94C5.56844 9.90891 8.23219 6.74516 11.7972 5.53516ZM11.3477 13.7498C11.7302 9.65984 13.8227 6.81234 15.0314 5.49609C16.2814 6.83484 18.3414 9.65609 18.6977 13.7498H11.3477ZM11.3516 16.25H18.7041C18.3216 20.3462 16.2241 23.1937 15.0166 24.51C13.7078 23.1225 11.7003 20.34 11.3516 16.25ZM24.9125 13.7519H21.2225C20.9662 10.1906 19.635 7.45688 18.3125 5.57812C21.8225 6.81563 24.4362 9.95188 24.9125 13.7519ZM27.5 15C27.5 8.12 21.9112 2.5225 15.035 2.5025C15.03 2.5025 15.025 2.50125 15.0188 2.50125C15.0138 2.50125 15.0063 2.5 15 2.5C8.1075 2.5 2.5 8.10875 2.5 15C2.5 21.8925 8.1075 27.5 15 27.5C15.0075 27.5 15.0138 27.4988 15.0188 27.4988C15.0213 27.4988 15.0225 27.5 15.025 27.5C15.0288 27.5 15.0325 27.4975 15.035 27.4975C21.9112 27.4788 27.5 21.88 27.5 15Z\"\r\n                            fill=\"white\"\r\n                          />\r\n                        </mask>\r\n                      </svg>\r\n                    </div>\r\n                    <h3>Mentorship Access</h3>\r\n                    <p>\r\n                      Set out on the right path by leveraging on the experience\r\n                      of those who have gone ahead.\r\n                    </p>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n              <div className=\"boxes22\">\r\n                <div className=\"\">\r\n                  <div className=\"boxes\">\r\n                    <div className=\"svg-box2\">\r\n                      <svg\r\n                        width=\"30\"\r\n                        height=\"30\"\r\n                        viewBox=\"0 0 30 30\"\r\n                        fill=\"none\"\r\n                        xmlns=\"http://www.w3.org/2000/svg\"\r\n                      >\r\n                        <path\r\n                          fillRule=\"evenodd\"\r\n                          clipRule=\"evenodd\"\r\n                          d=\"M18.2695 24.44C19.5808 22.5675 20.9445 19.8138 21.217 16.25H24.9108C24.432 20.065 21.7995 23.2125 18.2695 24.44ZM5.08612 16.2498H8.82612C9.08362 19.8273 10.4299 22.5698 11.7586 24.4511C8.21237 23.2298 5.56737 20.0761 5.08612 16.2498ZM11.7972 5.53516C10.4822 7.40766 9.10594 10.1702 8.83094 13.7489H5.08594C5.56844 9.90891 8.23219 6.74516 11.7972 5.53516ZM11.3477 13.7498C11.7302 9.65984 13.8227 6.81234 15.0314 5.49609C16.2814 6.83484 18.3414 9.65609 18.6977 13.7498H11.3477ZM11.3516 16.25H18.7041C18.3216 20.3462 16.2241 23.1937 15.0166 24.51C13.7078 23.1225 11.7003 20.34 11.3516 16.25ZM24.9125 13.7519H21.2225C20.9662 10.1906 19.635 7.45688 18.3125 5.57812C21.8225 6.81563 24.4362 9.95188 24.9125 13.7519ZM27.5 15C27.5 8.12 21.9112 2.5225 15.035 2.5025C15.03 2.5025 15.025 2.50125 15.0188 2.50125C15.0138 2.50125 15.0063 2.5 15 2.5C8.1075 2.5 2.5 8.10875 2.5 15C2.5 21.8925 8.1075 27.5 15 27.5C15.0075 27.5 15.0138 27.4988 15.0188 27.4988C15.0213 27.4988 15.0225 27.5 15.025 27.5C15.0288 27.5 15.0325 27.4975 15.035 27.4975C21.9112 27.4788 27.5 21.88 27.5 15Z\"\r\n                          fill=\"#773DD3\"\r\n                        />\r\n                        <mask\r\n                          id=\"mask0\"\r\n                          mask-type=\"alpha\"\r\n                          maskUnits=\"userSpaceOnUse\"\r\n                          x=\"2\"\r\n                          y=\"2\"\r\n                          width=\"26\"\r\n                          height=\"26\"\r\n                        >\r\n                          <path\r\n                            fillRule=\"evenodd\"\r\n                            clipRule=\"evenodd\"\r\n                            d=\"M18.2695 24.44C19.5808 22.5675 20.9445 19.8138 21.217 16.25H24.9108C24.432 20.065 21.7995 23.2125 18.2695 24.44ZM5.08612 16.2498H8.82612C9.08362 19.8273 10.4299 22.5698 11.7586 24.4511C8.21237 23.2298 5.56737 20.0761 5.08612 16.2498ZM11.7972 5.53516C10.4822 7.40766 9.10594 10.1702 8.83094 13.7489H5.08594C5.56844 9.90891 8.23219 6.74516 11.7972 5.53516ZM11.3477 13.7498C11.7302 9.65984 13.8227 6.81234 15.0314 5.49609C16.2814 6.83484 18.3414 9.65609 18.6977 13.7498H11.3477ZM11.3516 16.25H18.7041C18.3216 20.3462 16.2241 23.1937 15.0166 24.51C13.7078 23.1225 11.7003 20.34 11.3516 16.25ZM24.9125 13.7519H21.2225C20.9662 10.1906 19.635 7.45688 18.3125 5.57812C21.8225 6.81563 24.4362 9.95188 24.9125 13.7519ZM27.5 15C27.5 8.12 21.9112 2.5225 15.035 2.5025C15.03 2.5025 15.025 2.50125 15.0188 2.50125C15.0138 2.50125 15.0063 2.5 15 2.5C8.1075 2.5 2.5 8.10875 2.5 15C2.5 21.8925 8.1075 27.5 15 27.5C15.0075 27.5 15.0138 27.4988 15.0188 27.4988C15.0213 27.4988 15.0225 27.5 15.025 27.5C15.0288 27.5 15.0325 27.4975 15.035 27.4975C21.9112 27.4788 27.5 21.88 27.5 15Z\"\r\n                            fill=\"white\"\r\n                          />\r\n                        </mask>\r\n                      </svg>\r\n                    </div>\r\n                    <h3>Job Placement</h3>\r\n                    <p>\r\n                      Enter the recruitment process with tech companies and take\r\n                      a stride into your dream career.{\" \"}\r\n                    </p>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <div className=\"background1\" id=\"courses\">\r\n            <div className=\"container\">\r\n              <div className=\"gga\">\r\n                <div className=\"course_mode-intro course_mode-intro\">\r\n                  <h2>Available Courses</h2>\r\n                </div>\r\n                <div className=\"gga_container\">\r\n                  {courses.length ? (\r\n                    courses.map((item, index) => (\r\n                      <Link\r\n                        to={`/course-detail-graduate?course=${item.slug}`}\r\n                        className=\"boxes33\"\r\n                        key={index}\r\n                      >\r\n                        <div className=\"gua_cardview\">\r\n                          <div className=\"gua_cardview-box\">\r\n                            <img src={item.thumb} alt=\"course-desc\" />\r\n                          </div>\r\n                          <div className=\"gua_cardview-text\">\r\n                            <h4 style={{ color: \"rgb(51, 51, 51)\" }}>\r\n                              {item.name}\r\n                            </h4>\r\n                            <p>{item.description}</p>\r\n                            <Link\r\n                              to={\"/course-detail-graduate?course=\" + item.slug}\r\n                            >\r\n                            Learn More\r\n                            </Link>\r\n                          </div>\r\n                        </div>\r\n                      </Link>\r\n                    ))\r\n                  ) : (\r\n                    <div>\r\n                      {/* <img src={loader} alt=\"loader\" className=\"loader\" /> */}\r\n                    </div>\r\n                  )}\r\n                  <div className=\"boxes33\">\r\n                    <div className=\"gua_cardview\">\r\n                      <div className=\"gua_cardview-text\">\r\n                        <h4>Can't find a course you are interested in?</h4>\r\n                        <p>\r\n                          We will be glad if you can suggest the course you'd\r\n                          love to learn.\r\n                        </p>\r\n                        <Link to=\"/contact\">\r\n                          <a>Contact Us</a>\r\n                        </Link>\r\n                      </div>\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <Qualities />\r\n          <NeedAdvice />\r\n        </div>\r\n        <Footer />\r\n      </div>\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default GraduateAccelerator;\r\n","C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\pages\\Landing.js",["342","343","344","345","346","347"],"import { useEffect, useState, useContext } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { Accordion, Card } from \"react-bootstrap\";\r\n// import { cn } from \"../utils\";\r\nimport { MdKeyboardArrowDown } from \"react-icons/md\";\r\nimport { IoMdArrowRoundBack } from \"react-icons/io\";\r\nimport Slider from \"infinite-react-carousel\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport Mode from \"../components/Mode\";\r\nimport PrimaryBtn from \"../components/PrimaryBtn\";\r\n\r\nimport Abdullahi from \"../images/testimonial/abdullahi.jpeg\";\r\nimport Adedamola from \"../images/testimonial/adedamola.jpeg\";\r\nimport Bosun from \"../images/testimonial/bosun.jpg\";\r\nimport Grazac from \"../images/svg/logo-round.svg\";\r\nimport Video from \"../images/landing-video2.mp4\";\r\nimport Object from \"../images/svg/objects.svg\";\r\nimport poster from \"../images/Grazac-website/IMG_8403.JPG\";\r\n\r\nimport badge from \"../images/svg/badge.svg\";\r\nimport ex from \"../images/svg/x-mark.svg\";\r\nimport Sponsor1 from \"../images/svg/Apple.svg\";\r\nimport Sponsor2 from \"../images/svg/AWS.svg\";\r\nimport Sponsor3 from \"../images/svg/Flutterwave.svg\";\r\nimport Sponsor5 from \"../images/svg/Microsoft.svg\";\r\nimport Sponsor6 from \"../images/svg/Google.svg\";\r\n\r\nimport Card1 from \"../images/svg/card1.svg\";\r\nimport Card2 from \"../images/svg/card2.svg\";\r\n\r\nimport { LoaderContext } from \"../context\";\r\n\r\nconst Landing = () => {\r\n  const [showModal, setShowModal] = useState(true);\r\n  const { setShow, show } = useContext(LoaderContext);\r\n  useEffect(() => {\r\n    document.title = \"Welcome to Grazac Academy\";\r\n    let mediaPlayer = document.querySelector(\"#video\");\r\n    mediaPlayer.controls = false;\r\n    mediaPlayer.play();\r\n\r\n    //this gives the homepage spacing on top for the notification\r\n    var landingHeight = document.getElementsByClassName(\"landing\")[0];\r\n    landingHeight.style.marginTop = `80px`;\r\n\r\n    window.addEventListener(\"load\", () => {\r\n    \r\n      setShow(false)\r\n    });\r\n  }, []);\r\n\r\n  const content = [\r\n    {\r\n      id: 0,\r\n      img: Bosun,\r\n      content:\r\n        \"The future of work will be filled with so many opportunities we need to prepare for, I’ve known Grazac for a while and seen them in the business of helping people lay hold of these opportunities. Grazac Academy is an excellent starting point for anyone looking into building a career in technology.\",\r\n      name: \"Bosun Egberinde - Creator of PHPSandbox.io\",\r\n    },\r\n    {\r\n      id: 1,\r\n      img: Adedamola,\r\n      content:\r\n        \"I've known Grazac for over a year now and having worked with some of their successful students, I can boldly say the competency and problem solving skills of their students is top-notch and their academy is one of the best academy promoting technology skills acquisition here in Nigeria\",\r\n      name: \"Samson Adedamola - Consultant at Kudi\",\r\n    },\r\n    {\r\n      id: 2,\r\n      img: Abdullahi,\r\n      content:\r\n        \"I passed through Grazac Academy while I was in school and that's one of the best thing that happened to me as an undergraduate. I love how the facilitators mentored everyone of us up and I must say that, we got more value than we paid for.\",\r\n      name: \"Abdullahi Olaniyan - Software Developer at Global Accelerex\",\r\n    },\r\n  ];\r\n\r\n  const handleModal = () => {\r\n    setShowModal(false);\r\n    var landingHeight = document.getElementsByClassName(\"landing\")[0];\r\n    landingHeight.style.marginTop = `0px`;\r\n  };\r\n\r\n  const handleFaq = (e) => {\r\n    // const svg = e.target.querySelector(\"svg\");\r\n    console.log(e);\r\n    let svg = e.target.parentElement.querySelector(\"svg\");\r\n    if (e.target.nodeName === \"path\") {\r\n      svg = e.target.parentElement.parentElement.querySelector(\"svg\");\r\n    }\r\n    svg.classList.toggle(\"faq-icon_transition\");\r\n  };\r\n\r\n\r\n  return (\r\n    <div className=\"landing\">\r\n      {showModal && (\r\n        <div className=\"infomodal\">\r\n          <div className=\"infomodal_content\">\r\n            <img src={badge} alt=\"\" className=\"infomodal_badge\" />\r\n            <p>\r\n              Grazac Graduate Accelerator Program enrollment is opening by June\r\n              25th.\r\n              <a\r\n                className=\"infomodal_content-link\"\r\n                href=\"https://grazacacademy.com/graduate-accelerator-plan\"\r\n                f\r\n              >\r\n                Learn more\r\n              </a>\r\n            </p>\r\n            <Link to=\"/graduate-accelerator-plan\">\r\n              <button>Learn more</button>\r\n            </Link>\r\n            <img\r\n              src={ex}\r\n              alt=\"\"\r\n              onClick={handleModal}\r\n              style={{ cursor: \"pointer\" }}\r\n            />\r\n          </div>\r\n        </div>\r\n      )}\r\n      <div className=\"landing__header\">\r\n        <Navbar top={true} />\r\n        <img src={Object} className=\"bg-img\" alt=\"ccc\" />\r\n        <div style={{ height: 10 }}></div>\r\n\r\n        <div className=\"landing__text\">\r\n          <h1>\r\n            Upskilling You For The <span>Future</span> Of Work\r\n          </h1>\r\n          <p>\r\n            Learn valuable technology skills with us, we strongly believe the\r\n            future of work will be skill based. Join us to build a career in\r\n            tech and get tutored by industry leaders who will walk you through\r\n            the path of becoming highly valuable and employable{\" \"}\r\n          </p>\r\n        </div>\r\n        <a href=\"/#tracks\">\r\n          <div\r\n            className=\"nav__btn\"\r\n            style={{ width: \"130px\", margin: \"auto\", textAlign: \"center\" }}\r\n          >\r\n            <div className=\"nav__btn--text\">Get Started</div>\r\n          </div>\r\n        </a>\r\n      </div>\r\n\r\n      <div className=\"landing__video\">\r\n        <video\r\n          id=\"video\"\r\n          width=\"320\"\r\n          height=\"240\"\r\n          autoPlay\r\n          loop\r\n          muted\r\n          poster={poster}\r\n        >\r\n          <source src={Video} type=\"video/mp4\" />\r\n        </video>\r\n      </div>\r\n\r\n      <div className=\"landing__sponsors\">\r\n        <div className=\"landing__sponsors--container\">\r\n          <img src={Sponsor1} alt=\"sponsor\" />\r\n          <img src={Sponsor2} alt=\"sponsor\" />\r\n          <img src={Sponsor3} alt=\"sponsor\" />\r\n          <img src={Sponsor5} alt=\"sponsor\" />\r\n          <img src={Sponsor6} alt=\"sponsor\" />\r\n        </div>\r\n      </div>\r\n\r\n      <div className=\"landing__cards\" id=\"tracks\">\r\n        <div className=\"landing__cards--container\">\r\n          <div className=\"landing__bottom--text\">\r\n            <div className=\"landing__bottom--text--right\">\r\n              <h1>Get Ready To Grow With us </h1>\r\n            </div>\r\n          </div>\r\n\r\n          <div className=\"landing__card--box\">\r\n            <div className=\"landing__card landing__card--1\">\r\n              <img src={Card1} alt=\"illustration\" />\r\n              <h3>\r\n                <span>Graduate </span>\r\n                <br />\r\n                Accelerator Plan\r\n              </h3>\r\n              <p>\r\n                An immersive program that gives you the opportunity to build a\r\n                career and get a job in the tech industry.\r\n              </p>\r\n\r\n              <div className=\"landing__btn\">\r\n                <PrimaryBtn yellow link=\"/graduate-accelerator-plan\">\r\n                  Learn More\r\n                </PrimaryBtn>\r\n              </div>\r\n            </div>\r\n\r\n            <div className=\"landing__card landing__card--2\">\r\n              <img src={Card2} alt=\"illustration\" />\r\n              <h3>\r\n                <span>Undergraduate </span>\r\n                <br />\r\n                Accelerator Plan (FREE)\r\n              </h3>\r\n              <p>\r\n                Set the pace for a bright future as an undergraduate by\r\n                acquiring technology skills now.\r\n              </p>\r\n              <div className=\"landing__btn\">\r\n                <PrimaryBtn link=\"/undergraduate-accelerator-plan\">\r\n                  Learn More\r\n                </PrimaryBtn>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <div className=\"landing__intern\">\r\n        <div className=\"landing__intern--content\">\r\n          <div>&nbsp;</div>\r\n          <div className=\"landing__bottom--text landing__bottom--text-2\">\r\n            <div className=\"landing__intern--text\">\r\n              <h1>Tech is Vast. Let's help you with directions.</h1>\r\n              <p>\r\n                Are you looking to step into the field of tech but don't know\r\n                what to learn or how to begin? We can help you. Tech is a broad\r\n                field, and there are a lot of interesting pathways and\r\n                directions you can venture into. You need all the clarity you\r\n                can get so you can make informed decisions. Consult us for free\r\n              </p>\r\n              <div className=\"landing__btn--2\">\r\n                {/* <PrimaryBtn link=\"/\">Enroll Now</PrimaryBtn> */}\r\n                <a href=\"/#tracks\">\r\n                  <div className=\"nav__btn nav__btn-flex \">\r\n                    <a\r\n                      className=\"nav__btn--text\"\r\n                      href=\"tel:+2348068365951\"\r\n                      style={{ marginRight: \"20px\" }}\r\n                    >\r\n                      Call Us Now\r\n                    </a>\r\n                    <a href=\"https://wa.link/w8e0xs\">\r\n                      <div className=\"nav__btn--text1\">Chat With Us</div>\r\n                    </a>\r\n                  </div>\r\n                </a>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          {/* <div className=\"landing__intern--btn\">\r\n            <PrimaryBtn link=\"/internship\">Enroll Now</PrimaryBtn>\r\n          </div> */}\r\n        </div>\r\n      </div>\r\n\r\n      <div className=\"landing__discover\">\r\n        <div className=\"landing__bottom--text landing__bottom--text-2\">\r\n          <div className=\"landing__bottom--text--right\">\r\n            <h1>\r\n              We are trusted by entrepreneurs and hiring managers globally.\r\n            </h1>\r\n            <p>\r\n              We guarantee you impact driven candidates who will impact your\r\n              bottom lines positively.\r\n            </p>\r\n          </div>\r\n        </div>\r\n\r\n        <div className=\"landing__discover--container\">\r\n          <div className=\"landing__discover--images\">\r\n            <div className=\"landing__discover--images-left\">\r\n              <div></div>\r\n              <div></div>\r\n            </div>\r\n            <div className=\"landing__discover--images-right\">\r\n              <div></div>\r\n            </div>\r\n          </div>\r\n\r\n          <div className=\"landing__discover--list\">\r\n            <div className=\"landing__discover--list-item\">\r\n              <h2>01</h2>\r\n              <div>\r\n                <h3>Enroll</h3>\r\n                <p>\r\n                  Set yourself up for success by registering for any of our\r\n                  courses that fits your passion and career.\r\n                </p>\r\n              </div>\r\n            </div>\r\n\r\n            <div className=\"landing__discover--list-item\">\r\n              <h2>02</h2>\r\n              <div>\r\n                <h3>Learn</h3>\r\n                <p>\r\n                  Get trained by world class facilitators. We will provide you\r\n                  with the right mentorship, tools and content you need to be\r\n                  the best in your choosing career.\r\n                </p>\r\n              </div>\r\n            </div>\r\n\r\n            <div className=\"landing__discover--list-item\">\r\n              <h2>03</h2>\r\n              <div>\r\n                <h3>Get Hired</h3>\r\n                <p>\r\n                  Join the workforce of the future as you get connected with\r\n                  career coaches and potential employers.\r\n                </p>\r\n              </div>\r\n            </div>\r\n            <div className=\"landing__discover--list-item\"></div>\r\n            <div className=\"landing__discover--list-item\"></div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      {/* FAQ section commented out till content is ready */}\r\n      <div className=\"landing_faq\">\r\n        <div className=\"container\">\r\n          <h1>FAQs</h1>\r\n          <div>\r\n            <Accordion>\r\n              <Card>\r\n                <Accordion.Toggle as={Card.Header} eventKey=\"0\">\r\n                  <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                    <h4>What is Grazac Academy?</h4>\r\n                    <MdKeyboardArrowDown size=\"2rem\" color=\"black\" />\r\n                  </div>\r\n                </Accordion.Toggle>\r\n                <Accordion.Collapse eventKey=\"0\">\r\n                  <Card.Body>\r\n                    <div className=\"landing_faq-answer\">\r\n                      <p>\r\n                        Grazac Academy is closing the gap between youths and\r\n                        entry-level jobs in the technology industry. We strongly\r\n                        believe the job market for youths has changed and the\r\n                        future of work will be skill-based.\r\n                      </p>\r\n                      <p>We are approaching this in two ways:</p>\r\n                      <p>\r\n                        Grazac Academy Graduate Accelerator - This plan is for\r\n                        tertiary institutions graduates who have full time to\r\n                        build a career in tech. This plan has been arranged in a\r\n                        way to prepare them for work.\r\n                      </p>\r\n                      <p>\r\n                        Grazac Academy Undergraduate Accelerator - This plan is\r\n                        to equip undergraduates in their institutions, we\r\n                        believe the earlier the better and we want to prepare\r\n                        them for life after school by upskilling them while they\r\n                        are still in school.\r\n                      </p>\r\n                    </div>\r\n                  </Card.Body>\r\n                </Accordion.Collapse>\r\n              </Card>\r\n              <hr />\r\n              <Card>\r\n                <Accordion.Toggle as={Card.Header} eventKey=\"1\">\r\n                  <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                    <h4>When was the academy established?</h4>\r\n                    <MdKeyboardArrowDown size=\"2rem\" color=\"black\" />\r\n                  </div>\r\n                </Accordion.Toggle>\r\n                <Accordion.Collapse eventKey=\"1\">\r\n                  <Card.Body>\r\n                    <div className=\"landing_faq-answer\">\r\n                      <p>Grazac Academy has been in operation since 2018</p>\r\n                    </div>\r\n                  </Card.Body>\r\n                </Accordion.Collapse>\r\n              </Card>\r\n              <hr />\r\n              <Card>\r\n                <Accordion.Toggle as={Card.Header} eventKey=\"2\">\r\n                  <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                    <h4>How many students have graduated from your academy?</h4>\r\n                    <MdKeyboardArrowDown size=\"2rem\" color=\"black\" />\r\n                  </div>\r\n                </Accordion.Toggle>\r\n                <Accordion.Collapse eventKey=\"2\">\r\n                  <Card.Body>\r\n                    <div className=\"landing_faq-answer\">\r\n                      <p>\r\n                        Excluding our partnership with Haptics.ng in 2019 to\r\n                        execute Google project of upskilling Nigerians on\r\n                        Digital skills where we trained about 500 youths, we\r\n                        have impacted over 2,000 lives through our trainings,\r\n                        meetups and events.\r\n                      </p>\r\n                    </div>\r\n                  </Card.Body>\r\n                </Accordion.Collapse>\r\n              </Card>\r\n              <hr />\r\n              <Card>\r\n                <Accordion.Toggle as={Card.Header} eventKey=\"3\">\r\n                  <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                    <h4>Where is the academy located?</h4>\r\n                    <MdKeyboardArrowDown size=\"2rem\" color=\"black\" />\r\n                  </div>\r\n                </Accordion.Toggle>\r\n                <Accordion.Collapse eventKey=\"3\">\r\n                  <Card.Body>\r\n                    <div className=\"landing_faq-answer\">\r\n                      <p>\r\n                        Our headquarter is located at Abeokuta, Ogun State,\r\n                        Nigeria.\r\n                      </p>\r\n                      <p>\r\n                        Address: Suite 106, PROHUB, Salawu Olabode Avenue, Ewang\r\n                        Road, Idi-aba, Abeokuta.\r\n                      </p>\r\n                    </div>\r\n                  </Card.Body>\r\n                </Accordion.Collapse>\r\n              </Card>\r\n              <hr />\r\n              <Card>\r\n                <Accordion.Toggle as={Card.Header} eventKey=\"4\">\r\n                  <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                    <h4>How do I enroll in the academy?</h4>\r\n                    <MdKeyboardArrowDown size=\"2rem\" color=\"black\" />\r\n                  </div>\r\n                </Accordion.Toggle>\r\n                <Accordion.Collapse eventKey=\"4\">\r\n                  <Card.Body>\r\n                    <div className=\"landing_faq-answer\">\r\n                      <p>\r\n                        Visit{\" \"}\r\n                        <a href=\"https://www.grazacacademy.com\">\r\n                          www.grazacacademy.com\r\n                        </a>{\" \"}\r\n                        to enroll for your preferred course.\r\n                      </p>\r\n                    </div>\r\n                  </Card.Body>\r\n                </Accordion.Collapse>\r\n              </Card>\r\n              <hr />\r\n              <Card>\r\n                <Accordion.Toggle as={Card.Header} eventKey=\"5\">\r\n                  <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                    <h4>What are the payment options?</h4>\r\n                    <MdKeyboardArrowDown size=\"2rem\" color=\"black\" />\r\n                  </div>\r\n                </Accordion.Toggle>\r\n                <Accordion.Collapse eventKey=\"5\">\r\n                  <Card.Body>\r\n                    <div className=\"landing_faq-answer\">\r\n                      <p>\r\n                        We have three (2) payment options for our Gradaute\r\n                        Accelerator, you can either pay once or pay\r\n                        installmentally.\r\n                      </p>\r\n                    </div>\r\n                  </Card.Body>\r\n                </Accordion.Collapse>\r\n              </Card>\r\n            </Accordion>\r\n            <hr />\r\n            <Link to=\"/faq\">\r\n              <p className=\"landing_faq-link\">\r\n                More frequently asked questions\r\n              </p>\r\n            </Link>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <div className=\"landing__slider\">\r\n        <Slider arrows={true}>\r\n          {content.map((item) => (\r\n            <div className=\"landing__slider--container\" key={item.id}>\r\n              <div className=\"landing__slider--img\">\r\n                <img src={item.img} alt=\"img\" />\r\n              </div>\r\n\r\n              <div className=\"landing__slider--text\">\r\n                <svg\r\n                  width=\"30\"\r\n                  height=\"28\"\r\n                  viewBox=\"0 0 30 28\"\r\n                  fill=\"none\"\r\n                  xmlns=\"http://www.w3.org/2000/svg\"\r\n                >\r\n                  <path\r\n                    d=\"M12.3993 5.56001C13.1711 5.22699 13.4948 4.27918 13.1462 3.51069L11.9262 0.872185C11.5777 0.129562 10.7311 -0.203709 9.98417 0.129562C7.86782 1.05176 6.05026 2.25573 4.60616 3.71587C2.83839 5.43192 1.64328 7.4044 0.995927 9.5818C0.348574 11.7851 0 14.782 0 18.5988V26.4631C0 27.3084 0.672251 28.0001 1.49389 28.0001H11.2789C12.1005 28.0001 12.7728 27.3084 12.7728 26.4631V16.3958C12.7728 15.5502 12.1005 14.8588 11.2789 14.8588H6.59802C6.64781 12.2713 7.24537 10.1966 8.34089 8.63373C9.23722 7.37904 10.5817 6.35438 12.3993 5.56001Z\"\r\n                    fill=\"#4B004B\"\r\n                  />\r\n                  <path\r\n                    d=\"M29.1127 5.53403C29.8845 5.20102 30.2079 4.25321 29.8596 3.48471L28.6396 0.872082C28.291 0.129203 27.4445 -0.203812 26.6976 0.129203C24.6061 1.0514 22.8132 2.25537 21.3444 3.6899C19.5764 5.43182 18.3567 7.40429 17.7091 9.5817C17.0617 11.7332 16.7383 14.7306 16.7383 18.5731V26.4374C16.7383 27.2827 17.4105 27.9744 18.2322 27.9744H28.0172C28.8388 27.9744 29.511 27.2827 29.511 26.4374V16.3701C29.511 15.5245 28.8388 14.8331 28.0172 14.8331H23.3114C23.3612 12.2456 23.959 10.1709 25.0543 8.60801C25.9506 7.35306 27.2951 6.3284 29.1127 5.53403Z\"\r\n                    fill=\"#4B004B\"\r\n                  />\r\n                </svg>\r\n\r\n                <p>{item.content}</p>\r\n\r\n                <small>{item.name}</small>\r\n              </div>\r\n            </div>\r\n          ))}\r\n        </Slider>\r\n      </div>\r\n\r\n      <div className=\"landing__bottom\" style={{ paddingBottom: 0 }}>\r\n        <div className=\"landing__bottom--text\">\r\n          <div className=\"landing__bottom--text--right\">\r\n            <h1>Get Upskilled For The Future Of Work</h1>\r\n            <p>\r\n              We will provide you with the tools, resources, facilities, content\r\n              and mentorship needed for your relevance in the future of work.\r\n            </p>\r\n            <div className=\"landing__btn--2\">\r\n              {/* <PrimaryBtn link=\"/\">Enroll Now</PrimaryBtn> */}\r\n              <a href=\"/#tracks\">\r\n                <div className=\"nav__btn nav__btn-flex \">\r\n                  <a className=\"nav__btn--text\" href=\"https://wa.link/w8e0xs\">\r\n                    Chat with Us\r\n                  </a>\r\n                </div>\r\n              </a>\r\n            </div>\r\n          </div>\r\n\r\n          <div className=\"landing__bottom--text--left\">\r\n            <img src={Grazac} alt=\"img\" />\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <Mode />\r\n      <Footer />\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default Landing;\r\n","C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\pages\\UndergraduateCoursePayment.js",["348","349"],"import { useState, useEffect, useContext} from \"react\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport { useFlutterwave, closePaymentModal } from 'flutterwave-react-v3';\r\nimport { useParams } from \"react-router-dom\";\r\nimport { LoaderContext } from \"../context\";\r\n\r\nconst UndergraduateCoursePayment = () => {\r\n  const { id } = useParams();\r\n  const [fetched, setFetched] = useState({});\r\n  const [payment, setPayment] = useState(true);\r\n  const { setShow } = useContext(LoaderContext);\r\n  useEffect(() => {\r\n    document.title = 'Payment - Grazac Academy'\r\nsetShow(true)\r\n    fetch(`https://grazacacademy.com/undergraduate/registration/details/${id}`)\r\n    .then(resp => resp.json())\r\n    .then(data => {\r\n      setFetched(data.data)\r\n      setShow(false)\r\n      if(data.data.tx_ref.length) {\r\n        document.querySelector(\".form-info\").textContent = \"You have completed your registration\";\r\n        setPayment(false);\r\n      } \r\n    })\r\n    .catch(err => {\r\n      document.querySelector(\".form-info\").textContent = \"Something went wrong, refreshing...\";\r\n      //window.location.reload();\r\n      document.querySelector(\"#form-btn\").setAttribute('disabled', 'disabled');\r\n    })\r\n  }, []);\r\n\r\n  const config = {\r\n    public_key: 'FLWPUBK-006bdc82ad878f1518af32f44af6478f-X',\r\n    tx_ref: Date.now(),\r\n    amount: fetched.tuition,\r\n    currency: 'NGN',\r\n    payment_options: 'card,mobilemoney,ussd',\r\n    customer: {\r\n      email: fetched.email,\r\n      phonenumber: fetched.phone,\r\n      name: fetched.firstname + \" \" + fetched.lastname,\r\n    },\r\n    customizations: {\r\n      title: 'Grazac Undergraduate Accelerator Plan',\r\n      description: `Payment for ${fetched.course} at Grazac Undergraduate Accelerator Plan`,\r\n      logo: 'https://grazac.com.ng/assets/images/favicon.png',\r\n    },\r\n  };\r\n\r\n  const handleFlutterPayment = useFlutterwave(config);\r\n\r\n  const onSubmit = () => {\r\n    if(payment) {\r\n      handleFlutterPayment({\r\n        callback: (response) => {\r\n            if (response.status === 'successful') {\r\n              fetch(\"https://grazacacademy.com/undergraduate/registration/update\", {\r\n                method: 'POST',\r\n                headers: {\r\n                'Content-Type': 'application/json'\r\n                },\r\n                body: JSON.stringify({\r\n                  firstname: fetched.firstname,\r\n                  email: fetched.email,\r\n                  course: fetched.course,\r\n                  tx_ref: response.tx_ref,\r\n                  id: id\r\n                })\r\n              })\r\n              .then(resp => resp.json())\r\n              .then(data => {\r\n                if(data.success === true) {\r\n                  document.querySelector(\".form-info\").textContent = \"Your payment was successful.\";\r\n                }\r\n              })\r\n            };\r\n            closePaymentModal() // this will close the modal programmatically\r\n        },\r\n        onClose: () => {\r\n\r\n        },\r\n      });\r\n  } else {\r\n    alert('You have completed your registration');\r\n  }\r\n  }\r\n\r\n  return (\r\n    <div>\r\n      <Navbar/>\r\n        <div>\r\n          <div className=\"contact_layer\">\r\n            <div className=\"form_top\">\r\n              <div>\r\n                <h1>Payment</h1>\r\n              </div>\r\n              </div>\r\n              <div className=\"container\">\r\n                <div className=\"form\">\r\n                  <div className=\"form-info\">Click on Pay Now to finalize your payment.</div>\r\n                  <div className=\"form-flexdiv\">\r\n                    <div className=\"form-flexdiv-1\" >\r\n                      <label>First Name  <span>*</span></label>\r\n                      <input className=\"input\" type=\"text\" maxLength=\"30\" readOnly value={fetched.firstname} style={{textTransform: \"capitalize\"}}/>\r\n                    </div>\r\n                      <div className=\"form-flexdiv-2\">\r\n                          <label>Last Name  <span>*</span></label>\r\n                          <input className=\"input\" type=\"text\" maxLength=\"30\" readOnly value={fetched.lastname} style={{textTransform: \"capitalize\"}}/>\r\n                      </div>\r\n                    </div>\r\n                      <div className=\"form-flexdiv\">\r\n                          <div className=\"form-flexdiv-1\" >\r\n                              <label>Mobile Number  <span>*</span></label>\r\n                              <input className=\"input\" type=\"text\" maxLength=\"11\" readOnly value={fetched.phone}/>\r\n                          </div>\r\n                          <div className=\"form-flexdiv-2\">\r\n                              <label>Email  <span>*</span></label>\r\n                              <input className=\"input\" type=\"email\" maxLength=\"30\" readOnly value={fetched.email}/>\r\n                          </div>\r\n                      </div>\r\n                      <div>\r\n                          <label>Select your institution  <span>*</span></label><br/>\r\n                          <input className=\"input\" type=\"text\" readOnly value={fetched.institution}/>\r\n                      </div>\r\n                      <div>\r\n                          <label>Kindly choose your preferred course  <span>*</span></label><br/>\r\n                          <input className=\"input\" type=\"text\" readOnly value={fetched.course}/>\r\n                      </div>\r\n                      <div>\r\n                          <label>Amount</label><br/>\r\n                          <p className=\"show-amount\">\r\n                              ₦{ new Intl.NumberFormat().format(fetched.tuition) }\r\n                          </p>\r\n                      </div>\r\n                     \r\n                      <div className=\"form-privacy\" >\r\n                        <a className=\"download-brochure\" onClick={onSubmit} id=\"form-btn\">Pay Now</a>\r\n                      </div>\r\n                  </div>\r\n              </div>\r\n          </div>\r\n        </div>\r\n        <Footer/>\r\n    </div>\r\n  )\r\n}\r\n\r\nexport default UndergraduateCoursePayment;","C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\pages\\GraduateCoursePayment.js",[],"C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\pages\\LeadForm.js",[],"C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\pages\\GraduateForm.js",["350","351"],"import { useEffect, useRef, useState } from \"react\";\r\nimport { useFlutterwave, closePaymentModal } from \"flutterwave-react-v3\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport axios from \"axios\";\r\n\r\nconst GraduateForm = () => {\r\n  const [firstname, setFirstName] = useState(\"\");\r\n  const [lastname, setLastName] = useState(\"\");\r\n  const [phone, setPhone] = useState(\"\");\r\n  const [email, setEmail] = useState(\"\");\r\n  const [availability, setAvailability] = useState(\"\");\r\n  const [amount, setAmount] = useState(\"\");\r\n  const [course, setCourse] = useState(\"\");\r\n  const [paymentPlan, setPaymentPlan] = useState(\"\");\r\n  const [message, setMessage] = useState(\"\");\r\n  const [fetchCourses, setFetched] = useState([]);\r\n  const formInfo = useRef();\r\n  const [showPayment, setShowPayment] = useState(true);\r\n\r\n  useEffect(() => {\r\n    document.title = \"Join our Graduate Track - Grazac Academy\";\r\n    window.scrollTo(0, 0);\r\n    const method = window.location.search.substring(9);\r\n    if (method) {\r\n      setPaymentPlan(method);\r\n      setShowPayment(false);\r\n    }\r\n    fetch(\"https://grazacacademy.com/graduate/courses\")\r\n      .then((resp) => resp.json())\r\n      .then((resp) => {\r\n        console.log(resp.data)\r\n        setFetched(resp.data);\r\n      })\r\n      .catch((error) => {\r\n        console.log(\r\n          \"An error occurred when fetching course details, refreshing...\"\r\n        );\r\n        window.location.reload();\r\n      });\r\n  }, []);\r\n\r\n  const courseChange = (e) => {\r\n    setCourse(e.target.value);\r\n    var rc = e.target.options[e.target.selectedIndex].dataset.index;\r\n    setAmount(fetchCourses[rc].discounted_tuition);\r\n  };\r\n\r\n  const choosePlan = (e) => {\r\n    if(e.target.value === 'installmental') {\r\n      setAmount(100000);\r\n    } else if(e.target.value === 'monthly') {\r\n      setAmount(55000);\r\n    } else {\r\n      setAmount(200000);\r\n    }\r\n    setPaymentPlan(e.target.value);\r\n  };\r\n\r\n  const config = {\r\n    public_key: \"FLWPUBK-006bdc82ad878f1518af32f44af6478f-X\",\r\n    tx_ref: Date.now(),\r\n    amount: amount,\r\n    currency: \"NGN\",\r\n    payment_options: \"card,mobilemoney,ussd\",\r\n    customer: {\r\n      email: email,\r\n      phonenumber: phone,\r\n      name: firstname + \" \" + lastname,\r\n    },\r\n    customizations: {\r\n      title: \"Grazac Graduate Accelerator Plan\",\r\n      description: `Payment for ${course} at Grazac Graduate Accelerator Plan`,\r\n      logo: \"https://grazac.com.ng/assets/images/favicon.png\",\r\n    },\r\n  };\r\n\r\n  const handleFlutterPayment = useFlutterwave(config);\r\n\r\n  const onSubmit = (e) => {\r\n    e.preventDefault();\r\n    if (amount) {\r\n      handleFlutterPayment({\r\n        callback: (response) => {\r\n          if (response.status === \"successful\") {\r\n            window.scroll(0, formInfo.current.offsetTop);\r\n            document.querySelector(\".form-info\").textContent =\r\n              \"Submitting, please wait...\";\r\n            document\r\n              .querySelector(\"#submit-btn\")\r\n              .setAttribute(\"disabled\", \"disabled\");\r\n            fetch(\"https://grazacacademy.com/graduate/register\", {\r\n              method: \"POST\",\r\n              headers: {\r\n                \"Content-Type\": \"application/json\",\r\n              },\r\n              body: JSON.stringify({\r\n                firstname: firstname,\r\n                lastname: lastname,\r\n                email: email,\r\n                phone: phone,\r\n                course: course,\r\n                paymentPlan: paymentPlan,\r\n                expectation: message,\r\n                tuition: amount,\r\n              }),\r\n            })\r\n              .then((resp) => resp.json())\r\n              .then((data) => {\r\n                if (data.success === true) {\r\n                  document.querySelector(\".form-info\").textContent =\r\n                    \"Your registration was successful, kindly check your mailbox for further details\";\r\n                  document.querySelector(\"#submit-btn\").removeAttribute(\"disabled\");\r\n                  setFirstName(\"\");\r\n                  setLastName(\"\");\r\n                  setMessage(\"\");\r\n                  setPhone(\"\");\r\n                  setEmail(\"\");\r\n                  setCourse(\"\");\r\n                } else {\r\n                  document.querySelector(\".form-info\").textContent = data.msg;\r\n                  document.querySelector(\"#submit-btn\").removeAttribute(\"disabled\");\r\n                }\r\n              })\r\n              .catch((err) => {\r\n                document.querySelector(\".form-info\").textContent =\r\n                  \"Something went wrong, please try again\";\r\n                document.querySelector(\"#submit-btn\").removeAttribute(\"disabled\");\r\n              });\r\n\r\n              let formData = new FormData();\r\n              formData.append(\"name\", firstname);\r\n              formData.append(\"email\", email);\r\n              axios\r\n                .post(\"http://grazac.com.ng/newsletter/subscribe\", formData, {\r\n                  headers: {\r\n                    \"Content-Type\": \"application/json\",\r\n                  },\r\n                })\r\n                .then((resp) => resp.data)\r\n                .then((data) => {\r\n                  if (data.success === true) {\r\n                    console.log(\"Added to newsletter\");\r\n                  } else {\r\n                    console.log(\"Not Added to newsletter\");\r\n                  }\r\n                })\r\n                .catch((err) => {\r\n                  console.log(`An error occured, please try again ${err}`);\r\n                });\r\n\r\n          } else {\r\n            alert('Payment not successful');\r\n          }\r\n          closePaymentModal(); // this will close the modal programmatically\r\n        },\r\n        onClose: () => {},\r\n      });\r\n    } else {\r\n      alert(\"Please select a course\");\r\n    }\r\n  };\r\n\r\n  return (\r\n    <div>\r\n      <Navbar />\r\n      <div>\r\n        <div className=\"contact_layer\">\r\n          <div className=\"form_top\">\r\n            <div>\r\n              <h1>Grazac Academy Graduate Accelerator</h1>\r\n              <p>\r\n                We are bridging the gap between unemployment and entry-level\r\n                jobs in the technology industry.\r\n              </p>\r\n            </div>\r\n          </div>\r\n          <div className=\"container\" ref={formInfo}>\r\n            <div className=\"form\">\r\n              <form onSubmit={onSubmit}>\r\n                <div className=\"form-info\">\r\n                  Note: Fields with <span>*</span> are required\r\n                </div>\r\n                <div className=\"form-flexdiv\">\r\n                  <div className=\"form-flexdiv-1\">\r\n                    <label>\r\n                      First Name <span>*</span>\r\n                    </label>\r\n                    <input\r\n                      className=\"input\"\r\n                      type=\"text\"\r\n                      placeholder=\"ex. John\"\r\n                      value={firstname}\r\n                      onChange={(e) => setFirstName(e.target.value)}\r\n                      required=\"required\"\r\n                    />\r\n                  </div>\r\n                  <div className=\"form-flexdiv-2\">\r\n                    <label>\r\n                      Last Name <span>*</span>\r\n                    </label>\r\n                    <input\r\n                      className=\"input\"\r\n                      type=\"text\"\r\n                      placeholder=\"ex. Doe\"\r\n                      value={lastname}\r\n                      onChange={(e) => setLastName(e.target.value)}\r\n                      required=\"required\"\r\n                    />\r\n                  </div>\r\n                </div>\r\n                <div className=\"form-flexdiv\">\r\n                  <div className=\"form-flexdiv-1\">\r\n                    <label>\r\n                      Mobile Number <span>*</span>\r\n                    </label>\r\n                    <input\r\n                      className=\"input\"\r\n                      type=\"text\"\r\n                      placeholder=\"ex. 08133333333\"\r\n                      value={phone}\r\n                      onChange={(e) => setPhone(e.target.value)}\r\n                      required=\"required\"\r\n                    />\r\n                  </div>\r\n                  <div className=\"form-flexdiv-2\">\r\n                    <label>\r\n                      Email <span>*</span>\r\n                    </label>\r\n                    <input\r\n                      className=\"input\"\r\n                      type=\"text\"\r\n                      placeholder=\"ex. john@gmail.com\"\r\n                      value={email}\r\n                      onChange={(e) => setEmail(e.target.value)}\r\n                      required=\"required\"\r\n                    />\r\n                  </div>\r\n                </div>\r\n                <div>\r\n                  <label>\r\n                    Our classes will be on Monday, Wednesdays and Fridays, will\r\n                    you be available? <span>*</span>\r\n                  </label>\r\n                  <br />\r\n                  <label>\r\n                    <input\r\n                      type=\"radio\"\r\n                      className=\"radio-input\"\r\n                      id=\"yes\"\r\n                      name=\"availability\"\r\n                      value=\"1\"\r\n                      required=\"required\"\r\n                      checked={availability === \"1\"}\r\n                      onChange={(e) => setAvailability(e.target.value)}\r\n                    />\r\n                    Yes\r\n                  </label>\r\n                  <label>\r\n                    <input\r\n                      type=\"radio\"\r\n                      className=\"radio-input\"\r\n                      id=\"no\"\r\n                      name=\"availability\"\r\n                      value=\"0\"\r\n                      required=\"required\"\r\n                      checked={availability === \"0\"}\r\n                      onChange={(e) => setAvailability(e.target.value)}\r\n                      style={{ marginLeft: \"30px\" }}\r\n                    />\r\n                    No\r\n                  </label>\r\n                </div>\r\n                <div>\r\n                  <label>\r\n                    Kindly choose your preferred course <span>*</span>\r\n                  </label>\r\n                  <br />\r\n                  <select\r\n                    className=\"input\"\r\n                    onChange={courseChange}\r\n                    required=\"required\"\r\n                  >\r\n                    <option value=\"\">---Choose course---</option>\r\n                    {fetchCourses.map((item, index) => (\r\n                      <option key={index} data-index={index}>\r\n                        {item.name}\r\n                      </option>\r\n                    ))}\r\n                  </select>\r\n                </div>\r\n                {showPayment && (\r\n                  <div>\r\n                    <label>\r\n                      Kindly choose your preferred payment plan <span>*</span>\r\n                    </label>\r\n                    <br />\r\n                    <select\r\n                      className=\"input\"\r\n                      onChange={choosePlan}\r\n                      required=\"required\"\r\n                    >\r\n                      <option value=\"\">---Choose Plan---</option>\r\n                      <option value=\"full\">Full Payment</option>\r\n                      <option value=\"installmental\">Installmental Payment</option>\r\n                      <option value=\"monthly\">Monthly Payment</option>\r\n                    </select>\r\n                  </div>\r\n                )}\r\n                <div>\r\n                  <label>Amount</label>\r\n                  <br />\r\n                  <p className=\"show-amount\">\r\n                    ₦{amount ? new Intl.NumberFormat().format(amount) : \"0\"}\r\n                  </p>\r\n                </div>\r\n                {/* <div>\r\n                  <label>\r\n                    Kindly select a package. Our Part-time students have on-site\r\n                    classes only on Saturdays.{\" \"}\r\n                  </label>\r\n                  <br />\r\n                  <label>\r\n                    <input\r\n                      type=\"radio\"\r\n                      className=\"radio-input\"\r\n                      id=\"full-time\"\r\n                      name=\"plan\"\r\n                      value=\"full-time\"\r\n                      checked={plan === \"full-time\"}\r\n                      onChange={(e) => setPlan(e.target.value)}\r\n                      required=\"required\"\r\n                    />\r\n                    Full time\r\n                  </label>\r\n                  <label>\r\n                    <input\r\n                      type=\"radio\"\r\n                      className=\"radio-input\"\r\n                      id=\"part-time\"\r\n                      name=\"plan\"\r\n                      value=\"part-time\"\r\n                      checked={plan === \"part-time\"}\r\n                      onChange={(e) => setPlan(e.target.value)}\r\n                      style={{ marginLeft: \"30px\" }}\r\n                      required=\"required\"\r\n                    />\r\n                    Part time\r\n                  </label>\r\n                </div> */}\r\n                <div>\r\n                  <label>\r\n                    What do you expect at the end of this training?{\" \"}\r\n                    <span>*</span>\r\n                  </label>\r\n                  <textarea\r\n                    type=\"text\"\r\n                    placeholder=\"Say something ...\"\r\n                    value={message}\r\n                    onChange={(e) => setMessage(e.target.value)}\r\n                    required=\"required\"\r\n                  />\r\n                </div>\r\n                <div className=\"form-privacy\">\r\n                  <button\r\n                    className=\"download-brochure\"\r\n                    type=\"submit\"\r\n                    id=\"submit-btn\"\r\n                  >\r\n                    Register\r\n                  </button>\r\n                </div>\r\n              </form>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <Footer />\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default GraduateForm;\r\n","C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\pages\\ComingSoon.js",[],"C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\pages\\UndergraduateForm.js",[],"C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\auth\\Login.js",["352","353","354","355","356","357","358","359","360","361","362","363"],"C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\pages\\InternshipForm.js",["364","365"],"C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\auth\\Signup.js",["366","367","368","369","370","371","372","373","374","375","376","377","378"],"C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\pages\\UndergraduateAccelerator.js",["379","380","381","382","383","384"],"C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\components\\Qualities.js",[],"C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\components\\PrimaryBtn.js",[],"C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\components\\Navbar.js",["385","386"],"import { useEffect, useState, useRef } from \"react\";\r\nimport { cn } from \"../utils\";\r\nimport NavItem from \"./NavItem\";\r\nimport logo from \"../images/svg/grazac-logo.svg\";\r\nimport { Link } from \"react-router-dom\";\r\nimport InfoModal from \"../components/InfoModal\";\r\n\r\nconst Navbar = ({ top }) => {\r\n  const [fixed, setFixed] = useState(false);\r\n  const [active, setActive] = useState(false);\r\n  const [hover, setHover] = useState(false);\r\n  const nav = useRef(null);\r\n\r\n  useEffect(() => {\r\n    /*if(top) {\r\n      let h = document.querySelector('.infomodal').offsetHeight;\r\n      console.log(h);\r\n      document.querySelector('nav.nav').style.marginTop = h+'px';\r\n    }*/\r\n    if (nav.current && window.pageYOffset > nav.current.offsetTop) {\r\n      setFixed(true);\r\n    } else {\r\n      setFixed(false);\r\n    }\r\n    window.addEventListener(\"scroll\", () => {\r\n      if (nav.current && window.pageYOffset > nav.current.offsetTop)\r\n        setFixed(true);\r\n      else setFixed(false);\r\n    });\r\n  }, []);\r\n\r\n  const handleClick = (e) => {\r\n    e.preventDefault();\r\n\r\n    if (active) setActive(false);\r\n    else setActive(true);\r\n  };\r\n\r\n  return (\r\n    <nav className={cn(\"nav\", { \"nav--fixed\": fixed })} ref={nav}>\r\n      <div className=\"nav__container\">\r\n        <div className=\"nav__logo\">\r\n          <Link to=\"/\">\r\n            <img src={logo} alt=\"logo\" />\r\n          </Link>\r\n        </div>\r\n\r\n        <div className={cn(\"nav__menu\", { \"nav__menu--active\": active })}>\r\n          <button className=\"nav-tgl\" onClick={handleClick}>\r\n            <span>&nbsp;</span>\r\n          </button>\r\n\r\n          <ul className=\"nav__list--mb\">\r\n            <li className=\"nav__item\">\r\n              <NavItem exact link=\"/\">\r\n                <span>01</span>Home\r\n              </NavItem>\r\n            </li>\r\n            <li className=\"nav__item\">\r\n              <NavItem link=\"/about-us\">\r\n                <span>02</span>About\r\n              </NavItem>\r\n            </li>\r\n            <li className=\"nav__item\">\r\n              <NavItem link=\"/undergraduate-accelerator-plan\">\r\n                <span>03</span>Undergraduate\r\n              </NavItem>\r\n            </li>\r\n            <li className=\"nav__item\">\r\n              <NavItem link=\"/graduate-accelerator-plan\">\r\n                <span>04</span>Graduate\r\n              </NavItem>\r\n            </li>\r\n            <li className=\"nav__item\">\r\n              <a href=\"/#tracks\">\r\n                <button onClick={() => setActive(false)}>Enroll Now</button>\r\n              </a>\r\n            </li>\r\n            <li className=\"nav__item\" style={{ marginTop: \"30px\" }}>\r\n              <a href=\"tel:+2348068365951\">\r\n                <button onClick={() => setActive(false)}>Talk to us</button>\r\n              </a>\r\n            </li>\r\n          </ul>\r\n        </div>\r\n\r\n        <ul className=\"nav__list\" style={{ marginBottom: 0 }}>\r\n          <li className=\"nav__item\">\r\n            <NavItem exact link=\"/\">\r\n              Home\r\n            </NavItem>\r\n          </li>\r\n          <li className=\"nav__item\">\r\n            <NavItem link=\"/about-us\">About</NavItem>\r\n          </li>\r\n          <li\r\n            className=\"nav__item\"\r\n            style={{ position: \"relative\", cursor: \"pointer\" }}\r\n            onMouseEnter={() => setHover(true)}\r\n            onMouseLeave={() => setHover(false)}\r\n          >\r\n            <a className=\"nav__link\">Academy</a>\r\n            <svg\r\n              className=\"mask\"\r\n              width=\"11\"\r\n              height=\"6\"\r\n              viewBox=\"0 0 11 6\"\r\n              fill=\"none\"\r\n              xmlns=\"http://www.w3.org/2000/svg\"\r\n            >\r\n              <path\r\n                fillRule=\"evenodd\"\r\n                clipRule=\"evenodd\"\r\n                d=\"M5.50003 6C5.32089 6 5.14252 5.934 4.99716 5.80113L0.282791 1.51511C-0.0503581 1.21251 -0.0959304 0.671616 0.182218 0.308161C0.45958 -0.0552936 0.954589 -0.104154 1.28852 0.198439L5.50867 4.03529L9.72175 0.336449C10.0596 0.0398561 10.5546 0.098146 10.8265 0.466744C11.0984 0.835342 11.0449 1.37452 10.7071 1.67197L5.99268 5.81056C5.8489 5.93657 5.67446 6 5.50003 6Z\"\r\n                fill=\"#575A65\"\r\n              />\r\n            </svg>\r\n\r\n            <div\r\n              className={cn(\"nav__dropdown\", {\r\n                \"nav__dropdown--active\": hover,\r\n              })}\r\n            >\r\n              <span></span>\r\n              <ul className=\"nav__dropdown--list\">\r\n                <li>\r\n                  <Link\r\n                    to=\"/undergraduate-accelerator-plan\"\r\n                    className=\"nav__link\"\r\n                  >\r\n                    Undergraduate\r\n                  </Link>\r\n                </li>\r\n                <li>\r\n                  <Link to=\"/graduate-accelerator-plan\" className=\"nav__link\">\r\n                    Graduate\r\n                  </Link>\r\n                </li>\r\n              </ul>\r\n            </div>\r\n          </li>\r\n          <a href=\"/#tracks\">\r\n            <div className=\"nav__btn\">\r\n              <div className=\"nav__btn--text\">Enroll Now</div>\r\n            </div>\r\n          </a>\r\n          <a href=\"tel:+2348068365951\" style={{ marginLeft: \"20px\" }}>\r\n            <div className=\"nav__btn\">\r\n              <div className=\"nav__btn--text1\">Talk to us</div>\r\n            </div>\r\n          </a>\r\n        </ul>\r\n      </div>\r\n    </nav>\r\n  );\r\n};\r\n\r\nexport default Navbar;\r\n","C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\components\\NeedAdvice.js",["387","388","389"],"import lady from \"../images/Grazac-website/IMG_8440.JPG\";\r\n\r\nconst NeedAdvice = () => {\r\n  return(\r\n    <div className=\"gua_advice\" >\r\n        <div className=\"container\">\r\n            <div className=\"gua_advice-box\">\r\n                <div className=\"boxes55\">\r\n                        <img src={lady} alt=\"undergraduate\" className=\"gua_advice-box-img\" />\r\n                </div>\r\n                <div className=\"boxes55\">\r\n                    <div className=\"gua_advice-box-text\">\r\n                        <h2>Need Advice?</h2>\r\n                        <p>Do you need further clarification?\r\n                        </p>\r\n                        <a href=\"tel:+2348068365951\"><button>Call us now</button></a>\r\n                        <a href=\"https://wa.link/w8e0xs\"><button className=\"second-button\">Chat with us</button></a>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n\r\n        </div>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default NeedAdvice;","C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\components\\Mode.js",["390","391","392","393","394","395"],"C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\utils.js",[],"C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\components\\Footer.js",["396","397","398","399"],"C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\components\\SchoolList.js",[],"C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\components\\MOT.js",[],"C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\components\\NavItem.js",[],"C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\components\\InfoModal.js",["400"],"C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\components\\Modal.js",[],"C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\pages\\Faq.js",["401","402","403","404","405","406","407","408","409","410","411","412","413","414","415","416","417","418","419","420","421","422","423","424","425","426","427","428","429","430","431","432","433","434"],"import React from \"react\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport {Accordion, Card} from 'react-bootstrap';\r\nimport { MdKeyboardArrowDown, MdKeyboardArrowUp } from 'react-icons/md'\r\nimport lady from '../images/Grazac-website/IMG_8440.JPG'\r\n\r\nconst Faq = () => {\r\n    React.useEffect(() => {\r\n        document.title = 'FAQs - Grazac Academy';\r\n        window.scrollTo(0,0);\r\n    },[]);\r\n    \r\n    const handleFaq = (e) => {\r\n      // const svg = e.target.querySelector(\"svg\");\r\n      console.log(e)\r\n      let svg = e.target.parentElement.querySelector('svg')\r\n      if (e.target.nodeName === 'path') {\r\n        svg = e.target.parentElement.parentElement.querySelector('svg')\r\n      }\r\n      svg.classList.toggle('faq-icon_transition')\r\n    }\r\n    \r\n    return (\r\n      <div>\r\n        <div className='faq_hero'>\r\n          <Navbar />\r\n          <div className='faq_hero_content'>\r\n            <h1>Frequently Asked Questions</h1>\r\n            <p>\r\n              To better help you learn more about Grazac Academy, we’ve compiled\r\n              the following Frequently Asked Questions (FAQs).\r\n            </p>\r\n          </div>\r\n        </div>\r\n        <div>\r\n          {/* FAQ section */}\r\n          <div className='landing_faq'>\r\n            <div className='container'>\r\n              <div>\r\n                <Accordion defaultActiveKey='0'>\r\n                  <h3>Academy</h3>\r\n                  <Card>\r\n                    <Accordion.Toggle as={Card.Header} eventKey='0'>\r\n                      <div className='landing_faq-question' onClick={handleFaq}>\r\n                        <h4>What is Grazac Academy?</h4>\r\n                        <MdKeyboardArrowUp size='2rem' color='black' />\r\n                      </div>\r\n                    </Accordion.Toggle>\r\n                    <Accordion.Collapse eventKey='0'>\r\n                      <Card.Body>\r\n                        <div className='landing_faq-answer'>\r\n                          <p>\r\n                            Grazac Academy is closing the gap between youths and\r\n                            entry-level jobs in the technology industry. We\r\n                            strongly believe the job market for youths has\r\n                            changed and the future of work will be skill-based.\r\n                          </p>\r\n                          <p>We are approaching this in two ways:</p>\r\n                          <p>\r\n                            Grazac Academy Graduate Accelerator - This plan is\r\n                            for tertiary institutions graduates who have full\r\n                            time to build a career in tech. This plan has been\r\n                            arranged in a way to prepare them for work.\r\n                          </p>\r\n                          <p>\r\n                            Grazac Academy Undergraduate Accelerator - This plan\r\n                            is to equip undergraduates in their institutions, we\r\n                            believe the earlier the better and we want to\r\n                            prepare them for life after school by upskilling\r\n                            them while they are still in school.\r\n                          </p>\r\n                        </div>\r\n                      </Card.Body>\r\n                    </Accordion.Collapse>\r\n                  </Card>\r\n                  <hr />\r\n                  <Card>\r\n                    <Accordion.Toggle as={Card.Header} eventKey='1'>\r\n                      <div className='landing_faq-question' onClick={handleFaq}>\r\n                        <h4>When was the academy established?</h4>\r\n                        <MdKeyboardArrowDown size='2rem' color='black' />\r\n                      </div>\r\n                    </Accordion.Toggle>\r\n                    <Accordion.Collapse eventKey='1'>\r\n                      <Card.Body>\r\n                        <div className='landing_faq-answer'>\r\n                          <p>Grazac Academy has been in operation since 2018</p>\r\n                        </div>\r\n                      </Card.Body>\r\n                    </Accordion.Collapse>\r\n                  </Card>\r\n                  <hr />\r\n                  <Card>\r\n                    <Accordion.Toggle as={Card.Header} eventKey='2'>\r\n                      <div className='landing_faq-question' onClick={handleFaq}>\r\n                        <h4>\r\n                          How many students have graduated from your academy?\r\n                        </h4>\r\n                        <MdKeyboardArrowDown size='2rem' color='black' />\r\n                      </div>\r\n                    </Accordion.Toggle>\r\n                    <Accordion.Collapse eventKey='2'>\r\n                      <Card.Body>\r\n                        <div className='landing_faq-answer'>\r\n                          <p>\r\n                            Excluding our partnership with Haptics.ng in 2019 to\r\n                            execute Google project of upskilling Nigerians on\r\n                            Digital skills where we trained about 500 youths, we\r\n                            have impacted over 2,000 lives through our\r\n                            trainings, meetups and events.\r\n                          </p>\r\n                        </div>\r\n                      </Card.Body>\r\n                    </Accordion.Collapse>\r\n                  </Card>\r\n                  <hr />\r\n                  <Card>\r\n                    <Accordion.Toggle as={Card.Header} eventKey='3'>\r\n                      <div className='landing_faq-question' onClick={handleFaq}>\r\n                        <h4>Where is the academy located?</h4>\r\n                        <MdKeyboardArrowDown size='2rem' color='black' />\r\n                      </div>\r\n                    </Accordion.Toggle>\r\n                    <Accordion.Collapse eventKey='3'>\r\n                      <Card.Body>\r\n                        <div className='landing_faq-answer'>\r\n                          <p>\r\n                            Our headquarter is located at Abeokuta, Ogun State,\r\n                            Nigeria.\r\n                          </p>\r\n                          <p>\r\n                            Address: Suite 106, PROHUB, Salawu Olabode Avenue,\r\n                            Ewang Road, Idi-aba, Abeokuta.\r\n                          </p>\r\n                        </div>\r\n                      </Card.Body>\r\n                    </Accordion.Collapse>\r\n                  </Card>\r\n                  <hr />\r\n                  <Card>\r\n                    <Accordion.Toggle as={Card.Header} eventKey='4'>\r\n                      <div className='landing_faq-question' onClick={handleFaq}>\r\n                        <h4>How do I enroll in the academy?</h4>\r\n                        <MdKeyboardArrowDown size='2rem' color='black' />\r\n                      </div>\r\n                    </Accordion.Toggle>\r\n                    <Accordion.Collapse eventKey='4'>\r\n                      <Card.Body>\r\n                        <div className='landing_faq-answer'>\r\n                          <p>\r\n                            Visit{' '}\r\n                            <a href='https://www.grazacacademy.com'>\r\n                              www.grazacacademy.com\r\n                            </a>{' '}\r\n                            to enroll for your preferred course.\r\n                          </p>\r\n                        </div>\r\n                      </Card.Body>\r\n                    </Accordion.Collapse>\r\n                  </Card>\r\n                  <hr />\r\n                  <h3>Payment Structure</h3>\r\n                  <Card>\r\n                    <Accordion.Toggle as={Card.Header} eventKey='5'>\r\n                      <div className='landing_faq-question' onClick={handleFaq}>\r\n                        <h4>What are the payment options?</h4>\r\n                        <MdKeyboardArrowDown size='2rem' color='black' />\r\n                      </div>\r\n                    </Accordion.Toggle>\r\n                    <Accordion.Collapse eventKey='5'>\r\n                      <Card.Body>\r\n                        <div className='landing_faq-answer'>\r\n                          <p>\r\n                            We have three (2) payment options for our Gradaute\r\n                            Accelerator, you can either pay once or pay\r\n                            installmentally.\r\n                          </p>\r\n                        </div>\r\n                      </Card.Body>\r\n                    </Accordion.Collapse>\r\n                  </Card>\r\n                  <hr />\r\n                  <Card>\r\n                    <Accordion.Toggle as={Card.Header} eventKey='6'>\r\n                      <div className='landing_faq-question' onClick={handleFaq}>\r\n                        <h4>Do you offer discounts?</h4>\r\n                        <MdKeyboardArrowDown size='2rem' color='black' />\r\n                      </div>\r\n                    </Accordion.Toggle>\r\n                    <Accordion.Collapse eventKey='6'>\r\n                      <Card.Body>\r\n                        <div className='landing_faq-answer'>\r\n                          <p>Yes, we offer early bird discounts.</p>\r\n                        </div>\r\n                      </Card.Body>\r\n                    </Accordion.Collapse>\r\n                  </Card>\r\n                  <hr />\r\n                  <Card>\r\n                    <Accordion.Toggle as={Card.Header} eventKey='7'>\r\n                      <div className='landing_faq-question' onClick={handleFaq}>\r\n                        <h4>Do you offer scholarships?</h4>\r\n                        <MdKeyboardArrowDown size='2rem' color='black' />\r\n                      </div>\r\n                    </Accordion.Toggle>\r\n                    <Accordion.Collapse eventKey='7'>\r\n                      <Card.Body>\r\n                        <div className='landing_faq-answer'>\r\n                          <p>\r\n                            No. We don’t have scholarship offers at the moment.\r\n                          </p>\r\n                        </div>\r\n                      </Card.Body>\r\n                    </Accordion.Collapse>\r\n                  </Card>\r\n                  <hr />\r\n                  <Card>\r\n                    <Accordion.Toggle as={Card.Header} eventKey='100'>\r\n                      <div className='landing_faq-question' onClick={handleFaq}>\r\n                        <h4>Do you offer compensation to a referrer?</h4>\r\n                        <MdKeyboardArrowDown size='2rem' color='black' />\r\n                      </div>\r\n                    </Accordion.Toggle>\r\n                    <Accordion.Collapse eventKey='100'>\r\n                      <Card.Body>\r\n                        <div className='landing_faq-answer'>\r\n                          <p>\r\n                            Yes, for our Graduate Accelerator, you can refer\r\n                            someone and earn 5,000 naira immediately after the\r\n                            referred person enroll. The referred person must put\r\n                            your name while registering.\r\n                          </p>\r\n                        </div>\r\n                      </Card.Body>\r\n                    </Accordion.Collapse>\r\n                  </Card>\r\n                  <hr />\r\n                  <Card>\r\n                    <Accordion.Toggle as={Card.Header} eventKey='8'>\r\n                      <div className='landing_faq-question' onClick={handleFaq}>\r\n                        <h4>Can I switch my payment plan?</h4>\r\n                        <MdKeyboardArrowDown size='2rem' color='black' />\r\n                      </div>\r\n                    </Accordion.Toggle>\r\n                    <Accordion.Collapse eventKey='8'>\r\n                      <Card.Body>\r\n                        <div className='landing_faq-answer'>\r\n                          <p>No, you can’t switch payment plans.</p>\r\n                        </div>\r\n                      </Card.Body>\r\n                    </Accordion.Collapse>\r\n                  </Card>\r\n                  <hr />\r\n                  <Card>\r\n                    <Accordion.Toggle as={Card.Header} eventKey='9'>\r\n                      <div className='landing_faq-question' onClick={handleFaq}>\r\n                        <h4>Can I apply for a refund?</h4>\r\n                        <MdKeyboardArrowDown size='2rem' color='black' />\r\n                      </div>\r\n                    </Accordion.Toggle>\r\n                    <Accordion.Collapse eventKey='9'>\r\n                      <Card.Body>\r\n                        <div className='landing_faq-answer'>\r\n                          <p>\r\n                            You are only eligible for a refund if you make a\r\n                            request for course cancellation within 1 week of\r\n                            commencement of lectures. After 1 week, you are not\r\n                            eligible to request a refund.\r\n                          </p>\r\n                        </div>\r\n                      </Card.Body>\r\n                    </Accordion.Collapse>\r\n                  </Card>\r\n                  <hr />\r\n                  <h3>Lectures/Class Model</h3>\r\n                  <Card>\r\n                    <Accordion.Toggle as={Card.Header} eventKey='10'>\r\n                      <div className='landing_faq-question' onClick={handleFaq}>\r\n                        <h4>\r\n                          Do I need to have any previous experience or knowledge\r\n                          before coming to learn?\r\n                        </h4>\r\n                        <MdKeyboardArrowDown size='2rem' color='black' />\r\n                      </div>\r\n                    </Accordion.Toggle>\r\n                    <Accordion.Collapse eventKey='10'>\r\n                      <Card.Body>\r\n                        <div className='landing_faq-answer'>\r\n                          <p>\r\n                            Not at all. All our courses are designed to help\r\n                            people from any educational background and\r\n                            experience level achieve a successful career in IT.\r\n                          </p>\r\n                        </div>\r\n                      </Card.Body>\r\n                    </Accordion.Collapse>\r\n                  </Card>\r\n                  <hr />\r\n                  <Card>\r\n                    <Accordion.Toggle as={Card.Header} eventKey='11'>\r\n                      <div className='landing_faq-question' onClick={handleFaq}>\r\n                        <h4>Are classes virtual or physical?</h4>\r\n                        <MdKeyboardArrowDown size='2rem' color='black' />\r\n                      </div>\r\n                    </Accordion.Toggle>\r\n                    <Accordion.Collapse eventKey='11'>\r\n                      <Card.Body>\r\n                        <div className='landing_faq-answer'>\r\n                          <p>\r\n                            For our Graduate Accelerator, classes are 100%\r\n                            physical at our location in Abeokuta and our\r\n                            undergraduate accelerator is held around the school\r\n                            area.\r\n                          </p>\r\n                        </div>\r\n                      </Card.Body>\r\n                    </Accordion.Collapse>\r\n                  </Card>\r\n                  <hr />\r\n                  <Card>\r\n                    <Accordion.Toggle as={Card.Header} eventKey='12'>\r\n                      <div className='landing_faq-question' onClick={handleFaq}>\r\n                        <h4>Can I take the course online?</h4>\r\n                        <MdKeyboardArrowDown size='2rem' color='black' />\r\n                      </div>\r\n                    </Accordion.Toggle>\r\n                    <Accordion.Collapse eventKey='12'>\r\n                      <Card.Body>\r\n                        <div className='landing_faq-answer'>\r\n                          <p>\r\n                            No, you cannot. All courses are strictly onsite for\r\n                            now.\r\n                          </p>\r\n                        </div>\r\n                      </Card.Body>\r\n                    </Accordion.Collapse>\r\n                  </Card>\r\n                  <hr />\r\n                  <Card>\r\n                    <Accordion.Toggle as={Card.Header} eventKey='13'>\r\n                      <div className='landing_faq-question' onClick={handleFaq}>\r\n                        <h4>Can I take two courses at a time?</h4>\r\n                        <MdKeyboardArrowDown size='2rem' color='black' />\r\n                      </div>\r\n                    </Accordion.Toggle>\r\n                    <Accordion.Collapse eventKey='13'>\r\n                      <Card.Body>\r\n                        <div className='landing_faq-answer'>\r\n                          <p>\r\n                            No, you cannot. This is because we want you to be\r\n                            focused and dedicated to a particular course and\r\n                            give it your best.\r\n                          </p>\r\n                        </div>\r\n                      </Card.Body>\r\n                    </Accordion.Collapse>\r\n                  </Card>\r\n                  <hr />\r\n                  <Card>\r\n                    <Accordion.Toggle as={Card.Header} eventKey='14'>\r\n                      <div className='landing_faq-question' onClick={handleFaq}>\r\n                        <h4>What course is right for me?</h4>\r\n                        <MdKeyboardArrowDown size='2rem' color='black' />\r\n                      </div>\r\n                    </Accordion.Toggle>\r\n                    <Accordion.Collapse eventKey='14'>\r\n                      <Card.Body>\r\n                        <div className='landing_faq-answer'>\r\n                          <p>\r\n                            You can give us a call or chat with us for guidance.\r\n                          </p>\r\n                        </div>\r\n                      </Card.Body>\r\n                    </Accordion.Collapse>\r\n                  </Card>\r\n                  <hr />\r\n                  <Card>\r\n                    <Accordion.Toggle as={Card.Header} eventKey='15'>\r\n                      <div className='landing_faq-question' onClick={handleFaq}>\r\n                        <h4>What is the duration of the program?</h4>\r\n                        <MdKeyboardArrowDown size='2rem' color='black' />\r\n                      </div>\r\n                    </Accordion.Toggle>\r\n                    <Accordion.Collapse eventKey='15'>\r\n                      <Card.Body>\r\n                        <div className='landing_faq-answer'>\r\n                          <p>\r\n                            Grazac Academy Graduate Accelerator runs for 4\r\n                            months (3 months of training and 1 month internship)\r\n                            while our Undergraduate Accelerator runs for 2\r\n                            months (Weekends only)\r\n                          </p>\r\n                        </div>\r\n                      </Card.Body>\r\n                    </Accordion.Collapse>\r\n                  </Card>\r\n                  <hr />\r\n                  <Card>\r\n                    <Accordion.Toggle as={Card.Header} eventKey='16'>\r\n                      <div className='landing_faq-question' onClick={handleFaq}>\r\n                        <h4>What is the internship like?</h4>\r\n                        <MdKeyboardArrowDown size='2rem' color='black' />\r\n                      </div>\r\n                    </Accordion.Toggle>\r\n                    <Accordion.Collapse eventKey='16'>\r\n                      <Card.Body>\r\n                        <div className='landing_faq-answer'>\r\n                          <p>\r\n                            You will be grouped into teams alongside other\r\n                            learners to work on real-life projects within the\r\n                            organization.\r\n                          </p>\r\n                        </div>\r\n                      </Card.Body>\r\n                    </Accordion.Collapse>\r\n                  </Card>\r\n                  <hr />\r\n                  <Card>\r\n                    <Accordion.Toggle as={Card.Header} eventKey='17'>\r\n                      <div className='landing_faq-question' onClick={handleFaq}>\r\n                        <h4>What courses do you offer?</h4>\r\n                        <MdKeyboardArrowDown size='2rem' color='black' />\r\n                      </div>\r\n                    </Accordion.Toggle>\r\n                    <Accordion.Collapse eventKey='17'>\r\n                      <Card.Body>\r\n                        <div className='landing_faq-answer'>\r\n                          <p>Our courses are:</p>\r\n                          <p>Product Designing</p>\r\n                          <p>Brand Identity Designing</p>\r\n                          <p>Digital Marketing</p>\r\n                          <p>\r\n                            Front-end Web Development (HTML, CSS, Javascript\r\n                            (ReactJS))\r\n                          </p>\r\n                          <p>Back-end Web Development with Nodejs.</p>\r\n                          <p>\r\n                            Mobile Application Development (Android with Kotlin)\r\n                          </p>\r\n                        </div>\r\n                      </Card.Body>\r\n                    </Accordion.Collapse>\r\n                  </Card>\r\n                  <hr />\r\n                  <Card>\r\n                    <Accordion.Toggle as={Card.Header} eventKey='18'>\r\n                      <div className='landing_faq-question' onClick={handleFaq}>\r\n                        <h4>Can I enroll as a secondary school leaver?</h4>\r\n                        <MdKeyboardArrowDown size='2rem' color='black' />\r\n                      </div>\r\n                    </Accordion.Toggle>\r\n                    <Accordion.Collapse eventKey='18'>\r\n                      <Card.Body>\r\n                        <div className='landing_faq-answer'>\r\n                          <p>\r\n                            No, you cannot but the good news is that we are\r\n                            currently working on bringing up an academy program\r\n                            for secondary school leavers. Follow us\r\n                            @grazacacademy on instagram for more updates.\r\n                          </p>\r\n                        </div>\r\n                      </Card.Body>\r\n                    </Accordion.Collapse>\r\n                  </Card>\r\n                  <hr />\r\n                  <Card>\r\n                    <Accordion.Toggle as={Card.Header} eventKey='19'>\r\n                      <div className='landing_faq-question' onClick={handleFaq}>\r\n                        <h4>\r\n                          What materials do I need to enroll for the course?\r\n                        </h4>\r\n                        <MdKeyboardArrowDown size='2rem' color='black' />\r\n                      </div>\r\n                    </Accordion.Toggle>\r\n                    <Accordion.Collapse eventKey='19'>\r\n                      <Card.Body>\r\n                        <div className='landing_faq-answer'>\r\n                          <p>\r\n                            You need a functional laptop and a ready to learn\r\n                            mindset.\r\n                          </p>\r\n                        </div>\r\n                      </Card.Body>\r\n                    </Accordion.Collapse>\r\n                  </Card>\r\n                  <hr />\r\n                  <Card>\r\n                    <Accordion.Toggle as={Card.Header} eventKey='20'>\r\n                      <div className='landing_faq-question' onClick={handleFaq}>\r\n                        <h4>How accessible are the tutors?</h4>\r\n                        <MdKeyboardArrowDown size='2rem' color='black' />\r\n                      </div>\r\n                    </Accordion.Toggle>\r\n                    <Accordion.Collapse eventKey='20'>\r\n                      <Card.Body>\r\n                        <div className='landing_faq-answer'>\r\n                          <p>\r\n                            Our tutors are always available to respond swiftly\r\n                            to all your questions and offer you support.\r\n                          </p>\r\n                        </div>\r\n                      </Card.Body>\r\n                    </Accordion.Collapse>\r\n                  </Card>\r\n                  <hr />\r\n                  <Card>\r\n                    <Accordion.Toggle as={Card.Header} eventKey='21'>\r\n                      <div className='landing_faq-question' onClick={handleFaq}>\r\n                        <h4>How can I defer a course?</h4>\r\n                        <MdKeyboardArrowDown size='2rem' color='black' />\r\n                      </div>\r\n                    </Accordion.Toggle>\r\n                    <Accordion.Collapse eventKey='21'>\r\n                      <Card.Body>\r\n                        <div className='landing_faq-answer'>\r\n                          <p>There is no opportunity to defer a course.</p>\r\n                        </div>\r\n                      </Card.Body>\r\n                    </Accordion.Collapse>\r\n                  </Card>\r\n                  <hr />\r\n                  <Card>\r\n                    <Accordion.Toggle as={Card.Header} eventKey='22'>\r\n                      <div className='landing_faq-question' onClick={handleFaq}>\r\n                        <h4>\r\n                          What happens If I miss a class due to an emergency?\r\n                        </h4>\r\n                        <MdKeyboardArrowDown size='2rem' color='black' />\r\n                      </div>\r\n                    </Accordion.Toggle>\r\n                    <Accordion.Collapse eventKey='22'>\r\n                      <Card.Body>\r\n                        <div className='landing_faq-answer'>\r\n                          <p>\r\n                            Follow up with what you have missed when you return\r\n                            to class. It is advisable to inform your tutor in\r\n                            case of an emergency.\r\n                          </p>\r\n                        </div>\r\n                      </Card.Body>\r\n                    </Accordion.Collapse>\r\n                  </Card>\r\n                  <hr />\r\n                  <Card>\r\n                    <Accordion.Toggle as={Card.Header} eventKey='23'>\r\n                      <div className='landing_faq-question' onClick={handleFaq}>\r\n                        <h4>\r\n                          Can I enroll for Graduate Accelerator If I am yet to\r\n                          go for NYSC?\r\n                        </h4>\r\n                        <MdKeyboardArrowDown size='2rem' color='black' />\r\n                      </div>\r\n                    </Accordion.Toggle>\r\n                    <Accordion.Collapse eventKey='23'>\r\n                      <Card.Body>\r\n                        <div className='landing_faq-answer'>\r\n                          <p>\r\n                            Yes, if you will be available all through the period\r\n                            of the training which is four (4) months\r\n                          </p>\r\n                        </div>\r\n                      </Card.Body>\r\n                    </Accordion.Collapse>\r\n                  </Card>\r\n                  <hr />\r\n                  <Card>\r\n                    <Accordion.Toggle as={Card.Header} eventKey='24'>\r\n                      <div className='landing_faq-question' onClick={handleFaq}>\r\n                        <h4>What days of the week do the classes hold?</h4>\r\n                        <MdKeyboardArrowDown size='2rem' color='black' />\r\n                      </div>\r\n                    </Accordion.Toggle>\r\n                    <Accordion.Collapse eventKey='24'>\r\n                      <Card.Body>\r\n                        <div className='landing_faq-answer'>\r\n                          <p>Classes are held at least 3 times a week.</p>\r\n                        </div>\r\n                      </Card.Body>\r\n                    </Accordion.Collapse>\r\n                  </Card>\r\n                  <hr />\r\n                  <Card>\r\n                    <Accordion.Toggle as={Card.Header} eventKey='25'>\r\n                      <div className='landing_faq-question' onClick={handleFaq}>\r\n                        <h4>Is there an option for a full-time worker?</h4>\r\n                        <MdKeyboardArrowDown size='2rem' color='black' />\r\n                      </div>\r\n                    </Accordion.Toggle>\r\n                    <Accordion.Collapse eventKey='25'>\r\n                      <Card.Body>\r\n                        <div className='landing_faq-answer'>\r\n                          <p>No, we currently run 100% physical classes.</p>\r\n                        </div>\r\n                      </Card.Body>\r\n                    </Accordion.Collapse>\r\n                  </Card>\r\n                  <hr />\r\n                  <h3>Graduation and Certifications</h3>\r\n                  <Card>\r\n                    <Accordion.Toggle as={Card.Header} eventKey='26'>\r\n                      <div className='landing_faq-question' onClick={handleFaq}>\r\n                        <h4>\r\n                          Will the certificate be recognized locally and\r\n                          globally?\r\n                        </h4>\r\n                        <MdKeyboardArrowDown size='2rem' color='black' />\r\n                      </div>\r\n                    </Accordion.Toggle>\r\n                    <Accordion.Collapse eventKey='26'>\r\n                      <Card.Body>\r\n                        <div className='landing_faq-answer'>\r\n                          <p>\r\n                            Yes. Grazac is a corporate organisation incorporated\r\n                            under the COMPANIES AND ALLIED MATTERS act 1990 and\r\n                            the company is limited by shares with RC 1643778.\r\n                          </p>\r\n                        </div>\r\n                      </Card.Body>\r\n                    </Accordion.Collapse>\r\n                  </Card>\r\n                  <hr />\r\n                  <Card>\r\n                    <Accordion.Toggle as={Card.Header} eventKey='27'>\r\n                      <div className='landing_faq-question' onClick={handleFaq}>\r\n                        <h4>\r\n                          What’s the probability that I will be good after\r\n                          enrolling for Grazac Academy?\r\n                        </h4>\r\n                        <MdKeyboardArrowDown size='2rem' color='black' />\r\n                      </div>\r\n                    </Accordion.Toggle>\r\n                    <Accordion.Collapse eventKey='27'>\r\n                      <Card.Body>\r\n                        <div className='landing_faq-answer'>\r\n                          <p>\r\n                            We have been training youths since 2019 and our\r\n                            success stories speak for us. What differentiates us\r\n                            from other academy is we are practical oriented and\r\n                            what gives us joy is seeing our students making a\r\n                            living after graduating.\r\n                          </p>\r\n                        </div>\r\n                      </Card.Body>\r\n                    </Accordion.Collapse>\r\n                  </Card>\r\n                  <hr />\r\n                  <Card>\r\n                    <Accordion.Toggle as={Card.Header} eventKey='28'>\r\n                      <div className='landing_faq-question' onClick={handleFaq}>\r\n                        <h4>What happens if I fail an exam?</h4>\r\n                        <MdKeyboardArrowDown size='2rem' color='black' />\r\n                      </div>\r\n                    </Accordion.Toggle>\r\n                    <Accordion.Collapse eventKey='28'>\r\n                      <Card.Body>\r\n                        <div className='landing_faq-answer'>\r\n                          <p>\r\n                            We will give you 1 month to revise what you have\r\n                            learnt and after 1 month, we will conduct another\r\n                            exam for you at no extra cost.\r\n                          </p>\r\n                        </div>\r\n                      </Card.Body>\r\n                    </Accordion.Collapse>\r\n                  </Card>\r\n                  <hr />\r\n                  <Card>\r\n                    <Accordion.Toggle as={Card.Header} eventKey='29'>\r\n                      <div className='landing_faq-question' onClick={handleFaq}>\r\n                        <h4>\r\n                          What kind of certificate do I get (Soft or Hard Copy)?\r\n                        </h4>\r\n                        <MdKeyboardArrowDown size='2rem' color='black' />\r\n                      </div>\r\n                    </Accordion.Toggle>\r\n                    <Accordion.Collapse eventKey='29'>\r\n                      <Card.Body>\r\n                        <div className='landing_faq-answer'>\r\n                          <p>\r\n                            For undergraduates, you get a soft copy immediately\r\n                            and a hard copy at our next annual event (Ogun\r\n                            Digital Summit).\r\n                          </p>\r\n                          <p>\r\n                            For graduates, you get both soft copy and hard copy\r\n                            upon successful graduation.\r\n                          </p>\r\n                        </div>\r\n                      </Card.Body>\r\n                    </Accordion.Collapse>\r\n                  </Card>\r\n                  <hr />\r\n                  <Card>\r\n                    <Accordion.Toggle as={Card.Header} eventKey='30'>\r\n                      <div className='landing_faq-question' onClick={handleFaq}>\r\n                        <h4>When do I get my certificate?</h4>\r\n                        <MdKeyboardArrowDown size='2rem' color='black' />\r\n                      </div>\r\n                    </Accordion.Toggle>\r\n                    <Accordion.Collapse eventKey='30'>\r\n                      <Card.Body>\r\n                        <div className='landing_faq-answer'>\r\n                          <p>\r\n                            You get the soft copy certificate upon successful\r\n                            graduation.\r\n                          </p>\r\n                        </div>\r\n                      </Card.Body>\r\n                    </Accordion.Collapse>\r\n                  </Card>\r\n                  <hr />\r\n                  <Card>\r\n                    <Accordion.Toggle as={Card.Header} eventKey='31'>\r\n                      <div className='landing_faq-question' onClick={handleFaq}>\r\n                        <h4>\r\n                          Is a job guaranteed for me after taking the course?\r\n                        </h4>\r\n                        <MdKeyboardArrowDown size='2rem' color='black' />\r\n                      </div>\r\n                    </Accordion.Toggle>\r\n                    <Accordion.Collapse eventKey='31'>\r\n                      <Card.Body>\r\n                        <div className='landing_faq-answer'>\r\n                          <p>\r\n                            For our graduate accelerator, yes!! We outsource all\r\n                            successful graduates to both local and global\r\n                            companies.\r\n                          </p>\r\n                          <p>\r\n                            For our Undergraduate accelerator, whenever we are\r\n                            taking interns, we consider our undergraduate\r\n                            students first and we also share job opportunities\r\n                            with their community group\r\n                          </p>\r\n                          <p>\r\n                            For employment offer, we put all our academy\r\n                            students first.\r\n                          </p>\r\n                        </div>\r\n                      </Card.Body>\r\n                    </Accordion.Collapse>\r\n                  </Card>\r\n                  <hr />\r\n                  <Card>\r\n                    <Accordion.Toggle as={Card.Header} eventKey='32'>\r\n                      <div className='landing_faq-question' onClick={handleFaq}>\r\n                        <h4>What are the prerequisites for graduation?</h4>\r\n                        <MdKeyboardArrowDown size='2rem' color='black' />\r\n                      </div>\r\n                    </Accordion.Toggle>\r\n                    <Accordion.Collapse eventKey='32'>\r\n                      <Card.Body>\r\n                        <div className='landing_faq-answer'>\r\n                          <p>\r\n                            Students must have at least 90% attendance and 70%\r\n                            in projects and challenges.\r\n                          </p>\r\n                        </div>\r\n                      </Card.Body>\r\n                    </Accordion.Collapse>\r\n                  </Card>\r\n                </Accordion>\r\n                <hr />\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n\r\n        <div className='gua_advice'>\r\n          <div className='container'>\r\n            <div className='gua_advice-box'>\r\n              <div className='boxes55'>\r\n                <img\r\n                  src={lady}\r\n                  alt='undergraduate'\r\n                  className='gua_advice-box-img'\r\n                />\r\n              </div>\r\n              <div className='boxes55'>\r\n                <div className='gua_advice-box-text'>\r\n                  <h2>Still have a questions?</h2>\r\n                  <p>\r\n                    Do you need further clarification? Call{' '}\r\n                    <span>0803-302-4644</span> or click on the button below to\r\n                    chat with us.\r\n                  </p>\r\n                  <a href='tel:+2348068365951'>\r\n                    <button>Call us now</button>\r\n                  </a>\r\n                  <a href='https://wa.link/w8e0xs'>\r\n                    <button className='second-button'>Chat with us</button>\r\n                  </a>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n        <Footer />\r\n      </div>\r\n    )\r\n}\r\n\r\nexport default Faq;","C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\context.js",["435","436"],"C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\components\\Loader.js",["437"],{"ruleId":"438","severity":1,"message":"439","line":3,"column":9,"nodeType":"440","messageId":"441","endLine":3,"endColumn":18},{"ruleId":"438","severity":1,"message":"442","line":3,"column":20,"nodeType":"440","messageId":"441","endLine":3,"endColumn":24},{"ruleId":"443","severity":1,"message":"444","line":29,"column":7,"nodeType":"445","endLine":29,"endColumn":9,"suggestions":"446"},{"ruleId":"447","severity":1,"message":"448","line":49,"column":105,"nodeType":"449","endLine":49,"endColumn":120},{"ruleId":"443","severity":1,"message":"450","line":28,"column":6,"nodeType":"445","endLine":28,"endColumn":8,"suggestions":"451"},{"ruleId":"452","severity":1,"message":"453","line":135,"column":25,"nodeType":"454","endLine":135,"endColumn":91},{"ruleId":"452","severity":1,"message":"453","line":72,"column":54,"nodeType":"454","endLine":72,"endColumn":80},{"ruleId":"452","severity":1,"message":"453","line":82,"column":37,"nodeType":"454","endLine":82,"endColumn":102},{"ruleId":"452","severity":1,"message":"453","line":105,"column":109,"nodeType":"454","endLine":105,"endColumn":112},{"ruleId":"452","severity":1,"message":"453","line":118,"column":65,"nodeType":"454","endLine":118,"endColumn":68},{"ruleId":"452","severity":1,"message":"453","line":227,"column":29,"nodeType":"454","endLine":227,"endColumn":32},{"ruleId":"452","severity":1,"message":"453","line"