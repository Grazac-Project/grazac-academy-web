nimport { LoaderContext } from \"./context\";\r\nimport Loader from \"./components/Loader\";\r\nimport 'react-toastify/dist/ReactToastify.css';\r\n\r\nconst LandingPage = lazy(() => {\r\n  return import(\"./pages/Landing\");\r\n});\r\n\r\nconst About = lazy(() => {\r\n  return import(\"./pages/AboutUs\");\r\n});\r\n\r\nconst UndergraduateAccelerator = lazy(() => {\r\n  return import(\"./pages/UndergraduateAccelerator\");\r\n});\r\n\r\n\r\nconst UndergraduateCourseDetail = lazy(() => {\r\n  return import(\"./pages/UndergraduateCourseDetail\");\r\n});\r\n\r\nconst GraduateCourseDetail = lazy(() => {\r\n  return import(\"./pages/GraduateCourseDetail\");\r\n});\r\n\r\nconst Faq = lazy(() => {\r\n  return import(\"./pages/Faq\");\r\n});\r\n\r\nconst Contact = lazy(() => {\r\n  return import(\"./pages/Contact\");\r\n});\r\n\r\n\r\nconst GraduateForm = lazy(() => {\r\n  return import(\"./pages/GraduateForm\");\r\n});\r\n\r\nconst UndergraduateForm = lazy(() => {\r\n  return import(\"./pages/UndergraduateForm\");\r\n});\r\n\r\nconst InternshipForm = lazy(() => {\r\n  return import(\"./pages/InternshipForm\");\r\n});\r\n\r\nconst Hire = lazy(() => {\r\n  return import(\"./pages/Hire\");\r\n});\r\n\r\nconst Profile = lazy(() => {\r\n  return import(\"./pages/Profile\");\r\n});\r\n\r\n\r\nconst Project = lazy(() => {\r\n  return import(\"./pages/Project\");\r\n});\r\n\r\nconst Join = lazy(() => {\r\n  return import(\"./pages/Join\");\r\n});\r\n\r\nconst SignUp = lazy(() => {\r\n  return import(\"./pages/graduateCohort/auth/SignUp\");\r\n});\r\n\r\nconst Login = lazy(() => {\r\n  return import(\"./pages/graduateCohort/auth/Login\");\r\n});\r\n\r\nconst Forgot = lazy(() => {\r\n  return import(\"./pages/graduateCohort/auth/ForgotPassword\");\r\n});\r\n\r\nconst Reset = lazy(() => {\r\n  return import(\"./pages/graduateCohort/auth/ResetPassword\");\r\n});\r\n\r\nconst MailSent = lazy(() => {\r\n  return import(\"./pages/graduateCohort/auth/MailSent\");\r\n});\r\n\r\nconst VerifyMail = lazy(() => {\r\n  return import(\"./pages/graduateCohort/auth/VerifyMail\");\r\n});\r\n\r\nconst DashBoardHome = lazy(() => {\r\n  return import(\"./pages/graduateCohort/dashboard/Main\");\r\n});\r\n\r\n\r\nconst App = () => {\r\n  const [show, setShow] = useState(true);\r\n  const [redirect, setRedirect] = useState(false);\r\n\r\n  const app = useRef();\r\n\r\n  return (\r\n    <LoaderContext.Provider value={{ show, setShow }}>\r\n      {/* {show && <Loader />} */}\r\n\r\n      <Suspense fallback={<Loader />}>\r\n        <div ref={app} className=\"App\" style={{ overflow: \"hidden\" }}>\r\n          <Switch>\r\n            {/* authentication pages */}\r\n            <Route path=\"/signup\" component={SignUp} />\r\n            <Route path=\"/login\" component={Login} />\r\n            <Route path=\"/forgot-password\" component={Forgot} />\r\n            <Route path=\"/reset-password\" component={Reset} />\r\n            <Route path=\"/mail-sent\" component={MailSent} />\r\n            <Route path=\"/account-created\" component={VerifyMail} />\r\n\r\n            {/* Graduate dashboard */}\r\n            <Route path=\"/dashboard\" component={DashBoardHome} />\r\n\r\n            {/* main pages */}\r\n            <Route path=\"/\" exact component={LandingPage}>\r\n              {/* <Redirect to=\"/join\"/>  */}\r\n            </Route>\r\n            <Route path=\"/about-us\" component={About} />\r\n            <Route path=\"/contact\" component={Contact} />\r\n            <Route path=\"/faq\" component={Faq} />\r\n\r\n            {/* Courses (both graduate and undergraduate) and internship */}\r\n            <Route path=\"/course-detail-undergraduate\" component={UndergraduateCourseDetail} />\r\n            <Route path=\"/course-detail-graduate\" component={GraduateCourseDetail} />\r\n            <Route path=\"/graduate-accelerator-plan\" component={GraduateAccelerator} />\r\n            <Route path=\"/undergraduate-accelerator-plan\" component={UndergraduateAccelerator}/>\r\n            <Route path=\"/graduate-form\" component={GraduateForm} />\r\n            <Route path=\"/undergraduate-form\" component={UndergraduateForm} />\r\n            <Route path=\"/internship\" component={InternshipForm} />\r\n\r\n            {/*   hire pages */}\r\n            <Route path=\"/hire\" component={Hire} />\r\n            <Route path=\"/profile\" component={Profile} />\r\n            <Route path=\"/project\" component={Project} />\r\n\r\n            {/* Coming soon page */}\r\n            <Route path=\"/:name/coming-soon\" component={ComingSoon} />\r\n          </Switch>\r\n        </div>\r\n      </Suspense>\r\n    </LoaderContext.Provider>\r\n  );\r\n};\r\n\r\nexport default App;\r\n","C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\reportWebVitals.js",[],"C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\context.js",["230","231"],"import { createContext, useState } from \"react\";\r\nimport Loading from \"./components/Loader\";\r\n\r\nexport const LoaderContext = createContext(null);\r\n\r\n// const Loader = ({ children }) => {\r\n//   const [show, setShow] = useState(true);\r\n\r\n//   return(\r\n// <>\r\n//     {/* <LoaderContext.Provider value={{show, setShow}}>{show ? <Loader /> : children}</LoaderContext.Provider>; */}\r\n//    </>\r\n//     )\r\n// };\r\n\r\n// export default Loader;\r\n","C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\pages\\ComingSoon.js",[],"C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\pages\\UndergraduateAccelerator.js",["232","233","234","235"],"import React, { useState } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport NeedAdvice from \"../components/NeedAdvice\";\r\nimport Qualities from \"../components/Qualities\";\r\n\r\nimport undergraduate from \"../images/undergraduate.png\";\r\nimport SchoolList from \"../components/SchoolList\";\r\nimport Loader from \"../components/Loader\";\r\n\r\nconst UndergraduateAccelerator = () => {\r\n  const [courses, setCourses] = useState([]);\r\n  const [openListModal, setOpenListModal] = useState(false);\r\n\r\n  React.useEffect(() => {\r\n    console.log(\"Undergraduate Accelaerator\");\r\n    document.title = \"Undergraduate Accelerator Track - Grazac Academy\";\r\n    window.scrollTo(0, 0);\r\n      fetch(\"https://grazacacademy.com/undergraduate/courses\")\r\n        .then((resp) => resp.json())\r\n        .then((resp) => {\r\n          console.log(\"false\")\r\n          setCourses(resp.data);\r\n        })\r\n        .catch((error) => {\r\n          console.log(\r\n            \"An error occurred when fetching the available courses, refreshing...\"\r\n          );\r\n        });\r\n  }, []);\r\n\r\n  return (\r\n    <div>\r\n      {courses.length ? (\r\n        <div id=\"blur\">\r\n        <Navbar />\r\n        <div className=\"gua\">\r\n          <div className=\"gua_hero\">\r\n            <div className=\"container\">\r\n              <div className=\"row\">\r\n                <div className=\"col-sm-6\">\r\n                  <div className=\"gua_hero-text\">\r\n                    <div className=\"gua_hero-text-b\">\r\n                      <h1>Undergraduate Accelerator Plan</h1>\r\n                      <p>\r\n                        We equip you to be an asset in the digital age before\r\n                        leaving the four walls of school and we believe the\r\n                        future of work will be strictly skill-based. Join\r\n                        thousands of young undergraduates to build a career in\r\n                        technology and be mentored by industry experts.\r\n                      </p>\r\n                      <div className=\"contact_hero-privacy\">\r\n                        <a href=\"#courses\" className=\"download-brochure\">\r\n                          Join Us Today!\r\n                        </a>\r\n                        <Link to=\"/lead\">\r\n                          <button>Apply as Lead</button>\r\n                        </Link>\r\n                      </div>\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n                <div>\r\n                  <img\r\n                    src={undergraduate}\r\n                    alt=\"undergraduate\"\r\n                    className=\"gua_hero-image\"\r\n                  />\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <div className=\"container\">\r\n            <div className=\"gga\">\r\n              <div className=\"course_mode-intro course_mode-intro\">\r\n                <h4 style={{ marginTop: \"100px\" }}>\r\n                  We are preparing you for the future of work\r\n                </h4>\r\n                <h2>Join our community</h2>\r\n              </div>\r\n            </div>\r\n            <div className=\"gua_highlight\">\r\n              <div className=\"boxes44 gua_highlight-box1\">\r\n                <div className=\"gua_highlight-box3\">\r\n                  <div className=\"gua_highlight-box4\">\r\n                    <h3>\r\n                      <strong>Student Lead</strong>\r\n                    </h3>\r\n                    <p>Become our ambassador in your institution. </p>\r\n                    <p>\r\n                      Lead other students who are ready to prepare themselves\r\n                      for the future of work.\r\n                    </p>\r\n                    <Link to=\"/lead\">\r\n                      <a className=\"white-link\">Apply as Student Lead</a>\r\n                    </Link>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n              <div className=\"boxes44 gua_highlight-box2\">\r\n                <div className=\"gua_highlight-box3\">\r\n                  <div className=\"gua_highlight-box4\">\r\n                    <h3>\r\n                      <strong>Affiliated Campuses</strong>\r\n                    </h3>\r\n                    <p>\r\n                      We are well represented in various institutions of\r\n                      learning across Nigeria.\r\n                    </p>\r\n                    <p>\r\n                      We want to prepare you for the future of work before you\r\n                      leave the four walls of learning.\r\n                    </p>\r\n                    <a\r\n                      className=\"white-link\"\r\n                      onClick={() => setOpenListModal(true)}\r\n                    >\r\n                      Learn More\r\n                    </a>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <div className=\"background1\" id=\"courses\">\r\n            <div className=\"container\">\r\n              <div className=\"gga\">\r\n                <div className=\"course_mode-intro course_mode-intro\">\r\n                  <h2>Available Courses</h2>\r\n                </div>\r\n                <div className=\"gga_container\">\r\n                  {courses.length ? (\r\n                    courses.map((item, index) => (\r\n                      <div className=\"boxes33\" key={index}>\r\n                        <div className=\"gua_cardview\">\r\n                          <div className=\"gua_cardview-box\">\r\n                            <img src={item.thumb} alt=\"course-desc\" />\r\n                          </div>\r\n                          <div className=\"gua_cardview-text\">\r\n                            <h4>{item.name}</h4>\r\n                            <p>{item.description}</p>\r\n                            <Link\r\n                              to={\r\n                                \"/course-detail-undergraduate?course=\" +\r\n                                item.slug\r\n                              }\r\n                            >\r\n                              <a>Learn More</a>\r\n                            </Link>\r\n                          </div>\r\n                        </div>\r\n                      </div>\r\n                    ))\r\n                  ) : (\r\n                    <div>\r\n                      {/* <img src={loader} alt=\"loader\" className=\"loader\" /> */}\r\n                    </div>\r\n                  )}\r\n                  <div className=\"boxes33\">\r\n                    <div className=\"gua_cardview\">\r\n                      <div className=\"gua_cardview-text\">\r\n                        <h4>Can't find a course you are interested in?</h4>\r\n                        <p>\r\n                          We will be glad if you can suggest the course you'd\r\n                          love to learn.\r\n                        </p>\r\n                        <Link to=\"/contact\">\r\n                          <a>Contact Us</a>\r\n                        </Link>\r\n                      </div>\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <Qualities />\r\n          <NeedAdvice />\r\n        </div>\r\n        <Footer />\r\n\r\n        {openListModal && <SchoolList onOpen={(e) => setOpenListModal(e)} />}\r\n      </div>\r\n      ) : (\r\n          <Loader />\r\n      )}\r\n    </div>\r\n  );\r\n\r\n};\r\n\r\nexport default UndergraduateAccelerator;\r\n","C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\pages\\GraduateAccelerator.js",["236"],"import { useState, useEffect } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport NeedAdvice from \"../components/NeedAdvice\";\r\nimport Qualities from \"../components/Qualities\";\r\nimport Graduates from \"../images/graduate.png\";\r\nimport Loader from \"../components/Loader\";\r\nconst 