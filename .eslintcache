      </div>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"boxes33\">\r\n                        <div className=\"gua_cardview\">\r\n                            <div className=\"gua_cardview-box\">\r\n                                <img src={frontend} alt=\"course-desc\" />\r\n                            </div>\r\n                            <div className=\"gua_cardview-text\">\r\n                                <p>Web Development</p>\r\n                                <h4>Frontend Development</h4>\r\n                                <p>This course helps you accelerate your career into Data Analytics. Learn Structured Query Language and Power BI for Data Analytics and Visualization.</p>\r\n                                <Link to=\"/course-detail\"><a>Learn More</a></Link>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"boxes33\">\r\n                        <div className=\"gua_cardview\">\r\n                            <div className=\"gua_cardview-box\">\r\n                                <img src={backend} alt=\"course-desc\" />\r\n                            </div>\r\n                            <div className=\"gua_cardview-text\">\r\n                                <p>Web Development</p>\r\n                                <h4>Bankend Development</h4>\r\n                                <p>This course helps you accelerate your career into Data Analytics. Learn Structured Query Language and Power BI for Data Analytics and Visualization.</p>\r\n                                <Link to=\"/course-detail\"><a>Learn More</a></Link>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"boxes33\">\r\n                        <div className=\"gua_cardview\">\r\n                            <div className=\"gua_cardview-box\">\r\n                                <img src={android} alt=\"course-desc\" />\r\n                            </div>\r\n                            <div className=\"gua_cardview-text\">\r\n                                <p>Mobile Application</p>\r\n                                <h4>Android Development</h4>\r\n                                <p>This course helps you accelerate your career into Data Analytics. Learn Structured Query Language and Power BI for Data Analytics and Visualization.</p>\r\n                                <Link to=\"/course-detail\"><a>Learn More</a></Link>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"boxes33\">\r\n                        <div className=\"gua_cardview\">\r\n                            <div className=\"gua_cardview-box\">\r\n                                <img src={brandidentity} alt=\"course-desc\" />\r\n                            </div>\r\n                            <div className=\"gua_cardview-text\">\r\n                                <p>Design</p>\r\n                                <h4>Brand Identity Design</h4>\r\n                                <p>This course helps you accelerate your career into Data Analytics. Learn Structured Query Language and Power BI for Data Analytics and Visualization.</p>\r\n                                <Link to=\"/course-detail\"><a>Learn More</a></Link>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"boxes33\">\r\n                        <div className=\"gua_cardview\">\r\n                            <div className=\"gua_cardview-box\">\r\n                                <img src={digitalmarketing} alt=\"course-desc\" />\r\n                            </div>\r\n                            <div className=\"gua_cardview-text\">\r\n                                <p>Marketing</p>\r\n                                <h4>Digital Marketing</h4>\r\n                                <p>This course helps you accelerate your career into Data Analytics. Learn Structured Query Language and Power BI for Data Analytics and Visualization.</p>\r\n                                <Link to=\"/course-detail\"><a>Learn More</a></Link>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"boxes33\">\r\n                        <div className=\"gua_cardview\">\r\n                            <div className=\"gua_cardview-box\">\r\n                                <img src={projectmanagement} alt=\"course-desc\" />\r\n                            </div>\r\n                            <div className=\"gua_cardview-text\">\r\n                                <p>Management</p>\r\n                                <h4>Project Management</h4>\r\n                                <p>This course helps you accelerate your career into Data Analytics. Learn Structured Query Language and Power BI for Data Analytics and Visualization.</p>\r\n                                <Link to=\"/course-detail\"><a>Learn More</a></Link>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default PopularCourses;","C:\\Users\\USER\\Desktop\\Web Development\\Bitbucket\\grazac-academy\\src\\components\\PrimaryBtn.js",[],"C:\\Users\\USER\\Desktop\\Web Development\\Bitbucket\\grazac-academy\\src\\components\\Navbar.js",["141","142","143"],"import { useEffect, useState, useRef } from \"react\";\r\nimport { cn } from \"../utils\";\r\nimport NavItem from \"./NavItem\";\r\nimport logo from \"../images/svg/grazac-logo.svg\";\r\nimport PrimaryBtn from \"./PrimaryBtn\";\r\nimport { Link } from \"react-router-dom\";\r\n\r\nconst Navbar = () => {\r\n  const [fixed, setFixed] = useState(false);\r\n  const [active, setActive] = useState(false);\r\n  const [hover, setHover] = useState(false);\r\n  const [click, setClick] = useState(false);\r\n  const nav = useRef(null);\r\n\r\n  useEffect(() => {\r\n    if (nav.current && window.pageYOffset > nav.current.offsetTop)\r\n      setFixed(true);\r\n    else setFixed(false);\r\n    window.addEventListener(\"scroll\", () => {\r\n      if (nav.current && window.pageYOffset > nav.current.offsetTop)\r\n        setFixed(true);\r\n      else setFixed(false);\r\n    });\r\n  });\r\n\r\n  const handleClick = (e) => {\r\n    e.preventDefault();\r\n\r\n    if (active) setActive(false);\r\n    else setActive(true);\r\n  };\r\n\r\n  return (\r\n    <nav className={cn(\"nav\", { \"nav--fixed\": fixed })} ref={nav}>\r\n      <div className=\"nav__container\">\r\n        <div className=\"nav__logo\">\r\n          <Link to=\"/\">\r\n            <img src={logo} alt=\"logo\" />\r\n          </Link>\r\n        </div>\r\n\r\n        <div className={cn(\"nav__menu\", { \"nav__menu--active\": active })}>\r\n          <button className=\"nav-tgl\" onClick={handleClick}>\r\n            <span>&nbsp;</span>\r\n          </button>\r\n\r\n          <ul className=\"nav__list--mb\">\r\n            <li className=\"nav__item\">\r\n              <NavItem exact link=\"/\">\r\n                Home\r\n              </NavItem>\r\n            </li>\r\n            <li className=\"nav__item\">\r\n              <NavItem link=\"/about-us\">About</NavItem>\r\n            </li>\r\n            <li className=\"nav__item\">\r\n              <NavItem link=\"/undergraduate-accelerator-track\">Undergraduate</NavItem>\r\n            </li>\r\n            <li className=\"nav__item\">\r\n              <NavItem link=\"/graduate-accelerator-track\">Graduate</NavItem>\r\n            </li>\r\n            <li className=\"nav__item nav__item--btn\">\r\n              <a href=\"/#tracks\">\r\n                <div className=\"nav__btn\">\r\n                  <div className=\"nav__btn--text\">Enroll Now</div>\r\n                </div>\r\n              </a>\r\n            </li>\r\n          </ul>\r\n        </div>\r\n\r\n        <ul className=\"nav__list\" style={{ marginBottom: 0 }}>\r\n          <li className=\"nav__item\">\r\n            <NavItem exact link=\"/\">\r\n              Home\r\n            </NavItem>\r\n          </li>\r\n          <li className=\"nav__item\">\r\n            <NavItem link=\"/about-us\">About</NavItem>\r\n          </li>\r\n          <li\r\n            className=\"nav__item\"\r\n            style={{ position: \"relative\", cursor: \"pointer\" }}\r\n            onMouseEnter={() => setHover(true)}\r\n            onMouseLeave={() => setHover(false)}\r\n          >\r\n            <a className=\"nav__link\" onClick={(e) => (!click ? setClick(true) : setClick(false))}>\r\n              Academy\r\n            </a>\r\n            <svg\r\n              className=\"mask\"\r\n              width=\"11\"\r\n              height=\"6\"\r\n              viewBox=\"0 0 11 6\"\r\n              fill=\"none\"\r\n              xmlns=\"http://www.w3.org/2000/svg\"\r\n            >\r\n              <path\r\n                fill-rule=\"evenodd\"\r\n                clip-rule=\"evenodd\"\r\n                d=\"M5.50003 6C5.32089 6 5.14252 5.934 4.99716 5.80113L0.282791 1.51511C-0.0503581 1.21251 -0.0959304 0.671616 0.182218 0.308161C0.45958 -0.0552936 0.954589 -0.104154 1.28852 0.198439L5.50867 4.03529L9.72175 0.336449C10.0596 0.0398561 10.5546 0.098146 10.8265 0.466744C11.0984 0.835342 11.0449 1.37452 10.7071 1.67197L5.99268 5.81056C5.8489 5.93657 5.67446 6 5.50003 6Z\"\r\n                fill=\"#575A65\"\r\n              />\r\n            </svg>\r\n\r\n            <div\r\n              className={cn(\"nav__dropdown\", {\r\n                \"nav__dropdown--active\": hover || click,\r\n              })}\r\n            >\r\n              <span></span>\r\n              <ul\r\n                className=\"nav__dropdown--list\"\r\n                onMouseEnter={() => console.log(\"brrrrr\")}\r\n              >\r\n                <li>\r\n                  <Link to=\"/undergraduate-accelerator-track\" className=\"nav__link\">Undergraduate</Link>\r\n                </li>\r\n                <li>\r\n                  <Link to=\"/graduate-accelerator-track\" className=\"nav__link\">Graduate</Link>\r\n                </li>\r\n              </ul>\r\n            </div>\r\n          </li>\r\n          <a href=\"/#tracks\">\r\n            <div className=\"nav__btn\">\r\n              <div className=\"nav__btn--text\">Enroll Now</div>\r\n            </div>\r\n          </a>\r\n        </ul>\r\n      </div>\r\n    </nav>\r\n  );\r\n};\r\n\r\nexport default Navbar;\r\n","C:\\Users\\USER\\Desktop\\Web Development\\Bitbucket\\grazac-academy\\src\\components\\Footer.js",[],"C:\\Users\\USER\\Desktop\\Web Development\\Bitbucket\\grazac-academy\\src\\components\\Mode.js",["144","145","146","147","148"],"C:\\Users\\USER\\Desktop\\Web Development\\Bitbucket\\grazac-academy\\src\\components\\Qualities.js",[],"C:\\Users\\USER\\Desktop\\Web Development\\Bitbucket\\grazac-academy\\src\\components\\NavItem.js",[],{"ruleId":"149","replacedBy":"150"},{"ruleId":"151","replacedBy":"152"},{"ruleId":"153","severity":1,"message":"154","line":22,"column":7,"nodeType":"155","endLine":22,"endColumn":9,"suggestions":"156"},{"ruleId":"157","severity":1,"message":"158","line":94,"column":41,"nodeType":"159","endLine":94,"endColumn":45},{"ruleId":"157","severity":1,"message":"158","line":99,"column":41,"nodeType":"159","endLine":99,"endColumn":45},{"ruleId":"157","severity":1,"message":"158","line":108,"column":41,"nodeType":"159","endLine":108,"endColumn":45},{"ruleId":"157","severity":1,"message":"158","line":113,"column":41,"nodeType":"159","endLine":113,"endColumn":45},{"ruleId":"160","severity":1,"message":"161","line":56,"column":37,"nodeType":"159","endLine":56,"endColumn":63},{"ruleId":"160","severity":1,"message":"161","line":66,"column":37,"