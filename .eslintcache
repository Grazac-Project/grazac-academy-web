n",["357"],"no-negated-in-lhs",["358"],"no-unused-vars","'Redirect' is defined but never used.","Identifier","unusedVar","'Join' is assigned a value but never used.","'redirect' is assigned a value but never used.","'setRedirect' is assigned a value but never used.","'useState' is defined but never used.","'Loading' is defined but never used.","jsx-a11y/anchor-is-valid","The href attribute is required for an anchor to be keyboard accessible. Provide a valid, navigable address as the href value. If you cannot provide an href, but still need the element to resemble a link, use a button and change it with appropriate styles. Learn more: https://github.com/evcohen/eslint-plugin-jsx-a11y/blob/master/docs/rules/anchor-is-valid.md","JSXOpeningElement","'setShow' is assigned a value but never used.","'paper' is defined but never used.","'toggleModal' is assigned a value but never used.","'show' is assigned a value but never used.","react-hooks/exhaustive-deps","React Hook useEffect has a missing dependency: 'setShow'. Either include it or remove the dependency array.","ArrayExpression",["359"],"'content' is assigned a value but never used.","'PrimaryBtn' is defined but never used.","jsx-a11y/iframe-has-title","<iframe> elements must have a unique title property.","React Hook React.useEffect has a missing dependency: 'props.location.search'. Either include it or remove the dependency array.",["360"],"react/jsx-no-target-blank","Using target=\"_blank\" without rel=\"noreferrer\" is a security risk: see https://html.spec.whatwg.org/multipage/links.html#link-type-noopener","JSXAttribute","'closePaymentModal' is defined but never used.","'axios' is defined but never used.","'paymentPlan' is assigned a value but never used.","'txref' is assigned a value but never used.","'setTxref' is assigned a value but never used.","'handleFlutterPayment' is assigned a value but never used.","'setAmount' is assigned a value but never used.","'fetchCourses' is assigned a value but never used.","jsx-a11y/alt-text","img elements must have an alt prop, either with meaningful text, or an empty string for decorative images.","'Link' is defined but never used.","'Row' is defined but never used.","'Col' is defined but never used.","'student' is defined but never used.","'Modal' is defined but never used.","'useContext' is defined but never used.","'object' is defined but never used.","'InfoModal' is defined but never used.","'Kamala' is defined but never used.","'Linkedn' is assigned a value but never used.","'showModal' is assigned a value but never used.","eqeqeq","Expected '!==' and instead saw '!='.","BinaryExpression","unexpected","The href attribute requires a valid value to be accessible. Provide a valid, navigable address as the href value. If you cannot provide a valid href, but still need the element to resemble a link, use a button and change it with appropriate styles. Learn more: https://github.com/evcohen/eslint-plugin-jsx-a11y/blob/master/docs/rules/anchor-is-valid.md","'UnderReview' is defined but never used.","no-global-assign","no-unsafe-negation",{"desc":"361","fix":"362"},{"desc":"363","fix":"364"},"Update the dependencies array to be: [setShow]",{"range":"365","text":"366"},"Update the dependencies array to be: [props.location.search]",{"range":"367","text":"368"},[1951,1953],"[setShow]",[1098,1100],"[props.location.search]"]