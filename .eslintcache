recatedRules":"46"},{"filePath":"89","messages":"90","errorCount":0,"warningCount":19,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"91","messages":"92","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"46"},"C:\\Users\\'Toyosi Adekanmbi\\Desktop\\grazac-academy-web\\src\\index.js",[],["93","94"],"C:\\Users\\'Toyosi Adekanmbi\\Desktop\\grazac-academy-web\\src\\reportWebVitals.js",[],"C:\\Users\\'Toyosi Adekanmbi\\Desktop\\grazac-academy-web\\src\\App.js",[],"C:\\Users\\'Toyosi Adekanmbi\\Desktop\\grazac-academy-web\\src\\pages\\CourseDetail.js",["95","96","97","98","99"],"import React,{useState} from \"react\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport PrimaryBtn from \"../components/PrimaryBtn\";\r\nimport {productDesign} from \"../content/courses.js\";\r\n\r\nimport quote from '../images/svg/quote.svg';\r\nimport sprint from '../images/sprint.png';\r\n\r\nconst CourseDetail = (props) => {\r\n    const [course, setCourse] = useState('')\r\n\r\n    React.useEffect(() => {\r\n        document.title = 'Course Details - Grazac Academy';\r\n        window.scrollTo(0,0);\r\n        const param = props.location.search.substring(8);\r\n        if (param === 'productDesign'){\r\n            setCourse(productDesign)\r\n        }\r\n        console.log(course.benefits)\r\n    },[]);\r\n    \r\n    const RenderOutline = _ => {\r\n        const list = course.outline.map((item, index) => (\r\n            <div key={index}>\r\n                <div className=\"course_learn-main-list\">\r\n                    <div className=\"box1\">\r\n                        <h3>{item.id}</h3>\r\n                    </div>\r\n                    <div className=\"box2\">\r\n                        <h3>{item.topic}</h3>\r\n                    </div>\r\n                    <div className=\"box3\">\r\n                        <p>{item.content}</p>\r\n                    </div>\r\n                </div>\r\n                <hr/>\r\n            </div>\r\n        ))\r\n        return(<div>{list}</div>)\r\n    }\r\n    return(\r\n        <div>\r\n            <Navbar/>\r\n            <div className=\"course\">\r\n                <div className=\"gua_hero\">\r\n                    <div className=\"container\">\r\n                        <div className=\"row\">\r\n                            <div className=\"col-sm-6\">\r\n                                <div className=\"gua_hero-text\">\r\n                                    <div className=\"gua_hero-text-b\">\r\n                                        <h1>\r\n                                            {course.name}\r\n                                        </h1>\r\n                                        <p>\r\n                                            {course.description}\r\n                                        </p>\r\n                                        <div className=\"contact_hero-privacy\" >\r\n                                            <button>Download Brochure</button>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div>\r\n\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"course_learn\">\r\n                    <div className=\"container\">\r\n                        <div className=\"course_wwd-intro\">\r\n                            <h4>GRAZAC ACADEMY</h4>\r\n                            <h2>What you'll Learn</h2>\r\n                        </div>\r\n                        <div className=\"course_learn-main\">\r\n                            <RenderOutline/>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"course_mode\">\r\n                    <div className=\"container\">\r\n                        <div className=\"course_wwd-intro\">\r\n                            <h4>What we do</h4>\r\n                            <h2>Mode Of Teaching</h2>\r\n                            <p>Amet minim mollit non deserunt ullamco est sit aliqua dolor do amet sint. Velit officia consequ</p>\r\n                        </div>\r\n                        <div className=\"course_mode-container\">\r\n                            <div className=\"\">\r\n                                <div>\r\n                                    <div className=\"boxes\">\r\n                                        <div className=\"svg-box\"></div>\r\n                                        <h3></h3>\r\n                                        <p>Learn the foundations of database management with focus on relational database systems and its terminologies.</p>\r\n                                    </div>\r\n                                    <div className=\"boxes\">\r\n                                        <div className=\"svg-box\"></div>\r\n                                        <h3></h3>\r\n                                        <p>Learn the foundations of database management with focus on relational database systems and its terminologies.</p>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div className=\"\">\r\n                                <div>\r\n                                    <div className=\"boxes\">\r\n                                        <div className=\"svg-box\"></div>\r\n                                        <h3></h3>\r\n                                        <p>Learn the foundations of database management with focus on relational database systems and its terminologies.</p>\r\n                                    </div>\r\n                                    <div className=\"boxes\">\r\n                                        <div className=\"svg-box\"></div>\r\n                                        <h3></h3>\r\n                                        <p>Learn the foundations of database management with focus on relational database systems and its terminologies.</p>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div className=\"mode-pic\">\r\n                                <img src={sprint} alt=\"jdgkj\" style={{width:'100%'}} />\r\n                            </div>\r\n                        </div>\r\n                        <div className=\"course_mode-quote\">\r\n                            <img src={quote} alt=\"quote\" />\r\n                            <p>Online learning can be a lifeline to those who have obstacles, such as geographical distances or physical disabilities.</p>\r\n                            <span>Paul Levinson</span>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"course_purple\">\r\n                    <div className=\"course_purple_txt\">\r\n                        <p>Pricing</p>\r\n                        <h1>50%</h1>\r\n                        <p>Scholarship Available</p>\r\n                    </div>\r\n                    <div className=\"course_purple-main\">\r\n                        <div className=\"course_purple-main-boxes\">\r\n                            <h4>FULL TUITION PAYMENT</h4>\r\n                            <h2>₦540,000</h2>\r\n                            <p>Pay your fees 100% upfront. No other charges come up during your career</p>\r\n                        </div>\r\n                        <div className=\"course_purple-main-boxes\">\r\n                            <h4>FULL TUITION PAYMENT</h4>\r\n                            <h2>₦540,000</h2>\r\n                            <p>Pay your fees 100% upfront. No other charges come up during your career</p>\r\n                        </div>\r\n                        <div className=\"course_purple-main-boxes\">\r\n                            <h4>FULL TUITION PAYMENT</h4>\r\n                            <h2>₦540,000</h2>\r\n                            <p>Pay your fees 100% upfront. No other charges come up during your career</p>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"course_purple-btn\">\r\n                        <PrimaryBtn>Claim Scholarship</PrimaryBtn> \r\n                        <p>Talk to course rep</p>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n            <Footer/>\r\n        </div>\r\n    );\r\n}\r\n\r\nexport default CourseDetail;","C:\\Users\\'Toyosi Adekanmbi\\Desktop\\grazac-academy-web\\src\\pages\\GraduateAccelerator.js",[],"C:\\Users\\'Toyosi Adekanmbi\\Desktop\\grazac-academy-web\\src\\pages\\Landing.js",["100"],"C:\\Users\\'Toyosi Adekanmbi\\Desktop\\grazac-academy-web\\src\\pages\\UndergraduateAccelerator.js",["101","102"],"import React from \"react\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport NeedAdvice from \"../components/NeedAdvice\";\r\nimport PopularCourses from \"../components/PopularCourses\";\r\nimport Qualities from \"../components/Qualities\";\r\n\r\nimport undergraduate from \"../images/undergraduate.png\";\r\n\r\nconst UndergraduateAccelerator = () => {\r\n\r\n    React.useEffect(() => {\r\n        document.title = 'Undergraduate Accelerator Track - Grazac Academy';\r\n        window.scrollTo(0,0);\r\n    }, []);\r\n\r\n    return(\r\n        <div>\r\n            <Navbar/>\r\n            <div className=\"gua\">\r\n                <div className=\"gua_hero\">\r\n                    <div className=\"container\">\r\n                        <div className=\"row\">\r\n                            <div className=\"col-sm-6\">\r\n                                <div className=\"gua_hero-text\">\r\n                                    <div className=\"gua_hero-text-b\">\r\n                                        <h1>\r\n                                            Undergraduate Accelerator Track\r\n                                        </h1>\r\n                                        <p>\r\n                                            We equip you for the future of the career you desire.\r\n                                        </p>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div>\r\n                                <img src={undergraduate} alt=\"undergraduate\"  className=\"gua_hero-image\" />\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"container\">\r\n                    <div className=\"gga\">\r\n                        <div className=\"course_mode-intro course_mode-intro\">\r\n                            <h4 style={{marginTop:'100px'}}>How it works</h4>\r\n                            <h2>Highlighted Learning</h2>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"gua_highlight\">\r\n                        <div className=\"boxes44 gua_highlight-box1\">\r\n                            <div className=\"gua_highlight-box3\">\r\n                                <div className=\"gua_highlight-box4\">\r\n                                    <h3><strong>Student Lead</strong></h3>\r\n                                    <p>Become our ambassador in your institution. </p>\r\n                                    <p>Lead other students who are ready to prepare themselves for the future of work.</p>\r\n                                    <a className=\"white-link\">Apply as Student Lead</a>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                        <div className=\"boxes44 gua_highlight-box2\">\r\n                            <div  className=\"gua_highlight-box3\">\r\n                                <div className=\"gua_highlight-box4\">\r\n                                    <h3><strong>Affiliated Campuses</strong></h3>\r\n                                    <p>We are well represented in various institutions of learning across Nigeria.</p>\r\n                                    <p>We want to prepare you for the future of work before you leave the four walls of learning.</p>\r\n                                    <a className=\"white-link\">Learn More</a>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <PopularCourses />\r\n                <Qualities />\r\n                <NeedAdvice />\r\n            </div>\r\n            <Footer/>\r\n        </div>\r\n    );\r\n}\r\n\r\nexport default UndergraduateAccelerator;","C:\\Users\\'Toyosi Adekanmbi\\Desktop\\grazac-academy-web\\src\\pages\\Contact.js",["103"],"import React, { useState, useEffect } from \"react\";\r\nimport axios from 'axios';\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport PrimaryBtn from \"../components/PrimaryBtn\";\r\n\r\nimport Facebook from \"../images/svg/facebook.svg\";\r\nimport Instagram from \"../images/svg/instagram.svg\";\r\nimport Twitter from \"../images/svg/twitter.svg\";\r\nimport Youtube from \"../images/svg/youtube.svg\";\r\nimport kamala from \"../images/kamala.jpg\";\r\n\r\nconst Contact = () => {\r\n\r\n    const [ name, setName ] = useState('');\r\n    const [ email, setEmail ] = useState('');\r\n    const [ subject, setSubject ] = useState('');\r\n    const [ message, setMessage ] = useState('');\r\n\r\n    useEffect(() => {\r\n        document.title = 'Contact - Grazac Academy';\r\n        window.scrollTo(0,0);\r\n    }, []);\r\n\r\n    const handleSubmit = () => {\r\n        if(name.length && email.length && subject.length && message.length) {\r\n            const btn = document.querySelector('#submit');\r\n            btn.setAttribute('disabled', '');\r\n            btn.textContent = 'Submitting...';\r\n            console.log('Submitted')\r\n            axios.post('http://grazacacademy.com/contact/create', {\r\n                name: name,\r\n                email: email,\r\n                subject: subject,\r\n                message: message\r\n            })\r\n            .then(resp => resp.data)\r\n            .then(response => {\r\n                if(response.success === true) {\r\n                    btn.removeAttribute('disabled');\r\n                    btn.textContent = 'Submit';\r\n                    alert(response.msg);\r\n                    setName(''); setEmail(''); setSubject(''); setMessage('');\r\n                } else {\r\n\r\n                }\r\n            })\r\n            .catch((err) => {\r\n                \r\n            });\r\n        } else {\r\n            alert('Invalid input');\r\n        }\r\n    }\r\n\r\n    return(\r\n        <div>\r\n            <Navbar/>\r\n            <div className=\"contact\">\r\n                <div className=\"contact_layer\">\r\n                    <div className=\"container\">\r\n                        <div className=\"contact_layer-text\">\r\n                            <h1>Get In Touch</h1>\r\n                            <p>We want to hear from you. Let us know how we can help</p>\r\n                        </div>\r\n                        <div classname=\"contact_layer-circles\">\r\n                            <img src={kamala} alt=\"kamala\"  classname=\"contact_layer-circles-1\" />\r\n                            <img src={kamala} alt=\"kamala\"  classname=\"contact_layer-circles-2\" />\r\n                            <img src={kamala} alt=\"kamala\"  classname=\"contact_layer-circles-3\" />\r\n                            <img src={kamala} alt=\"kamala\"  classname=\"contact_layer-circles-4\" />\r\n                        </div>\r\n                        <div className=\"contact_hero\">\r\n                            <div className=\"contact_hero-flexdiv\">\r\n                                <div className=\"contact_hero-flexdiv-1\" >\r\n                                    <label>Full Name  <span>*</span></label>\r\n                                    <input type=\"text\" placeholder=\"ex. John Doe\" value={name} onChange={e => setName(e.target.value)} />\r\n                                </div>\r\n                                <div className=\"contact_hero-flexdiv-2\">\r\n                                    <label>Email  <span>*</span></label>\r\n                                    <input type=\"text\" placeholder=\"ex. john@gmail.com\" value={email} onChange={e => setEmail(e.target.value)}  />\r\n                                </div>\r\n                            </div>\r\n                            <div>\r\n                                <label>Subject  <span>*</span></label>\r\n                                <input  type=\"text\" placeholder=\"ex. John Doe\" value={subject} onChange={e => setSubject(e.target.value)}  />\r\n                            </div>\r\n                            <div>\r\n                                <label>Message  <span>*</span></label>\r\n                                <textarea  type=\"text\" placeholder=\"Describe your task for us\" value={message} onChange={e => setMessage(e.target.value)}  />\r\n                            </div>\r\n                            <div className=\"contact_hero-privacy\" >\r\n                                <p>By submitting this form your consent to us emailing you occasionally about our products and services. You can unsubscribe from emails at any time, and we will never pass your email onto third parties. <span>Privacy Policy</span></p>\r\n                                <button id=\"submit\" onClick={handleSubmit}>Submit</button>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"container\">\r\n                    <div className=\"contact_campus\">\r\n                        <div className=\"contact_campus-intro\">\r\n                            <h4>What we do</h4>\r\n                            <h2>Campus Inquiries</h2>\r\n                            <p>Connect with Us</p>\r\n                        </div>\r\n                        <div className=\"contact_campus-main\">\r\n                            <div className=\"contact_campus-main-div boxes33\">\r\n                                <h3>Office</h3>\r\n                                <p>PROHUB, Salawu Olabode Avenue, Ewang Road, </p>\r\n                                <p>Idi-aba, 110124, Abeokuta</p>\r\n                                <p>0906 133 3395</p>\r\n                            </div>\r\n                            <div className=\"contact_campus-main-div boxes33\">\r\n                                <h3>Book A Call</h3>\r\n                                <p>We are here to help with any questions. </p>\r\n                                <p>Talk to our programme leads.</p>\r\n                                <div style={{display:'flex'}}>\r\n                                    <PrimaryBtn>Book A Call</PrimaryBtn>\r\n                                </div>\r\n                            </div>\r\n                            <div className=\"contact_campus-main-div boxes33\">\r\n                                <h3>Social Media</h3>\r\n                                <div className=\"social\">\r\n                                    <img src={Facebook} alt=\"social\"/>\r\n                                </div>\r\n                                <div className=\"social\">\r\n                                    <img src={Twitter} alt=\"social\"/>\r\n                                </div>\r\n                                <div className=\"social\">\r\n                                    <img src={Youtube} alt=\"social\"/>\r\n                                </div>\r\n                                <div className=\"social\">\r\n                                    <img src={Instagram} alt=\"social\"/>\r\n                                </div>\r\n                            </div>\r\n\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div>\r\n                    <iframe width=\"100%\" height=\"600\" frameborder=\"0\" scrolling=\"no\" marginheight=\"0\" marginwidth=\"0\" id=\"gmap_canvas\" src=\"https://maps.google.com/maps?width=520&amp;height=400&amp;hl=en&amp;q=PROHUB,%20Salawu%20Olabode%20Avenue,%20Ewang%20Road,%20Idi-aba,%20110124,%20Abeokuta%20Abeokuta+(Grazac%20Office)&amp;t=&amp;z=15&amp;ie=UTF8&amp;iwloc=B&amp;output=embed\"></iframe>\r\n                </div>\r\n                {/*<extracomponent/> a component used in the landing page comes here*/}\r\n            </div>\r\n            <Footer/>\r\n        </div>\r\n    );\r\n}\r\n\r\nexport default Contact;","C:\\Users\\'Toyosi Adekanmbi\\Desktop\\grazac-academy-web\\src\\pages\\AboutUs.js",["104","105","106","107"],"C:\\Users\\'Toyosi Adekanmbi\\Desktop\\grazac-academy-web\\src\\auth\\Login.js",["108","109","110","111","112","113","114","115","116","117","118","119"],"import { useState } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { cn } from \"../utils\";\r\nimport PrimaryBtn from \"../components/PrimaryBtn\";\r\nimport Grazac from \"../images/grazac.png\";\r\n\r\nconst validEmailRegex = RegExp(\r\n  /^(([^<>()\\[\\]\\.,;:\\s@\\\"]+(\\.[^<>()\\[\\]\\.,;:\\s@\\\"]+)*)|(\\\".+\\\"))@(([^<>()[\\]\\.,;:\\s@\\\"]+\\.)+[^<>()[\\]\\.,;:\\s@\\\"]{2,})$/i\r\n);\r\n\r\nconst Login = () => {\r\n  const [email, setEmail] = useState(\"\");\r\n  const [password, setPassword] = useState(\"\");\r\n  const [emailErr, setEmailErr] =  useState(\"\");\r\n\r\n  \r\n  const handleEmailChange = e => {\r\n    e.preventDefault();\r\n    setEmail(e.target.value)\r\n\r\n    if (!email) setEmailErr(\"\");\r\n    let err = validEmailRegex.test(e.target.value) ? \"\" : \"please enter a valid email address\";\r\n    setEmailErr(err);\r\n  }\r\n\r\n  const handlePasswordChange = e => {\r\n    e.preventDefault();\r\n    setPassword(e.target.value)\r\n  }\r\n\r\n  return(\r\n    <div className=\"auth\">\r\n      <div className=\"auth__body\">\r\n        <div className=\"auth__hero\">\r\n          <img src={Grazac} alt=\"grazac\" />\r\n        </div>\r\n\r\n        <div className=\"auth__form\">\r\n          <div className=\"auth__form--container\">\r\n            <h1>Login</h1>\r\n\r\n            <form className=\"form\">\r\n              <div className=\"form__group\">\r\n                <label for=\"email\">Email address</label>\r\n                <input type=\"email\" id=\"email\" value={email} onChange={handleEmailChange} className={cn(\"form__input\", {\"form__input--err\": emailErr})}/>\r\n              </div>\r\n\r\n              <div className=\"form__group\">\r\n                <label for=\"pass\">Password</label>\r\n                <input type=\"password\" id=\"pass\" value={password} onChange={handlePasswordChange} className=\"form__input\"/>\r\n              </div>\r\n\r\n              <Link className=\"form__link\">Forgot password?</Link>\r\n\r\n              <button type=\"submit\" className=\"form__btn\">\r\n                <PrimaryBtn>Login</PrimaryBtn>\r\n              </button>\r\n            </form>\r\n\r\n            <div className=\"auth__line\">\r\n              <div>&nbsp;</div>\r\n              <span>or</span>\r\n              <div>&nbsp;</div>\r\n            </div>\r\n          </div>\r\n\r\n          <div className=\"auth__btns\">\r\n            <Link className=\"auth__btn\">\r\n              <