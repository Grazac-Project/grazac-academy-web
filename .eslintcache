89 5.50916 5.7177 6.46241 4.54178 6.46241ZM17.901 17.3117C17.901 17.5791 17.6843 17.7958 17.417 17.7958H15.012C14.7447 17.7958 14.528 17.5791 14.528 17.3117V12.905C14.528 12.2476 14.7208 10.0243 12.81 10.0243C11.3279 10.0243 11.0272 11.5461 10.9669 12.2291V17.3117C10.9669 17.5791 10.7502 17.7958 10.4828 17.7958H8.15681C7.88948 17.7958 7.67272 17.5791 7.67272 17.3117V7.83209C7.67272 7.56476 7.88948 7.34801 8.15681 7.34801H10.4828C10.7501 7.34801 10.9669 7.56476 10.9669 7.83209V8.65173C11.5164 7.82696 12.3332 7.19037 14.0722 7.19037C17.9231 7.19037 17.901 10.7881 17.901 12.7648V17.3117Z\" fill=\"#0077B7\"/>\r\n              </svg>\r\n\r\n              Linkedln\r\n            </Link>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default Login;","C:\\Users\\USER\\Desktop\\Web Development\\Bitbucket\\grazac-academy\\src\\content\\courses.js",[],"C:\\Users\\USER\\Desktop\\Web Development\\Bitbucket\\grazac-academy\\src\\utils.js",[],"C:\\Users\\USER\\Desktop\\Web Development\\Bitbucket\\grazac-academy\\src\\components\\NeedAdvice.js",[],"C:\\Users\\USER\\Desktop\\Web Development\\Bitbucket\\grazac-academy\\src\\components\\PopularCourses.js",["159","160","161","162","163","164","165"],"import {Link} from 'react-router-dom';\r\nimport design from \"../images/design.png\";\r\nimport frontend from \"../images/frontend.png\";\r\nimport backend from \"../images/backend.png\";\r\nimport android from \"../images/android.png\";\r\nimport brandidentity from \"../images/brandidentity.png\";\r\nimport digitalmarketing from \"../images/digitalmarketing.png\";\r\nimport projectmanagement from \"../images/projectmanagement.png\";\r\n\r\nconst PopularCourses = () => {\r\n  return(\r\n    <div className=\"background1\">\r\n        <div className=\"container\">\r\n            <div className=\"gga\">\r\n                <div className=\"course_mode-intro course_mode-intro\">\r\n                    <h2>Popular Courses</h2>\r\n                </div>\r\n                <div className=\"gga_container\">\r\n                    <div className=\"boxes33\">\r\n                        <div className=\"gua_cardview\">\r\n                            <div className=\"gua_cardview-box\">\r\n                                <img src={design} alt=\"course-desc\" />\r\n                            </div>\r\n                            <div className=\"gua_cardview-text\">\r\n                                <p>Design</p>\r\n                                <h4>UI/UX Design</h4>\r\n                                <p>This course helps you accelerate your career into Data Analytics. Learn Structured Query Language and Power BI for Data Analytics and Visualization.</p>\r\n                                <Link to=\"/course-detail?course=productDesign\"><a>Learn More</a></Link>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"boxes33\">\r\n                        <div className=\"gua_cardview\">\r\n                            <div className=\"gua_cardview-box\">\r\n                                <img src={frontend} alt=\"course-desc\" />\r\n                            </div>\r\n                            <div className=\"gua_cardview-text\">\r\n                                <p>Web Development</p>\r\n                                <h4>Frontend Development</h4>\r\n                                <p>This course helps you accelerate your career into Data Analytics. Learn Structured Query Language and Power BI for Data Analytics and Visualization.</p>\r\n                                <Link to=\"/course-detail\"><a>Learn More</a></Link>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"boxes33\">\r\n                        <div className=\"gua_cardview\">\r\n                            <div className=\"gua_cardview-box\">\r\n                                <img src={backend} alt=\"course-desc\" />\r\n                            </div>\r\n                            <div className=\"gua_cardview-text\">\r\n                                <p>Web Development</p>\r\n                                <h4>Bankend Development</h4>\r\n                                <p>This course helps you accelerate your career into Data Analytics. Learn Structured Query Language and Power BI for Data Analytics and Visualization.</p>\r\n                                <Link to=\"/course-detail\"><a>Learn More</a></Link>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"boxes33\">\r\n                        <div className=\"gua_cardview\">\r\n                            <div className=\"gua_cardview-box\">\r\n                                <img src={android} alt=\"course-desc\" />\r\n                            </div>\r\n                            <div className=\"gua_cardview-text\">\r\n                                <p>Mobile Application</p>\r\n                                <h4>Android Development</h4>\r\n                                <p>This course helps you accelerate your career into Data Analytics. Learn Structured Query Language and Power BI for Data Analytics and Visualization.</p>\r\n                                <Link to=\"/course-detail\"><a>Learn More</a></Link>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"boxes33\">\r\n                        <div className=\"gua_cardview\">\r\n                            <div className=\"gua_cardview-box\">\r\n                                <img src={brandidentity} alt=\"course-desc\" />\r\n                            </div>\r\n                            <div className=\"gua_cardview-text\">\r\n                                <p>Design</p>\r\n                                <h4>Brand Identity Design</h4>\r\n                                <p>This course helps you accelerate your career into Data Analytics. Learn Structured Query Language and Power BI for Data Analytics and Visualization.</p>\r\n                                <Link to=\"/course-detail\"><a>Learn More</a></Link>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"boxes33\">\r\n                        <div className=\"gua_cardview\">\r\n                            <div className=\"gua_cardview-box\">\r\n                                <img src={digitalmarketing} alt=\"course-desc\" />\r\n                            </div>\r\n                            <div className=\"gua_cardview-text\">\r\n                                <p>Marketing</p>\r\n                                <h4>Digital Marketing</h4>\r\n                                <p>This course helps you accelerate your career into Data Analytics. Learn Structured Query Language and Power BI for Data Analytics and Visualization.</p>\r\n                                <Link to=\"/course-detail\"><a>Learn More</a></Link>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"boxes33\">\r\n                        <div className=\"gua_cardview\">\r\n                            <div className=\"gua_cardview-box\">\r\n                                <img src={projectmanagement} alt=\"course-desc\" />\r\n                            </div>\r\n                            <div className=\"gua_cardview-text\">\r\n                                <p>Management</p>\r\n                                <h4>Project Management</h4>\r\n                                <p>This course helps you accelerate your career into Data Analytics. Learn Structured Query Language and Power BI for Data Analytics and Visualization.</p>\r\n                                <Link to=\"/course-de