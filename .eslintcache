rContext } from \"./context\";\r\nimport Loader from \"./components/Loader\";\r\nimport 'react-toastify/dist/ReactToastify.css';\r\nimport 'react-lazy-load-image-component/src/effects/blur.css';\r\n\r\nconst LandingPage = lazy(() => {\r\n  return import(\"./pages/Landing\");\r\n});\r\n\r\nconst About = lazy(() => {\r\n  return import(\"./pages/AboutUs\");\r\n});\r\n\r\nconst GraduateCourseDetail = lazy(() => {\r\n  return import(\"./pages/GraduateCourseDetail\");\r\n});\r\n\r\nconst Faq = lazy(() => {\r\n  return import(\"./pages/Faq\");\r\n});\r\n\r\nconst Contact = lazy(() => {\r\n  return import(\"./pages/Contact\");\r\n});\r\n\r\nconst Hire = lazy(() => {\r\n  return import(\"./pages/hire\");\r\n});\r\n\r\nconst Listing = lazy(() => {\r\n  return import(\"./pages/hire/Listing\");\r\n});\r\n\r\nconst Profile = lazy(() => {\r\n  return import(\"./pages/hire/Profile\");\r\n});\r\n\r\nconst HireContact = lazy(() => {\r\n  return import(\"./pages/hire/Contact\");\r\n});\r\n\r\nconst SignUp = lazy(() => {\r\n  return import(\"./pages/graduateCohort/auth/SignUp\");\r\n});\r\n\r\nconst Login = lazy(() => {\r\n  return import(\"./pages/graduateCohort/auth/Login\");\r\n});\r\n\r\nconst Forgot = lazy(() => {\r\n  return import(\"./pages/graduateCohort/auth/ForgotPassword\");\r\n});\r\n\r\nconst Reset = lazy(() => {\r\n  return import(\"./pages/graduateCohort/auth/ResetPassword\");\r\n});\r\n\r\nconst MailSent = lazy(() => {\r\n  return import(\"./pages/graduateCohort/auth/MailSent\");\r\n});\r\n\r\nconst VerifyMail = lazy(() => {\r\n  return import(\"./pages/graduateCohort/auth/VerifyMail\");\r\n});\r\n\r\nconst AccountCreated = lazy(() => {\r\n  return import(\"./pages/graduateCohort/auth/AccountCreated\");\r\n});\r\n\r\nconst DashBoardHome = lazy(() => {\r\n  return import(\"./pages/graduateCohort/dashboard/Main\");\r\n});\r\n\r\n\r\nconst App = () => {\r\n  const [show, setShow] = useState(true);\r\n  const [redirect, setRedirect] = useState(false);\r\n\r\n  const app = useRef();\r\n\r\n  return (\r\n    <LoaderContext.Provider value={{ show, setShow }}>\r\n      {/* {show && <Loader />} */}\r\n\r\n      <Suspense fallback={<Loader />}>\r\n        <div ref={app} className=\"App\" style={{ overflow: \"hidden\" }}>\r\n          <Switch>\r\n            {/* authentication pages */}\r\n            <Route path=\"/signup\" component={SignUp} />\r\n            <Route path=\"/login\" component={Login} />\r\n            <Route path=\"/forgot-password\" component={Forgot} />\r\n            <Route path=\"/resetPassword\" component={Reset} />\r\n            <Route path=\"/mail-sent\" component={MailSent} />\r\n            <Route path=\"/account-created\" component={AccountCreated} />\r\n            <Route path=\"/verification\" component={VerifyMail} />\r\n\r\n            {/* Graduate dashboard */}\r\n            <Route path=\"/dashboard\" component={DashBoardHome} />\r\n\r\n            {/* main pages */}\r\n            <Route path=\"/\" exact component={LandingPage}>\r\n              {/* <Redirect to=\"/join\"/>  */}\r\n            </Route>\r\n            {/* <Route path=\"/join\" component={Join}/> */}\r\n            <Route path=\"/about-us\" component={About} />\r\n            <Route path=\"/contact\" component={Contact} />\r\n            <Route path=\"/faq\" component={Faq} />\r\n\r\n            {/* Courses (both graduate and undergraduate) and internship */}\r\n            <Route path=\"/course-detail-graduate\" component={GraduateCourseDetail} />\r\n            {/* <Route path=\"/graduate-accelerator-plan\" component={GraduateAccelerator} />\r\n            <Route path=\"/course-detail-undergraduate\" component={UndergraduateCourseDetail} />\r\n            <Route path=\"/undergraduate-accelerator-plan\" component={UndergraduateAccelerator}/>\r\n            <Route path=\"/graduate-form\" component={GraduateForm} />\r\n            <Route path=\"/undergraduate-form\" component={UndergraduateForm} />\r\n            <Route path=\"/internship\" component={InternshipForm} /> */}\r\n\r\n            {/*   hire pages */}\r\n\r\n            <Route path=\"/hire\" exact component={Hire} />\r\n            <Route path=\"/hire/listing\" component={Listing} />\r\n            <Route path=\"/hire/profile\" component={Profile} />\r\n            <Route path=\"/hire/contact\" component={HireContact} />\r\n\r\n            {/* Coming soon page */}\r\n            {/* <Route path=\"/:name/coming-soon\" component={ComingSoon} /> */}\r\n          </Switch>\r\n        </div>\r\n      </Suspense>\r\n    </LoaderContext.Provider>\r\n  );\r\n};\r\n\r\nexport default App;\r\n","C:\\Users\\mitchel\\Documents\\grazac\\code\\grazac-academy-web\\src\\reportWebVitals.js",[],"C:\\Users\\mitchel\\Documents\\grazac\\code\\grazac-academy-web\\src\\context.js",["199","200"],"import { createContext, useState } from \"react\";\r\nimport Loading from \"./components/Loader\";\r\n\r\nexport const LoaderContext = createContext(null);\r\n\r\n// const Loader = ({ children }) => {\r\n//   const [show, setShow] = useState(true);\r\n\r\n//   return(\r\n// <>\r\n//     {/* <LoaderContext.Provider value={{show, setShow}}>{show ? <Loader /> : children}</LoaderContext.Provider>; */}\r\n//    </>\r\n//     )\r\n// };\r\n\r\n// export default Loader;\r\n","C:\\Users\\mitchel\\Documents\\grazac\\code\\grazac-academy-web\\src\\pages\\GraduateCourseDetail.js",["201","202","203","204"],"import React, { useState } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport PrimaryBtn from \"../components/PrimaryBtn\";\r\nimport MOT from \"../components/MOT\";\r\n\r\nimport paper from \"../images/svg/paper-ribbon.svg\";\r\nimport Loader from \"../components/Loader\";\r\n\r\nconst CourseDetail = (props) => {\r\n  const [course, setCourse] = useState(\"\");\r\n  const [outline, setOutline] = useState([]);\r\n\r\n  React.useEffect(() => {\r\n    document.title = \"Course Details - Grazac Academy\";\r\n    window.scrollTo(0, 0);\r\n    const slug = props.location.search.substring(8);\r\n    console.log(slug)\r\n    // console.log(props)\r\n    \r\n    fetch(`https://api.grazacacademy.com/api/v1/graduate/${slug}`)\r\n      .then((resp) => resp.json())\r\n      .then((resp) => {\r\n        // console.log(JSON.parse(resp.details.outline))\r\n        setCourse(resp.details);\r\n        setOutline(JSON.parse(resp.details.outline));\r\n        console.log(resp)\r\n        // console.log(outline)\r\n      })\r\n      .catch((error) => {\r\n        console.log(error);\r\n        console.log(\r\n          \"An error occurred when fetching course details, refreshing...\"\r\n        );\r\n        // window.location.reload();\r\n      });\r\n\r\n  }, []);\r\n\r\n  return (\r\n    <div>\r\n      {outline.length ? (\r\n        <div id=\"blur\">\r\n        <Navbar />\r\n        <div className=\"course\">\r\n          <div className=\"course_hero\">\r\n            <div className=\"container\">\r\n              {course ? (\r\n                <div className=\"row\">\r\n                  <div className=\"col-sm-6\">\r\n                    <div className=\"course_hero-text\">\r\n                      <div className=\"course_hero-text-b\">\r\n                        <h1>{course.name}</h1>\r\n                        <p>{course.description}</p>\r\n                        <div className=\"contact_hero-privacy\">\r\n                          <a\r\n                            href={course.brochure}\r\n                            className=\"download-brochure\"\r\n                            target=\"_blank\"\r\n                          >\r\n                            Download Brochure\r\n                          </a>\r\n                          <Link to=\"/login\">\r\n                            <button>Apply now</button>\r\n                          </Link>\r\n                        </div>\r\n                      </div>\r\n                    </div>\r\n                  </div>\r\n                  <div>\r\n                    {/* <img src={paper} alt=\"academy\" className=\"gga_hero-image\" /> */}\r\n                  </div>\r\n                </div>\r\n              ) : (\r\n                <div>\r\n                  {/*<img src={loader} alt=\"loader\" className=\"loader\" />*/}\r\n                </div>\r\n              )}\r\n            </div>\r\n          </div>\r\n          <div className=\"course_learn\">\r\n            <div className=\"container\">\r\n              <div className=\"course_wwd-intro\">\r\n                <h4>GRAZAC ACADEMY</h4>\r\n                <h2>What you'll Learn</h2>\r\n              </div>\r\n              <div className=\"course_learn-main\">\r\n                {outline.length ? (\r\n                  outline.map((item, index) => (\r\n                    <div key={index}>\r\n                      <div className=\"course_learn-main-list\">\r\n                        <div className=\"box1\">\r\n                          <h3>{index < 10 ? \"0\" + index : index}</h3>\r\n                        </div>\r\n                        <div className=\"box2\">\r\n                          <h3>{item.topic}</h3>\r\n                        </div>\r\n                        <div className=\"box3\">\r\n                          <p>{item.summary}</p>\r\n                        </div>\r\n                      </div>\r\n                      <hr />\r\n                    </div>\r\n                  ))\r\n                ) : (\r\n                  <div>\r\n                    {/* <img src={loader} alt=\"loader\" className=\"loader\" /> */}\r\n                  </div>\r\n                )}\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <MOT />\r\n        </div>\r\n        <Footer />\r\n      </div>\r\n      ) : (\r\n          <Loader />\r\n      )}\r\n    </div>\r\n  );\r\n\r\n};\r\n\r\nexport default CourseDetail;\r\n","C:\\Users\\mitchel\\Documents\\grazac\\code\\grazac-academy-web\\src\\pages\\AboutUs.js",["205"],"import { useEffect, useContext } from \"react\";\r\n// import { Link } from \"react-router-dom\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport Mode from \"../components/Mode\";\r\nimport Dots from \"../images/svg/dots.svg\";\r\nimport { LoaderContext } from \"../context\";\r\nconst cardsInfo = [\r\n  {\r\n    color: \"39,234,198\",\r\n    title: \"Creativity\",\r\n    body:\r\n      \"We constantly develop ideas that drives innovation. Our company is a community that allow us share common interests and ideas.\",\r\n  },\r\n  {\r\n    color: \"26,222,235\",\r\n    title: \"Quality\",\r\n    body:\r\n      \"We strive to provide value that fulfils and exceeds expectation. We have an unwavering guide that leads the way to fulfilling your goal.\",\r\n  },\r\n  {\r\n    color: \"108,21,250\",\r\n    title: \"Passion\",\r\n    body:\r\n      \"Our enthusiasm to deliver the best makes us unique. We uphold the highest standards in deliverability.\",\r\n  },\r\n  {\r\n    color: \"255,113,155\",\r\n    title: \"Commitment\",\r\n    body:\r\n      \"We are focused on giving best solutions. Our concern is solving your problem rather than why or how the problem was created.\",\r\n  },\r\n  {\r\n    color: \"254,125,108\",\r\n    title: \"Collaboration\",\r\n    body:\r\n      \"Our success depends upon the collective intelligence of our team members and the shared vision of our partners.\",\r\n  },\r\n  {\r\n    color: \"255,180,67\",\r\n    title: \"Teamwork\",\r\n    body:\r\n      \"We do better, together. Our environment fosters progress, effectiveness and speed.\",\r\n  },\r\n];\r\n\r\nconst AboutUs = () => {\r\n  const { setShow } = useContext(LoaderContext);\r\n  useEffect(() => {\r\n    document.title = \"About - Grazac Academy\";\r\n    window.scrollTo(0, 0);\r\n   \r\n  }, []);\r\n\r\n  return (\r\n    <div className=\"about\">\r\n      <Navbar />\r\n      <div className=\"about__top\">\r\n        <div className=\"about__top--container\">\r\n          <div className=\"about__top--up\">\r\n            <div>\r\n              <img src={Dots} alt=\"dots\" />\r\n            </div>\r\n            <div></div>\r\n            <div className=\"about__top--text\">\r\n              <h1>About Us</h1>\r\n              <p>\r\n                At Grazac Academy, we provide you with the right platform to\r\n                upskill yourself for the future.\r\n              </p>\r\n            </div>\r\n          </div>\r\n          <div className=\"about__top--down\">\r\n            <div></div>\r\n            <div></div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <div className=\"about__middle\">\r\n        <div className=\"about__middle--container\">\r\n          <div className=\"about__middle--head\">\r\n            <h2>Our Core Values</h2>\r\n            <p>\r\n              You determine the starting points, we provide the best possible\r\n              interception to achieve the goals.\r\n            </p>\r\n          </div>\r\n\r\n          <div className=\"about__middle--cards\">\r\n            {cardsInfo.map((item) => (\r\n              <div className=\"about__middle--card\">\r\n                <div style={{ \"--bg-color\": item.color }}></div>\r\n                <h3>{item.title}</h3>\r\n                <p>{item.body}</p>\r\n              </div>\r\n            ))}\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <Mode />\r\n      <Footer />\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default AboutUs;\r\n","C:\\Users\\mitchel\\Documents\\grazac\\code\\grazac-academy-web\\src\\pages\\Landing.js",["206","207","208","209","210","211","212","213","214","215","216","217","218","219","220"],"C:\\Users\\mitchel\\Documents\\grazac\\code\\grazac-academy-web\\src\\pages\\Faq.js",[],"C:\\Users\\mitchel\\Documents\\grazac\\code\\grazac-academy-web\\src\\pages\\Contact.js",["221","222"],"import React, { useState, useEffect } from \"react\";\r\nimport axios from 'axios';\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport PrimaryBtn from \"../components/PrimaryBtn\";\r\n\r\nimport Facebook from \"../images/svg/facebook.svg\";\r\nimport Instagram from \"../images/svg/instagram.svg\";\r\nimport Twitter from \"../images/svg/twitter.svg\";\r\nimport Youtube from \"../images/svg/youtube.svg\";\r\n\r\nconst Contact = () => {\r\n\r\n    const [ name, setName ] = useState('');\r\n    const [ email, setEmail ] = useState('');\r\n    const [ subject, setSubject ] = useState('');\r\n    const [ message, setMessage ] = useState('');\r\n\r\n    useEffect(() => {\r\n        document.title = 'Contact - Grazac Academy';\r\n        window.scrollTo(0,0);\r\n    }, []);\r\n\r\n    const handleSubmit = () => {\r\n        if(name.length && email.length && subject.length && message.length) {\r\n            const btn = document.querySelector('#submit');\r\n            btn.setAttribute('disabled', '');\r\n            btn.textContent = 'Submitting...';\r\n            console.log('Submitted')\r\n            axios.post('http://grazacacademy.com/contact/create', {\r\n                name: name,\r\n                email: email,\r\n                subject: subject,\r\n                message: message\r\n            })\r\n            .then(resp => resp.data)\r\n            .then(response => {\r\n                if(response.success === true) {\r\n                    btn.removeAttribute('disabled');\r\n                    btn.textContent = 'Submit';\r\n                    alert(response.msg);\r\n                    setName(''); setEmail(''); setSubject(''); setMessage('');\r\n                } else {\r\n\r\n                }\r\n            })\r\n            .catch((err) => {\r\n                \r\n            });\r\n        } else {\r\n            alert('Invalid input');\r\n        }\r\n    }\r\n\r\n    return(\r\n        <div>\r\n            <Navbar/>\r\n            <div className=\"contact\">\r\n                <div className=\"contact_layer\">\r\n                    <div className=\"container\">\r\n                        <div className=\"contact_layer-text\">\r\n                            <h1>Get In Touch</h1>\r\n                            <p>We want to hear from you. Let us know how we can help</p>\r\n                        </div>\r\n                        {/*<div classname=\"contact_layer-circles\">\r\n                            <img src={kamala} alt=\"kamala\"  classname=\"contact_layer-circles-1\" />\r\n                            <img src={kamala} alt=\"kamala\"  classname=\"contact_layer-circles-2\" />\r\n                            <img src={kamala} alt=\"kamala\"  classname=\"contact_layer-circles-3\" />\r\n                            <img src={kamala} alt=\"kamala\"  classname=\"contact_layer-circles-4\" />\r\n                        </div>*/}\r\n                        <div className=\"contact_hero\">\r\n                            <div className=\"contact_hero-flexdiv\">\r\n                                <div className=\"contact_hero-flexdiv-1\" >\r\n                                    <label>Full Name  <span>*</span></label>\r\n                                    <input type=\"text\" placeholder=\"ex. John Doe\" value={name} onChange={e => setName(e.target.value)} />\r\n                                </div>\r\n                                <div className=\"contact_hero-flexdiv-2\">\r\n                                    <label>Email  <span>*</span></label>\r\n                                    <input type=\"text\" placeholder=\"ex. john@gmail.com\" value={email} onChange={e => setEmail(e.target.value)}  />\r\n                                </div>\r\n                            </div>\r\n                            <div>\r\n                                <label>Subject  <span>*</span></label>\r\n                                <input  type=\"text\" placeholder=\"ex. John Doe\" value={subject} onChange={e => setSubject(e.target.value)}  />\r\n                            </div>\r\n                            <div>\r\n                                <label>Message  <span>*</span></label>\r\n                                <textarea  type=\"text\" placeholder=\"Describe your task for us\" value={message} onChange={e => setMessage(e.target.value)}  />\r\n                            </div>\r\n                            <div className=\"contact_hero-privacy\" >\r\n                                <p>By submitting this form your consent to us emailing you occasionally about our products and services. You can unsubscribe from emails at any time, and we will never pass your email onto third parties. <span>Privacy Policy</span></p>\r\n                                <button id=\"submit\" onClick={handleSubmit}>Submit</button>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"container\">\r\n                    <div className=\"contact_campus\">\r\n                        <div className=\"contact_campus-intro\">\r\n                            <h2>Campus Inquiries</h2>\r\n                            <p>Connect with Us</p>\r\n                        </div>\r\n                        <div className=\"contact_campus-main\">\r\n                            <div className=\"contact_campus-main-div boxes33\">\r\n                                <h3>Office</h3>\r\n                                <p>PROHUB, Salawu Olabode Avenue, Ewang Road, </p>\r\n                                <p>Idi-aba, 110124, Abeokuta</p>\r\n                                <p>+234 806 836 5951</p>\r\n                            </div>\r\n                            <div className=\"contact_campus-main-div boxes33\">\r\n                                <h3>Book A Call</h3>\r\n                                <p>We are here to help with any questions. </p>\r\n                                <p>Talk to our programme leads.</p>\r\n                                <div style={{display:'flex'}}>\r\n                                    <a href=\"tel:+2348068365951\" ><div className=\"nav__btn--text\">Book a Call</div></a>\r\n                                </div>\r\n                            </div>\r\n                            <div className=\"contact_campus-main-div boxes33\">\r\n                                <h3>Social Media</h3>\r\n                                <div className=\"social\">\r\n                                    <img src={Facebook} alt=\"social\"/>\r\n                                </div>\r\n                                <div className=\"social\">\r\n                                    <img src={Twitter} alt=\"social\"/>\r\n                                </div>\r\n                                <div className=\"social\">\r\n                                    <img src={Youtube} alt=\"social\"/>\r\n                                </div>\r\n                                <div className=\"social\">\r\n                                    <img src={Instagram} alt=\"social\"/>\r\n                                </div>\r\n                            </div>\r\n\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div>\r\n                    <iframe src=\"https://www.google.com/maps/d/embed?mid=16NZ9a9VhKkk2-5nnYEdL93mxq7kjDZLT\" width=\"100%\" height=\"600\"></iframe>\r\n                </div>\r\n                {/*<extracomponent/> a component used in the landing page comes here*/}\r\n            </div>\r\n            <Footer/>\r\n        </div>\r\n    );\r\n}\r\n\r\nexport default Contact;","C:\\Users\\mitchel\\Documents\\grazac\\code\\grazac-academy-web\\src\\components\\Loader.js",["223"],"import Modal from \"./Modal\";\r\nimport Logo from \"../images/svg/grazac-icon.svg\";\r\n\r\nconst Loader = () => {\r\n  return (\r\n    <div className=\"loading\">\r\n      <div className=\"loading_container\">\r\n        <div className=\"loading_box \">\r\n          <img src={Logo} className=\"lds-img\" alt=\"ccc\" />\r\n          <div className=\"lds-ring \">\r\n            <div></div>\r\n            <div></div>\r\n            <div></div>\r\n            <div></div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default Loader;\r\n","C:\\Users\\mitchel\\Documents\\grazac\\code\\grazac-academy-web\\src\\pages\\hire\\Listing.js",["224","225","226"],"import { useEffect, useState } from \"react\";\r\nimport Navbar from \"../../components/Navbar\";\r\nimport Footer from \"../../components/Footer\";\r\nimport { Container } from \"react-bootstrap\";\r\nimport { getAllTalents } from \"../../api/dashboard/hire\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { ToastContainer, toast } from 'react-toastify';\r\nimport man from \"../../images/man.jpg\";\r\nimport loader from \"../../images/loader-purple.gif\";\r\nimport arrow from \"../../images/svg/arrow-front.svg\";\r\nimport Loader from \"../../components/Loader\";\r\n\r\n\r\nfunction Listing() {\r\n  const [talents, setTalents] = useState([]);\r\n  const [fetchedPage, setFetchedPage] = useState(\"1\");\r\n  let [page, setPage] = useState(1);\r\n  const [loading, setLoading] = useState(false);\r\n\r\n  const isEmptyObject=(obj)=> {\r\n    var name;\r\n    for (name in obj) {\r\n        if (obj.hasOwnProperty(name)) {\r\n            return false;\r\n        }\r\n    }\r\n    return true;\r\n}\r\n  useEffect(() => {\r\n    document.title = \"Hire - Grazac Academy\";\r\n    window.scrollTo(0, 0);\r\n    fetchTalents(page);\r\n  }, [page]);\r\n\r\n  const fetchTalents = (page) => {\r\n    setLoading(true);\r\n    getAllTalents(page)\r\n      .then((response) => response)\r\n      .then((resp) => {\r\n        setLoading(false);\r\n        if (resp.status === 200) {\r\n          \r\n          console.log(resp.data.data.users.length)\r\n          if (resp.data.data.users.length!==0){\r\n            setFetchedPage(resp.data.data.pageNumber);\r\n            setTalents(resp.data.data.users);\r\n        \r\n          }\r\n          else{\r\n            toast.error(\"End of List!\", {\r\n              position: toast.POSITION.BOTTOM_RIGHT,\r\n            });\r\n          }\r\n          \r\n          \r\n        } \r\n        \r\n        \r\n      })\r\n      .catch((err) => {\r\n        setLoading(false);\r\n        // console.log(err);\r\n        // toast.error(\"There was an error, please try again\", {\r\n        //   position: toast.POSITION.BOTTOM_RIGHT,\r\n        // })\r\n      \r\n      });\r\n  };\r\n\r\n  const selectPage=(page)=>{\r\n    setLoading(true);\r\n      setPage(page);\r\n      fetchTalents();\r\n  }\r\n  const pagination = (type) => {\r\n    if (type === \"next\") {\r\n      setLoading(true);\r\n      setPage(prev => prev + 1);\r\n      fetchTalents();\r\n    } else {\r\n      if (fetchedPage === \"1\") {\r\n      } else {\r\n        setLoading(true);\r\n        setPage(prev => prev - 1);\r\n        fetchTalents();\r\n      }\r\n    }\r\n  };\r\n\r\n  return (\r\n    <div>\r\n<ToastContainer/> \r\n      {isEmptyObject(talents) == false ? (\r\n\r\n        <div>\r\n          <div className=\"hire-bg\">\r\n            <Navbar />\r\n            <div className=\"hire\">\r\n              <div className=\"hire_talents\">\r\n                <h2>Our Top Talents</h2>\r\n              </div>\r\n              <Container>\r\n                {loading ? (\r\n                  <div>\r\n                    <img\r\n                      src={loader}\r\n                      alt=\"loading\"\r\n                      width=\"70px\"\r\n                      style={{ margin: \"50px auto\", display: \"block\" }}\r\n                    />\r\n                  </div>\r\n                ) : (\r\n                  <div>\r\n                    {talents.map((item, idx) => (\r\n                      <Link\r\n                        style={{ color: \"black\" }}\r\n                        to={`/hire/profile?id=${item.id}&/${item.firstName}-${item.lastName}`}\r\n                        key={idx}\r\n                      >\r\n                        <div className=\"hire_listing\">\r\n                          <div className=\"hire_listing-image\">\r\n                            <img src={item.profile_upload} alt=\"man\" />\r\n                          </div>\r\n                          <div className=\"hire_listing-text\">\r\n                            <div className=\"d-flx\">\r\n                              <div>\r\n                                <p className=\"hire_listing-text-1\">\r\n                                  {item.firstName} {item.lastName}\r\n                                </p>\r\n                                <p>\r\n                                  {item.profession} <span>{item.location}</span>\r\n                                </p>\r\n                              </div>\r\n                              <span\r\n                                className={\r\n                                  item.status === \"Hired\"\r\n                                    ? \"hire_listing-text-2-hired\"\r\n                                    : \"hire_listing-text-2-available\"\r\n                                }\r\n                              >\r\n                                {item.status === \"Hired\"\r\n                                  ? \"HIRED\"\r\n                                  : \"AVAILABLE\"}\r\n                              </span>\r\n                            </div>\r\n                            <p className=\"hire_listing-text-3\">\r\n                              {item.shortBio}\r\n                            </p>\r\n                          </div>\r\n                        </div>\r\n                      </Link>\r\n                    ))}\r\n                  </div>\r\n                )}\r\n                <div className=\"hire_listing-pagination\">\r\n                  <div\r\n                    className=\"hire_listing-pagination-text\"\r\n                    onClick={() => pagination(\"prev\")}\r\n                  >\r\n                    <p>Previous</p>\r\n                  </div>\r\n                  {fetchedPage === \"1\" ? (\r\n                    <div></div>\r\n                  ) : (\r\n\r\n                    <div onClick={()=>selectPage(parseInt(fetchedPage) - 1)} className=\"hire_listing-pagination-number\">\r\n                      <p onClick={()=>selectPage(parseInt(fetchedPage) - 1)}>{parseInt(fetchedPage) - 1}</p>\r\n                    </div>\r\n                  )}\r\n\r\n                  <div className=\"hire_listing-pagination-number activePage\">\r\n                    <p>{fetchedPage}</p>\r\n                  </div>\r\n                  {console.log(fetchedPage)}\r\n                  \r\n                  <div onClick={()=>selectPage(parseInt(fetchedPage) + 1)} className=\"hire_listing-pagination-number\">\r\n                    <p onClick={()=>selectPage(parseInt(fetchedPage) + 1)}>{parseInt(fetchedPage) + 1}</p>\r\n                  </div>\r\n                  <div\r\n                    className=\"hire_listing-pagination-text\"\r\n                    onClick={() => pagination(\"next\")}\r\n                  >\r\n                    <p>Next</p>\r\n                  </div>\r\n                </div>\r\n              </Container>\r\n            </div>\r\n            <Footer />\r\n          </div>\r\n        </div>\r\n      ) : (\r\n        <div>\r\n          <Loader />\r\n        </div>\r\n      )}\r\n    </div>\r\n  );\r\n}\r\nexport default Listing;\r\n","C:\\Users\\mitchel\\Documents\\grazac\\code\\grazac-academy-web\\src\\pages\\hire\\Contact.js",["227"],"import { Container, Row, Col } from \"react-bootstrap\";\r\nimport Navbar from \"../../components/Navbar\";\r\nimport Footer from \"../../components/Footer\";\r\nimport { useEffect, useState } from \"react\";\r\nimport { submitContact } from \"../../api/dashboard/hire\";\r\n\r\nimport telephone from \"../../images/svg/telephone.svg\";\r\nimport location from \"../../images/svg/location.svg\";\r\nimport email from \"../../images/svg/email-white.svg\";\r\nimport loader from \"../../images/loader.gif\";\r\n\r\nfunction Contact() {\r\n  const [data, setData] = useState({\r\n    your_name: \"\",\r\n    email_address: \"\",\r\n    // contact_number: \"\",\r\n    company_name: \"\",\r\n    // company_website: \"\",\r\n    // hiring_location: \"\",\r\n    subject: \"\",\r\n    inquiry: \"\",\r\n  });\r\n\r\n  const handleChange = (e) => {\r\n    setData({\r\n      ...data,\r\n      [e.target.name]: e.target.value,\r\n    });\r\n  };\r\n\r\n  const submitForm = (e) => {\r\n    e.preventDefault();\r\n    const btn = document.getElementById(\"contact_submit\");\r\n    btn.innerHTML = `<img src=${loader} alt=\"loader\" width=\"20px\" />`;\r\n    let payload = JSON.stringify({\r\n      your_name: data.your_name,\r\n      email_address: data.email_address,\r\n      subject: data.subject,\r\n      inquiry: data.inquiry,\r\n      // contact_number: data.contact_number,\r\n      company_name: data.contact_number,\r\n      // company_website: data.company_website,\r\n      // hiring_location: data.hiring_location,\r\n    });\r\n\r\n    console.log(payload);\r\n    submitContact(payload)\r\n      .then((response) => response)\r\n      .then((resp) => {\r\n        console.log(resp);\r\n        if (resp.status === 200) {\r\n          alert(`${resp.data.message}`);\r\n          document.getElementById(\"contact_form\").reset();\r\n        } else {\r\n          alert(\r\n            `Something went wrong, please try again!!! Message: ${resp.data.message}`\r\n          );\r\n        }\r\n        btn.innerHTML = `Send Message`;\r\n      })\r\n      .catch((err) => {\r\n        console.log(err);\r\n        alert(`Something went wrong, please try again!!!`);\r\n        btn.innerHTML = `Send Message`;\r\n      });\r\n  };\r\n\r\n  return (\r\n    <div className=\"hire-bg\">\r\n      <Navbar />\r\n      <div className=\"hire\">\r\n        <Container>\r\n          <div className=\"hire_contact\">\r\n            <Container>\r\n              <Row>\r\n                <Col md={6}>\r\n                  <div className=\"hire_contact-text\">\r\n                    <h2>Get In Touch</h2>\r\n                    <p className=\"hire_contact-text-1\">\r\n                      Fill up the form and our support staff will get back to\r\n                      you as soon as possible\r\n                    </p>\r\n                    <div className=\"hire_contact-text-box\">\r\n                      <div className=\"hire_contact-text-box-flx\">\r\n                        <img src={telephone} alt=\"icon\" />\r\n                        <p>+234 806 836 5951</p>\r\n                      </div>\r\n                    </div>\r\n                    <div className=\"hire_contact-text-box\">\r\n                      <div className=\"hire_contact-text-box-flx\">\r\n                        <img src={email} alt=\"icon\" />\r\n                        <p>hire@grazacacademy.com</p>\r\n                      </div>\r\n                    </div>\r\n                    <div className=\"hire_contact-text-box\">\r\n                      <div className=\"hire_contact-text-box-flx\">\r\n                        <img src={location} alt=\"icon\" />\r\n                        <p>\r\n                          PROHUB, Suite 302, Salawu Olabode Avenue, Ewang Road,\r\n                          Idi Aba, Abeokuta, Ogun State.\r\n                        </p>\r\n                      </div>\r\n                    </div>\r\n                  </div>\r\n                </Col>\r\n                <Col md={6}>\r\n                  <div className=\"hire_contact-form\">\r\n                    <form onSubmit={submitForm} id=\"contact_form\">\r\n                      <input\r\n                        type=\"text\"\r\n                        required\r\n                        name=\"your_name\"\r\n                        placeholder=\"Your Name\"\r\n                        onChange={handleChange}\r\n                      />\r\n                      {/* <input\r\n                        type=\"text\"\r\n                        required\r\n                        name=\"contact_number\"\r\n                        placeholder=\"Contact Number\"\r\n                        onChange={handleChange}\r\n                      /> */}\r\n                      <input\r\n                        type=\"text\"\r\n                        required\r\n                        name=\"company_name\"\r\n                        placeholder=\"Company Name\"\r\n                        onChange={handleChange}\r\n                      />\r\n{/* \r\n                      <input\r\n                        type=\"text\"\r\n                        required\r\n                        name=\"company_website\"\r\n                        placeholder=\"Company Website\"\r\n                        onChange={handleChange}\r\n                      /> */}\r\n                      {/* <input\r\n                        type=\"text\"\r\n                        required\r\n                        name=\"hiring_location\"\r\n                        placeholder=\"Hiring Location\"\r\n                        onChange={handleChange}\r\n                      /> */}\r\n\r\n                      <input\r\n                        type=\"email\"\r\n                        required\r\n                        name=\"email_address\"\r\n                        placeholder=\"Email Address\"\r\n                        onChange={handleChange}\r\n                      />\r\n                      <input\r\n                        type=\"text\"\r\n                        required\r\n                        name=\"subject\"\r\n                        placeholder=\"Subject\"\r\n                        onChange={handleChange}\r\n                      />\r\n                      <textarea\r\n                        placeholder=\"Message\"\r\n                        name=\"inquiry\"\r\n                        required\r\n                        rows=\"6\"\r\n                        onChange={handleChange}\r\n                      />\r\n                      <button type=\"submit\" id=\"contact_submit\">\r\n                        Send Message\r\n                      </button>\r\n                    </form>\r\n                  </div>\r\n                </Col>\r\n              </Row>\r\n            </Container>\r\n          </div>\r\n        </Container>\r\n      </div>\r\n      <Footer />\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default Contact;\r\n","C:\\Users\\mitchel\\Documents\\grazac\\code\\grazac-academy-web\\src\\pages\\hire\\Profile.js",["228","229","230","231","232"],"import Navbar from \"../../components/Navbar\";\r\nimport Footer from \"../../components/Footer\";\r\nimport { Container } from \"react-bootstrap\";\r\nimport { useEffect, useState } from \"react\";\r\nimport { getOneTalent } from \"../../api/dashboard/hire\";\r\nimport { Link } from 'react-router-dom';\r\n\r\nimport arrow from \"../../images/svg/arrow-front.svg\";\r\nimport purpleBack from \"../../images/svg/purple-back.svg\";\r\nimport instagram from \"../../images/svg/icons8-instagram.svg\";\r\nimport facebook from \"../../images/svg/icons8-facebook.svg\";\r\nimport twitter from \"../../images/svg/icons8-twitter.svg\";\r\nimport github from \"../../images/svg/icons8-github.svg\";\r\nimport linkedin from \"../../images/svg/icons8-linkedin.svg\";\r\nimport profile from \"../../images/man.jpg\";\r\nimport Loader from \"../../components/Loader\";\r\n\r\n\r\nfunction Profile () {\r\n    const talentId = new URLSearchParams(window.location.search).get('id');\r\n    const [education, setEducation] = useState([]);\r\n    const [award, setAward] = useState([]);\r\n    const [project, setProject] = useState([]);\r\n    const [talent, setTalent] = useState({});\r\n\r\n\r\n    const isEmptyObject=(obj)=> {\r\n        var name;\r\n        for (name in obj) {\r\n            if (obj.hasOwnProperty(name)) {\r\n                return false;\r\n            }\r\n        }\r\n        return true;\r\n    }\r\n    \r\n\r\n    useEffect(()=>{\r\n        getOneTalent(talentId)\r\n            .then(response => response)\r\n            .then(resp => {\r\n                if(resp.status===200){\r\n                    setTalent(resp.data.profile.user);\r\n                    setEducation(resp.data.profile.education);\r\n                    setAward(resp.data.profile.award);\r\n                    setProject(resp.data.profile.project);\r\n                    console.log(resp.data.profile.project)\r\n                } else {\r\n                    alert(`Something went wrong, please try again!!! Message: ${resp.data.message}`)\r\n                }\r\n            })\r\n            .catch(err => {\r\n                console.log(err)\r\n                alert(`Something went wrong, please try again!!!`)\r\n            })\r\n    }, []);\r\n\r\n    \r\n    return (\r\n        <div>\r\n      {/* {console.log(isEmptyObject(talent))} */}\r\n\r\n       \r\n        {isEmptyObject(talent) == false ? \r\n       ( <div>\r\n        <div className=\"hire-bg\">\r\n        <Navbar/>\r\n        <div className=\"hire\">\r\n            <Container>\r\n                <div className=\"hire_profile\">\r\n                    <div className=\"hire_profile-main\">\r\n                        <div>\r\n                            <Link to=\"/hire/listing\"><img src={purpleBack} alt=\"back\" width=\"100px\" className=\"purpleBack\" /></Link>\r\n                            <div className=\"hire_profile-main-bio\">\r\n                                <div className=\"hire_profile-main-bio-image1\">\r\n                                    <div className=\"hire_profile-main-bio-image\">\r\n                                        <img src={talent.profile_upload} alt=\"profile\" />\r\n                                    </div>\r\n                                    <div className=\"hire_profile-main-bio-icons\">\r\n                                        {talent?.github===\"\"?<div></div>:<a href={talent?.github}><img src={github} alt=\"github\" /></a>}\r\n                                        {talent?.linkedin===\"\"?<div></div>:<a href={talent?.linkedin}><img src={linkedin} alt=\"linkedin\" /></a>}\r\n                                        {talent?.twitter===\"\"?<div></div>:<a href={talent?.twitter}><img src={twitter} alt=\"twitter\" /></a>}\r\n                                        {/* <a href={talent?.facebook}><img src={facebook} alt=\"facebook\" /></a> */}\r\n                                        {talent?.instagram===\"\"?<div></div>:<a href={talent?.instagram}><img src={instagram} alt=\"instagram\" /></a>}\r\n                                    </div>\r\n                                </div>\r\n\r\n                                <div className=\"hire_profile-main-bio-text\">\r\n                                    <div className=\"hire_profile-main-info\">\r\n                                        <p className=\"text-1\">{talent?.firstName} {talent?.lastName}</p>\r\n                                        <p>{talent?.profession} <span>{talent?.location}</span></p>\r\n                                        <p className={talent?.status===\"Unhired\" ? \"available\" : \"hired\"}>{talent?.status ==\"Unhired\" ? \"Available\":\"Hired\"}</p>\r\n                                        {/* {console.log(talent.status)} */}\r\n                                        <p>{talent?.shortBio}</p>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                        </div> \r\n\r\n                        <div className=\"hire_profile-main-info\">\r\n                            <div>\r\n                                <h4>Education</h4>\r\n                                <hr/>\r\n                                <div className=\"hire_profile-main-info-shift\">\r\n                                    {education?.map((item, idx)=> (\r\n                                        <div key={idx}>\r\n                                            <p className=\"text-1\">{item.institution}</p>\r\n                                            <p>{item.course}</p>\r\n                                            <p>{item.startYear} - {item.endYear}</p>\r\n                                            <hr/>\r\n                                        </div>\r\n                                    ))}\r\n                                </div>\r\n                            </div>\r\n                            <div>\r\n                                <h4>Award &#38; Certification</h4>\r\n                                <hr/>\r\n                                <div className=\"hire_profile-main-info-shift\">\r\n                                    {award?.map((item, idx)=> (\r\n                                        <div key={idx}>\r\n                                            <p className=\"text-1\">{item.title}</p>\r\n                                            <p>{item.awarder}</p>\r\n                                            <p>{item.yearAwarded}</p>\r\n                                            <hr/>\r\n                                        </div>\r\n                                    ))}\r\n                                </div>\r\n                            </div>\r\n                            <div>\r\n                                <h4>Projects and Experience</h4>\r\n                                <hr/>\r\n                                <div className=\"hire_profile-main-info-shift\">\r\n                                    {project?.map((item, idx)=> (\r\n                                        <div key={idx}>\r\n                                            <div className=\"hire_profile-main-info-shift-flx\">\r\n                                                <div className=\"hire_profile-main-info-shift-flx-1\">\r\n                                                    <p className=\"text-1\">{item.role}</p>\r\n                                                    <p>{item.startYear} - {item.endYear}</p>\r\n                                                </div>\r\n                                                <div className=\"hire_profile-main-info-shift-flx-2\">\r\n                                                    <p className=\"text-1\">{item.title}</p>\r\n                                                    {/* {console.log(item)} */}\r\n                                                    <p className=\"text__1__description\">\r\n                                                        {item.description}\r\n                                                    </p>\r\n                                                  \r\n                                                    <p>  <a href={item.project_link}>{item.project_link}</a>  </p>\r\n                                                </div>\r\n                                            </div>\r\n                                            <hr/>\r\n                                        </div>\r\n                                    ))}\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div style={{display:\"flex\", justifyContent:\"center\"}}>\r\n                        <Link to=\"/hire/listing\"><button className=\"hire_profile-backBtn\"><img src={arrow} alt=\"alt\" />Back To Listing</button></Link>\r\n                        <Link to=\"/hire/contact\"><button className=\"hire_profile-backBtn2\">Contact Us<img src={arrow} alt=\"alt\" /></button></Link>\r\n                    </div>\r\n                </div>\r\n            </Container>\r\n        </div>\r\n        <Footer/>\r\n    </div>   \r\n\r\n        \r\n        </div>)\r\n    :\r\n(<div>\r\n<Loader />\r\n</div>)\r\n}\r\n\r\n</div>\r\n    )\r\n}\r\n\r\nexport default Profile;","C:\\Users\\mitchel\\Documents\\grazac\\code\\grazac-academy-web\\src\\pages\\graduateCohort\\auth\\Login.js",["233"],"import { useState } from 'react';\r\nimport { Link } from \"react-router-dom\";\r\nimport { LoginAction } from \"../../../api/dashboard/auth\";\r\nimport { ToastContainer, toast } from 'react-toastify';\r\nimport { LazyLoadImage } from 'react-lazy-load-image-component';\r\n\r\nimport logo from '../../../images/svg/academy-logo.svg';\r\nimport visible from '../../../images/svg/visible.svg';\r\nimport notvisible from '../../../images/svg/notvisible.svg';\r\nimport loader from \"../../../images/svg/dashboard/loader.gif\";\r\nimport authImg from '../../../images/auth.png';\r\n\r\n\r\nfunction Login () {\r\n    const [form, setForm] = useState({\r\n        email: \"\",\r\n        password: \"\"\r\n    });\r\n\r\n    const handleChange = (e) => {\r\n        setForm({\r\n            ...form,\r\n            [e.target.name]: e.target.value\r\n        })\r\n    }\r\n\r\n    const doLogin = (e) => {\r\n        e.preventDefault();\r\n        var btn = document.getElementById(\"actionBtn\");\r\n        btn.innerHTML=`<img src=${loader} width=\"20px\" />`;\r\n        const { email, password } = form;\r\n        var data  = new FormData();\r\n\r\n        data.append(\"email\", email);\r\n        data.append(\"password\", password);\r\n\r\n        LoginAction(data)\r\n            .then((response) => response.data)\r\n            .then((res) => {\r\n                console.log(res);\r\n                if (res.status === 201) {\r\n                    toast.success(`${res.message}! Redirecting to dashboard...`);\r\n\r\n                    sessionStorage.setItem(\r\n                        \"user_details\",\r\n                        JSON.stringify({\r\n                        firstName: res.data.payload.FirstName,\r\n                        lastName: res.data.payload.LastName,\r\n                        email: res.data.payload.email,\r\n                        id: res.data.payload.id,\r\n                        isPaid: res.data.payload.isPaid,\r\n                        phone: res.data.phoneNumber,\r\n                        token: res.data.token\r\n                        })\r\n                    ); \r\n                    sessionStorage.setItem(\r\n                        \"status\", `${res.data.status}`\r\n                    ); \r\n                \r\n                    btn.innerHTML=`Sign in`;\r\n                    setTimeout( function (){window.location = '/dashboard';}, 2500)\r\n                } else {\r\n                    toast.error(\"Something went wrong, please try again!!!\")\r\n                }\r\n            })\r\n            .catch((err) => {\r\n\r\n                console.log(err.response)\r\n                console.log(err)\r\n                toast.error(err.response.data.message);\r\n\r\n\r\n                if(err.response.data.message){\r\n\r\n                    console.log(err.response.data.message)\r\n                    console.log(err.response.data)\r\n                    console.log(err.response)\r\n                    console.log(err)\r\n                    toast.error(err.response.data.message);\r\n                    btn.innerHTML=`Sign in`;\r\n\r\n                } else{\r\n                    toast.error(\"Something went wrong!!! Please make sure you have a good internet connection.\");\r\n                    btn.innerHTML=`Sign in`;\r\n                }\r\n            });\r\n    }\r\n\r\n    const toggleIcon = () => {\r\n        var x = document.getElementById(\"password\");\r\n        var iconContainer = document.getElementById(\"toggle\");\r\n        if (x.type === \"password\") {\r\n          x.type = \"text\";\r\n          iconContainer.innerHTML = `<img src=${notvisible} />`\r\n        } else {\r\n          x.type = \"password\";\r\n          iconContainer.innerHTML = `<img src=${visible} />` ;\r\n        }\r\n    }\r\n\r\n    return(\r\n        <div className=\"layout_auth\">\r\n            <ToastContainer/>\r\n            <div className=\"layout_auth-main\">\r\n                <div className=\"auth_container\">\r\n                    <div className=\"auth_container-logo\" >\r\n                        <Link to=\"/\">\r\n                            <img src={logo} alt=\"logo\" />\r\n                        </Link>\r\n                    </div>\r\n                    <div className=\"auth_container_form\">\r\n                        <h3>Login to your account</h3>\r\n                        <p className=\"auth_container_form-text\">Enter your email address and password to continue.</p>\r\n                        <form onSubmit={doLogin}>\r\n                            <div>\r\n                                <label>Email Address</label>\r\n                                <input type=\"email\" required placeholder=\"Email Address\" name=\"email\" onChange={handleChange} />\r\n                            </div>\r\n                            <div className=\"auth_container_form-password\">\r\n                                <label>Password</label>\r\n                                <input type=\"password\" required id=\"password\" placeholder=\"Password\" name=\"password\" onChange={handleChange} />\r\n                                <div id=\"toggle\" onClick={toggleIcon} ><img src={visible} /></div>\r\n                            </div>\r\n                            <button type=\"submit\" id=\"actionBtn\">Sign in</button>\r\n                            <p><Link to=\"/forgot-password\"><span>Forgot your password?</span></Link></p>\r\n                            <p>Don't have an account? <Link to=\"/signup\"><span>Sign up</span></Link></p>\r\n                            {/* <p>Don't have an account? <span onClick={()=>toast.info('Application into Cohort (CH011) is closed. Enrollment into CH012 begins July 2022')}>Sign up</span></p> */}\r\n                        </form>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n            <div className=\"layout_auth-image\">\r\n                <LazyLoadImage src={authImg} effect=\"blur\" alt=\"auth\" height=\"auto\" width=\"100%\" />\r\n            </div>\r\n        </div>\r\n    )\r\n}\r\n\r\nexport default Login;","C:\\Users\\mitchel\\Documents\\grazac\\code\\grazac-academy-web\\src\\pages\\graduateCohort\\auth\\ForgotPassword.js",[],"C:\\Users\\mitchel\\Documents\\grazac\\code\\grazac-academy-web\\src\\pages\\graduateCohort\\auth\\SignUp.js",["234","235","236"],"import { useEffect, useState } from 'react';\r\nimport { Link } from \"react-router-dom\";\r\nimport { ToastContainer, toast } from 'react-toastify';\r\nimport { SignupAction } from \"../../../api/dashboard/auth\";\r\nimport { LazyLoadImage } from 'react-lazy-load-image-component';\r\n\r\nimport authImg from '../../../images/auth.png';\r\nimport logo from '../../../images/svg/academy-logo.svg';\r\nimport visible from '../../../images/svg/visible.svg';\r\nimport notvisible from '../../../images/svg/notvisible.svg';\r\nimport loader from \"../../../images/svg/dashboard/loader.gif\";\r\n\r\n\r\nfunction SignUp () {\r\n    const [form, setForm] = useState({\r\n        firstName: \"\",\r\n        lastName: \"\",\r\n        email: \"\",\r\n        phone: \"\",\r\n        password: \"\"\r\n    });\r\n\r\n    const handleChange = (e) => {\r\n        setForm({\r\n            ...form,\r\n            [e.target.name]: e.target.value\r\n        })\r\n    }\r\n\r\n    async function doSignUp  (e)  {\r\n        e.preventDefault();\r\n        var btn = document.getElementById(\"actionBtn\");\r\n    \r\n\r\n        if (form.password.length > 5){\r\n            // btn.innerHTML=`<img src=${loader} width=\"20px\" />`;\r\n            const {firstName, lastName, email, phone, password} = form;\r\n            var data  = new FormData();\r\n            const phone_length=phone.length\r\n            console.log(phone, phone_length)\r\n\r\n            if (phone_length == 11 || phone_length > 11 ){\r\n                data.append(\"firstName\", firstName);\r\n                data.append(\"lastName\", lastName);\r\n                data.append(\"email\", email);\r\n                data.append(\"phoneNumber\", phone);\r\n                data.append(\"password\", password);\r\n\r\n                btn.innerHTML=`<img src=${loader} width=\"20px\" />`\r\n\r\n                try {\r\n\r\n                    const response = await SignupAction(data);\r\n            \r\n                    const res = await response;\r\n                    // const res.data.status ==201\r\n                    console.log(res);\r\n                        if (res.data.status === 201) {\r\n                        toast.success(`${res.data.message} Proceed to login.`);\r\n                        // btn.innerHTML=`Create account`;\r\n                        // btn.innerHTML=\"<p>Create account</p>\";\r\n                        \r\n                        window.location = `/account-created?email=${email}`;\r\n                    } \r\n                    else {\r\n                        toast.error(\"Something went wrong, please try again!!!\")\r\n                        btn.innerHTML=\"<p>Create account</p>\";\r\n                    }\r\n    \r\n                } catch (err) {\r\n                    console.log(err.response)\r\n                    if(err.response.data.message){\r\n                        toast.error(err.response.data.message);\r\n                        btn.innerHTML=`Create account`;\r\n                    } else{\r\n                        toast.error(\"Something went wrong!!! Please make sure you have a good internet connection.\");\r\n                        btn.innerHTML=`Create account`;\r\n                    }\r\n                }\r\n            }\r\n            else{\r\n                toast.error(\"please enter correct phone number\")\r\n            }\r\n\r\n            \r\n\r\n\r\n       \r\n            // SignupAction(data)\r\n            //     .then((response) => response.data)\r\n            //     .then((res) => {\r\n            //         console.log(res);\r\n            //         if (res.status === 201) {\r\n            //             toast.success(`${res.message} Proceed to login.`);\r\n            //             btn.innerHTML=`Create account`;\r\n            //             // window.location = `/account-created?email=${email}`;\r\n            //         } else {\r\n            //             toast.error(\"Something went wrong, please try again!!!\")\r\n            //         }\r\n            //     })\r\n            //     .catch((err) => {\r\n            //         console.log(err);\r\n            //         if(err.response.data.message){\r\n            //             toast.error(err.response.data.message);\r\n            //             btn.innerHTML=`Create account`;\r\n            //         } else{\r\n            //             toast.error(\"Something went wrong!!! Please make sure you have a good internet connection.\");\r\n            //             btn.innerHTML=`Create account`;\r\n            //         }\r\n            //     });\r\n        } else {\r\n            toast.error(\"Password must be at least 6 characters!\");\r\n        }\r\n    }\r\n\r\n    const toggleIcon = () => {\r\n        var x = document.getElementById(\"password\");\r\n        var iconContainer = document.getElementById(\"toggle\");\r\n        if (x.type === \"password\") {\r\n          x.type = \"text\";\r\n          iconContainer.innerHTML = `<img src=${notvisible} />`\r\n        } else {\r\n          x.type = \"password\";\r\n          iconContainer.innerHTML = `<img src=${visible} />` ;\r\n        }\r\n    }\r\n\r\n    return(\r\n        <div className=\"layout_auth\">\r\n            <ToastContainer/>\r\n            <div className=\"layout_auth-main\">\r\n                <div className=\"auth_container\">\r\n                    <div className=\"auth_container-logo\" >\r\n                        <Link to=\"/\">\r\n                            <img src={logo} alt=\"logo\" />\r\n                        </Link>\r\n                    </div>\r\n                    <div className=\"auth_container_form\">\r\n                        <h3>Create an Account</h3>\r\n                        <p className=\"auth_container_form-text\">Create a free account to start your application</p>\r\n                        <form onSubmit={doSignUp}>\r\n                            <div>\r\n                                <label>First Name</label>\r\n                                <input type=\"text\" required placeholder=\"First Name\" name=\"firstName\" onChange={handleChange} />\r\n                            </div>\r\n                            <div>\r\n                                <label>Last Name</label>\r\n                                <input type=\"text\" required placeholder=\"Last Name\" name=\"lastName\" onChange={handleChange} />\r\n                            </div>\r\n                            <div>\r\n                                <label>Email Address</label>\r\n                                <input type=\"email\" required placeholder=\"Email Address\" name=\"email\" onChange={handleChange} />\r\n                            </div>\r\n                            <div>\r\n                                <label>Phone Number</label>\r\n                                <input type=\"number\" required placeholder=\"Phone Number\" name=\"phone\" onChange={handleChange} />\r\n                            </div>\r\n                            <div className=\"auth_container_form-password\">\r\n                                <label>Password</label>\r\n                                <input type=\"password\" id=\"password\" required placeholder=\"Password\" name=\"password\" onChange={handleChange} />\r\n                                <div id=\"toggle\" onClick={toggleIcon} ><img src={visible} /></div>\r\n                            </div>\r\n                            <button type=\"submit\" id=\"actionBtn\">Create Account</button>\r\n                            <p>Already have an account? <Link to=\"/login\"><span>Login</span></Link></p>\r\n                        </form>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n            <div className=\"layout_auth-image\">\r\n                <LazyLoadImage src={authImg} effect=\"blur\" alt=\"auth\" height=\"auto\" width=\"100%\" />\r\n            </div>\r\n        </div>\r\n    )\r\n}\r\n\r\nexport default SignUp;","C:\\Users\\mitchel\\Documents\\grazac\\code\\grazac-academy-web\\src\\pages\\graduateCohort\\auth\\ResetPassword.js",["237","238","239"],"import { useState } from 'react';\r\nimport { Link } from \"react-router-dom\";\r\nimport { ToastContainer, toast } from 'react-toastify';\r\nimport { ResetPasswordAction } from \"../../../api/dashboard/auth\";\r\nimport { LazyLoadImage } from 'react-lazy-load-image-component';\r\nimport authImg from '../../../images/auth.png';\r\n\r\nimport logo from '../../../images/svg/academy-logo.svg';\r\nimport visible from '../../../images/svg/visible.svg';\r\nimport notvisible from '../../../images/svg/notvisible.svg';\r\nimport loader from \"../../../images/svg/dashboard/loader.gif\";\r\n\r\n\r\nfunction ResetPassword () {\r\n    const urlParams = new URLSearchParams(window.location.search);\r\n    const reset_token = urlParams.get('token');\r\n    const [form, setForm] = useState({\r\n        password: \"\",\r\n        confirmpassword: \"\"\r\n    });\r\n\r\n    const handleChange = (e) => {\r\n        setForm({\r\n            ...form,\r\n            [e.target.name]: e.target.value\r\n        })\r\n    }\r\n\r\n    const doReset = (e) => {\r\n        e.preventDefault();\r\n        if (!form.password.length || !form.confirmpassword.length) {\r\n            toast.info(\"Please make sure no field is empty!\")\r\n        }else if(form.password != form.confirmpassword){\r\n            toast.error(\"Passwords do not match!\")\r\n        }else if(form.password.length<6 || form.confirmpassword<6){\r\n            toast.error(\"Passwords should be at least 6 characters!\")\r\n        } else{\r\n            var btn = document.getElementById(\"actionBtn\");\r\n            btn.innerHTML = `<img src=${loader} width=\"20px\" />`;\r\n            var data  = new FormData();\r\n    \r\n            data.append(\"token\", reset_token);\r\n            data.append(\"password\", form.password);\r\n            data.append(\"confirmPassword\", form.confirmpassword);\r\n    \r\n            ResetPasswordAction(data)\r\n                .then((response) => response.data)\r\n                .then((res) => {\r\n                    console.log(res);\r\n                    if (res.status === 200) {\r\n                        toast.success(\"Password reset successful! Proceed to login.\");\r\n                        btn.innerHTML=`Reset Password`;\r\n                    } else {\r\n                        toast.error(\"Something went wrong, please try again!!!\")\r\n                        btn.innerHTML=`Reset Password`;\r\n                    }\r\n                })\r\n                .catch((err) => {\r\n                    console.log(err.response)//modify the errors\r\n                    toast.error(\"Unable to reset password! Try again\");\r\n                //     if(err.response.data.message){\r\n                //         toast.error(err.response.data.message);\r\n                //         btn.innerHTML=`Reset Password`;\r\n                //     } else{\r\n                //         toast.error(\"Something went wrong!!! Please make sure you have a good internet connection.\");\r\n                //         btn.innerHTML=`Reset Password`;\r\n                //     }\r\n                });\r\n        }\r\n    }\r\n\r\n    const toggleIcon = () => {\r\n        var x = document.getElementById(\"password\");\r\n        var iconContainer = document.getElementById(\"toggle\");\r\n        if (x.type === \"password\") {\r\n          x.type = \"text\";\r\n          iconContainer.innerHTML = `<img src=${notvisible} />`\r\n        } else {\r\n          x.type = \"password\";\r\n          iconContainer.innerHTML = `<img src=${visible} />` ;\r\n        }\r\n    }\r\n    \r\n    const toggleIcon2 = () => {\r\n        var x = document.getElementById(\"confirmpassword\");\r\n        var iconContainer = document.getElementById(\"confirmtoggle\");\r\n        if (x.type === \"password\") {\r\n            x.type = \"text\";\r\n            iconContainer.innerHTML = `<img src=${notvisible} />`\r\n        } else {\r\n            x.type = \"password\";\r\n            iconContainer.innerHTML = `<img src=${visible} />` ;\r\n        }\r\n    }\r\n\r\n    return(\r\n        <div className=\"layout_auth\">\r\n            <ToastContainer/>\r\n            <div className=\"layout_auth-main\">\r\n                <div className=\"auth_container\">\r\n                    <div className=\"auth_container-logo\" >\r\n                        <Link to=\"/\">\r\n                            <img src={logo} alt=\"logo\" />\r\n                        </Link>\r\n                    </div>\r\n                    <div className=\"auth_container_form\">\r\n                        <h3>Create New Password</h3>\r\n                        <p className=\"auth_container_form-text\">Enter your new password below to continue.</p>\r\n                        <form onSubmit={doReset}>\r\n                            <div className=\"auth_container_form-password\">\r\n                                <label>Password</label>\r\n                                <input type=\"password\" id=\"password\" placeholder=\"Password\" name=\"password\" onChange={handleChange} />\r\n                                <div id=\"toggle\" onClick={toggleIcon} ><img src={visible} /></div>\r\n                            </div>\r\n                            <div className=\"auth_container_form-password\">\r\n                                <label>Confirm Password</label>\r\n                                <input type=\"password\" id=\"confirmpassword\" placeholder=\"Password\" name=\"confirmpassword\" onChange={handleChange} />\r\n                                <div id=\"confirmtoggle\" onClick={toggleIcon2} ><img src={visible} /></div>\r\n                            </div>\r\n                            <button type=\"submit\" id=\"actionBtn\">Reset Password</button>\r\n                            <p>Remember your password? <Link to=\"/login\"><span>Login</span></Link></p>\r\n                        </form>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n            <div className=\"layout_auth-image\">\r\n                <LazyLoadImage src={authImg} effect=\"blur\" alt=\"auth\" height=\"auto\" width=\"100%\" />\r\n            </div>\r\n        </div>\r\n    )\r\n}\r\n\r\nexport default ResetPassword;","C:\\Users\\mitchel\\Documents\\grazac\\code\\grazac-academy-web\\src\\pages\\graduateCohort\\auth\\AccountCreated.js",[],"C:\\Users\\mitchel\\Documents\\grazac\\code\\grazac-academy-web\\src\\pages\\graduateCohort\\auth\\MailSent.js",[],"C:\\Users\\mitchel\\Documents\\grazac\\code\\grazac-academy-web\\src\\pages\\graduateCohort\\auth\\VerifyMail.js",["240"],"import { Link } from \"react-router-dom\";\r\nimport { useEffect, useState } from \"react\";\r\nimport { VerifyEmail } from \"../../../api/dashboard/auth\";\r\nimport { LazyLoadImage } from 'react-lazy-load-image-component';\r\nimport authImg from '../../../images/auth.png';\r\nimport logo from '../../../images/svg/academy-logo.svg';\r\nimport email from '../../../images/svg/email.svg';\r\nimport loader from '../../../images/loader-purple.gif';\r\n\r\n\r\nfunction Verify () {\r\n    const urlParams = new URLSearchParams(window.location.search);\r\n    const token = urlParams.get('token');\r\n    const [loading, setLoading] = useState(true)\r\n\r\n    useEffect(() => {\r\n        verify();\r\n    },[]);\r\n\r\n    async function verify () {\r\n        try {\r\n            const response = await VerifyEmail(token);\r\n            const res = await response;\r\n            console.log(res);\r\n            setTimeout( function (){setLoading(false);}, 2500)\r\n        } catch (err) {\r\n            console.log(err.response)\r\n        }\r\n    }\r\n\r\n    return(\r\n        <div className=\"layout_auth\">\r\n            <div className=\"layout_auth-main\">\r\n                <div className=\"auth_container\">\r\n                    <div className=\"auth_container-logo\" >\r\n                        <Link to=\"/\">\r\n                            <img src={logo} alt=\"logo\" />\r\n                        </Link>\r\n                    </div>\r\n                    <div className=\"auth_container_form\">\r\n                        {loading && <div className=\"auth_verify\">\r\n                            <img src={loader} alt=\"loading\" width=\"100px\" />\r\n                            <h3>Verifying, please wait...</h3>\r\n                        </div>}\r\n                        {!loading && <div>\r\n                            <img src={email} alt=\"email\" className=\"auth_container_form-email\" />\r\n                            <h3>Email Verified!</h3>\r\n                            <p className=\"auth_container_form-text\">\r\n                                Learn valuable technology skills with us, we strongly believe the future of work will be skill based. <br/>\r\n                                Join us to build a career in tech and get tutored by industry leaders who will walk you through the path of becoming highly valuable and employable. <br/>\r\n                            </p>\r\n                            <p>Proceed to <Link to=\"/login\"><span>Login</span></Link></p>\r\n                        </div>}\r\n                    </div>\r\n                </div>\r\n            </div>\r\n            <div className=\"layout_auth-image\">\r\n                <LazyLoadImage src={authImg} effect=\"blur\" alt=\"auth\" height=\"auto\" width=\"100%\" />\r\n            </div>\r\n        </div>\r\n    )\r\n}\r\n\r\nexport default Verify;","C:\\Users\\mitchel\\Documents\\grazac\\code\\grazac-academy-web\\src\\pages\\graduateCohort\\dashboard\\Main.js",["241","242","243","244","245","246","247","248","249","250","251"],"import { useState, useEffect } from \"react\";\r\nimport Sidebar from \"../../../components/dashboard/Sidebar\";\r\nimport Details from \"../../../components/dashboard/Details\";\r\nimport NotSubmitted from \"../../../components/dashboard/not-submitted\";\r\nimport UnderReview from \"../../../components/dashboard/UnderReview\";\r\nimport PaymentReceived from \"../../../components/dashboard/selected/PaymentReceived\";\r\nimport Selected from \"../../../components/dashboard/Selected\";\r\nimport Rejected from \"../../../components/dashboard/Rejected\";\r\nimport OutsideClickHandler from \"react-outside-click-handler\";\r\nimport { ToastContainer, toast } from \"react-toastify\";\r\nimport {\r\n  submitGuarantor,\r\n  sendFlutterTx,\r\n  addPlan,\r\n  getGuarantor,\r\n} from \"../../../api/dashboard/data\";\r\nimport { useFlutterwave, closePaymentModal } from \"flutterwave-react-v3\";\r\n\r\nimport arrow from \"../../../images/svg/dashboard/arrow.svg\";\r\nimport menu from \"../../../images/svg/dashboard/menu.svg\";\r\nimport cancel from \"../../../images/svg/dashboard/cancel.svg\";\r\nimport loader from \"../../../images/svg/dashboard/loader.gif\";\r\n\r\nimport termsandconds from \"../../../content/TermsandCondition.pdf\";\r\nimport Loader from \"../../../components/Loader\";\r\n\r\nfunction Dashboard() {\r\n  const [status, setStatus] = useState(\"Not Submitted\");\r\n  const [loading, setLoading] = useState(false);\r\n  const [isError, setIsError] = useState(null);\r\n  // const [status, setStatus] = useState(\"Admitted\");\r\n  const [selectStatus, setSelectStatus] = useState(\"congrats\");\r\n  const [selectStatus2, setSelectStatus2] = useState(\"\");\r\n  const [sidebarClick, setSidebarClick] = useState(\"dashboard\");\r\n  const [details, setDetails] = useState({});\r\n  const [payOpt, setPayOpt] = useState(\"\");\r\n  const [amount, setAmount] = useState(0);\r\n  const [currency, setCurrency] = useState(\"\");\r\n  const [userId, setUserId] = useState(0);\r\n  const [guarantorForm1, setGuarantorForm1] = useState(true);\r\n  const [showProfessionalInput1, setShowProfessionalInput1] = useState(false);\r\n  const [showGuarantorRelationshipInput1, setShowGuarantorRelationshipInput1] =\r\n    useState(false);\r\n\r\n  const [guarantorStatus, setGuarantorStatus] = useState(false);\r\n  // const [guarantorDetails_2,setGuarantorDetails_2]=useState([])\r\n  // console.log(\"nothing\")\r\n  const [guarantor, setGuarantor] = useState({\r\n    firstName: \"\",\r\n    lastName: \"\",\r\n    email: \"\",\r\n    phone: \"\",\r\n    gender: \"\",\r\n    officeAddress: \"\",\r\n    homeAddress: \"\",\r\n    profession: \"\",\r\n    organisation: \"\",\r\n    employer: \"\",\r\n    employerMail: \"\",\r\n    employerPhone: \"\",\r\n    relationship: \"\",\r\n  });\r\n\r\n  const item = 1;\r\n\r\n  useEffect(() => {\r\n    // setSelectStatus(\"paid\");\r\n    // console.log(selectStatus);\r\n    // setSelectStatus(\"paid\")\r\n\r\n    try {\r\n      let details = sessionStorage.getItem(\"user_details\");\r\n      setStatus(sessionStorage.getItem(\"status\"));\r\n      console.log(\"doing good\");\r\n\r\n      setDetails(JSON.parse(details));\r\n\r\n      setUserId(JSON.parse(details).id);\r\n\r\n      console.log(guarantorForm1);\r\n\r\n      if (JSON.parse(details).isPaid === 1) {\r\n        setSelectStatus(\"paid\");\r\n      }\r\n\r\n      if (!details) {\r\n        window.location = \"/login\";\r\n      }\r\n    } catch (err) {\r\n      window.location = \"/login\";\r\n    }\r\n\r\n    console.log(\"page loaded\");\r\n    setLoading(true);\r\n    \r\n    getGuarantor()\r\n      .then((response) => response.data)\r\n      .then((res) => {\r\n        console.log(res.data);\r\n        setLoading(false);\r\n\r\n        if (res.data.length > 1 || res.data.length === 1) {\r\n          setGuarantorForm1(false);\r\n        }\r\n\r\n        // work on this part for the payment page\r\n        if (res.data.length > 2 || res.data.length == 2) {\r\n          setGuarantorForm1(false);\r\n          setGuarantorStatus(true);\r\n        }\r\n      })\r\n      .catch((err) => {\r\n        setLoading(false);\r\n        console.log(err);\r\n        if (err.response) {\r\n          toast.error(err.response);\r\n        } else {\r\n          toast.error(\r\n            \"Something went wrong!!! Please make sure you have a good internet connection.\"\r\n          );\r\n        }\r\n      });\r\n  }, [guarantorForm1]);\r\n\r\n  const handleChange = (e) => {\r\n    setGuarantor({\r\n      ...guarantor,\r\n      [e.target.name]: e.target.value,\r\n    });\r\n  };\r\n\r\n  const showNavMobile = () => {\r\n    document.getElementById(\"sidebar\").style.left = \"0px\";\r\n  };\r\n  const closeNavMobile = () => {\r\n    if (window.innerWidth < 769) {\r\n      document.getElementById(\"sidebar\").style.left = \"-210px\";\r\n    }\r\n  };\r\n\r\n  const flutterWavePayment = () => {\r\n    handleFlutterPayment({\r\n      callback: (response) => {\r\n        if (response.status === \"successful\") {\r\n          console.log(response);\r\n          toast.success(\"Payment successful! Verifying payment...\");\r\n          window.location = \"/dashboard\";\r\n\r\n          sendFlutterTx(response.transaction_id)\r\n            .then((response) => response.data)\r\n            .then((res) => {\r\n              console.log(res);\r\n              if (res.data.status === \"successful\") {\r\n                setSelectStatus(\"paid\");\r\n                window.location = \"/dashboard\";\r\n              } else {\r\n                console.log(\"not successful\");\r\n              }\r\n            })\r\n            .catch((err) => {\r\n              console.log(err);\r\n            });\r\n        } else {\r\n          toast.error(\"Payment unsuccessful!\");\r\n        }\r\n        closePaymentModal(); // this will close the modal programmatically\r\n      },\r\n      onClose: (response) => {\r\n        console.log(response);\r\n      },\r\n    });\r\n  };\r\n\r\n  const makePayment = () => {\r\n    if (payOpt === \"part\") {\r\n      setSelectStatus2(\"\");\r\n      setSelectStatus(\"pay-as-you-earn\");\r\n    } else if (payOpt === \"full\") {\r\n      setSelectStatus2(\"\");\r\n\r\n      var planData = new FormData();\r\n      planData.append(\"payment_plan\", \"pay at once\");\r\n      addPlan(planData)\r\n        .then((response) => response.data)\r\n        .then((res) => {\r\n          console.log(res);\r\n        })\r\n        .catch((err) => {\r\n          console.log(err);\r\n        });\r\n\r\n      flutterWavePayment();\r\n    } else {\r\n      toast.info(\"You need to select a payment option to continue!\");\r\n    }\r\n  };\r\n\r\n  const showForm = () => {\r\n    if (document.getElementById(\"mark\").checked) {\r\n      setSelectStatus(\"form\");\r\n    } else {\r\n      toast.info(\"You need to accept our terms and conditions to continue\");\r\n    }\r\n  };\r\n\r\n  const SubmitGuarantorForm_1 = (e) => {\r\n    e.preventDefault();\r\n    var btn = document.getElementById(\"actionBtn\");\r\n    btn.innerHTML = `<img src=${loader} width=\"20px\" />`;\r\n\r\n    getGuarantor()\r\n      .then((response) => response.data)\r\n      .then((res) => {\r\n        console.log(res.data);\r\n        setLoading(false);\r\n\r\n        if (!(res.data.length == 1 || res.data.length > 1)) {\r\n          // setGuarantorForm1(false);\r\n          console.log(res.data.length);\r\n          console.log(\"the guarantor data not full\");\r\n\r\n          e.preventDefault();\r\n          var data = new FormData();\r\n\r\n          var btn = document.getElementById(\"actionBtn\");\r\n          btn.innerHTML = `<img src=${loader} width=\"20px\" />`;\r\n          btn.disabled = false;\r\n\r\n          if (!(guarantor.phone.length > 10)) {\r\n            btn.innerHTML = `<img src=${loader} width=\"20px\" />`;\r\n\r\n            toast.error(\"please enter a correct phone number\");\r\n            setIsError(true);\r\n            btn.innerHTML = `Proceed`;\r\n            // btn.disabled = true\r\n          }\r\n\r\n          if (!(guarantor.employerPhone.length > 10)) {\r\n            btn.innerHTML = `<img src=${loader} width=\"20px\" />`;\r\n\r\n            toast.error(\"please enter a correct employer's phone number\");\r\n            setIsError(true);\r\n            btn.innerHTML = `Proceed`;\r\n            // btn.disabled = true\r\n          }\r\n\r\n          if (\r\n            guarantor.phone.length > 10 ||\r\n            guarantor.employerPhone.length > 10\r\n          ) {\r\n            // btn.disabled = false\r\n          }\r\n\r\n          if (\r\n            guarantor.phone.length > 10 &&\r\n            guarantor.employerPhone.length > 10\r\n          ) {\r\n            console.log(guarantor.phone.length, guarantor.employerPhone.length);\r\n            setIsError(false);\r\n            console.log(\"no errors\");\r\n            // btn.disabled = false\r\n\r\n            // btn.innerHTML = `<img src=${loader} width=\"20px\" />`;\r\n            data.append(\"firstname\", guarantor.firstName);\r\n            data.append(\"lastname\", guarantor.lastName);\r\n            data.append(\"email\", guarantor.email);\r\n            data.append(\"phone_number\", guarantor.phone);\r\n            data.append(\"gender\", guarantor.gender);\r\n            data.append(\"office_address\", guarantor.officeAddress);\r\n            data.append(\"home_address\", guarantor.homeAddress);\r\n            data.append(\"profession\", guarantor.profession);\r\n            data.append(\"name_of_organization\", guarantor.organisation);\r\n            data.append(\"name_of_employer\", guarantor.employer);\r\n            data.append(\"email_address_of_employer\", guarantor.employerMail);\r\n            data.append(\"phone_number_of_employer\", guarantor.employerPhone);\r\n            data.append(\r\n              \"relationship_with_the_guarantor\",\r\n              guarantor.relationship\r\n            );\r\n            data.append(\"user_id\", userId);\r\n\r\n            submitGuarantor(data)\r\n              .then((response) => response.data)\r\n              .then((res) => {\r\n                if (res.status === 200) {\r\n                  // window.location = \"/dashboard\";\r\n                  window.scrollTo(0, 0);\r\n                  // document.getElementById(\"guarantorForm2\").reset()\r\n                  setGuarantorForm1(false);\r\n                  btn.disabled = true;\r\n                  toast.success(\"Submission successful\");\r\n                  btn.innerHTML = `<img src=${loader} width=\"20px\" />`;\r\n                  btn.disabled = true;\r\n                  // flutterWavePayment();\r\n                } else {\r\n                  toast.error(\"Submission not successful, try again!!!\");\r\n                  // btn.innerHTML = `<img src=${loader} width=\"20px\" />`;\r\n                  btn.innerHTML = `Procede`;\r\n                }\r\n              })\r\n              .catch((err) => {\r\n                console.log(err);\r\n                if (err.response) {\r\n                  toast.error(err.response);\r\n                  btn.innerHTML = `Procede`;\r\n                }\r\n                // else {\r\n                //   toast.error(\r\n                //     \"Something went wrong!!! Please make sure you have a good internet connection.\"\r\n                //   );\r\n                //   btn.innerHTML = `Procede`;\r\n                // }\r\n              });\r\n          }\r\n        }\r\n      });\r\n  };\r\n\r\n  const SubmitGuarantorForm_2 = (e) => {\r\n    e.preventDefault();\r\n    var data = new FormData();\r\n\r\n    var btn = document.getElementById(\"actionBtn\");\r\n    btn.innerHTML = `<img src=${loader} width=\"20px\" />`;\r\n    // btn.disabled = true\r\n\r\n    if (!(guarantor.phone.length > 10)) {\r\n      btn.innerHTML = `<img src=${loader} width=\"20px\" />`;\r\n\r\n      toast.error(\"please enter a correct phone number\");\r\n      setIsError(true);\r\n      btn.innerHTML = `Proceed`;\r\n      // btn.disabled = true\r\n    }\r\n\r\n    if (!(guarantor.employerPhone.length > 10)) {\r\n      btn.innerHTML = `<img src=${loader} width=\"20px\" />`;\r\n\r\n      toast.error(\"please enter a correct employer's phone number\");\r\n      setIsError(true);\r\n      btn.innerHTML = `Proceed`;\r\n      // btn.disabled = false\r\n    }\r\n\r\n    if (guarantor.phone.length > 10 && guarantor.employerPhone.length > 10) {\r\n      console.log(guarantor.phone.length, guarantor.employerPhone.length);\r\n      setIsError(false);\r\n      console.log(\"no errors\");\r\n\r\n      // btn.innerHTML = `<img src=${loader} width=\"20px\" />`;\r\n      data.append(\"firstname\", guarantor.firstName);\r\n      data.append(\"lastname\", guarantor.lastName);\r\n      data.append(\"email\", guarantor.email);\r\n      data.append(\"phone_number\", guarantor.phone);\r\n      data.append(\"gender\", guarantor.gender);\r\n      data.append(\"office_address\", guarantor.officeAddress);\r\n      data.append(\"home_address\", guarantor.homeAddress);\r\n      data.append(\"profession\", guarantor.profession);\r\n      data.append(\"name_of_organization\", guarantor.organisation);\r\n      data.append(\"name_of_employer\", guarantor.employer);\r\n      data.append(\"email_address_of_employer\", guarantor.employerMail);\r\n      data.append(\"phone_number_of_employer\", guarantor.employerPhone);\r\n      data.append(\"relationship_with_the_guarantor\", guarantor.relationship);\r\n      data.append(\"user_id\", userId);\r\n\r\n      submitGuarantor(data)\r\n        .then((response) => response.data)\r\n        .then((res) => {\r\n          if (res.status === 200) {\r\n            btn.disabled = true;\r\n            window.location = \"/dashboard\";\r\n            // toast.success(\"Submission successful\");\r\n            btn.innerHTML = `Submit & Pay`;\r\n\r\n            // flutterWavePayment();\r\n          } else {\r\n            toast.error(\"Submission not successful, try again!!!\");\r\n            btn.innerHTML = `Submit & Pay`;\r\n          }\r\n        })\r\n        .catch((err) => {\r\n          console.log(err);\r\n          if (err.response) {\r\n            toast.error(err.response);\r\n            btn.innerHTML = `Submit & Pay`;\r\n          }\r\n\r\n          // else {\r\n          //   toast.error(\r\n          //     \"Something went wrong!!! Please make sure you have a good internet connection.\"\r\n          //   );\r\n          //   btn.innerHTML = `Submit & Pay`;\r\n          // }\r\n        });\r\n\r\n      var planData = new FormData();\r\n      planData.append(\"payment_plan\", \"pay as you earn\");\r\n      addPlan(planData)\r\n        .then((response) => response.data)\r\n        .then((res) => {\r\n          console.log(res);\r\n        })\r\n        .catch((err) => {\r\n          console.log(err);\r\n        });\r\n    } else {\r\n      btn.innerHTML = `Proceed`;\r\n    }\r\n  };\r\n\r\n  const submitForm = (e, whichForm) => {\r\n    e.preventDefault();\r\n    var btn = document.getElementById(\"actionBtn\");\r\n    btn.innerHTML = `<img src=${loader} width=\"20px\" />`;\r\n\r\n    var data = new FormData();\r\n\r\n    // console.log(guarantor.firstName, guarantor.lastName);\r\n\r\n    if (!(guarantor.phone.length > 10)) {\r\n      btn.innerHTML = `<img src=${loader} width=\"20px\" />`;\r\n\r\n      toast.error(\"please enter a correct phone number\");\r\n      setIsError(true);\r\n      btn.innerHTML = `Proceed`;\r\n    }\r\n\r\n    if (!(guarantor.employerPhone.length > 10)) {\r\n      btn.innerHTML = `<img src=${loader} width=\"20px\" />`;\r\n\r\n      toast.error(\"please enter a correct employer's phone number\");\r\n      setIsError(true);\r\n      btn.innerHTML = `Proceed`;\r\n    }\r\n\r\n    if (guarantor.phone.length > 10 && guarantor.employerPhone.length > 10) {\r\n      console.log(guarantor.phone.length, guarantor.employerPhone.length);\r\n      setIsError(false);\r\n    }\r\n\r\n    if (isError === false) {\r\n      btn.innerHTML = `<img src=${loader} width=\"20px\" />`;\r\n      data.append(\"firstname\", guarantor.firstName);\r\n      data.append(\"lastname\", guarantor.lastName);\r\n      data.append(\"email\", guarantor.email);\r\n      data.append(\"phone_number\", guarantor.phone);\r\n      data.append(\"gender\", guarantor.gender);\r\n      data.append(\"office_address\", guarantor.officeAddress);\r\n      data.append(\"home_address\", guarantor.homeAddress);\r\n      data.append(\"profession\", guarantor.profession);\r\n      data.append(\"name_of_organization\", guarantor.organisation);\r\n      data.append(\"name_of_employer\", guarantor.employer);\r\n      data.append(\"email_address_of_employer\", guarantor.employerMail);\r\n      data.append(\"phone_number_of_employer\", guarantor.employerPhone);\r\n      data.append(\"relationship_with_the_guarantor\", guarantor.relationship);\r\n      data.append(\"user_id\", userId);\r\n\r\n      if (whichForm === \"guarantor1\" && isError === false) {\r\n        var btn = document.getElementById(\"actionBtn\");\r\n\r\n        btn.innerHTML = `<img src=${loader} width=\"20px\" />`;\r\n\r\n        submitGuarantor(data)\r\n          .then((response) => response.data)\r\n          .then((res) => {\r\n            if (res.status === 200) {\r\n              toast.success(\"Submission successful\");\r\n              btn.innerHTML = `Proceed`;\r\n              setGuarantorForm1(false);\r\n\r\n              window.scrollTo(0, 0);\r\n              document.getElementById(\"guarantorForm2\").reset();\r\n            } else {\r\n              toast.error(\"Submission not successful, try again!!!\");\r\n              btn.innerHTML = `Proceed`;\r\n            }\r\n          })\r\n          .catch((err) => {\r\n            console.log(err);\r\n            if (err.response) {\r\n              toast.error(err.response);\r\n              btn.innerHTML = `Proceed`;\r\n            } else {\r\n              toast.error(\r\n                \"Something went wrong!!! Please make sure you have a good internet connection.\"\r\n              );\r\n              btn.innerHTML = `Proceed`;\r\n            }\r\n          });\r\n      } else {\r\n        btn.innerHTML = `Proceed`;\r\n      }\r\n\r\n      if (whichForm === \"guarantor2\" && isError === false) {\r\n        var btn = document.getElementById(\"actionBtn\");\r\n        btn.innerHTML = `<img src=${loader} width=\"20px\" />`;\r\n\r\n        submitGuarantor(data)\r\n          .then((response) => response.data)\r\n          .then((res) => {\r\n            if (res.status === 200) {\r\n              window.location = \"/dashboard\";\r\n              // toast.success(\"Submission successful\");\r\n              btn.innerHTML = `Submit & Pay`;\r\n              // flutterWavePayment();\r\n            } else {\r\n              toast.error(\"Submission not successful, try again!!!\");\r\n              btn.innerHTML = `Submit & Pay`;\r\n            }\r\n          })\r\n          .catch((err) => {\r\n            console.log(err);\r\n            if (err.response) {\r\n              toast.error(err.response);\r\n              btn.innerHTML = `Submit & Pay`;\r\n            } else {\r\n              toast.error(\r\n                \"Something went wrong!!! Please make sure you have a good internet connection.\"\r\n              );\r\n              btn.innerHTML = `Submit & Pay`;\r\n            }\r\n          });\r\n\r\n        var planData = new FormData();\r\n        planData.append(\"payment_plan\", \"pay as you earn\");\r\n        addPlan(planData)\r\n          .then((response) => response.data)\r\n          .then((res) => {\r\n            console.log(res);\r\n          })\r\n          .catch((err) => {\r\n            console.log(err);\r\n          });\r\n      } else {\r\n        btn.innerHTML = `Proceed`;\r\n      }\r\n    }\r\n  };\r\n\r\n  // FLWPUBK_TEST-50065c317f5144179f94b776f7604026-X\r\n  // public_key: \"FLWPUBK-006bdc82ad878f1518af32f44af6478f-X\",\r\n\r\n  const config = {\r\n    public_key: \"FLWPUBK-006bdc82ad878f1518af32f44af6478f-X\",\r\n    tx_ref: Date.now(),\r\n    amount: amount,\r\n    currency: currency,\r\n    payment_options: \"card,mobilemoney,ussd\",\r\n    customer: {\r\n      email: `${details.email}`,\r\n      phonenumber: `${details.phone}`,\r\n      name: `${details.firstName} ${details.lastName}`,\r\n    },\r\n\r\n    customizations: {\r\n      title: \"Grazac Academy\",\r\n      description: \"Payment for Graduate Cohort\",\r\n      logo: \"https://grazac.com.ng/assets/images/favicon.png\",\r\n    },\r\n  };\r\n\r\n  const handleFlutterPayment = useFlutterwave(config);\r\n\r\n  const changeStatus = (par1) => {\r\n    setStatus(`${par1}`);\r\n    sessionStorage.setItem(\"status\", `${par1}`);\r\n  };\r\n\r\n  return (\r\n    <>\r\n      {loading === false ? (\r\n        <div>\r\n          <ToastContainer closeButton={false} />\r\n          <OutsideClickHandler\r\n            onOutsideClick={() => {\r\n              closeNavMobile();\r\n            }}\r\n          >\r\n            <div className=\"layout_dashboard-sidebar\" id=\"sidebar\">\r\n              <Sidebar\r\n                clicked={sidebarClick}\r\n                showDetails={status}\r\n                clickedDashboard={setSidebarClick}\r\n                clickedDetails={setSidebarClick}\r\n              />\r\n            </div>\r\n          </OutsideClickHandler>\r\n          <div className=\"layout_dashboard-content\">\r\n            <div className=\"dashboard-nav\">\r\n              <img\r\n                src={menu}\r\n                alt=\"menu\"\r\n                className=\"dashboard-nav-menu\"\r\n                onClick={showNavMobile}\r\n              />\r\n              <div className=\"dashboard-nav-status\">\r\n                <h3>Status: {status}</h3>\r\n                <div\r\n                  className={\r\n                    status === \"Not Submitted\"\r\n                      ? `dashboard-nav-status-dot not-submitted`\r\n                      : status === \"Under Review\"\r\n                      ? `dashboard-nav-status-dot under-review`\r\n                      : `dashboard-nav-status-dot ${status}`\r\n                  }\r\n                ></div>\r\n              </div>\r\n              <div className=\"dashboard-nav-user\">\r\n                <div>\r\n                  <h2>\r\n                    {details.firstName?.substring(0, 1)}\r\n                    {details?.lastName?.substring(0, 1)}\r\n                  </h2>\r\n                </div>\r\n                <p>\r\n                  {details.firstName} {details.lastName}\r\n                </p>\r\n              </div>\r\n            </div>\r\n            {sidebarClick === \"dashboard\" && (\r\n              <div className=\"dashboard-content\">\r\n                {/* {console.log(details)} */}\r\n                {status === \"Not Submitted\" && (\r\n                  <NotSubmitted\r\n                    userDetails={details}\r\n                    fname={details.firstName}\r\n                    lname={details.lastName}\r\n                    email={details.email}\r\n                    phone={details.phone}\r\n                    setNewStatus={() => changeStatus(\"Under Review\")}\r\n                  />\r\n                )}\r\n                {/* {console.log(details)}   */}\r\n                {status === \"Under Review\" && (\r\n                  <UnderReview fname={details.firstName} />\r\n                )}\r\n                {status === \"Selected\" && (\r\n                  <Selected fname={details.firstName} />\r\n                )}\r\n\r\n                {status === \"Admitted\" && (\r\n                  <div>\r\n                    {/* {guarantorStatus === false  && selectStatus !== \"paid\" ? ( */}\r\n                    {guarantorStatus === false ? (\r\n                      <div>\r\n                        {selectStatus === \"congrats\" && (\r\n                          <div>\r\n                            <h3>Hello {details.firstName}</h3>\r\n                            <p className=\"text1\">Congratulations!</p>\r\n                            <p>\r\n                              Your application has been selected. Click on the\r\n                              button below to continue you admission process.\r\n                            </p>\r\n                            <button onClick={() => setSelectStatus2(\"pay\")}>\r\n                              Continue admission process\r\n                            </button>\r\n                          </div>\r\n                        )}\r\n\r\n                        {selectStatus2 === \"pay\" && (\r\n                          <div className=\"dashboard-content-modal\">\r\n                            <div className=\"dashboard-content-modal-backdrop\"></div>\r\n                            <div className=\"dashboard-content-modal-container\">\r\n                              <div className=\"dashboard-content-modal-main\">\r\n                                <div className=\"dashboard-content-modal-main-text\">\r\n                                  <h4>Choose Payment Option</h4>\r\n                                  <img\r\n                                    src={cancel}\r\n                                    alt=\"cancel\"\r\n                                    onClick={() => setSelectStatus2(\"\")}\r\n                                  />\r\n                                </div>\r\n                                <div\r\n                                  className={\r\n                                    payOpt === \"part\"\r\n                                      ? \"active\"\r\n                                      : \"dashboard-content-modal-main-frame1\"\r\n                                  }\r\n                                  onClick={() => {\r\n                                    setPayOpt(\"part\");\r\n                                    setAmount(30000);\r\n                                    setCurrency(\"NGN\");\r\n                                  }}\r\n                                >\r\n                                  <div></div>\r\n                                  <p>Pay as you earn (NGN 30,000 legal fee)</p>\r\n                                </div>\r\n                                <div\r\n                                  className={\r\n                                    payOpt === \"full\"\r\n                                      ? \"active\"\r\n                                      : \"dashboard-content-modal-main-frame1\"\r\n                                  }\r\n                                  onClick={() => {\r\n                                    setPayOpt(\"full\");\r\n                                    setAmount(585000);\r\n                                    setCurrency(\"NGN\");\r\n                                  }}\r\n                                >\r\n                                  <div></div>\r\n                                  <p>Pay at once (USD 1,000 = NGN 585,000)</p>\r\n                                </div>\r\n                                <button onClick={makePayment}>Proceed</button>\r\n                              </div>\r\n                            </div>\r\n                          </div>\r\n                        )}\r\n\r\n                        {selectStatus === \"pay-as-you-earn\" && (\r\n                          <div>\r\n                            <div\r\n                              className=\"dashboard-content-back\"\r\n                              onClick={() => setSelectStatus(\"congrats\")}\r\n                            >\r\n                              <img src={arrow} alt=\"back\" />\r\n                              <p>Back</p>\r\n                            </div>\r\n                            <h3>Pay as you earn</h3>\r\n                            <div className=\"dashboard-content-guarantor_paragraph_text\">\r\n                              <p className=\"text1\">\r\n                                Learn with us for 5 months and pay no tuition\r\n                                till you’re hired!\r\n                              </p>\r\n                              <p>\r\n                                The Pay as You Earn is a financial instrument to\r\n                                help you participate in our training for FREE.\r\n                                You are expected to start repaying the credit\r\n                                once you get a job at the end of the program. It\r\n                                is governed by a legally binding contract. The\r\n                                repayment procedure can be found in our terms\r\n                                and conditions. This contract is bonded by the\r\n                                law firm.\r\n                              </p>\r\n                              <p>\r\n                                Note that: This policy requires you bringing two\r\n                                guarantors and making a one-time payment for\r\n                                legal fees bonded by the law firm.\r\n                              </p>\r\n                              <p>\r\n                                The legal fee cost is a total of 30,000 Naira.\r\n                                Kindly note that this amount is not refundable\r\n                                under any circumstance.\r\n                              </p>\r\n                            </div>\r\n\r\n                            <ul>\r\n                              <p>\r\n                                The following are of utmost necessity when\r\n                                bringing your guarantors;\r\n                              </p>\r\n                              <li>\r\n                                You must bring 2 guarantors who are over 18\r\n                                years of age and must have completed a higher\r\n                                institution of learning.\r\n                              </li>\r\n                              <li>\r\n                                Guarantors must have a stable source of income.\r\n                              </li>\r\n\r\n                              <li>\r\n                                They must be residents within the locality of\r\n                                Abeokuta, Ogun State.\r\n                              </li>\r\n                              <li>\r\n                                If your guarantor does not meet our eligibility\r\n                                status, you'll be asked to get a replacement.\r\n                              </li>\r\n                              <li>\r\n                                Kindly seek the consent of your guarantors\r\n                                before filling their details as we will contact\r\n                                them on your behalf.\r\n                              </li>\r\n                              <li>\r\n                                You can also share our terms and conditions with\r\n                                your guarantor to keep them informed.\r\n                              </li>\r\n                            </ul>\r\n                            <div className=\"checkbox\">\r\n                              <input type=\"checkbox\" id=\"mark\" />\r\n                              {/* <p>I accept the <a href=\"#\">Terms ‌and‌ ‌Conditions‌</a></p> */}\r\n                              <p>\r\n                                I accept the{\" \"}\r\n                                <a\r\n                                  href={termsandconds}\r\n                                  download\r\n                                  target=\"_blank\"\r\n                                >\r\n                                  Terms ‌and‌ ‌Conditions‌\r\n                                </a>\r\n                              </p>\r\n                            </div>\r\n\r\n                            <button onClick={showForm}>\r\n                              Upload Guarantor Details\r\n                            </button>\r\n                          </div>\r\n                        )}\r\n\r\n                        {selectStatus === \"form\" && (\r\n                          <div>\r\n                            <div\r\n                              className=\"dashboard-content-back\"\r\n                              onClick={() => setSelectStatus(\"pay-as-you-earn\")}\r\n                            >\r\n                              <img src={arrow} alt=\"back\" />\r\n                              <p>Back</p>\r\n                            </div>\r\n                            <h4 style={{ marginLeft: \"20px\" }}>\r\n                              Guarantor Form {guarantorForm1 ? \"1\" : \"2\"}\r\n                            </h4>\r\n\r\n                            {console.log(guarantorForm1)}\r\n                            {guarantorForm1 ? (\r\n                              <div className=\"dashboard-content-form\">\r\n                                <form\r\n                                  // onSubmit={(e) => submitForm(e, \"guarantor1\")}\r\n                                  onSubmit={(e) => SubmitGuarantorForm_1(e)}\r\n                                >\r\n                                  <div className=\"dashboard-content-form-container\">\r\n                                    <label>First Name</label>\r\n                                    <input\r\n                                      type=\"text\"\r\n                                      required\r\n                                      name=\"firstName\"\r\n                                      placeholder=\"FirstName\"\r\n                                      onChange={handleChange}\r\n                                    />\r\n                                  </div>\r\n                                  <div className=\"dashboard-content-form-container\">\r\n                                    <label>Last Name</label>\r\n                                    <input\r\n                                      type=\"text\"\r\n                                      required\r\n                                      name=\"lastName\"\r\n                                      placeholder=\"LastName\"\r\n                                      onChange={handleChange}\r\n                                    />\r\n                                  </div>\r\n                                  <div className=\"dashboard-content-form-container\">\r\n                                    <label>Email Address</label>\r\n                                    <input\r\n                                      type=\"email\"\r\n                                      required\r\n                                      name=\"email\"\r\n                                      placeholder=\"Email Address\"\r\n                                      onChange={handleChange}\r\n                                    />\r\n                                  </div>\r\n                                  <div className=\"dashboard-content-form-container\">\r\n                                    <label>Phone Number</label>\r\n                                    <input\r\n                                      type=\"number\"\r\n                                      required\r\n                                      name=\"phone\"\r\n                                      placeholder=\"Phone Number\"\r\n                                      onChange={handleChange}\r\n                                    />\r\n                                  </div>\r\n                                  <div className=\"dashboard-content-form-container\">\r\n                                    <label>Gender</label>\r\n                                    <select\r\n                                      name=\"gender\"\r\n                                      required\r\n                                      onChange={handleChange}\r\n                                    >\r\n                                      <option value=\"\">Select Gender</option>\r\n                                      <option value=\"Male\">Male</option>\r\n                                      <option value=\"Female\">Female</option>\r\n                                    </select>\r\n                                  </div>\r\n\r\n                                  <div className=\"dashboard-content-form-container\">\r\n                                    <label>Office Address</label>\r\n                                    <input\r\n                                      type=\"text\"\r\n                                      required\r\n                                      name=\"officeAddress\"\r\n                                      placeholder=\"Office Address\"\r\n                                      onChange={handleChange}\r\n                                    />\r\n                                  </div>\r\n                                  <div className=\"dashboard-content-form-container\">\r\n                                    <label>Home Address</label>\r\n                                    <input\r\n                                      type=\"text\"\r\n                                      required\r\n                                      name=\"homeAddress\"\r\n                                      placeholder=\"Home Address\"\r\n                                      onChange={handleChange}\r\n                                    />\r\n                                  </div>\r\n                                  <div className=\"dashboard-content-form-container\">\r\n                                    <label>Profession</label>\r\n                                    {/* <select\r\n                                          name=\"profession\"\r\n                                          required\r\n                                          onChange={handleChange}\r\n                                        >\r\n                                          <option value=\"\">\r\n                                            Choose Profession\r\n                                          </option>\r\n                                          <option value=\"Civil Servant\">\r\n                                            Civil Servant\r\n                                          </option>\r\n                                          <option value=\"Self Employed\">\r\n                                            Self Employed\r\n                                          </option>\r\n                                          <option value=\"Private worker\">\r\n                                            Private worker\r\n                                          </option>\r\n\r\n                                          <option\r\n                                            className=\"other\"\r\n                                            key=\"Other\"\r\n                                            value=\"Other\"\r\n                                          >\r\n                                            Other\r\n                                          </option>\r\n                                        </select> */}\r\n                                    <input\r\n                                      onChange={handleChange}\r\n                                      required\r\n                                      name=\"profession\"\r\n                                      type=\"text\"\r\n                                      placeholder=\"Enter Profession\"\r\n                                    ></input>\r\n\r\n                                    {/* {showProfessionalInput1 ? (\r\n                                          <input\r\n                                            onChange={handleChange}\r\n                                            name=\"profession\"\r\n                                            type=\"text\"\r\n                                            placeholder=\"Enter Profession\"\r\n                                          ></input>\r\n                                        ) : (\r\n                                          <>\r\n                                          </>\r\n                                        )} */}\r\n                                  </div>\r\n                                  <div className=\"dashboard-content-form-container\">\r\n                                    <label>Name of Organisation</label>\r\n                                    <input\r\n                                      type=\"text\"\r\n                                      required\r\n                                      name=\"organisation\"\r\n                                      placeholder=\"Name of organisation\"\r\n                                      onChange={handleChange}\r\n                                    />\r\n                                  </div>\r\n                                  <div className=\"dashboard-content-form-container\">\r\n                                    <label>Name of Employer</label>\r\n                                    <input\r\n                                      type=\"text\"\r\n                                      required\r\n                                      name=\"employer\"\r\n                                      placeholder=\"Name of employer\"\r\n                                      onChange={handleChange}\r\n                                    />\r\n                                  </div>\r\n                                  <div className=\"dashboard-content-form-container\">\r\n                                    <label>Email Address of Employer</label>\r\n                                    <input\r\n                                      type=\"email\"\r\n                                      required\r\n                                      name=\"employerMail\"\r\n                                      placeholder=\"Email Address of Employer\"\r\n                                      onChange={handleChange}\r\n                                    />\r\n                                  </div>\r\n                                  <div className=\"dashboard-content-form-container\">\r\n                                    <label>Phone of Employer</label>\r\n                                    <input\r\n                                      type=\"phone\"\r\n                                      required\r\n                                      name=\"employerPhone\"\r\n                                      placeholder=\"Phone of Employer\"\r\n                                      onChange={handleChange}\r\n                                    />\r\n                                  </div>\r\n                                  <div className=\"dashboard-content-form-container\">\r\n                                    <label>\r\n                                      Relationship with guarantor (Who is your\r\n                                      guarantor to you?)\r\n                                    </label>\r\n\r\n                                    <input\r\n                                      onChange={handleChange}\r\n                                      required\r\n                                      name=\"relationship\"\r\n                                      type=\"text\"\r\n                                      placeholder=\"Enter Relationship\"\r\n                                    ></input>\r\n\r\n                                    {/* <select\r\n                                          name=\"relationship\"\r\n                                          required\r\n                                          onChange={handleChange}\r\n                                        >\r\n                                          <option value=\"\">\r\n                                            Select Relationship\r\n                                          </option>\r\n                                          <option value=\"Parents\">Parents</option>\r\n                                          <option value=\"Legal Guardian\">\r\n                                            Legal Guardian\r\n                                          </option>\r\n                                          <option value=\"Employer\">Employer</option>\r\n                                          <option value=\"Other\">Other</option>\r\n                                        </select> */}\r\n\r\n                                    {/* {showGuarantorRelationshipInput1 ? (\r\n                                          <input\r\n                                            onChange={handleChange}\r\n                                            name=\"relationship\"\r\n                                            type=\"text\"\r\n                                            placeholder=\"Enter Relationship\"\r\n                                          ></input>\r\n                                        ) : (\r\n                                          <></>\r\n                                        )} */}\r\n                                  </div>\r\n                                  <button\r\n                                    style={{ float: \"right\", width: \"100px\" }}\r\n                                    type=\"submit\"\r\n                                    id=\"actionBtn\"\r\n                                  >\r\n                                    Proceed\r\n                                  </button>\r\n                                </form>\r\n                              </div>\r\n                            ) : (\r\n                              <div className=\"dashboard-content-form\">\r\n                                <form\r\n                                  // onSubmit={(e) => submitForm(e, \"guarantor2\")}\r\n                                  onSubmit={(e) => SubmitGuarantorForm_2(e)}\r\n                                  id=\"guarantorForm2\"\r\n                                >\r\n                                  <div className=\"dashboard-content-form-container\">\r\n                                    <label>First Name</label>\r\n                                    <input\r\n                                      type=\"text\"\r\n                                      required\r\n                                      name=\"firstName\"\r\n                                      placeholder=\"FirstName\"\r\n                                      onChange={handleChange}\r\n                                    />\r\n                                  </div>\r\n                                  <div className=\"dashboard-content-form-container\">\r\n                                    <label>Last Name</label>\r\n                                    <input\r\n                                      type=\"text\"\r\n                                      required\r\n                                      name=\"lastName\"\r\n                                      placeholder=\"LastName\"\r\n                                      onChange={handleChange}\r\n                                    />\r\n                                  </div>\r\n                                  <div className=\"dashboard-content-form-container\">\r\n                                    <label>Email Address</label>\r\n                                    <input\r\n                                      type=\"email\"\r\n                                      required\r\n                                      name=\"email\"\r\n                                      placeholder=\"Email Address\"\r\n                                      onChange={handleChange}\r\n                                    />\r\n                                  </div>\r\n                                  <div className=\"dashboard-content-form-container\">\r\n                                    <label>Phone Number</label>\r\n                                    <input\r\n                                      type=\"number\"\r\n                                      required\r\n                                      name=\"phone\"\r\n                                      placeholder=\"Phone Number\"\r\n                                      onChange={handleChange}\r\n                                    />\r\n                                  </div>\r\n                                  <div className=\"dashboard-content-form-container\">\r\n                                    <label>Gender</label>\r\n                                    <select\r\n                                      name=\"gender\"\r\n                                      required\r\n                                      onChange={handleChange}\r\n                                    >\r\n                                      <option value=\"\">Select Gender</option>\r\n                                      <option value=\"Male\">Male</option>\r\n                                      <option value=\"Female\">Female</option>\r\n                                    </select>\r\n                                  </div>\r\n                                  <div className=\"dashboard-content-form-container\">\r\n                                    <label>Office Address</label>\r\n                                    <input\r\n                                      type=\"text\"\r\n                                      required\r\n                                      name=\"officeAddress\"\r\n                                      placeholder=\"Office Address\"\r\n                                      onChange={handleChange}\r\n                                    />\r\n                                  </div>\r\n                                  <div className=\"dashboard-content-form-container\">\r\n                                    <label>Home Address</label>\r\n                                    <input\r\n                                      type=\"text\"\r\n                                      required\r\n                                      name=\"homeAddress\"\r\n                                      placeholder=\"Home Address\"\r\n                                      onChange={handleChange}\r\n                                    />\r\n                                  </div>\r\n                                  <div className=\"dashboard-content-form-container\">\r\n                                    <label>Profession</label>\r\n                                    <input\r\n                                      onChange={handleChange}\r\n                                      name=\"profession\"\r\n                                      required\r\n                                      type=\"text\"\r\n                                      placeholder=\"Enter Profession\"\r\n                                    ></input>\r\n\r\n                                    {/* <select\r\n                                          name=\"profession\"\r\n                                          required\r\n                                          onChange={handleChange}\r\n                                        >\r\n                                          <option value=\"\">\r\n                                            Choose Profession\r\n                                          </option>\r\n                                          <option value=\"Civil Servant\">\r\n                                            Civil Servant\r\n                                          </option>\r\n                                          <option value=\"Self Employed\">\r\n                                            Self Employed\r\n                                          </option>\r\n                                          <option value=\"Private worker\">\r\n                                            Private worker\r\n                                          </option>\r\n                                          <option value=\"Other\">Other</option>\r\n                                        </select> */}\r\n                                  </div>\r\n                                  <div className=\"dashboard-content-form-container\">\r\n                                    <label>Name of Organisation</label>\r\n                                    <input\r\n                                      type=\"text\"\r\n                                      required\r\n                                      name=\"organisation\"\r\n                                      placeholder=\"Name of organisation\"\r\n                                      onChange={handleChange}\r\n                                    />\r\n                                  </div>\r\n                                  <div className=\"dashboard-content-form-container\">\r\n                                    <label>Name of Employer</label>\r\n                                    <input\r\n                                      type=\"text\"\r\n                                      required\r\n                                      name=\"employer\"\r\n                                      placeholder=\"Name of employer\"\r\n                                      onChange={handleChange}\r\n                                    />\r\n                                  </div>\r\n                                  <div className=\"dashboard-content-form-container\">\r\n                                    <label>Email Address of Employer</label>\r\n                                    <input\r\n                                      type=\"email\"\r\n                                      required\r\n                                      name=\"employerMail\"\r\n                                      placeholder=\"Email Address of Employer\"\r\n                                      onChange={handleChange}\r\n                                    />\r\n                                  </div>\r\n                                  <div className=\"dashboard-content-form-container\">\r\n                                    <label>Phone of Employer</label>\r\n                                    <input\r\n                                      type=\"phone\"\r\n                                      required\r\n                                      name=\"employerPhone\"\r\n                                      placeholder=\"Phone of Employer\"\r\n                                      onChange={handleChange}\r\n                                    />\r\n                                  </div>\r\n                                  <div className=\"dashboard-content-form-container\">\r\n                                    <label>Relationship with guarantor</label>\r\n                                    <input\r\n                                      onChange={handleChange}\r\n                                      required\r\n                                      name=\"relationship\"\r\n                                      type=\"text\"\r\n                                      placeholder=\"Enter Relationship\"\r\n                                    ></input>\r\n                                    {/* \r\n                                        <select\r\n                                          name=\"relationship\"\r\n                                          required\r\n                                          onChange={handleChange}\r\n                                        >\r\n                                          <option value=\"\">\r\n                                            Select Relationship\r\n                                          </option>\r\n                                          <option value=\"Parents\">Parents</option>\r\n                                          <option value=\"Legal Guardian\">\r\n                                            Legal Guardian\r\n                                          </option>\r\n                                          <option value=\"Employer\">Employer</option>\r\n                                          <option value=\"Other\">Other</option>\r\n                                        </select> */}\r\n                                  </div>\r\n                                  <button\r\n                                    style={{ float: \"right\", width: \"100px\" }}\r\n                                    type=\"submit\"\r\n                                    id=\"actionBtn\"\r\n                                  >\r\n                                    Submit\r\n                                  </button>\r\n                                </form>\r\n                              </div>\r\n                            )}\r\n                          </div>\r\n                        )}\r\n                      </div>\r\n                    ) : (\r\n                      <div>\r\n                        {selectStatus === \"congrats\" &&\r\n                          selectStatus !== \"paid\" && (\r\n                            <div>\r\n                              <h3>Hello {details.firstName}</h3>\r\n                              <p className=\"text1\">Congratulations!</p>\r\n                              <p>\r\n                                Your application has been Admitted. Click on the\r\n                                button below to Pay Now.\r\n                              </p>\r\n                              <button onClick={() => setSelectStatus2(\"pay\")}>\r\n                                Pay Now\r\n                              </button>\r\n\r\n                              {selectStatus2 === \"pay\" && (\r\n                                <div className=\"dashboard-content-modal\">\r\n                                  <div className=\"dashboard-content-modal-backdrop\"></div>\r\n                                  <div className=\"dashboard-content-modal-container\">\r\n                                    <div className=\"dashboard-content-modal-main\">\r\n                                      <div className=\"dashboard-content-modal-main-text\">\r\n                                        <h4>Choose Payment Option</h4>\r\n                                        <img\r\n                                          src={cancel}\r\n                                          alt=\"cancel\"\r\n                                          onClick={() => setSelectStatus2(\"\")}\r\n                                        />\r\n                                      </div>\r\n                                      <div\r\n                                        className={\r\n                                          payOpt === \"part\"\r\n                                            ? \"active\"\r\n                                            : \"dashboard-content-modal-main-frame1\"\r\n                                        }\r\n                                        onClick={() => {\r\n                                          setPayOpt(\"part\");\r\n                                          setAmount(30000);\r\n                                          setCurrency(\"NGN\");\r\n                                        }}\r\n                                      >\r\n                                        <div></div>\r\n                                        <p>\r\n                                          Pay as you earn (NGN 30,000 legal fee)\r\n                                        </p>\r\n                                      </div>\r\n                                      <div\r\n                                        className={\r\n                                          payOpt === \"full\"\r\n                                            ? \"active\"\r\n                                            : \"dashboard-content-modal-main-frame1\"\r\n                                        }\r\n                                        onClick={() => {\r\n                                          setPayOpt(\"full\");\r\n                                          setAmount(585000);\r\n                                          setCurrency(\"NGN\");\r\n                                        }}\r\n                                      >\r\n                                        <div></div>\r\n                                        <p>\r\n                                          Pay at once (USD 1,000 = NGN 585,000)\r\n                                        </p>\r\n                                      </div>\r\n                                      <button\r\n                                        onClick={() => flutterWavePayment()}\r\n                                      >\r\n                                        Proceed\r\n                                      </button>\r\n                                    </div>\r\n                                  </div>\r\n                                </div>\r\n                              )}\r\n                            </div>\r\n                          )}\r\n                      </div>\r\n                    )}\r\n\r\n                    {selectStatus === \"paid\" && (\r\n                      <PaymentReceived fname={details.firstName} />\r\n                    )}\r\n                  </div>\r\n                )}\r\n\r\n                {status === \"Rejected\" && (\r\n                  <Rejected fname={details.firstName} />\r\n                )}\r\n              </div>\r\n            )}\r\n            {sidebarClick === \"details\" && <Details />}\r\n          </div>\r\n        </div>\r\n      ) : (\r\n        <Loader />\r\n      )}\r\n    </>\r\n  );\r\n}\r\n\r\nexport default Dashboard;\r\n","C:\\Users\\mitchel\\Documents\\grazac\\code\\grazac-academy-web\\src\\pages\\hire\\index.js",["252","253","254","255","256","257","258","259","260"],"import React, { useState, useEffect } from \"react\";\r\nimport { Container, Row, Col } from \"react-bootstrap\";\r\nimport Navbar from \"../../components/Navbar\";\r\nimport Footer from \"../../components/Footer\";\r\nimport Mode from \"../../components/Mode\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { getAllTalents } from \"../../api/dashboard/hire\";\r\n\r\nimport Sponsor1 from \"../../images/svg/Apple.svg\";\r\nimport Sponsor2 from \"../../images/svg/AWS.svg\";\r\nimport Sponsor3 from \"../../images/svg/Flutterwave.svg\";\r\nimport Sponsor5 from \"../../images/svg/Microsoft.svg\";\r\nimport Sponsor6 from \"../../images/svg/Google.svg\";\r\n// import whyHire from \"../../images/why-hire.png\";\r\nimport whyHire from \"../../images/why_hire_2.jpg\";\r\n\r\nimport man from \"../../images/man.jpg\";\r\nimport my_love from \"../../images/my_love.png\";\r\nimport kamala from \"../../images/kamala.jpg\";\r\nimport arrow from \"../../images/svg/arrow-front.svg\";\r\nimport star from \"../../images/svg/star.svg\";\r\nimport Loader from \"../../components/Loader\";\r\n\r\nconst Hire = () => {\r\n  const [carousel, setCarousel] = useState(\"one\");\r\n  const [carouselInfo, setCarouselInfo] = useState({\r\n    firstName: \"Jonathan Doe\",\r\n    profession: \"Product Designer\",\r\n    profile_upload: man,\r\n    stars: 4,\r\n  });\r\n  const [talents, setTalents] = useState([]);\r\n  const [index, setIndex] = useState(0);\r\n\r\n  useEffect(() => {\r\n    document.title = \"Hire - Grazac Academy\";\r\n    // window.scrollTo(0, 0);\r\n    getAllTalents(1)\r\n      .then((response) => response)\r\n      .then((resp) => {\r\n        // console.log(resp);\r\n        if (resp.status === 200) {\r\n          setTalents(resp.data.data.users);\r\n          // console.log(resp.data.data.users)\r\n\r\n          setCarouselInfo(resp.data.data.users[0]);\r\n          // console.log(resp.data.data.users[0])\r\n        } else {\r\n          alert(\r\n            `Something went wrong, please try again!!! Message: ${resp.data.message}`\r\n          );\r\n        }\r\n      })\r\n      .catch((err) => {\r\n        console.log(err);\r\n        alert(`Something went wrong, please try again!!!`);\r\n      });\r\n  }, []);\r\n\r\n  // console.log(talents)\r\n\r\n  const carouselPple = [\r\n    {\r\n      name: \"Jonathan Doe\",\r\n      position: \"Software Engineer, Primer AI\",\r\n      stars: 4,\r\n    },\r\n    {\r\n      name: \"Miracle Shadare\",\r\n      position: \"Content Writer, Grazac\",\r\n      stars: 4,\r\n    },\r\n    {\r\n      name: \"Rebecca West\",\r\n      position: \"Product Designer, Google LLC\",\r\n      stars: 4,\r\n    },\r\n  ];\r\n\r\n  const whyContent = [\r\n    {\r\n      heading: \"Competency\",\r\n      paragraph:\r\n        \"Our tech talents are adequately trained to be globally certified and competent to work anywhere in the world whether remotely or on-site.\",\r\n    },\r\n    {\r\n      heading: \"Good knowledge of soft skills\",\r\n      paragraph:\r\n        \"Our tech talents are not only vast with tech skills and tools, but also equipped with soft skills that will foster great workplace ethics.\",\r\n    },\r\n    {\r\n      heading: \"Strong Problem solving skill\",\r\n      paragraph:\r\n        \"Our tech talents are not just entry levels, they have gone through an in-depth internship program giving them prior workplace experience and they are practical oriented.\",\r\n    },\r\n    {\r\n      heading: \"No Hiring Stress\",\r\n      paragraph:\r\n        \"You won't have to sift through hundreds of fresh applications to determine the perfect fit for the position you're looking for.\",\r\n    },\r\n  ];\r\n\r\n  return (\r\n    <div>\r\n      {console.log(talents)}\r\n\r\n      {talents.length != 0 ? (\r\n        <div>\r\n          <Navbar />\r\n          <div className=\"hire\">\r\n            <div className=\"hire_hero\">\r\n              <Container>\r\n                <Row>\r\n                  <Col md={6}>\r\n                    <div>\r\n                      <h1>Hire top tech talents from our pool</h1>\r\n                      <p>\r\n                        Attracting the best tech talent is competitive, let’s\r\n                        pull them out from our pool.\r\n                      </p>\r\n                      <Link to=\"/hire/listing\">\r\n                        <button>Hire from Us</button>\r\n                      </Link>\r\n                    </div>\r\n                  </Col>\r\n                  <Col md={6}>\r\n                    <div className=\"hire_hero-carousel\">\r\n                      {carousel === \"one\" && (\r\n                        <img\r\n                          src={talents[0]?.profile_upload}\r\n                          alt=\"main-image\"\r\n                          className=\"hire_hero-carousel-mainImage\"\r\n                        />\r\n                      )}\r\n                      {carousel === \"two\" && (\r\n                        <img\r\n                          src={talents[1]?.profile_upload}\r\n                          alt=\"main-image\"\r\n                          className=\"hire_hero-carousel-mainImage\"\r\n                        />\r\n                      )}\r\n                      {carousel === \"three\" && (\r\n                        <img\r\n                          src={talents[2]?.profile_upload}\r\n                          alt=\"main-image\"\r\n                          className=\"hire_hero-carousel-mainImage\"\r\n                        />\r\n                      )}\r\n                      <div\r\n                        className={\r\n                          carousel === \"one\"\r\n                            ? \"hire_hero-carousel-frame box1 crs-bg\"\r\n                            : \"hire_hero-carousel-frame box1\"\r\n                        }\r\n                      >\r\n                        <div\r\n                          className=\"hire_hero-carousel-frame-image\"\r\n                          onClick={() => {\r\n                            setCarousel(\"one\");\r\n                            setCarouselInfo(talents[0]);\r\n                          }}\r\n                        >\r\n                          <img src={talents[0]?.profile_upload} alt=\"picx\" />\r\n                        </div>\r\n                      </div>\r\n                      <div\r\n                        className={\r\n                          carousel === \"two\"\r\n                            ? \"hire_hero-carousel-frame box2 crs-bg\"\r\n                            : \"hire_hero-carousel-frame box2\"\r\n                        }\r\n                      >\r\n                        <div\r\n                          className=\"hire_hero-carousel-frame-image\"\r\n                          onClick={() => {\r\n                            setCarousel(\"two\");\r\n                            setCarouselInfo(talents[1]);\r\n                          }}\r\n                        >\r\n                          <img src={talents[1]?.profile_upload} alt=\"picx\" />\r\n                        </div>\r\n                      </div>\r\n                      <div\r\n                        className={\r\n                          carousel === \"three\"\r\n                            ? \"hire_hero-carousel-frame box3 crs-bg\"\r\n                            : \"hire_hero-carousel-frame box3\"\r\n                        }\r\n                      >\r\n                        <div\r\n                          className=\"hire_hero-carousel-frame-image\"\r\n                          onClick={() => {\r\n                            setCarousel(\"three\");\r\n                            setCarouselInfo(talents[2]);\r\n                          }}\r\n                        >\r\n                          <img src={talents[2]?.profile_upload} alt=\"picx\" />\r\n                        </div>\r\n                      </div>\r\n                      <div className=\"hire_hero-carousel-textbox\">\r\n                        <div>\r\n                          <h4>\r\n                            {carouselInfo?.firstName} {carouselInfo?.lastName}\r\n                          </h4>\r\n                          <p>{carouselInfo?.profession}</p>\r\n                          <div>\r\n                            <img src={star} alt=\"star\" />\r\n                            <img src={star} alt=\"star\" />\r\n                            <img src={star} alt=\"star\" />\r\n                            <img src={star} alt=\"star\" />\r\n                          </div>\r\n                        </div>\r\n                      </div>\r\n                    </div>\r\n                  </Col>\r\n                </Row>\r\n              </Container>\r\n            </div>\r\n\r\n            <div className=\"landing__sponsors\">\r\n              <div className=\"landing__sponsors--container\">\r\n                <img src={Sponsor1} alt=\"sponsor\" />\r\n                <img src={Sponsor2} alt=\"sponsor\" />\r\n                <img src={Sponsor3} alt=\"sponsor\" />\r\n                <img src={Sponsor5} alt=\"sponsor\" />\r\n                <img src={Sponsor6} alt=\"sponsor\" />\r\n              </div>\r\n            </div>\r\n\r\n            <div className=\"hire_why\">\r\n              <Container>\r\n                <Row> \r\n                  <Col md={6}>\r\n                    <img src={whyHire} alt=\"why-hire\" className=\"hire_why-img\" />\r\n                  </Col>\r\n                  <Col md={6}>\r\n                    <div className=\"hire_why-content\">\r\n                      <h2>\r\n                        Why Top Companies <br />\r\n                        Hire from Us\r\n                      </h2>\r\n                      {whyContent.map((item, idx) => (\r\n                        <div key={idx}>\r\n                          <p className=\"hire_why-content-heading\">\r\n                            {item.heading}\r\n                          </p>\r\n                          <p className=\"hire_why-content-paragraph\">\r\n                            {item.paragraph}\r\n                          </p>\r\n                        </div>\r\n                      ))}\r\n                    </div>\r\n                  </Col>\r\n                </Row>\r\n              </Container>\r\n            </div>\r\n\r\n            <div className=\"hire_talents\">\r\n              <h2>Our Top Talents</h2>\r\n              <div className=\"hire_talents-define\">\r\n                <p>\r\n                  You determine the starting points, we provide the best\r\n                  possible interception to achieve the goals.\r\n                </p>\r\n              </div>\r\n              <div className=\"hire_talents-cards\">\r\n                <Container>\r\n                  <Row>\r\n                    {talents.slice(0, 6).map((item, idx) => (\r\n                      <Col md={4} sm={6} key={idx}>\r\n                        <Link\r\n                          to={`/hire/profile?id=${item.id}&/${item.firstName}-${item.lastName}`}\r\n                        >\r\n                          <div className=\"hire_talents-cards-box\">\r\n                            <div className=\"hire_talents-cards-box-image\">\r\n                              <img src={item.profile_upload} alt=\"talent\" />\r\n                            </div>\r\n                            <div className=\"hire_talents-cards-box-text\">\r\n                              <h4>\r\n                                {item.firstName} {item.lastName}\r\n                              </h4>\r\n                              <p className=\"hire_talents-cards-box-text-1\">\r\n                                {item.profession}\r\n                              </p>\r\n                              <div\r\n                                className={\r\n                                  item.status === \"Hired\"\r\n                                    ? \"hire_talents-cards-box-text-hired\"\r\n                                    : \"hire_talents-cards-box-text-available\"\r\n                                }\r\n                              >\r\n                                <p>\r\n                                  {item.status === \"Hired\"\r\n                                    ? \"HIRED\"\r\n                                    : \"AVAILABLE\"}\r\n                                </p>\r\n                              </div>\r\n                            </div>\r\n                          </div>\r\n                        </Link>\r\n                      </Col>\r\n                    ))}\r\n                  </Row>\r\n                </Container>\r\n                <Link to=\"/hire/listing\">\r\n                  <button>\r\n                    View more\r\n                    <img src={arrow} alt=\"alt\" />\r\n                  </button>\r\n                </Link>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <Mode\r\n            page={\"hire\"}\r\n            title={\"Make your dream job your real job\"}\r\n            text={\r\n              \"Learn in-demand tech skills with us and become globally sought-after in the digital space.\"\r\n            }\r\n            button_1={\"Learn with us\"}\r\n            button_2={\"Contact us\"}\r\n          />\r\n          <Footer />\r\n        </div>\r\n      ) : (\r\n        <Loader />\r\n      )}\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default Hire;\r\n","C:\\Users\\mitchel\\Documents\\grazac\\code\\grazac-academy-web\\src\\components\\Footer.js",["261","262","263","264"],"import { Link } from \"react-router-dom\";\r\nimport Facebook from \"../images/svg/facebook.svg\"\r\nimport Instagram from \"../images/svg/instagram.svg\"\r\nimport Twitter from \"../images/svg/twitter.svg\"\r\nimport Youtube from \"../images/svg/youtube.svg\"\r\nimport Logo from \"../images/svg/grazac-logo.svg\";\r\n\r\nconst Footer = () => {\r\n  return(\r\n    <div className=\"footer\">\r\n      <div className=\"footer__container\">\r\n        <div className=\"footer__links\">\r\n          <ul className=\"footer__list\">\r\n            <li className=\"footer__item footer__item--head\">\r\n              <div className=\"footer__logo\">\r\n                <Link to=\"/\">\r\n                  <img src={Logo} alt=\"logo\" />\r\n                </Link>\r\n              </div>\r\n            </li>\r\n            <li className=\"footer__item\">Grazac Academy gives you the opportunity to learn in-demand skills to build your technology career.</li>\r\n            <li className=\"footer__item\"><a href=\"tel:+234806 836 5951\">+234 806 836 5951</a></li>\r\n          </ul>\r\n\r\n          <ul className=\"footer__list\">\r\n            <li className=\"footer__item footer__item--head\">Company</li>\r\n            <li className=\"footer__item\"><Link to=\"/about-us\">About</Link></li>\r\n            <li className=\"footer__item\"><Link to=\"/contact\">Contact Us</Link></li>\r\n          </ul>\r\n\r\n          <ul className=\"footer__list\">\r\n            <li className=\"footer__item footer__item--head\">What We Offer</li>\r\n            <li className=\"footer__item\"><Link to=\"/login\">Learn with us</Link></li>\r\n            <li className=\"footer__item\"><Link to=\"/hire\">Hire our Talents</Link></li>\r\n          </ul>\r\n\r\n          <ul className=\"footer__list\">\r\n            <li className=\"footer__item footer__item--head\">Discover</li>\r\n            <li className=\"footer__item\"><Link to=\"/faq\">FAQs</Link></li>\r\n            {/* <li className=\"footer__item\"><Link>Book a Call</Link></li> */}\r\n            {/* <li className=\"footer__item\"><Link to=\"/training/coming-soon\">Corporate Training</Link></li>\r\n            <li className=\"footer__item\"><Link to=\"/hire/coming-soon\">Grazac Hire</Link></li> */}\r\n          </ul>\r\n        </div>\r\n\r\n        <div className=\"footer__line\">&nbsp;</div>\r\n\r\n        <div className=\"footer__bottom\">\r\n          <Link>Privacy & Policy</Link>\r\n          <Link>Terms of Service</Link>\r\n\r\n          <p>©{new Date().getFullYear()} Grazac Technologies. All Rights Reserved</p>\r\n\r\n          <div className=\"footer__icons\">\r\n            <a href=\"https://www.youtube.com/channel/UCAQ_Q8wYZloETgrdlBbwMtg\" target=\"_blank\"><img src={Youtube} alt=\"icon\" /></a>\r\n            <a href=\"https://twitter.com/grazacacademy\" target=\"_blank\"><img src={Twitter} alt=\"icon\" /></a>\r\n            <a href=\"https://www.instagram.com/grazacacademy/\" target=\"_blank\"><img src={Instagram} alt=\"icon\" /></a>\r\n            <a href=\"https://www.facebook.com/grazacng\" target=\"_blank\"><img src={Facebook} alt=\"icon\" /></a>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default Footer;","C:\\Users\\mitchel\\Documents\\grazac\\code\\grazac-academy-web\\src\\components\\Navbar.js",["265","266","267"],"import { useEffect, useState, useRef } from \"react\";\r\nimport { cn } from \"../utils\";\r\nimport NavItem from \"./NavItem\";\r\nimport logo from \"../images/svg/grazac-logo.svg\";\r\nimport { Link } from \"react-router-dom\";\r\nimport InfoModal from \"../components/InfoModal\";\r\n\r\nconst Navbar = ({ top }) => {\r\n  const [fixed, setFixed] = useState(false);\r\n  const [active, setActive] = useState(false);\r\n  const [hover, setHover] = useState(false);\r\n  const nav = useRef(null);\r\n\r\n  useEffect(() => {\r\n\r\n    if (nav.current && window.pageYOffset > nav.current.offsetTop) {\r\n      setFixed(true);\r\n    } else {\r\n      setFixed(false);\r\n    }\r\n    window.addEventListener(\"scroll\", () => {\r\n      if (nav.current && window.pageYOffset > nav.current.offsetTop)\r\n        setFixed(true);\r\n      else setFixed(false);\r\n    });\r\n  }, []);\r\n\r\n  const handleClick = (e) => {\r\n    e.preventDefault();\r\n\r\n    if (active) setActive(false);\r\n    else setActive(true);\r\n  };\r\n\r\n  return (\r\n    <nav className={cn(\"nav\", { \"nav--fixed\": fixed })} ref={nav}>\r\n      <div className=\"nav__container\">\r\n        <div className=\"nav__logo\">\r\n          <Link to=\"/\">\r\n            <img src={logo} alt=\"logo\" />\r\n          </Link>\r\n        </div>\r\n\r\n        <div className={cn(\"nav__menu\", { \"nav__menu--active\": active })}>\r\n          <button className=\"nav-tgl\" onClick={handleClick}>\r\n            <span>&nbsp;</span>\r\n          </button>\r\n\r\n          <ul className=\"nav__list--mb\">\r\n            <li className=\"nav__item\">\r\n              <NavItem exact link=\"/\">\r\n                <span>01</span>Home\r\n              </NavItem>\r\n            </li>\r\n            <li className=\"nav__item\">\r\n              <NavItem link=\"/about-us\">\r\n                <span>02</span>About\r\n              </NavItem>\r\n            </li>\r\n            <li className=\"nav__item\">\r\n              <NavItem link=\"/faq\">\r\n                <span>03</span>FAQs\r\n              </NavItem>\r\n            </li>\r\n            {/* <li className=\"nav__item\">\r\n              <NavItem link=\"/hire\">\r\n                <span>04</span>Hire\r\n              </NavItem>\r\n            </li> */}\r\n            <li className=\"nav__item\">\r\n              <a href=\"/login\">\r\n                <button onClick={() => setActive(false)}>Login</button>\r\n              </a>\r\n            </li>\r\n            <li className=\"nav__item\" style={{ marginTop: \"30px\" }}>\r\n              <a href=\"tel:+2348068365951\">\r\n                <button onClick={() => setActive(false)}>Talk to us</button>\r\n              </a>\r\n            </li>\r\n          </ul>\r\n        </div>\r\n\r\n        <ul className=\"nav__list\" style={{ marginBottom: 0 }}>\r\n          <li className=\"nav__item\">\r\n            <NavItem exact link=\"/\">\r\n              Home\r\n            </NavItem>\r\n          </li>\r\n          <li className=\"nav__item\">\r\n            <NavItem link=\"/about-us\">About</NavItem>\r\n          </li>\r\n          <li className=\"nav__item\">\r\n            <NavItem link=\"/faq\">FAQs</NavItem>\r\n          </li>\r\n          {/* <li className=\"nav__item\">\r\n            <NavItem link=\"/hire\">Hire</NavItem>\r\n          </li> */}\r\n          <a href=\"/login\">\r\n            <div className=\"nav__btn\">\r\n              <div className=\"nav__btn--text\">Go to Dashboard</div>\r\n            </div>\r\n          </a>\r\n          <a href=\"tel:+2348068365951\" style={{ marginLeft: \"20px\" }}>\r\n            <div className=\"nav__btn\">\r\n              <div className=\"nav__btn--text1\">Talk to us</div>\r\n            </div>\r\n          </a>\r\n        </ul>\r\n      </div>\r\n    </nav>\r\n  );\r\n};\r\n\r\nexport default Navbar;\r\n","C:\\Users\\mitchel\\Documents\\grazac\\code\\grazac-academy-web\\src\\components\\MOT.js",["268"],"import sprint from '../images/sprint.png';\r\nimport quote from '../images/svg/quote.svg';\r\nimport portfolio from '../images/svg/portfolio.svg';\r\nimport handshake from '../images/svg/handshake.svg';\r\nimport document from '../images/svg/document.svg';\r\nimport classroom from '../images/svg/classroom.svg';\r\n\r\n\r\nconst ModeOfTeaching = _ => {\r\n    return( \r\n        <div className=\"course_mode\">\r\n            <div className=\"container\">\r\n                <div className=\"course_wwd-intro\">\r\n                    <h4>What we do</h4>\r\n                    <h2>Mode Of Learning</h2>\r\n                    <p>We have designed strategic pathways that will fast track your learning curve.</p>\r\n                </div>\r\n                <div className=\"course_mode-container\">\r\n                    <div className=\"\">\r\n                        <div>\r\n                            <div className=\"boxes\">\r\n                                <div className=\"svg-box\">\r\n                                    <img src={classroom} alt=\"mode of learning\" />\r\n                                </div>\r\n                                <h3>Instructor-led live classes</h3>\r\n                                <p className=\"lenght1\">Join other students in our 100% physical classes with experts in the industry.</p>\r\n                            </div>\r\n                            <div className=\"boxes\">\r\n                                <div className=\"svg-box\">\r\n                                    <img src={portfolio} alt=\"mode of learning\" />\r\n                                </div>\r\n                                <h3>Networking</h3>\r\n                                <p className=\"lenght1\">Collaborate and communicate by exchanging ideas with other students of same interest to facilitate your career and build a community.</p>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"\">\r\n                        <div>\r\n                            <div className=\"boxes\">\r\n                                <div className=\"svg-box\">\r\n                                    <img src={document} alt=\"mode of learning\" />\r\n                                </div>\r\n                                <h3>Project Based Learning</h3>\r\n                                <p className=\"lenght1\">Opportunity to work on real-life projects by applying what you learn to enhance your skills and solve related problems.</p>\r\n                            </div>\r\n                            <div className=\"boxes\">\r\n                                <div className=\"svg-box\">\r\n                                    <img src={handshake} alt=\"mode of learning\" />\r\n                                </div>\r\n                                <h3>Mentorship Access</h3>\r\n                                <p className=\"lenght1\">Access to counselling and personalized guidance from mentors and thought leaders in your field that will increase your visibility to other employers.</p>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"mode-pic\">\r\n                        {/* <img src={sprint} alt=\"jdgkj\" style={{width:'100%'}} /> */}\r\n                    </div>\r\n                </div>\r\n                <div className=\"course_mode-quote\">\r\n                    <img src={quote} alt=\"quote\" />\r\n                    <p>I've known Grazac for over a year now and having worked with some of their successful students, I can boldly say the competency and problem solving skills of their students is top-notch and their academy is one of the best academy promoting technology skills acquisition here in Nigeria</p>\r\n                    <span>Samson Adedamola - Consultant at Kudi</span>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    )\r\n}\r\nexport default ModeOfTeaching;","C:\\Users\\mitchel\\Documents\\grazac\\code\\grazac-academy-web\\src\\components\\PrimaryBtn.js",[],"C:\\Users\\mitchel\\Documents\\grazac\\code\\grazac-academy-web\\src\\components\\Mode.js",["269","270","271","272","273","274","275"],"C:\\Users\\mitchel\\Documents\\grazac\\code\\grazac-academy-web\\src\\components\\dashboard\\Selected.js",[],"C:\\Users\\mitchel\\Documents\\grazac\\code\\grazac-academy-web\\src\\components\\dashboard\\Rejected.js",[],"C:\\Users\\mitchel\\Documents\\grazac\\code\\grazac-academy-web\\src\\components\\dashboard\\UnderReview.js",[],"C:\\Users\\mitchel\\Documents\\grazac\\code\\grazac-academy-web\\src\\components\\dashboard\\Details.js",["276","277","278","279","280","281","282"],"import { useEffect, useState } from \"react\";\r\nimport { ToastContainer, toast } from \"react-toastify\";\r\nimport {\r\n  getDetails,\r\n  getGuarantor,\r\n  getDetailsB,\r\n  editGuarantor,\r\n  submitGuarantor,\r\n} from \"../../api/dashboard/data\";\r\nimport axios from \"axios\";\r\n// import Loader from \"../Loader\";\r\n\r\nimport loader from \"../../images/loader-purple.gif\"\r\n\r\nfunction Details() {\r\n  const [isLoading, setIsLoading] = useState(false);\r\n  const [clicked, setClicked] = useState(\"bio\");\r\n  const [userDetails, setUserDetails] = useState({});\r\n  const [guarantorDetails_1, setGuarantorDetails_1] = useState([]);\r\n  const [guarantorDetails_2, setGuarantorDetails_2] = useState([]);\r\n\r\n  const [guarantorId_1, setGuarantorId_1] = useState(0);\r\n  const [guarantorId_2, setGuarantorId_2] = useState(0);\r\n\r\n  const userImage = `https://api.grazacacademy.com/uploads/${userDetails.means_of_identification}`;\r\n// console.log(guarantorDetails_1,userDetails)\r\n  const handleChange_1 = (e) => {\r\n    console.log(guarantorDetails_1[0]);\r\n\r\n    let guarantorData = [...guarantorDetails_1][0];\r\n    guarantorData[e.target.name] = e.target.value;\r\n\r\n    setGuarantorDetails_1([guarantorData]);\r\n    setGuarantorId_1(guarantorDetails_1[0].id);\r\n\r\n    console.log(guarantorData, guarantorId_1,guarantorDetails_1[0].id);\r\n  };\r\n\r\n\r\n  const handleChange_2 = (e) => {\r\n    console.log(guarantorDetails_2[0]);\r\n\r\n    let guarantorData = [...guarantorDetails_2][0];\r\n    guarantorData[e.target.name] = e.target.value;\r\n\r\n    setGuarantorDetails_2([guarantorData]);\r\n    // setGuarantorId_1(guarantorDetails_1[0]?.id);\r\n    setGuarantorId_2(guarantorDetails_2[0].id); \r\n    console.log(guarantorDetails_2[0].id)\r\n\r\n    console.log(guarantorData, guarantorId_2);\r\n  };\r\n\r\n\r\n\r\n  const SubmitGuarantorChange_1 = (e) => {\r\n    e.preventDefault();\r\n\r\n    const data = guarantorDetails_1;\r\n    console.log(data);\r\n    const final_data = [];\r\n    const new_data_1 = {};\r\n\r\n    for (let index = 0; index < data.length; index++) {\r\n      new_data_1[\"firstname\"] = data[0][\"firstname\"];\r\n      new_data_1[\"lastname\"] = data[0][\"lastname\"];\r\n      new_data_1[\"email\"] = data[0][\"email\"];\r\n      new_data_1[\"phone_number\"] = data[0][\"phone_number\"];\r\n      new_data_1[\"gender\"] = data[0][\"gender\"];\r\n      new_data_1[\"office_address\"] = data[0][\"office_address\"];\r\n      new_data_1[\"home_address\"] = data[0][\"home_address\"];\r\n      new_data_1[\"profession\"] = data[0][\"profession\"];\r\n      new_data_1[\"name_of_organization\"] = data[0][\"name_of_organization\"];\r\n      new_data_1[\"name_of_employer\"] = data[0][\"name_of_employer\"];\r\n      new_data_1[\"email_address_of_employer\"] =\r\n        data[0][\"email_address_of_employer\"];\r\n      new_data_1[\"phone_number_of_employer\"] =\r\n        data[0][\"phone_number_of_employer\"];\r\n      new_data_1[\"relationship_with_the_guarantor\"] =\r\n        data[0][\"relationship_with_the_guarantor\"];\r\n      new_data_1[\"user_id\"] = data[0][\"user_id\"];\r\n      console.log(\"end\");\r\n    }\r\n\r\n    console.log(new_data_1);\r\n    console.log(guarantorId_1)\r\n\r\n    axios\r\n      .put(\r\n        `https://api.grazacacademy.com/api/v1/user/edit-gurantor/${guarantorId_1}`,\r\n        new_data_1\r\n      )\r\n      .then(function (response) {\r\n        console.log(guarantorId_1)\r\n        console.log(response);\r\n        toast.success(\"saved successfully\");\r\n      })\r\n      .catch((res) => {\r\n        console.log(res.data);\r\n      });\r\n\r\n    // editGuarantor(final_data, guaID)\r\n    // .then((res) =>{\r\n    //   console.log(res)\r\n    //   toast.success(res.data)}\r\n    // )\r\n    // .catch((res) => {\r\n    //   toast.error(res.response)\r\n    //   console.log(res)\r\n    // })\r\n  };\r\n\r\n  const SubmitGuarantorChange_2 = (e) => {\r\n    e.preventDefault();\r\n\r\n    const data = guarantorDetails_2;\r\n    const new_data_1 = {};\r\n\r\n    for (let index = 0; index < data.length; index++) {\r\n      new_data_1[\"firstname\"] = data[0][\"firstname\"];\r\n      new_data_1[\"lastname\"] = data[0][\"lastname\"];\r\n      new_data_1[\"email\"] = data[0][\"email\"];\r\n      new_data_1[\"phone_number\"] = data[0][\"phone_number\"];\r\n      new_data_1[\"gender\"] = data[0][\"gender\"];\r\n      new_data_1[\"office_address\"] = data[0][\"office_address\"];\r\n      new_data_1[\"home_address\"] = data[0][\"home_address\"];\r\n      new_data_1[\"profession\"] = data[0][\"profession\"];\r\n      new_data_1[\"name_of_organization\"] = data[0][\"name_of_organization\"];\r\n      new_data_1[\"name_of_employer\"] = data[0][\"name_of_employer\"];\r\n      new_data_1[\"email_address_of_employer\"] =\r\n        data[0][\"email_address_of_employer\"];\r\n      new_data_1[\"phone_number_of_employer\"] =\r\n        data[0][\"phone_number_of_employer\"];\r\n      new_data_1[\"relationship_with_the_guarantor\"] =\r\n        data[0][\"relationship_with_the_guarantor\"];\r\n      new_data_1[\"user_id\"] = data[0][\"user_id\"];\r\n      console.log(\"end\");\r\n    }\r\n    console.log(new_data_1);\r\n    console.log(guarantorId_2)\r\n    setIsLoading(true)\r\n    axios\r\n      .put(\r\n        `https://api.grazacacademy.com/api/v1/user/edit-gurantor/${guarantorId_2}`,\r\n        new_data_1\r\n      )\r\n      .then(function (response) {\r\n        console.log(response);\r\n        toast.success(\"saving\");\r\n        setTimeout(()=>{toast.success(\"saved Successfully\")} ,5000)\r\n        toast.success(\"saved Successfully\");\r\n        setIsLoading(false)\r\n      })\r\n      .catch((res) => {\r\n        console.log(res.data);\r\n      });\r\n\r\n    // editGuarantor(final_data, guaID)\r\n    // .then((res) =>{\r\n    //   console.log(res)\r\n    //   toast.success(res.data)}\r\n    // )\r\n    // .catch((res) => {\r\n    //   toast.error(res.response)\r\n    //   console.log(res)\r\n    // })\r\n  };\r\n\r\n  useEffect(() => {\r\n    getDetailsB()\r\n      //   .then((res) => console.log(res.data['data']['results'][0]))\r\n      .then((res) => {\r\n        setIsLoading(true);\r\n        setUserDetails(res.data[\"data\"][\"results\"][0]);\r\n        setIsLoading(false);\r\n        // console.log(userDetails)\r\n        // console.log(res.data['data']['results'][0])\r\n      })\r\n      .catch((err) => {\r\n        console.log(err);\r\n        if (err.response) {\r\n          toast.error(err.response);\r\n        } else {\r\n          toast.error(\r\n            \"Something went wrong!!! Please make sure you have a good internet connection.\"\r\n          );\r\n        }\r\n      });\r\n\r\n    getGuarantor()\r\n      .then((response) => response.data)\r\n      .then((res) => {\r\n        setGuarantorDetails_1([res.data[0]]);\r\n        setGuarantorDetails_2([res.data[1]]);\r\n        console.log(res.data);\r\n        // setGuarantorId(res.data[0][\"id\"]);\r\n        // console.log(guarantorDetails);\r\n      })\r\n      .catch((err) => {\r\n        console.log(err);\r\n        if (err.response) {\r\n          toast.error(err.response);\r\n        } else {\r\n          toast.error(\r\n            \"Something went wrong!!! Please make sure you have a good internet connection.\"\r\n          );\r\n        }\r\n      });\r\n  }, [true])\r\n\r\n\r\n\r\n  return (\r\n    <div className=\"dashboard-content\">\r\n      {console.log()}\r\n      {Object.keys(userDetails).length === 0 ?\r\n      <div>\r\n       <img style={{ marginLeft: \"30rem\", marginTop: \"20rem\" }} src={loader} />\r\n       </div> : \r\n   \r\n       \r\n      <div>\r\n      <ToastContainer />\r\n      <h3 style={{ marginLeft: \"20px\", marginBottom: \"20px\" }}>Details</h3>\r\n      <div className=\"det-btn-container\">\r\n        <div className=\"dashboard-content-detail\">\r\n          <button\r\n            className={\r\n              clicked === \"bio\"\r\n                ? \"dashboard-content-detail-p active\"\r\n                : \"dashboard-content-detail-p\"\r\n            }\r\n            onClick={() => setClicked(\"bio\")}\r\n          >\r\n            Bio Data\r\n          </button>\r\n          <button\r\n            className={\r\n              clicked === \"edu\"\r\n                ? \"dashboard-content-detail-p active\"\r\n                : \"dashboard-content-detail-p\"\r\n            }\r\n            onClick={() => setClicked(\"edu\")}\r\n          >\r\n            Educational Background\r\n          </button>\r\n\r\n          {userDetails.payment_plan === \"pay as you earn\" && (\r\n            <button\r\n              className={\r\n                clicked === \"gua\"\r\n                  ? \"dashboard-content-detail-p active\"\r\n                  : \"dashboard-content-detail-p\"\r\n              }\r\n              onClick={() => setClicked(\"gua\")}\r\n            >\r\n              Guarantor Data\r\n            </button>\r\n          )}\r\n        </div>\r\n      </div>\r\n\r\n      {clicked === \"bio\" && (\r\n        <div className=\"dashboard-content-form\">\r\n          <form>\r\n            <div className=\"dashboard-content-form-container\">\r\n              <h5>First Name</h5>\r\n              <p>{userDetails?.firstName}</p>\r\n            </div>\r\n            <hr />\r\n            <div className=\"dashboard-content-form-container\">\r\n              <h5>Last Name</h5>\r\n              <p>{userDetails?.lastName}</p>\r\n            </div>\r\n            <hr />\r\n            <div className=\"dashboard-content-form-container\">\r\n              <h5>Email Address</h5>\r\n              <p>{userDetails?.email}</p>\r\n            </div>\r\n            <hr />\r\n            <div className=\"dashboard-content-form-container\">\r\n              <h5>Phone Number</h5>\r\n              <p>{userDetails?.phoneNumber}</p>\r\n            </div>\r\n            <hr />\r\n            <div className=\"dashboard-content-form-container\">\r\n              <h5>Date of Birth</h5>\r\n              <p>{userDetails?.dob?.slice(0, 10)}</p>\r\n            </div>\r\n            <hr />\r\n            <div className=\"dashboard-content-form-container\">\r\n              <h5>Gender</h5>\r\n              <p>{userDetails?.gender}</p>\r\n            </div>\r\n            <hr />\r\n            <div className=\"dashboard-content-form-container\">\r\n              <h5>Preferred course at Grazac</h5>\r\n              <p>{userDetails?.preferred_course}</p>\r\n            </div>\r\n            <hr />\r\n            <div className=\"dashboard-content-form-container\">\r\n              <h5>State of residence</h5>\r\n              <p>{userDetails?.state_of_residence}</p>\r\n            </div>\r\n            <hr />\r\n            <div className=\"dashboard-content-form-container\">\r\n              <h5>Current city and Location</h5>\r\n              <p>{userDetails?.current_city_and_location}</p>\r\n            </div>\r\n            <hr />\r\n            <div className=\"dashboard-content-form-container\">\r\n              <h5>Means of Identification (NIN/ Voter's Card)</h5>\r\n              <img\r\n                className=\"dashboard-content-form-container-image\"\r\n                src={userImage}\r\n                alt={userDetails.means_of_identification}\r\n              />\r\n            </div>\r\n          </form>\r\n        </div>\r\n      )}\r\n\r\n      {clicked === \"edu\" && (\r\n        <div className=\"dashboard-content-form\">\r\n          <form>\r\n            <div className=\"dashboard-content-form-container\">\r\n              <h5>Course of Study</h5>\r\n              <p>{userDetails?.course_of_study}</p>\r\n            </div>\r\n            <hr />\r\n            <div className=\"dashboard-content-form-container\">\r\n              <h5>Grade Achieved</h5>\r\n              <p>{userDetails?.grade_achieved}</p>\r\n            </div>\r\n            <hr />\r\n            <div className=\"dashboard-content-form-container\">\r\n              <h5>Qualifications</h5>\r\n              <p>{userDetails?.qualifications}</p>\r\n            </div>\r\n            <hr />\r\n            <div className=\"dashboard-content-form-container\">\r\n              <h5>Programming / Design Experience</h5>\r\n              <p>{userDetails?.programming_skills}</p>\r\n            </div>\r\n            <hr />\r\n            <div className=\"dashboard-content-form-container\">\r\n              <h5>NYSC Status</h5>\r\n              <p>{userDetails?.nysc_status}</p>\r\n            </div>\r\n            <hr />\r\n            <div className=\"dashboard-content-form-container\">\r\n              <h5>\r\n                Why do you think you should be selected as a part of this\r\n                cohort?\r\n              </h5>\r\n              <p>{userDetails?.why_selected_for_cohort}</p>\r\n            </div>\r\n            <hr />\r\n            <div className=\"dashboard-content-form-container\">\r\n              <h5>Will you be physically available for the next 6 months?</h5>\r\n              <p>{userDetails?.will_you_pay_legal_fees}</p>\r\n            </div>\r\n            <hr />\r\n            <div className=\"dashboard-content-form-container\">\r\n              <h5>\r\n                If selected, will you be able to pay the legal fees of #30,000?\r\n              </h5>\r\n              <p>{userDetails?.physically_available}</p>\r\n            </div>\r\n          </form>\r\n        </div>\r\n      )}\r\n      {clicked === \"gua\" && (\r\n        <div className=\"dashboard-content-form\">\r\n          <form\r\n            onSubmit={(e) => {\r\n              SubmitGuarantorChange_1(e);\r\n              setGuarantorId_1(guarantorDetails_1[0]?.id);\r\n            }}\r\n          >\r\n            <h4>Guarantor details 1</h4>\r\n            <div className=\"dashboard-content-form-container\"\r\n            \r\n            id={guarantorDetails_1[0]?.id}\r\n            >\r\n\r\n              {console.log(guarantorDetails_1[0]?.id)}\r\n\r\n              <h5>First Name</h5>\r\n              {/* {console.log(guarantorId_1)} */}\r\n              {/* <p>{guarantorDetails_1[0]?.firstname}</p> */}\r\n              {/* {console.log(guarantorDetails_1[0]?.id)} */}\r\n              <input\r\n                type=\"text\"\r\n                name=\"firstname\"\r\n                value={guarantorDetails_1[0]?.firstname}\r\n                onChange={(e) => handleChange_1(e)}\r\n              />\r\n            </div>\r\n            <hr />\r\n            <div className=\"dashboard-content-form-container\">\r\n              <h5>Last Name</h5>\r\n              {/* <p>{guarantorDetails_1[0]?.lastname}</p> */}\r\n              <input\r\n                type=\"text\"\r\n                name=\"lastname\"\r\n                value={guarantorDetails_1[0]?.lastname}\r\n                onChange={(e) => handleChange_1(e)}\r\n              />\r\n            </div>\r\n            <hr />\r\n            <div className=\"dashboard-content-form-container\">\r\n              <h5>Email Address</h5>\r\n              {/* <p>{guarantorDetails_1[0]?.email}</p> */}\r\n              <input\r\n                type=\"text\"\r\n                name=\"email\"\r\n                value={guarantorDetails_1[0]?.email}\r\n                onChange={(e) => handleChange_1(e)}\r\n              />\r\n            </div>\r\n            <hr />\r\n            <div className=\"dashboard-content-form-container\">\r\n              <h5>Phone Number</h5>\r\n              {/* <p>{guarantorDetails_1[0]?.phone_number}</p> */}\r\n              <input\r\n                type=\"text\"\r\n                name=\"phone_number\"\r\n                value={guarantorDetails_1[0]?.phone_number}\r\n                onChange={(e) => handleChange_1(e)}\r\n              />\r\n            </div>\r\n            <hr />\r\n            <div className=\"dashboard-content-form-container\">\r\n              <h5>Gender</h5>\r\n              {/* <p>{guarantorDetails_1[0]?.gender}</p> */}\r\n              <input\r\n                type=\"text\"\r\n                name=\"gender\"\r\n                value={guarantorDetails_1[0]?.gender}\r\n                onChange={(e) => handleChange_1(e)}\r\n              />\r\n            </div>\r\n            <hr />\r\n            <div className=\"dashboard-content-form-container\">\r\n              <h5>Office Address</h5>\r\n              {/* <p>{guarantorDetails_1[0]?.office_address}</p> */}\r\n              <input\r\n                type=\"text\"\r\n                name=\"office_address\"\r\n                value={guarantorDetails_1[0]?.office_address}\r\n                onChange={(e) => handleChange_1(e)}\r\n              />\r\n            </div>\r\n            <hr />\r\n            <div className=\"dashboard-content-form-container\">\r\n              <h5>Home Address</h5>\r\n              {/* <p>{guarantorDetails_1[0]?.home_address}</p> */}\r\n              <input\r\n                type=\"text\"\r\n                name=\"home_address\"\r\n                value={guarantorDetails_1[0]?.home_address}\r\n                onChange={(e) => handleChange_1(e)}\r\n              />\r\n            </div>\r\n            <hr />\r\n            <div className=\"dashboard-content-form-container\">\r\n              <h5>Profession</h5>\r\n              {/* <p>{guarantorDetails_1[0]?.profession}</p> */}\r\n              <input\r\n                type=\"text\"\r\n                name=\"profession\"\r\n                value={guarantorDetails_1[0]?.profession}\r\n                onChange={(e) => handleChange_1(e)}\r\n              />\r\n            </div>\r\n            <hr />\r\n            <div className=\"dashboard-content-form-container\">\r\n              <h5>Name of Organization</h5>\r\n              {/* <p>{guarantorDetails_1[0]?.name_of_organization}</p> */}\r\n              <input\r\n                type=\"text\"\r\n                name=\"name_of_organization\"\r\n                value={guarantorDetails_1[0]?.name_of_organization}\r\n                onChange={(e) => handleChange_1(e)}\r\n              />\r\n            </div>\r\n            <hr />\r\n            <div className=\"dashboard-content-form-container\">\r\n              <h5>Relationship with guarantor</h5>\r\n              {/* <p>{guarantorDetails_1[0]?.name_of_employer}</p> */}\r\n              <input\r\n                type=\"text\"\r\n                name=\"name_of_employer\"\r\n                value={guarantorDetails_1[0]?.name_of_employer}\r\n                onChange={(e) => handleChange_1(e)}\r\n              />\r\n            </div>\r\n            <hr />\r\n            <div className=\"dashboard-content-form-container\">\r\n              <h5>Email Address of Employer</h5>\r\n              {/* <p>{guarantorDetails_1[0]?.email_address_of_employer}</p> */}\r\n              <input\r\n                type=\"text\"\r\n                name=\"email_address_of_employer\"\r\n                value={guarantorDetails_1[0]?.email_address_of_employer}\r\n                onChange={(e) => handleChange_1(e)}\r\n              />\r\n            </div>\r\n            <hr />\r\n            <div className=\"dashboard-content-form-container\">\r\n              <h5>Phone Number of Employer</h5>\r\n              {/* <p>{guarantorDetails_1[0]?.phone_number_of_employer}</p> */}\r\n              <input\r\n                type=\"text\"\r\n                name=\"phone_number_of_employer\"\r\n                value={guarantorDetails_1[0]?.phone_number_of_employer}\r\n                onChange={(e) => handleChange_1(e)}\r\n              />\r\n            </div>\r\n            <hr />\r\n            <div className=\"dashboard-content-form-container\">\r\n              <h5>Relationship with guarantor</h5>\r\n              {/* <p>{guarantorDetails_1[0]?.relationship_with_the_guarantor}</p> */}\r\n              <input\r\n                type=\"text\"\r\n                name=\"relationship_with_the_guarantor\"\r\n                value={guarantorDetails_1[0]?.relationship_with_the_guarantor}\r\n                onChange={(e) => handleChange_1(e)}\r\n              />\r\n            </div>\r\n\r\n            <button type=\"submit\">Save</button>\r\n          </form>\r\n\r\n          <form\r\n            onSubmit={(e) => {\r\n              SubmitGuarantorChange_2(e);\r\n              setGuarantorId_2(guarantorDetails_2[0]?.id);\r\n            }}\r\n          >\r\n            <h4 style={{ marginTop: \"40px\" }}>Guarantor details 2</h4>\r\n            <div\r\n              className=\"dashboard-content-form-container\"\r\n              id={guarantorDetails_2[0]?.id}\r\n              key={guarantorDetails_2[0]?.id}\r\n            >\r\n              <h5>First Name</h5>\r\n              <input\r\n                type=\"text\"\r\n                name=\"firstname\"\r\n                value={guarantorDetails_2[0]?.firstname}\r\n                onChange={(e) => handleChange_2(e)}\r\n              />\r\n            </div>\r\n            {/* {console.log(guarantorDetails_2[0])} */}\r\n            <hr />\r\n            <div className=\"dashboard-content-form-container\">\r\n              <h5>Last Name</h5>\r\n              {/* <p>{guarantorDetails_2?.lastname}</p> */}\r\n              <input\r\n                type=\"text\"\r\n                name=\"lastname\"\r\n                value={guarantorDetails_2[0]?.lastname}\r\n                onChange={(e) => handleChange_2(e)}\r\n              />\r\n            </div>\r\n            <hr />\r\n            <div className=\"dashboard-content-form-container\">\r\n              <h5>Email Address</h5>\r\n              {/* <p>{guarantorDetails_2?.email}</p> */}\r\n              <input\r\n                type=\"text\"\r\n                name=\"email\"\r\n                value={guarantorDetails_2[0]?.email}\r\n                onChange={(e) => handleChange_2(e)}\r\n              />\r\n            </div>\r\n            <hr />\r\n            <div className=\"dashboard-content-form-container\">\r\n              <h5>Phone Number</h5>\r\n              {/* <p>{guarantorDetails_2?.phone_number}</p> */}\r\n              <input\r\n                type=\"text\"\r\n                name=\"phone_number\"\r\n                value={guarantorDetails_2[0]?.phone_number}\r\n                onChange={(e) => handleChange_2(e)}\r\n              />\r\n            </div>\r\n            <hr />\r\n            <div className=\"dashboard-content-form-container\">\r\n              <h5>Gender</h5>\r\n              {/* <p>{guarantorDetails_2?.gender}</p> */}\r\n              <input\r\n                type=\"text\"\r\n                name=\"gender\"\r\n                value={guarantorDetails_2[0]?.gender}\r\n                onChange={(e) => handleChange_2(e)}\r\n              />\r\n            </div>\r\n            <hr />\r\n            <div className=\"dashboard-content-form-container\">\r\n              <h5>Office Address</h5>\r\n              {/* <p>{guarantorDetails_2?.office_address}</p> */}\r\n              <input\r\n                type=\"text\"\r\n                name=\"office_address\"\r\n                value={guarantorDetails_2[0]?.office_address}\r\n                onChange={(e) => handleChange_2(e)}\r\n              />\r\n            </div>\r\n            <hr />\r\n            <div className=\"dashboard-content-form-container\">\r\n              <h5>Home Address</h5>\r\n              {/* <p>{guarantorDetails_2?.home_address}</p> */}\r\n              <input\r\n                type=\"text\"\r\n                name=\"home_address\"\r\n                value={guarantorDetails_2[0]?.home_address}\r\n                onChange={(e) => handleChange_2(e)}\r\n              />\r\n            </div>\r\n            <hr />\r\n            <div className=\"dashboard-content-form-container\">\r\n              <h5>Profession</h5>\r\n              {/* <p>{guarantorDetails_2?.profession}</p> */}\r\n  