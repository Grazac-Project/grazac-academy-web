 out on the right path by leveraging on the experience of those who have gone ahead.</p>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                        <div className=\"boxes22\">\r\n                            <div className=\"\">\r\n                                <div className=\"boxes\">\r\n                                    <div className=\"svg-box2\">\r\n                                        <svg width=\"30\" height=\"30\" viewBox=\"0 0 30 30\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\r\n                                            <path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M18.2695 24.44C19.5808 22.5675 20.9445 19.8138 21.217 16.25H24.9108C24.432 20.065 21.7995 23.2125 18.2695 24.44ZM5.08612 16.2498H8.82612C9.08362 19.8273 10.4299 22.5698 11.7586 24.4511C8.21237 23.2298 5.56737 20.0761 5.08612 16.2498ZM11.7972 5.53516C10.4822 7.40766 9.10594 10.1702 8.83094 13.7489H5.08594C5.56844 9.90891 8.23219 6.74516 11.7972 5.53516ZM11.3477 13.7498C11.7302 9.65984 13.8227 6.81234 15.0314 5.49609C16.2814 6.83484 18.3414 9.65609 18.6977 13.7498H11.3477ZM11.3516 16.25H18.7041C18.3216 20.3462 16.2241 23.1937 15.0166 24.51C13.7078 23.1225 11.7003 20.34 11.3516 16.25ZM24.9125 13.7519H21.2225C20.9662 10.1906 19.635 7.45688 18.3125 5.57812C21.8225 6.81563 24.4362 9.95188 24.9125 13.7519ZM27.5 15C27.5 8.12 21.9112 2.5225 15.035 2.5025C15.03 2.5025 15.025 2.50125 15.0188 2.50125C15.0138 2.50125 15.0063 2.5 15 2.5C8.1075 2.5 2.5 8.10875 2.5 15C2.5 21.8925 8.1075 27.5 15 27.5C15.0075 27.5 15.0138 27.4988 15.0188 27.4988C15.0213 27.4988 15.0225 27.5 15.025 27.5C15.0288 27.5 15.0325 27.4975 15.035 27.4975C21.9112 27.4788 27.5 21.88 27.5 15Z\" fill=\"#773DD3\"/>\r\n                                            <mask id=\"mask0\" mask-type=\"alpha\" maskUnits=\"userSpaceOnUse\" x=\"2\" y=\"2\" width=\"26\" height=\"26\">\r\n                                            <path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M18.2695 24.44C19.5808 22.5675 20.9445 19.8138 21.217 16.25H24.9108C24.432 20.065 21.7995 23.2125 18.2695 24.44ZM5.08612 16.2498H8.82612C9.08362 19.8273 10.4299 22.5698 11.7586 24.4511C8.21237 23.2298 5.56737 20.0761 5.08612 16.2498ZM11.7972 5.53516C10.4822 7.40766 9.10594 10.1702 8.83094 13.7489H5.08594C5.56844 9.90891 8.23219 6.74516 11.7972 5.53516ZM11.3477 13.7498C11.7302 9.65984 13.8227 6.81234 15.0314 5.49609C16.2814 6.83484 18.3414 9.65609 18.6977 13.7498H11.3477ZM11.3516 16.25H18.7041C18.3216 20.3462 16.2241 23.1937 15.0166 24.51C13.7078 23.1225 11.7003 20.34 11.3516 16.25ZM24.9125 13.7519H21.2225C20.9662 10.1906 19.635 7.45688 18.3125 5.57812C21.8225 6.81563 24.4362 9.95188 24.9125 13.7519ZM27.5 15C27.5 8.12 21.9112 2.5225 15.035 2.5025C15.03 2.5025 15.025 2.50125 15.0188 2.50125C15.0138 2.50125 15.0063 2.5 15 2.5C8.1075 2.5 2.5 8.10875 2.5 15C2.5 21.8925 8.1075 27.5 15 27.5C15.0075 27.5 15.0138 27.4988 15.0188 27.4988C15.0213 27.4988 15.0225 27.5 15.025 27.5C15.0288 27.5 15.0325 27.4975 15.035 27.4975C21.9112 27.4788 27.5 21.88 27.5 15Z\" fill=\"white\"/>\r\n                                            </mask>\r\n                                        </svg>\r\n                                    </div>\r\n                                    <h3>Job Placement</h3>\r\n                                    <p>Enter the recruitment process with tech companies and take a stride into your dream career. </p>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"background1\" id=\"courses\">\r\n                    <div className=\"container\">\r\n                        <div className=\"gga\">\r\n                            <div className=\"course_mode-intro course_mode-intro\">\r\n                                <h2>Available Courses</h2>\r\n                            </div>\r\n                            <div className=\"gga_container\">\r\n                                {courses.length ?\r\n                                    courses.map((item,index) => (\r\n                                    <div className=\"boxes33\" key={index}>\r\n                                        <div className=\"gua_cardview\">\r\n                                            <div className=\"gua_cardview-box\">\r\n                                                <img src={item.thumb} alt=\"course-desc\" />\r\n                                            </div>\r\n                                            <div className=\"gua_cardview-text\">\r\n                                                <h4>{item.name}</h4>\r\n                                                <p>{item.description}</p>\r\n                                                <Link to={\"/course-detail-graduate?course=\"+item.slug}><a>Learn More</a></Link>\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                    )) :\r\n                                    <div>\r\n                                        <img src={loader} alt=\"loader\" className=\"loader\" />\r\n                                    </div>\r\n                                }\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <Qualities />\r\n                <NeedAdvice />\r\n            </div>\r\n            <Footer/>\r\n        </div>\r\n    );\r\n}\r\n\r\nexport default GraduateAccelerator;","C:\\Users\\USER\\Desktop\\Web Development\\Bitbucket\\grazac-academy\\src\\auth\\Signup.js",["142","143","144","145","146","147","148","149","150","151","152","153","154"],"import { useState } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { cn } from \"../utils\";\r\nimport PrimaryBtn from \"../components/PrimaryBtn\";\r\nimport Grazac from \"../images/grazac.png\";\r\n\r\nconst validEmailRegex = RegExp(\r\n  /^(([^<>()\\[\\]\\.,;:\\s@\\\"]+(\\.[^<>()\\[\\]\\.,;:\\s@\\\"]+)*)|(\\\".+\\\"))@(([^<>()[\\]\\.,;:\\s@\\\"]+\\.)+[^<>()[\\]\\.,;:\\s@\\\"]{2,})$/i\r\n);\r\n\r\nconst Signup = () => {\r\n  const [email, setEmail] = useState(\"\");\r\n  const [password, setPassword] = useState(\"\");\r\n  const [emailErr, setEmailErr] =  useState(\"\");\r\n  const [phone, setPhone] = useState(\"\");\r\n  const [gender, setGender] = useState(\"\");\r\n\r\n  \r\n  const handleEmailChange = e => {\r\n    e.preventDefault();\r\n    setEmail(e.target.value)\r\n\r\n    if (!email) setEmailErr(\"\");\r\n    let err = validEmailRegex.test(e.target.value) ? \"\" : \"please enter a valid email address\";\r\n    setEmailErr(err);\r\n  }\r\n\r\n  const handlePasswordChange = e => {\r\n    e.preventDefault();\r\n    setPassword(e.target.value)\r\n  }\r\n\r\n  return(\r\n    <div className=\"auth\">\r\n      <div className=\"auth__body\">\r\n        <div className=\"auth__hero\">\r\n          <img src={Grazac} alt=\"grazac\" />\r\n        </div>\r\n\r\n        <div className=\"auth__form\">\r\n          <div className=\"auth__form--container\">\r\n            <h1>Create Account</h1>\r\n\r\n            <form className=\"form\">\r\n              <div className=\"form__group\">\r\n                <label for=\"email\">Email address</label>\r\n                <input type=\"email\" id=\"email\" value={email} onChange={handleEmailChange} className={cn(\"form__input\", {\"form__input--err\": emailErr})}/>\r\n              </div>\r\n\r\n              <div className=\"form__group--half\">\r\n                <div className=\"form__group\">\r\n                  <label for=\"phone\">Phone </label>\r\n                  <input type=\"email\" id=\"email\" value={phone} onChange={e => setPhone(e.target.value)} className={cn(\"form__input\")}/>\r\n                </div>\r\n\r\n                <div className=\"form__group\">\r\n                  <label for=\"gender\">Gender</label>\r\n                    <select id=\"cars\" className=\"form__input\" onChange={e => setGender(e.target.value)}>\r\n                      <option value=\"\">Select gender</option>\r\n                      <option value=\"male\">Male</option>\r\n                      <option value=\"female\">Female</option>\r\n                      <option value=\"\">I'm not sure</option>\r\n                    </select>\r\n                </div>\r\n              </div>\r\n\r\n              <div className=\"form__group\">\r\n                <label for=\"pass\">Password</label>\r\n                <input type=\"password\" id=\"pass\" value={password} onChange={handlePasswordChange} className=\"form__input\"/>\r\n              </div>\r\n\r\n              <Link className=\"form__link\">Forgot password?</Link>\r\n\r\n              <button type=\"submit\" className=\"form__btn\">\r\n                <PrimaryBtn>Create Account</PrimaryBtn>\r\n              </button>\r\n            </form>\r\n\r\n            <div className=\"auth__line\">\r\n              <div>&nbsp;</div>\r\n              <span>or</span>\r\n              <div>&nbsp;</div>\r\n            </div>\r\n          </div>\r\n\r\n          <div className=\"auth__btns\">\r\n            <Link className=\"auth__btn\">\r\n              <svg width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\r\n                <path d=\"M4.43236 12.0862L3.7362 14.6851L1.19174 14.7389C0.431322 13.3285 0 11.7148 0 9.99997C0 8.34175 0.403276 6.77802 1.11811 5.40112H1.11866L3.38394 5.81643L4.37627 8.06812C4.16858 8.67362 4.05537 9.32361 4.05537 9.99997C4.05545 10.734 4.18842 11.4373 4.43236 12.0862Z\" fill=\"#FBBB00\"/>\r\n                <path d=\"M19.824 8.1322C19.9389 8.73712 19.9988 9.36183 19.9988 10.0003C19.9988 10.7162 19.9235 11.4146 19.7801 12.0882C19.2933 14.3805 18.0213 16.3821 16.2593 17.7986L16.2587 17.798L13.4055 17.6524L13.0017 15.1316C14.1709 14.4459 15.0846 13.3728 15.5659 12.0882H10.2188V8.1322H15.644H19.824Z\" fill=\"#518EF8\"/>\r\n                <path d=\"M16.2593 17.798L16.2599 17.7985C14.5462 19.176 12.3693 20.0002 9.99953 20.0002C6.19134 20.0002 2.88041 17.8716 1.19141 14.7392L4.43203 12.0865C5.27651 14.3403 7.45066 15.9447 9.99953 15.9447C11.0951 15.9447 12.1215 15.6486 13.0022 15.1315L16.2593 17.798Z\" fill=\"#28B446\"/>\r\n                <path d=\"M16.3818 2.30216L13.1423 4.95431C12.2308 4.38455 11.1533 4.05541 9.99894 4.05541C7.39237 4.05541 5.17756 5.7334 4.37538 8.06802L1.11773 5.40102H1.11719C2.78146 2.19228 6.13415 0 9.99894 0C12.4253 0 14.65 0.864285 16.3818 2.30216Z\" fill=\"#F14336\"/>\r\n              </svg>\r\n\r\n              Google\r\n            </Link>\r\n\r\n            <Link className=\"auth__btn\">\r\n              <svg width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\r\n                <path d=\"M18.1908 0H1.80916C0.81 0 0 0.81 0 1.80916V18.1908C0 19.19 0.81 20 1.80916 20H18.1908C19.19 20 20 19.19 20 18.1908V1.80916C20 0.81 19.19 0 18.1908 0ZM6.18885 17.2693C6.18885 17.5601 5.95314 17.7958 5.66236 17.7958H3.4212C3.13042 17.7958 2.89471 17.5601 2.89471 17.2693V7.8745C2.89471 7.58372 3.13042 7.34801 3.4212 7.34801H5.66236C5.95314 7.34801 6.18885 7.58372 6.18885 7.8745V17.2693ZM4.54178 6.46241C3.36592 6.46241 2.41267 5.50916 2.41267 4.3333C2.41267 3.15743 3.36592 2.20419 4.54178 2.20419C5.71764 2.20419 6.67089 3.15743 6.67089 4.3333C6.67089 5.50916 5.7177 6.46241 4.54178 6.46241ZM17.901 17.3117C17.901 17.5791 17.6843 17.7958 17.417 17.7958H15.012C14.7447 17.7958 14.528 17.5791 14.528 17.3117V12.905C14.528 12.2476 14.7208 10.0243 12.81 10.0243C11.3279 10.0243 11.0272 11.5461 10.9669 12.2291V17.3117C10.9669 17.5791 10.7502 17.7958 10.4828 17.7958H8.15681C7.88948 17.7958 7.67272 17.5791 7.67272 17.3117V7.83209C7.67272 7.56476 7.88948 7.34801 8.15681 7.34801H10.4828C10.7501 7.34801 10.9669 7.56476 10.9669 7.83209V8.65173C11.5164 7.82696 12.3332 7.19037 14.0722 7.19037C17.9231 7.19037 17.901 10.7881 17.901 12.7648V17.3117Z\" fill=\"#0077B7\"/>\r\n              </svg>\r\n\r\n              Linkedln\r\n            </Link>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default Signup;","C:\\Users\\USER\\Desktop\\Web Development\\Bitbucket\\grazac-academy\\src\\pages\\AboutUs.js",["155","156","157","158"],"import { useEffect } from 'react';\r\nimport { Link } from \"react-router-dom\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport Mode from \"../components/Mode\";\r\nimport Sponsor1 from \"../images/svg/sponsor1.svg\";\r\nimport Sponsor2 from \"../images/svg/sponsor2.svg\";\r\nimport Sponsor3 from \"../images/svg/sponsor3.svg\";\r\nimport Dots from \"../images/svg/dots.svg\";\r\n\r\nconst cardsInfo = [\r\n  {\r\n    color: \"39,234,198\",\r\n    title: \"Creativity\",\r\n    body: \"We constantly develop ideas that drives innovation. Our company is a community that allow us share common interests and ideas.\"\r\n  },\r\n  {\r\n    color: \"26,222,235\",\r\n    title: \"Quality\",\r\n    body: \"We strive to provide value that fulfils and exceeds expectation. We have an unwavering guide that leads the way to fulfilling your goal.\"\r\n  },\r\n  {\r\n    color: \"108,21,250\",\r\n    title: \"Passion\",\r\n    body: \"Our enthusiasm to deliver the best makes us unique. We uphold the highest standards in deliverability.\"\r\n  },\r\n  {\r\n    color: \"255,113,155\",\r\n    title: \"Commitment\",\r\n    body: \"We are focused on giving best solutions. Our concern is solving your problem rather than why or how the problem was created.\"\r\n  },\r\n  {\r\n    color: \"254,125,108\",\r\n    title: \"Collaboration\",\r\n    body: \"Our success depends upon the collective intelligence of our team members and the shared vision of our partners.\"\r\n  },\r\n  {\r\n    color: \"255,180,67\",\r\n    title: \"Teamwork\",\r\n    body: \"We do better, together. Our environment fosters progress, effectiveness and speed.\"\r\n  },\r\n]\r\n\r\nconst AboutUs = () => {\r\n\r\n  useEffect(() => {\r\n    document.title = 'About - Grazac Academy';\r\n    window.scrollTo(0,0);\r\n  }, []);\r\n\r\n  return(\r\n    <div className=\"about\">\r\n      <div className=\"about__nav\">\r\n        <Navbar />\r\n      </div>\r\n\r\n      <div className=\"about__top\">\r\n        <div className=\"about__top--container\">\r\n          <div className=\"about__top--up\">\r\n            <div>\r\n              <img src={Dots} alt=\"dots\" />\r\n            </div>\r\n            <div></div>\r\n            <div className=\"about__top--text\">\r\n              <h1>About Us</h1>\r\n              <p>At Grazac Academy, we provide you with the right platform to upskill yourself for the future.</p>\r\n            </div>\r\n          </div>\r\n          <div className=\"about__top--down\">\r\n            <div></div>\r\n            <div></div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <div className=\"about__middle\">\r\n        <div className=\"about__middle--container\">\r\n          <div className=\"about__middle--head\">\r\n            <h2>Our Core Values</h2>\r\n            <p>You determine the starting points, we provide the best possible interception to achieve the goals.</p>\r\n          </div>\r\n\r\n          <div className=\"about__middle--cards\">\r\n            {\r\n              cardsInfo.map(item => (\r\n                <div className=\"about__middle--card\">\r\n                  <div style={{\"--bg-color\": item.color}}></div>\r\n                  <h3>{item.title}</h3>\r\n                  <p>{item.body}</p>\r\n                </div>\r\n              ))\r\n            }\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <Mode />\r\n      <Footer />\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default AboutUs;","C:\\Users\\USER\\Desktop\\Web Development\\Bitbucket\\grazac-academy\\src\\auth\\Login.js",["159","160","161","162","163","164","165","166","167","168","169","170"],"import { useState } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { cn } from \"../utils\";\r\nimport PrimaryBtn from \"../components/PrimaryBtn\";\r\nimport Grazac from \"../images/grazac.png\";\r\n\r\nconst validEmailRegex = RegExp(\r\n  /^(([^<>()\\[\\]\\.,;:\\s@\\\"]+(\\.[^<>()\\[\\]\\.,;:\\s@\\\"]+)*)|(\\\".+\\\"))@(([^<>()[\\]\\.,;:\\s@\\\"]+\\.)+[^<>()[\\]\\.,;:\\s@\\\"]{2,})$/i\r\n);\r\n\r\nconst Login = () => {\r\n  const [email, setEmail] = useState(\"\");\r\n  const [password, setPassword] = useState(\"\");\r\n  const [emailErr, setEmailErr] =  useState(\"\");\r\n\r\n  \r\n  const handleEmailChange = e => {\r\n    e.preventDefault();\r\n    setEmail(e.target.value)\r\n\r\n    if (!email) setEmailErr(\"\");\r\n    let err = validEmailRegex.test(e.target.value) ? \"\" : \"please enter a valid email address\";\r\n    setEmailErr(err);\r\n  }\r\n\r\n  const handlePasswordChange = e => {\r\n    e.preventDefault();\r\n    setPassword(e.target.value)\r\n  }\r\n\r\n  return(\r\n    <div className=\"auth\">\r\n      <div className=\"auth__body\">\r\n        <div className=\"auth__hero\">\r\n          <img src={Grazac} alt=\"grazac\" />\r\n        </div>\r\n\r\n        <div className=\"auth__form\">\r\n          <div className=\"auth__form--container\">\r\n            <h1>Login</h1>\r\n\r\n            <form className=\"form\">\r\n              <div className=\"form__group\">\r\n                <label for=\"email\">Email address</label>\r\n                <input type=\"email\" id=\"email\" value={email} onChange={handleEmailChange} className={cn(\"form__input\", {\"form__input--err\": emailErr})}/>\r\n              </div>\r\n\r\n              <div className=\"form__group\">\r\n                <label for=\"pass\">Password</label>\r\n                <input type=\"password\" id=\"pass\" value={password} onChange={handlePasswordChange} className=\"form__input\"/>\r\n              </div>\r\n\r\n              <Link className=\"form__link\">Forgot password?</Link>\r\n\r\n              <button type=\"submit\" className=\"form__btn\">\r\n                <PrimaryBtn>Login</PrimaryBtn>\r\n              </button>\r\n            </form>\r\n\r\n            <div className=\"auth__line\">\r\n              <div>&nbsp;</div>\r\n              <span>or</span>\r\n              <div>&nbsp;</div>\r\n            </div>\r\n          </div>\r\n\r\n          <div className=\"auth__btns\">\r\n            <Link className=\"auth__btn\">\r\n              <svg width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\r\n                <path d=\"M4.43236 12.0862L3.7362 14.6851L1.19174 14.7389C0.431322 13.3285 0 11.7148 0 9.99997C0 8.34175 0.403276 6.77802 1.11811 5.40112H1.11866L3.38394 5.81643L4.37627 8.06812C4.16858 8.67362 4.05537 9.32361 4.05537 9.99997C4.05545 10.734 4.18842 11.4373 4.43236 12.0862Z\" fill=\"#FBBB00\"/>\r\n                <path d=\"M19.824 8.1322C19.9389 8.73712 19.9988 9.36183 19.9988 10.0003C19.9988 10.7162 19.9235 11.4146 19.7801 12.0882C19.2933 14.3805 18.0213 16.3821 16.2593 17.7986L16.2587 17.798L13.4055 17.6524L13.0017 15.1316C14.1709 14.4459 15.0846 13.3728 15.5659 12.0882H10.2188V8.1322H15.644H19.824Z\" fill=\"#518EF8\"/>\r\n                <path d=\"M16.2593 17.798L16.2599 17.7985C14.5462 19.176 12.3693 20.0002 9.99953 20.0002C6.19134 20.0002 2.88041 17.8716 1.19141 14.7392L4.43203 12.0865C5.27651 14.3403 7.45066 15.9447 9.99953 15.9447C11.0951 15.9447 12.1215 15.6486 13.0022 15.1315L16.2593 17.798Z\" fill=\"#28B446\"/>\r\n                <path d=\"M16.3818 2.30216L13.1423 4.95431C12.2308 4.38455 11.1533 4.05541 9.99894 4.05541C7.39237 4.05541 5.17756 5.7334 4.37538 8.06802L1.11773 5.40102H1.11719C2.78146 2.19228 6.13415 0 9.99894 0C12.4253 0 14.65 0.864285 16.3818 2.30216Z\" fill=\"#F14336\"/>\r\n              </svg>\r\n\r\n              Google\r\n            </Link>\r\n\r\n            <Link className=\"auth__btn\">\r\n              <svg width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\r\n                <path d=\"M18.1908 0H1.80916C0.81 0 0 0.81 0 1.80916V18.1908C0 19.19 0.81 20 1.80916 20H18.1908C19.19 20 20 19.19 20 18.1908V1.80916C20 0.81 19.19 0 18.1908 0ZM6.18885 17.2693C6.18885 17.5601 5.95314 17.7958 5.66236 17.7958H3.4212C3.13042 17.7958 2.89471 17.5601 2.89471 17.2693V7.8745C2.89471 7.58372 3.13042 7.34801 3.4212 7.34801H5.66236C5.95314 7.34801 6.18885 7.58372 6.18885 7.8745V17.2693ZM4.54178 6.46241C3.36592 6.46241 2.41267 5.50916 2.41267 4.3333C2.41267 3.15743 3.36592 2.20419 4.54178 2.20419C5.71764 2.20419 6.67089 3.15743 6.67089 4.3333C6.67089 5.50916 5.7177 6.46241 4.54178 6.46241ZM17.901 17.3117C17.901 17.5791 17.6843 17.7958 17.417 17.7958H15.012C14.7447 17.7958 14.528 17.5791 14.528 17.3117V12.905C14.528 12.2476 14.7208 10.0243 12.81 10.0243C11.3279 10.0243 11.0272 11.5461 10.9669 12.2291V17.3117C10.9669 17.5791 10.7502 17.7958 10.4828 17.7958H8.15681C7.88948 17.7958 7.67272 17.5791 7.67272 17.3117V7.83209C7.67272 7.56476 7.88948 7.34801 8.15681 7.34801H10.4828C10.7501 7.34801 10.9669 7.56476 10.9669 7.83209V8.65173C11.5164 7.82696 12.3332 7.19037 14.0722 7.19037C17.9231 7.19037 17.901 10.7881 17.901 12.7648V17.3117Z\" fill=\"#0077B7\"/>\r\n              </svg>\r\n\r\n              Linkedln\r\n            </Link>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default Login;","C:\\Users\\USER\\Desktop\\Web Development\\Bitbucket\\grazac-academy\\src\\content\\courses.js",[],["171","172"],"C:\\Users\\USER\\Desktop\\Web Development\\Bitbucket\\grazac-academy\\src\\utils.js",[],"C:\\Users\\USER\\Desktop\\Web Development\\Bitbucket\\grazac-academy\\src\\components\\NeedAdvice.js",["173"],"C:\\Users\\USER\\Desktop\\Web Development\\Bitbucket\\grazac-aca