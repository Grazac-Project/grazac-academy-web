alekan Sogunle</a>\r\n              <h5>CAREERFOUNDRY</h5>\r\n              <small>Software Engineer</small>\r\n              <Linkedn />\r\n            </div>\r\n\r\n            <div className=\"landing__middle--images\">\r\n              <img src={Man}/>\r\n              <a>Olalekan Sogunle</a>\r\n              <h5>CAREERFOUNDRY</h5>\r\n              <small>Software Engineer</small>\r\n              <Linkedn />\r\n            </div>\r\n\r\n            <div className=\"landing__middle--images\">\r\n              <img src={Man}/>\r\n              <a>Olalekan Sogunle</a>\r\n              <h5>CAREERFOUNDRY</h5>\r\n              <small>Software Engineer</small>\r\n              <Linkedn />\r\n            </div>\r\n\r\n            <div className=\"landing__middle--images\">\r\n              <img src={Man}/>\r\n              <a>Olalekan Sogunle</a>\r\n              <h5>CAREERFOUNDRY</h5>\r\n              <small>Software Engineer</small>\r\n              <Linkedn />\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div> */}\r\n\r\n      <div className=\"landing__discount\">\r\n        <div className=\"landing__discount--container\">\r\n          <div className=\"landing__discount--img\">\r\n            <img src={lady}/>\r\n          </div>\r\n          <div className=\"landing__discount--text\">\r\n            <h3>Get equipped for the career you desire.</h3>\r\n            <p>You will gain insights into today’s digital skills and tools necessary for the future of work.</p>\r\n            <div className=\"landing__btn--2\">\r\n              {/* <PrimaryBtn link=\"/\">Enroll Now</PrimaryBtn> */}\r\n              <a>\r\n                <div className=\"nav__btn nav__btn-flex \">\r\n                  <a href=\"/#tracks\"><div className=\"nav__btn--text\" style={{marginRight:'20px'}}>Enroll Now</div></a>\r\n                  <a href=\"tel:+2348068365951\" ><div className=\"nav__btn--text1\">Talk to us</div></a>\r\n                </div>\r\n              </a>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  )\r\n}\r\n\r\nexport default Mode;","C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\components\\Navbar.js",["215","216"],"import { useEffect, useState, useRef } from \"react\";\r\nimport { cn } from \"../utils\";\r\nimport NavItem from \"./NavItem\";\r\nimport logo from \"../images/svg/grazac-logo.svg\";\r\nimport { Link } from \"react-router-dom\";\r\nimport InfoModal from \"../components/InfoModal\";\r\n\r\nconst Navbar = ({ top }) => {\r\n  const [fixed, setFixed] = useState(false);\r\n  const [active, setActive] = useState(false);\r\n  const [hover, setHover] = useState(false);\r\n  const nav = useRef(null);\r\n\r\n  useEffect(() => {\r\n\r\n    if (nav.current && window.pageYOffset > nav.current.offsetTop) {\r\n      setFixed(true);\r\n    } else {\r\n      setFixed(false);\r\n    }\r\n    window.addEventListener(\"scroll\", () => {\r\n      if (nav.current && window.pageYOffset > nav.current.offsetTop)\r\n        setFixed(true);\r\n      else setFixed(false);\r\n    });\r\n  }, []);\r\n\r\n  const handleClick = (e) => {\r\n    e.preventDefault();\r\n\r\n    if (active) setActive(false);\r\n    else setActive(true);\r\n  };\r\n\r\n  return (\r\n    <nav className={cn(\"nav\", { \"nav--fixed\": fixed })} ref={nav}>\r\n      <div className=\"nav__container\">\r\n        <div className=\"nav__logo\">\r\n          <Link to=\"/\">\r\n            <img src={logo} alt=\"logo\" />\r\n          </Link>\r\n        </div>\r\n\r\n        <div className={cn(\"nav__menu\", { \"nav__menu--active\": active })}>\r\n          <button className=\"nav-tgl\" onClick={handleClick}>\r\n            <span>&nbsp;</span>\r\n          </button>\r\n\r\n          <ul className=\"nav__list--mb\">\r\n            <li className=\"nav__item\">\r\n              <NavItem exact link=\"/\">\r\n                <span>01</span>Home\r\n              </NavItem>\r\n            </li>\r\n            <li className=\"nav__item\">\r\n              <NavItem link=\"/about-us\">\r\n                <span>02</span>About\r\n              </NavItem>\r\n            </li>\r\n            <li className=\"nav__item\">\r\n              <NavItem link=\"/undergraduate-accelerator-plan\">\r\n                <span>03</span>Undergraduate\r\n              </NavItem>\r\n            </li>\r\n            <li className=\"nav__item\">\r\n              <NavItem link=\"/graduate-accelerator-plan\">\r\n                <span>04</span>Graduate\r\n              </NavItem>\r\n            </li>\r\n            <li className=\"nav__item\">\r\n              <a href=\"/#tracks\">\r\n                <button onClick={() => setActive(false)}>Enroll Now</button>\r\n              </a>\r\n            </li>\r\n            <li className=\"nav__item\" style={{ marginTop: \"30px\" }}>\r\n              <a href=\"tel:+2348068365951\">\r\n                <button onClick={() => setActive(false)}>Talk to us</button>\r\n              </a>\r\n            </li>\r\n          </ul>\r\n        </div>\r\n\r\n        <ul className=\"nav__list\" style={{ marginBottom: 0 }}>\r\n          <li className=\"nav__item\">\r\n            <NavItem exact link=\"/\">\r\n              Home\r\n            </NavItem>\r\n          </li>\r\n          <li className=\"nav__item\">\r\n            <NavItem link=\"/about-us\">About</NavItem>\r\n          </li>\r\n          <li\r\n            className=\"nav__item\"\r\n            style={{ position: \"relative\", cursor: \"pointer\" }}\r\n            onMouseEnter={() => setHover(true)}\r\n            onMouseLeave={() => setHover(false)}\r\n          >\r\n            <a className=\"nav__link\">Academy</a>\r\n            <svg\r\n              className=\"mask\"\r\n              width=\"11\"\r\n              height=\"6\"\r\n              viewBox=\"0 0 11 6\"\r\n              fill=\"none\"\r\n              xmlns=\"http://www.w3.org/2000/svg\"\r\n            >\r\n              <path