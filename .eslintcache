791 14.528 17.3117V12.905C14.528 12.2476 14.7208 10.0243 12.81 10.0243C11.3279 10.0243 11.0272 11.5461 10.9669 12.2291V17.3117C10.9669 17.5791 10.7502 17.7958 10.4828 17.7958H8.15681C7.88948 17.7958 7.67272 17.5791 7.67272 17.3117V7.83209C7.67272 7.56476 7.88948 7.34801 8.15681 7.34801H10.4828C10.7501 7.34801 10.9669 7.56476 10.9669 7.83209V8.65173C11.5164 7.82696 12.3332 7.19037 14.0722 7.19037C17.9231 7.19037 17.901 10.7881 17.901 12.7648V17.3117Z\" fill=\"#0077B7\"/>\r\n              </svg>\r\n\r\n              Linkedln\r\n            </Link>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default Signup;","C:\\Users\\USER\\Desktop\\Web Development\\Bitbucket\\grazac-academy\\src\\pages\\AboutUs.js",["118","119","120","121"],"import { useEffect } from 'react';\r\nimport { Link } from \"react-router-dom\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport Mode from \"../components/Mode\";\r\nimport Sponsor1 from \"../images/svg/sponsor1.svg\";\r\nimport Sponsor2 from \"../images/svg/sponsor2.svg\";\r\nimport Sponsor3 from \"../images/svg/sponsor3.svg\";\r\nimport Dots from \"../images/svg/dots.svg\";\r\n\r\nconst cardsInfo = [\r\n  {\r\n    color: \"39,234,198\",\r\n    title: \"Creativity\",\r\n    body: \"We constantly develop ideas that drives innovation. Our company is a community that allow us share common interests and ideas.\"\r\n  },\r\n  {\r\n    color: \"26,222,235\",\r\n    title: \"Quality\",\r\n    body: \"We strive to provide value that fulfils and exceeds expectation. We have an unwavering guide that leads the way to fulfilling your goal.\"\r\n  },\r\n  {\r\n    color: \"108,21,250\",\r\n    title: \"Passion\",\r\n    body: \"Our enthusiasm to deliver the best makes us unique. We uphold the highest standards in deliverability.\"\r\n  },\r\n  {\r\n    color: \"255,113,155\",\r\n    title: \"Commitment\",\r\n    body: \"We are focused on giving best solutions. Our concern is solving your problem rather than why or how the problem was created.\"\r\n  },\r\n  {\r\n    color: \"254,125,108\",\r\n    title: \"Collaboration\",\r\n    body: \"Our success depends upon the collective intelligence of our team members and the shared vision of our partners.\"\r\n  },\r\n  {\r\n    color: \"255,180,67\",\r\n    title: \"Teamwork\",\r\n    body: \"We do better, together. Our environment fosters progress, effectiveness and speed.\"\r\n  },\r\n]\r\n\r\nconst AboutUs = () => {\r\n\r\n  useEffect(() => {\r\n    document.title = 'About - Grazac Academy';\r\n    window.scrollTo(0,0);\r\n  }, []);\r\n\r\n  return(\r\n    <div className=\"about\">\r\n      <div className=\"about__nav\">\r\n        <Navbar />\r\n      </div>\r\n\r\n      <div className=\"about__top\">\r\n        <div className=\"about__top--container\">\r\n          <div className=\"about__top--up\">\r\n            <div>\r\n              <img src={Dots} alt=\"dots\" />\r\n            </div>\r\n            <div></div>\r\n            <div className=\"about__top--text\">\r\n              <h1>About Us</h1>\r\n              <p>At Grazac Academy, we provide you with the right platform to upskill yourself for the future.</p>\r\n            </div>\r\n          </div>\r\n          <div className=\"about__top--down\">\r\n            <div></div>\r\n            <div></div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <div className=\"about__middle\">\r\n        <div className=\"about__middle--container\">\r\n          <div className=\"about__middle--head\">\r\n            <h2>Our Core Values</h2>\r\n            <p>You determine the starting points, we provide the best possible interception to achieve the goals.</p>\r\n          </div>\r\n\r\n          <div className=\"about__middle--cards\">\r\n            {\r\n              cardsInfo.map(item => (\r\n                <div className=\"about__middle--card\">\r\n                  <div style={{\"--bg-color\": item.color}}></div>\r\n                  <h3>{item.title}</h3>\r\n                  <p>{item.body}</p>\r\n                </div>\r\n              ))\r\n            }\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <Mode />\r\n      <Footer />\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default AboutUs;","C:\\Users\\USER\\Desktop\\Web Development\\Bitbucket\\grazac-academy\\src\\auth\\Login.js",["122","123","124","125","126","127","128","129","130","131","132","133"],"import { useState } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { cn } from \"../utils\";\r\nimport PrimaryBtn from \"../components/PrimaryBtn\";\r\nimport Grazac from \"../images/grazac.png\";\r\n\r\nconst validEmailRegex = RegExp(\r\n  /^(([^<>()\\[\\]\\.,;:\\s@\\\"]+(\\.[^<>()\\[\\]\\.,;:\\s@\\\"]+)*)|(\\\".+\\\"))@(([^<>()[\\]\\.,;:\\s@\\\"]+\\.)+[^<>()[\\]\\.,;:\\s@\\\"]{2,})$/i\r\n);\r\n\r\nconst Login = () => {\r\n  const [email, setEmail] = useState(\"\");\r\n  const [password, setPassword] = useState(\"\");\r\n  const [emailErr, setEmailErr] =  useState(\"\");\r\n\r\n  \r\n  const handleEmailChange = e => {\r\n    e.preventDefault();\r\n    setEmail(e.target.value)\r\n\r\n    if (!email) setEmailErr(\"\");\r\n    let err = validEmailRegex.test(e.target.value) ? \"\" : \"please enter a valid email address\";\r\n    setEmailErr(err);\r\n  }\r\n\r\n  const handlePasswordChange = e => {\r\n    e.preventDefault();\r\n    setPassword(e.target.value)\r\n  }\r\n\r\n  return(\r\n    <div className=\"auth\">\r\n      <div className=\"auth__body\">\r\n        <div className=\"auth__hero\">\r\n          <img src={Grazac} alt=\"grazac\" />\r\n        </div>\r\n\r\n        <div className=\"auth__form\">\r\n          <div className=\"auth__form--container\">\r\n            <h1>Login</h1>\r\n\r\n            <form className=\"form\">\r\n              <div className=\"form__group\">\r\n                <label for=\"email\">Email address</label>\r\n                <input type=\"email\" id=\"email\" value={email} onChange={handleEmailChange} className={cn(\"form__input\", {\"form__input--err\": emailErr})}/>\r\n              </div>\r\n\r\n              <div className=\"form__group\">\r\n                <label for=\"pass\">Password</label>\r\n                <input type=\"password\" id=\"pass\" value={password} onChange={handlePasswordChange} className=\"form__input\"/>\r\n              </div>\r\n\r\n              <Link className=\"form__link\">Forgot password?</Link>\r\n\r\n              <button type=\"submit\" className=\"form__btn\">\r\n                <PrimaryBtn>Login</PrimaryBtn>\r\n              </button>\r\n            </form>\r\n\r\n            <div className=\"auth__line\">\r\n              <div>&nbsp;</div>\r\n              <span>or</span>\r\n              <div>&nbsp;</div>\r\n            </div>\r\n          </div>\r\n\r\n          <div className=\"auth__btns\">\r\n            <Link className=\"auth__btn\">\r\n              <svg width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\r\n                <path d=\"M4.43236 12.0862L3.7362 14.6851L1.19174 14.7389C0.431322 13.3285 0 11.7148 0 9.99997C0 8.34175 0.403276 6.77802 1.11811 5.40112H1.11866L3.38394 5.81643L4.37627 8.06812C4.16858 8.67362 4.05537 9.32361 4.05537 9.99997C4.05545 10.734 4.18842 11.4373 4.43236 12.0862Z\" fill=\"#FBBB00\"/>\r\n                <path d=\"M19.824 8.1322C19.9389 8.73712 19.9988 9.36183 19.9988 10.0003C19.9988 10.7162 19.9235 11.4146 19.7801 12.0882C19.2933 14.3805 18.0213 16.3821 16.2593 17.7986L16.2587 17.798L13.4055 17.6524L13.0017 15.1316C14.1709 14.4459 15.0846 13.3728 15.5659 12.0882H10.2188V8.1322H15.644H19.824Z\" fill=\"#518EF8\"/>\r\n                <path d=\"M16.2593 17.798L16.2599 17.7985C14.5462 19.176 12.3693 20.0002 9.99953 20.0002C6.19134 20.0002 2.88041 17.8716 1.19141 14.7392L4.43203 12.0865C5.27651 14.3403 7.45066 15.9447 9.99953 15.9447C11.0951 15.9447 12.1215 15.6486 13.0022 15.1