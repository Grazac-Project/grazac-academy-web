37"],"import { useEffect } from 'react';\r\nimport { Link } from \"react-router-dom\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport Mode from \"../components/Mode\";\r\nimport Sponsor1 from \"../images/svg/sponsor1.svg\";\r\nimport Sponsor2 from \"../images/svg/sponsor2.svg\";\r\nimport Sponsor3 from \"../images/svg/sponsor3.svg\";\r\nimport Dots from \"../images/svg/dots.svg\";\r\n\r\nconst cardsInfo = [\r\n  {\r\n    color: \"39,234,198\",\r\n    title: \"Creativity\",\r\n    body: \"We constantly develop ideas that drives innovation. Our company is a community that allow us share common interests and ideas.\"\r\n  },\r\n  {\r\n    color: \"26,222,235\",\r\n    title: \"Quality\",\r\n    body: \"We strive to provide value that fulfils and exceeds expectation. We have an unwavering guide that leads the way to fulfilling your goal.\"\r\n  },\r\n  {\r\n    color: \"108,21,250\",\r\n    title: \"Passion\",\r\n    body: \"Our enthusiasm to deliver the best makes us unique. We uphold the highest standards in deliverability.\"\r\n  },\r\n  {\r\n    color: \"255,113,155\",\r\n    title: \"Commitment\",\r\n    body: \"We are focused on giving best solutions. Our concern is solving your problem rather than why or how the problem was created.\"\r\n  },\r\n  {\r\n    color: \"254,125,108\",\r\n    title: \"Collaboration\",\r\n    body: \"Our success depends upon the collective intelligence of our team members and the shared vision of our partners.\"\r\n  },\r\n  {\r\n    color: \"255,180,67\",\r\n    title: \"Teamwork\",\r\n    body: \"We do better, together. Our environment fosters progress, effectiveness and speed.\"\r\n  },\r\n]\r\n\r\nconst AboutUs = () => {\r\n\r\n  useEffect(() => {\r\n    document.title = 'About - Grazac Academy';\r\n    window.scrollTo(0,0);\r\n  }, []);\r\n\r\n  return(\r\n    <div className=\"about\">\r\n      <div className=\"about__nav\">\r\n        <Navbar />\r\n      </div>\r\n\r\n      <div className=\"about__top\">\r\n        <div className=\"about__top--container\">\r\n          <div className=\"about__top--up\">\r\n            <div>\r\n              <img src={Dots} alt=\"dots\" />\r\n            </div>\r\n            <div></div>\r\n            <div className=\"about__top--text\">\r\n              <h1>About Us</h1>\r\n              <p>At Grazac Academy, we provide you with the right platform to upskill yourself for the future.</p>\r\n            </div>\r\n          </div>\r\n          <div className=\"about__top--down\">\r\n            <div></div>\r\n            <div></div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <div className=\"about__middle\">\r\n        <div className=\"about__middle--container\">\r\n          <div className=\"about__middle--head\">\r\n            <h2>Our Core Values</h2>\r\n            <p>You determine the starting points, we provide the best possible interception to achieve the goals.</p>\r\n          </div>\r\n\r\n          <div className=\"about__middle--cards\">\r\n            {\r\n              cardsInfo.map(item => (\r\n                <div className=\"about__middle--card\">\r\n                  <div style={{\"--bg-color\": item.color}}></div>\r\n                  <h3>{item.title}</h3>\r\n                  <p>{item.body}</p>\r\n                </div>\r\n              ))\r\n            }\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <Mode />\r\n      <Footer />\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default AboutUs;","C:\\Users\\USER\\Desktop\\Web Development\\Bitbucket\\grazac-academy\\src\\auth\\Login.js",["138","139","140","141","142","143","144","145","146","147","148","149"],"import { useState } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { cn } from \"../utils\";\r\nimport PrimaryBtn from \"../components/PrimaryBtn\";\r\nimport Grazac from \"../images/grazac.png\";\r\n\r\nconst validEmailRegex = RegExp(\r\n  /^(([^<>()\\[\\]\\.,;:\\s@\\\"]+(\\.[^<>()\\[\\]\\.,;:\\s@\\\"]+)*)|(\\\".+\\\"))@(([^<>()[\\]\\.,;:\\s@\\\"]+\\.)+[^<>()[\\]\\.,;:\\s@\\\"]{2,})$/i\r\n);\r\n\r\nconst Login = () => {\r\n  const [email, setEmail] = useState(\"\");\r\n  const [password, setPassword] = useState(\"\");\r\n  const [emailErr, setEmailErr] =  useState(\"\");\r\n\r\n  \r\n  const handleEmailChange = e => {\r\n    e.preventDefault();\r\n    setEmail(e.target.value)\r\n\r\n    if (!email) setEmailErr(\"\");\r\n    let err = validEmailRegex.test(e.target.value) ? \"\" : \"please enter a valid email address\";\r\n    setEmailErr(err);\r\n  }\r\n\r\n  const handlePasswordChange = e => {\r\n    e.preventDefault();\r\n    setPassword(e.target.value)\r\n  }\r\n\r\n  return(\r\n    <div className=\"auth\">\r\n      <div className=\"auth__body\">\r\n        <div className=\"auth__hero\">\r\n          <img src={Grazac} alt=\"grazac\" />\r\n        </div>\r\n\r\n        <div className=\"auth__form\">\r\n          <div className=\"auth__form--container\">\r\n            <h1>Login</h1>\r\n\r\n            <form className=\"form\">\r\n              <div className=\"form__group\">\r\n                <label for=\"email\">Email address</label>\r\n                <input type=\"email\" id=\"email\" value={email} onChange={handleEmailChange} className={cn(\"form__input\", {\"form__input--err\": emailErr})}/>\r\n              </div>\r\n\r\n              <div className=\"form__group\">\r\n                <label for=\"pass\">Password</label>\r\n                <input type=\"password\" id=\"pass\" value={password} onChange={handlePasswordChange} className=\"form__input\"/>\r\n              </div>\r\n\r\n              <Link className=\"form__link\">Forgot password?</Link>\r\n\r\n              <button type=\"submit\" className=\"form__btn\">\r\n                <PrimaryBtn>Login</PrimaryBtn>\r\n              </button>\r\n            </form>\r\n\r\n            <div className=\"auth__line\">\r\n              <div>&nbsp;</div>\r\n              <span>or</span>\r\n              <div>&nbsp;</div>\r\n            </div>\r\n          </div>\r\n\r\n          <div className=\"auth__btns\">\r\n            <Link className=\"auth__btn\">\r\n              <svg width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\r\n                <path d=\"M4.43236 12.0862L3.7362 14.6851L1.19174 14.7389C0.431322 13.3285 0 11.7148 0 9.99997C0 8.34175 0.403276 6.77802 1.11811 5.40112H1.11866L3.38394 5.81643L4.37627 8.06812C4.16858 8.67362 4.05537 9.32361 4.05537 9.99997C4.05545 10.734 4.18842 11.4373 4.43236 12.0862Z\" fill=\"#FBBB00\"/>\r\n                <path d=\"M19.824 8.1322C19.9389 8.73712 19.9988 9.36183 19.9988 10.0003C19.9988 10.7162 19.9235 11.4146 19.7801 12.0882C19.2933 14.3805 18.0213 16.3821 16.2593 17.7986L16.2587 17.798L13.4055 17.6524L13.0017 15.1316C14.1709 14.4459 15.0846 13.3728 15.5659 12.0882H10.2188V8.1322H15.644H19.824Z\" fill=\"#518EF8\"/>\r\n                <path d=\"M16.2593 17.798L16.2599 17.7985C14.5462 19.176 12.3693 20.0002 9.99953 20.0002C6.19134 20.0002 2.88041 17.8716 1.19141 14.7392L4.43203 12.0865C5.27651 14.3403 7.45066 15.9447 9.99953 15.9447C11.0951 15.9447 12.1215 15.6486 13.0022 15.1315L16.2593 17.798Z\" fill=\"#28B446\"/>\r\n                <path d=\"M16.3818 2.30216L13.1423 4.95431C12.2308 4.38455 11.1533 4.05541 9.99894 4.05541C7.39237 4.05541 5.17756 5.7334 4.37538 8.06802L1.11773 5.40102H1.11719C2.78146 2.19228 6.13415 0 9.99894 0C12.4253 0 14.65 0.864285 16.3818 2.30216Z\" fill=\"#F14336\"/>\r\n              </svg>\r\n\r\n              Google\r\n            </Link>\r\n\r\n            <Link className=\"auth__btn\">\r\n              <svg width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\r\n                <path d=\"M18.1908 0H1.80916C0.81 0 0 0.81 0 1.80916V18.1908C0 19.19 0.81 20 1.80916 20H18.1908C19.19 20 20 19.19 20 18.1908V1.80916C20 0.81 19.19 0 18.1908 0ZM6.18885 17.2693C6.18885 17.5601 5.95314 17.7958 5.66236 17.7958H3.4212C3.13042 17.7958 2.89471 17.5601 2.89471 17.2693V7.8745C2.89471 7.58372 3.13042 7.34801 3.4212 7.34801H5.66236C5.95314 7.34801 6.18885 7.58372 6.18885 7.8745V17.2693ZM4.54178 6.46241C3.36592 6.46241 2.41267 5.50916 2.41267 4.3333C2.41267 3.15743 3.36592 2.20419 4.54178 2.20419C5.71764 2.20419 6.67089 3.15743 6.67089 4.3333C6.67089 5.50916 5.7177 6.46241 4.54178 6.46241ZM17.901 17.3117C17.901 17.5791 17.6843 17.7958 17.417 17.7958H15.012C14.7447 17.7958 14.528 17.5791 14.528 17.3117V12.905C14.528 12.2476 14.7208 10.0243 12.81 10.0243C11.3279 10.0243 11.0272 11.5461 10.9669 12.2291V17.3117C10.9669 17.5791 10.7502 17.7958 10.4828 17.7958H8.15681C7.88948 17.7958 7.67272 17.5791 7.67272 17.3117V7.83209C7.67272 7.56476 7.88948 7.34801 8.15681 7.34801H10.4828C10.7501 7.34801 10.9669 7.56476 10.9669 7.83209V8.65173C11.5164 7.82696 12.3332 7.19037 14.0722 7.19037C17.9231 7.19037 17.901 10.7881 17.901 12.7648V17.3117Z\" fill=\"#0077B7\"/>\r\n              </svg>\r\n\r\n              Linkedln\r\n            </Link>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default Login;","C:\\Users\\USER\\Desktop\\Web Development\\Bitbucket\\grazac-academy\\src\\content\\courses.js",[],"C:\\Users\\USER\\Desktop\\Web Development\\Bitbucket\\grazac-academy\\src\\utils.js",[],"C:\\Users\\USER\\Desktop\\Web Development\\Bitbucket\\grazac-academy\\src\\components\\NeedAdvice.js",[],"C:\\Users\\USER\\Desktop\\Web Development\\Bitbucket\\grazac-academy\\src\\components\\PopularCourses.js",["150","151","152","153","154","155","156"],"import {Link} from 'react-router-dom';\r\nimport design from \"../images/design.png\";\r\nimport frontend from \"../images/frontend.png\";\r\nimport backend from \"../images/backend.png\";\r\nimport android from \"../images/android.png\";\r\nimport brandidentity from \"../images/brandidentity.png\";\r\nimport digitalmarketing from \"../images/digitalmarketing.png\";\r\nimport projectmanagement from \"../images/projectmanagement.png\";\r\n\r\nconst PopularCourses = () => {\r\n  return(\r\n    <div className=\"background1\">\r\n        <div className=\"container\">\r\n            <div className=\"gga\">\r\n                <div className=\"course_mode-intro course_mode-intro\">\r\n                    <h2>Popular Courses</h2>\r\n                </div>\r\n                <div className=\"gga_container\">\r\n                    <div className=\"boxes33\">\r\n                        <div className=\"gua_cardview\">\r\n                            <div className=\"gua_cardview-box\">\r\n                                <img src={design} alt=\"course-desc\" />\r\n                            </div>\r\n                            <div className=\"gua_cardview-text\">\r\n                                <p>Design</p>\r\n                                <h4>UI/UX Design</h4>\r\n                                <p>This course helps you accelerate your career into Data Analytics. Learn Structured Query Language and Power BI for Data Analytics and Visualization.</p>\r\n                                <Link to=\"/course-detail?course=productDesign\"><a>Learn More</a></Link>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"boxes33\">\r\n                        <div className=\"gua_cardview\">\r\n                            <div className=\"gua_cardview-box\">\r\n                                <img src={frontend} alt=\"course-desc\" />\r\n                            </div>\r\n                            <div className=\"gua_cardview-text\">\r\n                                <p>Web Development</p>\r\n                                <h4>Frontend Development</h4>\r\n                                <p>This course helps you accelerate your career into Data Analytics. Learn Structured Query Language and Power BI for Data Analytics and Visualization.</p>\r\n                                <Link to=\"/course-detail\"><a>Learn More</a></Link>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"boxes33\">\r\n                        <div className=\"gua_cardview\">\r\n                            <div className=\"gua_cardview-box\">\r\n                                <img src={backend} alt=\"course-desc\" />\r\n                            </div>\r\n                            <div className=\"gua_cardview-text\">\r\n                                <p>Web Development</p>\r\n                                <h4>Bankend Development</h4>\r\n                                <p>This course helps you accelerate your career into Data Analytics. Learn Structured Query Language and Power BI for Data Analytics and Visualization.</p>\r\n                                <Link to=\"/course-detail\"><a>Learn More</a></Link>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"boxes33\">\r\n                        <div className=\"gua_cardview\">\r\n                            <div className=\"gua_cardview-box\">\r\n                                <img src={android} alt=\"course-desc\" />\r\n                            </div>\r\n                            <div className=\"gua_cardview-text\">\r\n                                <p>Mobile Application</p>\r\n                                <h4>Android Development</h4>\r\n                                <p>This course helps you accelerate your career into Data Analytics. Learn Structured Query Language and Power BI for Data Analytics and Visualization.</p>\r\n                                <Link to=\"/course-detail\"><a>Learn More</a></Link>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"boxes33\">\r\n                        <div className=\"gua_cardview\">\r\n                            <div className=\"gua_cardview-box\">\r\n                                <img src={brandidentity} alt=\"course-desc\" />\r\n                            </div>\r\n                            <div className=\"gua_cardview-text\">\r\n                                <p>Design</p>\r\n                                <h4>Brand Identity Design</h4>\r\n                                <p>This course helps you accelerate your career into Data Analytics. Learn Structured Query Language and Power BI for Data Analytics and Visualization.</p>\r\n                                <Link to=\"/course-detail\"><a>Learn More</a></Link>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"boxes33\">\r\n                        <div className=\"gua_cardview\">\r\n                            <div className=\"gua_cardview-box\">\r\n                                <img src={digitalmarketing} alt=\"course-desc\" />\r\n                            </div>\r\n                            <div className=\"gua_cardview-text\">\r\n                                <p>Marketing</p>\r\n                                <h4>Digital Marketing</h4>\r\n                                <p>This course helps you accelerate your career into Data Analytics. Learn Structured Query Language and Power BI for Data Analytics and Visualization.</p>\r\n                                <Link to=\"/course-detail\"><a>Learn More</a></Link>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"boxes33\">\r\n                        <div className=\"gua_cardview\">\r\n                            <div className=\"gua_cardview-box\">\r\n                                <img src={projectmanagement} alt=\"course-desc\" />\r\n                            </div>\r\n                            <div className=\"gua_cardview-text\">\r\n                                <p>Management</p>\r\n                                <h4>Project Management</h4>\r\n                                <p>This course helps you accelerate your career into Data Analytics. Learn Structured Query Language and Power BI for Data Analytics and Visualization.</p>\r\n                                <Link to=\"/course-detail\"><a>Learn More</a></Link>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default PopularCourses;","C:\\Users\\USER\\Desktop\\Web Development\\Bitbucket\\grazac-academy\\src\\components\\PrimaryBtn.js",[],"C:\\Users\\USER\\Desktop\\Web Development\\Bitbucket\\grazac-academy\\src\\components\\Navbar.js",["157","158","159"],"import { useEffect, useState, useRef } from \"react\";\r\nimport { cn } from \"../utils\";\r\nimport NavItem from \"./NavItem\";\r\nimport logo from \"../images/svg/grazac-logo.svg\";\r\nimport PrimaryBtn from \"./PrimaryBtn\";\r\nimport { Link } from \"react-router-dom\";\r\n\r\nconst Navbar = () => {\r\n  const [fixed, setFixed] = useState(false);\r\n  const [active, setActive] = useState(false);\r\n  const [hover, setHover] = useState(false);\r\n  const [click, setClick] = useState(false);\r\n  const nav = useRef(null);\r\n\r\n  useEffect(() => {\r\n    if (nav.current && window.pageYOffset > nav.current.offsetTop)\r\n      setFixed(true);\r\n    else setFixed(false);\r\n    window.addEventListener(\"scroll\", () => {\r\n      if (nav.current && window.pageYOffset > nav.current.offsetTop)\r\n        setFixed(true);\r\n      else setFixed(false);\r\n    });\r\n  });\r\n\r\n  const handleClick = (e) => {\r\n    e.preventDefault();\r\n\r\n    if (active) setActive(false);\r\n    else setActive(true);\r\n  };\r\n\r\n  return (\r\n    <nav className={cn(\"nav\", { \"nav--fixed\": fixed })} ref={nav}>\r\n      <div className=\"nav__container\">\r\n        <div className=\"nav__logo\">\r\n          <Link to=\"/\">\r\n            <img src={logo} alt=\"logo\" />\r\n          </Link>\r\n        </div>\r\n\r\n        <div className={cn(\"nav__menu\", { \"nav__menu--active\": active })}>\r\n          <button className=\"nav-tgl\" onClick={handleClick}>\r\n            <span>&nbsp;</span>\r\n          </button>\r\n\r\n          <ul className=\"nav__list--mb\">\r\n            <li className=\"nav__item\">\r\n              <NavItem exact link=\"/\">\r\n                Home\r\n              </NavItem>\r\n            </li>\r\n            <li className=\"nav__item\">\r\n              <NavItem link=\"/about-us\">About</NavItem>\r\n            </li>\r\n            <li className=\"nav__item\">\r\n              <NavItem link=\"/undergraduate-accelerator-track\">Undergraduate</NavItem>\r\n            </li>\r\n            <li className=\"nav__item\">\r\n              <NavItem link=\"/graduate-accelerator-track\">Graduate</NavItem>\r\n            </li>\r\n            <li className=\"nav__item nav__item--btn\">\r\n              <a href=\"/#tracks\">\r\n                <div className=\"nav__btn\">\r\n                  <div className=\"nav__btn--text\">Enroll Now</div>\r\n                </div>\r\n              </a>\r\n            </li>\r\n          </ul>\r\n        </div>\r\n\r\n        <ul className=\"nav__list\" style={{ marginBottom: 0 }}>\r\n          <li className=\"nav__item\">\r\n            <NavItem exact link=\"/\">\r\n              Home\r\n            </NavItem>\r\n          </li>\r\n          <li className=\"nav__item\">\r\n            <NavItem link=\"/about-us\">About</NavItem>\r\n          </li>\r\n          <li\r\n            className=\"nav__item\"\r\n            style={{ position: \"relative\", cursor: \"pointer\" }}\r\n            onMouseEnter={() => setHover(true)}\r\n            onMouseLeave={() => setHover(false)}\r\n          >\r\n            <a className=\"nav__link\" onClick={(e) => (!click ? setClick(true) : setClick(false))}>\r\n              Academy\r\n            </a>\r\n            <svg\r\n              className=\"mask\"\r\n              width=\"11\"\r\n              height=\"6\"\r\n              viewBox=\"0 0 11 6\"\r\n              fill=\"none\"\r\n              xmlns=\"http://www.w3.org/2000/svg\"\r\n            >\r\n              <path\r\n                fill-rule=\"evenodd\"\r\n                clip-rule=\"evenodd\"\r\n                d=\"M5.50003 6C5.32089 6 5.14252 5.934 4.99716 5.80113L0.282791 1.51511C-0.0503581 1.21251 -0.0959304 0.671616 0.182218 0.308161C0.45958 -0.0552936 0.954589 -0.104154 1.28852 0.198439L5.50867 4.03529L9.72175 0.336449C10.0596 0.0398561 10.5546 0.098146 10.8265 0.466744C11.0984 0.835342 11.0449 1.37452 10.7071 1.67197L5.99268 5.81056C5.8489 5.93657 5.67446 6 5.50003 6Z\"\r\n                fill=\"#575A65\"\r\n              />\r\n            </svg>\r\n\r\n            <div\r\n              className={cn(\"nav__dropdown\", {\r\n                \"nav__dropdown--active\": hover || click,\r\n              })}\r\n            >\r\n              <span></span>\r\n              <ul\r\n                className=\"nav__dropdown--list\"\r\n                onMouseEnter={() => console.log(\"brrrrr\")}\r\n              >\r\n                <li>\r\n                  <Link to=\"/undergraduate-accelerator-track\" className=\"nav__link\">Undergraduate</Link>\r\n                </li>\r\n                <li>\r\n                  <Link to=\"/graduate-accelerator-track\" className=\"nav__link\">Graduate</Link>\r\n                </li>\r\n              </ul>\r\n            </div>\r\n          </li>\r\n          <a href=\"/#tracks\">\r\n            <div className=\"nav__btn\">\r\n              <div className=\"nav__btn--text\">Enroll Now</div>\r\n            </div>\r\n          </a>\r\n        </ul>\r\n      </div>\r\n    </nav>\r\n  );\r\n};\r\n\r\nexport default Navbar;\r\n","C:\\Users\\USER\\Desktop\\Web Development\\Bitbucket\\graz