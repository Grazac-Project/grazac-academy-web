2.5025 15.025 2.50125 15.0188 2.50125C15.0138 2.50125 15.0063 2.5 15 2.5C8.1075 2.5 2.5 8.10875 2.5 15C2.5 21.8925 8.1075 27.5 15 27.5C15.0075 27.5 15.0138 27.4988 15.0188 27.4988C15.0213 27.4988 15.0225 27.5 15.025 27.5C15.0288 27.5 15.0325 27.4975 15.035 27.4975C21.9112 27.4788 27.5 21.88 27.5 15Z\"\r\n                            fill=\"white\"\r\n                          />\r\n                        </mask>\r\n                      </svg>\r\n                    </div>\r\n                    <h3>Job Placement</h3>\r\n                    <p>\r\n                      Enter the recruitment process with tech companies and take\r\n                      a stride into your dream career.{\" \"}\r\n                    </p>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <div className=\"background1\" id=\"courses\">\r\n            <div className=\"container\">\r\n              <div className=\"gga\">\r\n                <div className=\"course_mode-intro course_mode-intro\">\r\n                  <h2>Available Courses</h2>\r\n                </div>\r\n                <div className=\"gga_container\">\r\n                  {courses.length ? (\r\n                    courses.map((item, index) => (\r\n                      <Link\r\n                        to={`/course-detail-graduate?course=${item.slug}`}\r\n                        className=\"boxes33\"\r\n                        key={index}\r\n                      >\r\n                        <div className=\"gua_cardview\">\r\n                          <div className=\"gua_cardview-box\">\r\n                            <img src={item.thumb} alt=\"course-desc\" />\r\n                          </div>\r\n                          <div className=\"gua_cardview-text\">\r\n                            <h4 style={{ color: \"rgb(51, 51, 51)\" }}>\r\n                              {item.name}\r\n                            </h4>\r\n                            <p>{item.description}</p>\r\n                            <Link\r\n                              to={\"/course-detail-graduate?course=\" + item.slug}\r\n                            >\r\n                            Learn More\r\n                            </Link>\r\n                          </div>\r\n                        </div>\r\n                      </Link>\r\n                    ))\r\n                  ) : (\r\n                    <div>\r\n                      {/* <img src={loader} alt=\"loader\" className=\"loader\" /> */}\r\n                    </div>\r\n                  )}\r\n                  <div className=\"boxes33\">\r\n                    <div className=\"gua_cardview\">\r\n                      <div className=\"gua_cardview-text\">\r\n                        <h4>Can't find a course you are interested in?</h4>\r\n                        <p>\r\n                          We will be glad if you can suggest the course you'd\r\n                          love to learn.\r\n                        </p>\r\n                        <Link to=\"/contact\">\r\n                          <a>Contact Us</a>\r\n                        </Link>\r\n                      </div>\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <Qualities />\r\n          <NeedAdvice />\r\n        </div>\r\n        <Footer />\r\n      </div>\r\n      ) : (\r\n          <Loader />\r\n      )}\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default GraduateAccelerator;\r\n","C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\pages\\AboutUs.js",["236"],"import { useEffect, useContext } from \"react\";\r\n// import { Link } from \"react-router-dom\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport Mode from \"../components/Mode\";\r\nimport Dots from \"../images/svg/dots.svg\";\r\nimport { LoaderContext } from \"../context\";\r\nconst cardsInfo = [\r\n  {\r\n    color: \"39,234,198\",\r\n    title: \"Creativity\",\r\n    body:\r\n      \"We constantly develop ideas that drives innovation. Our company is a community that allow us share common interests and ideas.\",\r\n  },\r\n  {\r\n    color: \"26,222,235\",\r\n    title: \"Quality\",\r\n    body:\r\n      \"We strive to provide value that fulfils and exceeds expectation. We have an unwavering guide that leads the way to fulfilling your goal.\",\r\n  },\r\n  {\r\n    color: \"108,21,250\",\r\n    title: \"Passion\",\r\n    body:\r\n      \"Our enthusiasm to deliver the best makes us unique. We uphold the highest standards in deliverability.\",\r\n  },\r\n  {\r\n    color: \"255,113,155\",\r\n    title: \"Commitment\",\r\n    body:\r\n      \"We are focused on giving best solutions. Our concern is solving your problem rather than why or how the problem was created.\",\r\n  },\r\n  {\r\n    color: \"254,125,108\",\r\n    title: \"Collaboration\",\r\n    body:\r\n      \"Our success depends upon the collective intelligence of our team members and the shared vision of our partners.\",\r\n  },\r\n  {\r\n    color: \"255,180,67\",\r\n    title: \"Teamwork\",\r\n    body:\r\n      \"We do better, together. Our environment fosters progress, effectiveness and speed.\",\r\n  },\r\n];\r\n\r\nconst AboutUs = () => {\r\n  const { setShow } = useContext(LoaderContext);\r\n  useEffect(() => {\r\n    document.title = \"About - Grazac Academy\";\r\n    window.scrollTo(0, 0);\r\n   \r\n  }, []);\r\n\r\n  return (\r\n    <div className=\"about\">\r\n      <Navbar />\r\n      <div className=\"about__top\">\r\n        <div className=\"about__top--container\">\r\n          <div className=\"about__top--up\">\r\n            <div>\r\n              <img src={Dots} alt=\"dots\" />\r\n            </div>\r\n            <div></div>\r\n            <div className=\"about__top--text\">\r\n              <h1>About Us</h1>\r\n              <p>\r\n                At Grazac Academy, we provide you with the right platform to\r\n                upskill yourself for the future.\r\n              </p>\r\n            </div>\r\n          </div>\r\n          <div className=\"about__top--down\">\r\n            <div></div>\r\n            <div></div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <div className=\"about__middle\">\r\n        <div className=\"about__middle--container\">\r\n          <div className=\"about__middle--head\">\r\n            <h2>Our Core Values</h2>\r\n            <p>\r\n              You determine the starting points, we provide the best possible\r\n              interception to achieve the goals.\r\n            </p>\r\n          </div>\r\n\r\n          <div className=\"about__middle--cards\">\r\n            {cardsInfo.map((item) => (\r\n              <div className=\"about__middle--card\">\r\n                <div style={{ \"--bg-color\": item.color }}></div>\r\n                <h3>{item.title}</h3>\r\n                <p>{item.body}</p>\r\n              </div>\r\n            ))}\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <Mode />\r\n      <Footer />\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default AboutUs;\r\n","C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\pages\\UndergraduateCourseDetail.js",["237","238"],"import React, { useState, useEffect } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport PrimaryBtn from \"../components/PrimaryBtn\";\r\nimport MOT from \"../components/MOT\";\r\nimport Loader from \"../components/Loader\";\r\n\r\nimport paper from \"../images/svg/paper-ribbon.svg\";\r\n\r\nconst ErrorModal = (props) => {\r\n  return (\r\n    <div className=\"modal3__bg\" onClick={() => props.setShowModal(false)}>\r\n      <div className=\"modal3__content modal3__content--err\">\r\n        <div className=\"modal3__content--head\">\r\n          <div>&nbsp;</div>\r\n          <svg className=\"modal3__content--svg\" viewBox=\"0 0 10 10\" fill=\"none\">\r\n            <path\r\n              d=\"M4.94263 4.00008L7.80451 1.13814C8.06516 0.877482 8.06516 0.456157 7.80451 0.195496C7.54385 -0.0651653 7.12254 -0.0651653 6.86188 0.195496L4 3.05744L1.13812 0.195496C0.877463 -0.0651653 0.456148 -0.0651653 0.195492 0.195496C-0.065164 0.456157 -0.065164 0.877482 0.195492 1.13814L3.05737 4.00008L0.195492 6.86202C-0.065164 7.12269 -0.065164 7.54401 0.195492 7.80467C0.325486 7.93467 0.496146 8 0.666806 8C0.837465 8 1.00812 7.93467 1.13812 7.80467L4 4.94273L6.86188 7.80467C6.99188 7.93467 7.16254 8 7.33319 8C7.50385 8 7.67451 7.93467 7.80451 7.80467C8.06516 7.54401 8.06516 7.12269 7.80451 6.86202L4.94263 4.00008Z\"\r\n              fill=\"#073041\"\r\n            />\r\n          </svg>\r\n        </div>\r\n\r\n        <div className=\"modal3__content--body\">\r\n          <h1>Oops...</h1>\r\n          Sorry :( but you can no longer enroll for this course because it is no\r\n          longer available.\r\n          <br />\r\n          <br />\r\n          Check by later.\r\n        </div>\r\n      </div>\r\n    </div>\r\n  );\r\n};\r\n\r\nconst CourseDetail = (props) => {\r\n  const [course, setCourse] = useState(\"\");\r\n  const [outline, setOutline] = useState([]);\r\n  const [showModal, setShowModal] = useState(false);\r\n\r\n  useEffect(() => {\r\n    document.title = \"Course Details - Grazac Academy\";\r\n    window.scrollTo(0, 0);\r\n  \r\n    const slug = props.location.search.substring(8);\r\n    fetch(`https://grazacacademy.com/undergraduate/course/details/${slug}`)\r\n      .then((resp) => resp.json())\r\n      .then((resp) => {\r\n        setCourse(resp.data);\r\n        setOutline(JSON.parse(resp.data.outline));\r\n      })\r\n      .catch(() => {\r\n        console.log(\r\n          \"An error occurred when fetching course details, refreshing...\"\r\n        );\r\n        window.location.reload();\r\n      });\r\n  }, [props.location.search]);\r\n\r\n  const toggleModal = (e) => {\r\n    e.preventDefault();\r\n    showModal ? setShowModal(false) : setShowModal(true);\r\n  };\r\n\r\n  return (\r\n    <div>\r\n      {outline.length ? (\r\n        <div id=\"blur\">\r\n        <Navbar />\r\n        <div className=\"course\">\r\n          <div className=\"course_hero\">\r\n            <div className=\"container\">\r\n              {course ? (\r\n                <div className=\"row\">\r\n                  <div className=\"col-sm-6\">\r\n                    <div className=\"course_hero-text\">\r\n                      <div className=\"course_hero-text-b\">\r\n                        <h1>{course.name}</h1>\r\n                        <p>{course.description}</p>\r\n                        <div className=\"contact_hero-privacy\">\r\n                          <a\r\n                            href={course.brochure}\r\n                            target=\"_blank\"\r\n                            rel=\"noreferrer\"\r\n                            className=\"download-brochure\"\r\n                          >\r\n                            Download Brochure\r\n                          </a>\r\n                          <Link to=\"/undergraduate-form\">\r\n                            <button>Enroll now</button>\r\n                          </Link>\r\n                        </div>\r\n                      </div>\r\n                    </div>\r\n                  </div>\r\n                  <div>\r\n                    {/* <img src={paper} alt=\"academy\" className=\"gga_hero-image\" /> */}\r\n                  </div>\r\n                </div>\r\n              ) : (\r\n                <div>\r\n                {/*<img src={loader} alt=\"loader\" className=\"loader\" />*/}\r\n                </div>\r\n              )}\r\n            </div>\r\n          </div>\r\n          <div className=\"course_learn\">\r\n            <div className=\"container\">\r\n              <div className=\"course_wwd-intro\">\r\n                <h4>GRAZAC ACADEMY</h4>\r\n                <h2>What you'll Learn</h2>\r\n              </div>\r\n              <div className=\"course_learn-main\">\r\n                {outline.length ? (\r\n                  outline.map((item, index) => (\r\n                    <div key={index}>\r\n                      <div className=\"course_learn-main-list\">\r\n                        <div className=\"box1\">\r\n                          <h3>{index < 10 ? \"0\" + index : index}</h3>\r\n                        </div>\r\n                        <div className=\"box2\">\r\n                          <h3>{item.topic}</h3>\r\n                        </div>\r\n                        <div className=\"box3\">\r\n                          <p>{item.summary}</p>\r\n                        </div>\r\n                      </div>\r\n                      <hr />\r\n                    </div>\r\n                  ))\r\n                ) : (\r\n                  <div>\r\n                    {/*<img src={loader} alt=\"loader\" className=\"loader\" />*/}\r\n                  </div>\r\n                )}\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <MOT />\r\n          <div className=\"course_purple\">\r\n            <div className=\"course_purple_txt\">\r\n              <p>Pricing</p>\r\n              <h1>100%</h1>\r\n              <p>Discount Available</p>\r\n            </div>\r\n            <div className=\"course_purple-main\">\r\n              <div className=\"course_purple-main-boxes grad-box\">\r\n                <h4>Tuition</h4>\r\n                <h2>FREE</h2>\r\n              </div>\r\n              <div className=\"course_purple-main-boxes grad-box\">\r\n                <h4>Note</h4>\r\n                <p>\r\n                  <span>\r\n                    You are required to pay a sum of ₦10,000 for your certificate\r\n                    and to ensure we secure a befitting environment to aid your\r\n                    learning.{\" \"}\r\n                  </span>\r\n                </p>\r\n              </div>\r\n            </div>\r\n            <div className=\"course_purple-btn\">\r\n              <PrimaryBtn link=\"/undergraduate-form\">Enroll Now</PrimaryBtn>\r\n              <a href=\"tel:+234806 836 5951\" style={{marginTop:\"7px\"}}>\r\n                <p>Talk to course rep</p>\r\n              </a>\r\n            </div>\r\n          </div>\r\n        </div>\r\n        <Footer />\r\n  \r\n        {showModal && <ErrorModal setShowModal={setShowModal} />}\r\n      </div>\r\n  \r\n      ) : (\r\n          <Loader />\r\n      )}\r\n    </div>\r\n  );\r\n\r\n};\r\n\r\nexport default CourseDetail;\r\n","C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\pages\\Landing.js",["239","240","241","242","243","244","245","246","247","248","249"],"C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\pages\\Contact.js",["250","251"],"import React, { useState, useEffect } from \"react\";\r\nimport axios from 'axios';\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport PrimaryBtn from \"../components/PrimaryBtn\";\r\n\r\nimport Facebook from \"../images/svg/facebook.svg\";\r\nimport Instagram from \"../images/svg/instagram.svg\";\r\nimport Twitter from \"../images/svg/twitter.svg\";\r\nimport Youtube from \"../images/svg/youtube.svg\";\r\n\r\nconst Contact = () => {\r\n\r\n    const [ name, setName ] = useState('');\r\n    const [ email, setEmail ] = useState('');\r\n    const [ subject, setSubject ] = useState('');\r\n    const [ message, setMessage ] = useState('');\r\n\r\n    useEffect(() => {\r\n        document.title = 'Contact - Grazac Academy';\r\n        window.scrollTo(0,0);\r\n    }, []);\r\n\r\n    const handleSubmit = () => {\r\n        if(name.length && email.length && subject.length && message.length) {\r\n            const btn = document.querySelector('#submit');\r\n            btn.setAttribute('disabled', '');\r\n            btn.textContent = 'Submitting...';\r\n            console.log('Submitted')\r\n            axios.post('http://grazacacademy.com/contact/create', {\r\n                name: name,\r\n                email: email,\r\n                subject: subject,\r\n                message: message\r\n            })\r\n            .then(resp => resp.data)\r\n            .then(response => {\r\n                if(response.success === true) {\r\n                    btn.removeAttribute('disabled');\r\n                    btn.textContent = 'Submit';\r\n                    alert(response.msg);\r\n                    setName(''); setEmail(''); setSubject(''); setMessage('');\r\n                } else {\r\n\r\n                }\r\n            })\r\n            .catch((err) => {\r\n                \r\n            });\r\n        } else {\r\n            alert('Invalid input');\r\n        }\r\n    }\r\n\r\n    return(\r\n        <div>\r\n            <Navbar/>\r\n            <div className=\"contact\">\r\n                <div className=\"contact_layer\">\r\n                    <div className=\"container\">\r\n                        <div className=\"contact_layer-text\">\r\n                            <h1>Get In Touch</h1>\r\n                            <p>We want to hear from you. Let us know how we can help</p>\r\n                        </div>\r\n                        {/*<div classname=\"contact_layer-circles\">\r\n                            <img src={kamala} alt=\"kamala\"  classname=\"contact_layer-circles-1\" />\r\n                            <img src={kamala} alt=\"kamala\"  classname=\"contact_layer-circles-2\" />\r\n                            <img src={kamala} alt=\"kamala\"  classname=\"contact_layer-circles-3\" />\r\n                            <img src={kamala} alt=\"kamala\"  classname=\"contact_layer-circles-4\" />\r\n                        </div>*/}\r\n                        <div className=\"contact_hero\">\r\n                            <div className=\"contact_hero-flexdiv\">\r\n                                <div className=\"contact_hero-flexdiv-1\" >\r\n                                    <label>Full Name  <span>*</span></label>\r\n                                    <input type=\"text\" placeholder=\"ex. John Doe\" value={name} onChange={e => setName(e.target.value)} />\r\n                                </div>\r\n                                <div className=\"contact_hero-flexdiv-2\">\r\n                                    <label>Email  <span>*</span></label>\r\n                                    <input type=\"text\" placeholder=\"ex. john@gmail.com\" value={email} onChange={e => setEmail(e.target.value)}  />\r\n                                </div>\r\n                            </div>\r\n                            <div>\r\n                                <label>Subject  <span>*</span></label>\r\n                                <input  type=\"text\" placeholder=\"ex. John Doe\" value={subject} onChange={e => setSubject(e.target.value)}  />\r\n                            </div>\r\n                            <div>\r\n                                <label>Message  <span>*</span></label>\r\n                                <textarea  type=\"text\" placeholder=\"Describe your task for us\" value={message} onChange={e => setMessage(e.target.value)}  />\r\n                            </div>\r\n                            <div className=\"contact_hero-privacy\" >\r\n                                <p>By submitting this form your consent to us emailing you occasionally about our products and services. You can unsubscribe from emails at any time, and we will never pass your email onto third parties. <span>Privacy Policy</span></p>\r\n                                <button id=\"submit\" onClick={handleSubmit}>Submit</button>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"container\">\r\n                    <div className=\"contact_campus\">\r\n                        <div className=\"contact_campus-intro\">\r\n                            <h2>Campus Inquiries</h2>\r\n                            <p>Connect with Us</p>\r\n                        </div>\r\n                        <div className=\"contact_campus-main\">\r\n                            <div className=\"contact_campus-main-div boxes33\">\r\n                                <h3>Office</h3>\r\n                                <p>PROHUB, Salawu Olabode Avenue, Ewang Road, </p>\r\n                                <p>Idi-aba, 110124, Abeokuta</p>\r\n                                <p>+234 806 836 5951</p>\r\n                            </div>\r\n                            <div className=\"contact_campus-main-div boxes33\">\r\n                                <h3>Book A Call</h3>\r\n                                <p>We are here to help with any questions. </p>\r\n                                <p>Talk to our programme leads.</p>\r\n                                <div style={{display:'flex'}}>\r\n                                    <a href=\"tel:+2348068365951\" ><div className=\"nav__btn--text\">Book a Call</div></a>\r\n                                </div>\r\n                            </div>\r\n                            <div className=\"contact_campus-main-div boxes33\">\r\n                                <h3>Social Media</h3>\r\n                                <div className=\"social\">\r\n                                    <img src={Facebook} alt=\"social\"/>\r\n                                </div>\r\n                                <div className=\"social\">\r\n                                    <img src={Twitter} alt=\"social\"/>\r\n                                </div>\r\n                                <div className=\"social\">\r\n                                    <img src={Youtube} alt=\"social\"/>\r\n                                </div>\r\n                                <div className=\"social\">\r\n                                    <img src={Instagram} alt=\"social\"/>\r\n                                </div>\r\n                            </div>\r\n\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div>\r\n                    <iframe src=\"https://www.google.com/maps/d/embed?mid=16NZ9a9VhKkk2-5nnYEdL93mxq7kjDZLT\" width=\"100%\" height=\"600\"></iframe>\r\n                </div>\r\n                {/*<extracomponent/> a component used in the landing page comes here*/}\r\n            </div>\r\n            <Footer/>\r\n        </div>\r\n    );\r\n}\r\n\r\nexport default Contact;","C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\pages\\GraduateCourseDetail.js",["252","253","254"],"import React, { useState } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport PrimaryBtn from \"../components/PrimaryBtn\";\r\nimport MOT from \"../components/MOT\";\r\n\r\nimport paper from \"../images/svg/paper-ribbon.svg\";\r\nimport Loader from \"../components/Loader\";\r\n\r\nconst CourseDetail = (props) => {\r\n  const [course, setCourse] = useState(\"\");\r\n  const [outline, setOutline] = useState([]);\r\n\r\n  React.useEffect(() => {\r\n    document.title = \"Course Details - Grazac Academy\";\r\n    window.scrollTo(0, 0);\r\n    const slug = props.location.search.substring(8);\r\n    fetch(`https://grazacacademy.com/graduate/course/details/${slug}`)\r\n      .then((resp) => resp.json())\r\n      .then((resp) => {\r\n        console.log(resp)\r\n        setCourse(resp.data);\r\n        setOutline(JSON.parse(resp.data.outline));\r\n      })\r\n      .catch((error) => {\r\n        console.log(\r\n          \"An error occurred when fetching course details, refreshing...\"\r\n        );\r\n        window.location.reload();\r\n      });\r\n  }, []);\r\n\r\n  return (\r\n    <div>\r\n      {outline.length ? (\r\n        <div id=\"blur\">\r\n        <Navbar />\r\n        <div className=\"course\">\r\n          <div className=\"course_hero\">\r\n            <div className=\"container\">\r\n              {course ? (\r\n                <div className=\"row\">\r\n                  <div className=\"col-sm-6\">\r\n                    <div className=\"course_hero-text\">\r\n                      <div className=\"course_hero-text-b\">\r\n                        <h1>{course.name}</h1>\r\n                        <p>{course.description}</p>\r\n                        <div className=\"contact_hero-privacy\">\r\n                          <a\r\n                            href={course.brochure}\r\n                            className=\"download-brochure\"\r\n                            target=\"_blank\"\r\n                          >\r\n                            Download Brochure\r\n                          </a>\r\n                          <Link to=\"/login\">\r\n                            <button>Enroll now</button>\r\n                          </Link>\r\n                        </div>\r\n                      </div>\r\n                    </div>\r\n                  </div>\r\n                  <div>\r\n                    {/* <img src={paper} alt=\"academy\" className=\"gga_hero-image\" /> */}\r\n                  </div>\r\n                </div>\r\n              ) : (\r\n                <div>\r\n                  {/*<img src={loader} alt=\"loader\" className=\"loader\" />*/}\r\n                </div>\r\n              )}\r\n            </div>\r\n          </div>\r\n          <div className=\"course_learn\">\r\n            <div className=\"container\">\r\n              <div className=\"course_wwd-intro\">\r\n                <h4>GRAZAC ACADEMY</h4>\r\n                <h2>What you'll Learn</h2>\r\n              </div>\r\n              <div className=\"course_learn-main\">\r\n                {outline.length ? (\r\n                  outline.map((item, index) => (\r\n                    <div key={index}>\r\n                      <div className=\"course_learn-main-list\">\r\n                        <div className=\"box1\">\r\n                          <h3>{index < 10 ? \"0\" + index : index}</h3>\r\n                        </div>\r\n                        <div className=\"box2\">\r\n                          <h3>{item.topic}</h3>\r\n                        </div>\r\n                        <div className=\"box3\">\r\n                          <p>{item.summary}</p>\r\n                        </div>\r\n                      </div>\r\n                      <hr />\r\n                    </div>\r\n                  ))\r\n                ) : (\r\n                  <div>\r\n                    {/* <img src={loader} alt=\"loader\" className=\"loader\" /> */}\r\n                  </div>\r\n                )}\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <MOT />\r\n          <div className=\"course_purple\">\r\n                    <div className=\"course_purple_txt\">\r\n                        <p>Our Flexible Payment Plans</p>\r\n                        <h1>{course.percent_off}%</h1>\r\n                        <p>Discount Available</p>\r\n                    </div>\r\n                    <div className=\"course_purple-main\">\r\n                    <div>\r\n                            <div className=\"course_purple-main-boxes grad-box\">\r\n                                <h4>Full Payment</h4>\r\n                                <h3><span style={{textDecoration:'line-through'}}>₦{course.tuition}</span></h3>\r\n                                <h2>₦{new Intl.NumberFormat().format(course.discounted_tuition)}</h2>\r\n                                <p>This is a one-off payment. You won't be required to pay any amount again till the end of your training.</p>\r\n                            </div>\r\n                        </div>\r\n                        <div>\r\n                            <div className=\"course_purple-main-boxes grad-box\">\r\n                                <h4>Installment Payment</h4>\r\n                                <h3><span style={{textDecoration:'line-through'}}>₦{/*course.tuition*/}</span></h3>\r\n                                <h2>₦{new Intl.NumberFormat().format(75000)} <span style={{fontSize: '14px'}}>* 2 months.</span></h2>\r\n                                <p>To be paid at the start of the training and completed midway into the training which is after 2 months.</p>\r\n                            </div>\r\n                        </div>\r\n                        <div>\r\n                            <div className=\"course_purple-main-boxes grad-box\">\r\n                                <h4>Monthly Payment</h4>\r\n                                <h3><span style={{textDecoration:'line-through'}}>₦{course.tuition}</span></h3>\r\n                                <h2>₦{new Intl.NumberFormat().format(40000)} <span style={{fontSize: '14px'}}>* 4 months.</span></h2>\r\n                                <p>To be paid at the beginning of each month for the duration of the training which is 4 months.</p>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"course_purple-btn\">\r\n                        <PrimaryBtn link=\"/login\">Enroll Now</PrimaryBtn>\r\n                        <a href=\"tel:+234806 836 5951\" style={{marginTop:\"7px\"}}><p>Talk to course rep</p></a>\r\n                    </div>\r\n            </div>\r\n        </div>\r\n        <Footer />\r\n      </div>\r\n      ) : (\r\n          <Loader />\r\n      )}\r\n    </div>\r\n  );\r\n\r\n};\r\n\r\nexport default CourseDetail;\r\n","C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\pages\\GraduateForm.js",["255","256","257","258","259","260"],"import { useEffect, useRef, useState } from \"react\";\r\nimport { useFlutterwave, closePaymentModal } from \"flutterwave-react-v3\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport axios from \"axios\";\r\n\r\nconst GraduateForm = () => {\r\n  const [firstname, setFirstName] = useState(\"\");\r\n  const [lastname, setLastName] = useState(\"\");\r\n  const [phone, setPhone] = useState(\"\");\r\n  const [email, setEmail] = useState(\"\");\r\n  const [availability, setAvailability] = useState(\"\");\r\n  const [amount, setAmount] = useState(\"\");\r\n  const [course, setCourse] = useState(\"\");\r\n  const [paymentPlan, setPaymentPlan] = useState(\"\");\r\n  const [message, setMessage] = useState(\"\");\r\n  const [txref, setTxref] = useState(\"\");\r\n  const [fetchCourses, setFetched] = useState([]);\r\n  const formInfo = useRef();\r\n  const [showPayment, setShowPayment] = useState(true);\r\n\r\n  useEffect(() => {\r\n    document.title = \"Join our Graduate Track - Grazac Academy\";\r\n    window.scrollTo(0, 0);\r\n    const method = window.location.search.substring(9);\r\n    if (method) {\r\n      setPaymentPlan(method);\r\n      setShowPayment(false);\r\n    }\r\n    fetch(\"https://grazacacademy.com/graduate/courses\")\r\n      .then((resp) => resp.json())\r\n      .then((resp) => {\r\n        setFetched(resp.data);\r\n      })\r\n      .catch((error) => {\r\n        console.log(\r\n          \"An error occurred when fetching course details, refreshing...\"\r\n        );\r\n        window.location.reload();\r\n      });\r\n  }, []);\r\n\r\n  const courseChange = (e) => {\r\n    setCourse(e.target.value);\r\n    var rc = e.target.options[e.target.selectedIndex].dataset.index;\r\n    setAmount(fetchCourses[rc].discounted_tuition);\r\n  };\r\n\r\n  const choosePlan = (e) => {\r\n    if(e.target.value === 'installmental') {\r\n      setAmount(40000);\r\n    } else if(e.target.value === 'monthly') {\r\n      setAmount(55000);\r\n    } else {\r\n      setAmount(75000);\r\n    }\r\n    setPaymentPlan(e.target.value);\r\n  };\r\n\r\n  const config = {\r\n    public_key: \"FLWPUBK-006bdc82ad878f1518af32f44af6478f-X\",\r\n    tx_ref: Date.now(),\r\n    amount: amount,\r\n    currency: \"NGN\",\r\n    payment_options: \"card,mobilemoney,ussd\",\r\n    customer: {\r\n      email: email,\r\n      phonenumber: phone,\r\n      name: firstname + \" \" + lastname,\r\n    },\r\n    customizations: {\r\n      title: \"Grazac Graduate Accelerator Plan\",\r\n      description: `Payment for ${course} at Grazac Graduate Accelerator Plan`,\r\n      logo: \"https://grazac.com.ng/assets/images/favicon.png\",\r\n    },\r\n  };\r\n\r\n  const handleFlutterPayment = useFlutterwave(config);\r\n\r\n  const onSubmit = (e) => {\r\n    e.preventDefault();\r\n    document.querySelector(\".form-info\").textContent = \"Enrollment is Currently Closed. Check Back Later\"; \r\n    document.querySelector(\"#submit-btn\").textContent = \"Registration closed!!!\"\r\n    // if (amount) {\r\n    //   handleFlutterPayment({\r\n    //     callback: (response) => {\r\n    //       if (response.status === \"successful\") {\r\n    //         setTxref(response.tx_ref);\r\n    //         //window.scroll(0, formInfo.current.offsetTop);\r\n    //         document.querySelector(\".form-info\").textContent =\r\n    //           \"Submitting, please wait...\";\r\n    //         document\r\n    //           .querySelector(\"#submit-btn\")\r\n    //           .setAttribute(\"disabled\", \"disabled\");\r\n    //         fetch(\"https://grazacacademy.com/graduate/register\", {\r\n    //           method: \"POST\",\r\n    //           headers: {\r\n    //             \"Content-Type\": \"application/json\",\r\n    //           },\r\n    //           body: JSON.stringify({\r\n    //             firstname: firstname,\r\n    //             lastname: lastname,\r\n    //             email: email,\r\n    //             phone: phone,\r\n    //             course: course,\r\n    //             paymentPlan: paymentPlan,\r\n    //             expectation: message,\r\n    //             tuition: amount,\r\n    //             tx_ref: txref,\r\n    //           }),\r\n    //         })\r\n    //           .then((resp) => resp.json())\r\n    //           .then((data) => {\r\n    //             if (data.success === true) {\r\n    //               document.querySelector(\".form-info\").textContent =\r\n    //                 \"Your registration was successful, kindly check your mailbox for further details\";\r\n    //               document.querySelector(\"#submit-btn\").removeAttribute(\"disabled\");\r\n    //               setFirstName(\"\");\r\n    //               setLastName(\"\");\r\n    //               setMessage(\"\");\r\n    //               setPhone(\"\");\r\n    //               setEmail(\"\");\r\n    //               setCourse(\"\");\r\n    //             } else {\r\n    //               document.querySelector(\".form-info\").textContent = data.msg;\r\n    //               document.querySelector(\"#submit-btn\").removeAttribute(\"disabled\");\r\n    //             }\r\n    //           })\r\n    //           .catch((err) => {\r\n    //             document.querySelector(\".form-info\").textContent =\r\n    //               \"Something went wrong, please try again\";\r\n    //             document.querySelector(\"#submit-btn\").removeAttribute(\"disabled\");\r\n    //           });\r\n\r\n    //           let formData = new FormData();\r\n    //           formData.append(\"name\", firstname);\r\n    //           formData.append(\"email\", email);\r\n    //           axios\r\n    //             .post(\"http://grazac.com.ng/newsletter/subscribe\", formData, {\r\n    //               headers: {\r\n    //                 \"Content-Type\": \"application/json\",\r\n    //               },\r\n    //             })\r\n    //             .then((resp) => resp.data)\r\n    //             .then((data) => {\r\n    //               if (data.success === true) {\r\n    //                 console.log(\"Added to newsletter\");\r\n    //               } else {\r\n    //                 console.log(\"Not Added to newsletter\");\r\n    //               }\r\n    //             })\r\n    //             .catch((err) => {\r\n    //               console.log(`An error occured, please try again ${err}`);\r\n    //             });\r\n\r\n    //       } else {\r\n    //         alert('Payment not successful');\r\n    //       }\r\n    //       closePaymentModal(); // this will close the modal programmatically\r\n    //     },\r\n    //     onClose: (response) => {\r\n    //       if (response === true){\r\n    //         console.log(response);\r\n    //         //Payment has been cancelled\r\n    //         fetch(\"https://grazacacademy.com/graduate/register\", {\r\n    //           method: \"POST\",\r\n    //           headers: {\r\n    //             \"Content-Type\": \"application/json\",\r\n    //           },\r\n    //           body: JSON.stringify({\r\n    //             firstname: firstname,\r\n    //             lastname: lastname,\r\n    //             email: email,\r\n    //             phone: phone,\r\n    //             course: course,\r\n    //             paymentPlan:paymentPlan,\r\n    //             tuition: amount,\r\n    //             expectation: message,\r\n    //             status:\"Attempted Payment\"\r\n    //           }),\r\n    //         })\r\n    //           .then((resp) => resp.json())\r\n    //           .then((data) => {\r\n    //             console.log(data);\r\n    //             if (data.success === true) {\r\n    //               console.log('user cancelled and data is recorded')\r\n    //             } \r\n    //           })\r\n    //           .catch((err) => {\r\n    //             console.log(err)\r\n    //           });\r\n    //         }\r\n    //     },\r\n    //   });\r\n    // } else {\r\n    //   alert(\"Please select a course\");\r\n    // }\r\n  };\r\n  \r\n  const handlePhone = (e) => {\r\n    setPhone(e.target.value.slice(0, 11));\r\n  }\r\n\r\n  return (\r\n    <div>\r\n      <Navbar />\r\n      <div>\r\n        <div className=\"contact_layer\">\r\n          <div className=\"form_top\">\r\n            <div>\r\n              <h1>Grazac Academy Graduate Accelerator</h1>\r\n              <p>\r\n                We are bridging the gap between unemployment and entry-level\r\n                jobs in the technology industry.\r\n              </p>\r\n            </div>\r\n          </div>\r\n          <div className=\"container\" ref={formInfo}>\r\n            <div className=\"form\">\r\n              <form onSubmit={onSubmit}>\r\n                <div className=\"form-flexdiv\">\r\n                  <div className=\"form-flexdiv-1\">\r\n                    <label>\r\n                      First Name <span>*</span>\r\n                    </label>\r\n                    <input\r\n                      className=\"input\"\r\n                      type=\"text\"\r\n                      placeholder=\"ex. John\"\r\n                      value={firstname}\r\n                      onChange={(e) => setFirstName(e.target.value)}\r\n                      required=\"required\"\r\n                    />\r\n                  </div>\r\n                  <div className=\"form-flexdiv-2\">\r\n                    <label>\r\n                      Last Name <span>*</span>\r\n                    </label>\r\n                    <input\r\n                      className=\"input\"\r\n                      type=\"text\"\r\n                      placeholder=\"ex. Doe\"\r\n                      value={lastname}\r\n                      onChange={(e) => setLastName(e.target.value)}\r\n                      required=\"required\"\r\n                    />\r\n                  </div>\r\n                </div>\r\n                <div className=\"form-flexdiv\">\r\n                  <div className=\"form-flexdiv-1\">\r\n                    <label>\r\n                      Mobile Number <span>*</span>\r\n                    </label>\r\n                    <input\r\n                      className=\"input\"\r\n                      type=\"number\"\r\n                      placeholder=\"ex. 08133333333\"\r\n                      value={phone}\r\n                      onChange={handlePhone}\r\n                      required=\"required\"\r\n                    />\r\n                  </div>\r\n                  <div className=\"form-flexdiv-2\">\r\n                    <label>\r\n                      Email <span>*</span>\r\n                    </label>\r\n                    <input\r\n                      className=\"input\"\r\n                      type=\"text\"\r\n                      placeholder=\"ex. john@gmail.com\"\r\n                      value={email}\r\n                      onChange={(e) => setEmail(e.target.value)}\r\n                      required=\"required\"\r\n                    />\r\n                  </div>\r\n                </div>\r\n                <div>\r\n                  <label>\r\n                    Our classes will be on Monday, Wednesdays and Fridays, will\r\n                    you be available? <span>*</span>\r\n                  </label>\r\n                  <br />\r\n                  <label>\r\n                    <input\r\n                      type=\"radio\"\r\n                      className=\"radio-input\"\r\n                      id=\"yes\"\r\n                      name=\"availability\"\r\n                      value=\"1\"\r\n                      required=\"required\"\r\n                      checked={availability === \"1\"}\r\n                      onChange={(e) => setAvailability(e.target.value)}\r\n                    />\r\n                    Yes\r\n                  </label>\r\n                  <label>\r\n                    <input\r\n                      type=\"radio\"\r\n                      className=\"radio-input\"\r\n                      id=\"no\"\r\n                      name=\"availability\"\r\n                      value=\"0\"\r\n                      required=\"required\"\r\n                      checked={availability === \"0\"}\r\n                      onChange={(e) => setAvailability(e.target.value)}\r\n                      style={{ marginLeft: \"30px\" }}\r\n                    />\r\n                    No\r\n                  </label>\r\n                </div>\r\n                <div>\r\n                  <label>\r\n                    Kindly choose your preferred course <span>*</span>\r\n                  </label>\r\n                  <br />\r\n                  <select\r\n                    className=\"input\"\r\n                    onChange={courseChange}\r\n                    required=\"required\"\r\n                  >\r\n                    <option value=\"\">---Choose course---</option>\r\n                    {fetchCourses.map((item, index) => (\r\n                      <option key={index} data-index={index}>\r\n                        {item.name}\r\n                      </option>\r\n                    ))}\r\n                  </select>\r\n                </div>\r\n                {showPayment && (\r\n                  <div>\r\n                    <label>\r\n                      Kindly choose your preferred payment plan <span>*</span>\r\n                    </label>\r\n                    <br />\r\n                    <select\r\n                      className=\"input\"\r\n                      onChange={choosePlan}\r\n                      required=\"required\"\r\n                    >\r\n                      <option value=\"\">---Choose Plan---</option>\r\n                      <option value=\"full\">Full Payment</option>\r\n                      <option value=\"installmental\">Installmental Payment</option>\r\n                      {/* <option value=\"monthly\">Monthly Payment</option> */}\r\n                    </select>\r\n                  </div>\r\n                )}\r\n                <div>\r\n                  <label>Amount</label>\r\n                  <br />\r\n                  <p className=\"show-amount\">\r\n                    ₦{amount ? new Intl.NumberFormat().format(amount) : \"0\"}\r\n                  </p>\r\n                </div>\r\n                {/* <div>\r\n                  <label>\r\n                    Kindly select a package. Our Part-time students have on-site\r\n                    classes only on Saturdays.{\" \"}\r\n                  </label>\r\n                  <br />\r\n                  <label>\r\n                    <input\r\n                      type=\"radio\"\r\n                      className=\"radio-input\"\r\n                      id=\"full-time\"\r\n                      name=\"plan\"\r\n                      value=\"full-time\"\r\n                      checked={plan === \"full-time\"}\r\n                      onChange={(e) => setPlan(e.target.value)}\r\n                      required=\"required\"\r\n                    />\r\n                    Full time\r\n                  </label>\r\n                  <label>\r\n                    <input\r\n                      type=\"radio\"\r\n                      className=\"radio-input\"\r\n                      id=\"part-time\"\r\n                      name=\"plan\"\r\n                      value=\"part-time\"\r\n                      checked={plan === \"part-time\"}\r\n                      onChange={(e) => setPlan(e.target.value)}\r\n                      style={{ marginLeft: \"30px\" }}\r\n                      required=\"required\"\r\n                    />\r\n                    Part time\r\n                  </label>\r\n                </div> */}\r\n                <div>\r\n                  <label>\r\n                    What do you expect at the end of this training?{\" \"}\r\n                    <span>*</span>\r\n                  </label>\r\n                  <textarea\r\n                    type=\"text\"\r\n                    placeholder=\"Say something ...\"\r\n                    value={message}\r\n                    onChange={(e) => setMessage(e.target.value)}\r\n                    required=\"required\"\r\n                  />\r\n                </div>\r\n                <div>\r\n                  <p>\r\n                  <strong>Note:</strong> Intending corps member who are yet to be fully posted to Ogun State are advised to think twice as we currently don't offer refunds and we run physical classes\r\n                  </p>\r\n                </div>\r\n                <div className=\"form-info\">\r\n                  Note: Fields with <span>*</span> are required\r\n                </div>\r\n                <div className=\"form-privacy\">\r\n                  <button\r\n                    className=\"download-brochure\"\r\n                    type=\"submit\"\r\n                    id=\"submit-btn\"\r\n                  >\r\n                    Register\r\n                  </button>\r\n                </div>\r\n              </form>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <Footer />\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default GraduateForm;\r\n","C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\pages\\Hire.js",[],"C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\pages\\InternshipForm.js",["261","262"],"import { useEffect, useRef, useState } from \"react\";\r\nimport { useFlutterwave, closePaymentModal } from 'flutterwave-react-v3';\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\n\r\nconst InternshipForm = () => {\r\n  const [firstname, setFirstName] = useState(\"\");\r\n  const [lastname, setLastName] = useState(\"\");\r\n  const [phone, setPhone] = useState(\"\");\r\n  const [email, setEmail] = useState(\"\");\r\n  const [availability, setAvailability] = useState(\"\");\r\n  const [amount, setAmount] = useState(40000);\r\n  const [course, setCourse] = useState(\"\");\r\n  const [message, setMessage] = useState(\"\");\r\n  const [fetchCourses, setFetched] = useState([]);\r\n  const formInfo = useRef();\r\n\r\n  useEffect(() => {\r\n    document.title = \"Internship Application - Grazac Academy\";\r\n    window.scrollTo(0, 0);\r\n    fetch(\"https://grazacacademy.com/graduate/courses\")\r\n      .then((resp) => resp.json())\r\n      .then((resp) => {\r\n        setFetched(resp.data);\r\n      })\r\n      .catch((error) => {\r\n        console.log(\r\n          \"An error occurred when fetching course details, refreshing...\"\r\n        );\r\n        window.location.reload();\r\n      });\r\n  }, []);\r\n\r\n  const config = {\r\n    public_key: 'FLWPUBK-006bdc82ad878f1518af32f44af6478f-X',\r\n    tx_ref: Date.now(),\r\n    amount: amount,\r\n    currency: 'NGN',\r\n    payment_options: 'card,mobilemoney,ussd',\r\n    customer: {\r\n      email: email,\r\n      phonenumber: phone,\r\n      name: firstname + \" \" + lastname,\r\n    },\r\n    customizations: {\r\n      title: 'Grazac Internship',\r\n      description: `Payment for ${course} at Grazac Internship`,\r\n      logo: 'https://grazac.com.ng/assets/images/favicon.png',\r\n    },\r\n  };\r\n\r\n  const handleFlutterPayment = useFlutterwave(config);\r\n\r\n  const onSubmit = (e) => {\r\n    e.preventDefault();\r\n    if ( availability === \"1\" ) {\r\n      var elmnt = document.getElementById(\"form_top\");\r\n      elmnt.scrollIntoView();\r\n      //window.scroll(0, formInfo.current.offsetTop);\r\n      handleFlutterPayment({\r\n        callback: (response) => {\r\n            if (response.status === 'successful') {\r\n\r\n              document.querySelector(\".form-info\").textContent = \"Submitting, please wait...\";\r\n              document\r\n                .querySelector(\"#submit-btn\")\r\n                .setAttribute(\"disabled\", \"disabled\");\r\n              fetch(\"https://grazacacademy.com/undergraduate/intern\", {\r\n                method: \"POST\",\r\n                headers: {\r\n                  \"Content-Type\": \"application/json\",\r\n                },\r\n                body: JSON.stringify({\r\n                  firstname: firstname,\r\n                  lastname: lastname,\r\n                  email: email,\r\n                  phone: phone,\r\n                  course: course,\r\n                  expectation: message,\r\n                  transaction_id: response.transaction_id\r\n                })\r\n              })\r\n              .then((resp) => resp.json())\r\n              .then((data) => {\r\n                if (data.success === true) {\r\n                  document.querySelector(\".form-info\").textContent = \"Your registration was successful, kindly check your mailbox for further details\";\r\n                  document.querySelector(\"#submit-btn\").removeAttribute(\"disabled\");\r\n                  setFirstName(\"\");\r\n                  setLastName(\"\");\r\n                  setMessage(\"\");\r\n                  setPhone(\"\");\r\n                  setEmail(\"\");\r\n                  setCourse(\"\");\r\n                } else {\r\n                  document.querySelector(\".form-info\").textContent = data.msg;\r\n                  document.querySelector(\"#submit-btn\").removeAttribute(\"disabled\");\r\n                }\r\n              })\r\n              .catch((err) => {\r\n                document.querySelector(\".form-info\").textContent = `Your payment was successful but something wrong while saving your details. \r\n                Kindly mail us at hello@grazacacademy.com`;\r\n                document.querySelector(\"#submit-btn\").removeAttribute(\"disabled\");\r\n              })\r\n\r\n            };\r\n            closePaymentModal() // this will close the modal programmatically\r\n        },\r\n        onClose: () => {\r\n\r\n        },\r\n      });\r\n    } else {\r\n      alert(\"You have to be available to register\");\r\n    }\r\n  };\r\n\r\n  return (\r\n    <div>\r\n      <Navbar />\r\n      <div>\r\n        <div className=\"contact_layer\">\r\n          <div className=\"form_top\" id=\"form_top\">\r\n            <div>\r\n              <h1>Grazac Internships.</h1>\r\n              <p>\r\n                We are bridging the gap between unemployment and entry-level\r\n                jobs in the technology industry.\r\n              </p>\r\n            </div>\r\n          </div>\r\n          <div className=\"container\" ref={formInfo}>\r\n            <div className=\"form\">\r\n              <form onSubmit={onSubmit}>\r\n                <div className=\"form-info\">\r\n                  Note: Fields with <span>*</span> are required\r\n                </div>\r\n                <div className=\"form-flexdiv\">\r\n                  <div className=\"form-flexdiv-1\">\r\n                    <label>\r\n                      First Name <span>*</span>\r\n                    </label>\r\n                    <input\r\n                      className=\"input\"\r\n                      type=\"text\"\r\n                      placeholder=\"ex. John\"\r\n                      value={firstname}\r\n                      onChange={(e) => setFirstName(e.target.value)}\r\n                      required=\"required\"\r\n                    />\r\n                  </div>\r\n                  <div className=\"form-flexdiv-2\">\r\n                    <label>\r\n                      Last Name <span>*</span>\r\n                    </label>\r\n                    <input\r\n                      className=\"input\"\r\n                      type=\"text\"\r\n                      placeholder=\"ex. Doe\"\r\n                      value={lastname}\r\n                      onChange={(e) => setLastName(e.target.value)}\r\n                      required=\"required\"\r\n                    />\r\n                  </div>\r\n                </div>\r\n                <div className=\"form-flexdiv\">\r\n                  <div className=\"form-flexdiv-1\">\r\n                    <label>\r\n                      Mobile Number <span>*</span>\r\n                    </label>\r\n                    <input\r\n                      className=\"input\"\r\n                      type=\"text\"\r\n                      placeholder=\"ex. 08133333333\"\r\n                      value={phone}\r\n                      onChange={(e) => setPhone(e.target.value)}\r\n                      required=\"required\"\r\n                      pattern=\".{11}\"\r\n                      title=\"Phone number is invalid\"\r\n                    />\r\n                  </div>\r\n                  <div className=\"form-flexdiv-2\">\r\n                    <label>\r\n                      Email <span>*</span>\r\n                    </label>\r\n                    <input\r\n                      className=\"input\"\r\n                      type=\"email\"\r\n                      placeholder=\"ex. john@example.com\"\r\n                      value={email}\r\n                      onChange={(e) => setEmail(e.target.value)}\r\n                      required=\"required\"\r\n                    />\r\n                  </div>\r\n                </div>\r\n                <div>\r\n                  <label>\r\n                    Our classes will be on Tuesdays and Thursdays, will you be\r\n                    available? <span>*</span>\r\n                  </label>\r\n                  <br />\r\n                  <label>\r\n                    <input\r\n                      type=\"radio\"\r\n                      className=\"radio-input\"\r\n                      id=\"yes\"\r\n                      name=\"availability\"\r\n                      value=\"1\"\r\n                      required=\"required\"\r\n                      checked={availability === \"1\"}\r\n                      onChange={(e) => setAvailability(e.target.value)}\r\n                    />\r\n                    Yes\r\n                  </label>\r\n                  <label>\r\n                    <input\r\n                      type=\"radio\"\r\n                      className=\"radio-input\"\r\n                      id=\"no\"\r\n                      name=\"availability\"\r\n                      value=\"0\"\r\n                      required=\"required\"\r\n                      checked={availability === \"0\"}\r\n                      onChange={(e) => setAvailability(e.target.value)}\r\n                      style={{ marginLeft: \"30px\" }}\r\n                    />\r\n                    No\r\n                  </label>\r\n                </div>\r\n                <div>\r\n                  <label>Course</label>\r\n                  <br />\r\n                  <p className=\"show-amount\">\r\n                    Website Development\r\n                  </p>\r\n                </div>\r\n                <div>\r\n                  <label>Amount</label>\r\n                  <br />\r\n                  <p className=\"show-amount\">\r\n                    ₦{new Intl.NumberFormat().format(amount)}\r\n                  </p>\r\n                </div>\r\n\r\n                <div>\r\n                  <label>\r\n                    What do you expect at the end of this training?{\" \"}\r\n                    <span>*</span>\r\n                  </label>\r\n                  <textarea\r\n                    type=\"text\"\r\n                    placeholder=\"Say something ...\"\r\n                    value={message}\r\n                    onChange={(e) => setMessage(e.target.value)}\r\n                    required=\"required\"\r\n                  />\r\n                </div>\r\n                <div className=\"form-privacy\">\r\n                  <button\r\n                    className=\"download-brochure\"\r\n                    type=\"submit\"\r\n                    id=\"submit-btn\"\r\n                  >\r\n                    Register\r\n                  </button>\r\n                </div>\r\n              </form>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <Footer />\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default InternshipForm;\r\n","C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\pages\\Faq.js",[],"C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\pages\\Profile.js",["263","264"],"import React from \"react\";\r\nimport {Link} from \"react-router-dom\";\r\nimport { Container, Row, Col } from \"react-bootstrap\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport Mode from \"../components/Mode\";\r\n\r\nimport project from \"../images/project.png\";\r\nimport student from \"../images/student.png\";\r\nimport back from \"../images/svg/arrow-back.svg\";\r\n\r\nconst Profile = () => {\r\n  React.useEffect(() => {\r\n    document.title = \"Profile - Grazac Academy\";\r\n    window.scrollTo(0, 0);\r\n  }, []);\r\n\r\n\r\n  return (\r\n    <div>\r\n      <Navbar/>\r\n        <div className=\"hire_profile_hero\">\r\n          <Container>\r\n            <Row>\r\n              <Col sm={6}>\r\n                <div className=\"hire_profile\">\r\n                  <div>\r\n                    <div className=\"hire_profile-text1\">\r\n                      <img src={back} />\r\n                      <h5>STUDENT PROFILE</h5>\r\n                    </div>\r\n                    <h3>Samuel Peter</h3>\r\n                    <p>Product Designer at Grazac</p>\r\n                    <h5>COURSE TAKEN</h5>\r\n                    <p>Product Designing (UI/UX)</p>\r\n                    <h5>KEY SKILLS LEARNT</h5>\r\n                    <p>\r\n                      <ul>\r\n                        <li>Responsive web designs </li>\r\n                        <li>Responsive web designs</li>\r\n                        <li>Responsive web designs</li>\r\n                        <li>Responsive web designs</li>\r\n                        <li>Responsive web designs</li>\r\n                      </ul>\r\n                    </p>\r\n                    <div className=\"contact_hero-privacy\" style={{marginBottom:'50px'}}>\r\n                        <a className=\"download-brochure\">\r\n                          Download CV\r\n                        </a>\r\n                        <Link to=\"/lead\">\r\n                          <button>Contact</button>\r\n                        </Link>\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n              </Col>\r\n              <Col sm={6}>\r\n                  <div className=\"hire_profile-image\">\r\n                    <img\r\n                      src={student}\r\n                      alt=\"student\"\r\n                      className=\"\"\r\n                    />\r\n                  </div>\r\n              </Col>\r\n            </Row>\r\n          </Container>\r\n        </div>\r\n\r\n\r\n        <div style={{boxSizing:'border-box', margin:'80px 0'}}>\r\n          <Container>\r\n            <h3>Projects</h3>\r\n            <Row>\r\n              <Col md={6}>\r\n                <div className=\"hire_dev\">\r\n                  <div className=\"hire_dev-picture\">\r\n                    <img src={project} alt=\"profile\" />\r\n                  </div>\r\n                  <h4>Project Name 1</h4>\r\n                  <p className=\"hire_dev-grey\">A brief, clear and consise description of the project been worked by each of the students.</p>\r\n                  <p className=\"hire_dev-purple\">View Project</p>\r\n                </div>\r\n              </Col>\r\n              <Col md={6}>\r\n                <div className=\"hire_dev\">\r\n                  <div className=\"hire_dev-picture\">\r\n                    <img src={project} alt=\"profile\" />\r\n                  </div>\r\n                  <h4>Project Name 1</h4>\r\n                  <p className=\"hire_dev-grey\">A brief, clear and consise description of the project been worked by each of the students.</p>\r\n                  <p className=\"hire_dev-purple\">View Project</p>\r\n                </div>\r\n              </Col>\r\n            </Row>\r\n          </Container>\r\n 