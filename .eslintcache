} alt=\"course-desc\" />\r\n                            </div>\r\n                            <div className=\"gua_cardview-text\">\r\n                                <p>Web Development</p>\r\n                                <h4>Frontend Development</h4>\r\n                                <p>This course helps you accelerate your career into Data Analytics. Learn Structured Query Language and Power BI for Data Analytics and Visualization.</p>\r\n                                <Link to=\"/course-detail\"><a>Learn More</a></Link>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"boxes33\">\r\n                        <div className=\"gua_cardview\">\r\n                            <div className=\"gua_cardview-box\">\r\n                                <img src={backend} alt=\"course-desc\" />\r\n                            </div>\r\n                            <div className=\"gua_cardview-text\">\r\n                                <p>Web Development</p>\r\n                                <h4>Bankend Development</h4>\r\n                                <p>This course helps you accelerate your career into Data Analytics. Learn Structured Query Language and Power BI for Data Analytics and Visualization.</p>\r\n                                <Link to=\"/course-detail\"><a>Learn More</a></Link>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"boxes33\">\r\n                        <div className=\"gua_cardview\">\r\n                            <div className=\"gua_cardview-box\">\r\n                                <img src={android} alt=\"course-desc\" />\r\n                            </div>\r\n                            <div className=\"gua_cardview-text\">\r\n                                <p>Mobile Application</p>\r\n                                <h4>Android Development</h4>\r\n                                <p>This course helps you accelerate your career into Data Analytics. Learn Structured Query Language and Power BI for Data Analytics and Visualization.</p>\r\n                                <Link to=\"/course-detail\"><a>Learn More</a></Link>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"boxes33\">\r\n                        <div className=\"gua_cardview\">\r\n                            <div className=\"gua_cardview-box\">\r\n                                <img src={brandidentity} alt=\"course-desc\" />\r\n                            </div>\r\n                            <div className=\"gua_cardview-text\">\r\n                                <p>Design</p>\r\n                                <h4>Brand Identity Design</h4>\r\n                                <p>This course helps you accelerate your career into Data Analytics. Learn Structured Query Language and Power BI for Data Analytics and Visualization.</p>\r\n                                <Link to=\"/course-detail\"><a>Learn More</a></Link>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"boxes33\">\r\n                        <div className=\"gua_cardview\">\r\n                            <div className=\"gua_cardview-box\">\r\n                                <img src={digitalmarketing} alt=\"course-desc\" />\r\n                            </div>\r\n                            <div className=\"gua_cardview-text\">\r\n                                <p>Marketing</p>\r\n                                <h4>Digital Marketing</h4>\r\n                                <p>This course helps you accelerate your career into Data Analytics. Learn Structured Query Language and Power BI for Data Analytics and Visualization.</p>\r\n                                <Link to=\"/course-detail\"><a>Learn More</a></Link>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"boxes33\">\r\n                        <div className=\"gua_cardview\">\r\n                            <div className=\"gua_cardview-box\">\r\n                                <img src={projectmanagement} alt=\"course-desc\" />\r\n                            </div>\r\n                            <div className=\"gua_cardview-text\">\r\n                                <p>Management</p>\r\n                                <h4>Project Management</h4>\r\n                                <p>This course helps you accelerate your career into Data Analytics. Learn Structured Query Language and Power BI for Data Analytics and Visualization.</p>\r\n                                <Link to=\"/course-detail\"><a>Learn More</a></Link>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default PopularCourses;","C:\\Users\\USER\\Desktop\\Web Development\\Bitbucket\\grazac-academy\\src\\components\\PrimaryBtn.js",[],"C:\\Users\\USER\\Desktop\\Web Development\\Bitbucket\\grazac-academy\\src\\components\\Navbar.js",["181","182","183"],"import { useEffect, useState, useRef } from \"react\";\r\nimport { cn } from \"../utils\";\r\nimport NavItem from \"./NavItem\";\r\nimport logo from \"../images/svg/grazac-logo.svg\";\r\nimport { Link } from \"react-router-dom\";\r\n\r\nconst Navbar = () => {\r\n  const [fixed, setFixed] = useState(false);\r\n  const [active, setActive] = useState(false);\r\n  const [hover, setHover] = useState(false);\r\n  const nav = useRef(null);\r\n\r\n  useEffect(() => {\r\n    if (nav.current && window.pageYOffset > nav.current.offsetTop)\r\n      setFixed(true);\r\n    else setFixed(false);\r\n    window.addEventListener(\"scroll\", () => {\r\n      if (nav.current && window.pageYOffset > nav.current.offsetTop)\r\n        setFixed(true);\r\n      else setFixed(false);\r\n    });\r\n  });\r\n\r\n  const handleClick = (e) => {\r\n    e.preventDefault();\r\n\r\n    if (active) setActive(false);\r\n    else setActive(true);\r\n  };\r\n\r\n  return (\r\n    <nav className={cn(\"nav\", { \"nav--fixed\": fixed })} ref={nav}>\r\n      <div className=\"nav__container\">\r\n        <div className=\"nav__logo\">\r\n          <Link to=\"/\">\r\n            <img src={logo} alt=\"logo\" />\r\n          </Link>\r\n        </div>\r\n\r\n        <div className={cn(\"nav__menu\", { \"nav__menu--active\": active })}>\r\n          <button className=\"nav-tgl\" onClick={handleClick}>\r\n            <span>&nbsp;</span>\r\n          </button>\r\n\r\n          <ul className=\"nav__list--mb\">\r\n            <li className=\"nav__item\">\r\n              <NavItem exact link=\"/\">\r\n              <span>01</span>Home\r\n              </NavItem>\r\n            </li>\r\n            <li className=\"nav__item\">\r\n              <NavItem link=\"/about-us\"><span>02</span>About</NavItem>\r\n            </li>\r\n            <li className=\"nav__item\">\r\n              <NavItem link=\"/undergraduate-accelerator-plan\"><span>03</span>Undergraduate</NavItem>\r\n            </li>\r\n            <li className=\"nav__item\">\r\n              <NavItem link=\"/graduate-accelerator-plan\"><span>04</span>Graduate</NavItem>\r\n            </li>\r\n            <li className=\"nav__item\">\r\n              <a href=\"/#tracks\">\r\n                <button onClick={() => setActive(false)}>Enroll Now</button>\r\n              </a>\r\n            </li>\r\n          </ul>\r\n        </div>\r\n\r\n        <ul className=\"nav__list\" style={{ marginBottom: 0 }}>\r\n          <li className=\"nav__item\">\r\n            <NavItem exact link=\"/\">\r\n              Home\r\n            </NavItem>\r\n          </li>\r\n          <li className=\"nav__item\">\r\n            <NavItem link=\