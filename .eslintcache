.36592 6.46241 2.41267 5.50916 2.41267 4.3333C2.41267 3.15743 3.36592 2.20419 4.54178 2.20419C5.71764 2.20419 6.67089 3.15743 6.67089 4.3333C6.67089 5.50916 5.7177 6.46241 4.54178 6.46241ZM17.901 17.3117C17.901 17.5791 17.6843 17.7958 17.417 17.7958H15.012C14.7447 17.7958 14.528 17.5791 14.528 17.3117V12.905C14.528 12.2476 14.7208 10.0243 12.81 10.0243C11.3279 10.0243 11.0272 11.5461 10.9669 12.2291V17.3117C10.9669 17.5791 10.7502 17.7958 10.4828 17.7958H8.15681C7.88948 17.7958 7.67272 17.5791 7.67272 17.3117V7.83209C7.67272 7.56476 7.88948 7.34801 8.15681 7.34801H10.4828C10.7501 7.34801 10.9669 7.56476 10.9669 7.83209V8.65173C11.5164 7.82696 12.3332 7.19037 14.0722 7.19037C17.9231 7.19037 17.901 10.7881 17.901 12.7648V17.3117Z\" fill=\"#0077B7\"/>\r\n              </svg>\r\n\r\n              Linkedln\r\n            </Link>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default Login;","C:\\Users\\'Toyosi Adekanmbi\\Desktop\\grazac-academy-web\\src\\pages\\Contact.js",["120"],"import React from \"react\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport PrimaryBtn from \"../components/PrimaryBtn\";\r\n\r\nimport Facebook from \"../images/svg/facebook.svg\";\r\nimport Instagram from \"../images/svg/instagram.svg\";\r\nimport Twitter from \"../images/svg/twitter.svg\";\r\nimport Youtube from \"../images/svg/youtube.svg\";\r\nimport kamala from \"../images/kamala.jpg\";\r\n\r\n//name\r\n//\r\n\r\nconst Contact = () => {\r\n    return(\r\n        <div>\r\n            <Navbar/>\r\n            <div className=\"contact\">\r\n                <div className=\"contact_layer\">\r\n                    <div className=\"container\">\r\n                        <div className=\"contact_layer-text\">\r\n                            <h1>Get In Touch</h1>\r\n                            <p>We want to hear from you. Let us know how we can help</p>\r\n                        </div>\r\n                        <div classname=\"contact_layer-circles\">\r\n                            <img src={kamala} alt=\"kamala\"  classname=\"contact_layer-circles-1\" />\r\n                            <img src={kamala} alt=\"kamala\"  classname=\"contact_layer-circles-2\" />\r\n                            <img src={kamala} alt=\"kamala\"  classname=\"contact_layer-circles-3\" />\r\n                            <img src={kamala} alt=\"kamala\"  classname=\"contact_layer-circles-4\" />\r\n                        </div>\r\n                        <div className=\"contact_hero\">\r\n                            <div className=\"contact_hero-flexdiv\">\r\n                                <div className=\"contact_hero-flexdiv-1\" >\r\n                                    <label>Full Name  <span>*</span></label>\r\n                                    <input type=\"text\" placeholder=\"ex. John Doe\" />\r\n                                </div>\r\n                                <div className=\"contact_hero-flexdiv-2\">\r\n                                    <label>Mail  <span>*</span></label>\r\n                                    <input type=\"text\" placeholder=\"ex. john@gmail.com\" />\r\n                                </div>\r\n                            </div>\r\n                            <div>\r\n                                <label>Select a Subject  <span>*</span></label>\r\n                                <input  type=\"text\" placeholder=\"ex. John Doe\" />\r\n                            </div>\r\n                            <div>\r\n                                <label>Message  <span>*</span></label>\r\n                                <textarea  type=\"text\" placeholder=\"Describe your task for us\" />\r\n                            </div>\r\n                            <div className=\"contact_hero-privacy\" >\r\n                                <p>By submitting this form your consent to us emailing you occasionally about our products and services. You can unsubscribe from emails at any time, and we will never pass your email onto third parties. <span>Privacy Policy</span></p>\r\n                                <button>Explore Courses</button>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"container\">\r\n                    <div className=\"contact_campus\">\r\n                        <div className=\"contact_campus-intro\">\r\n                            <h4>What we do</h4>\r\n                            <h2>Campus Inquiries</h2>\r\n                            <p>Connect with Us</p>\r\n                        </div>\r\n                        <div className=\"contact_campus-main\">\r\n                            <div className=\"contact_campus-main-div boxes33\">\r\n                                <h3>Office</h3>\r\n                                <p>PROHUB, Salawu Olabode Avenue, Ewang Road, </p>\r\n                                <p>Idi-aba, 110124, Abeokuta</p>\r\n                                <p>0906 133 3395</p>\r\n                            </div>\r\n                            <div className=\"contact_campus-main-div boxes33\">\r\n                                <h3>Book A Call</h3>\r\n                                <p>We are here to help with any questions. </p>\r\n                                <p>Talk to our programme leads.</p>\r\n                                <div style={{display:'flex'}}>\r\n                                    <PrimaryBtn>Book A Call</PrimaryBtn>\r\n                                </div>\r\n                            </div>\r\n                            <div className=\"contact_campus-main-div boxes33\">\r\n                                <h3>Social Media</h3>\r\n                                <div className=\"social\">\r\n                                    <img src={Facebook} alt=\"social\"/>\r\n                                </div>\r\n                                <div className=\"social\">\r\n                                    <img src={Twitter} alt=\"social\"/>\r\n                                </div>\r\n                                <div className=\"social\">\r\n                                    <img src={Youtube} alt=\"social\"/>\r\n                                </div>\r\n                                <div className=\"social\">\r\n                                    <img src={Instagram} alt=\"social\"/>\r\n                                </div>\r\n                            </div>\r\n\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div>\r\n                    <iframe width=\"100%\" height=\"600\" frameborder=\"0\" scrolling=\"no\" marginheight=\"0\" marginwidth=\"0\" id=\"gmap_canvas\" src=\"https://maps.google.com/maps?width=520&amp;height=400&amp;hl=en&amp;q=PROHUB,%20Salawu%20Olabode%20Avenue,%20Ewang%20Road,%20Idi-aba,%20110124,%20Abeokuta%20Abeokuta+(Grazac%20Office)&amp;t=&amp;z=15&amp;ie=UTF8&amp;iwloc=B&amp;output=embed\"></iframe>\r\n                </div>\r\n                {/*<extracomponent/> a component used in the landing page comes here*/}\r\n            </div>\r\n            <Footer/>\r\n        </div>\r\n    );\r\n}\r\n\r\nexport default Contact;","C:\\Users\\'Toyosi Adekanmbi\\Desktop\\grazac-academy-web\\src\\pages\\GraduateAccelerator.js",[],"C:\\Users\\'Toyosi Adekanmbi\\Desktop\\grazac-academy-web\\src\\pages\\UndergraduateAccelerator.js",[],"C:\\Users\\'Toyosi Adekanmbi\\Desktop\\grazac-academy-web\\src\\pages\\CourseDetail.js",[],"C:\\Users\\'Toyosi Adekanmbi\\Desktop\\grazac-academy-web\\src\\utils.js",[],"C:\\Users\\'Toyosi Adekanmbi\\Desktop\\grazac-academy-web\\src\\components\\Footer.js",[],"C:\\Users\\'Toyosi Adekanmbi\\Desktop\\grazac-academy-web\\src\\components\\PrimaryBtn.js",[],"C:\\Users\\'Toyosi Adekanmbi\\Desktop\\grazac-academy-web\\src\\components\\Navbar.js",["121","122"],"C:\\Users\\'Toyosi Adekanm