etails;\r\n","C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\academy-dashboard\\component\\carousel\\Carousel.jsx",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\academy-dashboard\\icons\\SettingsIcon.jsx",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\academy-dashboard\\icons\\ChallengeIcon.jsx",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\academy-dashboard\\icons\\PortfolioIcon.jsx",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\academy-dashboard\\icons\\PaymentIcon.jsx",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\academy-dashboard\\icons\\DashboardIcon.jsx",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\academy-dashboard\\component\\challenge\\challenges\\ChallengeProgress.jsx",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\academy-dashboard\\component\\shared\\profilecard\\ProfileCard.jsx",["442"],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\academy-dashboard\\component\\challenge\\challenges\\challengecard\\LockedChallenge.jsx",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\academy-dashboard\\component\\shared\\cohortcard\\CohortCard.jsx",["443","444","445","446"],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\academy-dashboard\\component\\challenge\\challenges\\challengetext\\ChallengeText.jsx",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\academy-dashboard\\component\\challenge\\challenges\\challengecard\\ChallengeCard.jsx",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\components\\dashboard\\not-submitted\\AdmissionFeePage.jsx",["447","448","449","450"],"import React, { useState, useRef } from \"react\";\r\nimport termsandconds from \"../../../content/TermsandCondition.pdf\";\r\nimport {\r\n  useFlutterwave,\r\n  FlutterWaveButton,\r\n  closePaymentModal,\r\n} from \"flutterwave-react-v3\";\r\n\r\nfunction AdmissionFeePage({ details, fname, lname, email, phone }) {\r\n  const [checkAct, setCheckAct] = useState(false);\r\n  const buttonRef = useRef();\r\n\r\n  // test: \"FLWPUBK_TEST-b6c44d3213f2d2b3c0c3142f3ab81b72-X\",\r\n  // public_key: \"FLWPUBK-006bdc82ad878f1518af32f44af6478f-X\",\r\n\r\n  const AdmissionFeeFlutterwaveConfig = {\r\n    public_key: \"FLWPUBK-006bdc82ad878f1518af32f44af6478f-X\",\r\n    tx_ref: Date.now(),\r\n    amount: 15000,\r\n    currency: \"NGN\",\r\n    payment_options: \"card,mobilemoney,ussd\",\r\n    customer: {\r\n      email: `${details.email}`,\r\n      phonenumber: `${details.phone}`,\r\n      name: `${details.firstName} ${details.lastName}`,\r\n    },\r\n\r\n    customizations: {\r\n      title: \"Grazac Academy\",\r\n      description: \"Admission Fee Payment\",\r\n      logo: \"https://grazac.com.ng/assets/images/favicon.png\",\r\n    },\r\n  };\r\n\r\n  const HandleAdmissionPayFlutterPayment = useFlutterwave(\r\n    AdmissionFeeFlutterwaveConfig\r\n  );\r\n\r\n  const confirmCheck = () => {\r\n    var check = document.getElementById(\"check\");\r\n    if (check.checked) {\r\n      setCheckAct(true);\r\n    } else {\r\n      setCheckAct(false);\r\n    }\r\n  };\r\n\r\n  return (\r\n    <div>\r\n      <h3>Hello {fname}</h3>\r\n      <h4>Welcome to Grazac Academy</h4>\r\n      <p>We can’t wait to help you kickstart your career in tech!</p>\r\n\r\n      <p>\r\n        To start your application, you are required to pay a non-refundable fee\r\n        of 15,000 naira only.\r\n      </p>\r\n\r\n      <p>\r\n        As part of your registration process, assessment and interview will be\r\n        conducted, the schedule will be communicated to you via your registered\r\n        email address within 7 days after payment of the registration fee.\r\n        Please note that It is important that you do not miss the assessment\r\n        interview. Kindly check your email regularly for updates.\r\n      </p>\r\n\r\n      <p>We look forward to being a part of your growth.</p>\r\n\r\n      <button\r\n        className={\"button\"}\r\n        ref={buttonRef}\r\n        onClick={() => {\r\n          HandleAdmissionPayFlutterPayment({\r\n            callback: (response) => {\r\n              console.log(response.status);\r\n              closePaymentModal(); // this will close the modal programmatically\r\n              window.location = \"/login\";\r\n            },\r\n            onClose: () => {\r\n              window.location = \"/login\";\r\n            },\r\n          });\r\n        }}\r\n      >\r\n        Proceed To Pay\r\n      </button>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default AdmissionFeePage;\r\n","C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\utils.js",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\components\\NavItem.js",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\components\\InfoModal.js",["451"],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\api\\dashboard\\apikit.js",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\components\\dashboard\\not-submitted\\index.js",["452","453","454","455","456","457","458","459"],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\academy-dashboard\\component\\dashboard\\Progress\\Progress.jsx",["460","461"],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\academy-dashboard\\component\\dashboard\\Learning\\LearningProgress.jsx",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\academy-dashboard\\icons\\DropDown.jsx",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\academy-dashboard\\component\\shared\\textcomponent\\TextComponent.jsx",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\academy-dashboard\\component\\shared\\button\\Button.jsx",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\pages\\newsletterModal\\newsletterModal.js",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\pages\\newsletterModal\\newsForm\\newsform.js",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\pages\\newsletterModal\\newsRe