 13.7519ZM27.5 15C27.5 8.12 21.9112 2.5225 15.035 2.5025C15.03 2.5025 15.025 2.50125 15.0188 2.50125C15.0138 2.50125 15.0063 2.5 15 2.5C8.1075 2.5 2.5 8.10875 2.5 15C2.5 21.8925 8.1075 27.5 15 27.5C15.0075 27.5 15.0138 27.4988 15.0188 27.4988C15.0213 27.4988 15.0225 27.5 15.025 27.5C15.0288 27.5 15.0325 27.4975 15.035 27.4975C21.9112 27.4788 27.5 21.88 27.5 15Z\"\r\n                            fill=\"white\"\r\n                          />\r\n                        </mask>\r\n                      </svg>\r\n                    </div>\r\n                    <h3>Job Placement</h3>\r\n                    <p>\r\n                      Enter the recruitment process with tech companies and take\r\n                      a stride into your dream career.{\" \"}\r\n                    </p>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <div className=\"background1\" id=\"courses\">\r\n            <div className=\"container\">\r\n              <div className=\"gga\">\r\n                <div className=\"course_mode-intro course_mode-intro\">\r\n                  <h2>Available Courses</h2>\r\n                </div>\r\n                <div className=\"gga_container\">\r\n                  {courses.length ? (\r\n                    courses.map((item, index) => (\r\n                      <Link\r\n                        to={`/course-detail-graduate?course=${item.slug}`}\r\n                        className=\"boxes33\"\r\n                        key={index}\r\n                      >\r\n                        <div className=\"gua_cardview\">\r\n                          <div className=\"gua_cardview-box\">\r\n                            <img src={item.thumb} alt=\"course-desc\" />\r\n                          </div>\r\n                          <div className=\"gua_cardview-text\">\r\n                            <h4 style={{ color: \"rgb(51, 51, 51)\" }}>\r\n                              {item.name}\r\n                            </h4>\r\n                            <p>{item.description}</p>\r\n                            <Link\r\n                              to={\"/course-detail-graduate?course=\" + item.slug}\r\n                            >\r\n                            Learn More\r\n                            </Link>\r\n                          </div>\r\n                        </div>\r\n                      </Link>\r\n                    ))\r\n                  ) : (\r\n                    <div>\r\n                      {/* <img src={loader} alt=\"loader\" className=\"loader\" /> */}\r\n                    </div>\r\n                  )}\r\n                  <div className=\"boxes33\">\r\n                    <div className=\"gua_cardview\">\r\n                      <div className=\"gua_cardview-text\">\r\n                        <h4>Can't find a course you are interested in?</h4>\r\n                        <p>\r\n                          We will be glad if you can suggest the course you'd\r\n                          love to learn.\r\n                        </p>\r\n                        <Link to=\"/contact\">\r\n                          <a>Contact Us</a>\r\n                        </Link>\r\n                      </div>\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <Qualities />\r\n          <NeedAdvice />\r\n        </div>\r\n        <Footer />\r\n      </div>\r\n      ) : (\r\n          <Loader />\r\n      )}\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default GraduateAccelerator;\r\n","C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\pages\\AboutUs.js",["237"],"import { useEffect, useContext } from \"react\";\r\n// import { Link } from \"react-router-dom\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport Mode from \"../components/Mode\";\r\nimport Dots from \"../images/svg/dots.svg\";\r\nimport { LoaderContext } from \"../context\";\r\nconst cardsInfo = [\r\n  {\r\n    color: \"39,234,198\",\r\n    title: \"Creativity\",\r\n    body:\r\n      \"We constantly develop ideas that drives innovation. Our company is a community that allow us share common interests and ideas.\",\r\n  },\r\n  {\r\n    color: \"26,222,235\",\r\n    title: \"Quality\",\r\n    body:\r\n      \"We strive to provide value that fulfils and exceeds expectation. We have an unwavering guide that leads the way to fulfilling your goal.\",\r\n  },\r\n  {\r\n    color: \"108,21,250\",\r\n    title: \"Passion\",\r\n    body:\r\n      \"Our enthusiasm to deliver the best makes us unique. We uphold the highest standards in deliverability.\",\r\n  },\r\n  {\r\n    color: \"255,113,155\",\r\n    title: \"Commitment\",\r\n    body:\r\n      \"We are focused on giving best solutions. Our concern is solving your problem rather than why or how the problem was created.\",\r\n  },\r\n  {\r\n    color: \"254,125,108\",\r\n    title: \"Collaboration\",\r\n    body:\r\n      \"Our success depends upon the collective intelligence of our team members and the shared vision of our partners.\",\r\n  },\r\n  {\r\n    color: \"255,180,67\",\r\n    title: \"Teamwork\",\r\n    body:\r\n      \"We do better, together. Our environment fosters progress, effectiveness and speed.\",\r\n  },\r\n];\r\n\r\nconst AboutUs = () => {\r\n  const { setShow } = useContext(LoaderContext);\r\n  useEffect(() => {\r\n    document.title = \"About - Grazac Academy\";\r\n    window.scrollTo(0, 0);\r\n   \r\n  }, []);\r\n\r\n  return (\r\n    <div className=\"about\">\r\n      <Navbar />\r\n      <div className=\"about__top\">\r\n        <div className=\"about__top--container\">\r\n          <div className=\"about__top--up\">\r\n            <div>\r\n              <img src={Dots} alt=\"dots\" />\r\n            </div>\r\n            <div></div>\r\n            <div className=\"about__top--text\">\r\n              <h1>About Us</h1>\r\n              <p>\r\n                At Grazac Academy, we provide you with the right platform to\r\n                upskill yourself for the future.\r\n              </p>\r\n            </div>\r\n          </div>\r\n          <div className=\"about__top--down\">\r\n            <div></div>\r\n            <div></div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <div className=\"about__middle\">\r\n        <div className=\"about__middle--container\">\r\n          <div className=\"about__middle--head\">\r\n            <h2>Our Core Values</h2>\r\n            <p>\r\n              You determine the starting points, we provide the best possible\r\n              interception to achieve the goals.\r\n            </p>\r\n          </div>\r\n\r\n          <div className=\"about__middle--cards\">\r\n            {cardsInfo.map((item) => (\r\n              <div className=\"about__middle--card\">\r\n                <div style={{ \"--bg-color\": item.color }}></div>\r\n                <h3>{item.title}</h3>\r\n                <p>{item.body}</p>\r\n              </div>\r\n            ))}\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <Mode />\r\n      <Footer />\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default AboutUs;\r\n","C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\pages\\UndergraduateCourseDetail.js",["238","239"],"import React, { useState, useEffect } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport PrimaryBtn from \"../components/PrimaryBtn\";\r\nimport MOT from \"../components/MOT\";\r\nimport Loader from \"../components/Loader\";\r\n\r\nimport paper from \"../images/svg/paper-ribbon.svg\";\r\n\r\nconst ErrorModal = (props) => {\r\n  return (\r\n    <div className=\"modal3__bg\" onClick={() => props.setShowModal(false)}>\r\n      <div className=\"modal3__content modal3__content--err\">\r\n        <div className=\"modal3__content--head\">\r\n          <div>&nbsp;</div>\r\n          <svg className=\"modal3__content--svg\" viewBox=\"0 0 10 10\" fill=\"none\">\r\n            <path\r\n              d=\"M4.94263 4.00008L7.80451 1.13814C8.06516 0.877482 8.06516 0.456157 7.80451 0.195496C7.54385 -0.0651653 7.12254 -0.0651653 6.86188 0.195496L4 3.05744L1.13812 0.195496C0.877463 -0.0651653 0.456148 -0.0651653 0.195492 0.195496C-0.065164 0.456157 -0.065164 0.877482 0.195492 1.13814L3.05737 4.00008L0.195492 6.86202C-0.065164 7.12269 -0.065164 7.54401 0.195492 7.80467C0.325486 7.93467 0.496146 8 0.666806 8C0.837465 8 1.00812 7.93467 1.13812 7.80467L4 4.94273L6.86188 7.80467C6.99188 7.93467 7.16254 8 7.33319 8C7.50385 8 7.67451 7.93467 7.80451 7.80467C8.06516 7.54401 8.06516 7.12269 7.80451 6.86202L4.94263 4.00008Z\"\r\n              fill=\"#073041\"\r\n            />\r\n          </svg>\r\n        </div>\r\n\r\n        <div className=\"modal3__content--body\">\r\n          <h1>Oops...</h1>\r\n          Sorry :( but you can no longer enroll for this course because it is no\r\n          longer available.\r\n          <br />\r\n          <br />\r\n          Check by later.\r\n        </div>\r\n      </div>\r\n    </div>\r\n  );\r\n};\r\n\r\nconst CourseDetail = (props) => {\r\n  const [course, setCourse] = useState(\"\");\r\n  const [outline, setOutline] = useState([]);\r\n  const [showModal, setShowModal] = useState(false);\r\n\r\n  useEffect(() => {\r\n    document.title = \"Course Details - Grazac Academy\";\r\n    window.scrollTo(0, 0);\r\n  \r\n    const slug = props.location.search.substring(8);\r\n    fetch(`https://grazacacademy.com/undergraduate/course/details/${slug}`)\r\n      .then((resp) => resp.json())\r\n      .then((resp) => {\r\n        setCourse(resp.data);\r\n        setOutline(JSON.parse(resp.data.outline));\r\n      })\r\n      .catch(() => {\r\n        console.log(\r\n          \"An error occurred when fetching course details, refreshing...\"\r\n        );\r\n        window.location.reload();\r\n      });\r\n  }, [props.location.search]);\r\n\r\n  const toggleModal = (e) => {\r\n    e.preventDefault();\r\n    showModal ? setShowModal(false) : setShowModal(true);\r\n  };\r\n\r\n  return (\r\n    <div>\r\n      {outline.length ? (\r\n        <div id=\"blur\">\r\n        <Navbar />\r\n        <div className=\"course\">\r\n          <div className=\"course_hero\">\r\n            <div className=\"container\">\r\n              {course ? (\r\n                <div className=\"row\">\r\n                  <div className=\"col-sm-6\">\r\n                    <div className=\"course_hero-text\">\r\n                      <div className=\"course_hero-text-b\">\r\n                        <h1>{course.name}</h1>\r\n                        <p>{course.description}</p>\r\n                        <div className=\"contact_hero-privacy\">\r\n                          <a\r\n                            href={course.brochure}\r\n                            target=\"_blank\"\r\n                            rel=\"noreferrer\"\r\n                            className=\"download-brochure\"\r\n                          >\r\n                            Download Brochure\r\n                          </a>\r\n                          <Link to=\"/undergraduate-form\">\r\n                            <button>Enroll now</button>\r\n                          </Link>\r\n                        </div>\r\n                      </div>\r\n                    </div>\r\n                  </div>\r\n                  <div>\r\n                    {/* <img src={paper} alt=\"academy\" className=\"gga_hero-image\" /> */}\r\n                  </div>\r\n                </div>\r\n              ) : (\r\n                <div>\r\n                {/*<img src={loader} alt=\"loader\" className=\"loader\" />*/}\r\n                </div>\r\n              )}\r\n            </div>\r\n          </div>\r\n          <div className=\"course_learn\">\r\n            <div className=\"container\">\r\n              <div className=\"course_wwd-intro\">\r\n                <h4>GRAZAC ACADEMY</h4>\r\n                <h2>What you'll Learn</h2>\r\n              </div>\r\n              <div className=\"course_learn-main\">\r\n                {outline.length ? (\r\n                  outline.map((item, index) => (\r\n                    <div key={index}>\r\n                      <div className=\"course_learn-main-list\">\r\n                        <div className=\"box1\">\r\n                          <h3>{index < 10 ? \"0\" + index : index}</h3>\r\n                        </div>\r\n                        <div className=\"box2\">\r\n                          <h3>{item.topic}</h3>\r\n                        </div>\r\n                        <div className=\"box3\">\r\n                          <p>{item.summary}</p>\r\n                        </div>\r\n                      </div>\r\n                      <hr />\r\n                    </div>\r\n                  ))\r\n                ) : (\r\n                  <div>\r\n                    {/*<img src={loader} alt=\"loader\" className=\"loader\" />*/}\r\n                  </div>\r\n                )}\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <MOT />\r\n          <div className=\"course_purple\">\r\n            <div className=\"course_purple_txt\">\r\n              <p>Pricing</p>\r\n              <h1>100%</h1>\r\n              <p>Discount Available</p>\r\n            </div>\r\n            <div className=\"course_purple-main\">\r\n              <div className=\"course_purple-main-boxes grad-box\">\r\n                <h4>Tuition</h4>\r\n                <h2>FREE</h2>\r\n              </div>\r\n              <div className=\"course_purple-main-boxes grad-box\">\r\n                <h4>Note</h4>\r\n                <p>\r\n                  <span>\r\n                    You are required to pay a sum of ₦10,000 for your certificate\r\n                    and to ensure we secure a befitting environment to aid your\r\n                    learning.{\" \"}\r\n                  </span>\r\n                </p>\r\n              </div>\r\n            </div>\r\n            <div className=\"course_purple-btn\">\r\n              <PrimaryBtn link=\"/undergraduate-form\">Enroll Now</PrimaryBtn>\r\n              <a href=\"tel:+234806 836 5951\" style={{marginTop:\"7px\"}}>\r\n                <p>Talk to course rep</p>\r\n              </a>\r\n            </div>\r\n          </div>\r\n        </div>\r\n        <Footer />\r\n  \r\n        {showModal && <ErrorModal setShowModal={setShowModal} />}\r\n      </div>\r\n  \r\n      ) : (\r\n          <Loader />\r\n      )}\r\n    </div>\r\n  );\r\n\r\n};\r\n\r\nexport default CourseDetail;\r\n","C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\pages\\Landing.js",["240","241","242"],"import { useEffect, useState, useContext } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { Accordion, Card } from \"react-bootstrap\";\r\n// import { cn } from \"../utils\";\r\nimport { MdKeyboardArrowDown } from \"react-icons/md\";\r\nimport Slider from \"infinite-react-carousel\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport Mode from \"../components/Mode\";\r\nimport PrimaryBtn from \"../components/PrimaryBtn\";\r\n\r\nimport Abdullahi from \"../images/testimonial/abdullahi.jpeg\";\r\nimport Adedamola from \"../images/testimonial/adedamola.jpeg\";\r\nimport Bosun from \"../images/testimonial/bosun.jpg\";\r\nimport Grazac from \"../images/svg/logo-round.svg\";\r\nimport Video from \"../images/landing-video2.mp4\";\r\nimport Object from \"../images/svg/objects.svg\";\r\nimport poster from \"../images/Grazac-website/IMG_8403.JPG\";\r\n\r\nimport badge from \"../images/svg/badge.svg\";\r\nimport ex from \"../images/svg/x-mark.svg\";\r\nimport Sponsor1 from \"../images/svg/Apple.svg\";\r\nimport Sponsor2 from \"../images/svg/AWS.svg\";\r\nimport Sponsor3 from \"../images/svg/Flutterwave.svg\";\r\nimport Sponsor5 from \"../images/svg/Microsoft.svg\";\r\nimport Sponsor6 from \"../images/svg/Google.svg\";\r\n\r\nimport Card1 from \"../images/svg/card1.svg\";\r\nimport Card2 from \"../images/svg/card2.svg\";\r\n\r\nimport { LoaderContext } from \"../context\";\r\n\r\nconst Landing = () => {\r\n  const [showModal, setShowModal] = useState(true);\r\n  const { setShow, show } = useContext(LoaderContext);\r\n  useEffect(() => {\r\n    document.title = \"Welcome to Grazac Academy\";\r\n    let mediaPlayer = document.querySelector(\"#video\");\r\n    mediaPlayer.controls = false;\r\n    mediaPlayer.play();\r\n\r\n    //this gives the homepage spacing on top for the notification\r\n    var landingHeight = document.getElementsByClassName(\"landing\")[0];\r\n    landingHeight.style.marginTop = `80px`;\r\n\r\n    window.addEventListener(\"load\", () => {\r\n    \r\n      setShow(false)\r\n    });\r\n  }, []);\r\n\r\n  const content = [\r\n    {\r\n      id: 0,\r\n      img: Bosun,\r\n      content:\r\n        \"The future of work will be filled with so many opportunities we need to prepare for, I’ve known Grazac for a while and seen them in the business of helping people lay hold of these opportunities. Grazac Academy is an excellent starting point for anyone looking into building a career in technology.\",\r\n      name: \"Bosun Egberinde - Creator of PHPSandbox.io\",\r\n    },\r\n    {\r\n      id: 1,\r\n      img: Adedamola,\r\n      content:\r\n        \"I've known Grazac for over a year now and having worked with some of their successful students, I can boldly say the competency and problem solving skills of their students is top-notch and their academy is one of the best academy promoting technology skills acquisition here in Nigeria\",\r\n      name: \"Samson Adedamola - Consultant at Kudi\",\r\n    },\r\n    {\r\n      id: 2,\r\n      img: Abdullahi,\r\n      content:\r\n        \"I passed through Grazac Academy while I was in school and that's one of the best thing that happened to me as an undergraduate. I love how the facilitators mentored everyone of us up and I must say that, we got more value than we paid for.\",\r\n      name: \"Abdullahi Olaniyan - Software Developer at Global Accelerex\",\r\n    },\r\n  ];\r\n\r\n  const handleModal = () => {\r\n    setShowModal(false);\r\n    var landingHeight = document.getElementsByClassName(\"landing\")[0];\r\n    landingHeight.style.marginTop = `0px`;\r\n  };\r\n\r\n  const handleFaq = (e) => {\r\n    let svg = e.target.parentElement.querySelector(\"svg\");\r\n    if (e.target.nodeName === \"path\") {\r\n      svg = e.target.parentElement.parentElement.querySelector(\"svg\");\r\n    }\r\n    svg.classList.toggle(\"faq-icon_transition\");\r\n  };\r\n\r\n\r\n  return (\r\n    <div className=\"landing\">\r\n      {showModal && (\r\n        <div className=\"infomodal\">\r\n          <div className=\"infomodal_content\">\r\n            <img src={badge} alt=\"\" className=\"infomodal_badge\" />\r\n            <p>\r\n              Grazac Graduate Accelerator Program enrollment is opening by July\r\n              12th.\r\n              <a\r\n                className=\"infomodal_content-link\"\r\n                href=\"https://grazacacademy.com/graduate-accelerator-plan\"\r\n                f\r\n              >\r\n                Learn more\r\n              </a>\r\n            </p>\r\n            <Link to=\"/graduate-accelerator-plan\">\r\n              <button>Learn more</button>\r\n            </Link>\r\n            <img\r\n              src={ex}\r\n              alt=\"\"\r\n              onClick={handleModal}\r\n              style={{ cursor: \"pointer\" }}\r\n            />\r\n          </div>\r\n        </div>\r\n      )}\r\n      <div className=\"landing__header\">\r\n        <Navbar top={true} />\r\n        <img src={Object} className=\"bg-img\" alt=\"ccc\" />\r\n        <div style={{ height: 10 }}></div>\r\n\r\n        <div className=\"landing__text\">\r\n          <h1>\r\n            Upskilling You For The <span>Future</span> Of Work\r\n          </h1>\r\n          <p>\r\n            Learn valuable technology skills with us, we strongly believe the\r\n            future of work will be skill based. Join us to build a career in\r\n            tech and get tutored by industry leaders who will walk you through\r\n            the path of becoming highly valuable and employable{\" \"}\r\n          </p>\r\n        </div>\r\n        <a href=\"/#tracks\">\r\n          <div\r\n            className=\"nav__btn\"\r\n            style={{ width: \"130px\", margin: \"auto\", textAlign: \"center\" }}\r\n          >\r\n            <div className=\"nav__btn--text\">Get Started</div>\r\n          </div>\r\n        </a>\r\n      </div>\r\n\r\n      <div className=\"landing__video\">\r\n        <video\r\n          id=\"video\"\r\n          width=\"320\"\r\n          height=\"240\"\r\n          autoPlay\r\n          loop\r\n          muted\r\n          poster={poster}\r\n        >\r\n          <source src={Video} type=\"video/mp4\" />\r\n        </video>\r\n      </div>\r\n\r\n      <div className=\"landing__sponsors\">\r\n        <div className=\"landing__sponsors--container\">\r\n          <img src={Sponsor1} alt=\"sponsor\" />\r\n          <img src={Sponsor2} alt=\"sponsor\" />\r\n          <img src={Sponsor3} alt=\"sponsor\" />\r\n          <img src={Sponsor5} alt=\"sponsor\" />\r\n          <img src={Sponsor6} alt=\"sponsor\" />\r\n        </div>\r\n      </div>\r\n\r\n      <div className=\"landing__cards\" id=\"tracks\">\r\n        <div className=\"landing__cards--container\">\r\n          <div className=\"landing__bottom--text\">\r\n            <div className=\"landing__bottom--text--right\">\r\n              <h1>Get Ready To Grow With us </h1>\r\n            </div>\r\n          </div>\r\n\r\n          <div className=\"landing__card--box\">\r\n            <div className=\"landing__card landing__card--1\">\r\n              <img src={Card1} alt=\"illustration\" />\r\n              <h3>\r\n                <span>Graduate </span>\r\n                <br />\r\n                Accelerator Plan\r\n              </h3>\r\n              <p>\r\n                An immersive program that gives you the opportunity to build a\r\n                career and get a job in the tech industry.\r\n              </p>\r\n\r\n              <div className=\"landing__btn\">\r\n                <PrimaryBtn yellow link=\"/graduate-accelerator-plan\">\r\n                  Learn More\r\n                </PrimaryBtn>\r\n              </div>\r\n            </div>\r\n\r\n            <div className=\"landing__card landing__card--2\">\r\n              <img src={Card2} alt=\"illustration\" />\r\n              <h3>\r\n                <span>Undergraduate </span>\r\n                <br />\r\n                Accelerator Plan (FREE)\r\n              </h3>\r\n              <p>\r\n                Set the pace for a bright future as an undergraduate by\r\n                acquiring technology skills now.\r\n              </p>\r\n              <div className=\"landing__btn\">\r\n                <PrimaryBtn link=\"/undergraduate-accelerator-plan\">\r\n                  Learn More\r\n                </PrimaryBtn>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <div className=\"landing__intern\">\r\n        <div className=\"landing__intern--content\">\r\n          <div>&nbsp;</div>\r\n          <div className=\"landing__bottom--text landing__bottom--text-2\">\r\n            <div className=\"landing__intern--text\">\r\n              <h1>Tech is Vast. Let's help you with directions.</h1>\r\n              <p>\r\n                Are you looking to step into the field of tech but don't know\r\n                what to learn or how to begin? We can help you. Tech is a broad\r\n                field, and there are a lot of interesting pathways and\r\n                directions you can venture into. You need all the clarity you\r\n                can get so you can make informed decisions. Consult us for free\r\n              </p>\r\n              <div className=\"landing__btn--2\">\r\n                {/* <PrimaryBtn link=\"/\">Enroll Now</PrimaryBtn> */}\r\n                <a href=\"/#tracks\">\r\n                  <div className=\"nav__btn nav__btn-flex \">\r\n                    <a\r\n                      className=\"nav__btn--text\"\r\n                      href=\"tel:+2348068365951\"\r\n                      style={{ marginRight: \"20px\" }}\r\n                    >\r\n                      Call Us Now\r\n                    </a>\r\n                    <a href=\"https://wa.link/w8e0xs\">\r\n                      <div className=\"nav__btn--text1\">Chat With Us</div>\r\n                    </a>\r\n                  </div>\r\n                </a>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          {/* <div className=\"landing__intern--btn\">\r\n            <PrimaryBtn link=\"/internship\">Enroll Now</PrimaryBtn>\r\n          </div> */}\r\n        </div>\r\n      </div>\r\n\r\n      <div className=\"landing__discover\">\r\n        <div className=\"landing__bottom--text landing__bottom--text-2\">\r\n          <div className=\"landing__bottom--text--right\">\r\n            <h1>\r\n              We are trusted by entrepreneurs and hiring managers globally.\r\n            </h1>\r\n            <p>\r\n              We guarantee you impact driven candidates who will impact your\r\n              bottom lines positively.\r\n            </p>\r\n          </div>\r\n        </div>\r\n\r\n        <div className=\"landing__discover--container\">\r\n          <div className=\"landing__discover--images\">\r\n            <div className=\"landing__discover--images-left\">\r\n              <div></div>\r\n              <div></div>\r\n            </div>\r\n            <div className=\"landing__discover--images-right\">\r\n              <div></div>\r\n            </div>\r\n          </div>\r\n\r\n          <div className=\"landing__discover--list\">\r\n            <div className=\"landing__discover--list-item\">\r\n              <h2>01</h2>\r\n              <div>\r\n                <h3>Enroll</h3>\r\n                <p>\r\n                  Set yourself up for success by registering for any of our\r\n                  courses that fits your passion and career.\r\n                </p>\r\n              </div>\r\n            </div>\r\n\r\n            <div className=\"landing__discover--list-item\">\r\n              <h2>02</h2>\r\n              <div>\r\n                <h3>Learn</h3>\r\n                <p>\r\n                  Get trained by world class facilitators. We will provide you\r\n                  with the right mentorship, tools and content you need to be\r\n                  the best in your choosing career.\r\n                </p>\r\n              </div>\r\n            </div>\r\n\r\n            <div className=\"landing__discover--list-item\">\r\n              <h2>03</h2>\r\n              <div>\r\n                <h3>Get Hired</h3>\r\n                <p>\r\n                  Join the workforce of the future as you get connected with\r\n                  career coaches and potential employers.\r\n                </p>\r\n              </div>\r\n            </div>\r\n            <div className=\"landing__discover--list-item\"></div>\r\n            <div className=\"landing__discover--list-item\"></div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      {/* FAQ section commented out till content is ready */}\r\n      <div className=\"landing_faq\">\r\n        <div className=\"container\">\r\n          <h1>FAQs</h1>\r\n          <div>\r\n            <Accordion>\r\n              <Card>\r\n                <Accordion.Toggle as={Card.Header} eventKey=\"0\">\r\n                  <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                    <h4>What is Grazac Academy?</h4>\r\n                    <MdKeyboardArrowDown size=\"2rem\" color=\"black\" />\r\n                  </div>\r\n                </Accordion.Toggle>\r\n                <Accordion.Collapse eventKey=\"0\">\r\n                  <Card.Body>\r\n                    <div className=\"landing_faq-answer\">\r\n                      <p>\r\n                        Grazac Academy is closing the gap between youths and\r\n                        entry-level jobs in the technology industry. We strongly\r\n                        believe the job market for youths has changed and the\r\n                        future of work will be skill-based.\r\n                      </p>\r\n                      <p>We are approaching this in two ways:</p>\r\n                      <p>\r\n                        Grazac Academy Graduate Accelerator - This plan is for\r\n                        tertiary institutions graduates who have full time to\r\n                        build a career in tech. This plan has been arranged in a\r\n                        way to prepare them for work.\r\n                      </p>\r\n                      <p>\r\n                        Grazac Academy Undergraduate Accelerator - This plan is\r\n                        to equip undergraduates in their institutions, we\r\n                        believe the earlier the better and we want to prepare\r\n                        them for life after school by upskilling them while they\r\n                        are still in school.\r\n                      </p>\r\n                    </div>\r\n                  </Card.Body>\r\n                </Accordion.Collapse>\r\n              </Card>\r\n              <hr />\r\n              <Card>\r\n                <Accordion.Toggle as={Card.Header} eventKey=\"1\">\r\n                  <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                    <h4>When was the academy established?</h4>\r\n                    <MdKeyboardArrowDown size=\"2rem\" color=\"black\" />\r\n                  </div>\r\n                </Accordion.Toggle>\r\n                <Accordion.Collapse eventKey=\"1\">\r\n                  <Card.Body>\r\n                    <div className=\"landing_faq-answer\">\r\n                      <p>Grazac Academy has been in operation since 2018</p>\r\n                    </div>\r\n                  </Card.Body>\r\n                </Accordion.Collapse>\r\n              </Card>\r\n              <hr />\r\n              <Card>\r\n                <Accordion.Toggle as={Card.Header} eventKey=\"2\">\r\n                  <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                    <h4>How many students have graduated from your academy?</h4>\r\n                    <MdKeyboardArrowDown size=\"2rem\" color=\"black\" />\r\n                  </div>\r\n                </Accordion.Toggle>\r\n                <Accordion.Collapse eventKey=\"2\">\r\n                  <Card.Body>\r\n                    <div className=\"landing_faq-answer\">\r\n                      <p>\r\n                        Excluding our partnership with Haptics.ng in 2019 to\r\n                        execute Google project of upskilling Nigerians on\r\n                        Digital skills where we trained about 500 youths, we\r\n                        have impacted over 2,000 lives through our trainings,\r\n                        meetups and events.\r\n                      </p>\r\n                    </div>\r\n                  </Card.Body>\r\n                </Accordion.Collapse>\r\n              </Card>\r\n              <hr />\r\n              <Card>\r\n                <Accordion.Toggle as={Card.Header} eventKey=\"3\">\r\n                  <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                    <h4>Where is the academy located?</h4>\r\n                    <MdKeyboardArrowDown size=\"2rem\" color=\"black\" />\r\n                  </div>\r\n                </Accordion.Toggle>\r\n                <Accordion.Collapse eventKey=\"3\">\r\n                  <Card.Body>\r\n                    <div className=\"landing_faq-answer\">\r\n                      <p>\r\n                        Our headquarter is located at Abeokuta, Ogun State,\r\n                        Nigeria.\r\n                      </p>\r\n                      <p>\r\n                        Address: Suite 106, PROHUB, Salawu Olabode Avenue, Ewang\r\n                        Road, Idi-aba, Abeokuta.\r\n                      </p>\r\n                    </div>\r\n                  </Card.Body>\r\n                </Accordion.Collapse>\r\n              </Card>\r\n              <hr />\r\n              <Card>\r\n                <Accordion.Toggle as={Card.Header} eventKey=\"4\">\r\n                  <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                    <h4>How do I enroll in the academy?</h4>\r\n                    <MdKeyboardArrowDown size=\"2rem\" color=\"black\" />\r\n                  </div>\r\n                </Accordion.Toggle>\r\n                <Accordion.Collapse eventKey=\"4\">\r\n                  <Card.Body>\r\n                    <div className=\"landing_faq-answer\">\r\n                      <p>\r\n                        Visit{\" \"}\r\n                        <a href=\"https://www.grazacacademy.com\">\r\n                          www.grazacacademy.com\r\n                        </a>{\" \"}\r\n                        to enroll for your preferred course.\r\n                      </p>\r\n                    </div>\r\n                  </Card.Body>\r\n                </Accordion.Collapse>\r\n              </Card>\r\n              <hr />\r\n              <Card>\r\n                <Accordion.Toggle as={Card.Header} eventKey=\"5\">\r\n                  <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                    <h4>What are the payment options?</h4>\r\n                    <MdKeyboardArrowDown size=\"2rem\" color=\"black\" />\r\n                  </div>\r\n                </Accordion.Toggle>\r\n                <Accordion.Collapse eventKey=\"5\">\r\n                  <Card.Body>\r\n                    <div className=\"landing_faq-answer\">\r\n                      <p>\r\n                        We have three (2) payment options for our Gradaute\r\n                        Accelerator, you can either pay once or pay\r\n                        installmentally.\r\n                      </p>\r\n                    </div>\r\n                  </Card.Body>\r\n                </Accordion.Collapse>\r\n              </Card>\r\n            </Accordion>\r\n            <hr />\r\n            <Link to=\"/faq\">\r\n              <p className=\"landing_faq-link\">\r\n                More frequently asked questions\r\n              </p>\r\n            </Link>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <div className=\"landing__slider\">\r\n        <Slider arrows={true}  className=\"landing__slider-desktop\">\r\n          {/* {content.map((item) => (\r\n            <div className=\"landing__slider--container\" key={item.id}>\r\n              <div className=\"landing__slider--img\">\r\n                <img src={item.img} alt=\"img\" />\r\n              </div>\r\n\r\n              <div className=\"landing__slider--text\">\r\n                <svg\r\n                  width=\"30\"\r\n                  height=\"28\"\r\n                  viewBox=\"0 0 30 28\"\r\n                  fill=\"none\"\r\n                  xmlns=\"http://www.w3.org/2000/svg\"\r\n                >\r\n                  <path\r\n                    d=\"M12.3993 5.56001C13.1711 5.22699 13.4948 4.27918 13.1462 3.51069L11.9262 0.872185C11.5777 0.129562 10.7311 -0.203709 9.98417 0.129562C7.86782 1.05176 6.05026 2.25573 4.60616 3.71587C2.83839 5.43192 1.64328 7.4044 0.995927 9.5818C0.348574 11.7851 0 14.782 0 18.5988V26.4631C0 27.3084 0.672251 28.0001 1.49389 28.0001H11.2789C12.1005 28.0001 12.7728 27.3084 12.7728 26.4631V16.3958C12.7728 15.5502 12.1005 14.8588 11.2789 14.8588H6.59802C6.64781 12.2713 7.24537 10.1966 8.34089 8.63373C9.23722 7.37904 10.5817 6.35438 12.3993 5.56001Z\"\r\n                    fill=\"#4B004B\"\r\n                  />\r\n                  <path\r\n                    d=\"M29.1127 5.53403C29.8845 5.20102 30.2079 4.25321 29.8596 3.48471L28.6396 0.872082C28.291 0.129203 27.4445 -0.203812 26.6976 0.129203C24.6061 1.0514 22.8132 2.25537 21.3444 3.6899C19.5764 5.43182 18.3567 7.40429 17.7091 9.5817C17.0617 11.7332 16.7383 14.7306 16.7383 18.5731V26.4374C16.7383 27.2827 17.4105 27.9744 18.2322 27.9744H28.0172C28.8388 27.9744 29.511 27.2827 29.511 26.4374V16.3701C29.511 15.5245 28.8388 14.8331 28.0172 14.8331H23.3114C23.3612 12.2456 23.959 10.1709 25.0543 8.60801C25.9506 7.35306 27.2951 6.3284 29.1127 5.53403Z\"\r\n                    fill=\"#4B004B\"\r\n                  />\r\n                </svg>\r\n\r\n                <p>{item.content}</p>\r\n\r\n                <small>{item.name}</small>\r\n              </div>\r\n            </div>\r\n          ))} */}\r\n            <div className=\"landing__slider--container\" >\r\n              <div className=\"video-width\">\r\n                <iframe className=\"video-width\" src=\"https://www.youtube.com/embed/HQYKZ6RaZ6I\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen></iframe>\r\n              </div>\r\n              <div>\r\n                <iframe className=\"video-width\" src=\"https://www.youtube.com/embed/CVDQuO2KMCw\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen></iframe>\r\n              </div>\r\n            </div>\r\n            <div className=\"landing__slider--container\" >\r\n              <div className=\"video-width\">\r\n                <iframe className=\"video-width\" src=\"https://www.youtube.com/embed/yfP88Mr_Ixw\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen></iframe>\r\n              </div>\r\n              <div>\r\n                <iframe className=\"video-width\" src=\"https://www.youtube.com/embed/1KkiCbKrG-w\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen></iframe>\r\n              </div>\r\n            </div>\r\n        </Slider>\r\n        <div className=\"landing__slider-mobile\">\r\n            <iframe src=\"https://www.youtube.com/embed/HQYKZ6RaZ6I\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen></iframe>\r\n            <iframe src=\"https://www.youtube.com/embed/yfP88Mr_Ixw\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen></iframe>\r\n            <iframe src=\"https://www.youtube.com/embed/CVDQuO2KMCw\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen></iframe>\r\n        </div>\r\n      </div>\r\n\r\n      <div className=\"landing__bottom\" style={{ paddingBottom: 0 }}>\r\n        <div className=\"landing__bottom--text\">\r\n          <div className=\"landing__bottom--text--right\">\r\n            <h1>Get Upskilled For The Future Of Work</h1>\r\n            <p>\r\n              We will provide you with the tools, resources, facilities, content\r\n              and mentorship needed for your relevance in the future of work.\r\n            </p>\r\n            <div className=\"landing__btn--2\">\r\n              {/* <PrimaryBtn link=\"/\">Enroll Now</PrimaryBtn> */}\r\n              <a href=\"/#tracks\">\r\n                <div className=\"nav__btn nav__btn-flex \">\r\n                  <a className=\"nav__btn--text\" href=\"https://wa.link/w8e0xs\">\r\n                    Chat with Us\r\n                  </a>\r\n                </div>\r\n              </a>\r\n            </div>\r\n          </div>\r\n\r\n          <div className=\"landing__bottom--text--left\">\r\n            <img src={Grazac} alt=\"img\" />\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <Mode />\r\n      <Footer />\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default Landing;\r\n","C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\pages\\Contact.js",["243","244"],"import React, { useState, useEffect } from \"react\";\r\nimport axios from 'axios';\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport PrimaryBtn from \"../components/PrimaryBtn\";\r\n\r\nimport Facebook from \"../images/svg/facebook.svg\";\r\nimport Instagram from \"../images/svg/instagram.svg\";\r\nimport Twitter from \"../images/svg/twitter.svg\";\r\nimport Youtube from \"../images/svg/youtube.svg\";\r\n\r\nconst Contact = () => {\r\n\r\n    const [ name, setName ] = useState('');\r\n    const [ email, setEmail ] = useState('');\r\n    const [ subject, setSubject ] = useState('');\r\n    const [ message, setMessage ] = useState('');\r\n\r\n    useEffect(() => {\r\n        document.title = 'Contact - Grazac Academy';\r\n        window.scrollTo(0,0);\r\n    }, []);\r\n\r\n    const handleSubmit = () => {\r\n        if(name.length && email.length && subject.length && message.length) {\r\n            const btn = document.querySelector('#submit');\r\n            btn.setAttribute('disabled', '');\r\n            btn.textContent = 'Submitting...';\r\n            console.log('Submitted')\r\n            axios.post('http://grazacacademy.com/contact/create', {\r\n                name: name,\r\n                email: email,\r\n                subject: subject,\r\n                message: message\r\n            })\r\n            .then(resp => resp.data)\r\n            .then(response => {\r\n                if(response.success === true) {\r\n                    btn.removeAttribute('disabled');\r\n                    btn.textContent = 'Submit';\r\n                    alert(response.msg);\r\n                    setName(''); setEmail(''); setSubject(''); setMessage('');\r\n                } else {\r\n\r\n                }\r\n            })\r\n            .catch((err) => {\r\n                \r\n            });\r\n        } else {\r\n            alert('Invalid input');\r\n        }\r\n    }\r\n\r\n    return(\r\n        <div>\r\n            <Navbar/>\r\n            <div className=\"contact\">\r\n                <div className=\"contact_layer\">\r\n                    <div className=\"container\">\r\n                        <div className=\"contact_layer-text\">\r\n                            <h1>Get In Touch</h1>\r\n                            <p>We want to hear from you. Let us know how we can help</p>\r\n                        </div>\r\n                        {/*<div classname=\"contact_layer-circles\">\r\n                            <img src={kamala} alt=\"kamala\"  classname=\"contact_layer-circles-1\" />\r\n                            <img src={kamala} alt=\"kamala\"  classname=\"contact_layer-circles-2\" />\r\n                            <img src={kamala} alt=\"kamala\"  classname=\"contact_layer-circles-3\" />\r\n                            <img src={kamala} alt=\"kamala\"  classname=\"contact_layer-circles-4\" />\r\n                        </div>*/}\r\n                        <div className=\"contact_hero\">\r\n                            <div className=\"contact_hero-flexdiv\">\r\n                                <div className=\"contact_hero-flexdiv-1\" >\r\n                                    <label>Full Name  <span>*</span></label>\r\n                                    <input type=\"text\" placeholder=\"ex. John Doe\" value={name} onChange={e => setName(e.target.value)} />\r\n                                </div>\r\n                                <div className=\"contact_hero-flexdiv-2\">\r\n                                    <label>Email  <span>*</span></label>\r\n                                    <input type=\"text\" placeholder=\"ex. john@gmail.com\" value={email} onChange={e => setEmail(e.target.value)}  />\r\n                                </div>\r\n                            </div>\r\n                            <div>\r\n                                <label>Subject  <span>*</span></label>\r\n                                <input  type=\"text\" placeholder=\"ex. John Doe\" value={subject} onChange={e => setSubject(e.target.value)}  />\r\n                            </div>\r\n                            <div>\r\n                                <label>Message  <span>*</span></label>\r\n                                <textarea  type=\"text\" placeholder=\"Describe your task for us\" value={message} onChange={e => setMessage(e.target.value)}  />\r\n                            </div>\r\n                            <div className=\"contact_hero-privacy\" >\r\n                                <p>By submitting this form your consent to us emailing you occasionally about our products and services. You can unsubscribe from emails at any time, and we will never pass your email onto third parties. <span>Privacy Policy</span></p>\r\n                                <button id=\"submit\" onClick={handleSubmit}>Submit</button>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"container\">\r\n                    <div className=\"contact_campus\">\r\n                        <div className=\"contact_campus-intro\">\r\n                            <h2>Campus Inquiries</h2>\r\n                            <p>Connect with Us</p>\r\n                        </div>\r\n                        <div className=\"contact_campus-main\">\r\n                            <div className=\"contact_campus-main-div boxes33\">\r\n                                <h3>Office</h3>\r\n                                <p>PROHUB, Salawu Olabode Avenue, Ewang Road, </p>\r\n                                <p>Idi-aba, 110124, Abeokuta</p>\r\n                                <p>+234 806 836 5951</p>\r\n                            </div>\r\n                            <div className=\"contact_campus-main-div boxes33\">\r\n                                <h3>Book A Call</h3>\r\n                                <p>We are here to help with any questions. </p>\r\n                                <p>Talk to our programme leads.</p>\r\n                                <div style={{display:'flex'}}>\r\n                                    <a href=\"tel:+2348068365951\" ><div className=\"nav__btn--text\">Book a Call</div></a>\r\n                                </div>\r\n                            </div>\r\n                            <div className=\"contact_campus-main-div boxes33\">\r\n                                <h3>Social Media</h3>\r\n                                <div className=\"social\">\r\n                                    <img src={Facebook} alt=\"social\"/>\r\n                                </div>\r\n                                <div className=\"social\">\r\n                                    <img src={Twitter} alt=\"social\"/>\r\n                                </div>\r\n                                <div className=\"social\">\r\n                                    <img src={Youtube} alt=\"social\"/>\r\n                                </div>\r\n                                <div className=\"social\">\r\n                                    <img src={Instagram} alt=\"social\"/>\r\n                                </div>\r\n                            </div>\r\n\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div>\r\n                    <iframe src=\"https://www.google.com/maps/d/embed?mid=16NZ9a9VhKkk2-5nnYEdL93mxq7kjDZLT\" width=\"100%\" height=\"600\"></iframe>\r\n                </div>\r\n                {/*<extracomponent/> a component used in the landing page comes here*/}\r\n            </div>\r\n            <Footer/>\r\n        </div>\r\n    );\r\n}\r\n\r\nexport default Contact;","C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\pages\\GraduateCourseDetail.js",["245","246","247"],"C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\pages\\GraduateForm.js",["248","249","250","251","252","253"],"import { useEffect, useRef, useState } from \"react\";\r\nimport { useFlutterwave, closePaymentModal } from \"flutterwave-react-v3\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport axios from \"axios\";\r\n\r\nconst GraduateForm = () => {\r\n  const [firstname, setFirstName] = useState(\"\");\r\n  const [lastname, setLastName] = useState(\"\");\r\n  const [phone, setPhone] = useState(\"\");\r\n  const [email, setEmail] = useState(\"\");\r\n  const [availability, setAvailability] = useState(\"\");\r\n  const [amount, setAmount] = useState(\"\");\r\n  const [course, setCourse] = useState(\"\");\r\n  const [paymentPlan, setPaymentPlan] = useState(\"\");\r\n  const [message, setMessage] = useState(\"\");\r\n  const [txref, setTxref] = useState(\"\");\r\n  const [fetchCourses, setFetched] = useState([]);\r\n  const formInfo = useRef();\r\n  const [showPayment, setShowPayment] = useState(true);\r\n\r\n  useEffect(() => {\r\n    document.title = \"Join our Graduate Track - Grazac Academy\";\r\n    window.scrollTo(0, 0);\r\n    const method = window.location.search.substring(9);\r\n    if (method) {\r\n      setPaymentPlan(method);\r\n      setShowPayment(false);\r\n    }\r\n    fetch(\"https://grazacacademy.com/graduate/courses\")\r\n      .then((resp) => resp.json())\r\n      .then((resp) => {\r\n        setFetched(resp.data);\r\n      })\r\n      .catch((error) => {\r\n        console.log(\r\n          \"An error occurred when fetching course details, refreshing...\"\r\n        );\r\n        window.location.reload();\r\n      });\r\n  }, []);\r\n\r\n  const courseChange = (e) => {\r\n    setCourse(e.target.value);\r\n    var rc = e.target.options[e.target.selectedIndex].dataset.index;\r\n    setAmount(fetchCourses[rc].discounted_tuition);\r\n  };\r\n\r\n  const choosePlan = (e) => {\r\n    if(e.target.value === 'installmental') {\r\n      setAmount(40000);\r\n    } else if(e.target.value === 'monthly') {\r\n      setAmount(55000);\r\n    } else {\r\n      setAmount(75000);\r\n    }\r\n    setPaymentPlan(e.target.value);\r\n  };\r\n\r\n  const config = {\r\n    public_key: \"FLWPUBK-006bdc82ad878f1518af32f44af6478f-X\",\r\n    tx_ref: Date.now(),\r\n    amount: amount,\r\n    currency: \"NGN\",\r\n    payment_options: \"card,mobilemoney,ussd\",\r\n    customer: {\r\n      email: email,\r\n      phonenumber: phone,\r\n      name: firstname + \" \" + lastname,\r\n    },\r\n    customizations: {\r\n      title: \"Grazac Graduate Accelerator Plan\",\r\n      description: `Payment for ${course} at Grazac Graduate Accelerator Plan`,\r\n      logo: \"https://grazac.com.ng/assets/images/favicon.png\",\r\n    },\r\n  };\r\n\r\n  const handleFlutterPayment = useFlutterwave(config);\r\n\r\n  const onSubmit = (e) => {\r\n    e.preventDefault();\r\n    document.querySelector(\".form-info\").textContent = \"Enrollment is Currently Closed. Check Back Later\"; \r\n    document.querySelector(\"#submit-btn\").textContent = \"Registration closed!!!\"\r\n    // if (amount) {\r\n    //   handleFlutterPayment({\r\n    //     callback: (response) => {\r\n    //       if (response.status === \"successful\") {\r\n    //         setTxref(response.tx_ref);\r\n    //         //window.scroll(0, formInfo.current.offsetTop);\r\n    //         document.querySelector(\".form-info\").textContent =\r\n    //           \"Submitting, please wait...\";\r\n    //         document\r\n    //           .querySelector(\"#submit-btn\")\r\n    //           .setAttribute(\"disabled\", \"disabled\");\r\n    //         fetch(\"https://grazacacademy.com/graduate/register\", {\r\n    //           method: \"POST\",\r\n    //           headers: {\r\n    //             \"Content-Type\": \"application/json\",\r\n    //           },\r\n    //           body: JSON.stringify({\r\n    //             firstname: firstname,\r\n    //             lastname: lastname,\r\n    //             email: email,\r\n    //             phone: phone,\r\n    //             course: course,\r\n    //             paymentPlan: paymentPlan,\r\n    //             expectation: message,\r\n    //             tuition: amount,\r\n    //             tx_ref: txref,\r\n    //           }),\r\n    //         })\r\n    //           .then((resp) => resp.json())\r\n    //           .then((data) => {\r\n    //             if (data.success === true) {\r\n    //               document.querySelector(\".form-info\").textContent =\r\n    //                 \"Your registration was successful, kindly check your mailbox for further details\";\r\n    //               document.querySelector(\"#submit-btn\").removeAttribute(\"disabled\");\r\n    //               setFirstName(\"\");\r\n    //               setLastName(\"\");\r\n    //               setMessage(\"\");\r\n    //               setPhone(\"\");\r\n    //               setEmail(\"\");\r\n    //               setCourse(\"\");\r\n    //             } else {\r\n    //               document.querySelector(\".form-info\").textContent = data.msg;\r\n    //               document.querySelector(\"#submit-btn\").removeAttribute(\"disabled\");\r\n    //             }\r\n    //           })\r\n    //           .catch((err) => {\r\n    //             document.querySelector(\".form-info\").textContent =\r\n    //               \"Something went wrong, please try again\";\r\n    //             document.querySelector(\"#submit-btn\").removeAttribute(\"disabled\");\r\n    //           });\r\n\r\n    //           let formData = new FormData();\r\n    //           formData.append(\"name\", firstname);\r\n    //           formData.append(\"email\", email);\r\n    //           axios\r\n    //             .post(\"http://grazac.com.ng/newsletter/subscribe\", formData, {\r\n    //               headers: {\r\n    //                 \"Content-Type\": \"application/json\",\r\n    //               },\r\n    //             })\r\n    //             .then((resp) => resp.data)\r\n    //             .then((data) => {\r\n    //               if (data.success === true) {\r\n    //                 console.log(\"Added to newsletter\");\r\n    //               } else {\r\n    //                 console.log(\"Not Added to newsletter\");\r\n    //               }\r\n    //             })\r\n    //             .catch((err) => {\r\n    //               console.log(`An error occured, please try again ${err}`);\r\n    //             });\r\n\r\n    //       } else {\r\n    //         alert('Payment not successful');\r\n    //       }\r\n    //       closePaymentModal(); // this will close the modal programmatically\r\n    //     },\r\n    //     onClose: (response) => {\r\n    //       if (response === true){\r\n    //         console.log(response);\r\n    //         //Payment has been cancelled\r\n    //         fetch(\"https://grazacacademy.com/graduate/register\", {\r\n    //           method: \"POST\",\r\n    //           headers: {\r\n    //             \"Content-Type\": \"application/json\",\r\n    //           },\r\n    //           body: JSON.stringify({\r\n    //             firstname: firstname,\r\n    //             lastname: lastname,\r\n    //             email: email,\r\n    //             phone: phone,\r\n    //             course: course,\r\n    //             paymentPlan:paymentPlan,\r\n    //             tuition: amount,\r\n    //             expectation: message,\r\n    //             status:\"Attempted Payment\"\r\n    //           }),\r\n    //         })\r\n    //           .then((resp) => resp.json())\r\n    //           .then((data) => {\r\n    //             console.log(data);\r\n    //             if (data.success === true) {\r\n    //               console.log('user cancelled and data is recorded')\r\n    //             } \r\n    //           })\r\n    //           .catch((err) => {\r\n    //             console.log(err)\r\n    //           });\r\n    //         }\r\n    //     },\r\n    //   });\r\n    // } else {\r\n    //   alert(\"Please select a course\");\r\n    // }\r\n  };\r\n  \r\n  const handlePhone = (e) => {\r\n    setPhone(e.target.value.slice(0, 11));\r\n  }\r\n\r\n  return (\r\n    <div>\r\n      <Navbar />\r\n      <div>\r\n        <div className=\"contact_layer\">\r\n          <div className=\"form_top\">\r\n            <div>\r\n              <h1>Grazac Academy Graduate Accelerator</h1>\r\n              <p>\r\n                We are bridging the gap between unemployment and entry-level\r\n                jobs in the technology industry.\r\n              </p>\r\n            </div>\r\n          </div>\r\n          <div className=\"container\" ref={formInfo}>\r\n            <div className=\"form\">\r\n              <form onSubmit={onSubmit}>\r\n                <div className=\"form-flexdiv\">\r\n                  <div className=\"form-flexdiv-1\">\r\n                    <label>\r\n                      First Name <span>*</span>\r\n                    </label>\r\n                    <input\r\n                      className=\"input\"\r\n                      type=\"text\"\r\n                      placeholder=\"ex. John\"\r\n                      value={firstname}\r\n                      onChange={(e) => setFirstName(e.target.value)}\r\n                      required=\"required\"\r\n                    />\r\n                  </div>\r\n                  <div className=\"form-flexdiv-2\">\r\n                    <label>\r\n                      Last Name <span>*</span>\r\n                    </label>\r\n                    <input\r\n                      className=\"input\"\r\n                      type=\"text\"\r\n                      placeholder=\"ex. Doe\"\r\n                      value={lastname}\r\n                      onChange={(e) => setLastName(e.target.value)}\r\n                      required=\"required\"\r\n                    />\r\n                  </div>\r\n                </div>\r\n                <div className=\"form-flexdiv\">\r\n                  <div className=\"form-flexdiv-1\">\r\n                    <label>\r\n                      Mobile Number <span>*</span>\r\n                    </label>\r\n                    <input\r\n                      className=\"input\"\r\n                      type=\"number\"\r\n                      placeholder=\"ex. 08133333333\"\r\n                      value={phone}\r\n                      onChange={handlePhone}\r\n                      required=\"required\"\r\n                    />\r\n                  </div>\r\n                  <div className=\"form-flexdiv-2\">\r\n                    <label>\r\n                      Email <span>*</span>\r\n                    </label>\r\n                    <input\r\n                      className=\"input\"\r\n                      type=\"text\"\r\n                      placeholder=\"ex. john@gmail.com\"\r\n                      value={email}\r\n                      onChange={(e) => setEmail(e.target.value)}\r\n                      required=\"required\"\r\n                    />\r\n                  </div>\r\n                </div>\r\n                <div>\r\n                  <label>\r\n                    Our classes will be on Monday, Wednesdays and Fridays, will\r\n                    you be available? <span>*</span>\r\n                  </label>\r\n                  <br />\r\n                  <label>\r\n                    <input\r\n                      type=\"radio\"\r\n                      className=\"radio-input\"\r\n                      id=\"yes\"\r\n                      name=\"availability\"\r\n                      value=\"1\"\r\n                      required=\"required\"\r\n                      checked={availability === \"1\"}\r\n                      onChange={(e) => setAvailability(e.target.value)}\r\n                    />\r\n                    Yes\r\n                  </label>\r\n                  <label>\r\n                    <input\r\n                      type=\"radio\"\r\n                      className=\"radio-input\"\r\n                      id=\"no\"\r\n                      name=\"availability\"\r\n                      value=\"0\"\r\n                      required=\"required\"\r\n                      checked={availability === \"0\"}\r\n                      onChange={(e) => setAvailability(e.target.value)}\r\n                      style={{ marginLeft: \"30px\" }}\r\n                    />\r\n                    No\r\n                  </label>\r\n                </div>\r\n                <div>\r\n                  <label>\r\n                    Kindly choose your preferred course <span>*</span>\r\n                  </label>\r\n                  <br />\r\n                  <select\r\n                    className=\"input\"\r\n                    onChange={courseChange}\r\n                    required=\"required\"\r\n                  >\r\n                    <option value=\"\">---Choose course---</option>\r\n                    {fetchCourses.map((item, index) => (\r\n                      <option key={index} data-index={index}>\r\n                        {item.name}\r\n                      </option>\r\n                    ))}\r\n                  </select>\r\n                </div>\r\n                {showPayment && (\r\n                  <div>\r\n                    <label>\r\n                      Kindly choose your preferred payment plan <span>*</span>\r\n                    </label>\r\n                    <br />\r\n                    <select\r\n                      className=\"input\"\r\n                      onChange={choosePlan}\r\n                      required=\"required\"\r\n                    >\r\n                      <option value=\"\">---Choose Plan---</option>\r\n                      <option value=\"full\">Full Payment</option>\r\n                      <option value=\"installmental\">Installmental Payment</option>\r\n                      {/* <option value=\"monthly\">Monthly Payment</option> */}\r\n                    </select>\r\n                  </div>\r\n                )}\r\n                <div>\r\n                  <label>Amount</label>\r\n                  <br />\r\n                  <p className=\"show-amount\">\r\n                    ₦{amount ? new Intl.NumberFormat().format(amount) : \"0\"}\r\n                  </p>\r\n                </div>\r\n                {/* <div>\r\n                  <label>\r\n                    Kindly select a package. Our Part-time students have on-site\r\n                    classes only on Saturdays.{\" \"}\r\n                  </label>\r\n                  <br />\r\n                  <label>\r\n                    <input\r\n                      type=\"radio\"\r\n                      className=\"radio-input\"\r\n                      id=\"full-time\"\r\n                      name=\"plan\"\r\n                      value=\"full-time\"\r\n                      checked={plan === \"full-time\"}\r\n                      onChange={(e) => setPlan(e.target.value)}\r\n                      required=\"required\"\r\n                    />\r\n                    Full time\r\n                  </label>\r\n                  <label>\r\n                    <input\r\n                      type=\"radio\"\r\n                      className=\"radio-input\"\r\n                      id=\"part-time\"\r\n                      name=\"plan\"\r\n                      value=\"part-time\"\r\n                      checked={plan === \"part-time\"}\r\n                      onChange={(e) => setPlan(e.target.value)}\r\n                      style={{ marginLeft: \"30px\" }}\r\n                      required=\"required\"\r\n                    />\r\n                    Part time\r\n                  </label>\r\n                </div> */}\r\n                <div>\r\n                  <label>\r\n                    What do you expect at the end of this training?{\" \"}\r\n                    <span>*</span>\r\n                  </label>\r\n                  <textarea\r\n                    type=\"text\"\r\n                    placeholder=\"Say something ...\"\r\n                    value={message}\r\n                    onChange={(e) => setMessage(e.target.value)}\r\n                    required=\"required\"\r\n                  />\r\n                </div>\r\n                <div>\r\n                  <p>\r\n                  <strong>Note:</strong> Intending corps member who are yet to be fully posted to Ogun State are advised to think twice as we currently don't offer refunds and we run physical classes\r\n                  </p>\r\n                </div>\r\n                <div className=\"form-info\">\r\n                  Note: Fields with <span>*</span> are required\r\n                </div>\r\n                <div className=\"form-privacy\">\r\n                  <button\r\n                    className=\"download-brochure\"\r\n                    type=\"submit\"\r\n                    id=\"submit-btn\"\r\n                  >\r\n                    Register\r\n                  </button>\r\n                </div>\r\n              </form>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <Footer />\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default GraduateForm;\r\n","C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\pages\\Hire.js",[],"C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\pages\\InternshipForm.js",["254","255"],"import { useEffect, useRef, useState } from \"react\";\r\nimport { useFlutterwave, closePaymentModal } from 'flutterwave-react-v3';\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\n\r\nconst InternshipForm = () => {\r\n  const [firstname, setFirstName] = useState(\"\");\r\n  const [lastname, setLastName] = useState(\"\");\r\n  const [phone, setPhone] = useState(\"\");\r\n  const [email, setEmail] = useState(\"\");\r\n  const [availability, setAvailability] = useState(\"\");\r\n  const [amount, setAmount] = useState(40000);\r\n  const [course, setCourse] = useState(\"\");\r\n  const [message, setMessage] = useState(\"\");\r\n  const [fetchCourses, setFetched] = useState([]);\r\n  const formInfo = useRef();\r\n\r\n  useEffect(() => {\r\n    document.title = \"Internship Application - Grazac Academy\";\r\n    window.scrollTo(0, 0);\r\n    fetch(\"https://grazacacademy.com/graduate/courses\")\r\n      .then((resp) => resp.json())\r\n      .then((resp) => {\r\n        setFetched(resp.data);\r\n      })\r\n      .catch((error) => {\r\n        console.log(\r\n          \"An error occurred when fetching course details, refreshing...\"\r\n        );\r\n        window.location.reload();\r\n      });\r\n  }, []);\r\n\r\n  const config = {\r\n    public_key: 'FLWPUBK-006bdc82ad878f1518af32f44af6478f-X',\r\n    tx_ref: Date.now(),\r\n    amount: amount,\r\n    currency: 'NGN',\r\n    payment_options: 'card,mobilemoney,ussd',\r\n    customer: {\r\n      email: email,\r\n      phonenumber: phone,\r\n      name: firstname + \" \" + lastname,\r\n    },\r\n    customizations: {\r\n      title: 'Grazac Internship',\r\n      description: `Payment for ${course} at Grazac Internship`,\r\n      logo: 'https://grazac.com.ng/assets/images/favicon.png',\r\n    },\r\n  };\r\n\r\n  const handleFlutterPayment = useFlutterwave(config);\r\n\r\n  const onSubmit = (e) => {\r\n    e.preventDefault();\r\n    if ( availability === \"1\" ) {\r\n      var elmnt = document.getElementById(\"form_top\");\r\n      elmnt.scrollIntoView();\r\n      //window.scroll(0, formInfo.current.offsetTop);\r\n      handleFlutterPayment({\r\n        callback: (response) => {\r\n            if (response.status === 'successful') {\r\n\r\n              document.querySelector(\".form-info\").textContent = \"Submitting, please wait...\";\r\n              document\r\n                .querySelector(\"#submit-btn\")\r\n                .setAttribute(\"disabled\", \"disabled\");\r\n              fetch(\"https://grazacacademy.com/undergraduate/intern\", {\r\n                method: \"POST\",\r\n                headers: {\r\n                  \"Content-Type\": \"application/json\",\r\n                },\r\n                body: JSON.stringify({\r\n                  firstname: firstname,\r\n                  lastname: lastname,\r\n                  email: email,\r\n                  phone: phone,\r\n                  course: course,\r\n                  expectation: message,\r\n                  transaction_id: response.transaction_id\r\n                })\r\n              })\r\n              .then((resp) => resp.json())\r\n              .then((data) => {\r\n                if (data.success === true) {\r\n                  document.querySelector(\".form-info\").textContent = \"Your registration was successful, kindly check your mailbox for further details\";\r\n                  document.querySelector(\"#submit-btn\").removeAttribute(\"disabled\");\r\n                  setFirstName(\"\");\r\n                  setLastName(\"\");\r\n                  setMessage(\"\");\r\n                  setPhone(\"\");\r\n                  setEmail(\"\");\r\n                  setCourse(\"\");\r\n                } else {\r\n                  document.querySelector(\".form-info\").textContent = data.msg;\r\n                  document.querySelector(\"#submit-btn\").removeAttribute(\"disabled\");\r\n                }\r\n              })\r\n              .catch((err) => {\r\n                document.querySelector(\".form-info\").textContent = `Your payment was successful but something wrong while saving your details. \r\n                Kindly mail us at hello@grazacacademy.com`;\r\n                document.querySelector(\"#submit-btn\").removeAttribute(\"disabled\");\r\n              })\r\n\r\n            };\r\n            closePaymentModal() // this will close the modal programmatically\r\n        },\r\n        onClose: () => {\r\n\r\n        },\r\n      });\r\n    } else {\r\n      alert(\"You have to be available to register\");\r\n    }\r\n  };\r\n\r\n  return (\r\n    <div>\r\n      <Navbar />\r\n      <div>\r\n        <div className=\"contact_layer\">\r\n          <div className=\"form_top\" id=\"form_top\">\r\n            <div>\r\n              <h1>Grazac Internships.</h1>\r\n              <p>\r\n                We are bridging the gap between unemployment and entry-level\r\n                jobs in the technology industry.\r\n              </p>\r\n            </div>\r\n          </div>\r\n          <div className=\"container\" ref={formInfo}>\r\n            <div className=\"form\">\r\n              <form onSubmit={onSubmit}>\r\n                <div className=\"form-info\">\r\n                  Note: Fields with <span>*</span> are required\r\n                </div>\r\n                <div className=\"form-flexdiv\">\r\n                  <div className=\"form-flexdiv-1\">\r\n                    <label>\r\n                      First Name <span>*</span>\r\n                    </label>\r\n                    <input\r\n                      className=\"input\"\r\n                      type=\"text\"\r\n                      placeholder=\"ex. John\"\r\n                      value={firstname}\r\n                      onChange={(e) => setFirstName(e.target.value)}\r\n                      required=\"required\"\r\n                    />\r\n                  </div>\r\n                  <div className=\"form-flexdiv-2\">\r\n                    <label>\r\n                      Last Name <span>*</span>\r\n                    </label>\r\n                    <input\r\n                      className=\"input\"\r\n                      type=\"text\"\r\n                      placeholder=\"ex. Doe\"\r\n                      value={lastname}\r\n                      onChange={(e) => setLastName(e.target.value)}\r\n                      required=\"required\"\r\n                    />\r\n                  </div>\r\n                </div>\r\n                <div className=\"form-flexdiv\">\r\n                  <div className=\"form-flexdiv-1\">\r\n                    <label>\r\n                      Mobile Number <span>*</span>\r\n                    </label>\r\n                    <input\r\n                      className=\"input\"\r\n                      type=\"text\"\r\n                      placeholder=\"ex. 08133333333\"\r\n                      value={phone}\r\n                      onChange={(e) => setPhone(e.target.value)}\r\n                      required=\"required\"\r\n                      pattern=\".{11}\"\r\n                      title=\"Phone number is invalid\"\r\n                    />\r\n                  </div>\r\n                  <div className=\"form-flexdiv-2\">\r\n                    <label>\r\n                      Email <span>*</span>\r\n                    </label>\r\n                    <input\r\n                      className=\"input\"\r\n                      type=\"email\"\r\n                      placeholder=\"ex. john@example.com\"\r\n                      value={email}\r\n                      onChange={(e) => setEmail(e.target.value)}\r\n                      required=\"required\"\r\n                    />\r\n                  </div>\r\n                </div>\r\n                <div>\r\n                  <label>\r\n                    Our classes will be on Tuesdays and Thursdays, will you be\r\n                    available? <span>*</span>\r\n                  </label>\r\n                  <br />\r\n                  <label>\r\n                    <input\r\n                      type=\"radio\"\r\n                      className=\"radio-input\"\r\n                      id=\"yes\"\r\n                      name=\"availability\"\r\n                      value=\"1\"\r\n                      required=\"required\"\r\n                      checked={availability === \"1\"}\r\n                      onChange={(e) => setAvailability(e.target.value)}\r\n                    />\r\n                    Yes\r\n                  </label>\r\n                  <label>\r\n                    <input\r\n                      type=\"radio\"\r\n                      className=\"radio-input\"\r\n                      id=\"no\"\r\n                      name=\"availability\"\r\n                      value=\"0\"\r\n                      required=\"required\"\r\n                      checked={availability === \"0\"}\r\n                      onChange={(e) => setAvailability(e.target.value)}\r\n                      style={{ marginLeft: \"30px\" }}\r\n                    />\r\n                    No\r\n                  </label>\r\n                </div>\r\n                <div>\r\n                  <label>Course</label>\r\n                  <br />\r\n                  <p className=\"show-amount\">\r\n                    Website Development\r\n                  </p>\r\n                </div>\r\n                <div>\r\n                  <label>Amount</label>\r\n                  <br />\r\n                  <p className=\"show-amount\">\r\n                    ₦{new Intl.NumberFormat().format(amount)}\r\n                  </p>\r\n                </div>\r\n\r\n                <div>\r\n                  <label>\r\n                    What do you expect at the end of this training?{\" \"}\r\n                    <span>*</span>\r\n                  </label>\r\n                  <textarea\r\n                    type=\"text\"\r\n                    placeholder=\"Say something ...\"\r\n                    value={message}\r\n                    onChange={(e) => setMessage(e.target.value)}\r\n                    required=\"required\"\r\n                  />\r\n                </div>\r\n                <div className=\"form-privacy\">\r\n                  <button\r\n                    className=\"download-brochure\"\r\n                    type=\"submit\"\r\n                    id=\"submit-btn\"\r\n                  >\r\n                    Register\r\n                  </button>\r\n                </div>\r\n              </form>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <Footer />\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default InternshipForm;\r\n","C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\pages\\Faq.js",[],"C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\pages\\Profile.js",["256","257"],"import React from \"react\";\r\nimport {Link} from \"react-router-dom\";\r\nimport { Container, Row, Col } from \"react-bootstrap\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport Mode from \"../components/Mode\";\r\n\r\nimport project from \"../images/project.png\";\r\nimport student from \"../images/student.png\";\r\nimport back from \"../images/svg/arrow-back.svg\";\r\n\r\nconst Profile = () => {\r\n  React.useEffect(() => {\r\n    document.title = \"Profile - Grazac Academy\";\r\n    window.scrollTo(0, 0);\r\n  }, []);\r\n\r\n\r\n  return (\r\n    <div>\r\n      <Navbar/>\r\n        <div className=\"hire_profile_hero\">\r\n          <Container>\r\n            <Row>\r\n              <Col sm={6}>\r\n                <div className=\"hire_profile\">\r\n                  <div>\r\n                    <div className=\"hire_profile-text1\">\r\n                      <img src={back} />\r\n                      <h5>STUDENT PROFILE</h5>\r\n                    </div>\r\n                    <h3>Samuel Peter</h3>\r\n                    <p>Product Designer at Grazac</p>\r\n                    <h5>COURSE TAKEN</h5>\r\n                    <p>Product Designing (UI/UX)</p>\r\n                    <h5>KEY SKILLS LEARNT</h5>\r\n                    <p>\r\n                      <ul>\r\n                        <li>Responsive web designs </li>\r\n                        <li>Responsive web designs</li>\r\n                        <li>Responsive web designs</li>\r\n                        <li>Responsive web designs</li>\r\n                        <li>Responsive web designs</li>\r\n                      </ul>\r\n                    </p>\r\n                    <div className=\"contact_hero-privacy\" style={{marginBottom:'50px'}}>\r\n                        <a className=\"download-brochure\">\r\n                          Download CV\r\n                        </a>\r\n                        <Link to=\"/lead\">\r\n                          <button>Contact</button>\r\n                        </Link>\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n              </Col>\r\n              <Col sm={6}>\r\n                  <div className=\"hire_profile-image\">\r\n                    <img\r\n                      src={student}\r\n                      alt=\"student\"\r\n                      className=\"\"\r\n                    />\r\n                  </div>\r\n              </Col>\r\n            </Row>\r\n          </Container>\r\n        </div>\r\n\r\n\r\n        <div style={{boxSizing:'border-box', margin:'80px 0'}}>\r\n          <Container>\r\n            <h3>Projects</h3>\r\n            <Row>\r\n              <Col md={6}>\r\n                <div className=\"hire_dev\">\r\n                  <div className=\"hire_dev-picture\">\r\n                    <img src={project} alt=\"profile\" />\r\n                  </div>\r\n                  <h4>Project Name 1</h4>\r\n                  <p className=\"hire_dev-grey\">A brief, clear and consise description of the project been worked by each of the students.</p>\r\n                  <p className=\"hire_dev-purple\">View Project</p>\r\n                </div>\r\n              </Col>\r\n              <Col md={6}>\r\n                <div className=\"hire_dev\">\r\n                  <div className=\"hire_dev-picture\">\r\n                    <img src={project} alt=\"profile\" />\r\n                  </div>\r\n                  <h4>Project Name 1</h4>\r\n                  <p className=\"hire_dev-grey\">A brief, clear and consise description of the project been worked by each of the students.</p>\r\n                  <p className=\"hire_dev-purple\">View Project</p>\r\n                </div>\r\n              </Col>\r\n            </Row>\r\n          </Container>\r\n        </div>\r\n\r\n      <Mode />\r\n      <Footer />\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default Profile;","C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\pages\\Project.js",["258","259","260","261","262","263"],"import React from \"react\";\r\nimport {Link} from \"react-router-dom\";\r\nimport { Container, Row, Col } from \"react-bootstrap\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport Mode from \"../components/Mode\";\r\n\r\nimport project from \"../images/project.png\";\r\nimport student from \"../images/student.png\";\r\nimport back from \"../images/svg/arrow-back.svg\";\r\n\r\nconst Profile = () => {\r\n  React.useEffect(() => {\r\n    document.title = \"Profile - Grazac Academy\";\r\n    window.scrollTo(0, 0);\r\n  }, []);\r\n\r\n\r\n  return (\r\n    <div>\r\n        <Navbar/>\r\n        <div className=\"hire_project\">\r\n            <Container>\r\n                <div className=\"hire_project-hero\">\r\n                    <h1>Project Name 1</h1>\r\n                    <p>A brief, clear and consise description of the project been worked by each of the students.</p>\r\n                    <img src={project} />\r\n                </div>\r\n            </Container>\r\n        </div>\r\n        <Container>\r\n            <div className=\"hire_project-essay\">\r\n                <div>\r\n                    <h3>Question 1</h3>\r\n                    <p>Proin volutpat id orci vel ornare. In sit amet elit in eros fringilla rhoncus. Etiam auctor tincidunt ligula et facilisis. Suspendisse potenti. Etiam eu odio quis purus tempus egestas ut id sem. Proin a dignissim purus. Integer quis arcu in sem sollicitudin lobortis. Aliquam at neque elit. Cras tincidunt facilisis porta. Ut pretium vitae erat et finibus. Pellentesque a eros sollicitudin, ornare sem eget, hendrerit urna. Mauris blandit suscipit ex, finibus varius tortor imperdiet quis. Sed vitae nunc porta magna ultricies congue. Phasellus eu magna ac mauris malesuada dapibus. Ut rutrum augue pellentesque mauris gravida luctus ut ac urna. Etiam ultrices ex ac hendrerit pharetra. Mauris quis lacinia erat, eget euismod dui. Nulla at turpis in mauris laoreet consequat vitae at felis.</p>\r\n                    <p>Proin volutpat id orci vel ornare. In sit amet elit in eros fringilla rhoncus. Etiam auctor tincidunt ligula et facilisis. Suspendisse potenti. Etiam eu odio quis purus tempus egestas ut id sem. Proin a dignissim purus. Integer quis arcu in sem sollicitudin lobortis. Aliquam at neque elit. Cras tincidunt facilisis porta. Ut pretium vitae erat et finibus. Pellentesque a eros sollicitudin, ornare sem eget, hendrerit urna. Mauris blandit suscipit ex, finibus varius tortor imperdiet quis. Sed vitae nunc porta magna ultricies congue. Phasellus eu magna ac mauris malesuada dapibus. Ut rutrum augue pellentesque mauris gravida luctus ut ac urna. Etiam ultrices ex ac hendrerit pharetra. Mauris quis lacinia erat, eget euismod dui. Nulla at turpis in mauris laoreet consequat vitae at felis.</p>\r\n                    <p>Proin volutpat id orci vel ornre. In sit amet elit in eros f