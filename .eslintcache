87","messages":"88","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"59"},{"filePath":"89","messages":"90","errorCount":0,"warningCount":5,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"91","messages":"92","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"93","messages":"94","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"95","messages":"96","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},"C:\\Users\\'Toyosi Adekanmbi\\Desktop\\grazac-academy-web\\src\\index.js",[],"C:\\Users\\'Toyosi Adekanmbi\\Desktop\\grazac-academy-web\\src\\App.js",[],"C:\\Users\\'Toyosi Adekanmbi\\Desktop\\grazac-academy-web\\src\\reportWebVitals.js",[],"C:\\Users\\'Toyosi Adekanmbi\\Desktop\\grazac-academy-web\\src\\pages\\AboutUs.js",["97","98","99","100"],"C:\\Users\\'Toyosi Adekanmbi\\Desktop\\grazac-academy-web\\src\\pages\\CourseDetail.js",["101","102","103","104","105"],"import React,{useState} from \"react\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport PrimaryBtn from \"../components/PrimaryBtn\";\r\nimport {productDesign} from \"../content/courses.js\";\r\n\r\nimport quote from '../images/svg/quote.svg';\r\nimport paper from '../images/svg/paper-ribbon.svg';\r\nimport sprint from '../images/sprint.png';\r\n\r\nconst CourseDetail = (props) => {\r\n    const [course, setCourse] = useState('');\r\n    const [outline, setOutline] = useState([]);\r\n\r\n    React.useEffect(() => {\r\n        document.title = 'Course Details - Grazac Academy';\r\n        window.scrollTo(0,0);\r\n        const param = props.location.search.substring(8);\r\n        if (param === 'productDesign'){\r\n            setCourse(productDesign);\r\n            setOutline(productDesign.outline)\r\n        }\r\n    },[]);\r\n    \r\n    const RenderOutline = _ => {\r\n        const list = outline.map((item, index) => (\r\n            <div key={index}>\r\n                <div className=\"course_learn-main-list\">\r\n                    <div className=\"box1\">\r\n                        <h3>{item.id}</h3>\r\n                    </div>\r\n                    <div className=\"box2\">\r\n                        <h3>{item.topic}</h3>\r\n                    </div>\r\n                    <div className=\"box3\">\r\n                        <p>{item.content}</p>\r\n                    </div>\r\n                </div>\r\n                <hr/>\r\n            </div>\r\n        ))\r\n        return(<div>{list}</div>)\r\n    }\r\n    return(\r\n        <div>\r\n            <Navbar/>\r\n            <div className=\"course\">\r\n                <div className=\"gua_hero\">\r\n                    <div className=\"container\">\r\n                        <div className=\"row\">\r\n                            <div className=\"col-sm-6\">\r\n                                <div className=\"gua_hero-text\">\r\n                                    <div className=\"gua_hero-text-b\">\r\n                                        <h1>\r\n                                            {course.name}\r\n                                        </h1>\r\n                                        <p>\r\n                                            {course.description}\r\n                                        </p>\r\n                                        <div className=\"contact_hero-privacy\" >\r\n                                            <button>Download Brochure</button>\r\n                                            <button>Enroll now</button>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div>\r\n                                <img src={paper} alt=\"academy\"  className=\"gga_hero-image\" />\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"course_learn\">\r\n                    <div className=\"container\">\r\n                        <div className=\"course_wwd-intro\">\r\n                            <h4>GRAZAC ACADEMY</h4>\r\n                            <h2>What you'll Learn</h2>\r\n                        </div>\r\n                        <div className=\"course_learn-main\">\r\n                            <RenderOutline/>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"course_mode\">\r\n                    <div className=\"container\">\r\n                        <div className=\"course_wwd-intro\">\r\n                            <h4>What we do</h4>\r\n                            <h2>Mode Of Teaching</h2>\r\n                            <p>Amet minim mollit non deserunt ullamco est sit aliqua dolor do amet sint. Velit officia consequ</p>\r\n                        </div>\r\n                        <div className=\"course_mode-container\">\r\n                            <div className=\"\">\r\n                                <div>\r\n                                    <div className=\"boxes\">\r\n                                        <div className=\"svg-box\"></div>\r\n                                        <h3></h3>\r\n                                        <p>Learn the foundations of database management with focus on relational database systems and its terminologies.</p>\r\n                                    </div>\r\n                                    <div className=\"boxes\">\r\n                                        <div className=\"svg-box\"></div>\r\n                                        <h3></h3>\r\n                                        <p>Learn the foundations of database management with focus on relational database systems and its terminologies.</p>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div className=\"\">\r\n                                <div>\r\n                                    <div className=\"boxes\">\r\n                                        <div className=\"svg-box\"></div>\r\n                                        <h3></h3>\r\n                                        <p>Learn the foundations of database management with focus on relational database systems and its terminologies.</p>\r\n                                    </div>\r\n                                    <div className=\"boxes\">\r\n                                        <div className=\"svg-box\"></div>\r\n                                        <h3></h3>\r\n                                        <p>Learn the foundations of database management with focus on relational database systems and its terminologies.</p>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div className=\"mode-pic\">\r\n                                <img src={sprint} alt=\"jdgkj\" style={{width:'100%'}} />\r\n                            </div>\r\n                        </div>\r\n                        <div className=\"course_mode-quote\">\r\n                            <img src={quote} alt=\"quote\" />\r\n                            <p>Online learning can be a lifeline to those who have obstacles, such as geographical distances or physical disabilities.</p>\r\n                            <span>Paul Levinson</span>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"course_purple\">\r\n                    <div className=\"course_purple_txt\">\r\n                        <p>Pricing</p>\r\n                        <h1>50%</h1>\r\n                        <p>Scholarship Available</p>\r\n                    </div>\r\n                    <div className=\"course_purple-main\">\r\n                        <div className=\"course_purple-main-boxes\">\r\n                            <h4>FULL TUITION PAYMENT</h4>\r\n                            <h2>₦540,000</h2>\r\n                            <p>Pay your fees 100% upfront. No other charges come up during your career</p>\r\n                        </div>\r\n                        <div className=\"course_purple-main-boxes\">\r\n                            <h4>FULL TUITION PAYMENT</h4>\r\n                            <h2>₦540,000</h2>\r\n                            <p>Pay your fees 100% upfront. No other charges come up during your career</p>\r\n                        </div>\r\n                        <div className=\"course_purple-main-boxes\">\r\n                            <h4>FULL TUITION PAYMENT</h4>\r\n                            <h2>₦540,000</h2>\r\n                            <p>Pay your fees 100% upfront. No other charges come up during your career</p>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"course_purple-btn\">\r\n                        <PrimaryBtn>Claim Scholarship</PrimaryBtn> \r\n                        <p>Talk to course rep</p>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n            <Footer/>\r\n        </div>\r\n    );\r\n}\r\n\r\nexport default CourseDetail;",["106","107"],"C:\\Users\\'Toyosi Adekanmbi\\Desktop\\grazac-academy-web\\src\\pages\\GraduateAccelerator.js",[],"C:\\Users\\'Toyosi Adekanmbi\\Desktop\\grazac-academy-web\\src\\pages\\UndergraduateAccelerator.js",["108","109"],"import React from \"react\";\r\nimport {Link} from \"react-router-dom\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport NeedAdvice from \"../components/NeedAdvice\";\r\nimport PopularCourses from \"../components/PopularCourses\";\r\nimport Qualities from \"../components/Qualities\";\r\n\r\nimport undergraduate from \"../images/undergraduate.png\";\r\n\r\nconst UndergraduateAccelerator = () => {\r\n\r\n    React.useEffect(() => {\r\n        document.title = 'Undergraduate Accelerator Track - Grazac Academy';\r\n        window.scrollTo(0,0);\r\n    }, []);\r\n\r\n    return(\r\n        <div>\r\n            <div className=\"gua\">\r\n                <div className=\"gua_hero\">\r\n                        <Navbar/>\r\n                    <div className=\"container\">\r\n                        <div className=\"row\">\r\n                            <div className=\"col-sm-6\">\r\n                                <div className=\"gua_hero-text\">\r\n                                    <div className=\"gua_hero-text-b\">\r\n                                        <h1>\r\n                                            Undergraduate Accelerator Plan\r\n                                        </h1>\r\n                                        <p> We equip you for the future of the career you desire,\r\n                                        Become an asset in this 21st century before leaving the four walls of school.</p>\r\n                                        <p>Join thousands of young undergraduates now. Access to mentorship tailored to your career path.</p>\r\n                                        <p>Become the next best talent to be hired in this 21st century and be employable.</p>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div>\r\n                                <img src={undergraduate} alt=\"undergraduate\"  className=\"gua_hero-image\" />\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"container\">\r\n                    <div className=\"gga\">\r\n                        <div className=\"course_mode-intro course_mode-intro\">\r\n                            <h4 style={{marginTop:'100px'}}>How it works</h4>\r\n                            <h2>Highlighted Learning</h2>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"gua_highlight\">\r\n                        <div className=\"boxes44 gua_highlight-box1\">\r\n                            <div className=\"gua_highlight-box3\">\r\n                                <div className=\"gua_highlight-box4\">\r\n                                    <h3><strong>Student Lead</strong></h3>\r\n                                    <p>Become our ambassador in your institution. </p>\r\n                                    <p>Lead other students who are ready to prepare themselves for the future of work.</p>\r\n                                    <Link to=\"/lead\"><a className=\"white-link\">Apply as Student Lead</a></Link>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                        <div className=\"boxes44 gua_highlight-box2\">\r\n                            <div  className=\"gua_highlight-box3\">\r\n                                <div className=\"gua_highlight-box4\">\r\n                                    <h3><strong>Affiliated Campuses</strong></h3>\r\n                                    <p>We are well represented in various institutions of learning across Nigeria.</p>\r\n                                    <p>We want to prepare you for the future of work before you leave the four walls of learning.</p>\r\n                                    <a className=\"white-link\">Learn More</a>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <PopularCourses />\r\n                <Qualities />\r\n                <NeedAdvice />\r\n    