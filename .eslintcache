eWarningCount":0,"usedDeprecatedRules":"72"},{"filePath":"111","messages":"112","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"113","usedDeprecatedRules":"72"},{"filePath":"114","messages":"115","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"116","usedDeprecatedRules":"72"},{"filePath":"117","messages":"118","errorCount":0,"warningCount":13,"fixableErrorCount":0,"fixableWarningCount":0,"source":"119","usedDeprecatedRules":"72"},{"filePath":"120","messages":"121","errorCount":0,"warningCount":12,"fixableErrorCount":0,"fixableWarningCount":0,"source":"122","usedDeprecatedRules":"72"},{"filePath":"123","messages":"124","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"72"},{"filePath":"125","messages":"126","errorCount":0,"warningCount":4,"fixableErrorCount":0,"fixableWarningCount":0,"source":"127","usedDeprecatedRules":"72"},{"filePath":"128","messages":"129","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"130","usedDeprecatedRules":"72"},{"filePath":"131","messages":"132","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"72"},{"filePath":"133","messages":"134","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"72"},{"filePath":"135","messages":"136","errorCount":0,"warningCount":6,"fixableErrorCount":0,"fixableWarningCount":0,"source":"137","usedDeprecatedRules":"72"},{"filePath":"138","messages":"139","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"72"},{"filePath":"140","messages":"141","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"72"},{"filePath":"142","messages":"143","errorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"144","usedDeprecatedRules":"72"},{"filePath":"145","messages":"146","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"72"},{"filePath":"147","messages":"148","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"72"},{"filePath":"149","messages":"150","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"151","usedDeprecatedRules":"72"},{"filePath":"152","messages":"153","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"154","usedDeprecatedRules":"72"},{"filePath":"155","messages":"156","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},"C:\\Users\\Dabiri Mayowa\\Desktop\\Grazac\\grazac-academy-web\\src\\index.js",[],["157","158"],"C:\\Users\\Dabiri Mayowa\\Desktop\\Grazac\\grazac-academy-web\\src\\App.js",["159","160","161"],"C:\\Users\\Dabiri Mayowa\\Desktop\\Grazac\\grazac-academy-web\\src\\reportWebVitals.js",[],"C:\\Users\\Dabiri Mayowa\\Desktop\\Grazac\\grazac-academy-web\\src\\pages\\UndergraduateCourseDetail.js",["162"],"import React, { useState, useEffect } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport PrimaryBtn from \"../components/PrimaryBtn\";\r\nimport MOT from \"../components/MOT\";\r\n\r\nimport paper from \"../images/svg/paper-ribbon.svg\";\r\nimport loader from \"../images/loader.gif\";\r\n\r\nconst ErrorModal = (props) => {\r\n  return (\r\n    <div className=\"modal3__bg\" onClick={() => props.setShowModal(false)}>\r\n      <div className=\"modal3__content modal3__content--err\">\r\n        <div className=\"modal3__content--head\">\r\n          <div>&nbsp;</div>\r\n          <svg className=\"modal3__content--svg\" viewBox=\"0 0 10 10\" fill=\"none\">\r\n            <path\r\n              d=\"M4.94263 4.00008L7.80451 1.13814C8.06516 0.877482 8.06516 0.456157 7.80451 0.195496C7.54385 -0.0651653 7.12254 -0.0651653 6.86188 0.195496L4 3.05744L1.13812 0.195496C0.877463 -0.0651653 0.456148 -0.0651653 0.195492 0.195496C-0.065164 0.456157 -0.065164 0.877482 0.195492 1.13814L3.05737 4.00008L0.195492 6.86202C-0.065164 7.12269 -0.065164 7.54401 0.195492 7.80467C0.325486 7.93467 0.496146 8 0.666806 8C0.837465 8 1.00812 7.93467 1.13812 7.80467L4 4.94273L6.86188 7.80467C6.99188 7.93467 7.16254 8 7.33319 8C7.50385 8 7.67451 7.93467 7.80451 7.80467C8.06516 7.54401 8.06516 7.12269 7.80451 6.86202L4.94263 4.00008Z\"\r\n              fill=\"#073041\"\r\n            />\r\n          </svg>\r\n        </div>\r\n\r\n        <div className=\"modal3__content--body\">\r\n          <h1>Oops...</h1>\r\n          Sorry :( but you can no longer enroll for this course because it is no\r\n          longer available.\r\n          <br />\r\n          <br />\r\n          Check by later.\r\n        </div>\r\n      </div>\r\n    </div>\r\n  );\r\n};\r\n\r\nconst CourseDetail = (props) => {\r\n  const [course, setCourse] = useState(\"\");\r\n  const [outline, setOutline] = useState([]);\r\n  const [showModal, setShowModal] = useState(false);\r\n\r\n  useEffect(() => {\r\n    document.title = \"Course Details - Grazac Academy\";\r\n    window.scrollTo(0, 0);\r\n    var blur = document.getElementById('blur');\r\n    blur.classList.add('blur-active');\r\n    const slug = props.location.search.substring(8);\r\n    fetch(`https://grazacacademy.com/undergraduate/course/details/${slug}`)\r\n      .then((resp) => resp.json())\r\n      .then((resp) => {\r\n        setCourse(resp.data);\r\n        setOutline(JSON.parse(resp.data.outline));\r\n        blur.classList.remove('blur-active');\r\n      })\r\n      .catch(() => {\r\n        console.log(\r\n          \"An error occurred when fetching course details, refreshing...\"\r\n        );\r\n        window.location.reload();\r\n      });\r\n  }, [props.location.search]);\r\n\r\n  const toggleModal = (e) => {\r\n    e.preventDefault();\r\n    showModal ? setShowModal(false) : setShowModal(true);\r\n  };\r\n\r\n  return (\r\n    <div>\r\n            {outline.length ? (<div></div>) : (\r\n                <div>\r\n                <img src={loader} alt=\"loader\" className=\"loader-top\" />\r\n                </div>\r\n            )}\r\n    <div id=\"blur\">\r\n      <Navbar />\r\n      <div className=\"course\">\r\n        <div className=\"course_hero\">\r\n          <div className=\"container\">\r\n            {course ? (\r\n              <div className=\"row\">\r\n                <div className=\"col-sm-6\">\r\n                  <div className=\"course_hero-text\">\r\n                    <div className=\"course_hero-text-b\">\r\n                      <h1>{course.name}</h1>\r\n                      <p>{course.description}</p>\r\n                      <div className=\"contact_hero-privacy\">\r\n                        <a\r\n                          href={course.brochure}\r\n                          target=\"_blank\"\r\n                          rel=\"noreferrer\"\r\n                          className=\"download-brochure\"\r\n                        >\r\n                          Download Brochure\r\n                        </a>\r\n                        <Link to=\"/undergraduate-form\">\r\n                          <button>Enroll now</button>\r\n                        </Link>\r\n                      </div>\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n                <div>\r\n                  <img src={paper} alt=\"academy\" className=\"gga_hero-image\" />\r\n                </div>\r\n              </div>\r\n            ) : (\r\n              <div>\r\n              {/*<img src={loader} alt=\"loader\" className=\"loader\" />*/}\r\n              </div>\r\n            )}\r\n          </div>\r\n        </div>\r\n        <div className=\"course_learn\">\r\n          <div className=\"container\">\r\n            <div className=\"course_wwd-intro\">\r\n              <h4>GRAZAC ACADEMY</h4>\r\n              <h2>What you'll Learn</h2>\r\n            </div>\r\n            <div className=\"course_learn-main\">\r\n              {outline.length ? (\r\n                outline.map((item, index) => (\r\n                  <div key={index}>\r\n                    <div className=\"course_learn-main-list\">\r\n                      <div className=\"box1\">\r\n                        <h3>{index < 10 ? \"0\" + index : index}</h3>\r\n                      </div>\r\n                      <div className=\"box2\">\r\n                        <h3>{item.topic}</h3>\r\n                      </div>\r\n                      <div className=\"box3\">\r\n                        <p>{item.summary}</p>\r\n                      </div>\r\n                    </div>\r\n                    <hr />\r\n                  </div>\r\n                ))\r\n              ) : (\r\n                <div>\r\n                  {/*<img src={loader} alt=\"loader\" className=\"loader\" />*/}\r\n                </div>\r\n              )}\r\n            </div>\r\n          </div>\r\n        </div>\r\n        <MOT />\r\n        <div className=\"course_purple\">\r\n          <div className=\"course_purple_txt\">\r\n            <p>Pricing</p>\r\n            <h1>100%</h1>\r\n            <p>Discount Available</p>\r\n          </div>\r\n          <div className=\"course_purple-main\">\r\n            <div className=\"course_purple-main-boxes grad-box\">\r\n              <h4>Tuition</h4>\r\n              <h2>FREE</h2>\r\n            </div>\r\n            <div className=\"course_purple-main-boxes grad-box\">\r\n              <h4>Note</h4>\r\n              <p>\r\n                <span>\r\n                  You are required to pay a sum of ₦10,000 for your certificate\r\n                  and to ensure we secure a befitting environment to aid your\r\n                  learning.{\" \"}\r\n                </span>\r\n              </p>\r\n            </div>\r\n          </div>\r\n          <div className=\"course_purple-btn\">\r\n            <PrimaryBtn link=\"/undergraduate-form\">Enroll Now</PrimaryBtn>\r\n            <a href=\"tel:+234806 836 5951\" style={{marginTop:\"7px\"}}>\r\n              <p>Talk to course rep</p>\r\n            </a>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <Footer />\r\n\r\n      {showModal && <ErrorModal setShowModal={setShowModal} />}\r\n    </div>\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default CourseDetail;\r\n","C:\\Users\\Dabiri Mayowa\\Desktop\\Grazac\\grazac-academy-web\\src\\pages\\Landing.js",["163"],"import { useEffect, useState } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { Accordion, Card } from \"react-bootstrap\";\r\n// import { cn } from \"../utils\";\r\nimport { MdKeyboardArrowDown } from \"react-icons/md\";\r\nimport { IoMdArrowRoundBack } from \"react-icons/io\";\r\nimport Slider from \"infinite-react-carousel\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport Mode from \"../components/Mode\";\r\nimport PrimaryBtn from \"../components/PrimaryBtn\";\r\n\r\nimport Abdullahi from \"../images/testimonial/abdullahi.jpeg\";\r\nimport Adedamola from \"../images/testimonial/adedamola.jpeg\";\r\nimport Bosun from \"../images/testimonial/bosun.jpg\";\r\nimport Grazac from \"../images/svg/logo-round.svg\";\r\nimport Video from \"../images/landing-video2.mp4\";\r\nimport Object from \"../images/svg/objects.svg\";\r\nimport poster from \"../images/Grazac-website/IMG_8403.JPG\";\r\n\r\nimport badge from \"../images/svg/badge.svg\";\r\nimport ex from \"../images/svg/x-mark.svg\";\r\nimport Sponsor1 from \"../images/svg/Apple.svg\";\r\nimport Sponsor2 from \"../images/svg/AWS.svg\";\r\nimport Sponsor3 from \"../images/svg/Flutterwave.svg\";\r\nimport Sponsor5 from \"../images/svg/Microsoft.svg\";\r\nimport Sponsor6 from \"../images/svg/Google.svg\";\r\n\r\nimport Card1 from \"../images/svg/card1.svg\";\r\nimport Card2 from \"../images/svg/card2.svg\";\r\n\r\nimport Loader from \"../components/Loader\";\r\nconst Landing = () => {\r\n  const [showModal, setShowModal] = useState(true);\r\n  useEffect(() => {\r\n    document.title = \"Welcome to Grazac Academy\";\r\n    let mediaPlayer = document.querySelector(\"#video\");\r\n    mediaPlayer.controls = false;\r\n    mediaPlayer.play();\r\n\r\n    //this gives the homepage spacing on top for the notification\r\n    var landingHeight = document.getElementsByClassName(\"landing\")[0];\r\n    landingHeight.style.marginTop = `80px`;\r\n  }, []);\r\n\r\n  const content = [\r\n    {\r\n      id: 0,\r\n      img: Bosun,\r\n      content:\r\n        \"The future of work will be filled with so many opportunities we need to prepare for, I’ve known Grazac for a while and seen them in the business of helping people lay hold of these opportunities. Grazac Academy is an excellent starting point for anyone looking into building a career in technology.\",\r\n      name: \"Bosun Egberinde - Creator of PHPSandbox.io\",\r\n    },\r\n    {\r\n      id: 1,\r\n      img: Adedamola,\r\n      content:\r\n        \"I've known Grazac for over a year now and having worked with some of their successful students, I can boldly say the competency and problem solving skills of their students is top-notch and their academy is one of the best academy promoting technology skills acquisition here in Nigeria\",\r\n      name: \"Samson Adedamola - Consultant at Kudi\",\r\n    },\r\n    {\r\n      id: 2,\r\n      img: Abdullahi,\r\n      content:\r\n        \"I passed through Grazac Academy while I was in school and that's one of the best thing that happened to me as an undergraduate. I love how the facilitators mentored everyone of us up and I must say that, we got more value than we paid for.\",\r\n      name: \"Abdullahi Olaniyan - Software Developer at Global Accelerex\",\r\n    },\r\n  ];\r\n\r\n  const handleModal = () => {\r\n    setShowModal(false);\r\n    var landingHeight = document.getElementsByClassName(\"landing\")[0];\r\n    landingHeight.style.marginTop = `0px`;\r\n  };\r\n\r\n  const handleFaq = (e) => {\r\n    // const svg = e.target.querySelector(\"svg\");\r\n    console.log(e);\r\n    let svg = e.target.parentElement.querySelector(\"svg\");\r\n    if (e.target.nodeName === \"path\") {\r\n      svg = e.target.parentElement.parentElement.querySelector(\"svg\");\r\n    }\r\n    svg.classList.toggle(\"faq-icon_transition\");\r\n  };\r\n\r\n  useEffect(() => {\r\n    window.addEventListener(\"load\", (event) => {\r\n      console.log(\"The page has fully loaded\");\r\n    });\r\n  }, []);\r\n  return (\r\n    <div className=\"landing\">\r\n      <Loader />\r\n      {showModal && (\r\n        <div className=\"infomodal\">\r\n          <div className=\"infomodal_content\">\r\n            <img src={badge} alt=\"\" className=\"infomodal_badge\" />\r\n            <p>\r\n              Grazac Graduate Accelerator Program enrollment is opening by June\r\n              25th.\r\n              <a\r\n                className=\"infomodal_content-link\"\r\n                href=\"https://grazacacademy.com/graduate-accelerator-plan\"\r\n                f\r\n              >\r\n                Learn more\r\n              </a>\r\n            </p>\r\n            <Link to=\"/graduate-accelerator-plan\">\r\n              <button>Learn more</button>\r\n            </Link>\r\n            <img\r\n              src={ex}\r\n              alt=\"\"\r\n              onClick={handleModal}\r\n              style={{ cursor: \"pointer\" }}\r\n            />\r\n          </div>\r\n        </div>\r\n      )}\r\n      <div className=\"landing__header\">\r\n        <Navbar top={true} />\r\n        <img src={Object} className=\"bg-img\" alt=\"ccc\" />\r\n        <div style={{ height: 10 }}></div>\r\n\r\n        <div className=\"landing__text\">\r\n          <h1>\r\n            Upskilling You For The <span>Future</span> Of Work\r\n          </h1>\r\n          <p>\r\n            Learn valuable technology skills with us, we strongly believe the\r\n            future of work will be skill based. Join us to build a career in\r\n            tech and get tutored by industry leaders who will walk you through\r\n            the path of becoming highly valuable and employable{\" \"}\r\n          </p>\r\n        </div>\r\n        <a href=\"/#tracks\">\r\n          <div\r\n            className=\"nav__btn\"\r\n            style={{ width: \"130px\", margin: \"auto\", textAlign: \"center\" }}\r\n          >\r\n            <div className=\"nav__btn--text\">Get Started</div>\r\n          </div>\r\n        </a>\r\n      </div>\r\n\r\n      <div className=\"landing__video\">\r\n        <video\r\n          id=\"video\"\r\n          width=\"320\"\r\n          height=\"240\"\r\n          autoPlay\r\n          loop\r\n          muted\r\n          poster={poster}\r\n        >\r\n          <source src={Video} type=\"video/mp4\" />\r\n        </video>\r\n      </div>\r\n\r\n      <div className=\"landing__sponsors\">\r\n        <div className=\"landing__sponsors--container\">\r\n          <img src={Sponsor1} alt=\"sponsor\" />\r\n          <img src={Sponsor2} alt=\"sponsor\" />\r\n          <img src={Sponsor3} alt=\"sponsor\" />\r\n          <img src={Sponsor5} alt=\"sponsor\" />\r\n          <img src={Sponsor6} alt=\"sponsor\" />\r\n        </div>\r\n      </div>\r\n\r\n      <div className=\"landing__cards\" id=\"tracks\">\r\n        <div className=\"landing__cards--container\">\r\n          <div className=\"landing__bottom--text\">\r\n            <div className=\"landing__bottom--text--right\">\r\n              <h1>Get Ready To Grow With us </h1>\r\n            </div>\r\n          </div>\r\n\r\n          <div className=\"landing__card--box\">\r\n            <div className=\"landing__card landing__card--1\">\r\n              <img src={Card1} alt=\"illustration\" />\r\n              <h3>\r\n                <span>Graduate </span>\r\n                <br />\r\n                Accelerator Plan\r\n              </h3>\r\n              <p>\r\n                An immersive program that gives you the opportunity to build a\r\n                career and get a job in the tech industry.\r\n              </p>\r\n\r\n              <div className=\"landing__btn\">\r\n                <PrimaryBtn yellow link=\"/graduate-accelerator-plan\">\r\n                  Learn More\r\n                </PrimaryBtn>\r\n              </div>\r\n            </div>\r\n\r\n            <div className=\"landing__card landing__card--2\">\r\n              <img src={Card2} alt=\"illustration\" />\r\n              <h3>\r\n                <span>Undergraduate </span>\r\n                <br />\r\n                Accelerator Plan (FREE)\r\n              </h3>\r\n              <p>\r\n                Set the pace for a bright future as an undergraduate by\r\n                acquiring technology skills now.\r\n              </p>\r\n              <div className=\"landing__btn\">\r\n                <PrimaryBtn link=\"/undergraduate-accelerator-plan\">\r\n                  Learn More\r\n                </PrimaryBtn>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <div className=\"landing__intern\">\r\n        <div className=\"landing__intern--content\">\r\n          <div>&nbsp;</div>\r\n          <div className=\"landing__bottom--text landing__bottom--text-2\">\r\n            <div className=\"landing__intern--text\">\r\n              <h1>Tech is Vast. Let's help you with directions.</h1>\r\n              <p>\r\n                Are you looking to step into the field of tech but don't know\r\n                what to learn or how to begin? We can help you. Tech is a broad\r\n                field, and there are a lot of interesting pathways and\r\n                directions you can venture into. You need all the clarity you\r\n                can get so you can make informed decisions. Consult us for free\r\n              </p>\r\n              <div className=\"landing__btn--2\">\r\n                {/* <PrimaryBtn link=\"/\">Enroll Now</PrimaryBtn> */}\r\n                <a href=\"/#tracks\">\r\n                  <div className=\"nav__btn nav__btn-flex \">\r\n                    <a\r\n                      className=\"nav__btn--text\"\r\n                      href=\"tel:+2348068365951\"\r\n                      style={{ marginRight: \"20px\" }}\r\n                    >\r\n                      Call Us Now\r\n                    </a>\r\n                    <a href=\"https://wa.link/w8e0xs\">\r\n                      <div className=\"nav__btn--text1\">Chat With Us</div>\r\n                    </a>\r\n                  </div>\r\n                </a>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          {/* <div className=\"landing__intern--btn\">\r\n            <PrimaryBtn link=\"/internship\">Enroll Now</PrimaryBtn>\r\n          </div> */}\r\n        </div>\r\n      </div>\r\n\r\n      <div className=\"landing__discover\">\r\n        <div className=\"landing__bottom--text landing__bottom--text-2\">\r\n          <div className=\"landing__bottom--text--right\">\r\n            <h1>\r\n              We are trusted by entrepreneurs and hiring managers globally.\r\n            </h1>\r\n            <p>\r\n              We guarantee you impact driven candidates who will impact your\r\n              bottom lines positively.\r\n            </p>\r\n          </div>\r\n        </div>\r\n\r\n        <div className=\"landing__discover--container\">\r\n          <div className=\"landing__discover--images\">\r\n            <div className=\"landing__discover--images-left\">\r\n              <div></div>\r\n              <div></div>\r\n            </div>\r\n            <div className=\"landing__discover--images-right\">\r\n              <div></div>\r\n            </div>\r\n          </div>\r\n\r\n          <div className=\"landing__discover--list\">\r\n            <div className=\"landing__discover--list-item\">\r\n              <h2>01</h2>\r\n              <div>\r\n                <h3>Enroll</h3>\r\n                <p>\r\n                  Set yourself up for success by registering for any of our\r\n                  courses that fits your passion and career.\r\n                </p>\r\n              </div>\r\n            </div>\r\n\r\n            <div className=\"landing__discover--list-item\">\r\n              <h2>02</h2>\r\n              <div>\r\n                <h3>Learn</h3>\r\n                <p>\r\n                  Get trained by world class facilitators. We will provide you\r\n                  with the right mentorship, tools and content you need to be\r\n                  the best in your choosing career.\r\n                </p>\r\n              </div>\r\n            </div>\r\n\r\n            <div className=\"landing__discover--list-item\">\r\n              <h2>03</h2>\r\n              <div>\r\n                <h3>Get Hired</h3>\r\n                <p>\r\n                  Join the workforce of the future as you get connected with\r\n                  career coaches and potential employers.\r\n                </p>\r\n              </div>\r\n            </div>\r\n            <div className=\"landing__discover--list-item\"></div>\r\n            <div className=\"landing__discover--list-item\"></div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      {/* FAQ section commented out till content is ready */}\r\n      <div className=\"landing_faq\">\r\n        <div className=\"container\">\r\n          <h1>FAQs</h1>\r\n          <div>\r\n            <Accordion>\r\n              <Card>\r\n                <Accordion.Toggle as={Card.Header} eventKey=\"0\">\r\n                  <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                    <h4>What is Grazac Academy?</h4>\r\n                    <MdKeyboardArrowDown size=\"2rem\" color=\"black\" />\r\n                  </div>\r\n                </Accordion.Toggle>\r\n                <Accordion.Collapse eventKey=\"0\">\r\n                  <Card.Body>\r\n                    <div className=\"landing_faq-answer\">\r\n                      <p>\r\n                        Grazac Academy is closing the gap between youths and\r\n                        entry-level jobs in the technology industry. We strongly\r\n                        believe the job market for youths has changed and the\r\n                        future of work will be skill-based.\r\n                      </p>\r\n                      <p>We are approaching this in two ways:</p>\r\n                      <p>\r\n                        Grazac Academy Graduate Accelerator - This plan is for\r\n                        tertiary institutions graduates who have full time to\r\n                        build a career in tech. This plan has been arranged in a\r\n                        way to prepare them for work.\r\n                      </p>\r\n                      <p>\r\n                        Grazac Academy Undergraduate Accelerator - This plan is\r\n                        to equip undergraduates in their institutions, we\r\n                        believe the earlier the better and we want to prepare\r\n                        them for life after school by upskilling them while they\r\n                        are still in school.\r\n                      </p>\r\n                    </div>\r\n                  </Card.Body>\r\n                </Accordion.Collapse>\r\n              </Card>\r\n              <hr />\r\n              <Card>\r\n                <Accordion.Toggle as={Card.Header} eventKey=\"1\">\r\n                  <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                    <h4>When was the academy established?</h4>\r\n                    <MdKeyboardArrowDown size=\"2rem\" color=\"black\" />\r\n                  </div>\r\n                </Accordion.Toggle>\r\n                <Accordion.Collapse eventKey=\"1\">\r\n                  <Card.Body>\r\n                    <div className=\"landing_faq-answer\">\r\n                      <p>Grazac Academy has been in operation since 2018</p>\r\n                    </div>\r\n                  </Card.Body>\r\n                </Accordion.Collapse>\r\n              </Card>\r\n              <hr />\r\n              <Card>\r\n                <Accordion.Toggle as={Card.Header} eventKey=\"2\">\r\n                  <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                    <h4>How many students have graduated from your academy?</h4>\r\n                    <MdKeyboardArrowDown size=\"2rem\" color=\"black\" />\r\n                  </div>\r\n                </Accordion.Toggle>\r\n                <Accordion.Collapse eventKey=\"2\">\r\n                  <Card.Body>\r\n                    <div className=\"landing_faq-answer\">\r\n                      <p>\r\n                        Excluding our partnership with Haptics.ng in 2019 to\r\n                        execute Google project of upskilling Nigerians on\r\n                        Digital skills where we trained about 500 youths, we\r\n                        have impacted over 2,000 lives through our trainings,\r\n                        meetups and events.\r\n                      </p>\r\n                    </div>\r\n                  </Card.Body>\r\n                </Accordion.Collapse>\r\n              </Card>\r\n              <hr />\r\n              <Card>\r\n                <Accordion.Toggle as={Card.Header} eventKey=\"3\">\r\n                  <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                    <h4>Where is the academy located?</h4>\r\n                    <MdKeyboardArrowDown size=\"2rem\" color=\"black\" />\r\n                  </div>\r\n                </Accordion.Toggle>\r\n                <Accordion.Collapse eventKey=\"3\">\r\n                  <Card.Body>\r\n                    <div className=\"landing_faq-answer\">\r\n                      <p>\r\n                        Our headquarter is located at Abeokuta, Ogun State,\r\n                        Nigeria.\r\n                      </p>\r\n                      <p>\r\n                        Address: Suite 106, PROHUB, Salawu Olabode Avenue, Ewang\r\n                        Road, Idi-aba, Abeokuta.\r\n                      </p>\r\n                    </div>\r\n                  </Card.Body>\r\n                </Accordion.Collapse>\r\n              </Card>\r\n              <hr />\r\n              <Card>\r\n                <Accordion.Toggle as={Card.Header} eventKey=\"4\">\r\n                  <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                    <h4>How do I enroll in the academy?</h4>\r\n                    <MdKeyboardArrowDown size=\"2rem\" color=\"black\" />\r\n                  </div>\r\n                </Accordion.Toggle>\r\n                <Accordion.Collapse eventKey=\"4\">\r\n                  <Card.Body>\r\n                    <div className=\"landing_faq-answer\">\r\n                      <p>\r\n                        Visit{\" \"}\r\n                        <a href=\"https://www.grazacacademy.com\">\r\n                          www.grazacacademy.com\r\n                        </a>{\" \"}\r\n                        to enroll for your preferred course.\r\n                      </p>\r\n                    </div>\r\n                  </Card.Body>\r\n                </Accordion.Collapse>\r\n              </Card>\r\n              <hr />\r\n              <Card>\r\n                <Accordion.Toggle as={Card.Header} eventKey=\"5\">\r\n                  <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                    <h4>What are the payment options?</h4>\r\n                    <MdKeyboardArrowDown size=\"2rem\" color=\"black\" />\r\n                  </div>\r\n                </Accordion.Toggle>\r\n                <Accordion.Collapse eventKey=\"5\">\r\n                  <Card.Body>\r\n                    <div className=\"landing_faq-answer\">\r\n                      <p>\r\n                        We have three (2) payment options for our Gradaute\r\n                        Accelerator, you can either pay once or pay\r\n                        installmentally.\r\n                      </p>\r\n                    </div>\r\n                  </Card.Body>\r\n                </Accordion.Collapse>\r\n              </Card>\r\n            </Accordion>\r\n            <hr />\r\n            <Link to=\"/faq\">\r\n              <p className=\"landing_faq-link\">\r\n                More frequently asked questions\r\n              </p>\r\n            </Link>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <div className=\"landing__slider\">\r\n        <Slider arrows={true}>\r\n          {content.map((item) => (\r\n            <div className=\"landing__slider--container\" key={item.id}>\r\n              <div className=\"landing__slider--img\">\r\n                <img src={item.img} alt=\"img\" />\r\n              </div>\r\n\r\n              <div className=\"landing__slider--text\">\r\n                <svg\r\n                  width=\"30\"\r\n                  height=\"28\"\r\n                  viewBox=\"0 0 30 28\"\r\n                  fill=\"none\"\r\n                  xmlns=\"http://www.w3.org/2000/svg\"\r\n                >\r\n                  <path\r\n                    d=\"M12.3993 5.56001C13.1711 5.22699 13.4948 4.27918 13.1462 3.51069L11.9262 0.872185C11.5777 0.129562 10.7311 -0.203709 9.98417 0.129562C7.86782 1.05176 6.05026 2.25573 4.60616 3.71587C2.83839 5.43192 1.64328 7.4044 0.995927 9.5818C0.348574 11.7851 0 14.782 0 18.5988V26.4631C0 27.3084 0.672251 28.0001 1.49389 28.0001H11.2789C12.1005 28.0001 12.7728 27.3084 12.7728 26.4631V16.3958C12.7728 15.5502 12.1005 14.8588 11.2789 14.8588H6.59802C6.64781 12.2713 7.24537 10.1966 8.34089 8.63373C9.23722 7.37904 10.5817 6.35438 12.3993 5.56001Z\"\r\n                    fill=\"#4B004B\"\r\n                  />\r\n                  <path\r\n                    d=\"M29.1127 5.53403C29.8845 5.20102 30.2079 4.25321 29.8596 3.48471L28.6396 0.872082C28.291 0.129203 27.4445 -0.203812 26.6976 0.129203C24.6061 1.0514 22.8132 2.25537 21.3444 3.6899C19.5764 5.43182 18.3567 7.40429 17.7091 9.5817C17.0617 11.7332 16.7383 14.7306 16.7383 18.5731V26.4374C16.7383 27.2827 17.4105 27.9744 18.2322 27.9744H28.0172C28.8388 27.9744 29.511 27.2827 29.511 26.4374V16.3701C29.511 15.5245 28.8388 14.8331 28.0172 14.8331H23.3114C23.3612 12.2456 23.959 10.1709 25.0543 8.60801C25.9506 7.35306 27.2951 6.3284 29.1127 5.53403Z\"\r\n                    fill=\"#4B004B\"\r\n                  />\r\n                </svg>\r\n\r\n                <p>{item.content}</p>\r\n\r\n                <small>{item.name}</small>\r\n              </div>\r\n            </div>\r\n          ))}\r\n        </Slider>\r\n      </div>\r\n\r\n      <div className=\"landing__bottom\" style={{ paddingBottom: 0 }}>\r\n        <div className=\"landing__bottom--text\">\r\n          <div className=\"landing__bottom--text--right\">\r\n            <h1>Get Upskilled For The Future Of Work</h1>\r\n            <p>\r\n              We will provide you with the tools, resources, facilities, content\r\n              and mentorship needed for your relevance in the future of work.\r\n            </p>\r\n            <div className=\"landing__btn--2\">\r\n              {/* <PrimaryBtn link=\"/\">Enroll Now</PrimaryBtn> */}\r\n              <a href=\"/#tracks\">\r\n                <div className=\"nav__btn nav__btn-flex \">\r\n                  <a className=\"nav__btn--text\" href=\"https://wa.link/w8e0xs\">\r\n                    Chat with Us\r\n                  </a>\r\n                </div>\r\n              </a>\r\n            </div>\r\n          </div>\r\n\r\n          <div className=\"landing__bottom--text--left\">\r\n            <img src={Grazac} alt=\"img\" />\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <Mode />\r\n      <Footer />\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default Landing;\r\n","C:\\Users\\Dabiri Mayowa\\Desktop\\Grazac\\grazac-academy-web\\src\\pages\\GraduateCourseDetail.js",["164","165"],"import React,{useState} from \"react\";\r\nimport {Link} from \"react-router-dom\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport PrimaryBtn from \"../components/PrimaryBtn\";\r\nimport MOT from \"../components/MOT\";\r\n\r\nimport paper from '../images/svg/paper-ribbon.svg';\r\nimport loader from \"../images/loader.gif\";\r\n\r\nconst CourseDetail = (props) => {\r\n    const [course, setCourse] = useState('');\r\n    const [outline, setOutline] = useState([]);\r\n\r\n    React.useEffect(() => {\r\n        document.title = 'Course Details - Grazac Academy';\r\n        window.scrollTo(0,0);\r\n        var blur = document.getElementById('blur');\r\n        blur.classList.add('blur-active');\r\n        const slug = props.location.search.substring(8);\r\n        fetch(`https://grazacacademy.com/graduate/course/details/${slug}`)\r\n            .then(resp => resp.json())\r\n            .then(resp => {\r\n                setCourse(resp.data);\r\n                console.log(resp.data);\r\n                setOutline(JSON.parse(resp.data.outline));\r\n                blur.classList.remove('blur-active');\r\n            })\r\n            .catch(error => {\r\n                console.log('An error occurred when fetching course details, refreshing...')\r\n                window.location.reload();\r\n            })\r\n    },[]);\r\n    \r\n    return(\r\n        <div>\r\n            {outline.length ? (<div></div>) : (\r\n                <div>\r\n                <img src={loader} alt=\"loader\" className=\"loader-top\" />\r\n                </div>\r\n            )}\r\n        <div id=\"blur\">\r\n            <Navbar/>\r\n            <div className=\"course\">\r\n                <div className=\"course_hero\">\r\n                    <div className=\"container\">\r\n                        {course ? \r\n                            <div className=\"row\">\r\n                                <div className=\"col-sm-6\">\r\n                                    <div className=\"course_hero-text\">\r\n                                        <div className=\"course_hero-text-b\">\r\n                                            <h1>\r\n                                                {course.name}\r\n                                            </h1>\r\n                                            <p>\r\n                                                {course.description}\r\n                                            </p>\r\n                                            <div className=\"contact_hero-privacy\" >\r\n                                                <a href={course.brochure} className=\"download-brochure\" target=\"_blank\">Download Brochure</a>\r\n                                                <Link to=\"/graduate-form\"><button>Enroll now</button></Link>\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                                <div>\r\n                                    <img src={paper} alt=\"academy\"  className=\"gga_hero-image\" />\r\n                                </div>\r\n                            </div> : \r\n                            <div>\r\n                            {/*<img src={loader} alt=\"loader\" className=\"loader\" />*/}\r\n                            </div>\r\n                        }\r\n                    </div>\r\n                </div>\r\n                <div className=\"course_learn\">\r\n                    <div className=\"container\">\r\n                        <div className=\"course_wwd-intro\">\r\n                            <h4>GRAZAC ACADEMY</h4>\r\n                            <h2>What you'll Learn</h2>\r\n                        </div>\r\n                        <div className=\"course_learn-main\">\r\n                            {outline.length ? \r\n                                outline.map((item, index) => (\r\n                                    <div key={index}>\r\n                                        <div className=\"course_learn-main-list\">\r\n                                            <div className=\"box1\">\r\n                                                <h3>{(index<10) ? '0'+index : index}</h3>\r\n                                            </div>\r\n                                            <div className=\"box2\">\r\n                                                <h3>{item.topic}</h3>\r\n                                            </div>\r\n                                            <div className=\"box3\">\r\n                                                <p>{item.summary}</p>\r\n                                            </div>\r\n                                        </div>\r\n                                        <hr/>\r\n                                    </div>\r\n                                )):\r\n                                <div>\r\n                                    {/* <img src={loader} alt=\"loader\" className=\"loader\" /> */}\r\n                                </div>\r\n                            }\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <MOT />\r\n                <div className=\"course_purple\">\r\n                    <div className=\"course_purple_txt\">\r\n                        <p>Our Flexible Payment Plans</p>\r\n                        <h1>{course.percent_off}%</h1>\r\n                        <p>Discount Available</p>\r\n                    </div>\r\n                    <div className=\"course_purple-main\">\r\n                        <Link to=\"/graduate-form?payment=fulltime\">\r\n                            <div className=\"course_purple-main-boxes grad-box\">\r\n                                <h4>Full Payment</h4>\r\n                                <h3><span style={{textDecoration:'line-through'}}>₦{course.tuition}</span></h3>\r\n                                <h2>₦{new Intl.NumberFormat().format(course.discounted_tuition)}</h2>\r\n                                <p>This is a one-off payment. You won't be required to pay any amount again till the end of your training.</p>\r\n                            </div>\r\n                        </Link>\r\n                        <Link to=\"/graduate-form?payment=installment\">\r\n                            <div className=\"course_purple-main-boxes grad-box\">\r\n                                <h4>Installment Payment</h4>\r\n                                <h3><span style={{textDecoration:'line-through'}}>₦{course.tuition}</span></h3>\r\n                                <h2>₦{new Intl.NumberFormat().format(100000)} <span style={{fontSize: '14px'}}>* 2 months.</span></h2>\r\n                                <p>To be paid at the start of the training and completed midway into the training which is after 2 months.</p>\r\n                            </div>\r\n                        </Link>\r\n                        <Link to=\"/graduate-form?payment=income-split\">\r\n                            <div className=\"course_purple-main-boxes grad-box\">\r\n                                <h4>Monthly Payment</h4>\r\n                                <h3><span style={{textDecoration:'line-through'}}>₦{course.tuition}</span></h3>\r\n                                <h2>₦{new Intl.NumberFormat().format(55000)} <span style={{fontSize: '14px'}}>* 4 months.</span></h2>\r\n                                <p>To be paid at the beginning of each month for the duration of the training which is 4 months.</p>\r\n                            </div>\r\n                        </Link>\r\n                    </div>\r\n                    <div className=\"course_purple-btn\">\r\n                        <PrimaryBtn link=\"/graduate-form\">Enroll Now</PrimaryBtn>\r\n                        <a href=\"tel:+234806 836 5951\" style={{marginTop:\"7px\"}}><p>Talk to course rep</p></a>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n            <Footer/>\r\n        </div>\r\n        </div>\r\n    );\r\n}\r\n\r\nexport default CourseDetail;","C:\\Users\\Dabiri Mayowa\\Desktop\\Grazac\\grazac-academy-web\\src\\pages\\AboutUs.js",[],"C:\\Users\\Dabiri Mayowa\\Desktop\\Grazac\\grazac-academy-web\\src\\pages\\Contact.js",["166","167"],"import React, { useState, useEffect } from \"react\";\r\nimport axios from 'axios';\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport PrimaryBtn from \"../components/PrimaryBtn\";\r\n\r\nimport Facebook from \"../images/svg/facebook.svg\";\r\nimport Instagram from \"../images/svg/instagram.svg\";\r\nimport Twitter from \"../images/svg/twitter.svg\";\r\nimport Youtube from \"../images/svg/youtube.svg\";\r\n\r\nconst Contact = () => {\r\n\r\n    const [ name, setName ] = useState('');\r\n    const [ email, setEmail ] = useState('');\r\n    const [ subject, setSubject ] = useState('');\r\n    const [ message, setMessage ] = useState('');\r\n\r\n    useEffect(() => {\r\n        document.title = 'Contact - Grazac Academy';\r\n        window.scrollTo(0,0);\r\n    }, []);\r\n\r\n    const handleSubmit = () => {\r\n        if(name.length && email.length && subject.length && message.length) {\r\n            const btn = document.querySelector('#submit');\r\n            btn.setAttribute('disabled', '');\r\n            btn.textContent = 'Submitting...';\r\n            console.log('Submitted')\r\n            axios.post('http://grazacacademy.com/contact/create', {\r\n                name: name,\r\n                email: email,\r\n                subject: subject,\r\n                message: message\r\n            })\r\n            .then(resp => resp.data)\r\n            .then(response => {\r\n                if(response.success === true) {\r\n                    btn.removeAttribute('disabled');\r\n                    btn.textContent = 'Submit';\r\n                    alert(response.msg);\r\n                    setName(''); setEmail(''); setSubject(''); setMessage('');\r\n                } else {\r\n\r\n                }\r\n            })\r\n            .catch((err) => {\r\n                \r\n            });\r\n        } else {\r\n            alert('Invalid input');\r\n        }\r\n    }\r\n\r\n    return(\r\n        <div>\r\n            <Navbar/>\r\n            <div className=\"contact\">\r\n                <div className=\"contact_layer\">\r\n                    <div className=\"container\">\r\n                        <div className=\"contact_layer-text\">\r\n                            <h1>Get In Touch</h1>\r\n                            <p>We want to hear from you. Let us know how we can help</p>\r\n                        </div>\r\n                        {/*<div classname=\"contact_layer-circles\">\r\n                            <img src={kamala} alt=\"kamala\"  classname=\"contact_layer-circles-1\" />\r\n                            <img src={kamala} alt=\"kamala\"  classname=\"contact_layer-circles-2\" />\r\n                            <img src={kamala} alt=\"kamala\"  classname=\"contact_layer-circles-3\" />\r\n                            <img src={kamala} alt=\"kamala\"  classname=\"contact_layer-circles-4\" />\r\n                        </div>*/}\r\n                        <div className=\"contact_hero\">\r\n                            <div className=\"contact_hero-flexdiv\">\r\n                                <div className=\"contact_hero-flexdiv-1\" >\r\n                                    <label>Full Name  <span>*</span></label>\r\n                                    <input type=\"text\" placeholder=\"ex. John Doe\" value={name} onChange={e => setName(e.target.value)} />\r\n                                </div>\r\n                                <div className=\"contact_hero-flexdiv-2\">\r\n                                    <label>Email  <span>*</span></label>\r\n                                    <input type=\"text\" placeholder=\"ex. john@gmail.com\" value={email} onChange={e => setEmail(e.target.value)}  />\r\n                                </div>\r\n                            </div>\r\n                            <div>\r\n                                <label>Subject  <span>*</span></label>\r\n                                <input  type=\"text\" placeholder=\"ex. John Doe\" value={subject} onChange={e => setSubject(e.target.value)}  />\r\n                            </div>\r\n                            <div>\r\n                                <label>Message  <span>*</span></label>\r\n                                <textarea  type=\"text\" placeholder=\"Describe your task for us\" value={message} onChange={e => setMessage(e.target.value)}  />\r\n                            </div>\r\n                            <div className=\"contact_hero-privacy\" >\r\n                                <p>By submitting this form your consent to us emailing you occasionally about our products and services. You can unsubscribe from emails at any time, and we will never pass your email onto third parties. <span>Privacy Policy</span></p>\r\n                                <button id=\"submit\" onClick={handleSubmit}>Submit</button>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"container\">\r\n                    <div className=\"contact_campus\">\r\n                        <div className=\"contact_campus-intro\">\r\n                            <h2>Campus Inquiries</h2>\r\n                            <p>Connect with Us</p>\r\n                        </div>\r\n                        <div className=\"contact_campus-main\">\r\n                            <div className=\"contact_campus-main-div boxes33\">\r\n                                <h3>Office</h3>\r\n                                <p>PROHUB, Salawu Olabode Avenue, Ewang Road, </p>\r\n                                <p>Idi-aba, 110124, Abeokuta</p>\r\n                                <p>+234 806 836 5951</p>\r\n                            </div>\r\n                            <div className=\"contact_campus-main-div boxes33\">\r\n                                <h3>Book A Call</h3>\r\n                                <p>We are here to help with any questions. </p>\r\n                                <p>Talk to our programme leads.</p>\r\n                                <div style={{display:'flex'}}>\r\n                                    <a href=\"tel:+2348068365951\" ><div className=\"nav__btn--text\">Book a Call</div></a>\r\n                                </div>\r\n                            </div>\r\n                            <div className=\"contact_campus-main-div boxes33\">\r\n                                <h3>Social Media</h3>\r\n                                <div className=\"social\">\r\n                                    <img src={Facebook} alt=\"social\"/>\r\n                                </div>\r\n                                <div className=\"social\">\r\n                                    <img src={Twitter} alt=\"social\"/>\r\n                                </div>\r\n                                <div className=\"social\">\r\n                                    <img src={Youtube} alt=\"social\"/>\r\n                                </div>\r\n                                <div className=\"social\">\r\n                                    <img src={Instagram} alt=\"social\"/>\r\n                                </div>\r\n                            </div>\r\n\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div>\r\n                    <iframe src=\"https://www.google.com/maps/d/embed?mid=16NZ9a9VhKkk2-5nnYEdL93mxq7kjDZLT\" width=\"100%\" height=\"600\"></iframe>\r\n                </div>\r\n                {/*<extracomponent/> a component used in the landing page comes here*/}\r\n            </div>\r\n            <Footer/>\r\n        </div>\r\n    );\r\n}\r\n\r\nexport default Contact;","C:\\Users\\Dabiri Mayowa\\Desktop\\Grazac\\grazac-academy-web\\src\\pages\\GraduateAccelerator.js",["168","169","170","171"],"import  { useState, useEffect } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport NeedAdvice from \"../components/NeedAdvice\";\r\nimport Qualities from \"../components/Qualities\";\r\nimport Graduates from \"../images/graduate.png\";\r\nimport loader from \"../images/loader.gif\";\r\n\r\nconst GraduateAccelerator = () => {\r\n  const [courses, setCourses] = useState([]);\r\n\r\n  useEffect(() => {\r\n    document.title = \"Graduate Accelerator Track - Grazac Academy\";\r\n    window.scrollTo(0, 0);\r\n    // var blur = document.getElementById(\"blur\");\r\n    // blur.classList.add(\"blur-active\");\r\n    window.addEventListener(\"load\", (event) => {\r\n      fetch(\"https://grazacacademy.com/graduate/courses\")\r\n      .then((resp) => resp.json())\r\n      .then((resp) => {\r\n        setCourses(resp.data);\r\n        // blur.classList.remove(\"blur-active\");\r\n      })\r\n      .catch((error) => {\r\n        console.log(\r\n          \"An error occurred when fetching the available courses, refreshing...\"\r\n        );\r\n        //\r\n    });\r\n    //  window.location.reload();\r\n      });\r\n    if (!courses.length) {\r\n      console.log(\"dont scroll\");\r\n      document.getElementsByClassName(\"gga\").scroll = \"no\";\r\n      document.body.style.overflow = \"hidden\";\r\n      document.height = window.innerHeight;\r\n    }\r\n  }, []);\r\n\r\n  useEffect(() => {\r\n    window.addEventListener(\"load\", (event) => {\r\n      console.log(\"The page has fully loaded\");\r\n    });\r\n  }, []);\r\n\r\n  return (\r\n    <div>\r\n      {/* {courses.length ? (\r\n        <div></div>\r\n      ) : (\r\n        <div>\r\n          <img src={loader} alt=\"loader\" className=\"loader-top\" />\r\n        </div>\r\n      )} */}\r\n      <div id=\"blur\">\r\n        <Navbar />\r\n        <div className=\"gga\">\r\n          <div className=\"gga_hero\">\r\n            <div className=\"container\">\r\n              <div className=\"gga_flex\">\r\n                <div className=\"gga_flex-half1\">\r\n                  <div className=\"gga_hero-text\">\r\n                    <div className=\"gga_hero-text-b\">\r\n                      <h1>Graduate Accelerator Plan</h1>\r\n                      <p>\r\n                        We are bridging the gap between unemployment and\r\n                        entry-level jobs in the technology industry. Become\r\n                        employable in just 4 months by joining us today, we\r\n                        provide you with the right mentorship, tools and\r\n                        contents to upskill yourself.\r\n                      </p>\r\n                      <div className=\"contact_hero-privacy\">\r\n                        <a href=\"#courses\" className=\"download-brochure\">\r\n                          Join Us Today!\r\n                        </a>\r\n                      </div>\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n                <div className=\"gga_flex-half2\">\r\n                  <img\r\n                    src={Graduates}\r\n                    alt=\"Graduates\"\r\n                    className=\"gga_hero-image\"\r\n                  />\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <div className=\"container\">\r\n            <div 