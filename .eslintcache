75 27.5 15 27.5C15.0075 27.5 15.0138 27.4988 15.0188 27.4988C15.0213 27.4988 15.0225 27.5 15.025 27.5C15.0288 27.5 15.0325 27.4975 15.035 27.4975C21.9112 27.4788 27.5 21.88 27.5 15Z\"\r\n                            fill=\"white\"\r\n                          />\r\n                        </mask>\r\n                      </svg>\r\n                    </div>\r\n                    <h3>Mentorship Access</h3>\r\n                    <p>\r\n                      Set out on the right path by leveraging on the experience\r\n                      of those who have gone ahead.\r\n                    </p>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n              <div className=\"boxes22\">\r\n                <div className=\"\">\r\n                  <div className=\"boxes\">\r\n                    <div className=\"svg-box2\">\r\n                      <svg\r\n                        width=\"30\"\r\n                        height=\"30\"\r\n                        viewBox=\"0 0 30 30\"\r\n                        fill=\"none\"\r\n                        xmlns=\"http://www.w3.org/2000/svg\"\r\n                      >\r\n                        <path\r\n                          fill-rule=\"evenodd\"\r\n                          clip-rule=\"evenodd\"\r\n                          d=\"M18.2695 24.44C19.5808 22.5675 20.9445 19.8138 21.217 16.25H24.9108C24.432 20.065 21.7995 23.2125 18.2695 24.44ZM5.08612 16.2498H8.82612C9.08362 19.8273 10.4299 22.5698 11.7586 24.4511C8.21237 23.2298 5.56737 20.0761 5.08612 16.2498ZM11.7972 5.53516C10.4822 7.40766 9.10594 10.1702 8.83094 13.7489H5.08594C5.56844 9.90891 8.23219 6.74516 11.7972 5.53516ZM11.3477 13.7498C11.7302 9.65984 13.8227 6.81234 15.0314 5.49609C16.2814 6.83484 18.3414 9.65609 18.6977 13.7498H11.3477ZM11.3516 16.25H18.7041C18.3216 20.3462 16.2241 23.1937 15.0166 24.51C13.7078 23.1225 11.7003 20.34 11.3516 16.25ZM24.9125 13.7519H21.2225C20.9662 10.1906 19.635 7.45688 18.3125 5.57812C21.8225 6.81563 24.4362 9.95188 24.9125 13.7519ZM27.5 15C27.5 8.12 21.9112 2.5225 15.035 2.5025C15.03 2.5025 15.025 2.50125 15.0188 2.50125C15.0138 2.50125 15.0063 2.5 15 2.5C8.1075 2.5 2.5 8.10875 2.5 15C2.5 21.8925 8.1075 27.5 15 27.5C15.0075 27.5 15.0138 27.4988 15.0188 27.4988C15.0213 27.4988 15.0225 27.5 15.025 27.5C15.0288 27.5 15.0325 27.4975 15.035 27.4975C21.9112 27.4788 27.5 21.88 27.5 15Z\"\r\n                          fill=\"#773DD3\"\r\n                        />\r\n                        <mask\r\n                          id=\"mask0\"\r\n                          mask-type=\"alpha\"\r\n                          maskUnits=\"userSpaceOnUse\"\r\n                          x=\"2\"\r\n                          y=\"2\"\r\n                          width=\"26\"\r\n                          height=\"26\"\r\n                        >\r\n                          <path\r\n                            fill-rule=\"evenodd\"\r\n                            clip-rule=\"evenodd\"\r\n                            d=\"M18.2695 24.44C19.5808 22.5675 20.9445 19.8138 21.217 16.25H24.9108C24.432 20.065 21.7995 23.2125 18.2695 24.44ZM5.08612 16.2498H8.82612C9.08362 19.8273 10.4299 22.5698 11.7586 24.4511C8.21237 23.2298 5.56737 20.0761 5.08612 16.2498ZM11.7972 5.53516C10.4822 7.40766 9.10594 10.1702 8.83094 13.7489H5.08594C5.56844 9.90891 8.23219 6.74516 11.7972 5.53516ZM11.3477 13.7498C11.7302 9.65984 13.8227 6.81234 15.0314 5.49609C16.2814 6.83484 18.3414 9.65609 18.6977 13.7498H11.3477ZM11.3516 16.25H18.7041C18.3216 20.3462 16.2241 23.1937 15.0166 24.51C13.7078 23.1225 11.7003 20.34 11.3516 16.25ZM24.9125 13.7519H21.2225C20.9662 10.1906 19.635 7.45688 18.3125 5.57812C21.8225 6.81563 24.4362 9.95188 24.9125 13.7519ZM27.5 15C27.5 8.12 21.9112 2.5225 15.035 2.5025C15.03 2.5025 15.025 2.50125 15.0188 2.50125C15.0138 2.50125 15.0063 2.5 15 2.5C8.1075 2.5 2.5 8.10875 2.5 15C2.5 21.8925 8.1075 27.5 15 27.5C15.0075 27.5 15.0138 27.4988 15.0188 27.4988C15.0213 27.4988 15.0225 27.5 15.025 27.5C15.0288 27.5 15.0325 27.4975 15.035 27.4975C21.9112 27.4788 27.5 21.88 27.5 15Z\"\r\n                            fill=\"white\"\r\n                          />\r\n                        </mask>\r\n                      </svg>\r\n                    </div>\r\n                    <h3>Job Placement</h3>\r\n                    <p>\r\n                      Enter the recruitment process with tech companies and take\r\n                      a stride into your dream career.{\" \"}\r\n                    </p>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <div className=\"background1\" id=\"courses\">\r\n            <div className=\"container\">\r\n              <div className=\"gga\">\r\n                <div className=\"course_mode-intro course_mode-intro\">\r\n                  <h2>Available Courses</h2>\r\n                </div>\r\n                <div className=\"gga_container\">\r\n                  {courses.length ? (\r\n                    courses.map((item, index) => (\r\n                      <a\r\n                        href={`/course-detail-graduate?course=${item.slug}`}\r\n                        className=\"boxes33\"\r\n                        key={index}\r\n                      >\r\n                        <div className=\"gua_cardview\">\r\n                          <div className=\"gua_cardview-box\">\r\n                            <img src={item.thumb} alt=\"course-desc\" />\r\n                          </div>\r\n                          <div className=\"gua_cardview-text\">\r\n                            <h4 style={{ color: \"rgb(51, 51, 51)\" }}>\r\n                              {item.name}\r\n                            </h4>\r\n                            <p>{item.description}</p>\r\n                            <Link\r\n                              to={\"/course-detail-graduate?course=\" + item.slug}\r\n                            >\r\n                              <a>Learn More</a>\r\n                            </Link>\r\n                          </div>\r\n                        </div>\r\n                      </a>\r\n                    ))\r\n                  ) : (\r\n                    <div>\r\n                      {/* <img src={loader} alt=\"loader\" className=\"loader\" /> */}\r\n                    </div>\r\n                  )}\r\n                  <div className=\"boxes33\">\r\n                    <div className=\"gua_cardview\">\r\n                      <div className=\"gua_cardview-text\">\r\n                        <h4>Can't find a course you are interested in?</h4>\r\n                        <p>\r\n                          We will be glad if you can suggest the course you'd\r\n                          love to learn.\r\n                        </p>\r\n                        <Link to=\"/contact\">\r\n                          <a>Contact Us</a>\r\n                        </Link>\r\n                      </div>\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <Qualities />\r\n          <NeedAdvice />\r\n        </div>\r\n        <Footer />\r\n      </div>\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default GraduateAccelerator;\r\n","C:\\Users\\Dabiri Mayowa\\Desktop\\Grazac\\grazac-academy-web\\src\\pages\\Faq.js",["172"],"import React from \"react\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport {Accordion, Card} from 'react-bootstrap';\r\nimport { MdKeyboardArrowDown } from \"react-icons/md\";\r\n\r\nconst Faq = () => {\r\n    React.useEffect(() => {\r\n        document.title = 'FAQs - Grazac Academy';\r\n        window.scrollTo(0,0);\r\n    },[]);\r\n    \r\n    const handleFaq = (e) => {\r\n        var icon = e.target.querySelector('img');\r\n        //console.log(icon.classList);\r\n        icon.classList.toggle(\"faq-icon_transition\")  \r\n    }\r\n    \r\n    return(\r\n        <div>\r\n            <Navbar/>\r\n            <div>\r\n                {/* FAQ section */}\r\n                <div className=\"landing_faq\">\r\n                    <div className=\"container\">\r\n                        <h1>FAQs - Frequently Asked Questions:</h1>\r\n                        <div>\r\n                        <Accordion defaultActiveKey=\"0\">\r\n                            <h3>Academy</h3>\r\n                            <Card>\r\n                            <Accordion.Toggle as={Card.Header} eventKey=\"0\">\r\n                                <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                                <h4>What is Grazac Academy?</h4>\r\n                                </div>\r\n                            </Accordion.Toggle>\r\n                            <Accordion.Collapse eventKey=\"0\">\r\n                                <Card.Body>\r\n                                <div className=\"landing_faq-answer\">\r\n                                    <p>Grazac Academy is closing the gap between youths and entry-level jobs in the technology industry. We strongly believe the job market for youths has changed and the future of work will be skill-based.</p>\r\n                                    <p>We are approaching this in two ways:</p>\r\n                                    <p>Grazac Academy Graduate Accelerator - This plan is for tertiary institutions graduates who have full time to build a career in tech. This plan has been arranged in a way to prepare them for work.</p>\r\n                                    <p>Grazac Academy Undergraduate Accelerator - This plan is to equip undergraduates in their institutions, we believe the earlier the better and we want to prepare them for life after school by upskilling them while they are still in school.</p>\r\n                                </div>\r\n                                </Card.Body>\r\n                            </Accordion.Collapse>\r\n                            </Card>\r\n                            <hr/>\r\n                            <Card>\r\n                            <Accordion.Toggle as={Card.Header} eventKey=\"1\">\r\n                                <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                                <h4>When was the academy established?</h4>\r\n                                </div>\r\n                            </Accordion.Toggle>\r\n                            <Accordion.Collapse eventKey=\"1\">\r\n                                <Card.Body>\r\n                                <div className=\"landing_faq-answer\">\r\n                                    <p>Grazac Academy has been in operation since 2018</p>\r\n                                </div>\r\n                                </Card.Body>\r\n                            </Accordion.Collapse>\r\n                            </Card>\r\n                            <hr/>\r\n                            <Card>\r\n                            <Accordion.Toggle as={Card.Header} eventKey=\"2\">\r\n                                <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                                <h4>How many students have graduated from your academy?</h4>\r\n                                </div>\r\n                            </Accordion.Toggle>\r\n                            <Accordion.Collapse eventKey=\"2\">\r\n                                <Card.Body>\r\n                                <div className=\"landing_faq-answer\">\r\n                                    <p>Excluding our partnership with Haptics.ng in 2019 to execute Google project of upskilling Nigerians on Digital skills where we trained about 500 youths, we have impacted over 2,000 lives through our trainings, meetups and events.</p>\r\n                                </div>\r\n                                </Card.Body>\r\n                            </Accordion.Collapse>\r\n                            </Card>\r\n                            <hr/>\r\n                            <Card>\r\n                            <Accordion.Toggle as={Card.Header} eventKey=\"3\">\r\n                                <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                                <h4>Where is the academy located?</h4>\r\n                                </div>\r\n                            </Accordion.Toggle>\r\n                            <Accordion.Collapse eventKey=\"3\">\r\n                                <Card.Body>\r\n                                <div className=\"landing_faq-answer\">\r\n                                    <p>Our headquarter is located at Abeokuta, Ogun State, Nigeria.</p>\r\n                                    <p>Address: Suite 106, PROHUB, Salawu Olabode Avenue, Ewang Road, Idi-aba, Abeokuta.</p>\r\n                                </div>\r\n                                </Card.Body>\r\n                            </Accordion.Collapse>\r\n                            </Card>\r\n                            <hr/>\r\n                            <Card>\r\n                            <Accordion.Toggle as={Card.Header} eventKey=\"4\">\r\n                                <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                                <h4>How do I enroll in the academy?</h4>\r\n                                </div>\r\n                            </Accordion.Toggle>\r\n                            <Accordion.Collapse eventKey=\"4\">\r\n                                <Card.Body>\r\n                                <div className=\"landing_faq-answer\">\r\n                                    <p>Visit <a href=\"https://www.grazacacademy.com\">www.grazacacademy.com</a> to enroll for your preferred course.</p>\r\n                                </div>\r\n                                </Card.Body>\r\n                            </Accordion.Collapse>\r\n                            </Card>\r\n                            <hr/>\r\n                            <h3>Payment Structure</h3>\r\n                            <Card>\r\n                            <Accordion.Toggle as={Card.Header} eventKey=\"5\">\r\n                                <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                                <h4>What are the payment options?</h4>\r\n                                </div>\r\n                            </Accordion.Toggle>\r\n                            <Accordion.Collapse eventKey=\"5\">\r\n                                <Card.Body>\r\n                                <div className=\"landing_faq-answer\">\r\n                                    <p>We have three (2) payment options for our Gradaute Accelerator, you can either pay once or pay installmentally.</p>\r\n                                </div>\r\n                                </Card.Body>\r\n                            </Accordion.Collapse>\r\n                            </Card>\r\n                            <hr/>\r\n                            <Card>\r\n                            <Accordion.Toggle as={Card.Header} eventKey=\"6\">\r\n                                <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                                <h4>Do you offer discounts?</h4>\r\n                                </div>\r\n                            </Accordion.Toggle>\r\n                            <Accordion.Collapse eventKey=\"6\">\r\n                                <Card.Body>\r\n                                <div className=\"landing_faq-answer\">\r\n                                    <p>Yes, we offer early bird discounts.</p>\r\n                                </div>\r\n                                </Card.Body>\r\n                            </Accordion.Collapse>\r\n                            </Card>\r\n                            <hr/>\r\n                            <Card>\r\n                            <Accordion.Toggle as={Card.Header} eventKey=\"7\">\r\n                                <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                                <h4>Do you offer scholarships?</h4>\r\n                                </div>\r\n                            </Accordion.Toggle>\r\n                            <Accordion.Collapse eventKey=\"7\">\r\n                                <Card.Body>\r\n                                <div className=\"landing_faq-answer\">\r\n                                    <p>No. We don’t have scholarship offers at the moment.</p>\r\n                                </div>\r\n                                </Card.Body>\r\n                            </Accordion.Collapse>\r\n                            </Card>\r\n                            <hr/>\r\n                            <Card>\r\n                            <Accordion.Toggle as={Card.Header} eventKey=\"100\">\r\n                                <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                                <h4>Do you offer compensation to a referrer?</h4>\r\n                                </div>\r\n                            </Accordion.Toggle>\r\n                            <Accordion.Collapse eventKey=\"100\">\r\n                                <Card.Body>\r\n                                <div className=\"landing_faq-answer\">\r\n                                    <p>Yes, for our Graduate Accelerator, you can refer someone and earn 5,000 naira immediately after the referred person enroll. The referred person must put your name while registering.</p>\r\n                                </div>\r\n                                </Card.Body>\r\n                            </Accordion.Collapse>\r\n                            </Card>\r\n                            <hr/>\r\n                            <Card>\r\n                            <Accordion.Toggle as={Card.Header} eventKey=\"8\">\r\n                                <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                                <h4>Can I switch my payment plan?</h4>\r\n                                </div>\r\n                            </Accordion.Toggle>\r\n                            <Accordion.Collapse eventKey=\"8\">\r\n                                <Card.Body>\r\n                                <div className=\"landing_faq-answer\">\r\n                                    <p>No, you can’t switch payment plans.</p>\r\n                                </div>\r\n                                </Card.Body>\r\n                            </Accordion.Collapse>\r\n                            </Card>\r\n                            <hr/>\r\n                            <Card>\r\n                            <Accordion.Toggle as={Card.Header} eventKey=\"9\">\r\n                                <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                                <h4>Can I apply for a refund?</h4>\r\n                                </div>\r\n                            </Accordion.Toggle>\r\n                            <Accordion.Collapse eventKey=\"9\">\r\n                                <Card.Body>\r\n                                <div className=\"landing_faq-answer\">\r\n                                    <p>You are only eligible for a refund if you make a request for course cancellation within 1 week of commencement of lectures. After 1 week, you are not eligible to request a refund.</p>\r\n                                </div>\r\n                                </Card.Body>\r\n                            </Accordion.Collapse>\r\n                            </Card>\r\n                            <hr/>\r\n                            <h3>Lecture/Class Model</h3>\r\n                            <Card>\r\n                            <Accordion.Toggle as={Card.Header} eventKey=\"10\">\r\n                                <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                                <h4>Do I need to have any previous experience or knowledge before coming to learn?</h4>\r\n                                </div>\r\n                            </Accordion.Toggle>\r\n                            <Accordion.Collapse eventKey=\"10\">\r\n                                <Card.Body>\r\n                                <div className=\"landing_faq-answer\">\r\n                                    <p>Not at all. All our courses are designed to help people from any educational background and experience level achieve a successful career in IT.</p>\r\n                                </div>\r\n                                </Card.Body>\r\n                            </Accordion.Collapse>\r\n                            </Card>\r\n                            <hr/>\r\n                            <Card>\r\n                            <Accordion.Toggle as={Card.Header} eventKey=\"11\">\r\n                                <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                                <h4>Are classes virtual or physical?</h4>\r\n                                </div>\r\n                            </Accordion.Toggle>\r\n                            <Accordion.Collapse eventKey=\"11\">\r\n                                <Card.Body>\r\n                                <div className=\"landing_faq-answer\">\r\n                                    <p>For our Graduate Accelerator, classes are 100% physical at our location in Abeokuta and our undergraduate accelerator is held around the school area.</p>\r\n                                </div>\r\n                                </Card.Body>\r\n                            </Accordion.Collapse>\r\n                            </Card>\r\n                            <hr/>\r\n                            <Card>\r\n                            <Accordion.Toggle as={Card.Header} eventKey=\"12\">\r\n                                <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                                <h4>Can I take the course online?</h4>\r\n                                </div>\r\n                            </Accordion.Toggle>\r\n                            <Accordion.Collapse eventKey=\"12\">\r\n                                <Card.Body>\r\n                                <div className=\"landing_faq-answer\">\r\n                                    <p>No, you cannot. All courses are strictly onsite for now.</p>\r\n                                </div>\r\n                                </Card.Body>\r\n                            </Accordion.Collapse>\r\n                            </Card>\r\n                            <hr/>\r\n                            <Card>\r\n                            <Accordion.Toggle as={Card.Header} eventKey=\"13\">\r\n                                <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                                <h4>Can I take two courses at a time?</h4>\r\n                                </div>\r\n                            </Accordion.Toggle>\r\n                            <Accordion.Collapse eventKey=\"13\">\r\n                                <Card.Body>\r\n                                <div className=\"landing_faq-answer\">\r\n                                    <p>No, you cannot. This is because we want you to be focused and dedicated to a particular course and give it your best.</p>\r\n                                </div>\r\n                                </Card.Body>\r\n                            </Accordion.Collapse>\r\n                            </Card>\r\n                            <hr/>\r\n                            <Card>\r\n                            <Accordion.Toggle as={Card.Header} eventKey=\"14\">\r\n                                <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                                <h4>What course is right for me?</h4>\r\n                                </div>\r\n                            </Accordion.Toggle>\r\n                            <Accordion.Collapse eventKey=\"14\">\r\n                                <Card.Body>\r\n                                <div className=\"landing_faq-answer\">\r\n                                    <p>You can give us a call or chat with us for guidance.</p>\r\n                                </div>\r\n                                </Card.Body>\r\n                            </Accordion.Collapse>\r\n                            </Card>\r\n                            <hr/>\r\n                            <Card>\r\n                            <Accordion.Toggle as={Card.Header} eventKey=\"15\">\r\n                                <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                                <h4>What is the duration of the program?</h4>\r\n                                </div>\r\n                            </Accordion.Toggle>\r\n                            <Accordion.Collapse eventKey=\"15\">\r\n                                <Card.Body>\r\n                                <div className=\"landing_faq-answer\">\r\n                                    <p>Grazac Academy Graduate Accelerator runs for 4 months (3 months of training and 1 month internship) while our Undergraduate Accelerator runs for 2 months (Weekends only)</p>\r\n                                </div>\r\n                                </Card.Body>\r\n                            </Accordion.Collapse>\r\n                            </Card>\r\n                            <hr/>\r\n                            <Card>\r\n                            <Accordion.Toggle as={Card.Header} eventKey=\"16\">\r\n                                <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                                <h4>What is the internship like?</h4>\r\n                                </div>\r\n                            </Accordion.Toggle>\r\n                            <Accordion.Collapse eventKey=\"16\">\r\n                                <Card.Body>\r\n                                <div className=\"landing_faq-answer\">\r\n                                    <p>You will be grouped into teams alongside other learners to work on real-life projects within the organization.</p>\r\n                                </div>\r\n                                </Card.Body>\r\n                            </Accordion.Collapse>\r\n                            </Card>\r\n                            <hr/>\r\n                            <Card>\r\n                            <Accordion.Toggle as={Card.Header} eventKey=\"17\">\r\n                                <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                                <h4>What courses do you offer?</h4>\r\n                                </div>\r\n                            </Accordion.Toggle>\r\n                            <Accordion.Collapse eventKey=\"17\">\r\n                                <Card.Body>\r\n                                <div className=\"landing_faq-answer\">\r\n                                    <p>Our courses are:</p>\r\n                                    <p>Product Designing</p>\r\n                                    <p>Brand Identity Designing</p>\r\n                                    <p>Digital Marketing</p>\r\n                                    <p>Front-end Web Development (HTML, CSS, Javascript (ReactJS))</p>\r\n                                    <p>Back-end Web Development with Nodejs.</p>\r\n                                    <p>Mobile Application Development (Android with Kotlin)</p>\r\n                                </div>\r\n                                </Card.Body>\r\n                            </Accordion.Collapse>\r\n                            </Card>\r\n                            <hr/>\r\n                            <Card>\r\n                            <Accordion.Toggle as={Card.Header} eventKey=\"18\">\r\n                                <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                                <h4>Can I enroll as a secondary school leaver?</h4>\r\n                                </div>\r\n                            </Accordion.Toggle>\r\n                            <Accordion.Collapse eventKey=\"18\">\r\n                                <Card.Body>\r\n                                <div className=\"landing_faq-answer\">\r\n                                    <p>No, you cannot but the good news is that we are currently working on bringing up an academy program for secondary school leavers. Follow us @grazacacademy on instagram for more updates.</p>\r\n                                </div>\r\n                                </Card.Body>\r\n                            </Accordion.Collapse>\r\n                            </Card>\r\n                            <hr/>\r\n                            <Card>\r\n                            <Accordion.Toggle as={Card.Header} eventKey=\"19\">\r\n                                <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                                <h4>What materials do I need to enroll for the course?</h4>\r\n                                </div>\r\n                            </Accordion.Toggle>\r\n                            <Accordion.Collapse eventKey=\"19\">\r\n                                <Card.Body>\r\n                                <div className=\"landing_faq-answer\">\r\n                                    <p>You need a functional laptop and a ready to learn mindset.</p>\r\n                                </div>\r\n                                </Card.Body>\r\n                            </Accordion.Collapse>\r\n                            </Card>\r\n                            <hr/>\r\n                            <Card>\r\n                            <Accordion.Toggle as={Card.Header} eventKey=\"20\">\r\n                                <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                                <h4>How accessible are the tutors?</h4>\r\n                                </div>\r\n                            </Accordion.Toggle>\r\n                            <Accordion.Collapse eventKey=\"20\">\r\n                                <Card.Body>\r\n                                <div className=\"landing_faq-answer\">\r\n                                    <p>Our tutors are always available to respond swiftly to all your questions and offer you support.</p>\r\n                                </div>\r\n                                </Card.Body>\r\n                            </Accordion.Collapse>\r\n                            </Card>\r\n                            <hr/>\r\n                            <Card>\r\n                            <Accordion.Toggle as={Card.Header} eventKey=\"21\">\r\n                                <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                                <h4>How can I defer a course?</h4>\r\n                                </div>\r\n                            </Accordion.Toggle>\r\n                            <Accordion.Collapse eventKey=\"21\">\r\n                                <Card.Body>\r\n                                <div className=\"landing_faq-answer\">\r\n                                    <p>There is no opportunity to defer a course.</p>\r\n                                </div>\r\n                                </Card.Body>\r\n                            </Accordion.Collapse>\r\n                            </Card>\r\n                            <hr/>\r\n                            <Card>\r\n                            <Accordion.Toggle as={Card.Header} eventKey=\"22\">\r\n                                <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                                <h4>What happens If I miss a class due to an emergency?</h4>\r\n                                </div>\r\n                            </Accordion.Toggle>\r\n                            <Accordion.Collapse eventKey=\"22\">\r\n                                <Card.Body>\r\n                                <div className=\"landing_faq-answer\">\r\n                                    <p>Follow up with what you have missed when you return to class. It is advisable to inform your tutor in case of an emergency.</p>\r\n                                </div>\r\n                                </Card.Body>\r\n                            </Accordion.Collapse>\r\n                            </Card>\r\n                            <hr/>\r\n                            <Card>\r\n                            <Accordion.Toggle as={Card.Header} eventKey=\"23\">\r\n                                <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                                <h4>Can I enroll for Graduate Accelerator If I am yet to go for NYSC?</h4>\r\n                                </div>\r\n                            </Accordion.Toggle>\r\n                            <Accordion.Collapse eventKey=\"23\">\r\n                                <Card.Body>\r\n                                <div className=\"landing_faq-answer\">\r\n                                    <p>Yes, if you will be available all through the period of the training which is four (4) months</p>\r\n                                </div>\r\n                                </Card.Body>\r\n                            </Accordion.Collapse>\r\n                            </Card>\r\n                            <hr/>\r\n                            <Card>\r\n                            <Accordion.Toggle as={Card.Header} eventKey=\"24\">\r\n                                <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                                <h4>What days of the week do the classes hold?</h4>\r\n                                </div>\r\n                            </Accordion.Toggle>\r\n                            <Accordion.Collapse eventKey=\"24\">\r\n                                <Card.Body>\r\n                                <div className=\"landing_faq-answer\">\r\n                                    <p>Classes are held at least 3 times a week.</p>\r\n                                </div>\r\n                                </Card.Body>\r\n                            </Accordion.Collapse>\r\n                            </Card>\r\n                            <hr/>\r\n                            <Card>\r\n                            <Accordion.Toggle as={Card.Header} eventKey=\"25\">\r\n                                <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                                <h4>Is there an option for a full-time worker?</h4>\r\n                                </div>\r\n                            </Accordion.Toggle>\r\n                            <Accordion.Collapse eventKey=\"25\">\r\n                                <Card.Body>\r\n                                <div className=\"landing_faq-answer\">\r\n                                    <p>No, we currently run 100% physical classes.</p>\r\n                                </div>\r\n                                </Card.Body>\r\n                            </Accordion.Collapse>\r\n                            </Card>\r\n                            <hr/>\r\n                            <h3>Graduation and Certification</h3>\r\n                            <Card>\r\n                            <Accordion.Toggle as={Card.Header} eventKey=\"26\">\r\n                                <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                                <h4>Will the certificate be recognized locally and globally?</h4>\r\n                                </div>\r\n                            </Accordion.Toggle>\r\n                            <Accordion.Collapse eventKey=\"26\">\r\n                                <Card.Body>\r\n                                <div className=\"landing_faq-answer\">\r\n                                    <p>Yes. Grazac is a corporate organisation incorporated under the COMPANIES AND ALLIED MATTERS act 1990 and the company is limited by shares with RC 1643778.</p>\r\n                                </div>\r\n                                </Card.Body>\r\n                            </Accordion.Collapse>\r\n                            </Card>\r\n                            <hr/>\r\n                            <Card>\r\n                            <Accordion.Toggle as={Card.Header} eventKey=\"27\">\r\n                                <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                                <h4>What’s the probability that I will be good after enrolling for Grazac Academy?</h4>\r\n                                </div>\r\n                            </Accordion.Toggle>\r\n                            <Accordion.Collapse eventKey=\"27\">\r\n                                <Card.Body>\r\n                                <div className=\"landing_faq-answer\">\r\n                                    <p>We have been training youths since 2019 and our success stories speak for us. What differentiates us from other academy is we are practical oriented and what gives us joy is seeing our students making a living after graduating.</p>\r\n                                </div>\r\n                                </Card.Body>\r\n                            </Accordion.Collapse>\r\n                            </Card>\r\n                            <hr/>\r\n                            <Card>\r\n                            <Accordion.Toggle as={Card.Header} eventKey=\"28\">\r\n                                <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                                <h4>What happens if I fail an exam?</h4>\r\n                                </div>\r\n                            </Accordion.Toggle>\r\n                            <Accordion.Collapse eventKey=\"28\">\r\n                                <Card.Body>\r\n                                <div className=\"landing_faq-answer\">\r\n                                    <p>We will give you 1 month to revise what you have learnt and after 1 month, we will conduct another exam for you at no extra cost.</p>\r\n                                </div>\r\n                                </Card.Body>\r\n                            </Accordion.Collapse>\r\n                            </Card>\r\n                            <hr/>\r\n                            <Card>\r\n                            <Accordion.Toggle as={Card.Header} eventKey=\"29\">\r\n                                <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                                <h4>What kind of certificate do I get (Soft or Hard Copy)?</h4>\r\n                                </div>\r\n                            </Accordion.Toggle>\r\n                            <Accordion.Collapse eventKey=\"29\">\r\n                                <Card.Body>\r\n                                <div className=\"landing_faq-answer\">\r\n                                    <p>For undergraduates, you get a soft copy immediately and a hard copy at our next annual event (Ogun Digital Summit).</p>\r\n                                <p>For graduates, you get both soft copy and hard copy upon successful graduation.</p>\r\n                                </div>\r\n                                </Card.Body>\r\n                            </Accordion.Collapse>\r\n                            </Card>\r\n                            <hr/>\r\n                            <Card>\r\n                            <Accordion.Toggle as={Card.Header} eventKey=\"30\">\r\n                                <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                                <h4>When do I get my certificate?</h4>\r\n                                </div>\r\n                            </Accordion.Toggle>\r\n                            <Accordion.Collapse eventKey=\"30\">\r\n                                <Card.Body>\r\n                                <div className=\"landing_faq-answer\">\r\n                                    <p>You get the soft copy certificate upon successful graduation.</p>\r\n                                </div>\r\n                                </Card.Body>\r\n                            </Accordion.Collapse>\r\n                            </Card>\r\n                            <hr/>\r\n                            <Card>\r\n                            <Accordion.Toggle as={Card.Header} eventKey=\"31\">\r\n                                <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                                <h4>Is a job guaranteed for me after taking the course?</h4>\r\n                                </div>\r\n                            </Accordion.Toggle>\r\n                            <Accordion.Collapse eventKey=\"31\">\r\n                                <Card.Body>\r\n                                <div className=\"landing_faq-answer\">\r\n                                    <p>For our graduate accelerator, yes!! We outsource all successful graduates to both local and global companies.</p>\r\n                                    <p>For our Undergraduate accelerator, whenever we are taking interns, we consider our undergraduate students first and we also share job opportunities with their community group</p>\r\n                                    <p>For employment offer, we put all our academy students first.</p>\r\n                                </div>\r\n                                </Card.Body>\r\n                            </Accordion.Collapse>\r\n                            </Card>\r\n                            <hr/>\r\n                            <Card>\r\n                            <Accordion.Toggle as={Card.Header} eventKey=\"32\">\r\n                                <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                                <h4>What are the prerequisites for graduation?</h4>\r\n                                </div>\r\n                            </Accordion.Toggle>\r\n                            <Accordion.Collapse eventKey=\"32\">\r\n                                <Card.Body>\r\n                                <div className=\"landing_faq-answer\">\r\n                                    <p>Students must have at least 90% attendance and 70% in projects and challenges.</p>\r\n                                </div>\r\n                                </Card.Body>\r\n                            </Accordion.Collapse>\r\n                            </Card>\r\n                        </Accordion>\r\n                        <hr/>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n            <Footer/>\r\n        </div>\r\n    );\r\n}\r\n\r\nexport default Faq;","C:\\Users\\Dabiri Mayowa\\Desktop\\Grazac\\grazac-academy-web\\src\\pages\\UndergraduateAccelerator.js",["173","174","175","176"],"import React, {useState} from \"react\";\r\nimport {Link} from \"react-router-dom\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport NeedAdvice from \"../components/NeedAdvice\";\r\nimport Qualities from \"../components/Qualities\";\r\n\r\nimport undergraduate from \"../images/undergraduate.png\";\r\nimport loader from \"../images/loader.gif\";\r\nimport SchoolList from \"../components/SchoolList\";\r\n\r\nconst UndergraduateAccelerator = () => {\r\n    const [courses, setCourses] = useState([]);\r\n    const [openListModal, setOpenListModal] = useState(false);\r\n\r\n    React.useEffect(() => {\r\n        document.title = 'Undergraduate Accelerator Track - Grazac Academy';\r\n        window.scrollTo(0,0);\r\n        var blur = document.getElementById('blur');\r\n        blur.classList.add('blur-active');\r\n        \r\n        fetch('https://grazacacademy.com/undergraduate/courses')\r\n            .then(resp => resp.json())\r\n            .then(resp => {\r\n                setCourses(resp.data);\r\n                blur.classList.remove('blur-active');\r\n            })\r\n            .catch(error => {\r\n                console.log('An error occurred when fetching the available courses, refreshing...')\r\n                window.location.reload();\r\n            })\r\n    }, []);\r\n\r\n    return(\r\n        <div>\r\n            {courses.length ? (<div></div>) : (\r\n                <div>\r\n                <img src={loader} alt=\"loader\" className=\"loader-top\" />\r\n                </div>\r\n            )}\r\n        <div id=\"blur\">\r\n            <Navbar/>\r\n            <div className=\"gua\">\r\n                <div className=\"gua_hero\">\r\n                    <div className=\"container\">\r\n                        <div className=\"row\">\r\n                            <div className=\"col-sm-6\">\r\n                                <div className=\"gua_hero-text\">\r\n                                    <div className=\"gua_hero-text-b\">\r\n                                        <h1>\r\n                                            Undergraduate Accelerator Plan\r\n                                        </h1>\r\n                                        <p>We equip you to be an asset in the digital age before leaving the four walls of school and we believe the future of work will be strictly skill-based. Join thousands of young undergraduates to build a career in technology and be mentored by industry experts.\r\n                                        </p>\r\n                                        <div className=\"contact_hero-privacy\" >\r\n                                            <a href=\"#courses\"  className=\"download-brochure\">Join Us Today!</a>\r\n                                            <Link to=\"/lead\"><button>Apply as Lead</button></Link>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div>\r\n                                <img src={undergraduate} alt=\"undergraduate\"  className=\"gua_hero-image\" />\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"container\">\r\n                    <div className=\"gga\">\r\n                        <div className=\"course_mode-intro course_mode-intro\">\r\n                            <h4 style={{marginTop:'100px'}}>We are preparing you for the future of work</h4>\r\n                            <h2>Join our community</h2>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"gua_highlight\">\r\n                        <div className=\"boxes44 gua_highlight-box1\">\r\n                            <div className=\"gua_highlight-box3\">\r\n                                <div className=\"gua_highlight-box4\">\r\n                                    <h3><strong>Student Lead</strong></h3>\r\n                                    <p>Become our ambassador in your institution. </p>\r\n                                    <p>Lead other students who are ready to prepare themselves for the future of work.</p>\r\n                                    <Link to=\"/lead\"><a className=\"white-link\">Apply as Student Lead</a></Link>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                        <div className=\"boxes44 gua_highlight-box2\">\r\n                            <div  className=\"gua_highlight-box3\">\r\n                                <div className=\"gua_highlight-box4\">\r\n                                    <h3><strong>Affiliated Campuses</strong></h3>\r\n                                    <p>We are well represented in various institutions of learning across Nigeria.</p>\r\n                                    <p>We want to prepare you for the future of work before you leave the four walls of learning.</p>\r\n                                    <a className=\"white-link\" onClick={() => setOpenListModal(true)}>Learn More</a>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"background1\" id=\"courses\">\r\n                    <div className=\"container\">\r\n                        <div className=\"gga\">\r\n                            <div className=\"course_mode-intro course_mode-intro\">\r\n                                <h2>Available Courses</h2>\r\n                            </div>\r\n                            <div className=\"gga_container\">\r\n                                {courses.length ? \r\n                                    courses.map((item,index) => (\r\n                                    <div className=\"boxes33\" key={index}>\r\n                                        <div className=\"gua_cardview\">\r\n                                            <div className=\"gua_cardview-box\">\r\n                                                <img src={item.thumb} alt=\"course-desc\" />\r\n                                            </div>\r\n                                            <div className=\"gua_cardview-text\">\r\n                                                <h4>{item.name}</h4>\r\n                                                <p>{item.description}</p>\r\n                                                <Link to={\"/course-detail-undergraduate?course=\"+item.slug}><a>Learn More</a></Link>\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>)) :\r\n                                    <div>\r\n                                        {/* <img src={loader} alt=\"loader\" className=\"loader\" /> */}\r\n                                    </div>\r\n                                }\r\n                                <div className=\"boxes33\">\r\n                                    <div className=\"gua_cardview\">\r\n                                        <div className=\"gua_cardview-text\">\r\n                                            <h4>Can't find a course you are interested in?</h4>\r\n                                            <p>We will be glad if you can suggest the course you'd love to learn.</p>\r\n                                            <Link to=\"/contact\"><a>Contact Us</a></Link>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <Qualities />\r\n                <NeedAdvice />\r\n            </div>\r\n            <Footer/>\r\n\r\n           { openListModal && <SchoolList onOpen={e => setOpenListModal(e)}/> }\r\n        </div>\r\n        </div>\r\n    );\r\n}\r\n\r\nexport default UndergraduateAccelerator;","C:\\Users\\Dabiri Mayowa\\Desktop\\Grazac\\grazac-academy-web\\src\\pages\\GraduateCoursePayment.js",[],"C:\\Users\\Dabiri Mayowa\\Desktop\\Grazac\\grazac-academy-web\\src\\pages\\UndergraduateCoursePayment.js",["177","178"],"import { useState, useEffect } from \"react\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport { useFlutterwave, closePaymentModal } from 'flutterwave-react-v3';\r\nimport { useParams } from \"react-router-dom\";\r\n\r\nconst UndergraduateCoursePayment = () => {\r\n  const { id } = useParams();\r\n  const [fetched, setFetched] = useState({});\r\n  const [payment, setPayment] = useState(true);\r\n\r\n  useEffect(() => {\r\n    document.title = 'Payment - Grazac Academy'\r\n    fetch(`https://grazacacademy.com/undergraduate/registration/details/${id}`)\r\n    .then(resp => resp.json())\r\n    .then(data => {\r\n      setFetched(data.data)\r\n      if(data.data.tx_ref.length) {\r\n        document.querySelector(\".form-info\").textContent = \"You have completed your registration\";\r\n        setPayment(false);\r\n      } \r\n    })\r\n    .catch(err => {\r\n      document.querySelector(\".form-info\").textContent = \"Something went wrong, refreshing...\";\r\n      //window.location.reload();\r\n      document.querySelector(\"#form-btn\").setAttribute('disabled', 'disabled');\r\n    })\r\n  }, []);\r\n\r\n  const config = {\r\n    public_key: 'FLWPUBK-006bdc82ad878f1518af32f44af6478f-X',\r\n    tx_ref: Date.now(),\r\n    amount: fetched.tuition,\r\n    currency: 'NGN',\r\n    payment_options: 'card,mobilemoney,ussd',\r\n    customer: {\r\n      email: fetched.email,\r\n      phonenumber: fetched.phone,\r\n      name: fetched.firstname + \" \" + fetched.lastname,\r\n    },\r\n    customizations: {\r\n      title: 'Grazac Undergraduate Accelerator Plan',\r\n      description: `Payment for ${fetched.course} at Grazac Undergraduate Accelerator Plan`,\r\n      logo: 'https://grazac.com.ng/assets/images/favicon.png',\r\n    },\r\n  };\r\n\r\n  const handleFlutterPayment = useFlutterwave(config);\r\n\r\n  const onSubmit = () => {\r\n    if(payment) {\r\n      handleFlutterPayment({\r\n        callback: (response) => {\r\n            if (response.status === 'successful') {\r\n              fetch(\"https://grazacacademy.com/undergraduate/registration/update\", {\r\n                method: 'POST',\r\n                headers: {\r\n                'Content-Type': 'application/json'\r\n                },\r\n                body: JSON.stringify({\r\n                  firstname: fetched.firstname,\r\n                  email: fetched.email,\r\n                  course: fetched.course,\r\n                  tx_ref: response.tx_ref,\r\n                  id: id\r\n                })\r\n              })\r\n              .then(resp => resp.json())\r\n              .then(data => {\r\n                if(data.success === true) {\r\n                  document.querySelector(\".form-info\").textContent = \"Your payment was successful.\";\r\n                }\r\n              })\r\n            };\r\n            closePaymentModal() // this will close the modal programmatically\r\n        },\r\n        onClose: () => {\r\n\r\n        },\r\n      });\r\n  } else {\r\n    alert('You have completed your registration');\r\n  }\r\n  }\r\n\r\n  return (\r\n    <div>\r\n      <Navbar/>\r\n        <div>\r\n          <div className=\"contact_layer\">\r\n            <div className=\"form_top\">\r\n              <div>\r\n                <h1>Payment</h1>\r\n              </div>\r\n              </div>\r\n              <div className=\"container\">\r\n                <div className=\"form\">\r\n                  <div className=\"form-info\">Click on Pay Now to finalize your payment.</div>\r\n                  <div className=\"form-flexdiv\">\r\n                    <div className=\"form-flexdiv-1\" >\r\n                      <label>First Name  <span>*</span></label>\r\n                      <input className=\"input\" type=\"text\" maxLength=\"30\" readOnly value={fetched.firstname} style={{textTransform: \"capitalize\"}}/>\r\n                    </div>\r\n                      <div className=\"form-flexdiv-2\">\r\n                          <label>Last Name  <span>*</span></label>\r\n                          <input className=\"input\" type=\"text\" maxLength=\"30\" readOnly value={fetched.lastname} style={{textTransform: \"capitalize\"}}/>\r\n                      </div>\r\n                    </div>\r\n                      <div className=\"form-flexdiv\">\r\n                          <div className=\"form-flexdiv-1\" >\r\n                              <label>Mobile Number  <span>*</span></label>\r\n                              <input className=\"input\" type=\"text\" maxLength=\"11\" readOnly value={fetched.phone}/>\r\n                          </div>\r\n                          <div className=\"form-flexdiv-2\">\r\n                              <label>Email  <span>*</span></label>\r\n                              <input className=\"input\" type=\"email\" maxLength=\"30\" readOnly value={fetched.email}/>\r\n                          </div>\r\n                      </div>\r\n                      <div>\r\n                          <label>Select your institution  <span>*</span></label><br/>\r\n                          <input className=\"input\" type=\"text\" readOnly value={fetched.institution}/>\r\n                      </div>\r\n                      <div>\r\n                          <label>Kindly choose your preferred course  <span>*</span></label><br/>\r\n                          <input className=\"input\" type=\"text\" readOnly value={fetched.course}/>\r\n                      </div>\r\n                      <div>\r\n                          <label>Amount</label><br/>\r\n                          <p className=\"show-amount\">\r\n                              ₦{ new Intl.NumberFormat().format(fetched.tuition) }\r\n                          </p>\r\n                      </div>\r\n                     \r\n                      <div className=\"form-privacy\" >\r\n                        <a className=\"download-brochure\" onClick={onSubmit} id=\"form-btn\">Pay Now</a>\r\n                      </div>\r\n                  </div>\r\n              </div>\r\n          </div>\r\n        </div>\r\n        <Footer/>\r\n    </div>\r\n  )\r\n}\r\n\r\nexport default UndergraduateCoursePayment;","C:\\Users\\Dabiri Mayowa\\Desktop\\Grazac\\grazac-academy-web\\src\\pages\\LeadForm.js",[],"C:\\Users\\Dabiri Mayowa\\Desktop\\Grazac\\grazac-academy-web\\src\\pages\\UndergraduateForm.js",[],"C:\\Users\\Dabiri Mayowa\\Desktop\\Grazac\\grazac-academy-web\\src\\pages\\ComingSoon.js",[],"C:\\Users\\Dabiri Mayowa\\Desktop\\Grazac\\grazac-academy-web\\src\\pages\\GraduateForm.js",["179","180"],"import { useEffect, useRef, useState } from \"react\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport axios from \"axios\";\r\n\r\nconst GraduateForm = () => {\r\n  const [firstname, setFirstName] = useState(\"\");\r\n  const [lastname, setLastName] = useState(\"\");\r\n  const [phone, setPhone] = useState(\"\");\r\n  const [email, setEmail] = useState(\"\");\r\n  const [plan, setPlan] = useState(\"full-time\");\r\n  const [availability, setAvailability] = useState(\"\");\r\n  const [amount, setAmount] = useState(\"\");\r\n  const [course, setCourse] = useState(\"\");\r\n  const [paymentPlan, setPaymentPlan] = useState(\"\");\r\n  const [message, setMessage] = useState(\"\");\r\n  const [fetchCourses, setFetched] = useState([]);\r\n  const formInfo = useRef();\r\n  const [showPayment, setShowPayment] = useState(true);\r\n\r\n  useEffect(() => {\r\n    document.title = \"Join our Graduate Track - Grazac Academy\";\r\n    window.scrollTo(0, 0);\r\n    const method = window.location.search.substring(9);\r\n    if (method) {\r\n      setPaymentPlan(method);\r\n      setShowPayment(false);\r\n    }\r\n    fetch(\"https://grazacacademy.com/graduate/courses\")\r\n      .then((resp) => resp.json())\r\n      .then((resp) => {\r\n        setFetched(resp.data);\r\n      })\r\n      .catch((error) => {\r\n        console.log(\r\n          \"An error occurred when fetching course details, refreshing...\"\r\n        );\r\n        window.location.reload();\r\n      });\r\n  }, []);\r\n\r\n  const courseChange = (e) => {\r\n    setCourse(e.target.value);\r\n    var rc = e.target.options[e.target.selectedIndex].dataset.index;\r\n    setAmount(fetchCourses[rc].discounted_tuition);\r\n  };\r\n\r\n  const choosePlan = (e) => {\r\n    setPaymentPlan(e.target.value);\r\n  };\r\n\r\n  const onSubmit = (e) => {\r\n    e.preventDefault();\r\n    if (amount) {\r\n      window.scroll(0, formInfo.current.offsetTop);\r\n      document.querySelector(\".form-info\").textContent =\r\n        \"Submitting, please wait...\";\r\n      document\r\n        .querySelector(\"#submit-btn\")\r\n        .setAttribute(\"disabled\", \"disabled\");\r\n      fetch(\"https://grazacacademy.com/graduate/register\", {\r\n        method: \"POST\",\r\n        headers: {\r\n          \"Content-Type\": \"application/json\",\r\n        },\r\n        body: JSON.stringify({\r\n          firstname: firstname,\r\n          lastname: lastname,\r\n          email: email,\r\n          phone: phone,\r\n          availability: availability,\r\n          course: course,\r\n          package: plan,\r\n          expectation: message,\r\n          tuition: amount,\r\n        }),\r\n      })\r\n        .then((resp) => resp.json())\r\n        .then((data) => {\r\n          if (data.success === true) {\r\n            document.querySelector(\".form-info\").textContent =\r\n              \"Your registration was successful, kindly check your mailbox for further details\";\r\n            document.querySelector(\"#submit-btn\").removeAttribute(\"disabled\");\r\n            setFirstName(\"\");\r\n            setLastName(\"\");\r\n            setMessage(\"\");\r\n            setPhone(\"\");\r\n            setEmail(\"\");\r\n            setCourse(\"\");\r\n          } else {\r\n            document.querySelector(\".form-info\").textContent = data.msg;\r\n            document.querySelector(\"#submit-btn\").removeAttribute(\"disabled\");\r\n          }\r\n        })\r\n        .catch((err) => {\r\n          document.querySelector(\".form-info\").textContent =\r\n            \"Something went wrong, please try again\";\r\n          document.querySelector(\"#submit-btn\").removeAttribute(\"disabled\");\r\n        });\r\n      let formData = new FormData();\r\n\r\n      formData.append(\"name\", firstname);\r\n      formData.append(\"email\", email);\r\n      axios\r\n        .post(\"http://grazac.com.ng/newsletter/subscribe\", formData, {\r\n          headers: {\r\n            \"Content-Type\": \"application/json\",\r\n          },\r\n        })\r\n        .then((resp) => resp.data)\r\n        .then((data) => {\r\n          console.log(data);\r\n          if (data.success === true) {\r\n            console.log(\"Added to newsletter\");\r\n          } else {\r\n            console.log(\"Not Added to newsletter\");\r\n          }\r\n        })\r\n        .catch((err) => {\r\n          console.log(`An error occured, please try again ${err}`);\r\n        });\r\n    } else {\r\n      alert(\"Please select a course\");\r\n    }\r\n  };\r\n\r\n  return (\r\n    <div>\r\n      <Navbar />\r\n      <div>\r\n        <div className=\"contact_layer\">\r\n          <div className=\"form_top\">\r\n            <div>\r\n              <h1>Grazac Academy Graduate Accelerator</h1>\r\n              <p>\r\n                We are bridging the gap between unemployment and entry-level\r\n                jobs in the technology industry.\r\n              </p>\r\n            </div>\r\n          </div>\r\n          <div className=\"container\" ref={formInfo}>\r\n            <div className=\"form\">\r\n              <form onSubmit={onSubmit}>\r\n                <div className=\"form-info\">\r\n                  Note: Fields with <span>*</span> are required\r\n                </div>\r\n                <div className=\"form-flexdiv\">\r\n                  <div className=\"form-flexdiv-1\">\r\n                    <label>\r\n                      First Name <span>*</span>\r\n                    </label>\r\n                    <input\r\n                      className=\"input\"\r\n                      type=\"text\"\r\n                      placeholder=\"ex. John\"\r\n                      value={firstname}\r\n                      onChange={(e) => setFirstName(e.target.value)}\r\n                      required=\"required\"\r\n                    />\r\n                  </div>\r\n                  <div className=\"form-flexdiv-2\">\r\n                    <label>\r\n                      Last Name <span>*</span>\r\n                    </label>\r\n                    <input\r\n                      className=\"input\"\r\n                      type=\"text\"\r\n                      placeholder=\"ex. Doe\"\r\n                      value={lastname}\r\n                      onChange={(e) => setLastName(e.target.value)}\r\n                      required=\"required\"\r\n                    />\r\n                  </div>\r\n                </div>\r\n                <div className=\"form-flexdiv\">\r\n                  <div className=\"form-flexdiv-1\">\r\n                    <label>\r\n                      Mobile Number <span>*</span>\r\n                    </label>\r\n                    <input\r\n                      className=\"input\"\r\n                      type=\"text\"\r\n                      placeholder=\"ex. 08133333333\"\r\n                      value={phone}\r\n                      onChange={(e) => setPhone(e.target.value)}\r\n                      required=\"required\"\r\n                    />\r\n                  </div>\r\n                  <div className=\"form-flexdiv-2\">\r\n                    <label>\r\n                      Email <span>*</span>\r\n                    </label>\r\n                    <input\r\n                      className=\"input\"\r\n                      type=\"text\"\r\n                      placeholder=\"ex. john@gmail.com\"\r\n                      value={email}\r\n                      onChange={(e) => setEmail(e.target.value)}\r\n                      required=\"required\"\r\n                    />\r\n                  </div>\r\n                </div>\r\n                <div>\r\n                  <label>\r\n                    Our classes will be on Monday, Wednesdays and Fridays, will\r\n                    you be available? <span>*</span>\r\n                  </label>\r\n                  <br />\r\n                  <label>\r\n                    <input\r\n                      type=\"radio\"\r\n                      className=\"radio-input\"\r\n                      id=\"yes\"\r\n                      name=\"availability\"\r\n                      value=\"1\"\r\n                      required=\"required\"\r\n                      checked={availability === \"1\"}\r\n                      onChange={(e) => setAvailability(e.target.value)}\r\n                    />\r\n                    Yes\r\n                  </label>\r\n                  <label>\r\n                    <input\r\n                      type=\"radio\"\r\n                      className=\"radio-input\"\r\n                      id=\"no\"\r\n                      name=\"availability\"\r\n                      value=\"0\"\r\n                      required=\"required\"\r\n                      checked={availability === \"0\"}\r\n                      onChange={(e) => setAvailability(e.target.value)}\r\n                      style={{ marginLeft: \"30px\" }}\r\n                    />\r\n                    No\r\n                  </label>\r\n                </div>\r\n                <div>\r\n                  <label>\r\n                    Kindly choose your preferred course <span>*</span>\r\n                  </label>\r\n                  <br />\r\n                  <select\r\n                    className=\"input\"\r\n                    onChange={courseChange}\r\n                    required=\"required\"\r\n                  >\r\n                    <option value=\"\">---Choose course---</option>\r\n                    {fetchCourses.map((item, index) => (\r\n                      <option key={index} data-index={index}>\r\n                        {item.name}\r\n                      </option>\r\n                    ))}\r\n                  </select>\r\n                </div>\r\n                {showPayment && (\r\n                  <div>\r\n                    <label>\r\n                      Kindly choose your preferred payment plan <span>*</span>\r\n                    </label>\r\n                    <br />\r\n                    <select\r\n                      className=\"input\"\r\n                      onChange={choosePlan}\r\n                      required=\"required\"\r\n                    >\r\n                      <option value=\"\">---Choose Plan---</option>\r\n                      <option>Full Payment</option>\r\n                      <option>Installmental Payment</option>\r\n                      {/* <option>Income Split Agreement</option> */}\r\n                    </select>\r\n                  </div>\r\n                )}\r\n                <div>\r\n                  <label>Amount</label>\r\n                  <br />\r\n                  <p className=\"show-amount\">\r\n                    ₦{amount ? new Intl.NumberFormat().format(amount) : \"0\"}\r\n                  </p>\r\n                </div>\r\n                {/* <div>\r\n                  <label>\r\n                    Kindly select a package. Our Part-time students have on-site\r\n                    classes only on Saturdays.{\" \"}\r\n                  </label>\r\n                  <br />\r\n                  <label>\r\n                    <input\r\n                      type=\"radio\"\r\n                      className=\"radio-input\"\r\n                      id=\"full-time\"\r\n                      name=\"plan\"\r\n                      value=\"full-time\"\r\n                      checked={plan === \"full-time\"}\r\n                      onChange={(e) => setPlan(e.target.value)}\r\n                      required=\"required\"\r\n                    />\r\n                    Full time\r\n                  </label>\r\n                  <label>\r\n                    <input\r\n                      type=\"radio\"\r\n                      className=\"radio-input\"\r\n                      id=\"part-time\"\r\n                      name=\"plan\"\r\n                      value=\"part-time\"\r\n                      checked={plan === \"part-time\"}\r\n                      onChange={(e) => setPlan(e.target.value)}\r\n                      style={{ marginLeft: \"30px\" }}\r\n                      required=\"required\"\r\n                    />\r\n                    Part time\r\n                  </label>\r\n                </div> */}\r\n                <div>\r\n                  <label>\r\n                    What do you expect at the end of this training?{\" \"}\r\n                    <span>*</span>\r\n                  </label>\r\n                  <textarea\r\n                    type=\"text\"\r\n                    placeholder=\"Say something ...\"\r\n                    value={message}\r\n                    onChange={(e) => setMessage(e.target.value)}\r\n                    required=\"required\"\r\n                  />\r\n                </div>\r\n                <div className=\"form-privacy\">\r\n                  <button\r\n                    className=\"download-brochure\"\r\n                    type=\"submit\"\r\n                    id=\"submit-btn\"\r\n                  >\r\n                    Register\r\n                  </button>\r\n                </div>\r\n              </form>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <Footer />\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default GraduateForm;\r\n","C:\\Users\\Dabiri Mayowa\\Desktop\\Grazac\\grazac-academy-web\\src\\pages\\InternshipForm.js",["181","182"],"import { useEffect, useRef, useState } from \"react\";\r\nimport { useFlutterwave, closePaymentModal } from 'flutterwave-react-v3';\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\n\r\nconst InternshipForm = () => {\r\n  const [firstname, setFirstName] = useState(\"\");\r\n  const [lastname, setLastName] = useState(\"\");\r\n  const [phone, setPhone] = useState(\"\");\r\n  const [email, setEmail] = useState(\"\");\r\n  const [availability, setAvailability] = useState(\"\");\r\n  const [amount, setAmount] = useState(40000);\r\n  const [course, setCourse] = useState(\"\");\r\n  const [message, setMessage] = useState(\"\");\r\n  const [fetchCourses, setFetched] = useState([]);\r\n  const formInfo = useRef();\r\n\r\n  useEffect(() => {\r\n    document.title = \"Internship Application - Grazac Academy\";\r\n    window.scrollTo(0, 0);\r\n    fetch(\"https://grazacacademy.com/graduate/courses\")\r\n      .then((resp) => resp.json())\r\n      .then((resp) => {\r\n        setFetched(resp.data);\r\n      })\r\n      .catch((error) => {\r\n        console.log(\r\n          \"An error occurred when fetching course details, refreshing...\"\r\n        );\r\n        window.location.reload();\r\n      });\r\n  }, []);\r\n\r\n  const config = {\r\n    public_key: 'FLWPUBK-006bdc82ad878f1518af32f44af6478f-X',\r\n    tx_ref: Date.now(),\r\n    amount: amount,\r\n    currency: 'NGN',\r\n    payment_options: 'card,mobilemoney,ussd',\r\n    customer: {\r\n      email: email,\r\n      phonenumber: phone,\r\n      name: firstname + \" \" + lastname,\r\n    },\r\n    customizations: {\r\n      title: 'Grazac Internship',\r\n      description: `Payment for ${course} at Grazac Internship`,\r\n      logo: 'https://grazac.com.ng/assets/images/favicon.png',\r\n    },\r\n  };\r\n\r\n  const handleFlutterPayment = useFlutterwave(config);\r\n\r\n  const onSubmit = (e) => {\r\n    e.preventDefault();\r\n    if ( availability === \"1\" ) {\r\n      var elmnt = document.getElementById(\"form_top\");\r\n      elmnt.scrollIntoView();\r\n      //window.scroll(0, formInfo.current.offsetTop);\r\n      handleFlutterPayment({\r\n        callback: (response) => {\r\n            if (response.status === 'successful') {\r\n\r\n              document.querySelector(\".form-info\").textContent = \"Submitting, please wait...\";\r\n              document\r\n                .querySelector(\"#submit-btn\")\r\n                .setAttribute(\"disabled\", \"disabled\");\r\n              fetch(\"https://grazacacademy.com/undergraduate/intern\", {\r\n                method: \"POST\",\r\n                headers: {\r\n                  \"Content-Type\": \"application/json\",\r\n                },\r\n                body: JSON.stringify({\r\n                  firstname: firstname,\r\n                  lastname: lastname,\r\n                  email: email,\r\n                  phone: phone,\r\n                  course: course,\r\n                  expectation: message,\r\n                  transaction_id: response.transaction_id\r\n                })\r\n              })\r\n              .then((resp) => resp.json())\r\n              .then((data) => {\r\n                if (data.success === true) {\r\n                  document.querySelector(\".form-info\").textContent = \"Your registration was successful, kindly check your mailbox for further details\";\r\n                  document.querySelector(\"#submit-btn\").removeAttribute(\"disabled\");\r\n                  setFirstName(\"\");\r\n                  setLastName(\"\");\r\n                  setMessage(\"\");\r\n                  setPhone(\"\");\r\n                  setEmail(\"\");\r\n                  setCourse(\"\");\r\n                } else {\r\n                  document.querySelector(\".form-info\").textContent = data.msg;\r\n                  document.querySelector(\"#submit-btn\").removeAttribute(\"disabled\");\r\n                }\r\n              })\r\n              .catch((err) => {\r\n                document.querySelector(\".form-info\").textContent = `Your payment was successful but something wrong while saving your details. \r\n                Kindly mail us at hello@grazacacademy.com`;\r\n                document.querySelector(\"#submit-btn\").removeAttribute(\"disabled\");\r\n              })\r\n\r\n            };\r\n            closePaymentModal() // this will close the modal programmatically\r\n        },\r\n        onClose: () => {\r\n\r\n        },\r\n      });\r\n    } else {\r\n      alert(\"You have to be available to register\");\r\n    }\r\n  };\r\n\r\n  return (\r\n    <div>\r\n      <Navbar />\r\n      <div>\r\n        <div className=\"contact_layer\">\r\n          <div className=\"form_top\" id=\"form_top\">\r\n            <div>\r\n              <h1>Grazac Internships.</h1>\r\n              <p>\r\n                We are bridging the gap between unemployment and entry-level\r\n                jobs in the technology industry.\r\n              </p>\r\n            </div>\r\n          </div>\r\n          <div className=\"container\" ref={formInfo}>\r\n            <div className=\"form\">\r\n              <form onSubmit={onSubmit}>\r\n                <div className=\"form-info\">\r\n                  Note: Fields with <span>*</span> are required\r\n                </div>\r\n                <div className=\"form-flexdiv\">\r\n                  <div className=\"form-flexdiv-1\">\r\n                    <label>\r\n                      First Name <span>*</span>\r\n                    </label>\r\n                    <input\r\n                      className=\"input\"\r\n                      type=\"text\"\r\n                      placeholder=\"ex. John\"\r\n                      value={firstname}\r\n                      onChange={(e) => setFirstName(e.target.value)}\r\n                      required=\"required\"\r\n                    />\r\n                  </div>\r\n                  <div className=\"form-flexdiv-2\">\r\n                    <label>\r\n                      Last Name <span>*</span>\r\n                    </label>\r\n                    <input\r\n                      className=\"input\"\r\n                      type=\"text\"\r\n                      placeholder=\"ex. Doe\"\r\n                      value={lastname}\r\n                      onChange={(e) => setLastName(e.target.value)}\r\n                      required=\"required\"\r\n                    />\r\n                  </div>\r\n                </div>\r\n                <div className=\"form-flexdiv\">\r\n                  <div className=\"form-flexdiv-1\">\r\n                    <label>\r\n                      Mobile Number <span>*</span>\r\n                    </label>\r\n                    <input\r\n                      className=\"input\"\r\n                      type=\"text\"\r\n                      placeholder=\"ex. 08133333333\"\r\n                      value={phone}\r\n                      onChange={(e) => setPhone(e.target.value)}\r\n                      required=\"required\"\r\n                      pattern=\".{11}\"\r\n                      title=\"Phone number is invalid\"\r\n                    />\r\n                  </div>\r\n                  <div className=\"form-flexdiv-2\">\r\n                    <label>\r\n                      Email <span>*</span>\r\n                    </label>\r\n                    <input\r\n                      className=\"input\"\r\n                      type=\"email\"\r\n                      placeholder=\"ex. john@example.com\"\r\n                      value={email}\r\n                      onChange={(e) => setEmail(e.target.value)}\r\n                      required=\"required\"\r\n                    />\r\n                  </div>\r\n                </div>\r\n                <div>\r\n                  <label>\r\n                    Our classes will be on Tuesdays and Thursdays, will you be\r\n                    available? <span>*</span>\r\n                  </label>\r\n                  <br />\r\n                  <label>\r\n                    <input\r\n                      type=\"radio\"\r\n                      className=\"radio-input\"\r\n                      id=\"yes\"\r\n                      name=\"availability\"\r\n                      value=\"1\"\r\n                      required=\"required\"\r\n                      checked={availability === \"1\"}\r\n                      onChange={(e) => setAvailability(e.target.value)}\r\n                    />\r\n                    Yes\r\n                  </label>\r\n                  <label>\r\n                    <input\r\n                      type=\"radio\"\r\n                      className=\"radio-input\"\r\n                      id=\"no\"\r\n                      name=\"availability\"\r\n                      value=\"0\"\r\n                      required=\"required\"\r\n                      checked={availability === \"0\"}\r\n                      onChange={(e) => setAvailability(e.target.value)}\r\n                      style={{ marginLeft: \"30px\" }}\r\n                    />\r\n                    No\r\n                  </label>\r\n                </div>\r\n                <div>\r\n                  <label>Course</label>\r\n                  <br />\r\n                  <p className=\"show-amount\">\r\n                    Website Development\r\n                  </p>\r\n                </div>\r\n                <div>\r\n                  <label>Amount</label>\r\n                  <br />\r\n                  <p className=\"show-amount\">\r\n                    ₦{new Intl.NumberFormat().format(amount)}\r\n                  </p>\r\n                </div>\r\n\r\n                <div>\r\n                  <label>\r\n                    What do you expect at the end of this training?{\" \"}\r\n                    <span>*</span>\r\n                  </label>\r\n                  <textarea\r\n                    type=\"text\"\r\n                    placeholder=\"Say something ...\"\r\n                    value={message}\r\n                    onChange={(e) => setMessage(e.target.value)}\r\n                    required=\"required\"\r\n                  />\r\n                </div>\r\n                <div className=\"form-privacy\">\r\n                  <button\r\n                    className=\"download-brochure\"\r\n                    type=\"submit\"\r\n                    id=\"submit-btn\"\r\n                  >\r\n                    Register\r\n                  </button>\r\n                </div>\r\n              </form>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <Footer />\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default InternshipForm;\r\n","C:\\Users\\Dabiri Mayowa\\Desktop\\Grazac\\grazac-academy-web\\src\\auth\\Signup.js",["183","184","185","186","187","188","189","190","191","192","193","194","195"],"import { useState } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { cn } from \"../utils\";\r\nimport PrimaryBtn from \"../components/PrimaryBtn\";\r\nimport Grazac from \"../images/grazac.png\";\r\n\r\nconst validEmailRegex = RegExp(\r\n  /^(([^<>()\\[\\]\\.,;:\\s@\\\"]+(\\.[^<>()\\[\\]\\.,;:\\s@\\\"]+)*)|(\\\".+\\\"))@(([^<>()[\\]\\.,;:\\s@\\\"]+\\.)+[^<>()[\\]\\.,;:\\s@\\\"]{2,})$/i\r\n);\r\n\r\nconst Signup = () => {\r\n  const [email, setEmail] = useState(\"\");\r\n  const [password, setPassword] = useState(\"\");\r\n  const [emailErr, setEmailErr] =  useState(\"\");\r\n  const [phone, setPhone] = useState(\"\");\r\n  const [gender, setGender] = useState(\"\");\r\n\r\n  \r\n  const handleEmailChange = e => {\r\n    e.preventDefault();\r\n    setEmail(e.target.value)\r\n\r\n    if (!email) setEmailErr(\"\");\r\n    let err = validEmailRegex.test(e.target.value) ? \"\" : \"please enter a valid email address\";\r\n    setEmailErr(err);\r\n  }\r\n\r\n  const handlePasswordChange = e => {\r\n    e.preventDefault();\r\n    setPassword(e.target.value)\r\n  }\r\n\r\n  return(\r\n    <div className=\"auth\">\r\n      <div className=\"auth__body\">\r\n        <div className=\"auth__hero\">\r\n          <img src={Grazac} alt=\"grazac\" />\r\n        </div>\r\n\r\n        <div className=\"auth__form\">\r\n          <div className=\"auth__form--container\">\r\n            <h1>Create Account</h1>\r\n\r\n            <form className=\"form\">\r\n              <div className=\"form__group\">\r\n                <label for=\"email\">Email address</label>\r\n                <input type=\"email\" id=\"email\" value={email} onChange={handleEmailChange} className={cn(\"form__input\", {\"form__input--err\": emailErr})}/>\r\n              </div>\r\n\r\n              <div className=\"form__group--half\">\r\n                <div className=\"form__group\">\r\n                  <label for=\"phone\">Phone </label>\r\n                  <input type=\"email\" id=\"email\" value={phone} onChange={e => setPhone(e.target.value)} className={cn(\"form__input\")}/>\r\n                </div>\r\n\r\n                <div className=\"form__group\">\r\n                  <label for=\"gender\">Gender</label>\r\n                    <select id=\"cars\" className=\"form__input\" onChange={e => setGender(e.target.value)}>\r\n                      <option value=\"\">Select gender</option>\r\n                      <option value=\"male\">Male</option>\r\n                      <option value=\"female\">Female</option>\r\n                      <option value=\"\">I'm not sure</option>\r\n                    </select>\r\n                </div>\r\n              </div>\r\n\r\n              <div className=\"form__group\">\r\n                <label for=\"pass\">Password</label>\r\n                <input type=\"password\" id=\"pass\" value={password} onChange={handlePasswordChange} className=\"form__input\"/>\r\n              </div>\r\n\r\n              <Link className=\"form__link\">Forgot password?</Link>\r\n\r\n              <button type=\"submit\" className=\"form__btn\">\r\n                <PrimaryBtn>Create Account</PrimaryBtn>\r\n              </button>\r\n            </form>\r\n\r\n            <div className=\"auth__line\">\r\n              <div>&nbsp;</div>\r\n              <span>or</span>\r\n              <div>&nbsp;</div>\r\n            </div>\r\n          </div>\r\n\r\n          <div className=\"auth__btns\">\r\n            <Link className=\"auth__btn\">