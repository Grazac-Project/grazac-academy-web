0,"usedDeprecatedRules":"169"},{"filePath":"333","messages":"334","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"169"},{"filePath":"335","messages":"336","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"169"},{"filePath":"337","messages":"338","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"169"},{"filePath":"339","messages":"340","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"169"},{"filePath":"341","messages":"342","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"343","usedDeprecatedRules":"169"},{"filePath":"344","messages":"345","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\index.js",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\reportWebVitals.js",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\App.js",["346","347","348","349","350","351","352","353","354","355"],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\context.js",["356","357"],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\components\\Loader.js",["358"],"import Modal from \"./Modal\";\r\nimport Logo from \"../images/svg/grazac-icon.svg\";\r\n\r\nconst Loader = () => {\r\n  return (\r\n    <div className=\"loading\">\r\n      <div className=\"loading_container\">\r\n        <div className=\"loading_box \">\r\n          <img src={Logo} className=\"lds-img\" alt=\"ccc\" />\r\n          <div className=\"lds-ring \">\r\n            <div></div>\r\n            <div></div>\r\n            <div></div>\r\n            <div></div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default Loader;\r\n",["359","360"],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\redux\\store.js",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\pages\\GraduateCourseDetail.js",["361","362","363","364"],"import React, { useState } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport PrimaryBtn from \"../components/PrimaryBtn\";\r\nimport MOT from \"../components/MOT\";\r\n\r\nimport paper from \"../images/svg/paper-ribbon.svg\";\r\nimport Loader from \"../components/Loader\";\r\n\r\nconst CourseDetail = (props) => {\r\n  const [course, setCourse] = useState(\"\");\r\n  const [outline, setOutline] = useState([]);\r\n\r\n  React.useEffect(() => {\r\n    document.title = \"Course Details - Grazac Academy\";\r\n    window.scrollTo(0, 0);\r\n    const slug = props.location.search.substring(8);\r\n\r\n    fetch(`https://api.grazacacademy.com/api/v1/graduate/${slug}`)\r\n      .then((resp) => resp.json())\r\n      .then((resp) => {\r\n        setCourse(resp.details);\r\n        setOutline(JSON.parse(resp.details.outline));\r\n      })\r\n      .catch((error) => {\r\n        // window.location.reload();\r\n      });\r\n  }, []);\r\n  // console.log(course);\r\n\r\n  return (\r\n    <div>\r\n      {outline.length ? (\r\n        <div id=\"blur\">\r\n          <Navbar />\r\n          <div className=\"course\">\r\n            <div className=\"course_hero\">\r\n              <div className=\"container\">\r\n                {course ? (\r\n                  <div className=\"row\">\r\n                    <div className=\"col-sm-6\">\r\n                      <div className=\"course_hero-text\">\r\n                        <div className=\"course_hero-text-b\">\r\n                          <h1>{course.name}</h1>\r\n                          <p>{course.description}</p>\r\n                          <div className=\"contact_hero-privacy\">\r\n                            <a\r\n                              href={course.brochure}\r\n                              className=\"download-brochure\"\r\n                              target=\"_blank\"\r\n                            >\r\n                              Download Brochure\r\n                            </a>\r\n                            <Link to=\"/login\">\r\n                              <button>Apply now</button>\r\n                            </Link>\r\n                          </div>\r\n                        </div>\r\n                      </div>\r\n                    </div>\r\n                    <div>\r\n                      {/* <img src={paper} alt=\"academy\" className=\"gga_hero-image\" /> */}\r\n                    </div>\r\n                  </div>\r\n                ) : (\r\n                  <div>\r\n                    {/*<img src={loader} alt=\"loader\" className=\"loader\" />*/}\r\n                  </div>\r\n                )}\r\n              </div>\r\n            </div>\r\n            <div className=\"course_learn\">\r\n              <div className=\"container\">\r\n                <div className=\"course_wwd-intro\">\r\n                  <h4>GRAZAC ACADEMY</h4>\r\n                  <h2>What you'll Learn</h2>\r\n                </div>\r\n                <div className=\"course_learn-main\">\r\n                  {outline.length ? (\r\n                    outline.map((item, index) => (\r\n                      <div key={index}>\r\n                        <div className=\"course_learn-main-list\">\r\n                          <div className=\"box1\">\r\n                            <h3>{index < 10 ? \"0\" + index : index}</h3>\r\n                          </div>\r\n                          <div className=\"box2\">\r\n                            <h3>{item.topic}</h3>\r\n                          </div>\r\n                          <div className=\"box3\">\r\n                            <p>{item.summary}</p>\r\n                          </div>\r\n                        </div>\r\n                        <hr />\r\n                      </div>\r\n                    ))\r\n                  ) : (\r\n                    <div>\r\n                      {/* <img src={loader} alt=\"loader\" className=\"loader\" /> */}\r\n                    </div>\r\n                  )}\r\n                </div>\r\n              </div>\r\n            </div>\r\n            <MOT />\r\n          </div>\r\n          <Footer />\r\n        </div>\r\n      ) : (\r\n        <Loader />\r\n      )}\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default CourseDetail;\r\n","C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\pages\\Contact.js",["365","366"],"import React, { useState, useEffect } from \"react\";\r\nimport axios from 'axios';\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport PrimaryBtn from \"../components/PrimaryBtn\";\r\n\r\nimport Facebook from \"../images/svg/facebook.svg\";\r\nimport Instagram from \"../images/svg/instagram.svg\";\r\nimport Twitter from \"../images/svg/twitter.svg\";\r\nimport Youtube from \"../images/svg/youtube.svg\";\r\n\r\nconst Contact = () => {\r\n\r\n    const [ name, setName ] = useState('');\r\n    const [ email, setEmail ] = useState('');\r\n    const [ subject, setSubject ] = useState('');\r\n    const [ message, setMessage ] = useState('');\r\n\r\n    useEffect(() => {\r\n        document.title = 'Contact - Grazac Academy';\r\n        window.scrollTo(0,0);\r\n    }, []);\r\n\r\n    const handleSubmit = () => {\r\n        if(name.length && email.length && subject.length && message.length) {\r\n            const btn = document.querySelector('#submit');\r\n            btn.setAttribute('disabled', '');\r\n            btn.textContent = 'Submitting...';\r\n            axios.post('http://grazacacademy.com/contact/create', {\r\n                name: name,\r\n                email: email,\r\n                subject: subject,\r\n                message: message\r\n            })\r\n            .then(resp => resp.data)\r\n            .then(response => {\r\n                if(response.success === true) {\r\n                    btn.removeAttribute('disabled');\r\n                    btn.textContent = 'Submit';\r\n                    alert(response.msg);\r\n                    setName(''); setEmail(''); setSubject(''); setMessage('');\r\n                } else {\r\n\r\n                }\r\n            })\r\n            .catch((err) => {\r\n                \r\n            });\r\n        } else {\r\n            alert('Invalid input');\r\n        }\r\n    }\r\n\r\n    return(\r\n        <div>\r\n            <Navbar/>\r\n            <div className=\"contact\">\r\n                <div className=\"contact_layer\">\r\n                    <div className=\"container\">\r\n                        <div className=\"contact_layer-text\">\r\n                            <h1>Get In Touch</h1>\r\n                            <p>We want to hear from you. Let us know how we can help</p>\r\n                        </div>\r\n                        {/*<div classname=\"contact_layer-circles\">\r\n                            <img src={kamala} alt=\"kamala\"  classname=\"contact_layer-circles-1\" />\r\n                            <img src={kamala} alt=\"kamala\"  classname=\"contact_layer-circles-2\" />\r\n                            <img src={kamala} alt=\"kamala\"  classname=\"contact_layer-circles-3\" />\r\n                            <img src={kamala} alt=\"kamala\"  classname=\"contact_layer-circles-4\" />\r\n                        </div>*/}\r\n                        <div className=\"contact_hero\">\r\n                            <div className=\"contact_hero-flexdiv\">\r\n                                <div className=\"contact_hero-flexdiv-1\" >\r\n                                    <label>Full Name  <span>*</span></label>\r\n                                    <input type=\"text\" placeholder=\"ex. John Doe\" value={name} onChange={e => setName(e.target.value)} />\r\n                                </div>\r\n                                <div className=\"contact_hero-flexdiv-2\">\r\n                                    <label>Email  <span>*</span></label>\r\n                                    <input type=\"text\" placeholder=\"ex. john@gmail.com\" value={email} onChange={e => setEmail(e.target.value)}  />\r\n                                </div>\r\n                            </div>\r\n                            <div>\r\n                                <label>Subject  <span>*</span></label>\r\n                                <input  type=\"text\" placeholder=\"ex. John Doe\" value={subject} onChange={e => setSubject(e.target.value)}  />\r\n                            </div>\r\n                            <div>\r\n                                <label>Message  <span>*</span></label>\r\n                                <textarea  type=\"text\" placeholder=\"Describe your task for us\" value={message} onChange={e => setMessage(e.target.value)}  />\r\n                            </div>\r\n                            <div className=\"contact_hero-privacy\" >\r\n                                <p>By submitting this form your consent to us emailing you occasionally about our products and services. You can unsubscribe from emails at any time, and we will never pass your email onto third parties. <span>Privacy Policy</span></p>\r\n                                <button id=\"submit\" onClick={handleSubmit}>Submit</button>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"container\">\r\n                    <div className=\"contact_campus\">\r\n                        <div className=\"contact_campus-intro\">\r\n                            <h2>Campus Inquiries</h2>\r\n                            <p>Connect with Us</p>\r\n                        </div>\r\n                        <div className=\"contact_campus-main\">\r\n                            <div className=\"contact_campus-main-div boxes33\">\r\n                                <h3>Office</h3>\r\n                                <p>PROHUB, Salawu Olabode Avenue, Ewang Road, </p>\r\n                                <p>Idi-aba, 110124, Abeokuta</p>\r\n                                <p>+234 806 836 5951</p>\r\n                            </div>\r\n                            <div className=\"contact_campus-main-div boxes33\">\r\n                                <h3>Book A Call</h3>\r\n                                <p>We are here to help with any questions. </p>\r\n                                <p>Talk to our programme leads.</p>\r\n                                <div style={{display:'flex'}}>\r\n                                    <a href=\"tel:+2348068365951\" ><div className=\"nav__btn--text\">Book a Call</div></a>\r\n                                </div>\r\n                            </div>\r\n                            <div className=\"contact_campus-main-div boxes33\">\r\n                                <h3>Social Media</h3>\r\n                                <div className=\"social\">\r\n                                    <img src={Facebook} alt=\"social\"/>\r\n                                </div>\r\n                                <div className=\"social\">\r\n                                    <img src={Twitter} alt=\"social\"/>\r\n                                </div>\r\n                                <div className=\"social\">\r\n                                    <img src={Youtube} alt=\"social\"/>\r\n                                </div>\r\n                                <div className=\"social\">\r\n                                    <img src={Instagram} alt=\"social\"/>\r\n                                </div>\r\n                            </div>\r\n\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div>\r\n                    <iframe src=\"https://www.google.com/maps/d/embed?mid=16NZ9a9VhKkk2-5nnYEdL93mxq7kjDZLT\" width=\"100%\" height=\"600\"></iframe>\r\n                </div>\r\n                {/*<extracomponent/> a component used in the landing page comes here*/}\r\n            </div>\r\n            <Footer/>\r\n        </div>\r\n    );\r\n}\r\n\r\nexport default Contact;","C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\pages\\AboutUs.js",["367"],"import { useEffect, useContext } from \"react\";\r\n// import { Link } from \"react-router-dom\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport Mode from \"../components/Mode\";\r\nimport Dots from \"../images/svg/dots.svg\";\r\nimport { LoaderContext } from \"../context\";\r\nconst cardsInfo = [\r\n  {\r\n    color: \"39,234,198\",\r\n    title: \"Creativity\",\r\n    body:\r\n      \"We constantly develop ideas that drives innovation. Our company is a community that allow us share common interests and ideas.\",\r\n  },\r\n  {\r\n    color: \"26,222,235\",\r\n    title: \"Quality\",\r\n    body:\r\n      \"We strive to provide value that fulfils and exceeds expectation. We have an unwavering guide that leads the way to fulfilling your goal.\",\r\n  },\r\n  {\r\n    color: \"108,21,250\",\r\n    title: \"Passion\",\r\n    body:\r\n      \"Our enthusiasm to deliver the best makes us unique. We uphold the highest standards in deliverability.\",\r\n  },\r\n  {\r\n    color: \"255,113,155\",\r\n    title: \"Commitment\",\r\n    body:\r\n      \"We are focused on giving best solutions. Our concern is solving your problem rather than why or how the problem was created.\",\r\n  },\r\n  {\r\n    color: \"254,125,108\",\r\n    title: \"Collaboration\",\r\n    body:\r\n      \"Our success depends upon the collective intelligence of our team members and the shared vision of our partners.\",\r\n  },\r\n  {\r\n    color: \"255,180,67\",\r\n    title: \"Teamwork\",\r\n    body:\r\n      \"We do better, together. Our environment fosters progress, effectiveness and speed.\",\r\n  },\r\n];\r\n\r\nconst AboutUs = () => {\r\n  const { setShow } = useContext(LoaderContext);\r\n  useEffect(() => {\r\n    document.title = \"About - Grazac Academy\";\r\n    window.scrollTo(0, 0);\r\n   \r\n  }, []);\r\n\r\n  return (\r\n    <div className=\"about\">\r\n      <Navbar />\r\n      <div className=\"about__top\">\r\n        <div className=\"about__top--container\">\r\n          <div className=\"about__top--up\">\r\n            <div>\r\n              <img src={Dots} alt=\"dots\" />\r\n            </div>\r\n            <div></div>\r\n            <div className=\"about__top--text\">\r\n              <h1>About Us</h1>\r\n              <p>\r\n                At Grazac Academy, we provide you with the right platform to\r\n                upskill yourself for the future.\r\n              </p>\r\n            </div>\r\n          </div>\r\n          <div className=\"about__top--down\">\r\n            <div></div>\r\n            <div></div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <div className=\"about__middle\">\r\n        <div className=\"about__middle--container\">\r\n          <div className=\"about__middle--head\">\r\n            <h2>Our Core Values</h2>\r\n            <p>\r\n              You determine the starting points, we provide the best possible\r\n              interception to achieve the goals.\r\n            </p>\r\n          </div>\r\n\r\n          <div className=\"about__middle--cards\">\r\n            {cardsInfo.map((item) => (\r\n              <div className=\"about__middle--card\">\r\n                <div style={{ \"--bg-color\": item.color }}></div>\r\n                <h3>{item.title}</h3>\r\n                <p>{item.body}</p>\r\n              </div>\r\n            ))}\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <Mode />\r\n      <Footer />\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default AboutUs;\r\n","C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\pages\\hire\\Listing.js",["368","369","370","371"],"import { useEffect, useState } from \"react\";\r\nimport Navbar from \"../../components/Navbar\";\r\nimport Footer from \"../../components/Footer\";\r\nimport { Container } from \"react-bootstrap\";\r\nimport { getAllTalents } from \"../../api/dashboard/hire\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { ToastContainer, toast } from \"react-toastify\";\r\nimport man from \"../../images/man.jpg\";\r\nimport loader from \"../../images/loader-purple.gif\";\r\nimport arrow from \"../../images/svg/arrow-front.svg\";\r\nimport Loader from \"../../components/Loader\";\r\nimport { saveHireId } from \"../../redux/slice/pageData.js\";\r\nimport { useSelector, useDispatch } from \"react-redux\";\r\n\r\nfunction Listing() {\r\n  let dispatch = useDispatch();\r\n  const [talents, setTalents] = useState([]);\r\n  const [fetchedPage, setFetchedPage] = useState(\"1\");\r\n  let [page, setPage] = useState(1);\r\n  const [loading, setLoading] = useState(false);\r\n\r\n  const isEmptyObject = (obj) => {\r\n    var name;\r\n    for (name in obj) {\r\n      if (obj.hasOwnProperty(name)) {\r\n        return false;\r\n      }\r\n    }\r\n    return true;\r\n  };\r\n  useEffect(() => {\r\n    document.title = \"Hire - Grazac Academy\";\r\n    window.scrollTo(0, 0);\r\n    fetchTalents(page);\r\n  }, [page]);\r\n\r\n  const fetchTalents = (page) => {\r\n    setLoading(true);\r\n    getAllTalents(page)\r\n      .then((response) => response)\r\n      .then((resp) => {\r\n        setLoading(false);\r\n        if (resp.status === 200) {\r\n          if (resp.data.data.users.length !== 0) {\r\n            setFetchedPage(resp.data.data.pageNumber);\r\n            setTalents(resp.data.data.users);\r\n          } else {\r\n            toast.error(\"End of List!\", {\r\n              position: toast.POSITION.BOTTOM_RIGHT,\r\n            });\r\n          }\r\n        }\r\n      })\r\n      .catch((err) => {\r\n        setLoading(false);\r\n\r\n        // toast.error(\"There was an error, please try again\", {\r\n        //   position: toast.POSITION.BOTTOM_RIGHT,\r\n        // })\r\n        \r\n      });\r\n  };\r\n\r\n  const selectPage = (page) => {\r\n    setLoading(true);\r\n    setPage(page);\r\n    fetchTalents();\r\n  };\r\n  const pagination = (type) => {\r\n    if (type === \"next\") {\r\n      setLoading(true);\r\n      setPage((prev) => prev + 1);\r\n      fetchTalents();\r\n    } else {\r\n      if (fetchedPage === \"1\") {\r\n      } else {\r\n        setLoading(true);\r\n        setPage((prev) => prev - 1);\r\n        fetchTalents();\r\n      }\r\n    }\r\n  };\r\n\r\n  return (\r\n    <div>\r\n      <ToastContainer />\r\n      {isEmptyObject(talents) == false ? (\r\n        <div>\r\n          <div className=\"hire-bg\">\r\n            <Navbar />\r\n            <div className=\"hire\">\r\n              <div className=\"hire_talents\">\r\n                <h2>Our Top Talents</h2>\r\n              </div>\r\n              <Container>\r\n                {loading ? (\r\n                  <div>\r\n                    <img\r\n                      src={loader}\r\n                      alt=\"loading\"\r\n                      width=\"70px\"\r\n                      style={{ margin: \"50px auto\", display: \"block\" }}\r\n                    />\r\n                  </div>\r\n                ) : (\r\n                  <div>\r\n\r\n                    {talents.map((item, idx) => (\r\n                      <Link\r\n                        style={{ color: \"black\" }}\r\n                        to={`/hire/${item.firstName}${item.lastName}`}\r\n                        key={idx}\r\n                       \r\n                      >\r\n                        <div\r\n                          className=\"hire_listing\"\r\n                          // key={idx}\r\n                          onClick={()=>dispatch(saveHireId(item.id))}\r\n                          \r\n                        >\r\n                          <div className=\"hire_listing-image\">\r\n                            <img src={item.profile_upload} alt=\"man\" />\r\n                          </div>\r\n                          <div className=\"hire_listing-text\">\r\n                            <div className=\"d-flx\">\r\n                              <div>\r\n                                <p className=\"hire_listing-text-1\">\r\n                                  {item.firstName} {item.lastName}\r\n                                </p>\r\n                                <p>\r\n                                  {item.profession} <span>{item.location}</span>\r\n                                </p>\r\n                              </div>\r\n                              <span\r\n                                className={\r\n                                  item.status === \"Hired\"\r\n                                    ? \"hire_listing-text-2-hired\"\r\n                                    : \"hire_listing-text-2-available\"\r\n                                }\r\n                              >\r\n                                {item.status === \"Hired\"\r\n                                  ? \"HIRED\"\r\n                                  : \"AVAILABLE\"}\r\n                              </span>\r\n                            </div>\r\n                            <p className=\"hire_listing-text-3\">\r\n                              {item.shortBio}\r\n                            </p>\r\n                          </div>\r\n                        </div>\r\n                      </Link>\r\n                    ))}\r\n                  </div>\r\n                )}\r\n                <div className=\"hire_listing-pagination\">\r\n                  <div\r\n                    className=\"hire_listing-pagination-text\"\r\n                    onClick={() => pagination(\"prev\")}\r\n                  >\r\n                    <p>Previous</p>\r\n                  </div>\r\n                  {fetchedPage === \"1\" ? (\r\n                    <div></div>\r\n                  ) : (\r\n                    <div\r\n                      onClick={() => selectPage(parseInt(fetchedPage) - 1)}\r\n                      className=\"hire_listing-pagination-number\"\r\n                    >\r\n                      <p onClick={() => selectPage(parseInt(fetchedPage) - 1)}>\r\n                        {parseInt(fetchedPage) - 1}\r\n                      </p>\r\n                    </div>\r\n                  )}\r\n\r\n                  <div className=\"hire_listing-pagination-number activePage\">\r\n                    <p>{fetchedPage}</p>\r\n                  </div>\r\n\r\n                  <div\r\n                    onClick={() => selectPage(parseInt(fetchedPage) + 1)}\r\n                    className=\"hire_listing-pagination-number\"\r\n                  >\r\n                    <p onClick={() => selectPage(parseInt(fetchedPage) + 1)}>\r\n                      {parseInt(fetchedPage) + 1}\r\n                    </p>\r\n                  </div>\r\n                  <div\r\n                    className=\"hire_listing-pagination-text\"\r\n                    onClick={() => pagination(\"next\")}\r\n                  >\r\n                    <p>Next</p>\r\n                  </div>\r\n                </div>\r\n              </Container>\r\n            </div>\r\n            <Footer />\r\n          </div>\r\n        </div>\r\n      ) : (\r\n        <div>\r\n          <Loader />\r\n        </div>\r\n      )}\r\n    </div>\r\n  );\r\n}\r\nexport default Listing;\r\n","C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\pages\\hire\\Contact.js",["372"],"import { Container, Row, Col } from \"react-bootstrap\";\r\nimport Navbar from \"../../components/Navbar\";\r\nimport Footer from \"../../components/Footer\";\r\nimport { useEffect, useState } from \"react\";\r\nimport { submitContact } from \"../../api/dashboard/hire\";\r\n\r\nimport telephone from \"../../images/svg/telephone.svg\";\r\nimport location from \"../../images/svg/location.svg\";\r\nimport email from \"../../images/svg/email-white.svg\";\r\nimport loader from \"../../images/loader.gif\";\r\n\r\nfunction Contact() {\r\n  const [data, setData] = useState({\r\n    your_name: \"\",\r\n    email_address: \"\",\r\n    // contact_number: \"\",\r\n    company_name: \"\",\r\n    // company_website: \"\",\r\n    // hiring_location: \"\",\r\n    subject: \"\",\r\n    inquiry: \"\",\r\n  });\r\n\r\n  const handleChange = (e) => {\r\n    setData({\r\n      ...data,\r\n      [e.target.name]: e.target.value,\r\n    });\r\n  };\r\n\r\n  const submitForm = (e) => {\r\n    e.preventDefault();\r\n    const btn = document.getElementById(\"contact_submit\");\r\n    btn.innerHTML = `<img src=${loader} alt=\"loader\" width=\"20px\" />`;\r\n    let payload = JSON.stringify({\r\n      your_name: data.your_name,\r\n      email_address: data.email_address,\r\n      subject: data.subject,\r\n      inquiry: data.inquiry,\r\n      // contact_number: data.contact_number,\r\n      company_name: data.contact_number,\r\n      // company_website: data.company_website,\r\n      // hiring_location: data.hiring_location,\r\n    });\r\n\r\n    submitContact(payload)\r\n      .then((response) => response)\r\n      .then((resp) => {\r\n        if (resp.status === 200) {\r\n          alert(`${resp.data.message}`);\r\n          document.getElementById(\"contact_form\").reset();\r\n        } else {\r\n          alert(\r\n            `Something went wrong, please try again!!! Message: ${resp.data.message}`\r\n          );\r\n        }\r\n        btn.innerHTML = `Send Message`;\r\n      })\r\n      .catch((err) => {\r\n        alert(`Something went wrong, please try again!!!`);\r\n        btn.innerHTML = `Send Message`;\r\n      });\r\n  };\r\n\r\n  return (\r\n    <div className=\"hire-bg\">\r\n      <Navbar />\r\n      <div className=\"hire\">\r\n        <Container>\r\n          <div className=\"hire_contact\">\r\n            <Container>\r\n              <Row>\r\n                <Col md={6}>\r\n                  <div className=\"hire_contact-text\">\r\n                    <h2>Get In Touch</h2>\r\n                    <p className=\"hire_contact-text-1\">\r\n                      Fill up the form and our support staff will get back to\r\n                      you as soon as possible\r\n                    </p>\r\n                    <div className=\"hire_contact-text-box\">\r\n                      <div className=\"hire_contact-text-box-flx\">\r\n                        <img src={telephone} alt=\"icon\" />\r\n                        <p>+234 806 836 5951</p>\r\n                      </div>\r\n                    </div>\r\n                    <div className=\"hire_contact-text-box\">\r\n                      <div className=\"hire_contact-text-box-flx\">\r\n                        <img src={email} alt=\"icon\" />\r\n                        <p>hire@grazacacademy.com</p>\r\n                      </div>\r\n                    </div>\r\n                    <div className=\"hire_contact-text-box\">\r\n                      <div className=\"hire_contact-text-box-flx\">\r\n                        <img src={location} alt=\"icon\" />\r\n                        <p>\r\n                          PROHUB, Suite 302, Salawu Olabode Avenue, Ewang Road,\r\n                          Idi Aba, Abeokuta, Ogun State.\r\n                        </p>\r\n                      </div>\r\n                    </div>\r\n                  </div>\r\n                </Col>\r\n                <Col md={6}>\r\n                  <div className=\"hire_contact-form\">\r\n                    <form onSubmit={submitForm} id=\"contact_form\">\r\n                      <input\r\n                        type=\"text\"\r\n                        required\r\n                        name=\"your_name\"\r\n                        placeholder=\"Your Name\"\r\n                        onChange={handleChange}\r\n                      />\r\n                      {/* <input\r\n                        type=\"text\"\r\n                        required\r\n                        name=\"contact_number\"\r\n                        placeholder=\"Contact Number\"\r\n                        onChange={handleChange}\r\n                      /> */}\r\n                      <input\r\n                        type=\"text\"\r\n                        required\r\n                        name=\"company_name\"\r\n                        placeholder=\"Company Name\"\r\n                        onChange={handleChange}\r\n                      />\r\n{/* \r\n                      <input\r\n                        type=\"text\"\r\n                        required\r\n                        name=\"company_website\"\r\n                        placeholder=\"Company Website\"\r\n                        onChange={handleChange}\r\n                      /> */}\r\n                      {/* <input\r\n                        type=\"text\"\r\n                        required\r\n                        name=\"hiring_location\"\r\n                        placeholder=\"Hiring Location\"\r\n                        onChange={handleChange}\r\n                      /> */}\r\n\r\n                      <input\r\n                        type=\"email\"\r\n                        required\r\n                        name=\"email_address\"\r\n                        placeholder=\"Email Address\"\r\n                        onChange={handleChange}\r\n                      />\r\n                      <input\r\n                        type=\"text\"\r\n                        required\r\n                        name=\"subject\"\r\n                        placeholder=\"Subject\"\r\n                        onChange={handleChange}\r\n                      />\r\n                      <textarea\r\n                        placeholder=\"Message\"\r\n                        name=\"inquiry\"\r\n                        required\r\n                        rows=\"6\"\r\n                        onChange={handleChange}\r\n                      />\r\n                      <button type=\"submit\" id=\"contact_submit\">\r\n                        Send Message\r\n                      </button>\r\n                    </form>\r\n                  </div>\r\n                </Col>\r\n              </Row>\r\n            </Container>\r\n          </div>\r\n        </Container>\r\n      </div>\r\n      <Footer />\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default Contact;\r\n","C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\pages\\hire\\Profile.js",["373","374","375","376","377","378"],"import Navbar from \"../../components/Navbar\";\r\nimport Footer from \"../../components/Footer\";\r\nimport { Container } from \"react-bootstrap\";\r\nimport { useEffect, useState } from \"react\";\r\nimport { getOneTalent } from \"../../api/dashboard/hire\";\r\nimport { Link } from \"react-router-dom\";\r\n\r\nimport arrow from \"../../images/svg/arrow-front.svg\";\r\nimport purpleBack from \"../../images/svg/purple-back.svg\";\r\nimport instagram from \"../../images/svg/icons8-instagram.svg\";\r\nimport facebook from \"../../images/svg/icons8-facebook.svg\";\r\nimport twitter from \"../../images/svg/icons8-twitter.svg\";\r\nimport github from \"../../images/svg/icons8-github.svg\";\r\nimport linkedin from \"../../images/svg/icons8-linkedin.svg\";\r\nimport profile from \"../../images/man.jpg\";\r\nimport Loader from \"../../components/Loader\";\r\nimport { useSelector, useDispatch } from \"react-redux\";\r\n\r\nfunction Profile() {\r\n  const talentId = useSelector((state) => state.pageData.hireUserId);\r\n\r\n\r\n//   const talentId = new URLSearchParams(window.location.search).get(\"id\");\r\n  const [education, setEducation] = useState([]);\r\n  const [award, setAward] = useState([]);\r\n  const [project, setProject] = useState([]);\r\n  const [talent, setTalent] = useState({});\r\n\r\n  const isEmptyObject = (obj) => {\r\n    var name;\r\n    for (name in obj) {\r\n      if (obj.hasOwnProperty(name)) {\r\n        return false;\r\n      }\r\n    }\r\n    return true;\r\n  };\r\n\r\n  useEffect(() => {\r\n    getOneTalent(talentId)\r\n      .then((response) => response)\r\n      .then((resp) => {\r\n        if (resp.status === 200) {\r\n          console.log(\"effect\", resp.data.profile);\r\n          setTalent(resp.data.profile.user);\r\n          setEducation(resp.data.profile.education);\r\n          setAward(resp.data.profile.award);\r\n          setProject(resp.data.profile.project);\r\n        } else {\r\n          alert(\r\n            `Something went wrong, please try again!!! Message: ${resp.data.message}`\r\n          );\r\n        }\r\n      })\r\n      .catch((err) => {\r\n        alert(`Something went wrong, please try again!!!`);\r\n      });\r\n  }, []);\r\n\r\n  return (\r\n    <div>\r\n      {isEmptyObject(talent) == false ? (\r\n        <div>\r\n          <div className=\"hire-bg\">\r\n            <Navbar />\r\n            <div className=\"hire\">\r\n              <Container>\r\n          \r\n                <div className=\"hire_profile\">\r\n                  <div className=\"hire_profile-main\">\r\n                    <div>\r\n                      <Link to=\"/hire/listing\">\r\n                        <img\r\n                          src={purpleBack}\r\n                          alt=\"back\"\r\n                          width=\"100px\"\r\n                          className=\"purpleBack\"\r\n                        />\r\n                      </Link>\r\n                      <div className=\"hire_profile-main-bio\">\r\n                        <div className=\"hire_profile-main-bio-image1\">\r\n                          <div className=\"hire_profile-main-bio-image\">\r\n                            <img src={talent.profile_upload} alt=\"profile\" />\r\n                          </div>\r\n                          <div className=\"hire_profile-main-bio-icons\">\r\n                            {talent?.github === \"\" ? (\r\n                              <div></div>\r\n                            ) : (\r\n                              <a\r\n                                href={\r\n                                  talent?.github.includes(\"https\")\r\n                                    ? talent?.github\r\n                                    : \"https://\" + talent?.github\r\n                                }\r\n                              >\r\n                                <img src={github} alt=\"github\" />\r\n                              </a>\r\n                            )}\r\n                            {talent?.linkedin === \"\" ? (\r\n                              <div></div>\r\n                            ) : (\r\n                              <a\r\n                                href={\r\n                                  talent?.linkedin.includes(\"https\")\r\n                                    ? talent?.linkedin\r\n                                    : \"https://\" + talent?.linkedin\r\n                                }\r\n                              >\r\n                                <img src={linkedin} alt=\"linkedin\" />\r\n                              </a>\r\n                            )}\r\n                            {talent?.twitter === \"\" ? (\r\n                              <div></div>\r\n                            ) : (\r\n                              <a\r\n                                href={\r\n                                  talent?.twitter.includes(\"https\")\r\n                                    ? talent?.twitter\r\n                                    : \"https://\" + talent?.twitter\r\n                                }\r\n                              >\r\n                                <img src={twitter} alt=\"twitter\" />\r\n                              </a>\r\n                            )}\r\n                            {/* <a href={talent?.facebook}><img src={facebook} alt=\"facebook\" /></a> */}\r\n                            {talent?.instagram === \"\" ? (\r\n                              <div></div>\r\n                            ) : (\r\n                              <a\r\n                                href={\r\n                                  talent?.instagram.includes(\"https\")\r\n                                    ? talent?.instagram\r\n                                    : \"https://\" + talent?.instagram\r\n                                }\r\n                              >\r\n                                <img src={instagram} alt=\"instagram\" />\r\n                              </a>\r\n                            )}\r\n                          </div>\r\n                          {console.log(talent?.instagram.includes(\"https\"))}\r\n                        </div>\r\n\r\n                        <div className=\"hire_profile-main-bio-text\">\r\n                          <div className=\"hire_profile-main-info\">\r\n                            <p className=\"text-1\">\r\n                              {talent?.firstName} {talent?.lastName}\r\n                            </p>\r\n                            <p>\r\n                              {talent?.profession}{\" \"}\r\n                              <span>{talent?.location}</span>\r\n                            </p>\r\n                            <p\r\n                              className={\r\n                                talent?.status === \"Unhired\"\r\n                                  ? \"available\"\r\n                                  : \"hired\"\r\n                              }\r\n                            >\r\n                              {talent?.status == \"Unhired\"\r\n                                ? \"Available\"\r\n                                : \"Hired\"}\r\n                            </p>\r\n                            <p>{talent?.shortBio}</p>\r\n                          </div>\r\n                        </div>\r\n                      </div>\r\n                    </div>\r\n\r\n                    <div className=\"hire_profile-main-info\">\r\n                      <div>\r\n                        <h4>Education</h4>\r\n                        <hr />\r\n                        <div className=\"hire_profile-main-info-shift\">\r\n                          {education?.map((item, idx) => (\r\n                            <div key={idx}>\r\n                              <p className=\"text-1\">{item.institution}</p>\r\n                              <p>{item.course}</p>\r\n                              <p>\r\n                                {item.startYear} - {item.endYear}\r\n                              </p>\r\n                              <hr />\r\n                            </div>\r\n                          ))}\r\n                        </div>\r\n                      </div>\r\n                      <div>\r\n                        <h4>Award &#38; Certification</h4>\r\n                        <hr />\r\n                        <div className=\"hire_profile-main-info-shift\">\r\n                          {award?.map((item, idx) => (\r\n                            <div key={idx}>\r\n                              <p className=\"text-1\">{item.title}</p>\r\n                              <p>{item.awarder}</p>\r\n                              <p>{item.yearAwarded}</p>\r\n                              <a href={item.certificate_link}>Link</a>\r\n                              <hr />\r\n                            </div>\r\n                          ))}\r\n                        </div>\r\n                      </div>\r\n                      <div>\r\n                        <h4>Projects and Experience</h4>\r\n                        <hr />\r\n                        <div className=\"hire_profile-main-info-shift\">\r\n                          {project?.map((item, idx) => (\r\n                            <div key={idx}>\r\n                              {console.log(item)}\r\n                              <div className=\"hire_profile-main-info-shift-flx\">\r\n                                <div className=\"hire_profile-main-info-shift-flx-1\">\r\n                                  <p className=\"text-1\">{item.role}</p>\r\n                                  <p>\r\n                                    {item.startYear} - {item.endYear}\r\n                                  </p>\r\n                                </div>\r\n                                <div className=\"hire_profile-main-info-shift-flx-2\">\r\n                                  <p className=\"text-1\">{item.title}</p>\r\n                                  <p className=\"text__1__description\">\r\n                                    {item.description}\r\n                                  </p>\r\n\r\n                                  <p>\r\n                                    {\" \"}\r\n                                    <a href={item.project_link}>\r\n                                      {item.project_link}\r\n                                    </a>{\" \"}\r\n                                  </p>\r\n                                </div>\r\n                              </div>\r\n                              <hr />\r\n                            </div>\r\n                          ))}\r\n                        </div>\r\n                      </div>\r\n                    </div>\r\n                  </div>\r\n                  <div style={{ display: \"flex\", justifyContent: \"center\" }}>\r\n                    <Link to=\"/hire/listing\">\r\n                      <button className=\"hire_profile-backBtn\">\r\n                        <img src={arrow} alt=\"alt\" />\r\n                        Back To Listing\r\n                      </button>\r\n                    </Link>\r\n                    <Link to=\"/hire/contact\">\r\n                      <button className=\"hire_profile-backBtn2\">\r\n                        Contact Us\r\n                        <img src={arrow} alt=\"alt\" />\r\n                      </button>\r\n                    </Link>\r\n                  </div>\r\n                </div>\r\n              </Container>\r\n            </div>\r\n            <Footer />\r\n          </div>\r\n        </div>\r\n      ) : (\r\n        <div>\r\n          <Loader />\r\n        </div>\r\n      )}\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default Profile;\r\n","C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\components\\shared\\index.js",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\pages\\graduateCohort\\auth\\AccountCreated.js",["379"],"import { Link } from \"react-router-dom\";\r\nimport { LazyLoadImage } from 'react-lazy-load-image-component';\r\nimport authImg from '../../../images/auth.png';\r\nimport logo from '../../../images/svg/academy-logo.svg';\r\nimport email from '../../../images/svg/email.svg';\r\n\r\n\r\nfunction Verify () {\r\n    const urlParams = new URLSearchParams(window.location.search);\r\n    const emailAddress = urlParams.get('email');\r\n\r\n    return(\r\n        <div className=\"layout_auth\">\r\n            <div className=\"layout_auth-main\">\r\n                <div className=\"auth_container\">\r\n                    <div className=\"auth_container-logo\" >\r\n                        <Link to=\"/\">\r\n                            <img src={logo} alt=\"logo\" />\r\n                        </Link>\r\n                    </div>\r\n                    <div className=\"auth_container_form\">\r\n                        <img src={email} alt=\"email\" className=\"auth_container_form-email\" />\r\n                        <h3>Welcome to Grazac Academy!</h3>\r\n                        <p className=\"auth_container_form-text\">\r\n                            Learn valuable technology skills with us, we strongly believe the future of work will be skill based. <br/>\r\n                            Join us to build a career in tech and get tutored by industry leaders who will walk you through the path of becoming highly valuable and employable. <br/>\r\n                            There is just one extra thing to do. Please check your email to verify your account.<br/>\r\n                        </p>\r\n                        {/* <p>Didn't get an email? <span>Resend Link</span></p> */}\r\n                        <p>Proceed to <Link to=\"/login\"><span>Login</span></Link></p>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n            <div className=\"layout_auth-image\">\r\n                <LazyLoadImage src={authImg} effect=\"blur\" alt=\"auth\" height=\"auto\" width=\"100%\" />\r\n            </div>\r\n        </div>\r\n    )\r\n}\r\n\r\nexport default Verify;","C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\pages\\graduateCohort\\auth\\VerifyMail.js",["380","381"],"import { Link } from \"react-router-dom\";\r\nimport { useEffect, useState } from \"react\";\r\nimport { VerifyEmail } from \"../../../api/dashboard/auth\";\r\nimport { LazyLoadImage } from \"react-lazy-load-image-component\";\r\nimport authImg from \"../../../images/auth.png\";\r\nimport logo from \"../../../images/svg/academy-logo.svg\";\r\nimport email from \"../../../images/svg/email.svg\";\r\nimport loader from \"../../../images/loader-purple.gif\";\r\n\r\nfunction Verify() {\r\n  const urlParams = new URLSearchParams(window.location.search);\r\n  const token = urlParams.get(\"token\");\r\n  const [loading, setLoading] = useState(true);\r\n\r\n  useEffect(() => {\r\n    verify();\r\n  }, []);\r\n\r\n  async function verify() {\r\n    try {\r\n      const response = await VerifyEmail(token);\r\n      const res = await response;\r\n      setTimeout(function () {\r\n        setLoading(false);\r\n      }, 2500);\r\n    } catch (err) {}\r\n  }\r\n\r\n  return (\r\n    <div className=\"layout_auth\">\r\n      <div className=\"layout_auth-main\">\r\n        <div className=\"auth_container\">\r\n          <div className=\"auth_container-logo\">\r\n            <Link to=\"/\">\r\n              <img src={logo} alt=\"logo\" />\r\n            </Link>\r\n          </div>\r\n          <div className=\"auth_container_form\">\r\n            {loading && (\r\n              <div className=\"auth_verify\">\r\n                <img src={loader} alt=\"loading\" width=\"100px\" />\r\n                <h3>Verifying, please wait...</h3>\r\n              </div>\r\n            )}\r\n            {!loading && (\r\n              <div>\r\n                <img\r\n                  src={email}\r\n                  alt=\"email\"\r\n                  className=\"auth_container_form-email\"\r\n                />\r\n                <h3>Email Verified!</h3>\r\n                <p className=\"auth_container_form-text\">\r\n                  Learn valuable technology skills with us, we strongly believe\r\n                  the future of work will be skill based. <br />\r\n                  Join us to build a career in tech and get tutored by industry\r\n                  leaders who will walk you through the path of becoming highly\r\n                  valuable and employable. <br />\r\n                </p>\r\n                <p>\r\n                  Proceed to{\" \"}\r\n                  <Link to=\"/login\">\r\n                    <span>Login</span>\r\n                  </Link>\r\n                </p>\r\n              </div>\r\n            )}\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <div className=\"layout_auth-image\">\r\n        <LazyLoadImage\r\n          src={authImg}\r\n          effect=\"blur\"\r\n          alt=\"auth\"\r\n          height=\"auto\"\r\n          width=\"100%\"\r\n        />\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default Verify;\r\n","C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\pages\\graduateCohort\\auth\\ForgotPassword.js",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\pages\\graduateCohort\\auth\\ResetPassword.js",["382","383","384"],"import { useState } from 'react';\r\nimport { Link } from \"react-router-dom\";\r\nimport { ToastContainer, toast } from 'react-toastify';\r\nimport { ResetPasswordAction } from \"../../../api/dashboard/auth\";\r\nimport { LazyLoadImage } from 'react-lazy-load-image-component';\r\nimport authImg from '../../../images/auth.png';\r\n\r\nimport logo from '../../../images/svg/academy-logo.svg';\r\nimport visible from '../../../images/svg/visible.svg';\r\nimport notvisible from '../../../images/svg/notvisible.svg';\r\nimport loader from \"../../../images/svg/dashboard/loader.gif\";\r\n\r\n\r\nfunction ResetPassword () {\r\n    const urlParams = new URLSearchParams(window.location.search);\r\n    const reset_token = urlParams.get('token');\r\n    const [form, setForm] = useState({\r\n        password: \"\",\r\n        confirmpassword: \"\"\r\n    });\r\n\r\n    const handleChange = (e) => {\r\n        setForm({\r\n            ...form,\r\n            [e.target.name]: e.target.value\r\n        })\r\n    }\r\n\r\n    const doReset = (e) => {\r\n        e.preventDefault();\r\n        if (!form.password.length || !form.confirmpassword.length) {\r\n            toast.info(\"Please make sure no field is empty!\")\r\n        }else if(form.password != form.confirmpassword){\r\n            toast.error(\"Passwords do not match!\")\r\n        }else if(form.password.length<6 || form.confirmpassword<6){\r\n            toast.error(\"Passwords should be at least 6 characters!\")\r\n        } else{\r\n            var btn = document.getElementById(\"actionBtn\");\r\n            btn.innerHTML = `<img src=${loader} width=\"20px\" />`;\r\n            var data  = new FormData();\r\n    \r\n            data.append(\"token\", reset_token);\r\n            data.append(\"password\", form.password);\r\n            data.append(\"confirmPassword\", form.confirmpassword);\r\n    \r\n            ResetPasswordAction(data)\r\n                .then((response) => response.data)\r\n                .then((res) => {\r\n                    if (res.status === 200) {\r\n                        toast.success(\"Password reset successful! Proceed to login.\");\r\n                        btn.innerHTML=`Reset Password`;\r\n                    } else {\r\n                        toast.error(\"Something went wrong, please try again!!!\")\r\n                        btn.innerHTML=`Reset Password`;\r\n                    }\r\n                })\r\n                .catch((err) => {\r\n                    toast.error(\"Unable to reset password! Try again\");\r\n                //     if(err.response.data.message){\r\n                //         toast.error(err.response.data.message);\r\n                //         btn.innerHTML=`Reset Password`;\r\n                //     } else{\r\n                //         toast.error(\"Something went wrong!!! Please make sure you have a good internet connection.\");\r\n                //         btn.innerHTML=`Reset Password`;\r\n                //     }\r\n                });\r\n        }\r\n    }\r\n\r\n    const toggleIcon = () => {\r\n        var x = document.getElementById(\"password\");\r\n        var iconContainer = document.getElementById(\"toggle\");\r\n        if (x.type === \"password\") {\r\n          x.type = \"text\";\r\n          iconContainer.innerHTML = `<img src=${notvisible} />`\r\n        } else {\r\n          x.type = \"password\";\r\n          iconContainer.innerHTML = `<img src=${visible} />` ;\r\n        }\r\n    }\r\n    \r\n    const toggleIcon2 = () => {\r\n        var x = document.getElementById(\"confirmpassword\");\r\n        var iconContainer = document.getElementById(\"confirmtoggle\");\r\n        if (x.type === \"password\") {\r\n            x.type = \"text\";\r\n            iconContainer.innerHTML = `<img src=${notvisible} />`\r\n        } else {\r\n            x.type = \"password\";\r\n            iconContainer.innerHTML = `<img src=${visible} />` ;\r\n        }\r\n    }\r\n\r\n    return(\r\n        <div className=\"layout_auth\">\r\n            <ToastContainer/>\r\n            <div className=\"layout_auth-main\">\r\n                <div className=\"auth_container\">\r\n                    <div className=\"auth_container-logo\" >\r\n                        <Link to=\"/\">\r\n                            <img src={logo} alt=\"logo\" />\r\n                        </Link>\r\n                    </div>\r\n                    <div className=\"auth_container_form\">\r\n                        <h3>Create New Password</h3>\r\n                        <p className=\"auth_container_form-text\">Enter your new password below to continue.</p>\r\n                        <form onSubmit={doReset}>\r\n                            <div className=\"auth_container_form-password\">\r\n                                <label>Password</label>\r\n                                <input type=\"password\" id=\"password\" placeholder=\"Password\" name=\"password\" onChange={handleChange} />\r\n                                <div id=\"toggle\" onClick={toggleIcon} ><img src={visible} /></div>\r\n                            </div>\r\n                            <div className=\"auth_container_form-password\">\r\n                                <label>Confirm Password</label>\r\n                                <input type=\"password\" id=\"confirmpassword\" placeholder=\"Password\" name=\"confirmpassword\" onChange={handleChange} />\r\n                                <div id=\"confirmtoggle\" onClick={toggleIcon2} ><img src={visible} /></div>\r\n                            </div>\r\n                            <button type=\"submit\" id=\"actionBtn\">Reset Password</button>\r\n                            <p>Remember your password? <Link to=\"/login\"><span>Login</span></Link></p>\r\n                        </form>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n            <div className=\"layout_auth-image\">\r\n                <LazyLoadImage src={authImg} effect=\"blur\" alt=\"auth\" height=\"auto\" width=\"100%\" />\r\n            </div>\r\n        </div>\r\n    )\r\n}\r\n\r\nexport default ResetPassword;","C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\pages\\graduateCohort\\auth\\MailSent.js",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\academy-dashboard\\pages\\dashboard\\Dashboard.js",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\academy-dashboard\\component\\sidebar\\AcademySidebar.js",["385","386","387","388","389","390","391","392"],"import React, { useState } from 'react';\r\nimport {\r\n    FaTh,\r\n    FaBars,\r\n    FaUserAlt,\r\n    FaRegChartBar,\r\n    FaCommentAlt,\r\n    FaShoppingBag,\r\n    FaThList\r\n}from \"react-icons/fa\";\r\nimport { NavLink } from 'react-router-dom';\r\nimport ChallengeIcon from '../../icons/ChallengeIcon';\r\nimport DashboardIcon from '../../icons/DashboardIcon';\r\nimport PaymentIcon from '../../icons/PaymentIcon';\r\nimport PortfolioIcon from '../../icons/PortfolioIcon';\r\nimport SettingsIcon from '../../icons/SettingsIcon';\r\nimport CohortCard from \"../shared/cohortcard/CohortCard\"\r\n\r\nconst AcademySidebar = ({children}) => {\r\n    const[isOpen ,setIsOpen] = useState(false);\r\n    const toggle = () => setIsOpen (!isOpen);\r\n    const menuItem=[\r\n        {\r\n            path:\"/academy\",\r\n            name:\"Academy\",\r\n            icon:<DashboardIcon /> \r\n        },\r\n        {\r\n            path:\"/challenge\",\r\n            name:\"Challenge\",\r\n            icon:<ChallengeIcon />\r\n        },\r\n        {\r\n            path:\"/payment\",\r\n            name:\"Payment\",\r\n            icon:<PaymentIcon />\r\n        },\r\n        {\r\n            path:\"/portfolio\",\r\n            name:\"Portfolio\",\r\n            icon:<PortfolioIcon />\r\n        },\r\n        {\r\n            path:\"/settings\",\r\n            name:\"Settings\",\r\n            icon:<SettingsIcon />\r\n        },      \r\n    ]\r\n    return (\r\n        <div className=\"academysidebar__container\">\r\n           <div className=\"academysidebar__sidebar\">\r\n               <div className=\"academysidebar__sidebar-top_section\">\r\n\r\n                <CohortCard status={\"Admitted\"} cohort={\"001\"} />\r\n                   {/* <h1  className=\"academysidebar__sidebar-top_section-logo\">Logo</h1> */}\r\n                   <div  className=\"academysidebar__sidebar-top_section-bars\">\r\n                       {/* <FaBars onClick={toggle}/> */}\r\n                   </div>\r\n               </div>\r\n\r\n               {menuItem.map((item, index)=>(\r\n                       <NavLink to={item.path} key={index} className=\"academysidebar__sidebar-link\" activeclassName=\"active\">\r\n                           <div className=\"academysidebar__sidebar-link-icon\">{item.icon}</div>\r\n                           <div className=\"academysidebar__sidebar-link-link_text\">{item.name}</div>\r\n                       </NavLink>\r\n                   ))\r\n               }\r\n           </div>\r\n           <main>{children}</main>\r\n        </div>\r\n    );\r\n};\r\n\r\nexport default AcademySidebar;","C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\academy-dashboard\\pages\\challenge\\Challenge.js",["393","394","395"],"import React, { useState } from \"react\";\r\nimport ChallengeCard from \"../../component/challenge/challenges/challengecard/ChallengeCard\";\r\nimport LockedChallenge from \"../../component/challenge/challenges/challengecard/LockedChallenge\";\r\nimport ChallengeProgress from \"../../component/challenge/challenges/ChallengeProgress\";\r\nimport ChallengeText from \"../../component/challenge/challenges/challengetext/ChallengeText\";\r\nimport ProfileCard from \"../../component/shared/profilecard/ProfileCard\";\r\nimport CohortCard from \"../../component/shared/cohortcard/CohortCard\";\r\nimport img from \"../../static/profile_image.png\";\r\nimport Carousel from \"../../component/carousel/Carousel\";\r\nimport CarouselDiv from \"../../component/carousel/Carousel\";\r\nimport ChallengeDetail from \"./ChallengeDetail\";\r\n// const Component1 = ({ String }) => {\r\n//   return <div dangerouslySetInnerHTML={{ __html: String }} />;\r\n// };\r\n// const value = `\r\n// <p>Empire Travel Group is a travel tour company which specializes in Educational and Holiday Tour. They provide educational travel and student holiday tour packages for ages 7-17. Currently, they have five (5) educational and holiday related tour products and services which schools can choose from. </p>\r\n// <p>Some of which are:\r\n// <ul>\r\n// <ol>1.\tEaster Holiday Camp</ol>\r\n// <ol>2.\tChristmas Holiday Camp</ol>\r\n// <ol>3.\tMusical Tours</ol>\r\n// <ol>4.\tArt and Design Tours</ol>\r\n// <ol>5.\tMid Term Break Tours</ol>\r\n// </ul>\r\n// </p>\r\n// <p>You have been hired as a product designer to show the world what they offer.</p>\r\n// <p>The following sections are what they want on their landing page after the header  - Service Avaliable, Why people book tour with them , Core Values, and Testimonial from past customers.\r\n// </br>\r\n// </br>\r\n// Feel free to be creative and add features that you consider vital to the business.\r\n\r\n// </br>\r\n// </br>\r\n// Constraint: Use existing web capabilities\r\n// </br>\r\n// </br>\r\n// Mode of submission\r\n\r\n// <ul>\r\n// <ol>1. Fill this form before your presentation: Challenge 1 Submission\r\n// </ol>\r\n// <ol>2. Prepare for your presentation on Thursday, 10th February, 2022\r\n// </ol>\r\n\r\n// </ul>\r\n// I wish you best of luck\r\n\r\n// `;\r\nfunction Challenge() {\r\n  const [showComponent, setShowComponent] = useState(\"main\");\r\n  const [showChallenge, setShowChallenge] = useState(\"\");\r\n  return (\r\n    <div className=\"challengepage__container\">\r\n      {showComponent === \"main\" && (\r\n        <>\r\n          <div className=\"challengepage-headtext\">\r\n            <h3>Challenges</h3>\r\n          </div>\r\n          <ChallengeProgress percentage={70} noCompleted={2} />\r\n\r\n          <div className=\"challenge\">\r\n            <h5 className=\"challenge-header\">Challenges</h5>\r\n            <div className=\"challenge__container\">\r\n              <ChallengeCard\r\n                size={\"short\"}\r\n                textColor={\"#00000\"}\r\n                bgColor={\"#F9F9F9\"}\r\n                title={\"Challenge 3\"}\r\n                topBand={\"76\"}\r\n                lowerBand={100}\r\n                dueDate={\"7pm, 1st Jan, 2022\"}\r\n                buttonText={\"submitted\"}\r\n                buttonBgColor={\"#CFB9F9\"}\r\n                buttonTextColor={\"#FFF\"}\r\n                disabled={true}\r\n                setShowComponent={setShowComponent}\r\n                setShowChallenge={setShowChallenge}\r\n              />\r\n              <ChallengeCard\r\n                size={\"short\"}\r\n                textColor={\"#FFFF\"}\r\n                bgColor={\"#783DD3\"}\r\n                title={\"Challenge 1\"}\r\n                topBand={1}\r\n                lowerBand={100}\r\n                submitDate={\"6pm, 1st Jan, 2022\"}\r\n                dueDate={\"6pm, 1st Jan, 2022\"}\r\n                buttonText={\"view\"}\r\n                buttonBgColor={\"#FFFF\"}\r\n                buttonTextColor={\"rgba(120, 61, 211, 0.85)\"}\r\n                disabled={false}\r\n                setShowComponent={setShowComponent}\r\n                setShowChallenge={setShowChallenge}\r\n              />\r\n              <LockedChallenge text=\"Challenge 3\" />\r\n            </div>\r\n          </div>\r\n\r\n          <ChallengeCard\r\n            size={\"short\"}\r\n            textColor={\"#FFFF\"}\r\n            bgColor={\"#783DD3\"}\r\n            title={\"Challenge 1\"}\r\n            topBand={1}\r\n            lowerBand={100}\r\n            submitDate={\"6pm, 1st Jan, 2022\"}\r\n            dueDate={\"6pm, 1st Jan, 2022\"}\r\n            buttonText={\"view\"}\r\n            buttonBgColor={\"#FFFF\"}\r\n            buttonTextColor={\"rgba(120, 61, 211, 0.85)\"}\r\n            disabled={false}\r\n          />\r\n          <ChallengeCard\r\n            size={\"short\"}\r\n            textColor={\"#00000\"}\r\n            bgColor={\"#F9F9F9\"}\r\n            title={\"Challenge 3\"}\r\n            topBand={\"76\"}\r\n            lowerBand={100}\r\n            dueDate={\"7pm, 1st Jan, 2022\"}\r\n            buttonText={\"submitted\"}\r\n            buttonBgColor={\"#CFB9F9\"}\r\n            buttonTextColor={\"#FFF\"}\r\n            disabled={true}\r\n          />\r\n          {/* \r\n      <ChallengeCard\r\n        size={\"long\"}\r\n        textColor={\"#00000\"}\r\n        bgColor={\"#F9F9F9\"}\r\n        title={\"Challenge 3\"}\r\n        topBand={\"--\"}\r\n        lowerBand={100}\r\n        dueDate={\"7pm, 1st Jan, 2022\"}\r\n        buttonText={\"submitted\"}\r\n        buttonBgColor={\"#99979C\"}\r\n        buttonTextColor={\"#FFF\"}\r\n        disabled={true}\r\n      /> */}\r\n          <LockedChallenge text=\"Challenge 3\" />\r\n          {/* <ChallengeText\r\n        heading=\"Empire Travel Group\"\r\n        text={<Component1 String={value} />}\r\n      /> */}\r\n          <ProfileCard image={img} name={\"Daniel Owolabi\"} cohort={\"001\"} />\r\n          <CohortCard cohort=\"001\" status=\"Admitted\" />\r\n        </>\r\n      )}\r\n\r\n      {showComponent === \"detail\" && (\r\n        <ChallengeDetail showChallenge={showChallenge} />\r\n      )}\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default Challenge;\r\n","C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\academy-dashboard\\pages\\payment\\Payment.js",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\academy-dashboard\\pages\\portfolio\\Portfolio.js",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\academy-dashboard\\pages\\settings\\Settings.js",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\pages\\Landing.js",["396","397","398","399","400","401","402","403","404","405","406","407","408","409","410"],"import { useEffect, useState, useContext } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { Accordion, Card } from \"react-bootstrap\";\r\nimport { MdKeyboardArrowDown } from \"react-icons/md\";\r\nimport Slider from \"infinite-react-carousel\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport Mode from \"../components/Mode\";\r\nimport { Container, Row, Col } from \"react-bootstrap\";\r\nimport { ToastContainer, toast } from \"react-toastify\";\r\n\r\nimport Abdullahi from \"../images/testimonial/abdullahi.jpeg\";\r\nimport Adedamola from \"../images/testimonial/adedamola.jpeg\";\r\nimport Bosun from \"../images/testimonial/bosun.jpg\";\r\nimport Grazac from \"../images/svg/logo-round.svg\";\r\nimport Video from \"../images/landing-video2.mp4\";\r\nimport Object from \"../images/svg/objects.svg\";\r\nimport poster from \"../images/Grazac-website/IMG_8403.JPG\";\r\nimport grad1 from \"../images/grad1.png\";\r\nimport grad2 from \"../images/grad2.png\";\r\nimport grad3 from \"../images/grad3.png\";\r\nimport grad4 from \"../images/grad4.png\";\r\nimport scroll from \"../images/testimonial-scroll.png\";\r\n\r\nimport badge from \"../images/svg/badge.svg\";\r\nimport ex from \"../images/svg/x-mark.svg\";\r\nimport Sponsor1 from \"../images/svg/Apple.svg\";\r\nimport Sponsor2 from \"../images/svg/AWS.svg\";\r\nimport Sponsor3 from \"../images/svg/Flutterwave.svg\";\r\nimport Sponsor5 from \"../images/svg/Microsoft.svg\";\r\nimport Sponsor6 from \"../images/svg/Google.svg\";\r\nimport mark from \"../images/svg/mark.svg\";\r\nimport join from \"../images/svg/join.svg\";\r\nimport why1 from \"../images/svg/why1.svg\";\r\nimport why2 from \"../images/svg/why2.svg\";\r\nimport why3 from \"../images/svg/why3.svg\";\r\nimport why4 from \"../images/svg/why4.svg\";\r\nimport product from \"../images/product.png\";\r\nimport frontend from \"../images/frontend.png\";\r\nimport backend from \"../images/backend.png\";\r\nimport android from \"../images/android.png\";\r\nimport product_management from \"../images/product_management.png\";\r\n\r\nimport { LoaderContext } from \"../context\";\r\nimport WhatsApp from \"../components/whatsApp/whatsApp\";\r\n\r\nconst Landing = () => {\r\n  const [showModal, setShowModal] = useState(true);\r\n  const { setShow, show } = useContext(LoaderContext);\r\n  useEffect(() => {\r\n    // document.title = \"Welcome to Grazac Academy\";\r\n    let mediaPlayer = document.querySelector(\"#video\");\r\n    mediaPlayer.controls = false;\r\n    mediaPlayer.play();\r\n\r\n    //this gives the homepage spacing on top for the notification\r\n    var landingHeight = document.getElementsByClassName(\"landing\")[0];\r\n    landingHeight.style.marginTop = `70px`;\r\n\r\n    window.addEventListener(\"load\", () => {\r\n      setShow(false);\r\n    });\r\n  }, []);\r\n\r\n  const handleModal = () => {\r\n    setShowModal(false);\r\n    var landingHeight = document.getElementsByClassName(\"landing\")[0];\r\n    landingHeight.style.marginTop = `0px`;\r\n  };\r\n\r\n  const handleFaq = (e) => {\r\n    let svg = e.target.parentElement.querySelector(\"svg\");\r\n    if (e.target.nodeName === \"path\") {\r\n      svg = e.target.parentElement.parentElement.querySelector(\"svg\");\r\n    }\r\n    svg.classList.toggle(\"faq-icon_transition\");\r\n  };\r\n\r\n  const scrolLeft = () => {\r\n    document.getElementById(\"scrolltainer\").scrollLeft -= 200;\r\n  };\r\n\r\n  const scrolRight = () => {\r\n    document.getElementById(\"scrolltainer\").scrollLeft += 200;\r\n  };\r\n\r\n  const showToast = () => {\r\n    toast.info(\r\n      \"Application into Cohort (CH011) is closed. Enrollment into CH012 begins July 2022.\"\r\n    );\r\n  };\r\n\r\n  return (\r\n    <>\r\n      <div className=\"landing\">\r\n        <ToastContainer closeButton={false} position=\"bottom-right\" />\r\n        {showModal && (\r\n          <div className=\"infomodal\">\r\n            <div className=\"infomodal_content\">\r\n              <img src={badge} alt=\"\" className=\"infomodal_badge\" />\r\n              <p>\r\n                Application is Now Open\r\n                {/* <a\r\n                className=\"infomodal_content-link\"\r\n                href=\"/login\"\r\n              >\r\n                Apply Now\r\n              </a> */}\r\n              </p>\r\n              {/* <Link to=\"/graduate-accelerator-plan\">\r\n              <button>Learn more</button>\r\n            </Link> */}\r\n\r\n              <img\r\n                src={ex}\r\n                alt=\"\"\r\n                onClick={handleModal}\r\n                style={{ cursor: \"pointer\" }}\r\n              />\r\n            </div>\r\n          </div>\r\n        )}\r\n        <div className=\"landing__header\">\r\n          <Navbar top={true} />\r\n          {/* <img src={Object} className=\"bg-img\" alt=\"ccc\" /> */}\r\n          <div style={{ height: 10 }}></div>\r\n\r\n          <div className=\"landing__text\">\r\n            <h1>\r\n              Upskilling You For The <span>Future</span> Of Work\r\n            </h1>\r\n            <p>\r\n              Learn valuable technology skills with our wide range of courses{\" \"}\r\n              <br className=\"hide-at-600\" /> and land your dream job.{\" \"}\r\n            </p>\r\n          </div>\r\n\r\n          {/* <a onClick={showToast}> */}\r\n          <Link to=\"/login\">\r\n            <div\r\n              className=\"nav__btn\"\r\n              style={{ width: \"130px\", margin: \"auto\", textAlign: \"center\" }}\r\n            >\r\n              {/* <a href=\"/login\" > */}\r\n              <div className=\"nav__btn--text\">Apply Now</div>\r\n              {/* <div className=\"nav__btn\">Apply Now</div> */}\r\n            </div>\r\n          </Link>\r\n          {/* </a> */}\r\n\r\n          <div className=\"landing__text-below\">\r\n            <div>\r\n              <img src={mark} alt=\"mark\" />\r\n              <h6>Conducive environment</h6>\r\n            </div>\r\n            <div>\r\n              <img src={mark} alt=\"mark\" />\r\n              <h6>No prior experience required</h6>\r\n            </div>\r\n            <div>\r\n              <img src={mark} alt=\"mark\" />\r\n              <h6>Flexible payment options</h6>\r\n            </div>\r\n          </div>\r\n        </div>\r\n\r\n        <div className=\"landing__video\">\r\n          <video\r\n            id=\"video\"\r\n            width=\"320\"\r\n            height=\"240\"\r\n            autoPlay\r\n            loop\r\n            muted\r\n            poster={poster}\r\n          >\r\n            <source src={Video} type=\"video/mp4\" />\r\n          </video>\r\n        </div>\r\n\r\n        <div className=\"landing__sponsors\">\r\n          <div className=\"landing__sponsors--container\">\r\n            <img src={Sponsor1} alt=\"sponsor\" />\r\n            <img src={Sponsor2} alt=\"sponsor\" />\r\n            <img src={Sponsor3} alt=\"sponsor\" />\r\n            <img src={Sponsor5} alt=\"sponsor\" />\r\n            <img src={Sponsor6} alt=\"sponsor\" />\r\n          </div>\r\n        </div>\r\n\r\n        <div>\r\n          <Container>\r\n            <div className=\"course_mode-intro course_mode-intro\">\r\n              <h2 style={{ margin: \"80px 0 30px\" }} className=\"join_heading\">\r\n                Why Grazac Academy is the\r\n                <br className=\"hide-at-600\" /> best for you\r\n              </h2>\r\n            </div>\r\n          </Container>\r\n        </div>\r\n\r\n        <div style={{ boxSizing: \"border-box\", margin: \"0 0 80px\" }}>\r\n          <Container>\r\n            <Row>\r\n              <Col md={6}>\r\n                <div className=\"join_box1\">\r\n                  <div className=\"\">\r\n                    <img src={why1} alt=\"profile\" />\r\n                  </div>\r\n                  <h4>There are no learning barriers </h4>\r\n                  <p className=\"hire_dev-grey\">\r\n                    We make starting a career in tech accessible to anyone.\r\n                    Whether you are a graduate or you are an undergraduate;\r\n                    whether you are young or old, and no matter your experience\r\n                    level - our model, courses, and community has been designed\r\n                    to make you feel comfortable and fully engaged in the\r\n                    learning process.\r\n                  </p>\r\n                </div>\r\n              </Col>\r\n              <Col md={6}>\r\n                <div className=\"join_box1\">\r\n                  <div className=\"\">\r\n                    <img src={why2} alt=\"profile\" />\r\n                  </div>\r\n                  <h4>1:1 access to mentorship and support</h4>\r\n                  <p className=\"hire_dev-grey\">\r\n                    You gain 24/7 access to a wide range of industry experts\r\n                    that will walk you through your career path and increase\r\n                    your visibility to potential employers.\r\n                  </p>\r\n                </div>\r\n              </Col>\r\n            </Row>\r\n            <Row>\r\n              <Col md={6}>\r\n                <div className=\"join_box1\">\r\n                  <div className=\"\">\r\n                    <img src={why3} alt=\"profile\" />\r\n                  </div>\r\n                  <h4>Recognized Certification</h4>\r\n                  <p className=\"hire_dev-grey\">\r\n                    You get a recognized certificate that serves as a proof that\r\n                    you are skilled enough to work in any organization in or\r\n                    outside Nigeria.\r\n                  </p>\r\n                </div>\r\n              </Col>\r\n              <Col md={6}>\r\n                <div className=\"join_box1\">\r\n                  <div className=\"\">\r\n                    <img src={why4} alt=\"profile\" />\r\n                  </div>\r\n                  <h4>3-months Compulsory Internship</h4>\r\n                  <p className=\"hire_dev-grey\">\r\n                    Get real workplace experience. You stand a chance to work\r\n                    with amazing teams on real-life projects to solve related\r\n                    problems so you can build your portfolio for at least\r\n                    3-months.\r\n                  </p>\r\n                </div>\r\n              </Col>\r\n            </Row>\r\n          </Container>\r\n        </div>\r\n\r\n        <div className=\"landing__intern\">\r\n          <div className=\"landing__intern--content\">\r\n            <div className=\"landing__bottom--text\">\r\n              <h2>Available Courses</h2>\r\n            </div>\r\n            <div className=\"landing__slider-text1\">\r\n              <p>\r\n                Learn any of these tech courses today for free and pay back when\r\n                you are hired.\r\n              </p>\r\n            </div>\r\n            <div className=\"gga_container\">\r\n              <Link\r\n                to={`/course-detail-graduate?course=product-designing-ui-ux`}\r\n                className=\"boxes33\"\r\n              >\r\n                <div className=\"gua_cardview\">\r\n                  <div className=\"gua_cardview-box\">\r\n                    <img src={product} alt=\"course-desc\" />\r\n                  </div>\r\n                  <div className=\"gua_cardview-text\">\r\n                    <h4 style={{ color: \"rgb(51, 51, 51)\" }}>\r\n                      Product Design (UI/UX)\r\n                    </h4>\r\n                    <p>\r\n                      User interface design or user interface engineering is the\r\n                      design of user interfaces for machines and software, such\r\n                      as computers, home appliances, mobile devices, and other\r\n                      electronic devices, with the focus on maximizing usability\r\n                      and the user experience.\r\n                    </p>\r\n                    <Link\r\n                      to={`/course-detail-graduate?course=product-designing-ui-ux`}\r\n                    >\r\n                      Learn More\r\n                    </Link>\r\n                  </div>\r\n                </div>\r\n              </Link>\r\n              <Link\r\n                to={`/course-detail-graduate?course=frontend-web-development`}\r\n                className=\"boxes33\"\r\n              >\r\n                <div className=\"gua_cardview\">\r\n                  <div className=\"gua_cardview-box\">\r\n                    <img src={frontend} alt=\"course-desc\" />\r\n                  </div>\r\n                  <div className=\"gua_cardview-text\">\r\n                    <h4 style={{ color: \"rgb(51, 51, 51)\" }}>\r\n                      Front-End Development\r\n                    </h4>\r\n                    <p>\r\n                      Front-end web development, also known as client-side\r\n                      development is the practice of producing HTML, CSS and\r\n                      JavaScript for a website or Web Application so that a user\r\n                      can see and interact with them directly.\r\n                    </p>\r\n                    <Link\r\n                      to={`/course-detail-graduate?course=frontend-web-development`}\r\n                    >\r\n                      Learn More\r\n                    </Link>\r\n                  </div>\r\n                </div>\r\n              </Link>\r\n              <Link\r\n                to={`/course-detail-graduate?course=backend-web-development`}\r\n                className=\"boxes33\"\r\n              >\r\n                <div className=\"gua_cardview\">\r\n                  <div className=\"gua_cardview-box\">\r\n                    <img src={backend} alt=\"course-desc\" />\r\n                  </div>\r\n                  <div className=\"gua_cardview-text\">\r\n                    <h4 style={{ color: \"rgb(51, 51, 51)\" }}>\r\n                      Back-End Development\r\n                    </h4>\r\n                    <p>\r\n                      Node.js is useful for developing applications that require\r\n                      a persistent connection from the browser to the server and\r\n                      is often used for real-time applications such as chat,\r\n                      news feeds and web push notifications.\r\n                    </p>\r\n                    <Link\r\n                      to={`/course-detail-graduate?course=backend-web-development`}\r\n                    >\r\n                      Learn More\r\n                    </Link>\r\n                  </div>\r\n                </div>\r\n              </Link>\r\n              <Link\r\n                to={`/course-detail-graduate?course=mobile-application-development`}\r\n                className=\"boxes33\"\r\n              >\r\n                <div className=\"gua_cardview\">\r\n                  <div className=\"gua_cardview-box\">\r\n                    <img src={android} alt=\"course-desc\" />\r\n                  </div>\r\n                  <div className=\"gua_cardview-text\">\r\n                    <h4 style={{ color: \"rgb(51, 51, 51)\" }}>\r\n                      Mobile App Developement\r\n                    </h4>\r\n                    <p>\r\n                      Flutter is an incredible user interface (UI) toolkit that\r\n                      lets you build apps for iOS and Android — and even the web\r\n                      and desktop platforms like macOS, Windows and Linux — all\r\n                      from a single codebase.\r\n                    </p>\r\n                    <Link\r\n                      to={`/course-detail-graduate?course=mobile-application-development`}\r\n                    >\r\n                      Learn More\r\n                    </Link>\r\n                  </div>\r\n                </div>\r\n              </Link>\r\n\r\n              <Link\r\n                to={`/course-detail-graduate?course=product-management`}\r\n                className=\"boxes33\"\r\n              >\r\n                <div className=\"gua_cardview\">\r\n                  <div className=\"gua_cardview-box\">\r\n                    <img src={product_management} alt=\"course-desc\" />\r\n                  </div>\r\n                  <div className=\"gua_cardview-text\">\r\n                    <h4 style={{ color: \"rgb(51, 51, 51)\" }}>\r\n                      Product Management\r\n                    </h4>\r\n                    <p>\r\n                      Product management is the process of strategically guiding\r\n                      a company's product development, market launch, ongoing\r\n                      support and improvement of a product. It is basically\r\n                      making a product the best version it can be and\r\n                      fine-tuning a company’s product in order to make it appeal\r\n                      to the organization’s target audience and customers\r\n                    </p>\r\n                    <Link\r\n                      to={`/course-detail-graduate?course=product-management`}\r\n                    >\r\n                      Learn More\r\n                    </Link>\r\n                  </div>\r\n                </div>\r\n              </Link>\r\n            </div>\r\n            <Link to=\"/login\">\r\n              <div\r\n                className=\"nav__btn\"\r\n                style={{ width: \"130px\", margin: \"auto\", textAlign: \"center\" }}\r\n                // onClick={showToast}\r\n              >\r\n                <div className=\"nav__btn--text\">Apply Now</div>\r\n              </div>\r\n            </Link>\r\n          </div>\r\n        </div>\r\n\r\n        <div className=\"landing__discover\">\r\n          <div className=\"landing__bottom--text1\">\r\n            <h1>\r\n              How the Admission <br className=\"hide-at-600\" />\r\n              Process Works\r\n            </h1>\r\n            <p>\r\n              Understand our admission process <br className=\"hide-at-600\" />\r\n              in 3 easy steps\r\n            </p>\r\n          </div>\r\n          <div className=\"landing__discover--container\">\r\n            <div className=\"landing__discover--images\">\r\n              <div className=\"landing__discover--images-left\">\r\n                <div></div>\r\n                <div></div>\r\n              </div>\r\n              <div className=\"landing__discover--images-right\">\r\n                <div></div>\r\n              </div>\r\n            </div>\r\n\r\n            <div className=\"landing__discover--list\">\r\n              <div className=\"landing__discover--list-item\">\r\n                <h2>01</h2>\r\n                <div>\r\n                  <h3>Fill and submit the application form</h3>\r\n                  <p>\r\n                    Create an account to start your application. Login to your\r\n                    dashboard and fill in your correct details.\r\n                  </p>\r\n                </div>\r\n              </div>\r\n\r\n              <div className=\"landing__discover--list-item\">\r\n                <h2>02</h2>\r\n                <div>\r\n                  <h3>Pass the assessment tests</h3>\r\n                  <p>\r\n                    If your application is successful, you will be contacted via\r\n                    mail to take a physical assessment test to ensure your\r\n                    commitment meets our standard.\r\n                  </p>\r\n                </div>\r\n              </div>\r\n\r\n              <div className=\"landing__discover--list-item\">\r\n                <h2>03</h2>\r\n                <div>\r\n                  <h3>Complete the process and begin your journey into Tech</h3>\r\n                  <p>\r\n                    Once you pass the assessment test, you are eligible for\r\n                    admission. You will receive a mail on how to complete your\r\n                    admission process.\r\n                  </p>\r\n                </div>\r\n              </div>\r\n              <div className=\"landing__discover--list-item\"></div>\r\n              <div className=\"landing__discover--list-item\"></div>\r\n              <Link to=\"/login\">\r\n                {/* <div className=\"nav__btn one-btn\" onClick={showToast}> */}\r\n                <div className=\"nav__btn one-btn\">\r\n                  <div className=\"nav__btn--text\">Apply Now</div>\r\n                </div>\r\n              </Link>\r\n            </div>\r\n          </div>\r\n        </div>\r\n\r\n        <div>\r\n          <div className=\"landing__bottom--text\">\r\n            <h2>Testimonials</h2>\r\n          </div>\r\n          <div className=\"landing__slider-text1\">\r\n            <p>\r\n              The success stories, testimonials and reviews from our students\r\n              are exceptional. These are our students that put in deliberate\r\n              efforts and have been intentional and consistent in implementing\r\n              what they learnt from the course.\r\n            </p>\r\n          </div>\r\n          <div className=\"landing__slider-contain\">\r\n            <div className=\"landing__slider--container\" id=\"scrolltainer\">\r\n              <img\r\n                src={scroll}\r\n                alt=\"scroll\"\r\n                className=\"scroll-left\"\r\n                onClick={scrolLeft}\r\n              />\r\n              <img\r\n                src={scroll}\r\n                alt=\"scroll\"\r\n                className=\"scroll-right\"\r\n                onClick={scrolRight}\r\n              />\r\n              <div className=\"video-width\">\r\n                <iframe\r\n                  className=\"video-width\"\r\n                  src=\"https://www.youtube.com/embed/ht8l30MozEM\"\r\n                  title=\"YouTube video player\"\r\n                  frameborder=\"0\"\r\n                  allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\"\r\n                  allowfullscreen\r\n                ></iframe>\r\n              </div>\r\n              <div className=\"video-width\">\r\n                <iframe\r\n                  className=\"video-width\"\r\n                  src=\"https://www.youtube.com/embed/ck-f8UD8RqU\"\r\n                  title=\"YouTube video player\"\r\n                  frameborder=\"0\"\r\n                  allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\"\r\n                  allowfullscreen\r\n                ></iframe>\r\n              </div>\r\n              <div className=\"video-width\">\r\n                <iframe\r\n                  className=\"video-width\"\r\n                  src=\"https://www.youtube.com/embed/IG5cs69PmBo\"\r\n                  title=\"YouTube video player\"\r\n                  frameborder=\"0\"\r\n                  allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\"\r\n                  allowfullscreen\r\n                ></iframe>\r\n              </div>\r\n              <div>\r\n                <iframe\r\n                  className=\"video-width\"\r\n                  src=\"https://www.youtube.com/embed/l5FVImbxdqw\"\r\n                  title=\"YouTube video player\"\r\n                  frameborder=\"0\"\r\n                  allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\"\r\n                  allowfullscreen\r\n                ></iframe>\r\n              </div>\r\n              <div className=\"video-width\">\r\n                <iframe\r\n                  className=\"video-width\"\r\n                  src=\"https://www.youtube.com/embed/6_ILohsUndE\"\r\n                  title=\"YouTube video player\"\r\n                  frameborder=\"0\"\r\n                  allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\"\r\n                  allowfullscreen\r\n                ></iframe>\r\n              </div>\r\n              <div>\r\n                <iframe\r\n                  className=\"video-width\"\r\n                  src=\"https://www.youtube.com/embed/M8mStqg17cQ\"\r\n                  title=\"YouTube video player\"\r\n                  frameborder=\"0\"\r\n                  allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\"\r\n                  allowfullscreen\r\n                ></iframe>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n\r\n        <div>\r\n          <div\r\n            className=\"course_mode-intro course_mode-intro\"\r\n            style={{ textAlign: \"center\" }}\r\n          >\r\n            <h2 className=\"join_heading\" style={{ marginTop: \"80px\" }}>\r\n              Gallery\r\n            </h2>\r\n            <p className=\"join_needed\">\r\n              Images of our students that put in deliberate efforts and have\r\n              been intentional and consistent in implementing{\" \"}\r\n              <br className=\"hide-at-600\" />\r\n              what they learnt from the course.\r\n            </p>\r\n          </div>\r\n          <Container>\r\n            <div className=\"join_gallery\">\r\n              <div className=\"join_gallery-top\">\r\n                <div className=\"join_gallery-top-left\">\r\n                  <img src={grad1} />\r\n                </div>\r\n                <div className=\"join_gallery-top-right\">\r\n                  <img src={grad4} />\r\n                </div>\r\n              </div>\r\n              <div className=\"join_gallery-bottom\">\r\n                <div className=\"join_gallery-bottom-left\">\r\n                  <img src={grad2} />\r\n                </div>\r\n                <div className=\"join_gallery-bottom-right\">\r\n                  <img src={grad3} />\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </Container>\r\n        </div>\r\n\r\n        <div\r\n          className=\"landing__bottom\"\r\n          id=\"landing__bottom\"\r\n          style={{ paddingBottom: 0 }}\r\n        >\r\n          <div className=\"landing__bottom--text\">\r\n            <div className=\"landing__bottom--text--right\">\r\n              <h1>\r\n                Discover Top Tech <br />\r\n                Talent Here\r\n              </h1>\r\n              <p>\r\n                Find experienced fresh tech talents and professionals with\r\n                authentic background that match your requirements.\r\n              </p>\r\n              <div className=\"landing__btn--2\">\r\n                <Link to=\"/hire\">\r\n                  <div\r\n                    className=\"nav__btn nav__btn-flex \"\r\n                    // onClick={() => toast.info(\"Coming Soon\")}\r\n                  >\r\n                    <a className=\"nav__btn--text\">Hire our Talents</a>\r\n                  </div>\r\n                </Link>\r\n              </div>\r\n            </div>\r\n\r\n            <div className=\"landing__bottom--text--left\">\r\n              <img src={Grazac} alt=\"img\" />\r\n            </div>\r\n          </div>\r\n        </div>\r\n\r\n        {/* FAQ section commented out till content is ready */}\r\n        <div className=\"landing_faq\">\r\n          <div className=\"container\">\r\n            <h1>FAQs</h1>\r\n            <div>\r\n              <Accordion>\r\n                <Card>\r\n                  <Accordion.Toggle as={Card.Header} eventKey=\"0\">\r\n                    <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                      <h4>How do I register?</h4>\r\n                      <MdKeyboardArrowDown size=\"2rem\" color=\"black\" />\r\n                    </div>\r\n                  </Accordion.Toggle>\r\n                  <Accordion.Collapse eventKey=\"0\">\r\n                    <Card.Body>\r\n                      <div className=\"landing_faq-answer\">\r\n                        <p>\r\n                          Visit www.grazacacademy.com and click the “apply now”\r\n                          button to create an account. Login to your dashboard\r\n                          to complete your application.\r\n                        </p>\r\n                      </div>\r\n                    </Card.Body>\r\n                  </Accordion.Collapse>\r\n                </Card>\r\n                <hr />\r\n                <Card>\r\n                  <Accordion.Toggle as={Card.Header} eventKey=\"1\">\r\n                    <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                      <h4>After registration, what next?</h4>\r\n                      <MdKeyboardArrowDown size=\"2rem\" color=\"black\" />\r\n                    </div>\r\n                  </Accordion.Toggle>\r\n                  <Accordion.Collapse eventKey=\"1\">\r\n                    <Card.Body>\r\n                      <div className=\"landing_faq-answer\">\r\n                        <p>\r\n                          Once you have successfully registered, an email will\r\n                          be sent to you detailing the next steps of the\r\n                          registration process. Ensure that you provide a valid\r\n                          email address and keep an eye on your inbox.\r\n                        </p>\r\n                      </div>\r\n                    </Card.Body>\r\n                  </Accordion.Collapse>\r\n                </Card>\r\n                <hr />\r\n                <Card>\r\n                  <Accordion.Toggle as={Card.Header} eventKey=\"2\">\r\n                    <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                      <h4>Do I have to be physically present to register?</h4>\r\n                      <MdKeyboardArrowDown size=\"2rem\" color=\"black\" />\r\n                    </div>\r\n                  </Accordion.Toggle>\r\n                  <Accordion.Collapse eventKey=\"2\">\r\n                    <Card.Body>\r\n                      <div className=\"landing_faq-answer\">\r\n                        <p>\r\n                          No. Registration can be done online but applicants\r\n                          have to be physically present to write the assessment\r\n                          test.\r\n                        </p>\r\n                      </div>\r\n                    </Card.Body>\r\n                  </Accordion.Collapse>\r\n                </Card>\r\n                <hr />\r\n                <Card>\r\n                  <Accordion.Toggle as={Card.Header} eventKey=\"3\">\r\n                    <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                      <h4>\r\n                        Do I need to have any previous experience or knowledge\r\n                        before coming to learn?\r\n                      </h4>\r\n                      <MdKeyboardArrowDown size=\"2rem\" color=\"black\" />\r\n                    </div>\r\n                  </Accordion.Toggle>\r\n                  <Accordion.Collapse eventKey=\"3\">\r\n                    <Card.Body>\r\n                      <div className=\"landing_faq-answer\">\r\n                        <p>\r\n                          Not at all. All our courses are designed to help\r\n                          people from any educational background and experience\r\n                          level, achieve a successful career in tech.\r\n                        </p>\r\n                      </div>\r\n                    </Card.Body>\r\n                  </Accordion.Collapse>\r\n                </Card>\r\n                <hr />\r\n                <Card>\r\n                  <Accordion.Toggle as={Card.Header} eventKey=\"4\">\r\n                    <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                      <h4>Are classes virtual or physical?</h4>\r\n                      <MdKeyboardArrowDown size=\"2rem\" color=\"black\" />\r\n                    </div>\r\n                  </Accordion.Toggle>\r\n                  <Accordion.Collapse eventKey=\"4\">\r\n                    <Card.Body>\r\n                      <div className=\"landing_faq-answer\">\r\n                        <p>\r\n                          Classes are 100% physical and this is to ensure\r\n                          students get maximum support and mentorship from their\r\n                          tutors.\r\n                        </p>\r\n                      </div>\r\n                    </Card.Body>\r\n                  </Accordion.Collapse>\r\n                </Card>\r\n                <hr />\r\n                <Card>\r\n                  <Accordion.Toggle as={Card.Header} eventKey=\"5\">\r\n                    <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                      <h4>What is the duration of the program?</h4>\r\n                      <MdKeyboardArrowDown size=\"2rem\" color=\"black\" />\r\n                    </div>\r\n                  </Accordion.Toggle>\r\n                  <Accordion.Collapse eventKey=\"5\">\r\n                    <Card.Body>\r\n                      <div className=\"landing_faq-answer\">\r\n                        <p>\r\n                          The program runs for at least 6 months (3 months of\r\n                          immersive training and 3 months internship)\r\n                        </p>\r\n                      </div>\r\n                    </Card.Body>\r\n                  </Accordion.Collapse>\r\n                </Card>\r\n                <Link to=\"/faq\" className=\"link-view\">\r\n                  <h5>View All</h5>\r\n                </Link>\r\n              </Accordion>\r\n            </div>\r\n          </div>\r\n        </div>\r\n        <Mode\r\n          id=\"landing_page_mode\"\r\n          page={\"home\"}\r\n          title={\"Ready to fill your vacant position?\"}\r\n          text={\r\n            \"Explore diverse tech talents of your choice with genuine skillsets and good workplace ethics.\"\r\n          }\r\n          button_1={\"Hire from us\"}\r\n          button_2={\"Chat with us\"}\r\n        />\r\n\r\n        {/* <WhatsApp /> */}\r\n        <Footer />\r\n      </div>\r\n    </>\r\n  );\r\n};\r\n\r\nexport default Landing;\r\n","C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\pages\\graduateCohort\\auth\\SignUp.js",["411","412","413"],"import { useEffect, useState } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { ToastContainer, toast } from \"react-toastify\";\r\nimport { SignupAction } from \"../../../api/dashboard/auth\";\r\nimport { LazyLoadImage } from \"react-lazy-load-image-component\";\r\nimport Terms from \"../../../images/newsletter/terms.pdf\"\r\nimport Pricing from \"../../../images/newsletter/pricing.pdf\"\r\nimport authImg from \"../../../images/auth.png\";\r\nimport logo from \"../../../images/svg/academy-logo.svg\";\r\nimport visible from \"../../../images/svg/visible.svg\";\r\nimport notvisible from \"../../../images/svg/notvisible.svg\";\r\nimport loader from \"../../../images/svg/dashboard/loader.gif\";\r\n\r\nfunction SignUp() {\r\n  const [form, setForm] = useState({\r\n    firstName: \"\",\r\n    lastName: \"\",\r\n    email: \"\",\r\n    phone: \"\",\r\n    password: \"\",\r\n    cohort_batch: \"\",\r\n  });\r\n\r\n  const handleChange = (e) => {\r\n    setForm({\r\n      ...form,\r\n      [e.target.name]: e.target.value,\r\n    });\r\n  };\r\n\r\n  async function doSignUp(e) {\r\n    e.preventDefault();\r\n    console.log(\"ffffff\");\r\n    console.log(form);\r\n    var btn = document.getElementById(\"actionBtn\");\r\n\r\n    if (form.password.length > 5) {\r\n      // btn.innerHTML=`<img src=${loader} width=\"20px\" />`;\r\n      const { firstName, lastName, email, phone, password, cohort_batch } =\r\n        form;\r\n      var data = new FormData();\r\n      const phone_length = phone.length;\r\n\r\n      if (phone_length == 11 || phone_length > 11) {\r\n        data.append(\"firstName\", firstName);\r\n        data.append(\"lastName\", lastName);\r\n        data.append(\"email\", email);\r\n        data.append(\"phoneNumber\", phone);\r\n        data.append(\"password\", password);\r\n        data.append(\"cohort_batch\", cohort_batch);\r\n\r\n        btn.innerHTML = `<img src=${loader} width=\"20px\" />`;\r\n\r\n        try {\r\n          const response = await SignupAction(data);\r\n\r\n          const res = await response;\r\n          // const res.data.status ==201\r\n          if (res.data.status === 201) {\r\n            toast.success(`${res.data.message} Proceed to login.`);\r\n            // btn.innerHTML=`Create account`;\r\n            // btn.innerHTML=\"<p>Create account</p>\";\r\n\r\n            window.location = `/account-created?email=${email}`;\r\n          } else {\r\n            toast.error(\"Something went wrong, please try again!!!\");\r\n            btn.innerHTML = \"<p>Create account</p>\";\r\n          }\r\n        } catch (err) {\r\n          if (err.response.data.message) {\r\n            toast.error(err.response.data.message);\r\n            btn.innerHTML = `Create account`;\r\n          } else {\r\n            toast.error(\r\n              \"Something went wrong!!! Please make sure you have a good internet connection.\"\r\n            );\r\n            btn.innerHTML = `Create account`;\r\n          }\r\n        }\r\n      } else {\r\n        toast.error(\"please enter correct phone number\");\r\n      }\r\n    } else {\r\n      toast.error(\"Password must be at least 6 characters!\");\r\n    }\r\n  }\r\n\r\n  const toggleIcon = () => {\r\n    var x = document.getElementById(\"password\");\r\n    var iconContainer = document.getElementById(\"toggle\");\r\n    if (x.type === \"password\") {\r\n      x.type = \"text\";\r\n      iconContainer.innerHTML = `<img src=${notvisible} />`;\r\n    } else {\r\n      x.type = \"password\";\r\n      iconContainer.innerHTML = `<img src=${visible} />`;\r\n    }\r\n  };\r\n\r\n  return (\r\n    <div className=\"layout_auth\">\r\n      <ToastContainer />\r\n      <div className=\"layout_auth-main\">\r\n        <div className=\"auth_container\">\r\n          <div className=\"auth_container-logo\">\r\n            <Link to=\"/\">\r\n              <img src={logo} alt=\"logo\" />\r\n            </Link>\r\n          </div>\r\n          <div className=\"auth_container_form\">\r\n            {/* <span className=\"closed\">Application is now Closed</span> */}\r\n            <h3>Create an Account</h3>\r\n            <p className=\"auth_container_form-text\">\r\n              Create a free account to start your application\r\n            </p>\r\n            <form onSubmit={doSignUp}>\r\n              <div>\r\n                <label>First Name</label>\r\n                <input\r\n                  type=\"text\"\r\n                  required\r\n                  placeholder=\"First Name\"\r\n                  name=\"firstName\"\r\n                  onChange={handleChange}\r\n                />\r\n              </div>\r\n              <div>\r\n                <label>Last Name</label>\r\n                <input\r\n                  type=\"text\"\r\n                  required\r\n                  placeholder=\"Last Name\"\r\n                  name=\"lastName\"\r\n                  onChange={handleChange}\r\n                />\r\n              </div>\r\n              <div>\r\n                <label>Email Address</label>\r\n                <input\r\n                  type=\"email\"\r\n                  required\r\n                  placeholder=\"Email Address\"\r\n                  name=\"email\"\r\n                  onChange={handleChange}\r\n                />\r\n              </div>\r\n              <div>\r\n                <label>Phone Number</label>\r\n                <input\r\n                  type=\"number\"\r\n                  required\r\n                  placeholder=\"Phone Number\"\r\n                  name=\"phone\"\r\n                  onChange={handleChange}\r\n                />\r\n              </div>\r\n              <div className=\"auth_container_form-password\">\r\n                <label>Password</label>\r\n                <input\r\n                  type=\"password\"\r\n                  id=\"password\"\r\n                  required\r\n                  placeholder=\"Password\"\r\n                  name=\"password\"\r\n                  onChange={handleChange}\r\n                />\r\n                <div id=\"toggle\" onClick={toggleIcon}>\r\n                  <img src={visible} />\r\n                </div>\r\n              </div>\r\n              <div>\r\n                <label>Cohort</label>\r\n                <select\r\n                  name=\"cohort_batch\"\r\n                  required\r\n                  onChange={handleChange}\r\n                  defaultValue={form.cohort_batch}\r\n                >\r\n                  <option value=\"\" disabled>\r\n                    Choose your preferred cohort\r\n                  </option>\r\n                  <option value=\"CH13\" disabled>\r\n                    CH-13 - January\r\n                  </option>\r\n                  <option value=\"CH14\">CH-14 - May</option>\r\n                  <option value=\"CH15\">CH-15 - August</option>\r\n                </select>\r\n              </div>\r\n              <button type=\"submit\" id=\"actionBtn\">\r\n                Create Account\r\n              </button>\r\n              <p className=\"terms\">\r\n                By clicking “Create account” you agree to our{\" \"}\r\n                <a href={Terms} download>\r\n                  Terms & Conditions\r\n                </a>{\" \"}\r\n                and that you have read our{\" \"}\r\n                <a href={Pricing} download>\r\n                  Pricing Plan\r\n                </a>\r\n                .\r\n              </p>\r\n              <p>\r\n                Already have an account?{\" \"}\r\n                <Link to=\"/login\">\r\n                  <span>Login</span>\r\n                </Link>\r\n              </p>\r\n            </form>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <div className=\"layout_auth-image\">\r\n        <LazyLoadImage\r\n          src={authImg}\r\n          effect=\"blur\"\r\n          alt=\"auth\"\r\n          height=\"auto\"\r\n          width=\"100%\"\r\n        />\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default SignUp;\r\n","C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\pages\\Faq.js",["414"],"import React from \"react\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport { Accordion, Card } from \"react-bootstrap\";\r\nimport { MdKeyboardArrowDown, MdKeyboardArrowUp } from \"react-icons/md\";\r\nimport lady from \"../images/Grazac-website/IMG_8440.JPG\";\r\n\r\nconst Faq = () => {\r\n  React.useEffect(() => {\r\n    document.title = \"FAQs - Grazac Academy\";\r\n    window.scrollTo(0, 0);\r\n  }, []);\r\n\r\n  const handleFaq = (e) => {\r\n    let svg = e.target.parentElement.querySelector(\"svg\");\r\n    if (e.target.nodeName === \"path\") {\r\n      svg = e.target.parentElement.parentElement.querySelector(\"svg\");\r\n    }\r\n    svg.classList.toggle(\"faq-icon_transition\");\r\n  };\r\n\r\n  return (\r\n    <div>\r\n      <div className=\"faq_hero\">\r\n        <Navbar />\r\n        <div className=\"faq_hero_content\">\r\n          <h1>\r\n            Frequently Asked <br />\r\n            Questions\r\n          </h1>\r\n          <p>\r\n            To better help you learn more about Grazac Academy, we’ve compiled\r\n            the following Frequently Asked Questions (FAQs).\r\n          </p>\r\n        </div>\r\n      </div>\r\n      <div>\r\n        {/* FAQ section */}\r\n        <div className=\"landing_faq\">\r\n          <div className=\"container\">\r\n            <div>\r\n              <Accordion defaultActiveKey=\"1\">\r\n                <Card>\r\n                  <Accordion.Toggle as={Card.Header} eventKey=\"1\">\r\n                    <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                      <h4>How do I register?</h4>\r\n                      <MdKeyboardArrowDown size=\"2rem\" color=\"black\" />\r\n                    </div>\r\n                  </Accordion.Toggle>\r\n                  <Accordion.Collapse eventKey=\"1\">\r\n                    <Card.Body>\r\n                      <div className=\"landing_faq-answer\">\r\n                        <p>\r\n                          Visit www.grazacacademy.com and click the “apply now”\r\n                          button to create an account. Login to your dashboard\r\n                          to complete your application.{\" \"}\r\n                        </p>\r\n                      </div>\r\n                    </Card.Body>\r\n                  </Accordion.Collapse>\r\n                </Card>\r\n                <hr />\r\n                <Card>\r\n                  <Accordion.Toggle as={Card.Header} eventKey=\"2\">\r\n                    <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                      <h4>After registration, what next?</h4>\r\n                      <MdKeyboardArrowDown size=\"2rem\" color=\"black\" />\r\n                    </div>\r\n                  </Accordion.Toggle>\r\n\r\n                  <Accordion.Collapse eventKey=\"2\">\r\n                    <Card.Body>\r\n                      <div className=\"landing_faq-answer\">\r\n                        <p>\r\n                          Once you have successfully registered, an email will\r\n                          be sent to you detailing the next steps of the\r\n                          registration process. Ensure that you provide a valid\r\n                          email address and keep an eye on your inbox.{\" \"}\r\n                        </p>\r\n                      </div>\r\n                    </Card.Body>\r\n                  </Accordion.Collapse>\r\n                </Card>\r\n                <hr />\r\n                <Card>\r\n                  <Accordion.Toggle as={Card.Header} eventKey=\"3\">\r\n                    <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                      <h4>Where is the academy located?</h4>\r\n                      <MdKeyboardArrowDown size=\"2rem\" color=\"black\" />\r\n                    </div>\r\n                  </Accordion.Toggle>\r\n                  <Accordion.Collapse eventKey=\"3\">\r\n                    <Card.Body>\r\n                      <div className=\"landing_faq-answer\">\r\n                        <p>\r\n                          Our headquarter is located at Abeokuta, Ogun State,\r\n                          Nigeria. Address : Suite 106, PROHUB, Salawu Olabode\r\n                          Avenue, Ewang Road, Idi-aba, Abeokuta.\r\n                        </p>\r\n                      </div>\r\n                    </Card.Body>\r\n                  </Accordion.Collapse>\r\n                </Card>\r\n                <hr />\r\n                <Card>\r\n                  <Accordion.Toggle as={Card.Header} eventKey=\"4\">\r\n                    <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                      <h4>Do I have to be physically present to register?</h4>\r\n                      <MdKeyboardArrowDown size=\"2rem\" color=\"black\" />\r\n                    </div>\r\n                  </Accordion.Toggle>\r\n                  <Accordion.Collapse eventKey=\"4\">\r\n                    <Card.Body>\r\n                      <div className=\"landing_faq-answer\">\r\n                        <p>\r\n                          No. Assessment will be done online. However, you will\r\n                          be required to be physically present for an interview.\r\n                        </p>\r\n                      </div>\r\n                    </Card.Body>\r\n                  </Accordion.Collapse>\r\n                </Card>\r\n                <hr />\r\n                <Card>\r\n                  <Accordion.Toggle as={Card.Header} eventKey=\"5\">\r\n                    <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                      <h4>\r\n                        Do I need to have any previous experience or knowledge\r\n                        before coming to learn?\r\n                      </h4>\r\n                      <MdKeyboardArrowDown size=\"2rem\" color=\"black\" />\r\n                    </div>\r\n                  </Accordion.Toggle>\r\n                  <Accordion.Collapse eventKey=\"5\">\r\n                    <Card.Body>\r\n                      <div className=\"landing_faq-answer\">\r\n                        <p>\r\n                          Not at all. All our courses are designed to help\r\n                          people from any educational background and experience\r\n                          level, achieve a successful career in tech.\r\n                        </p>\r\n                      </div>\r\n                    </Card.Body>\r\n                  </Accordion.Collapse>\r\n                </Card>\r\n                <hr />\r\n                <Card>\r\n                  <Accordion.Toggle as={Card.Header} eventKey=\"6\">\r\n                    <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                      <h4>Are classes virtual or physical?</h4>\r\n                      <MdKeyboardArrowDown size=\"2rem\" color=\"black\" />\r\n                    </div>\r\n                  </Accordion.Toggle>\r\n                  <Accordion.Collapse eventKey=\"6\">\r\n                    <Card.Body>\r\n                      <div className=\"landing_faq-answer\">\r\n                        <p>\r\n                          Both. You can choose to learn physically (majorly\r\n                          recommended and tailored for graduates) or you can\r\n                          choose to learn virtually (majorly recommended and\r\n                          tailored for undergraduates).\r\n                        </p>\r\n                      </div>\r\n                    </Card.Body>\r\n                  </Accordion.Collapse>\r\n                </Card>\r\n                <hr />\r\n                <Card>\r\n                  <Accordion.Toggle as={Card.Header} eventKey=\"7\">\r\n                    <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                      <h4>What is the duration of the program?</h4>\r\n                      <MdKeyboardArrowDown size=\"2rem\" color=\"black\" />\r\n                    </div>\r\n                  </Accordion.Toggle>\r\n                  <Accordion.Collapse eventKey=\"7\">\r\n                    <Card.Body>\r\n                      <div className=\"landing_faq-answer\">\r\n                        <p>\r\n                          6 months, if you choose to learn physically (3 months\r\n                          immersive training and 3 months internship). And 2\r\n                          months, if you choose to learn virtually.\r\n                        </p>\r\n                      </div>\r\n                    </Card.Body>\r\n                  </Accordion.Collapse>\r\n                </Card>\r\n                <hr />\r\n                <Card>\r\n                  <Accordion.Toggle as={Card.Header} eventKey=\"8\">\r\n                    <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                      <h4>\r\n                        Will the certificate be recognized locally and globally?\r\n                      </h4>\r\n                      <MdKeyboardArrowDown size=\"2rem\" color=\"black\" />\r\n                    </div>\r\n                  </Accordion.Toggle>\r\n                  <Accordion.Collapse eventKey=\"8\">\r\n                    <Card.Body>\r\n                      <div className=\"landing_faq-answer\">\r\n                        <p>\r\n                          Yes. Grazac is a corporate organization incorporated\r\n                          under the COMPANIES AND ALLIED MATTERS act 1990 and\r\n                          the company is limited by shares with RC 1643778.\r\n                        </p>\r\n                      </div>\r\n                    </Card.Body>\r\n                  </Accordion.Collapse>\r\n                </Card>\r\n                <hr />\r\n                <Card>\r\n                  <Accordion.Toggle as={Card.Header} eventKey=\"3\">\r\n                    <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                      <h4>\r\n                        What is the actual cost of learning at Grazac Academy\r\n                      </h4>\r\n                      <MdKeyboardArrowDown size=\"2rem\" color=\"black\" />\r\n                    </div>\r\n                  </Accordion.Toggle>\r\n                  <Accordion.Collapse eventKey=\"3\">\r\n                    <Card.Body>\r\n                      <div className=\"landing_faq-answer\">\r\n                        <p style={{ fontSize: \"16px\" }}>\r\n                          If you decide to learn onsite, we have three payment\r\n                          options that you can choose from.\r\n                        </p>\r\n                        <p>\r\n                          <strong>Pay at once:</strong> You can pay your tuition\r\n                          fee all at once with this plan. If you choose this,\r\n                          you are expected to pay N500,000.\r\n                        </p>\r\n                        <p>\r\n                          <strong>Pay in installments:</strong> We also have a\r\n                          plan that allows you to pay in installments. If you\r\n                          choose this, you are expected to pay N100,000\r\n                          immediately and spread the rest over 5 months of your\r\n                          training. This comes with a 10% interest on the\r\n                          tuition fee.\r\n                        </p>\r\n                        <p>\r\n                          <strong>\r\n                            Learn now. Pay later (‘pay as you earn’):\r\n                          </strong>{\" \"}\r\n                          You can also decide to learn now and start paying back\r\n                          when you get a job after your training. If you choose\r\n                          this, you would be required to pay a non-refundable\r\n                          legal fee of N50,000 immediately. After your training,\r\n                          you are expected to pay back the sum of 1500 dollars\r\n                          (which would be equivalent to the black dollar rate at\r\n                          the time that you start paying back) 18 months after\r\n                          securing a job, following our repayment procedure.\r\n                        </p>\r\n                        <p style={{ fontSize: \"16px\" }}>\r\n                          However, If you decide to learn online, you would be\r\n                          required to pay a fixed price of N90,000, once.\r\n                        </p>\r\n                      </div>\r\n                    </Card.Body>\r\n                  </Accordion.Collapse>\r\n                </Card>\r\n                <hr />\r\n                <Card>\r\n                  <Accordion.Toggle as={Card.Header} eventKey=\"8\">\r\n                    <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                      <h4>\r\n                        Will I be given the certificate upon graduation or upon\r\n                        successful completion of tuition?\r\n                      </h4>\r\n                      <MdKeyboardArrowDown size=\"2rem\" color=\"black\" />\r\n                    </div>\r\n                  </Accordion.Toggle>\r\n                  <Accordion.Collapse eventKey=\"8\">\r\n                    <Card.Body>\r\n                      <div className=\"landing_faq-answer\">\r\n                        <p>\r\n                          Certificates will be given to students upon successful\r\n                          graduation.\r\n                        </p>\r\n                      </div>\r\n                    </Card.Body>\r\n                  </Accordion.Collapse>\r\n                </Card>\r\n                <hr />\r\n                <Card>\r\n                  <Accordion.Toggle as={Card.Header} eventKey=\"9\">\r\n                    <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                      <h4>\r\n                        Will the certificate be recognized locally and globally?\r\n                      </h4>\r\n                      <MdKeyboardArrowDown size=\"2rem\" color=\"black\" />\r\n                    </div>\r\n                  </Accordion.Toggle>\r\n                  <Accordion.Collapse eventKey=\"9\">\r\n                    <Card.Body>\r\n                      <div className=\"landing_faq-answer\">\r\n                        <p>\r\n                          Yes. Grazac is a corporate organization incorporated\r\n                          under the COMPANIES AND ALLIED MATTERS act 1990 and\r\n                          the company is limited by shares with RC 1643778.\r\n                        </p>\r\n                      </div>\r\n                    </Card.Body>\r\n                  </Accordion.Collapse>\r\n                </Card>\r\n                <hr />\r\n                <Card>\r\n                  <Accordion.Toggle as={Card.Header} eventKey=\"13\">\r\n                    <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                      <h4>What are the available courses ?</h4>\r\n                      <MdKeyboardArrowDown size=\"2rem\" color=\"black\" />\r\n                    </div>\r\n                  </Accordion.Toggle>\r\n                  <Accordion.Collapse eventKey=\"13\">\r\n                    <Card.Body>\r\n                      <div className=\"landing_faq-answer\">\r\n                        <p>Product Design</p>\r\n                        <p>Product Management</p>\r\n                        <p>\r\n                          Front-end Web Development (HTML, CSS, Javascript\r\n                          [ReactJS] )\r\n                        </p>\r\n                        <p>Back-end Web Development with NodeJS</p>\r\n                        <p>\r\n                          Mobile Application Development (Android and Flutter){\" \"}\r\n                        </p>\r\n                      </div>\r\n                    </Card.Body>\r\n                  </Accordion.Collapse>\r\n                </Card>\r\n                {/* new card */}\r\n                <hr />\r\n                <Card>\r\n                  <Accordion.Toggle as={Card.Header} eventKey=\"14\">\r\n                    <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                      <h4>Do I qualify to enroll as an Undergraduate?</h4>\r\n                      <MdKeyboardArrowDown size=\"2rem\" color=\"black\" />\r\n                    </div>\r\n                  </Accordion.Toggle>\r\n                  <Accordion.Collapse eventKey=\"14\">\r\n                    <Card.Body>\r\n                      <div className=\"landing_faq-answer\">\r\n                        <p>\r\n                          Yes. You can enroll as an undergraduate. However, if\r\n                          you are an undergraduate, you are strongly advised to\r\n                          choose to learn virtually. In fact, our virtual\r\n                          classes are specifically tailored for you.\r\n                        </p>\r\n                      </div>\r\n                    </Card.Body>\r\n                  </Accordion.Collapse>\r\n                </Card>\r\n                {/* new card */}\r\n                <hr />\r\n                <Card>\r\n                  <Accordion.Toggle as={Card.Header} eventKey=\"15\">\r\n                    <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                      <h4>Would the academy get me a job?</h4>\r\n                      <MdKeyboardArrowDown size=\"2rem\" color=\"black\" />\r\n                    </div>\r\n                  </Accordion.Toggle>\r\n                  <Accordion.Collapse eventKey=\"15\">\r\n                    <Card.Body>\r\n                      <div className=\"landing_faq-answer\">\r\n                        <p>\r\n                          We match students with job opportunities in our hiring\r\n                          network within 9-12 months of learning to enter the\r\n                          recruitment process in securing their dream job. In\r\n                          essence, we equip all our students with the level of\r\n                          competency employers are looking for so they can\r\n                          secure the job they really desire. However, the\r\n                          cohort's best student (s) would be connected to a\r\n                          job/paid internship\r\n                          (remote/fulltime/hybrid/international/local).\r\n                        </p>\r\n                      </div>\r\n                    </Card.Body>\r\n                  </Accordion.Collapse>\r\n                </Card>\r\n                <hr />\r\n                {/* new card */}\r\n                <Card>\r\n                  <Accordion.Toggle as={Card.Header} eventKey=\"16\">\r\n                    <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                      <h4>\r\n                        Do I need to have any previous experience or knowledge\r\n                        before coming to learn?\r\n                      </h4>\r\n                      <MdKeyboardArrowDown size=\"2rem\" color=\"black\" />\r\n                    </div>\r\n                  </Accordion.Toggle>\r\n                  <Accordion.Collapse eventKey=\"16\">\r\n                    <Card.Body>\r\n                      <div className=\"landing_faq-answer\">\r\n                        <p>\r\n                          Not at all. All our courses are designed to help\r\n                          people from any educational background and experience\r\n                          level achieve a successful career in IT.\r\n                        </p>\r\n                      </div>\r\n                    </Card.Body>\r\n                  </Accordion.Collapse>\r\n                </Card>\r\n                <hr />\r\n                <Card>\r\n                  <Accordion.Toggle as={Card.Header} eventKey=\"17\">\r\n                    <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                      <h4>Can I take two courses at a time?</h4>\r\n                      <MdKeyboardArrowDown size=\"2rem\" color=\"black\" />\r\n                    </div>\r\n                  </Accordion.Toggle>\r\n                  <Accordion.Collapse eventKey=\"17\">\r\n                    <Card.Body>\r\n                      <div className=\"landing_faq-answer\">\r\n                        <p>\r\n                          No, you cannot. This is because we want you to be\r\n                          focused and dedicated to a particular course and give\r\n                          it your best.{\" \"}\r\n                        </p>\r\n                      </div>\r\n                    </Card.Body>\r\n                  </Accordion.Collapse>\r\n                </Card>\r\n                <hr />\r\n                <Card>\r\n                  <Accordion.Toggle as={Card.Header} eventKey=\"18\">\r\n                    <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                      <h4>What course is right for me?</h4>\r\n                      <MdKeyboardArrowDown size=\"2rem\" color=\"black\" />\r\n                    </div>\r\n                  </Accordion.Toggle>\r\n                  <Accordion.Collapse eventKey=\"18\">\r\n                    <Card.Body>\r\n                      <div className=\"landing_faq-answer\">\r\n                        <p>\r\n                          You can call us (or send us a Whatsapp message) on\r\n                          +234 806 836 5951\r\n                        </p>\r\n                      </div>\r\n                    </Card.Body>\r\n                  </Accordion.Collapse>\r\n                </Card>\r\n                <hr />\r\n                <Card>\r\n                  <Accordion.Toggle as={Card.Header} eventKey=\"19\">\r\n                    <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                      <h4>\r\n                        What are the added benefits of learning at Grazac\r\n                        Academy?\r\n                      </h4>\r\n                      <MdKeyboardArrowDown size=\"2rem\" color=\"black\" />\r\n                    </div>\r\n                  </Accordion.Toggle>\r\n                  <Accordion.Collapse eventKey=\"19\">\r\n                    <Card.Body>\r\n                      <div className=\"landing_faq-answer\">\r\n                        <p>\r\n                          Asides from equipping you with the level of competency\r\n                          employers are looking for so you can secure the job\r\n                          you really desire, we also provide placement for\r\n                          support services such as interview coaching, CV/\r\n                          LinkedIn profile reviews, Salary negotiation sessions,\r\n                          provision of reference letters, etc. You would also\r\n                          have access to be mentored by professionals in the\r\n                          industry, and access to a community of like minds that\r\n                          would foster your learning, commitment, and practice.\r\n                        </p>\r\n                      </div>\r\n                    </Card.Body>\r\n                  </Accordion.Collapse>\r\n                </Card>\r\n              </Accordion>\r\n              <hr />\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <div className=\"gua_advice\">\r\n        <div className=\"container\">\r\n          <div className=\"gua_advice-box\">\r\n            <div className=\"boxes55\">\r\n              <img\r\n                src={lady}\r\n                alt=\"undergraduate\"\r\n                className=\"gua_advice-box-img\"\r\n              />\r\n            </div>\r\n            <div className=\"boxes55\">\r\n              <div className=\"gua_advice-box-text\">\r\n                <h2>Still Have A Question?</h2>\r\n                <p>\r\n                  Do you need further clarification? Call{\" \"}\r\n                  <span>08068365951</span> or click on the button below to chat\r\n                  with us.\r\n                </p>\r\n                <a href=\"tel:+2348068365951\">\r\n                  <button>Call us now</button>\r\n                </a>\r\n                <a href=\"https://wa.link/w8e0xs\">\r\n                  <button className=\"second-button\">Chat with us</button>\r\n                </a>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <Footer />\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default Faq;\r\n","C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\pages\\graduateCohort\\dashboard\\Main.js",["415","416","417","418","419","420","421","422","423","424","425","426","427","428","429","430","431","432"],"import { useState, useEffect, useRef } from \"react\";\r\nimport Sidebar from \"../../../components/dashboard/Sidebar\";\r\nimport Details from \"../../../components/dashboard/Details\";\r\nimport NotSubmitted from \"../../../components/dashboard/not-submitted\";\r\nimport UnderReview from \"../../../components/dashboard/UnderReview\";\r\nimport PaymentReceived from \"../../../components/dashboard/selected/PaymentReceived\";\r\nimport Selected from \"../../../components/dashboard/Selected\";\r\nimport Rejected from \"../../../components/dashboard/Rejected\";\r\nimport OutsideClickHandler from \"react-outside-click-handler\";\r\nimport axios from \"axios\";\r\nimport { ToastContainer, toast } from \"react-toastify\";\r\nimport {\r\n  submitGuarantor,\r\n  sendFlutterTx,\r\n  addPlan,\r\n  getGuarantor,\r\n} from \"../../../api/dashboard/data\";\r\nimport {\r\n  useFlutterwave,\r\n  FlutterWaveButton,\r\n  closePaymentModal,\r\n} from \"flutterwave-react-v3\";\r\nimport arrow from \"../../../images/svg/dashboard/arrow.svg\";\r\nimport menu from \"../../../images/svg/dashboard/menu.svg\";\r\nimport cancel from \"../../../images/svg/dashboard/cancel.svg\";\r\nimport loader from \"../../../images/svg/dashboard/loader.gif\";\r\n\r\nimport termsandconds from \"../../../content/TermsandCondition.pdf\";\r\nimport Loader from \"../../../components/Loader\";\r\nimport AdmissionFeePage from \"../../../components/dashboard/not-submitted/AdmissionFeePage\";\r\n// import { usePayercoins } from \"payercoins-react\";\r\n\r\nfunction Dashboard() {\r\n  const buttonRef = useRef();\r\n  const [accepted, setAccepted] = useState(false);\r\n\r\n  // const [status, setStatus] = useState(\"Not Submitted\");\r\n  const [status, setStatus] = useState(\"Not Applied Yet\");\r\n  const [loading, setLoading] = useState(false);\r\n  const [isError, setIsError] = useState(null);\r\n  // const [status, setStatus] = useState(\"Admitted\");\r\n  const [selectStatus, setSelectStatus] = useState(\"congrats\");\r\n  const [payShowModal, setPayShowModal] = useState(\"\");\r\n  const [sidebarClick, setSidebarClick] = useState(\"dashboard\");\r\n  const [details, setDetails] = useState({});\r\n  const [payOpt, setPayOpt] = useState(\"\");\r\n  const [amount, setAmount] = useState(0);\r\n  const [currency, setCurrency] = useState(\"\");\r\n  const [userId, setUserId] = useState(0);\r\n  const [guarantorForm1, setGuarantorForm1] = useState(true);\r\n  const [showProfessionalInput1, setShowProfessionalInput1] = useState(false);\r\n  const [showGuarantorRelationshipInput1, setShowGuarantorRelationshipInput1] =\r\n    useState(false);\r\n\r\n  const [guarantorStatus, setGuarantorStatus] = useState(false);\r\n  // const [guarantorDetails_2,setGuarantorDetails_2]=useState([])\r\n  const [guarantor, setGuarantor] = useState({\r\n    firstName: \"\",\r\n    lastName: \"\",\r\n    email: \"\",\r\n    phone: \"\",\r\n    gender: \"\",\r\n    officeAddress: \"\",\r\n    homeAddress: \"\",\r\n    profession: \"\",\r\n    organisation: \"\",\r\n    employer: \"\",\r\n    employerMail: \"\",\r\n    employerPhone: \"\",\r\n    relationship: \"\",\r\n  });\r\n\r\n  const item = 1;\r\n\r\n  const usdValue = \"10\";\r\n  const ngnValue = \"720000\";\r\n\r\n  useEffect(() => {\r\n    // setSelectStatus(\"paid\");\r\n    // setSelectStatus(\"paid\")\r\n    try {\r\n      let details = sessionStorage.getItem(\"user_details\");\r\n\r\n      setDetails(JSON.parse(details));\r\n\r\n      setUserId(JSON.parse(details).id);\r\n      setAccepted(JSON.parse(details).applicationFee);\r\n\r\n      console.log(JSON.parse(details).applicationFee);\r\n\r\n      if (JSON.parse(details).applicationFee) {\r\n        // console.log(\"fkjdkj\");\r\n        setStatus(\"Not Submitted\");\r\n        setStatus(sessionStorage.getItem(\"status\"));\r\n\r\n        if (JSON.parse(details).isPaid === 1) {\r\n          setSelectStatus(\"paid\");\r\n        }\r\n\r\n        if (!details) {\r\n          window.location = \"/login\";\r\n        }\r\n      }\r\n    } catch (err) {\r\n      window.location = \"/login\";\r\n    }\r\n\r\n    setLoading(true);\r\n\r\n    getGuarantor()\r\n      .then((response) => response.data)\r\n      .then((res) => {\r\n        setLoading(false);\r\n\r\n        if (res.data.length > 1 || res.data.length === 1) {\r\n          setGuarantorForm1(false);\r\n        }\r\n        // work on this part for the payment page\r\n        if (res.data.length > 2 || res.data.length == 2) {\r\n          setGuarantorForm1(false);\r\n          setGuarantorStatus(true);\r\n        }\r\n      })\r\n      .catch((err) => {\r\n        setLoading(false);\r\n        if (err.response) {\r\n          toast.error(err.response);\r\n        } else {\r\n          toast.error(\r\n            \"Something went wrong!!! Please make sure you have a good internet connection.\"\r\n          );\r\n        }\r\n      });\r\n  }, [guarantorForm1]);\r\n\r\n  const handleChange = (e) => {\r\n    setGuarantor({\r\n      ...guarantor,\r\n      [e.target.name]: e.target.value,\r\n    });\r\n  };\r\n\r\n  const showNavMobile = () => {\r\n    document.getElementById(\"sidebar\").style.left = \"0px\";\r\n  };\r\n  const closeNavMobile = () => {\r\n    if (window.innerWidth < 769) {\r\n      document.getElementById(\"sidebar\").style.left = \"-210px\";\r\n    }\r\n  };\r\n\r\n  const flutterWavePayment = () => {\r\n    // const url =\r\n    //   \"https://admin-api.grazacacademy.com/api/v1/admin/download?status=Under Review\";\r\n\r\n    //   axios({\r\n    //     url: url, //your url\r\n    //     method: 'GET',\r\n    //     responseType: 'blob', // important\r\n    // }).then((response) => {\r\n    //     const url = window.URL.createObjectURL(new Blob([response.data]));\r\n    //     const link = document.createElement('a');\r\n    //     link.href = url;\r\n    //     link.setAttribute('download', 'file.csv'); //or any other extension\r\n    //     document.body.appendChild(link);\r\n    //     link.click();\r\n    // });\r\n\r\n    handleFlutterPayment({\r\n      callback: (response) => {\r\n        if (response.status === \"successful\") {\r\n          toast.success(\"Payment successful! Verifying payment...\");\r\n          // window.location = \"/dashboard\";\r\n          console.log(response);\r\n          console.log(response);\r\n          console.log(response);\r\n\r\n          sendFlutterTx(response.transaction_id)\r\n            .then((response) => response.data)\r\n            .then((res) => {\r\n              if (res.data.status === \"successful\") {\r\n                setSelectStatus(\"paid\");\r\n                // window.location = \"/dashboard\";\r\n              } else {\r\n              }\r\n            })\r\n            .catch((err) => {});\r\n        } else {\r\n          toast.error(\"Payment unsuccessful!\");\r\n        }\r\n        closePaymentModal(); // this will close the modal programmatically\r\n      },\r\n      onClose: (response) => {},\r\n    });\r\n  };\r\n\r\n  const makePayment = () => {\r\n    if (payOpt === \"part\") {\r\n      setPayShowModal(\"\");\r\n      setSelectStatus(\"pay-as-you-earn\");\r\n    } else if (payOpt === \"full\") {\r\n      setPayShowModal(\"\");\r\n\r\n      var planData = new FormData();\r\n      planData.append(\"payment_plan\", \"pay at once\");\r\n      addPlan(planData)\r\n        .then((response) => response.data)\r\n        .then((res) => {})\r\n        .catch((err) => {});\r\n\r\n      flutterWavePayment();\r\n    } else {\r\n      toast.info(\"You need to select a payment option to continue!\");\r\n    }\r\n  };\r\n\r\n  const showForm = () => {\r\n    if (document.getElementById(\"mark\").checked) {\r\n      setSelectStatus(\"form\");\r\n    } else {\r\n      toast.info(\"You need to accept our terms and conditions to continue\");\r\n    }\r\n  };\r\n\r\n  const SubmitGuarantorForm_1 = (e) => {\r\n    e.preventDefault();\r\n    var btn = document.getElementById(\"actionBtn\");\r\n    btn.innerHTML = `<img src=${loader} width=\"20px\" />`;\r\n\r\n    getGuarantor()\r\n      .then((response) => response.data)\r\n      .then((res) => {\r\n        setLoading(false);\r\n\r\n        if (!(res.data.length == 1 || res.data.length > 1)) {\r\n          // setGuarantorForm1(false);\r\n\r\n          e.preventDefault();\r\n          var data = new FormData();\r\n\r\n          var btn = document.getElementById(\"actionBtn\");\r\n          btn.innerHTML = `<img src=${loader} width=\"20px\" />`;\r\n          btn.disabled = false;\r\n\r\n          if (!(guarantor.phone.length > 10)) {\r\n            btn.innerHTML = `<img src=${loader} width=\"20px\" />`;\r\n\r\n            toast.error(\"please enter a correct phone number\");\r\n            setIsError(true);\r\n            btn.innerHTML = `Proceed`;\r\n            // btn.disabled = true\r\n          }\r\n\r\n          if (!(guarantor.employerPhone.length > 10)) {\r\n            btn.innerHTML = `<img src=${loader} width=\"20px\" />`;\r\n\r\n            toast.error(\"please enter a correct employer's phone number\");\r\n            setIsError(true);\r\n            btn.innerHTML = `Proceed`;\r\n            // btn.disabled = true\r\n          }\r\n\r\n          if (\r\n            guarantor.phone.length > 10 ||\r\n            guarantor.employerPhone.length > 10\r\n          ) {\r\n            // btn.disabled = false\r\n          }\r\n\r\n          if (\r\n            guarantor.phone.length > 10 &&\r\n            guarantor.employerPhone.length > 10\r\n          ) {\r\n            setIsError(false);\r\n            // btn.disabled = false\r\n\r\n            // btn.innerHTML = `<img src=${loader} width=\"20px\" />`;\r\n            data.append(\"firstname\", guarantor.firstName);\r\n            data.append(\"lastname\", guarantor.lastName);\r\n            data.append(\"email\", guarantor.email);\r\n            data.append(\"phone_number\", guarantor.phone);\r\n            data.append(\"gender\", guarantor.gender);\r\n            data.append(\"office_address\", guarantor.officeAddress);\r\n            data.append(\"home_address\", guarantor.homeAddress);\r\n            data.append(\"profession\", guarantor.profession);\r\n            data.append(\"name_of_organization\", guarantor.organisation);\r\n            data.append(\"name_of_employer\", guarantor.employer);\r\n            data.append(\"email_address_of_employer\", guarantor.employerMail);\r\n            data.append(\"phone_number_of_employer\", guarantor.employerPhone);\r\n            data.append(\r\n              \"relationship_with_the_guarantor\",\r\n              guarantor.relationship\r\n            );\r\n            data.append(\"user_id\", userId);\r\n\r\n            submitGuarantor(data)\r\n              .then((response) => response.data)\r\n              .then((res) => {\r\n                if (res.status === 200) {\r\n                  // window.location = \"/dashboard\";\r\n                  window.scrollTo(0, 0);\r\n                  // document.getElementById(\"guarantorForm2\").reset()\r\n                  setGuarantorForm1(false);\r\n                  btn.disabled = true;\r\n                  toast.success(\"Submission successful\");\r\n                  btn.innerHTML = `<img src=${loader} width=\"20px\" />`;\r\n                  btn.disabled = true;\r\n                  // flutterWavePayment();\r\n                } else {\r\n                  toast.error(\"Submission not successful, try again!!!\");\r\n                  // btn.innerHTML = `<img src=${loader} width=\"20px\" />`;\r\n                  btn.innerHTML = `Procede`;\r\n                }\r\n              })\r\n              .catch((err) => {\r\n                if (err.response) {\r\n                  toast.error(err.response);\r\n                  btn.innerHTML = `Procede`;\r\n                }\r\n                // else {\r\n                //   toast.error(\r\n                //     \"Something went wrong!!! Please make sure you have a good internet connection.\"\r\n                //   );\r\n                //   btn.innerHTML = `Procede`;\r\n                // }\r\n              });\r\n          }\r\n        }\r\n      });\r\n  };\r\n\r\n  const SubmitGuarantorForm_2 = (e) => {\r\n    e.preventDefault();\r\n    var data = new FormData();\r\n\r\n    var btn = document.getElementById(\"actionBtn\");\r\n    btn.innerHTML = `<img src=${loader} width=\"20px\" />`;\r\n    // btn.disabled = true\r\n\r\n    if (!(guarantor.phone.length > 10)) {\r\n      btn.innerHTML = `<img src=${loader} width=\"20px\" />`;\r\n\r\n      toast.error(\"please enter a correct phone number\");\r\n      setIsError(true);\r\n      btn.innerHTML = `Proceed`;\r\n      // btn.disabled = true\r\n    }\r\n\r\n    if (!(guarantor.employerPhone.length > 10)) {\r\n      btn.innerHTML = `<img src=${loader} width=\"20px\" />`;\r\n\r\n      toast.error(\"please enter a correct employer's phone number\");\r\n      setIsError(true);\r\n      btn.innerHTML = `Proceed`;\r\n      // btn.disabled = false\r\n    }\r\n\r\n    if (guarantor.phone.length > 10 && guarantor.employerPhone.length > 10) {\r\n      setIsError(false);\r\n\r\n      // btn.innerHTML = `<img src=${loader} width=\"20px\" />`;\r\n      data.append(\"firstname\", guarantor.firstName);\r\n      data.append(\"lastname\", guarantor.lastName);\r\n      data.append(\"email\", guarantor.email);\r\n      data.append(\"phone_number\", guarantor.phone);\r\n      data.append(\"gender\", guarantor.gender);\r\n      data.append(\"office_address\", guarantor.officeAddress);\r\n      data.append(\"home_address\", guarantor.homeAddress);\r\n      data.append(\"profession\", guarantor.profession);\r\n      data.append(\"name_of_organization\", guarantor.organisation);\r\n      data.append(\"name_of_employer\", guarantor.employer);\r\n      data.append(\"email_address_of_employer\", guarantor.employerMail);\r\n      data.append(\"phone_number_of_employer\", guarantor.employerPhone);\r\n      data.append(\"relationship_with_the_guarantor\", guarantor.relationship);\r\n      data.append(\"user_id\", userId);\r\n\r\n      submitGuarantor(data)\r\n        .then((response) => response.data)\r\n        .then((res) => {\r\n          if (res.status === 200) {\r\n            btn.disabled = true;\r\n            window.location = \"/dashboard\";\r\n            // toast.success(\"Submission successful\");\r\n            btn.innerHTML = `Submit & Pay`;\r\n\r\n            // flutterWavePayment();\r\n          } else {\r\n            toast.error(\"Submission not successful, try again!!!\");\r\n            btn.innerHTML = `Submit & Pay`;\r\n          }\r\n        })\r\n        .catch((err) => {\r\n          if (err.response) {\r\n            toast.error(err.response);\r\n            btn.innerHTML = `Submit & Pay`;\r\n          }\r\n\r\n          // else {\r\n          //   toast.error(\r\n          //     \"Something went wrong!!! Please make sure you have a good internet connection.\"\r\n          //   );\r\n          //   btn.innerHTML = `Submit & Pay`;\r\n          // }\r\n        });\r\n\r\n      var planData = new FormData();\r\n      planData.append(\"payment_plan\", \"pay as you earn\");\r\n      addPlan(planData)\r\n        .then((response) => response.data)\r\n        .then((res) => {})\r\n        .catch((err) => {});\r\n    } else {\r\n      btn.innerHTML = `Proceed`;\r\n    }\r\n  };\r\n\r\n  const submitForm = (e, whichForm) => {\r\n    e.preventDefault();\r\n    var btn = document.getElementById(\"actionBtn\");\r\n    btn.innerHTML = `<img src=${loader} width=\"20px\" />`;\r\n\r\n    var data = new FormData();\r\n\r\n    if (!(guarantor.phone.length > 10)) {\r\n      btn.innerHTML = `<img src=${loader} width=\"20px\" />`;\r\n\r\n      toast.error(\"please enter a correct phone number\");\r\n      setIsError(true);\r\n      btn.innerHTML = `Proceed`;\r\n    }\r\n\r\n    if (!(guarantor.employerPhone.length > 10)) {\r\n      btn.innerHTML = `<img src=${loader} width=\"20px\" />`;\r\n\r\n      toast.error(\"please enter a correct employer's phone number\");\r\n      setIsError(true);\r\n      btn.innerHTML = `Proceed`;\r\n    }\r\n\r\n    if (guarantor.phone.length > 10 && guarantor.employerPhone.length > 10) {\r\n      setIsError(false);\r\n    }\r\n\r\n    if (isError === false) {\r\n      btn.innerHTML = `<img src=${loader} width=\"20px\" />`;\r\n      data.append(\"firstname\", guarantor.firstName);\r\n      data.append(\"lastname\", guarantor.lastName);\r\n      data.append(\"email\", guarantor.email);\r\n      data.append(\"phone_number\", guarantor.phone);\r\n      data.append(\"gender\", guarantor.gender);\r\n      data.append(\"office_address\", guarantor.officeAddress);\r\n      data.append(\"home_address\", guarantor.homeAddress);\r\n      data.append(\"profession\", guarantor.profession);\r\n      data.append(\"name_of_organization\", guarantor.organisation);\r\n      data.append(\"name_of_employer\", guarantor.employer);\r\n      data.append(\"email_address_of_employer\", guarantor.employerMail);\r\n      data.append(\"phone_number_of_employer\", guarantor.employerPhone);\r\n      data.append(\"relationship_with_the_guarantor\", guarantor.relationship);\r\n      data.append(\"user_id\", userId);\r\n\r\n      if (whichForm === \"guarantor1\" && isError === false) {\r\n        var btn = document.getElementById(\"actionBtn\");\r\n\r\n        btn.innerHTML = `<img src=${loader} width=\"20px\" />`;\r\n\r\n        submitGuarantor(data)\r\n          .then((response) => response.data)\r\n          .then((res) => {\r\n            if (res.status === 200) {\r\n              toast.success(\"Submission successful\");\r\n              btn.innerHTML = `Proceed`;\r\n              setGuarantorForm1(false);\r\n\r\n              window.scrollTo(0, 0);\r\n              document.getElementById(\"guarantorForm2\").reset();\r\n            } else {\r\n              toast.error(\"Submission not successful, try again!!!\");\r\n              btn.innerHTML = `Proceed`;\r\n            }\r\n          })\r\n          .catch((err) => {\r\n            if (err.response) {\r\n              toast.error(err.response);\r\n              btn.innerHTML = `Proceed`;\r\n            } else {\r\n              toast.error(\r\n                \"Something went wrong!!! Please make sure you have a good internet connection.\"\r\n              );\r\n              btn.innerHTML = `Proceed`;\r\n            }\r\n          });\r\n      } else {\r\n        btn.innerHTML = `Proceed`;\r\n      }\r\n\r\n      if (whichForm === \"guarantor2\" && isError === false) {\r\n        var btn = document.getElementById(\"actionBtn\");\r\n        btn.innerHTML = `<img src=${loader} width=\"20px\" />`;\r\n\r\n        submitGuarantor(data)\r\n          .then((response) => response.data)\r\n          .then((res) => {\r\n            if (res.status === 200) {\r\n              window.location = \"/dashboard\";\r\n              // toast.success(\"Submission successful\");\r\n              btn.innerHTML = `Submit & Pay`;\r\n              // flutterWavePayment();\r\n            } else {\r\n              toast.error(\"Submission not successful, try again!!!\");\r\n              btn.innerHTML = `Submit & Pay`;\r\n            }\r\n          })\r\n          .catch((err) => {\r\n            if (err.response) {\r\n              toast.error(err.response);\r\n              btn.innerHTML = `Submit & Pay`;\r\n            } else {\r\n              toast.error(\r\n                \"Something went wrong!!! Please make sure you have a good internet connection.\"\r\n              );\r\n              btn.innerHTML = `Submit & Pay`;\r\n            }\r\n          });\r\n\r\n        var planData = new FormData();\r\n        planData.append(\"payment_plan\", \"pay as you earn\");\r\n        addPlan(planData)\r\n          .then((response) => response.data)\r\n          .then((res) => {})\r\n          .catch((err) => {});\r\n      } else {\r\n        btn.innerHTML = `Proceed`;\r\n      }\r\n    }\r\n  };\r\n\r\n  // FLWPUBK_TEST-b6c44d3213f2d2b3c0c3142f3ab81b72-X\r\n  // public_key: \"FLWPUBK-006bdc82ad878f1518af32f44af6478f-X\",\r\n  const config = {\r\n    public_key: \"FLWPUBK-006bdc82ad878f1518af32f44af6478f-X\",\r\n    tx_ref: Date.now(),\r\n    amount: amount,\r\n    currency: currency,\r\n    payment_options: \"card,mobilemoney,ussd\",\r\n    customer: {\r\n      email: `${details.email}`,\r\n      phonenumber: `${details.phone}`,\r\n      name: `${details.firstName} ${details.lastName}`,\r\n    },\r\n\r\n    customizations: {\r\n      title: \"Grazac Academy\",\r\n      description: \"Payment for Graduate Cohort\",\r\n      logo: \"https://grazac.com.ng/assets/images/favicon.png\",\r\n    },\r\n  };\r\n\r\n  const handleFlutterPayment = useFlutterwave(config);\r\n\r\n  const changeStatus = (par1) => {\r\n    setStatus(`${par1}`);\r\n    sessionStorage.setItem(\"status\", `${par1}`);\r\n  };\r\n\r\n  //payercoins LIVE public key PYC-PUB_339d368f5254b0149ad6c7\r\n  //payercoins TEST public key PYC-PUB_a04caeeba00b80ae762bbe_TEST\r\n  const payercoinsConfig = {\r\n    key: \"PYC-PUB_a04caeeba00b80ae762bbe_TEST\",\r\n    customer_name: \"Grazac Academy\",\r\n    customer_email: \"mitchelinajuo@gmail.com\",\r\n    amount: parseFloat(usdValue), // amount as a number or string\r\n    currency: \"ethereum\", // [ethereum, bitcoin, usdt-eth].  optional, if not provided will use your default currencies activated in your account\r\n    // description: \"Test Payment\", // optional\r\n    redirect_url: \"\", // optional - will default to current page\r\n    invoice_id: \"239313200190.40646\", // optional - unique identifier for your payment and minLength 8, else we will automatically generate one\r\n    // callback_url: 'https://sandbox-api.payercoins.com/api/v1/withdrawal' //This is just a test sandbox\r\n    callback_url: \"https://webhook.site/c573fd7d-2e6f-478d-b16d-b97e15c533c1\", //This is just a test sandbox\r\n  };\r\n  // const [initializePayment] = usePayercoins();\r\n  // const handlePayercoinsPayment = async () => {\r\n  //   initializePayment(payercoinsConfig);\r\n  // };\r\n\r\n  return (\r\n    <>\r\n      {loading === false ? (\r\n        <div>\r\n          <ToastContainer closeButton={false} />\r\n          <OutsideClickHandler\r\n            onOutsideClick={() => {\r\n              closeNavMobile();\r\n            }}\r\n          >\r\n            <div className=\"layout_dashboard-sidebar\" id=\"sidebar\">\r\n              <Sidebar\r\n                clicked={sidebarClick}\r\n                showDetails={status}\r\n                clickedDashboard={setSidebarClick}\r\n                clickedDetails={setSidebarClick}\r\n              />\r\n            </div>\r\n          </OutsideClickHandler>\r\n          <div className=\"layout_dashboard-content\">\r\n            <div className=\"dashboard-nav\">\r\n              <img\r\n                src={menu}\r\n                alt=\"menu\"\r\n                className=\"dashboard-nav-menu\"\r\n                onClick={showNavMobile}\r\n              />\r\n              <div className=\"dashboard-nav-status\">\r\n                <h3>Status: {status}</h3>\r\n                <div\r\n                  className={\r\n                    status === \"Not Submitted\"\r\n                      ? `dashboard-nav-status-dot not-submitted`\r\n                      : status === \"Under Review\"\r\n                      ? `dashboard-nav-status-dot under-review`\r\n                      : `dashboard-nav-status-dot ${status}`\r\n                  }\r\n                ></div>\r\n              </div>\r\n              <div className=\"dashboard-nav-user\">\r\n                <div>\r\n                  <h2>\r\n                    {details.firstName?.substring(0, 1)}\r\n                    {details?.lastName?.substring(0, 1)}\r\n                  </h2>\r\n                </div>\r\n                <p>\r\n                  {details.firstName} {details.lastName}\r\n                </p>\r\n              </div>\r\n            </div>\r\n            {sidebarClick === \"dashboard\" && (\r\n              <div className=\"dashboard-content\">\r\n                {!accepted && (\r\n                  <div>\r\n                    <AdmissionFeePage\r\n                      details={details}\r\n                      fname={details.firstName}\r\n                      lname={details.lastName}\r\n                      email={details.email}\r\n                      phone={details.phone}\r\n                    />\r\n                    {/* <p>Please Make your Admission Fee Payment</p> */}\r\n                  </div>\r\n                )}\r\n\r\n                {status === \"Not Submitted\" && (\r\n                  <NotSubmitted\r\n                    userDetails={details}\r\n                    fname={details.firstName}\r\n                    lname={details.lastName}\r\n                    email={details.email}\r\n                    phone={details.phone}\r\n                    setNewStatus={() => changeStatus(\"Under Review\")}\r\n                  />\r\n                )}\r\n                {status === \"Under Review\" && (\r\n                  <UnderReview fname={details.firstName} />\r\n                )}\r\n                {status === \"Selected\" && (\r\n                  <Selected fname={details.firstName} />\r\n                )}\r\n\r\n                {status === \"Admitted\" && (\r\n                  <div>\r\n                    {/* {guarantorStatus === false  && selectStatus !== \"paid\" ? ( */}\r\n                    {guarantorStatus === false ? (\r\n                      <div>\r\n                        {selectStatus === \"congrats\" && (\r\n                          <div>\r\n                            <h3>Hello {details.firstName}</h3>\r\n                            <p className=\"text1\">Congratulations!</p>\r\n                            <p>\r\n                              Your application has been selected. Click on the\r\n                              button below to continue you admission process.\r\n                            </p>\r\n                            <button onClick={() => setPayShowModal(\"pay\")}>\r\n                              Continue admission process\r\n                            </button>\r\n                          </div>\r\n                        )}\r\n\r\n                        {payShowModal === \"pay\" && (\r\n                          <div className=\"dashboard-content-modal\">\r\n                            <div className=\"dashboard-content-modal-backdrop\"></div>\r\n                            <div className=\"dashboard-content-modal-container\">\r\n                              <div className=\"dashboard-content-modal-main\">\r\n                                <div className=\"dashboard-content-modal-main-text\">\r\n                                  <h4>Choose Payment Option</h4>\r\n                                  <img\r\n                                    src={cancel}\r\n                                    alt=\"cancel\"\r\n                                    onClick={() => setPayShowModal(\"\")}\r\n                                  />\r\n                                </div>\r\n                                <div\r\n                                  className={\r\n                                    payOpt === \"part\"\r\n                                      ? \"active\"\r\n                                      : \"dashboard-content-modal-main-frame1\"\r\n                                  }\r\n                                  onClick={() => {\r\n                                    setPayOpt(\"part\");\r\n                                    setAmount(50000);\r\n                                    setCurrency(\"NGN\");\r\n                                  }}\r\n                                >\r\n                                  <div></div>\r\n                                  <p>Pay as you earn (NGN 50,000 legal fee)</p>\r\n                                </div>\r\n                                <div\r\n                                  className={\r\n                                    payOpt === \"full\"\r\n                                      ? \"active\"\r\n                                      : \"dashboard-content-modal-main-frame1\"\r\n                                  }\r\n                                  onClick={() => {\r\n                                    setPayOpt(\"full\");\r\n                                    setAmount(500000);\r\n                                    setCurrency(\"NGN\");\r\n                                  }}\r\n                                >\r\n                                  <div></div>\r\n                                  <p>Pay at once (NGN 500,000)</p>\r\n                                </div>\r\n                                <a\r\n                                  href=\"https://docs.google.com/forms/u/3/d/e/1FAIpQLSep9AvrWxiedsn8KWYTTiTAArLRwsHRSLnnd49GIrJ35Z4FUw/viewform?usp=pp_url&authuser=0\"\r\n                                  target=\"_blank\"\r\n                                  className={\r\n                                    payOpt === \"install\"\r\n                                      ? \"active\"\r\n                                      : \"dashboard-content-modal-main-frame1\"\r\n                                  }\r\n                                >\r\n                                  <div></div>\r\n                                  <p>\r\n                                    Pay in Installments (Starts from NGN\r\n                                    250,000)\r\n                                  </p>\r\n                                </a>\r\n                                <button onClick={makePayment}>Proceed</button>\r\n                              </div>\r\n                            </div>\r\n                          </div>\r\n                        )}\r\n\r\n                        {selectStatus === \"pay-as-you-earn\" && (\r\n                          <div>\r\n                            <div\r\n                              className=\"dashboard-content-back\"\r\n                              onClick={() => setSelectStatus(\"congrats\")}\r\n                            >\r\n                              <img src={arrow} alt=\"back\" />\r\n                              <p>Back</p>\r\n                            </div>\r\n                            <h3>Pay as you earn</h3>\r\n                            <div className=\"dashboard-content-guarantor_paragraph_text\">\r\n                              <p className=\"text1\">\r\n                                Learn with us for 6 months and pay no tuition\r\n                                till you’re hired!\r\n                              </p>\r\n                              <p>\r\n                                The Pay as You Earn is a financial instrument to\r\n                                help you participate in our training for FREE.\r\n                                You are expected to start repaying the credit\r\n                                once you get a job at the end of the program. It\r\n                                is governed by a legally binding contract. The\r\n                                repayment procedure can be found in our terms\r\n                                and conditions. This contract is bonded by the\r\n                                law firm.\r\n                              </p>\r\n                              <p>\r\n                                Note that: This policy requires you bringing two\r\n                                guarantors and making a one-time payment for\r\n                                legal fees bonded by the law firm.\r\n                              </p>\r\n                              <p>\r\n                                The legal fee cost is a total of 50,000 Naira.\r\n                                Kindly note that this amount is not refundable\r\n                                under any circumstance.\r\n                              </p>\r\n                            </div>\r\n\r\n                            <ul>\r\n                              <p>\r\n                                The following are of utmost necessity when\r\n                                bringing your guarantors;\r\n                              </p>\r\n                              <li>\r\n                                You must bring 2 guarantors who are over 18\r\n                                years of age and must have completed a higher\r\n                                institution of learning.\r\n                              </li>\r\n                              <li>\r\n                                Guarantors must have a stable source of income.\r\n                              </li>\r\n\r\n                              <li>They must be residents within Nigeria.</li>\r\n                              <li>\r\n                                If your guarantor does not meet our eligibility\r\n                                status, you'll be asked to get a replacement.\r\n                              </li>\r\n                              <li>\r\n                                Kindly seek the consent of your guarantors\r\n                                before filling their details as we will contact\r\n                                them on your behalf.\r\n                              </li>\r\n                              <li>\r\n                                You can also share our terms and conditions with\r\n                                your guarantor to keep them informed.\r\n                              </li>\r\n                            </ul>\r\n                            <div className=\"checkbox\">\r\n                              <input type=\"checkbox\" id=\"mark\" />\r\n                              {/* <p>I accept the <a href=\"#\">Terms ‌and‌ ‌Conditions‌</a></p> */}\r\n                              <p>\r\n                                I accept the{\" \"}\r\n                                <a\r\n                                  href={termsandconds}\r\n                                  download\r\n                                  target=\"_blank\"\r\n                                >\r\n                                  Terms ‌and‌ ‌Conditions‌\r\n                                </a>\r\n                              </p>\r\n                            </div>\r\n\r\n                            <button onClick={showForm}>\r\n                              Upload Guarantor Details\r\n                            </button>\r\n                          </div>\r\n                        )}\r\n\r\n                        {selectStatus === \"form\" && (\r\n                          <div>\r\n                            <div\r\n                              className=\"dashboard-content-back\"\r\n                              onClick={() => setSelectStatus(\"pay-as-you-earn\")}\r\n                            >\r\n                              <img src={arrow} alt=\"back\" />\r\n                              <p>Back</p>\r\n                            </div>\r\n                            <h4 style={{ marginLeft: \"20px\" }}>\r\n                              Guarantor Form {guarantorForm1 ? \"1\" : \"2\"}\r\n                            </h4>\r\n\r\n                            {guarantorForm1 ? (\r\n                              <div className=\"dashboard-content-form\">\r\n                                <form\r\n                                  // onSubmit={(e) => submitForm(e, \"guarantor1\")}\r\n                                  onSubmit={(e) => SubmitGuarantorForm_1(e)}\r\n                                >\r\n                                  <div className=\"dashboard-content-form-container\">\r\n                                    <label>First Name</label>\r\n                                    <input\r\n                                      type=\"text\"\r\n                                      required\r\n                                      name=\"firstName\"\r\n                                      placeholder=\"FirstName\"\r\n                                      onChange={handleChange}\r\n                                    />\r\n                                  </div>\r\n                                  <div className=\"dashboard-content-form-container\">\r\n                                    <label>Last Name</label>\r\n                                    <input\r\n                                      type=\"text\"\r\n                                      required\r\n                                      name=\"lastName\"\r\n                                      placeholder=\"LastName\"\r\n                                      onChange={handleChange}\r\n                                    />\r\n                                  </div>\r\n                                  <div className=\"dashboard-content-form-container\">\r\n                                    <label>Email Address</label>\r\n                                    <input\r\n                                      type=\"email\"\r\n                                      required\r\n                                      name=\"email\"\r\n                                      placeholder=\"Email Address\"\r\n                                      onChange={handleChange}\r\n                                    />\r\n                                  </div>\r\n                                  <div className=\"dashboard-content-form-container\">\r\n                                    <label>Phone Number</label>\r\n                                    <input\r\n                                      type=\"number\"\r\n                                      required\r\n                                      name=\"phone\"\r\n                                      placeholder=\"Phone Number\"\r\n                                      onChange={handleChange}\r\n                                    />\r\n                                  </div>\r\n                                  <div className=\"dashboard-content-form-container\">\r\n                                    <label>Gender</label>\r\n                                    <select\r\n                                      name=\"gender\"\r\n                                      required\r\n                                      onChange={handleChange}\r\n                                    >\r\n                                      <option value=\"\">Select Gender</option>\r\n                                      <option value=\"Male\">Male</option>\r\n                                      <option value=\"Female\">Female</option>\r\n                                    </select>\r\n                                  </div>\r\n\r\n                                  <div className=\"dashboard-content-form-container\">\r\n                                    <label>Office Address</label>\r\n                                    <input\r\n                                      type=\"text\"\r\n                                      required\r\n                                      name=\"officeAddress\"\r\n                                      placeholder=\"Office Address\"\r\n                                      onChange={handleChange}\r\n                                    />\r\n                                  </div>\r\n                                  <div className=\"dashboard-content-form-container\">\r\n                                    <label>Home Address</label>\r\n                                    <input\r\n                                      type=\"text\"\r\n                                      required\r\n                                      name=\"homeAddress\"\r\n                                      placeholder=\"Home Address\"\r\n                                      onChange={handleChange}\r\n                                    />\r\n                                  </div>\r\n                                  <div className=\"dashboard-content-form-container\">\r\n                                    <label>Profession</label>\r\n                                    {/* <select\r\n                                          name=\"profession\"\r\n                                          required\r\n                                          onChange={handleChange}\r\n                                        >\r\n                                          <option value=\"\">\r\n                                            Choose Profession\r\n                                          </option>\r\n                                          <option value=\"Civil Servant\">\r\n                                            Civil Servant\r\n                                          </option>\r\n                                          <option value=\"Self Employed\">\r\n                                            Self Employed\r\n                                          </option>\r\n                                          <option value=\"Private worker\">\r\n                                            Private worker\r\n                                          </option>\r\n\r\n                                          <option\r\n                                            className=\"other\"\r\n                                            key=\"Other\"\r\n                                            value=\"Other\"\r\n                                          >\r\n                                            Other\r\n                                          </option>\r\n                                        </select> */}\r\n                                    <input\r\n                                      onChange={handleChange}\r\n                                      required\r\n                                      name=\"profession\"\r\n                                      type=\"text\"\r\n                                      placeholder=\"Enter Profession\"\r\n                                    ></input>\r\n\r\n                                    {/* {showProfessionalInput1 ? (\r\n                                          <input\r\n                                            onChange={handleChange}\r\n                                            name=\"profession\"\r\n                                            type=\"text\"\r\n                                            placeholder=\"Enter Profession\"\r\n                                          ></input>\r\n                                        ) : (\r\n                                          <>\r\n                                          </>\r\n                                        )} */}\r\n                                  </div>\r\n                                  <div className=\"dashboard-content-form-container\">\r\n                                    <label>Name of Organisation</label>\r\n                                    <input\r\n                                      type=\"text\"\r\n                                      required\r\n                                      name=\"organisation\"\r\n                                      placeholder=\"Name of organisation\"\r\n                                      onChange={handleChange}\r\n                                    />\r\n                                  </div>\r\n                                  <div className=\"dashboard-content-form-container\">\r\n                                    <label>Name of Employer</label>\r\n                                    <input\r\n                                      type=\"text\"\r\n                                      required\r\n                                      name=\"employer\"\r\n                                      placeholder=\"Name of employer\"\r\n                                      onChange={handleChange}\r\n                                    />\r\n                                  </div>\r\n                                  <div className=\"dashboard-content-form-container\">\r\n                                    <label>Email Address of Employer</label>\r\n                                    <input\r\n                                      type=\"email\"\r\n                                      required\r\n                                      name=\"employerMail\"\r\n                                      placeholder=\"Email Address of Employer\"\r\n                                      onChange={handleChange}\r\n                                    />\r\n                                  </div>\r\n                                  <div className=\"dashboard-content-form-container\">\r\n                                    <label>Phone of Employer</label>\r\n                                    <input\r\n                                      type=\"phone\"\r\n                                      required\r\n                                      name=\"employerPhone\"\r\n                                      placeholder=\"Phone of Employer\"\r\n                                      onChange={handleChange}\r\n                                    />\r\n                                  </div>\r\n                                  <div className=\"dashboard-content-form-container\">\r\n                                    <label>\r\n                                      Relationship with guarantor (Who is your\r\n                                      guarantor to you?)\r\n                                    </label>\r\n\r\n                                    <input\r\n                                      onChange={handleChange}\r\n                                      required\r\n                                      name=\"relationship\"\r\n                                      type=\"text\"\r\n                                      placeholder=\"Enter Relationship\"\r\n                                    ></input>\r\n\r\n                                    {/* <select\r\n                                          name=\"relationship\"\r\n                                          required\r\n                                          onChange={handleChange}\r\n                                        >\r\n                                          <option value=\"\">\r\n                                            Select Relationship\r\n                                          </option>\r\n                                          <option value=\"Parents\">Parents</option>\r\n                                          <option value=\"Legal Guardian\">\r\n                                            Legal Guardian\r\n                                          </option>\r\n                                          <option value=\"Employer\">Employer</option>\r\n                                          <option value=\"Other\">Other</option>\r\n                                        </select> */}\r\n\r\n                                    {/* {showGuarantorRelationshipInput1 ? (\r\n                                          <input\r\n                                            onChange={handleChange}\r\n                                            name=\"relationship\"\r\n                                            type=\"text\"\r\n                                            placeholder=\"Enter Relationship\"\r\n                                          ></input>\r\n                                        ) : (\r\n                                          <></>\r\n                                        )} */}\r\n                                  </div>\r\n                                  <button\r\n                                    style={{ float: \"right\", width: \"100px\" }}\r\n                                    type=\"submit\"\r\n                                    id=\"actionBtn\"\r\n                                  >\r\n                                    Proceed\r\n                                  </button>\r\n                                </form>\r\n                              </div>\r\n                            ) : (\r\n                              <div className=\"dashboard-content-form\">\r\n                                <form\r\n                                  // onSubmit={(e) => submitForm(e, \"guarantor2\")}\r\n                                  onSubmit={(e) => SubmitGuarantorForm_2(e)}\r\n                                  id=\"guarantorForm2\"\r\n                                >\r\n                                  <div className=\"dashboard-content-form-container\">\r\n                                    <label>First Name</label>\r\n                                    <input\r\n                                      type=\"text\"\r\n                                      required\r\n                                      name=\"firstName\"\r\n                                      placeholder=\"FirstName\"\r\n                                      onChange={handleChange}\r\n                                    />\r\n                                  </div>\r\n                                  <div className=\"dashboard-content-form-container\">\r\n                                    <label>Last Name</label>\r\n                                    <input\r\n                                      type=\"text\"\r\n                                      required\r\n                                      name=\"lastName\"\r\n                                      placeholder=\"LastName\"\r\n                                      onChange={handleChange}\r\n                                    />\r\n                                  </div>\r\n                                  <div className=\"dashboard-content-form-container\">\r\n                                    <label>Email Address</label>\r\n                                    <input\r\n                                      type=\"email\"\r\n                                      required\r\n                                      name=\"email\"\r\n                                      placeholder=\"Email Address\"\r\n                                      onChange={handleChange}\r\n                                    />\r\n                                  </div>\r\n                                  <div className=\"dashboard-content-form-container\">\r\n                                    <label>Phone Number</label>\r\n                                    <input\r\n                                      type=\"number\"\r\n                                      required\r\n                                      name=\"phone\"\r\n                                      placeholder=\"Phone Number\"\r\n                                      onChange={handleChange}\r\n                                    />\r\n                                  </div>\r\n                                  <div className=\"dashboard-content-form-container\">\r\n                                    <label>Gender</label>\r\n                                    <select\r\n                                      name=\"gender\"\r\n                                      required\r\n                                      onChange={handleChange}\r\n                                    >\r\n                                      <option value=\"\">Select Gender</option>\r\n                                      <option value=\"Male\">Male</option>\r\n                                      <option value=\"Female\">Female</option>\r\n                                    </select>\r\n                                  </div>\r\n                                  <div className=\"dashboard-content-form-container\">\r\n                                    <label>Office Address</label>\r\n                                    <input\r\n                                      type=\"text\"\r\n                                      required\r\n                                      name=\"officeAddress\"\r\n                                      placeholder=\"Office Address\"\r\n                                      onChange={handleChange}\r\n                                    />\r\n                                  </div>\r\n                                  <div className=\"dashboard-content-form-container\">\r\n                                    <label>Home Address</label>\r\n                                    <input\r\n                                      type=\"text\"\r\n                                      required\r\n                                      name=\"homeAddress\"\r\n                                      placeholder=\"Home Address\"\r\n                                      onChange={handleChange}\r\n                                    />\r\n                                  </div>\r\n                                  <div className=\"dashboard-content-form-container\">\r\n                                    <label>Profession</label>\r\n                                    <input\r\n                                      onChange={handleChange}\r\n                                      name=\"profession\"\r\n                                      required\r\n                                      type=\"text\"\r\n                                      placeholder=\"Enter Profession\"\r\n                                    ></input>\r\n\r\n                                    {/* <select\r\n                                          name=\"profession\"\r\n                                          required\r\n                                          onChange={handleChange}\r\n                                        >\r\n                                          <option value=\"\">\r\n                                            Choose Profession\r\n                                          </option>\r\n                                          <option value=\"Civil Servant\">\r\n                                            Civil Servant\r\n                                          </option>\r\n                                          <option value=\"Self Employed\">\r\n                                            Self Employed\r\n                                          </option>\r\n                                          <option value=\"Private worker\">\r\n                                            Private worker\r\n                                          </option>\r\n                                          <option value=\"Other\">Other</option>\r\n                                        </select> */}\r\n                                  </div>\r\n                                  <div className=\"dashboard-content-form-container\">\r\n                                    <label>Name of Organisation</label>\r\n                                    <input\r\n                                      type=\"text\"\r\n                                      required\r\n                                      name=\"organisation\"\r\n                                      placeholder=\"Name of organisation\"\r\n                                      onChange={handleChange}\r\n                                    />\r\n                                  </div>\r\n                                  <div className=\"dashboard-content-form-container\">\r\n                                    <label>Name of Employer</label>\r\n                                    <input\r\n                                      type=\"text\"\r\n                                      required\r\n                                      name=\"employer\"\r\n                                      placeholder=\"Name of employer\"\r\n                                      onChange={handleChange}\r\n                                    />\r\n                                  </div>\r\n                                  <div className=\"dashboard-content-form-container\">\r\n                                    <label>Email Address of Employer</label>\r\n                                    <input\r\n                                      type=\"email\"\r\n                                      required\r\n                                      name=\"employerMail\"\r\n                                      placeholder=\"Email Address of Employer\"\r\n                                      onChange={handleChange}\r\n                                    />\r\n                                  </div>\r\n                                  <div className=\"dashboard-content-form-container\">\r\n                                    <label>Phone of Employer</label>\r\n                                    <input\r\n                                      type=\"phone\"\r\n                                      required\r\n                                      name=\"employerPhone\"\r\n                                      placeholder=\"Phone of Employer\"\r\n                                      onChange={handleChange}\r\n                                    />\r\n                                  </div>\r\n                                  <div className=\"dashboard-content-form-container\">\r\n                                    <label>Relationship with guarantor</label>\r\n                                    <input\r\n                                      onChange={handleChange}\r\n                                      required\r\n                                      name=\"relationship\"\r\n                                      type=\"text\"\r\n                                      placeholder=\"Enter Relationship\"\r\n                                    ></input>\r\n                                    {/* \r\n                                        <select\r\n                                          name=\"relationship\"\r\n                                          required\r\n                                          onChange={handleChange}\r\n                                        >\r\n                                          <option value=\"\">\r\n                                            Select Relationship\r\n                                          </option>\r\n                                          <option value=\"Parents\">Parents</option>\r\n                                          <option value=\"Legal Guardian\">\r\n                                            Legal Guardian\r\n                                          </option>\r\n                                          <option value=\"Employer\">Employer</option>\r\n                                          <option value=\"Other\">Other</option>\r\n                                        </select> */}\r\n                                  </div>\r\n                                  <button\r\n                                    style={{ float: \"right\", width: \"100px\" }}\r\n                                    type=\"submit\"\r\n                                    id=\"actionBtn\"\r\n                                  >\r\n                                    Submit\r\n                                  </button>\r\n                                </form>\r\n                              </div>\r\n                            )}\r\n                          </div>\r\n                        )}\r\n                      </div>\r\n                    ) : (\r\n                      <div>\r\n                        {selectStatus === \"congrats\" &&\r\n                          selectStatus !== \"paid\" && (\r\n                            <div>\r\n                              <h3>Hello {details.firstName}</h3>\r\n                              <p className=\"text1\">Congratulations!</p>\r\n                              <p>\r\n                                Your application has been selected. Click on the\r\n                                button below to continue you admission process.\r\n                              </p>\r\n                              <button onClick={() => setPayShowModal(\"pay\")}>\r\n                                Continue admission process\r\n                              </button>\r\n\r\n                              {payShowModal === \"pay\" && (\r\n                                <div className=\"dashboard-content-modal\">\r\n                                  <div className=\"dashboard-content-modal-backdrop\"></div>\r\n                                  <div className=\"dashboard-content-modal-container\">\r\n                                    <div className=\"dashboard-content-modal-main\">\r\n                                      <div className=\"dashboard-content-modal-main-text\">\r\n                                        <h4>Choose Payment Option</h4>\r\n                                        <img\r\n                                          src={cancel}\r\n                                          alt=\"cancel\"\r\n                                          onClick={() => setPayShowModal(\"\")}\r\n                                        />\r\n                                      </div>\r\n                                      {/* <div\r\n                                        className={\r\n                                          payOpt === \"part\"\r\n                                            ? \"active\"\r\n                                            : \"dashboard-content-modal-main-frame1\"\r\n                                        }\r\n                                        onClick={() => {\r\n                                          setPayOpt(\"part\");\r\n                                          setAmount(50000);\r\n                                          setCurrency(\"NGN\");\r\n                                        }}\r\n                                      >\r\n                                        <div></div>\r\n                                        <p>\r\n                                          Pay as you earn (NGN 50,000 legal fee)\r\n                                        </p>\r\n                                      </div> */}\r\n                                      <div\r\n                                        className={\r\n                                          payOpt === \"full\"\r\n                                            ? \"active\"\r\n                                            : \"dashboard-content-modal-main-frame1\"\r\n                                        }\r\n                                        onClick={() => {\r\n                                          setPayOpt(\"full\");\r\n                                          setAmount(500000);\r\n                                          setCurrency(\"NGN\");\r\n                                        }}\r\n                                      >\r\n                                        <div></div>\r\n                                        <p>Pay at once (NGN 500,000)</p>\r\n                                      </div>\r\n                                      <a\r\n                                        href=\"https://docs.google.com/forms/u/3/d/e/1FAIpQLSep9AvrWxiedsn8KWYTTiTAArLRwsHRSLnnd49GIrJ35Z4FUw/viewform?usp=pp_url&authuser=0\"\r\n                                        target=\"_blank\"\r\n                                        className={\r\n                                          payOpt === \"install\"\r\n                                            ? \"active\"\r\n                                            : \"dashboard-content-modal-main-frame1\"\r\n                                        }\r\n                                      >\r\n                                        <div></div>\r\n                                        <p>\r\n                                          Pay in Installments (NGN550,000:\r\n                                          Starts from NGN 250,000)\r\n                                        </p>\r\n                                      </a>\r\n                                      <button\r\n                                        // onClick={makePayment}\r\n                                        onClick={() => flutterWavePayment()}\r\n                                        // onClick={() =>\r\n                                        //   handlePayercoinsPayment()\r\n                                        // }\r\n                                      >\r\n                                        Proceed\r\n                                      </button>\r\n                                    </div>\r\n                                  </div>\r\n                                </div>\r\n                              )}\r\n                            </div>\r\n                          )}\r\n                      </div>\r\n                    )}\r\n\r\n                    {selectStatus === \"paid\" && (\r\n                      <PaymentReceived fname={details.firstName} />\r\n                    )}\r\n                  </div>\r\n                )}\r\n\r\n                {status === \"Rejected\" && (\r\n                  <Rejected fname={details.firstName} />\r\n                )}\r\n              </div>\r\n            )}\r\n            {sidebarClick === \"details\" && <Details />}\r\n          </div>\r\n        </div>\r\n      ) : (\r\n        <Loader />\r\n      )}\r\n    </>\r\n  );\r\n}\r\n\r\nexport default Dashboard;\r\n","C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\pages\\graduateCohort\\auth\\Login.js",["433"],"import { useState } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { LoginAction } from \"../../../api/dashboard/auth\";\r\nimport { ToastContainer, toast } from \"react-toastify\";\r\nimport { LazyLoadImage } from \"react-lazy-load-image-component\";\r\n\r\nimport logo from \"../../../images/svg/academy-logo.svg\";\r\nimport visible from \"../../../images/svg/visible.svg\";\r\nimport notvisible from \"../../../images/svg/notvisible.svg\";\r\nimport loader from \"../../../images/svg/dashboard/loader.gif\";\r\nimport authImg from \"../../../images/auth.png\";\r\n\r\nfunction Login() {\r\n  const [form, setForm] = useState({\r\n    email: \"\",\r\n    password: \"\",\r\n    cohort: \"\",\r\n  });\r\n\r\n  const handleChange = (e) => {\r\n    setForm({\r\n      ...form,\r\n      [e.target.name]: e.target.value,\r\n    });\r\n  };\r\n\r\n  const doLogin = (e) => {\r\n    console.log(form);\r\n    e.preventDefault();\r\n    var btn = document.getElementById(\"actionBtn\");\r\n    btn.innerHTML = `<img src=${loader} width=\"20px\" />`;\r\n    const { email, password, cohort } = form;\r\n    var data = new FormData();\r\n\r\n    data.append(\"email\", email);\r\n    data.append(\"password\", password);\r\n    data.append(\"cohort_batch\", cohort);\r\n\r\n    LoginAction(data)\r\n      .then((response) => response.data)\r\n      .then((res) => {\r\n        if (res.status === 201) {\r\n          toast.success(`${res.message}! Redirecting to dashboard...`);\r\n\r\n          sessionStorage.setItem(\r\n            \"user_details\",\r\n            JSON.stringify({\r\n              firstName: res.data.payload.FirstName,\r\n              lastName: res.data.payload.LastName,\r\n              email: res.data.payload.email,\r\n              id: res.data.payload.id,\r\n              isPaid: res.data.payload.isPaid,\r\n              applicationFee: res.data.payload.applicationFee,\r\n              phone: res.data.phoneNumber,\r\n              token: res.data.token,\r\n            })\r\n          );\r\n          sessionStorage.setItem(\"status\", `${res.data.status}`);\r\n\r\n          btn.innerHTML = `Sign in`;\r\n          setTimeout(function () {\r\n            window.location = \"/dashboard\";\r\n          }, 2500);\r\n        } else {\r\n          toast.error(\"Something went wrong, please try again!!!\");\r\n        }\r\n      })\r\n      .catch((err) => {\r\n        toast.error(err.response.data.message);\r\n\r\n        if (err.response.data.message) {\r\n          toast.error(err.response.data.message);\r\n          btn.innerHTML = `Sign in`;\r\n        } else {\r\n          toast.error(\r\n            \"Something went wrong!!! Please make sure you have a good internet connection.\"\r\n          );\r\n          btn.innerHTML = `Sign in`;\r\n        }\r\n      });\r\n  };\r\n\r\n  const toggleIcon = () => {\r\n    var x = document.getElementById(\"password\");\r\n    var iconContainer = document.getElementById(\"toggle\");\r\n    if (x.type === \"password\") {\r\n      x.type = \"text\";\r\n      iconContainer.innerHTML = `<img src=${notvisible} />`;\r\n    } else {\r\n      x.type = \"password\";\r\n      iconContainer.innerHTML = `<img src=${visible} />`;\r\n    }\r\n  };\r\n\r\n  return (\r\n    <div className=\"layout_auth\">\r\n      <ToastContainer />\r\n      <div className=\"layout_auth-main\">\r\n        <div className=\"auth_container\">\r\n          <div className=\"auth_container-logo\">\r\n            <Link to=\"/\">\r\n              <img src={logo} alt=\"logo\" />\r\n            </Link>\r\n          </div>\r\n          <div className=\"auth_container_form\">\r\n            <h3>Login to your account</h3>\r\n            <p className=\"auth_container_form-text\">\r\n              Enter your email address and password to continue.\r\n            </p>\r\n            <form onSubmit={doLogin}>\r\n              <div>\r\n                <label>Email Address</label>\r\n                <input\r\n                  type=\"email\"\r\n                  required\r\n                  placeholder=\"Email Address\"\r\n                  name=\"email\"\r\n                  onChange={handleChange}\r\n                />\r\n              </div>\r\n              <div className=\"auth_container_form-password\">\r\n                <label>Password</label>\r\n                <input\r\n                  type=\"password\"\r\n                  required\r\n                  id=\"password\"\r\n                  placeholder=\"Password\"\r\n                  name=\"password\"\r\n                  onChange={handleChange}\r\n                />\r\n                <div id=\"toggle\" onClick={toggleIcon}>\r\n                  <img src={visible} />\r\n                </div>\r\n              </div>\r\n              <div>\r\n                <label>Cohort</label>\r\n                <select\r\n                  name=\"cohort\"\r\n                  onChange={handleChange}\r\n                  defaultValue={form.cohort}\r\n                  required\r\n                >\r\n                  <option value=\"\" disabled>\r\n                    Choose your preferred cohort\r\n                  </option>\r\n                  <option value=\"CH13\">CH-13 - January</option>\r\n                  <option value=\"CH14\">CH-14 - May</option>\r\n                  <option value=\"CH15\">CH-15 - August</option>\r\n                </select>\r\n              </div>\r\n              <button type=\"submit\" id=\"actionBtn\">\r\n                Sign in\r\n              </button>\r\n              <p>\r\n                <Link to=\"/forgot-password\">\r\n                  <span>Forgot your password?</span>\r\n                </Link>\r\n              </p>\r\n              <p>\r\n                Don't have an account?{\" \"}\r\n                <Link to=\"/signup\">\r\n                  <span>Sign up</span>\r\n                </Link>\r\n              </p>\r\n              {/* <p>\r\n                Don't have an account?{\" \"}\r\n                <span\r\n                  onClick={() =>\r\n                    toast.info(\r\n                      \"Application is Closed. Enrollment into Cohort 013 begins September 2022\"\r\n                    )\r\n                  }\r\n                >\r\n                  Sign up\r\n                </span>\r\n              </p> */}\r\n            </form>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <div className=\"layout_auth-image\">\r\n        <LazyLoadImage\r\n          src={authImg}\r\n          effect=\"blur\"\r\n          alt=\"auth\"\r\n          height=\"auto\"\r\n          width=\"100%\"\r\n        />\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default Login;\r\n","C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\redux\\slice\\pageData.js",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\redux\\slice\\page-data.js",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\pages\\hire\\index.js",["434","435","436","437","438","439","440","441","442","443"],"import React, { useState, useEffect } from \"react\";\r\nimport { Container, Row, Col } from \"react-bootstrap\";\r\nimport Navbar from \"../../components/Navbar\";\r\nimport Footer from \"../../components/Footer\";\r\nimport Mode from \"../../components/Mode\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { getAllTalents } from \"../../api/dashboard/hire\";\r\n\r\nimport Sponsor1 from \"../../images/svg/Apple.svg\";\r\nimport Sponsor2 from \"../../images/svg/AWS.svg\";\r\nimport Sponsor3 from \"../../images/svg/Flutterwave.svg\";\r\nimport Sponsor5 from \"../../images/svg/Microsoft.svg\";\r\nimport Sponsor6 from \"../../images/svg/Google.svg\";\r\n// import whyHire from \"../../images/why-hire.png\";\r\nimport whyHire from \"../../images/why_hire_2.jpg\";\r\n\r\nimport man from \"../../images/man.jpg\";\r\nimport my_love from \"../../images/my_love.png\";\r\nimport kamala from \"../../images/kamala.jpg\";\r\nimport arrow from \"../../images/svg/arrow-front.svg\";\r\nimport star from \"../../images/svg/star.svg\";\r\nimport Loader from \"../../components/Loader\";\r\nimport { saveHireId } from \"../../redux/slice/pageData.js\";\r\nimport { useSelector, useDispatch } from \"react-redux\";\r\n\r\nconst Hire = () => {\r\n  let dispatch = useDispatch();\r\n\r\n  const [carousel, setCarousel] = useState(\"one\");\r\n  const [carouselInfo, setCarouselInfo] = useState({\r\n    firstName: \"Jonathan Doe\",\r\n    profession: \"Product Designer\",\r\n    profile_upload: man,\r\n    stars: 4,\r\n  });\r\n\r\n  const [talents, setTalents] = useState([]);\r\n  const [index, setIndex] = useState(0);\r\n\r\n  useEffect(() => {\r\n    document.title = \"Hire - Grazac Academy\";\r\n    // window.scrollTo(0, 0);\r\n    getAllTalents(1)\r\n      .then((response) => response)\r\n      .then((resp) => {\r\n        if (resp.status === 200) {\r\n          setTalents(resp.data.data.users);\r\n          setCarouselInfo(resp.data.data.users[0]);\r\n        } else {\r\n          alert(\r\n            `Something went wrong, please try again!!! Message: ${resp.data.message}`\r\n          );\r\n        }\r\n      })\r\n      .catch((err) => {\r\n        alert(`Something went wrong, please try again!!!`);\r\n      });\r\n  }, []);\r\n\r\n\r\n  const carouselPple = [\r\n    {\r\n      name: \"Jonathan Doe\",\r\n      position: \"Software Engineer, Primer AI\",\r\n      stars: 4,\r\n    },\r\n    {\r\n      name: \"Miracle Shadare\",\r\n      position: \"Content Writer, Grazac\",\r\n      stars: 4,\r\n    },\r\n    {\r\n      name: \"Rebecca West\",\r\n      position: \"Product Designer, Google LLC\",\r\n      stars: 4,\r\n    },\r\n  ];\r\n\r\n  const whyContent = [\r\n    {\r\n      heading: \"Competency\",\r\n      paragraph:\r\n        \"Our tech talents are adequately trained to be globally certified and competent to work anywhere in the world whether remotely or on-site.\",\r\n    },\r\n    {\r\n      heading: \"Good knowledge of soft skills\",\r\n      paragraph:\r\n        \"Our tech talents are not only vast with tech skills and tools, but also equipped with soft skills that will foster great workplace ethics.\",\r\n    },\r\n    {\r\n      heading: \"Strong Problem solving skill\",\r\n      paragraph:\r\n        \"Our tech talents are not just entry levels, they have gone through an in-depth internship program giving them prior workplace experience and they are practical oriented.\",\r\n    },\r\n    {\r\n      heading: \"No Hiring Stress\",\r\n      paragraph:\r\n        \"You won't have to sift through hundreds of fresh applications to determine the perfect fit for the position you're looking for.\",\r\n    },\r\n  ];\r\n\r\n  return (\r\n    <div>\r\n\r\n      {talents.length != 0 ? (\r\n        <div>\r\n          <Navbar />\r\n          <div className=\"hire\">\r\n            <div className=\"hire_hero\">\r\n              <Container>\r\n                <Row>\r\n                  <Col md={6}>\r\n                    <div>\r\n                      <h1>Hire top tech talents from our pool</h1>\r\n                      <p>\r\n                        Attracting the best tech talent is competitive, let’s\r\n                        pull them out from our pool.\r\n                      </p>\r\n                      <Link to=\"/hire/listing\">\r\n                        <button>Hire from Us</button>\r\n                      </Link>\r\n                    </div>\r\n                  </Col>\r\n                  <Col md={6}>\r\n                    <div className=\"hire_hero-carousel\">\r\n                      {carousel === \"one\" && (\r\n                        <img\r\n                          src={talents[0]?.profile_upload}\r\n                          alt=\"main-image\"\r\n                          className=\"hire_hero-carousel-mainImage\"\r\n                        />\r\n                      )}\r\n                      {carousel === \"two\" && (\r\n                        <img\r\n                          src={talents[1]?.profile_upload}\r\n                          alt=\"main-image\"\r\n                          className=\"hire_hero-carousel-mainImage\"\r\n                        />\r\n                      )}\r\n                      {carousel === \"three\" && (\r\n                        <img\r\n                          src={talents[2]?.profile_upload}\r\n                          alt=\"main-image\"\r\n                          className=\"hire_hero-carousel-mainImage\"\r\n                        />\r\n                      )}\r\n                      <div\r\n                        className={\r\n                          carousel === \"one\"\r\n                            ? \"hire_hero-carousel-frame box1 crs-bg\"\r\n                            : \"hire_hero-carousel-frame box1\"\r\n                        }\r\n                      >\r\n                        <div\r\n                          className=\"hire_hero-carousel-frame-image\"\r\n                          onClick={() => {\r\n                            setCarousel(\"one\");\r\n                            setCarouselInfo(talents[0]);\r\n                          }}\r\n                        >\r\n                          <img src={talents[0]?.profile_upload} alt=\"picx\" />\r\n                        </div>\r\n                      </div>\r\n                      <div\r\n                        className={\r\n                          carousel === \"two\"\r\n                            ? \"hire_hero-carousel-frame box2 crs-bg\"\r\n                            : \"hire_hero-carousel-frame box2\"\r\n                        }\r\n                      >\r\n                        <div\r\n                          className=\"hire_hero-carousel-frame-image\"\r\n                          onClick={() => {\r\n                            setCarousel(\"two\");\r\n                            setCarouselInfo(talents[1]);\r\n                          }}\r\n                        >\r\n                          <img src={talents[1]?.profile_upload} alt=\"picx\" />\r\n                        </div>\r\n                      </div>\r\n                      <div\r\n                        className={\r\n                          carousel === \"three\"\r\n                            ? \"hire_hero-carousel-frame box3 crs-bg\"\r\n                            : \"hire_hero-carousel-frame box3\"\r\n                        }\r\n                      >\r\n                        <div\r\n                          className=\"hire_hero-carousel-frame-image\"\r\n                          onClick={() => {\r\n                            setCarousel(\"three\");\r\n                            setCarouselInfo(talents[2]);\r\n                          }}\r\n                        >\r\n                          <img src={talents[2]?.profile_upload} alt=\"picx\" />\r\n                        </div>\r\n                      </div>\r\n                      <div className=\"hire_hero-carousel-textbox\">\r\n                        <div>\r\n                          <h4>\r\n                            {carouselInfo?.firstName} {carouselInfo?.lastName}\r\n                          </h4>\r\n                          <p>{carouselInfo?.profession}</p>\r\n                          <div>\r\n                            <img src={star} alt=\"star\" />\r\n                            <img src={star} alt=\"star\" />\r\n                            <img src={star} alt=\"star\" />\r\n                            <img src={star} alt=\"star\" />\r\n                          </div>\r\n                        </div>\r\n                      </div>\r\n                    </div>\r\n                  </Col>\r\n                </Row>\r\n              </Container>\r\n            </div>\r\n\r\n            <div className=\"landing__sponsors\">\r\n              <div className=\"landing__sponsors--container\">\r\n                <img src={Sponsor1} alt=\"sponsor\" />\r\n                <img src={Sponsor2} alt=\"sponsor\" />\r\n                <img src={Sponsor3} alt=\"sponsor\" />\r\n                <img src={Sponsor5} alt=\"sponsor\" />\r\n                <img src={Sponsor6} alt=\"sponsor\" />\r\n              </div>\r\n            </div>\r\n\r\n            <div className=\"hire_why\">\r\n              <Container>\r\n                <Row> \r\n                  <Col md={6}>\r\n                    <img src={whyHire} alt=\"why-hire\" className=\"hire_why-img\" />\r\n                  </Col>\r\n                  <Col md={6}>\r\n                    <div className=\"hire_why-content\">\r\n                      <h2>\r\n                        Why Top Companies <br />\r\n                        Hire from Us\r\n                      </h2>\r\n                      {whyContent.map((item, idx) => (\r\n                        <div key={idx}>\r\n                          <p className=\"hire_why-content-heading\">\r\n                            {item.heading}\r\n                          </p>\r\n                          <p className=\"hire_why-content-paragraph\">\r\n                            {item.paragraph}\r\n                          </p>\r\n                        </div>\r\n                      ))}\r\n                    </div>\r\n                  </Col>\r\n                </Row>\r\n              </Container>\r\n            </div>\r\n\r\n            <div className=\"hire_talents\">\r\n              <h2>Our Top Talents</h2>\r\n              <div className=\"hire_talents-define\">\r\n                <p>\r\n                  You determine the starting points, we provide the best\r\n                  possible interception to achieve the goals.\r\n                </p>\r\n              </div>\r\n              <div className=\"hire_talents-cards\">\r\n                <Container>\r\n                  <Row>\r\n                    {talents.slice(0, 6).map((item, idx) => (\r\n                      <Col md={4} sm={6} key={idx}>\r\n                     <Link\r\n                        style={{ color: \"black\" }}\r\n                        to={`/hire/${item.firstName}${item.lastName}`}\r\n                        key={idx}\r\n                       \r\n                      >\r\n               \r\n                          <div\r\n                            onClick={()=>dispatch(saveHireId(item.id))}\r\n                          className=\"hire_talents-cards-box\">\r\n                            <div className=\"hire_talents-cards-box-image\">\r\n                              <img src={item.profile_upload} alt=\"talent\" />\r\n                            </div>\r\n                            <div className=\"hire_talents-cards-box-text\">\r\n                              <h4>\r\n                                {item.firstName} {item.lastName}\r\n                              </h4>\r\n                              <p className=\"hire_talents-cards-box-text-1\">\r\n                                {item.profession}\r\n                              </p>\r\n                              <div\r\n                                className={\r\n                                  item.status === \"Hired\"\r\n                                    ? \"hire_talents-cards-box-text-hired\"\r\n                                    : \"hire_talents-cards-box-text-available\"\r\n                                }\r\n                              >\r\n                                <p>\r\n                                  {item.status === \"Hired\"\r\n                                    ? \"HIRED\"\r\n                                    : \"AVAILABLE\"}\r\n                                </p>\r\n                              </div>\r\n                            </div>\r\n                          </div>\r\n                        </Link>\r\n                      </Col>\r\n                    ))}\r\n                  </Row>\r\n                </Container>\r\n                <Link to=\"/hire/listing\">\r\n                  <button>\r\n                    View more\r\n                    <img src={arrow} alt=\"alt\" />\r\n                  </button>\r\n                </Link>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <Mode\r\n            page={\"hire\"}\r\n            title={\"Make your dream job your real job\"}\r\n            text={\r\n              \"Learn in-demand tech skills with us and become globally sought-after in the digital space.\"\r\n            }\r\n            button_1={\"Learn with us\"}\r\n            button_2={\"Contact us\"}\r\n          />\r\n          <Footer />\r\n        </div>\r\n      ) : (\r\n        <Loader />\r\n      )}\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default Hire;\r\n","C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\components\\PrimaryBtn.js",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\components\\Modal.js",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\components\\MOT.js",["444"],"import sprint from \"../images/sprint.png\";\r\nimport quote from \"../images/svg/quote.svg\";\r\nimport portfolio from \"../images/svg/portfolio.svg\";\r\nimport handshake from \"../images/svg/handshake.svg\";\r\nimport document from \"../images/svg/document.svg\";\r\nimport classroom from \"../images/svg/classroom.svg\";\r\nimport Pricing, { priceData } from \"./pricing/pricing\";\r\n\r\nconst ModeOfTeaching = (_) => {\r\n  return (\r\n    <div className=\"course_mode\">\r\n      <div className=\"container\">\r\n        <div className=\"course_wwd-intro\">\r\n          <h4>What we do</h4>\r\n          <h2>Mode Of Learning</h2>\r\n          <p>\r\n            We have designed strategic pathways that will fast track your\r\n            learning curve.\r\n          </p>\r\n        </div>\r\n        <div className=\"course_mode-container\">\r\n          <div className=\"\">\r\n            <div>\r\n              <div className=\"boxes\">\r\n                <div className=\"svg-box\">\r\n                  <img src={classroom} alt=\"mode of learning\" />\r\n                </div>\r\n                <h3>Instructor-led live classes</h3>\r\n                <p className=\"lenght1\">\r\n                  Join other students in our classes (physically or virtually)\r\n                  with experts in the industry.\r\n                </p>\r\n              </div>\r\n              <div className=\"boxes\">\r\n                <div className=\"svg-box\">\r\n                  <img src={portfolio} alt=\"mode of learning\" />\r\n                </div>\r\n                <h3>Networking</h3>\r\n                <p className=\"lenght1\">\r\n                  Collaborate and communicate by exchanging ideas with other\r\n                  students of same interest to facilitate your career and build\r\n                  a community.\r\n                </p>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <div className=\"\">\r\n            <div>\r\n              <div className=\"boxes\">\r\n                <div className=\"svg-box\">\r\n                  <img src={document} alt=\"mode of learning\" />\r\n                </div>\r\n                <h3>Project Based Learning</h3>\r\n                <p className=\"lenght1\">\r\n                  Opportunity to work on real-life projects by applying what you\r\n                  learn to enhance your skills and solve related problems.\r\n                </p>\r\n              </div>\r\n              <div className=\"boxes\">\r\n                <div className=\"svg-box\">\r\n                  <img src={handshake} alt=\"mode of learning\" />\r\n                </div>\r\n                <h3>Mentorship Access</h3>\r\n                <p className=\"lenght1\">\r\n                  Access to counselling and personalized guidance from mentors\r\n                  and thought leaders in your field that will increase your\r\n                  visibility to other employers.\r\n                </p>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <div className=\"mode-pic\">\r\n            {/* <img src={sprint} alt=\"jdgkj\" style={{width:'100%'}} /> */}\r\n          </div>\r\n        </div>\r\n        <div className=\"price-data\">\r\n          {priceData.map((item, i) => (\r\n            <Pricing {...item} key={i} />\r\n          ))}\r\n        </div>\r\n        <div className=\"course_mode-quote\">\r\n          <img src={quote} alt=\"quote\" />\r\n          <p>\r\n            I've known Grazac for over a year now and having worked with some of\r\n            their successful students, I can boldly say the competency and\r\n            problem solving skills of their students is top-notch and their\r\n            academy is one of the best academy promoting technology skills\r\n            acquisition here in Nigeria\r\n          </p>\r\n          <span>Samson Adedamola - Consultant at Kudi</span>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  );\r\n};\r\nexport default ModeOfTeaching;\r\n","C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\components\\Mode.js",["445","446","447","448","449","450","451"],"import lady from \"../images/Grazac-website/IMG_8440.JPG\";\r\nimport { ToastContainer, toast } from 'react-toastify';\r\n\r\n\r\nconst Linkedn = () => (\r\n  <a>\r\n    <svg\r\n      width=\"15\"\r\n      height=\"15\"\r\n      viewBox=\"0 0 15 15\"\r\n      fill=\"none\"\r\n      xmlns=\"http://www.w3.org/2000/svg\"\r\n    >\r\n      <path\r\n        d=\"M13.6431 0H1.35687C0.6075 0 0 0.6075 0 1.35687V13.6431C0 14.3925 0.6075 15 1.35687 15H13.6431C14.3925 15 15 14.3925 15 13.6431V1.35687C15 0.6075 14.3925 0 13.6431 0ZM4.64164 12.952C4.64164 13.1701 4.46486 13.3469 4.24677 13.3469H2.5659C2.34781 13.3469 2.17103 13.1701 2.17103 12.952V5.90588C2.17103 5.68779 2.34781 5.51101 2.5659 5.51101H4.24677C4.46486 5.51101 4.64164 5.68779 4.64164 5.90588V12.952ZM3.40634 4.84681C2.52444 4.84681 1.8095 4.13187 1.8095 3.24997C1.8095 2.36808 2.52444 1.65314 3.40634 1.65314C4.28823 1.65314 5.00317 2.36808 5.00317 3.24997C5.00317 4.13187 4.28827 4.84681 3.40634 4.84681ZM13.4258 12.9838C13.4258 13.1843 13.2632 13.3469 13.0627 13.3469H11.259C11.0585 13.3469 10.896 13.1843 10.896 12.9838V9.67877C10.896 9.18573 11.0406 7.51826 9.6075 7.51826C8.49589 7.51826 8.27042 8.65959 8.22514 9.17179V12.9838C8.22514 13.1843 8.06262 13.3469 7.86208 13.3469H6.1176C5.91711 13.3469 5.75454 13.1843 5.75454 12.9838V5.87407C5.75454 5.67357 5.91711 5.51101 6.1176 5.51101H7.86208C8.06258 5.51101 8.22514 5.67357 8.22514 5.87407V6.4888C8.63733 5.87022 9.2499 5.39277 10.5541 5.39277C13.4423 5.39277 13.4258 8.09105 13.4258 9.57361V12.9838Z\"\r\n        fill=\"#0077B7\"\r\n      />\r\n    </svg>\r\n  </a>\r\n);\r\n\r\nconst Mode = ({ title, page, text, button_1, button_2 }) => {\r\n  return (\r\n    <div className=\"mode\">\r\n      {/* <ToastContainer/> */}\r\n      <div className=\"landing__discount\">\r\n        <div className=\"landing__discount--container\">\r\n          <div className=\"landing__discount--img\">\r\n            <img src={lady} />\r\n          </div>\r\n          <div className=\"landing__discount--text\">\r\n            <h3>{title}</h3>\r\n            <p>{text}</p>\r\n            <div className=\"landing__btn--2\">\r\n              <a>\r\n                <div className=\"nav__btn nav__btn-flex\">\r\n                  {page == \"hire\" ? (\r\n                    <>\r\n                      <a href=\"/\" >\r\n                        <div\r\n                          className=\"nav__btn--text\"\r\n                          style={{ marginRight: \"20px\" }}\r\n                        >\r\n                          {button_1}\r\n                        </div>\r\n                      </a>\r\n\r\n                      <a href=\"/hire/contact \">\r\n                        <div className=\"nav__btn--text1\">{button_2}</div>\r\n                      </a>\r\n                    </>\r\n                  ) : (\r\n                    <>\r\n                      <a href=\"/hire\">\r\n                        <div\r\n                          className=\"nav__btn--text\"\r\n                          style={{ marginRight: \"20px\" }}\r\n                        >\r\n                          {button_1}\r\n                        </div>\r\n                      </a> \r\n                      \r\n                       {/* <p>Don't have an account? <span onClick={()=>toast.info('Application into Cohort (CH011) is closed. Enrollment into CH012 begins July 2022')}>Sign up</span></p> */}\r\n\r\n                      {/* <a\r\n                        href=\"#landing_page_mode\"\r\n                        onClick={()=>toast.info('Coming Soon')}\r\n                        className=\"nav__btn--text\"\r\n                        style={{ marginRight: \"20px\" }}\r\n                      >\r\n                        {button_1}\r\n                      </a> */}\r\n\r\n                      <a href=\"https://chat.whatsapp.com/EG62sZ8TqY198wq1vsjsXL\">\r\n                        <div className=\"nav__btn--text1\">{button_2}</div>\r\n                      </a>\r\n                    </>\r\n                  )}\r\n                </div>\r\n              </a>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default Mode;\r\n","C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\components\\Footer.js",["452","453","454","455"],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\components\\Navbar.js",["456","457","458"],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\api\\dashboard\\hire.js",["459"],"import {forHire, forHireContact} from './apikit';\r\n\r\n\r\nexport const getAllTalents = (page) => {\r\n    return forHire.get(`/hire/fetch?page=${page}`)\r\n}\r\n\r\nexport const getOneTalent = (talentId) => {\r\n    return forHire.get(`/hire/details/${talentId}`)\r\n}\r\n\r\nexport const submitContact = (payload) => {\r\n    return forHire.post(`/hire/contact`, payload)\r\n} ","C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\api\\dashboard\\auth.js",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\academy-dashboard\\component\\dashboard\\Dashboard.js",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\api\\dashboard\\data.js",["460"],"import { APIKit, AdminApiKit, AdminApi } from \"./apikit\";\r\n\r\nlet token = \"\";\r\nlet userId = 0;\r\ntry {\r\n  let details = sessionStorage.getItem(\"user_details\");\r\n  token = JSON.parse(details).token;\r\n  userId = JSON.parse(details).id;\r\n} catch (err) {\r\n  //err\r\n}\r\n\r\nexport const submitDetails = (data, id) => {\r\n  // return APIKit.put(`/user/apply/${id}`, data, {\r\n  //   headers: {\r\n  //     Authorization: `Bearer ${token}`,\r\n  //   },\r\n  // });\r\n  return APIKit.put(`/user/application-form`, data, {\r\n    headers: {\r\n      Authorization: `Bearer ${token}`,\r\n    },\r\n  });\r\n};\r\nexport const editDetails = (data, id) => {\r\n  return APIKit.put(`/user/edit-dashboard/${id}`, data, {\r\n    headers: {\r\n      Authorization: `Bearer ${token}`,\r\n    },\r\n  });\r\n};\r\n\r\nexport const getDetails = () => {\r\n  return APIKit.get(`/admin/fetchData/${userId}`, {\r\n    headers: {\r\n      Authorization: `Bearer ${token}`,\r\n    },\r\n  });\r\n};\r\n\r\nexport const getDetailsB = () => {\r\n  return AdminApiKit.get(`/fetchDataB/${userId}`, {\r\n    headers: {\r\n      Authorization: `Bearer ${token}`,\r\n    },\r\n  });\r\n};\r\nexport const getDetailsC = () => {\r\n  return APIKit.get(`/user/profile`, {\r\n    headers: {\r\n      Authorization: `Bearer ${token}`,\r\n    },\r\n  });\r\n};\r\n\r\nexport const getGuarantor = () => {\r\n  return APIKit.get(`/user/fetchGuarantorData?user_id=${userId}`, {\r\n    headers: {\r\n      Authorization: `Bearer ${token}`,\r\n    },\r\n  });\r\n};\r\n\r\nexport const editGuarantor = (data, guaID) => {\r\n  return APIKit.put(`/user/edit-gurantor/${guaID}`, data, {\r\n    headers: {\r\n      Authorization: `Bearer ${token}`,\r\n    },\r\n  });\r\n};\r\n\r\nexport const addPlan = (planData) => {\r\n  return APIKit.put(`/user/paymentPlan?id=${userId}`, planData, {\r\n    headers: {\r\n      Authorization: `Bearer ${token}`,\r\n    },\r\n  });\r\n};\r\n\r\nexport const submitGuarantor = (data) => {\r\n  return APIKit.post(\r\n    `/user/guarantorDetails?payment_plan=pay-as-you-earn`,\r\n    data,\r\n    {\r\n      headers: {\r\n        Authorization: `Bearer ${token}`,\r\n      },\r\n    }\r\n  );\r\n};\r\n\r\nexport const sendFlutterTx = (trans_id) => {\r\n  return APIKit.post(`/user/pay?transaction_id=${trans_id}`);\r\n};\r\n","C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\components\\dashboard\\Rejected.js",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\components\\dashboard\\Selected.js",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\components\\dashboard\\UnderReview.js",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\components\\dashboard\\Sidebar.js",["461"],"import { useState } from \"react\";\r\nimport { ToastContainer, toast } from \"react-toastify\";\r\nimport { Link } from \"react-router-dom\";\r\nimport Logo from \"../../images/svg/grazac-logo.svg\";\r\n\r\n\r\nfunction Sidebar({ clicked, clickedDashboard, clickedDetails, showDetails }) {\r\n\r\n  const [clickLink, setClickLink] = useState(false);\r\n\r\n  const signOut = () => {\r\n    sessionStorage.clear();\r\n    toast.info(\"Signing out ...\");\r\n    setTimeout(function () {\r\n      window.location = \"/dashboard\";\r\n    }, 2500);\r\n  };\r\n  \r\n\r\n  return (\r\n    <div className=\"sidebar\">\r\n      <ToastContainer closeButton={false} />\r\n      <Link to=\"/\">\r\n        <img src={Logo} alt=\"logo\" className=\"logo\" />\r\n      </Link>\r\n      <div className=\"sidebar-portal\">\r\n        <p className=\"sidebar-portal-heading\">PORTAL</p>\r\n        <div\r\n          className={\r\n            clicked === \"dashboard\" ? \"active\" : \"sidebar-portal-links\"\r\n          }\r\n          onClick={() => clickedDashboard(\"dashboard\")}\r\n        >\r\n          <svg\r\n            width=\"19\"\r\n            height=\"19\"\r\n            viewBox=\"0 0 19 19\"\r\n            fill=\"none\"\r\n            xmlns=\"http://www.w3.org/2000/svg\"\r\n          >\r\n            <path\r\n              d=\"M18.5 18.0003C18.5 18.2655 18.3946 18.5198 18.2071 18.7074C18.0196 18.8949 17.7652 19.0003 17.5 19.0003H1.5C1.23478 19.0003 0.98043 18.8949 0.792893 18.7074C0.605357 18.5198 0.5 18.2655 0.5 18.0003V7.49027C0.499895 7.33788 0.534617 7.18749 0.601516 7.05057C0.668415 6.91365 0.76572 6.79384 0.886 6.70027L8.886 0.478272C9.06154 0.341717 9.2776 0.267578 9.5 0.267578C9.7224 0.267578 9.93846 0.341717 10.114 0.478272L18.114 6.70027C18.2343 6.79384 18.3316 6.91365 18.3985 7.05057C18.4654 7.18749 18.5001 7.33788 18.5 7.49027V18.0003ZM4.5 13.0003V15.0003H14.5V13.0003H4.5Z\"\r\n              fill=\"#787676\"\r\n            />\r\n          </svg>\r\n          <p onClick={() => setClickLink(!clickLink)}>Dashboard</p>\r\n\r\n       \r\n\r\n        </div>\r\n        {showDetails != \"Not Submitted\" && (\r\n          <div\r\n            className={\r\n              clicked === \"details\" ? \"active\" : \"sidebar-portal-links\"\r\n            }\r\n            onClick={() => clickedDetails(\"details\")}\r\n          >\r\n            <svg\r\n              width=\"21\"\r\n              height=\"20\"\r\n              viewBox=\"0 0 21 20\"\r\n              fill=\"none\"\r\n              xmlns=\"http://www.w3.org/2000/svg\"\r\n            >\r\n              <path\r\n                d=\"M10.5 20C4.977 20 0.5 15.523 0.5 10C0.5 4.477 4.977 0 10.5 0C16.023 0 20.5 4.477 20.5 10C20.5 15.523 16.023 20 10.5 20ZM9.5 9V15H11.5V9H9.5ZM9.5 5V7H11.5V5H9.5Z\"\r\n                fill=\"#787676\"\r\n              />\r\n            </svg>\r\n            <p>Details</p>\r\n          </div>\r\n        )}\r\n        <div className=\"sidebar-portal-links signout\" onClick={signOut}>\r\n          <svg\r\n            width=\"20\"\r\n            height=\"20\"\r\n            viewBox=\"0 0 20 20\"\r\n            fill=\"none\"\r\n            xmlns=\"http://www.w3.org/2000/svg\"\r\n          >\r\n            <path\r\n              d=\"M10 20C4.477 20 0 15.523 0 10C0 4.477 4.477 0 10 0C15.523 0 20 4.477 20 10C20 15.523 15.523 20 10 20ZM5 9V6L0 10L5 14V11H13V9H5Z\"\r\n              fill=\"#909198\"\r\n            />\r\n          </svg>\r\n          <p>Sign Out</p>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default Sidebar;\r\n","C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\components\\dashboard\\selected\\PaymentReceived.js",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\academy-dashboard\\pages\\challenge\\ChallengeDetail.jsx",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\components\\dashboard\\Details.js",["462","463","464","465","466","467","468","469","470","471","472","473"],"import { useEffect, useState } from \"react\";\r\nimport { ToastContainer, toast } from \"react-toastify\";\r\nimport {\r\n  getGuarantor,\r\n  getDetailsB,\r\n  getDetailsC,\r\n  editDetails,\r\n} from \"../../api/dashboard/data\";\r\nimport axios from \"axios\";\r\n\r\n// import Loader from \"../Loader\";\r\n\r\nimport loader from \"../../images/loader-purple.gif\";\r\nimport btn_loader from \"../../images/svg/dashboard/loader.gif\";\r\nfunction Details() {\r\n  const [userId, setUserId] = useState(0);\r\n\r\n  const [isLoading, setIsLoading] = useState(false);\r\n  const [userDetails, setUserDetails] = useState({});\r\n  const [guarantorDetails_1, setGuarantorDetails_1] = useState([]);\r\n  const [guarantorDetails_2, setGuarantorDetails_2] = useState([]);\r\n  const [guarantorId_1, setGuarantorId_1] = useState(0);\r\n  const [guarantorId_2, setGuarantorId_2] = useState(0);\r\n  const [submitted, setSubmitted] = useState(true);\r\n\r\n  const [clicked, setClicked] = useState();\r\n  const [accepted, setAccepted] = useState(false);\r\n  const [tempData, setTemData] = useState(null);\r\n\r\n  useEffect(() => {\r\n    try {\r\n      let details = sessionStorage.getItem(\"user_details\");\r\n      setUserId(JSON.parse(details).id);\r\n      setAccepted(JSON.parse(details).applicationFee);\r\n\r\n      if (JSON.parse(details).applicationFee) {\r\n        setClicked(\"bio\");\r\n      }\r\n    } catch (err) {}\r\n    // setBioData(userDetails)\r\n  }, []);\r\n\r\n  useEffect(() => {\r\n    //remove the submit button if there is data for agerange have kids and marital status\r\n    {\r\n      !userDetails?.ageRange &&\r\n      !userDetails?.haveKids &&\r\n      !userDetails?.maritalStatus\r\n        ? setSubmitted(true)\r\n        : setSubmitted(false);\r\n    }\r\n  }, []);\r\n\r\n  const submitData = (e) => {\r\n    e.preventDefault();\r\n    var btn = document.getElementById(\"actionBtn\");\r\n    btn.innerHTML = `<img src=${btn_loader} width=\"20px\" />`;\r\n\r\n    var data = new FormData();\r\n\r\n    data.append(\"maritalStatus\", userDetails?.maritalStatus);\r\n    data.append(\"haveKids\", userDetails?.haveKids);\r\n    data.append(\"ageRange\", userDetails?.ageRange);\r\n\r\n    data.append(\"dob\", userDetails.dob);\r\n\r\n    data.append(\"gender\", userDetails.gender);\r\n    data.append(\"preferred_course\", userDetails.preferred_course);\r\n    data.append(\"state_of_residence\", userDetails.state_of_residence);\r\n    data.append(\r\n      \"current_city_and_location\",\r\n      userDetails.current_city_and_location\r\n    );\r\n    // data.append(\"means_of_identification\", bioData.id);\r\n\r\n    editDetails(data, userId)\r\n      .then((response) => response.data)\r\n      .then((res) => {\r\n        if (res.status == 201) {\r\n          toast.success(\"Submission successful!\");\r\n          btn.innerHTML = `Submit`;\r\n\r\n          setSubmitted(false);\r\n\r\n          window.location = \"/dashboard\";\r\n        } else {\r\n          toast.error(\"Submission not successful, try again!!!\");\r\n          btn.innerHTML = `Submit`;\r\n        }\r\n      })\r\n\r\n      .catch((err) => {\r\n        if (err.response.data === \"File size limit has been reached\") {\r\n          toast.error(\"File size exceeded for Means of Identification Field\");\r\n        }\r\n        if (err.response) {\r\n          toast.error(err.response);\r\n          btn.innerHTML = `Submit`;\r\n        } else {\r\n          toast.error(\r\n            \"Something went wrong!!! Please make sure you have a good internet connection.\"\r\n          );\r\n          btn.innerHTML = `Submit`;\r\n        }\r\n      });\r\n  };\r\n\r\n  const userImage = `https://api.grazacacademy.com/uploads/${userDetails.means_of_identification}`;\r\n\r\n  const handleChange_1 = (e) => {\r\n    let guarantorData = [...guarantorDetails_1][0];\r\n    guarantorData[e.target.name] = e.target.value;\r\n\r\n    setGuarantorDetails_1([guarantorData]);\r\n    setGuarantorId_1(guarantorDetails_1[0].id);\r\n  };\r\n\r\n  const handleChange_2 = (e) => {\r\n    let guarantorData = [...guarantorDetails_2][0];\r\n    guarantorData[e.target.name] = e.target.value;\r\n\r\n    setGuarantorDetails_2([guarantorData]);\r\n    // setGuarantorId_1(guarantorDetails_1[0]?.id);\r\n    setGuarantorId_2(guarantorDetails_2[0].id);\r\n  };\r\n\r\n  const handleDataChange = (e) => {\r\n    if (\r\n      e.target.value != \"\" ||\r\n      e.target.value != undefined ||\r\n      !e.target.value\r\n    ) {\r\n      let userData = { ...userDetails };\r\n\r\n      setUserDetails({\r\n        ...userData,\r\n        [e.target.name]: e.target.value,\r\n      });\r\n    }\r\n  };\r\n\r\n  const SubmitGuarantorChange_1 = (e) => {\r\n    e.preventDefault();\r\n\r\n    const data = guarantorDetails_1;\r\n    const final_data = [];\r\n    const new_data_1 = {};\r\n\r\n    for (let index = 0; index < data.length; index++) {\r\n      new_data_1[\"firstname\"] = data[0][\"firstname\"];\r\n      new_data_1[\"lastname\"] = data[0][\"lastname\"];\r\n      new_data_1[\"email\"] = data[0][\"email\"];\r\n      new_data_1[\"phone_number\"] = data[0][\"phone_number\"];\r\n      new_data_1[\"gender\"] = data[0][\"gender\"];\r\n      new_data_1[\"office_address\"] = data[0][\"office_address\"];\r\n      new_data_1[\"home_address\"] = data[0][\"home_address\"];\r\n      new_data_1[\"profession\"] = data[0][\"profession\"];\r\n      new_data_1[\"name_of_organization\"] = data[0][\"name_of_organization\"];\r\n      new_data_1[\"name_of_employer\"] = data[0][\"name_of_employer\"];\r\n      new_data_1[\"email_address_of_employer\"] =\r\n        data[0][\"email_address_of_employer\"];\r\n      new_data_1[\"phone_number_of_employer\"] =\r\n        data[0][\"phone_number_of_employer\"];\r\n      new_data_1[\"relationship_with_the_guarantor\"] =\r\n        data[0][\"relationship_with_the_guarantor\"];\r\n      new_data_1[\"user_id\"] = data[0][\"user_id\"];\r\n    }\r\n\r\n    axios\r\n      .put(\r\n        `https://api.grazacacademy.com/api/v1/user/edit-gurantor/${guarantorId_1}`,\r\n        new_data_1\r\n      )\r\n      .then(function (response) {\r\n        toast.success(\"saved successfully\");\r\n      })\r\n      .catch((res) => {});\r\n\r\n    // editGuarantor(final_data, guaID)\r\n    // .then((res) =>{\r\n    //   toast.success(res.data)}\r\n    // )\r\n    // .catch((res) => {\r\n    //   toast.error(res.response)\r\n    // })\r\n  };\r\n\r\n  const SubmitGuarantorChange_2 = (e) => {\r\n    e.preventDefault();\r\n\r\n    const data = guarantorDetails_2;\r\n    const new_data_1 = {};\r\n\r\n    for (let index = 0; index < data.length; index++) {\r\n      new_data_1[\"firstname\"] = data[0][\"firstname\"];\r\n      new_data_1[\"lastname\"] = data[0][\"lastname\"];\r\n      new_data_1[\"email\"] = data[0][\"email\"];\r\n      new_data_1[\"phone_number\"] = data[0][\"phone_number\"];\r\n      new_data_1[\"gender\"] = data[0][\"gender\"];\r\n      new_data_1[\"office_address\"] = data[0][\"office_address\"];\r\n      new_data_1[\"home_address\"] = data[0][\"home_address\"];\r\n      new_data_1[\"profession\"] = data[0][\"profession\"];\r\n      new_data_1[\"name_of_organization\"] = data[0][\"name_of_organization\"];\r\n      new_data_1[\"name_of_employer\"] = data[0][\"name_of_employer\"];\r\n      new_data_1[\"email_address_of_employer\"] =\r\n        data[0][\"email_address_of_employer\"];\r\n      new_data_1[\"phone_number_of_employer\"] =\r\n        data[0][\"phone_number_of_employer\"];\r\n      new_data_1[\"relationship_with_the_guarantor\"] =\r\n        data[0][\"relationship_with_the_guarantor\"];\r\n      new_data_1[\"user_id\"] = data[0][\"user_id\"];\r\n    }\r\n\r\n    setIsLoading(true);\r\n    axios\r\n      .put(\r\n        `https://api.grazacacademy.com/api/v1/user/edit-gurantor/${guarantorId_2}`,\r\n        new_data_1\r\n      )\r\n      .then(function (response) {\r\n        toast.success(\"saving\");\r\n        setTimeout(() => {\r\n          toast.success(\"saved Successfully\");\r\n        }, 5000);\r\n        toast.success(\"saved Successfully\");\r\n        setIsLoading(false);\r\n      })\r\n      .catch((res) => {});\r\n  };\r\n\r\n  const handleWhatToShow = (value) => {\r\n    if (accepted) {\r\n      setClicked(value);\r\n    }\r\n  };\r\n\r\n  useEffect(() => {\r\n    getDetailsC()\r\n      .then((res) => {\r\n       \r\n        setIsLoading(true);\r\n        setUserDetails(res.data[\"data\"][\"result\"][0]);\r\n        setTemData(res.data[\"data\"][\"result\"][0]);\r\n        setIsLoading(false);\r\n      })\r\n      .catch((err) => {\r\n        if (err.response) {\r\n          toast.error(err.response);\r\n        } else {\r\n          toast.error(\r\n            \"Something went wrong!!! Please make sure you have a good internet connection.\"\r\n          );\r\n        }\r\n      });\r\n\r\n    getGuarantor()\r\n      .then((response) => response.data)\r\n      .then((res) => {\r\n        setGuarantorDetails_1([res.data[0]]);\r\n        setGuarantorDetails_2([res.data[1]]);\r\n        // setGuarantorId(res.data[0][\"id\"]);\r\n      })\r\n      .catch((err) => {\r\n        if (err.response) {\r\n          toast.error(err.response);\r\n        } else {\r\n          toast.error(\r\n            \"Something went wrong!!! Please make sure you have a good internet connection.\"\r\n          );\r\n        }\r\n      });\r\n  }, [true]);\r\n\r\n  return (\r\n    <div className=\"dashboard-content\">\r\n      {Object.keys(userDetails).length === 0 ? (\r\n        <div>\r\n          <img\r\n            style={{ marginLeft: \"30rem\", marginTop: \"20rem\" }}\r\n            src={loader}\r\n          />\r\n        </div>\r\n      ) : (\r\n        <div>\r\n          <ToastContainer />\r\n          <h3 style={{ marginLeft: \"20px\", marginBottom: \"20px\" }}>Details</h3>\r\n          <div className=\"det-btn-container\">\r\n            <div className=\"dashboard-content-detail\">\r\n              <button\r\n                className={\r\n                  clicked === \"bio\"\r\n                    ? \"dashboard-content-detail-p active\"\r\n                    : \"dashboard-content-detail-p\"\r\n                }\r\n                onClick={() => handleWhatToShow(\"bio\")}\r\n              >\r\n                Bio Data\r\n              </button>\r\n              <button\r\n                className={\r\n                  clicked === \"edu\"\r\n                    ? \"dashboard-content-detail-p active\"\r\n                    : \"dashboard-content-detail-p\"\r\n                }\r\n                onClick={() => handleWhatToShow(\"edu\")}\r\n              >\r\n                Educational Background\r\n              </button>\r\n\r\n              {userDetails.payment_plan === \"pay as you earn\" && (\r\n                <button\r\n                  className={\r\n                    clicked === \"gua\"\r\n                      ? \"dashboard-content-detail-p active\"\r\n                      : \"dashboard-content-detail-p\"\r\n                  }\r\n                  onClick={() => handleWhatToShow(\"gua\")}\r\n                >\r\n                  Guarantor Data\r\n                </button>\r\n              )}\r\n            </div>\r\n          </div>\r\n\r\n          {clicked === \"bio\" && (\r\n            <div className=\"dashboard-content-form\">\r\n              <form onSubmit={(e) => submitData(e)}>\r\n                <div className=\"dashboard-content-form-container\">\r\n                  <h5>First Name</h5>\r\n                  <p>{userDetails?.firstName}</p>\r\n                </div>\r\n                <hr />\r\n                <div className=\"dashboard-content-form-container\">\r\n                  <h5>Last Name</h5>\r\n                  <p>{userDetails?.lastName}</p>\r\n                </div>\r\n                <hr />\r\n                <div className=\"dashboard-content-form-container\">\r\n                  <h5>Email Address</h5>\r\n                  <p>{userDetails?.email}</p>\r\n                </div>\r\n\r\n                <hr />\r\n                <div className=\"dashboard-content-form-container\">\r\n                  <h5>Phone Number</h5>\r\n                  <p>{userDetails?.phoneNumber}</p>\r\n                </div>\r\n                <hr />\r\n                <div className=\"dashboard-content-form-container\">\r\n                  <h5>Date of Birth</h5>\r\n                  <p>{userDetails?.dob?.slice(0, 10)}</p>\r\n                </div>\r\n                <hr />\r\n                <div className=\"dashboard-content-form-container\">\r\n                  <h5>Gender</h5>\r\n                  <p>{userDetails?.gender}</p>\r\n                </div>\r\n\r\n                <hr />\r\n                <div className=\"dashboard-content-form-container\">\r\n                  <h5>Preferred course at Grazac</h5>\r\n                  <p>{userDetails?.preferred_course}</p>\r\n                </div>\r\n                <hr />\r\n                <div className=\"dashboard-content-form-container\">\r\n                  <h5>State of residence</h5>\r\n                  <p>{userDetails?.state_of_residence}</p>\r\n                </div>\r\n                <hr />\r\n                <div className=\"dashboard-content-form-container\">\r\n                  <h5>Current city and Location</h5>\r\n                  <p>{userDetails?.current_city_and_location}</p>\r\n                </div>\r\n                {/* <hr /> */}\r\n                {/* <div className=\"dashboard-content-form-container\">\r\n                  <h5>Means of Identification (NIN/ Voter's Card)</h5>\r\n                  <img\r\n                    className=\"dashboard-content-form-container-image\"\r\n                    src={userImage}\r\n                    alt={userDetails.means_of_identification}\r\n                  />\r\n                </div> */}\r\n\r\n                {(!userDetails?.ageRange ||\r\n                  !userDetails?.haveKids ||\r\n                  !userDetails?.maritalStatus) && (\r\n                  <>\r\n                    <hr />\r\n                    <h3>Edit Data</h3>\r\n                  </>\r\n                )}\r\n\r\n                <hr />\r\n                <div className=\"dashboard-content-form-container\">\r\n                  <h5>Marital Status</h5>\r\n                  {userDetails?.maritalStatus ? (\r\n                    <p>{userDetails?.maritalStatus}</p>\r\n                  ) : (\r\n                    <select\r\n                      name=\"maritalStatus\"\r\n                      required\r\n                      value={userDetails?.maritalStatus}\r\n                      onChange={handleDataChange}\r\n                    >\r\n                      <option value=\"\">Select an option</option>\r\n                      <option value=\"single\">Single</option>\r\n                      <option value=\"married\">Married</option>\r\n                    </select>\r\n                  )}\r\n                </div>\r\n\r\n                <hr />\r\n                <div className=\"dashboard-content-form-container\">\r\n                  <h5>Have Kids?</h5>\r\n                  {userDetails?.haveKids ? (\r\n                    <p>{userDetails?.haveKids}</p>\r\n                  ) : (\r\n                    <select\r\n                      name=\"haveKids\"\r\n                      required\r\n                      value={userDetails?.haveKids}\r\n                      onChange={handleDataChange}\r\n                    >\r\n                      <option value=\"\">Select an option</option>\r\n                      <option value=\"yes\">Yes</option>\r\n                      <option value=\"no\">No</option>\r\n                    </select>\r\n                  )}\r\n                </div>\r\n\r\n                <hr />\r\n\r\n                <div className=\"dashboard-content-form-container\">\r\n                  <h5>Age Range</h5>\r\n                  {userDetails?.ageRange ? (\r\n                    <p>{userDetails?.ageRange}</p>\r\n                  ) : (\r\n                    <select\r\n                      name=\"ageRange\"\r\n                      required\r\n                      value={userDetails?.ageRange}\r\n                      onChange={handleDataChange}\r\n                    >\r\n                      <option value=\"\">Select an option</option>\r\n                      <option value=\"18 - 24\">18 - 24</option>\r\n                      <option value=\"25 - 30\">25 - 30</option>\r\n                      <option value=\"31 - 35\">31 - 35</option>\r\n                      <option value=\"36 and above\">36 and above</option>\r\n                    </select>\r\n                  )}\r\n                  {!(\r\n                    tempData?.ageRange &&\r\n                    tempData?.maritalStatus &&\r\n                    tempData?.haveKids\r\n                  ) && (\r\n                    <button id=\"actionBtn\" type=\"submit\">\r\n                      Save\r\n                    </button>\r\n                  )}\r\n\r\n                  {/* {(!userDetails?.ageRange ||\r\n                    !userDetails?.haveKids ||\r\n                    !userDetails?.maritalStatus ||\r\n                    submitted) && (\r\n                    <button id=\"actionBtn\" type=\"submit\">\r\n                      Save\r\n                    </button>\r\n                  )} */}\r\n                </div>\r\n              </form>\r\n            </div>\r\n          )}\r\n\r\n          {clicked === \"edu\" && (\r\n            <div className=\"dashboard-content-form\">\r\n              <form>\r\n                <div className=\"dashboard-content-form-container\">\r\n                  <h5>Course of Study</h5>\r\n                  <p>{userDetails?.course_of_study}</p>\r\n                </div>\r\n                <hr />\r\n                <div className=\"dashboard-content-form-container\">\r\n                  <h5>Grade Achieved</h5>\r\n                  <p>{userDetails?.grade_achieved}</p>\r\n                </div>\r\n                <hr />\r\n                <div className=\"dashboard-content-form-container\">\r\n                  <h5>Qualifications</h5>\r\n                  <p>{userDetails?.qualifications}</p>\r\n                </div>\r\n                <hr />\r\n                <div className=\"dashboard-content-form-container\">\r\n                  <h5>Programming / Design Experience</h5>\r\n                  <p>{userDetails?.programming_skills}</p>\r\n                </div>\r\n                <hr />\r\n                <div className=\"dashboard-content-form-container\">\r\n                  <h5>NYSC Status</h5>\r\n                  <p>{userDetails?.nysc_status}</p>\r\n                </div>\r\n                <hr />\r\n                <div className=\"dashboard-content-form-container\">\r\n                  <h5>\r\n                    Why do you think you should be selected as a part of this\r\n                    cohort?\r\n                  </h5>\r\n                  <p>{userDetails?.why_selected_for_cohort}</p>\r\n                </div>\r\n                <hr />\r\n                <div className=\"dashboard-content-form-container\">\r\n                  <h5>\r\n                    Will you be physically available for the next 6 months?\r\n                  </h5>\r\n                  <p>{userDetails?.will_you_pay_legal_fees}</p>\r\n                </div>\r\n                <hr />\r\n                <div className=\"dashboard-content-form-container\">\r\n                  <h5>\r\n                    If selected, will you be able to pay the legal fees of\r\n                    #50,000?\r\n                  </h5>\r\n                  <p>{userDetails?.physically_available}</p>\r\n                </div>\r\n              </form>\r\n            </div>\r\n          )}\r\n          {clicked === \"gua\" && (\r\n            <div className=\"dashboard-content-form\">\r\n              <form\r\n                onSubmit={(e) => {\r\n                  SubmitGuarantorChange_1(e);\r\n                  setGuarantorId_1(guarantorDetails_1[0]?.id);\r\n                }}\r\n              >\r\n                <h4>Guarantor details 1</h4>\r\n                <div\r\n                  className=\"dashboard-content-form-container\"\r\n                  id={guarantorDetails_1[0]?.id}\r\n                >\r\n                  <h5>First Name</h5>\r\n\r\n                  <input\r\n                    type=\"text\"\r\n                    name=\"firstname\"\r\n                    value={guarantorDetails_1[0]?.firstname}\r\n                    onChange={(e) => handleChange_1(e)}\r\n                  />\r\n                </div>\r\n                <hr />\r\n                <div className=\"dashboard-content-form-container\">\r\n                  <h5>Last Name</h5>\r\n                  {/* <p>{guarantorDetails_1[0]?.lastname}</p> */}\r\n                  <input\r\n                    type=\"text\"\r\n                    name=\"lastname\"\r\n                    value={guarantorDetails_1[0]?.lastname}\r\n                    onChange={(e) => handleChange_1(e)}\r\n                  />\r\n                </div>\r\n                <hr />\r\n                <div className=\"dashboard-content-form-container\">\r\n                  <h5>Email Address</h5>\r\n                  {/* <p>{guarantorDetails_1[0]?.email}</p> */}\r\n                  <input\r\n                    type=\"text\"\r\n                    name=\"email\"\r\n                    value={guarantorDetails_1[0]?.email}\r\n                    onChange={(e) => handleChange_1(e)}\r\n                  />\r\n                </div>\r\n                <hr />\r\n                <div className=\"dashboard-content-form-container\">\r\n                  <h5>Phone Number</h5>\r\n                  {/* <p>{guarantorDetails_1[0]?.phone_number}</p> */}\r\n                  <input\r\n                    type=\"text\"\r\n                    name=\"phone_number\"\r\n                    value={guarantorDetails_1[0]?.phone_number}\r\n                    onChange={(e) => handleChange_1(e)}\r\n                  />\r\n                </div>\r\n                <hr />\r\n                <div className=\"dashboard-content-form-container\">\r\n                  <h5>Gender</h5>\r\n                  {/* <p>{guarantorDetails_1[0]?.gender}</p> */}\r\n                  <input\r\n                    type=\"text\"\r\n                    name=\"gender\"\r\n                    value={guarantorDetails_1[0]?.gender}\r\n                    onChange={(e) => handleChange_1(e)}\r\n                  />\r\n                </div>\r\n                <hr />\r\n                <div className=\"dashboard-content-form-container\">\r\n                  <h5>Office Address</h5>\r\n                  {/* <p>{guarantorDetails_1[0]?.office_address}</p> */}\r\n                  <input\r\n                    type=\"text\"\r\n                    name=\"office_address\"\r\n                    value={guarantorDetails_1[0]?.office_address}\r\n                    onChange={(e) => handleChange_1(e)}\r\n                  />\r\n                </div>\r\n                <hr />\r\n                <div className=\"dashboard-content-form-container\">\r\n                  <h5>Home Address</h5>\r\n                  {/* <p>{guarantorDetails_1[0]?.home_address}</p> */}\r\n                  <input\r\n                    type=\"text\"\r\n                    name=\"home_address\"\r\n                    value={guarantorDetails_1[0]?.home_address}\r\n                    onChange={(e) => handleChange_1(e)}\r\n                  />\r\n                </div>\r\n                <hr />\r\n                <div className=\"dashboard-content-form-container\">\r\n                  <h5>Profession</h5>\r\n                  {/* <p>{guarantorDetails_1[0]?.profession}</p> */}\r\n                  <input\r\n                    type=\"text\"\r\n                    name=\"profession\"\r\n                    value={guarantorDetails_1[0]?.profession}\r\n                    onChange={(e) => handleChange_1(e)}\r\n                  />\r\n                </div>\r\n                <hr />\r\n                <div className=\"dashboard-content-form-container\">\r\n                  <h5>Name of Organization</h5>\r\n                  {/* <p>{guarantorDetails_1[0]?.name_of_organization}</p> */}\r\n                  <input\r\n                    type=\"text\"\r\n                    name=\"name_of_organization\"\r\n                    value={guarantorDetails_1[0]?.name_of_organization}\r\n                    onChange={(e) => handleChange_1(e)}\r\n                  />\r\n                </div>\r\n                <hr />\r\n                <div className=\"dashboard-content-form-container\">\r\n                  <h5>Relationship with guarantor</h5>\r\n                  {/* <p>{guarantorDetails_1[0]?.name_of_employer}</p> */}\r\n                  <input\r\n                    type=\"text\"\r\n                    name=\"name_of_employer\"\r\n                    value={guarantorDetails_1[0]?.name_of_employer}\r\n                    onChange={(e) => handleChange_1(e)}\r\n                  />\r\n                </div>\r\n                <hr />\r\n                <div className=\"dashboard-content-form-container\">\r\n                  <h5>Email Address of Employer</h5>\r\n                  {/* <p>{guarantorDetails_1[0]?.email_address_of_employer}</p> */}\r\n                  <input\r\n                    type=\"text\"\r\n                    name=\"email_address_of_employer\"\r\n                    value={guarantorDetails_1[0]?.email_address_of_employer}\r\n                    onChange={(e) => handleChange_1(e)}\r\n                  />\r\n                </div>