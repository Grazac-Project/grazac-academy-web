 15C27.5 8.12 21.9112 2.5225 15.035 2.5025C15.03 2.5025 15.025 2.50125 15.0188 2.50125C15.0138 2.50125 15.0063 2.5 15 2.5C8.1075 2.5 2.5 8.10875 2.5 15C2.5 21.8925 8.1075 27.5 15 27.5C15.0075 27.5 15.0138 27.4988 15.0188 27.4988C15.0213 27.4988 15.0225 27.5 15.025 27.5C15.0288 27.5 15.0325 27.4975 15.035 27.4975C21.9112 27.4788 27.5 21.88 27.5 15Z\" fill=\"#773DD3\"/>\r\n                                            <mask id=\"mask0\" mask-type=\"alpha\" maskUnits=\"userSpaceOnUse\" x=\"2\" y=\"2\" width=\"26\" height=\"26\">\r\n                                            <path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M18.2695 24.44C19.5808 22.5675 20.9445 19.8138 21.217 16.25H24.9108C24.432 20.065 21.7995 23.2125 18.2695 24.44ZM5.08612 16.2498H8.82612C9.08362 19.8273 10.4299 22.5698 11.7586 24.4511C8.21237 23.2298 5.56737 20.0761 5.08612 16.2498ZM11.7972 5.53516C10.4822 7.40766 9.10594 10.1702 8.83094 13.7489H5.08594C5.56844 9.90891 8.23219 6.74516 11.7972 5.53516ZM11.3477 13.7498C11.7302 9.65984 13.8227 6.81234 15.0314 5.49609C16.2814 6.83484 18.3414 9.65609 18.6977 13.7498H11.3477ZM11.3516 16.25H18.7041C18.3216 20.3462 16.2241 23.1937 15.0166 24.51C13.7078 23.1225 11.7003 20.34 11.3516 16.25ZM24.9125 13.7519H21.2225C20.9662 10.1906 19.635 7.45688 18.3125 5.57812C21.8225 6.81563 24.4362 9.95188 24.9125 13.7519ZM27.5 15C27.5 8.12 21.9112 2.5225 15.035 2.5025C15.03 2.5025 15.025 2.50125 15.0188 2.50125C15.0138 2.50125 15.0063 2.5 15 2.5C8.1075 2.5 2.5 8.10875 2.5 15C2.5 21.8925 8.1075 27.5 15 27.5C15.0075 27.5 15.0138 27.4988 15.0188 27.4988C15.0213 27.4988 15.0225 27.5 15.025 27.5C15.0288 27.5 15.0325 27.4975 15.035 27.4975C21.9112 27.4788 27.5 21.88 27.5 15Z\" fill=\"white\"/>\r\n                                            </mask>\r\n                                        </svg>\r\n                                    </div>\r\n                                    <h3>Job Placement</h3>\r\n                                    <p>Enter the recruitment process with tech companies and take a stride into your dream career. </p>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"background1\" id=\"courses\">\r\n                    <div className=\"container\">\r\n                        <div className=\"gga\">\r\n                            <div className=\"course_mode-intro course_mode-intro\">\r\n                                <h2>Available Courses</h2>\r\n                            </div>\r\n                            <div className=\"gga_container\">\r\n                                {courses.map((item,index) => (\r\n                                <div className=\"boxes33\" key={index}>\r\n                                    <div className=\"gua_cardview\">\r\n                                        <div className=\"gua_cardview-box\">\r\n                                            <img src={item.thumb} alt=\"course-desc\" />\r\n                                        </div>\r\n                                        <div className=\"gua_cardview-text\">\r\n                                            <h4>{item.name}</h4>\r\n                                            <p>{item.description}</p>\r\n                                            <Link to={\"/course-detail-graduate?course=\"+item.slug}><a>Learn More</a></Link>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                                ))}\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <Qualities />\r\n                <NeedAdvice />\r\n            </div>\r\n            <Footer/>\r\n        </div>\r\n    );\r\n}\r\n\r\nexport default GraduateAccelerator;","C:\\Users\\Toheeb\\Grazac Repo\\grazac-academy-web\\src\\pages\\GraduateForm.js",["129"],"import Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\n\r\n\r\nconst GraduateForm = () => {\r\n    return(\r\n        <div>\r\n            <Navbar/>\r\n            <div style={{marginTop:'80px'}}>\r\n                <iframe src=\"https://docs.google.com/forms/d/e/1FAIpQLSf2SxwbUFzTJhTduhDyAChgdVRToMYjQI-q5PNt8v1FKPMfBA/viewform\" width=\"100%\" height=\"2000px\"></iframe>\r\n            </div>\r\n            <Footer/>\r\n        </div>\r\n    )\r\n}\r\n\r\nexport default GraduateForm;","C:\\Users\\Toheeb\\Grazac Repo\\grazac-academy-web\\src\\pages\\LeadForm.js",["130"],"import Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\n\r\n\r\nconst LeadForm = () => {\r\n    return(\r\n        <div>\r\n            <Navbar/>\r\n            <div style={{marginTop:'80px'}}>\r\n                <iframe src=\"https://docs.google.com/forms/d/e/1FAIpQLSdRIZdhpwVGfnynf6v14c5G6kPtWGnlZx1PmtBfBMsXfw400A/viewform?usp=send_form\" width=\"100%\" height=\"2000px\"></iframe>\r\n            </div>\r\n            <Footer/>\r\n        </div>\r\n    )\r\n}\r\n\r\nexport default LeadForm;","C:\\Users\\Toheeb\\Grazac Repo\\grazac-academy-web\\src\\pages\\UndergraduateAccelerator.js",["131","132","133"],"import React, {useState} from \"react\";\r\nimport {Link} from \"react-router-dom\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport NeedAdvice from \"../components/NeedAdvice\";\r\nimport Qualities from \"../components/Qualities\";\r\n\r\nimport undergraduate from \"../images/undergraduate.png\";\r\n\r\nconst UndergraduateAccelerator = () => {\r\n    const [courses, setCourses] = useState([]);\r\n\r\n    React.useEffect(() => {\r\n        document.title = 'Undergraduate Accelerator Track - Grazac Academy';\r\n        window.scrollTo(0,0);\r\n        fetch('https://grazacacademy.com/courses/undergraduate',)\r\n            .then(resp => resp.json())\r\n            .then(resp => {\r\n                setCourses(resp.data);\r\n            })\r\n            .catch(error => {\r\n                alert('An error occured')\r\n            })\r\n    }, []);\r\n\r\n    return(\r\n        <div>\r\n            <div className=\"gua\">\r\n                <div className=\"gua_hero\">\r\n                        <Navbar/>\r\n                    <div className=\"container\">\r\n                        <div className=\"row\">\r\n                            <div className=\"col-sm-6\">\r\n                                <div className=\"gua_hero-text\">\r\n                                    <div className=\"gua_hero-text-b\">\r\n                                        <h1>\r\n                                            Undergraduate Accelerator Plan\r\n                                        </h1>\r\n                                        <p>We equip you to be an asset in the digital age before leaving the four walls of school and we believe the future of work will be strictly skill-based. Join thousands of young undergraduates to build a career in technology and be mentored by industry experts.\r\n                                        </p>\r\n                                        <div className=\"contact_hero-privacy\" >\r\n                                            <a href=\"#courses\"><button>Join Us Today!</button></a>\r\n                                            <Link to=\"/lead\"><button>Apply as student Lead</button></Link>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div>\r\n                                <img src={undergraduate} alt=\"undergraduate\"  className=\"gua_hero-image\" />\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"container\">\r\n                    <div className=\"gga\">\r\n                        <div className=\"course_mode-intro course_mode-intro\">\r\n                            <h4 style={{marginTop:'100px'}}>We are preparing you for the future of work</h4>\r\n                            <h2>Join our community</h2>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"gua_highlight\">\r\n                        <div className=\"boxes44 gua_highlight-box1\">\r\n                            <div className=\"gua_highlight-box3\">\r\n                                <div className=\"gua_highlight-box4\">\r\n                                    <h3><strong>Student Lead</strong></h3>\r\n                                    <p>Become our ambassador in your institution. </p>\r\n                                    <p>Lead other students who are ready to prepare themselves for the future of work.</p>\r\n                                    <Link to=\"/lead\"><a className=\"white-link\">Apply as Student Lead</a></Link>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                        <div className=\"boxes44 gua_highlight-box2\">\r\n                            <div  className=\"gua_highlight-box3\">\r\n                                <div className=\"gua_highlight-box4\">\r\n                                    <h3><strong>Affiliated Campuses</strong></h3>\r\n                                    <p>We are well represented in various institutions of learning across Nigeria.</p>\r\n                                    <p>We want to prepare you for the future of work before you leave the four walls of learning.</p>\r\n                                    <a className=\"white-link\">Learn More</a>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"background1\" id=\"courses\">\r\n                    <div className=\"container\">\r\n                        <div className=\"gga\">\r\n                            <div className=\"course_mode-intro course_mode-intro\">\r\n                                <h2>Available Courses</h2>\r\n                            </div>\r\n                            <div className=\"gga_container\">\r\n                                {courses.map((item,index) => (\r\n                                <div className=\"boxes33\" key={index}>\r\n                                    <div className=\"gua_cardview\">\r\n                                        <div className=\"gua_cardview-box\">\r\n                                            <img src={item.thumb} alt=\"course-desc\" />\r\n                                        </div>\r\n                                        <div className=\"gua_cardview-text\">\r\n                                            <h4>{item.name}</h4>\r\n                                            <p>{item.description}</p>\r\n                                            <Link to={\"/course-detail-undergraduate?course=\"+item.slug}><a>Learn More</a></Link>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                                ))}\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <Qualities />\r\n                <NeedAdvice />\r\n            </div>\r\n            <Footer/>\r\n        </div>\r\n    );\r\n}\r\n\r\nexport default UndergraduateAccelerator;","C:\\Users\\Toheeb\\Grazac Repo\\grazac-academy-web\\src\\pages\\AboutUs.js",["134","135","136","137"],"import { useEffect } from 'react';\r\nimport { Link } from \"react-router-dom\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport Mode from \"../components/Mode\";\r\nimport Sponsor1 from \"../images/svg/sponsor1.svg\";\r\nimport Sponsor2 from \"../images/svg/sponsor2.svg\";\r\nimport Sponsor3 from \"../images/svg/sponsor3.svg\";\r\nimport Dots from \"../images/svg/dots.svg\";\r\n\r\nconst cardsInfo = [\r\n  {\r\n    color: \"39,234,198\",\r\n    title: \"Creativity\",\r\n    body: \"We constantly develop ideas that drives innovation. Our company is a community that allow us share common interests and ideas.\"\r\n  },\r\n  {\r\n    color: \"26,222,235\",\r\n    title: \"Quality\",\r\n    body: \"We strive to provide value that fulfils and exceeds expectation. We have an unwavering guide that leads the way to fulfilling your goal.\"\r\n  },\r\n  {\r\n    color: \"108,21,250\",\r\n    title: \"Passion\",\r\n    body: \"Our enthusiasm to deliver the best makes us unique. We uphold the highest standards in deliverability.\"\r\n  },\r\n  {\r\n    color: \"255,113,155\",\r\n    title: \"Commitment\",\r\n    body: \"We are focused on giving best solutions. Our concern is solving your problem rather than why or how the problem was created.\"\r\n  },\r\n  {\r\n    color: \"254,125,108\",\r\n    title: \"Collaboration\",\r\n    body: \"Our success depends upon the collective intelligence of our team members and the shared vision of our partners.\"\r\n  },\r\n  {\r\n    color: \"255,180,67\",\r\n    title: \"Teamwork\",\r\n    body: \"We do better, together. Our environment fosters progress, effectiveness and speed.\"\r\n  },\r\n]\r\n\r\nconst AboutUs = () => {\r\n\r\n  useEffect(() => {\r\n    document.title = 'About - Grazac Academy';\r\n    window.scrollTo(0,0);\r\n  }, []);\r\n\r\n  return(\r\n    <div className=\"about\">\r\n      <div className=\"about__nav\">\r\n        <Navbar />\r\n      </div>\r\n\r\n      <div className=\"about__top\">\r\n        <div className=\"about__top--container\">\r\n          <div className=\"about__top--up\">\r\n            <div>\r\n              <img src={Dots} alt=\"dots\" />\r\n            </div>\r\n            <div></div>\r\n            <div className=\"about__top--text\">\r\n              <h1>About Us</h1>\r\n              <p>At Grazac Academy, we provide you with the right platform to upskill yourself for the future.</p>\r\n            </div>\r\n          </div>\r\n          <div className=\"about__top--down\">\r\n            <div></div>\r\n            <div></div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <div className=\"about__middle\">\r\n        <div className=\"about__middle--container\">\r\n          <div className=\"about__middle--head\">\r\n            <h2>Our Core Values</h2>\r\n            <p>You determine the starting points, we provide the best possible interception to achieve the goals.</p>\r\n          </div>\r\n\r\n          <div className=\"about__middle--cards\">\r\n            {\r\n              cardsInfo.map(item => (\r\n                <div className=\"about__middle--card\">\r\n                  <div style={{\"--bg-color\": item.color}}></div>\r\n                  <h3>{item.title}</h3>\r\n                  <p>{item.body}</p>\r\n                </div>\r\n              ))\r\n            }\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <Mode />\r\n      <Footer />\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default AboutUs;","C:\\Users\\Toheeb\\Grazac Repo\\grazac-academy-web\\src\\auth\\Login.js",["138","139","140","141","142","143","144","145","146","147","148","149"],"import { useState } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { cn } from \"../utils\";\r\nimport PrimaryBtn from \"../components/PrimaryBtn\";\r\nimport Grazac from \"../images/grazac.png\";\r\n\r\nconst validEmailRegex = RegExp(\r\n  /^(([^<>()\\[\\]\\.,;:\\s@\\\"]+(\\.[^<>()\\[\\]\\.,;:\\s@\\\"]+)*)|(\\\".+\\\"))@(([^<>()[\\]\\.,;:\\s@\\\"]+\\.)+[^<>()[\\]\\.,;:\\s@\\\"]{2,})$/i\r\n);\r\n\r\nconst Login = () => {\r\n  const [email, setEmail] = useState(\"\");\r\n  const [password, setPassword] = useState(\"\");\r\n  const [emailErr, setEmailErr] =  useState(\"\");\r\n\r\n  \r\n  const handleEmailChange = e => {\r\n    e.preventDefault();\r\n    setEmail(e.target.value)\r\n\r\n    if (!email) setEmailErr(\"\");\r\n    let err = validEmailRegex.test(e.target.value) ? \"\" : \"please enter a valid email address\";\r\n    setEmailErr(err);\r\n  }\r\n\r\n  const handlePasswordChange = e => {\r\n    e.preventDefault();\r\n    setPassword(e.target.value)\r\n  }\r\n\r\n  return(\r\n    <div className=\"auth\">\r\n      <div className=\"auth__body\">\r\n        <div className=\"auth__hero\">\r\n          <img src={Grazac} alt=\"grazac\" />\r\n        </div>\r\n\r\n        <div className=\"auth__form\">\r\n          <div className=\"auth__form--container\">\r\n            <h1>Login</h1>\r\n\r\n            <form className=\"form\">\r\n              <div className=\"form__group\">\r\n                <label for=\"email\">Email address</label>\r\n                <input type=\"email\" id=\"email\" value={email} onChange={handleEmailChange} className={cn(\"form__input\", {\"form__input--err\": emailErr})}/>\r\n              </div>\r\n\r\n              <div className=\"form__group\">\r\n                <label for=\"pass\">Password</label>\r\n                <input type=\"password\" id=\"pass\" value={password} onChange={handlePasswordChange} className=\"form__input\"/>\r\n              </div>\r\n\r\n              <Link className=\"form__link\">Forgot password?</Link>\r\n\r\n              <button type=\"submit\" className=\"form__btn\">\r\n                <PrimaryBtn>Login</PrimaryBtn>\r\n              </button>\r\n            </form>\r\n\r\n            <div className=\"auth__line\">\r\n              <div>&nbsp;</div>\r\n              <span>or</span>\r\n              <div>&nbsp;</div>\r\n            </div>\r\n          </div>\r\n\r\n          <div className=\"auth__btns\">\r\n            <Link className=\"auth__btn\">\r\n              <