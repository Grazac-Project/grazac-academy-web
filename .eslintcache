 );\r\n};\r\n\r\nexport default Loader;\r\n","C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\pages\\UndergraduateForm.js",[],"C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\pages\\Join.js",["272","273","274","275","276","277"],"import { React, useEffect, useState, useContext } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { Accordion, Card, Container, Row, Col } from \"react-bootstrap\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport Mode from \"../components/Mode\";\r\nimport { MdKeyboardArrowDown } from \"react-icons/md\";\r\nimport PrimaryBtn from \"../components/PrimaryBtn\";\r\nimport Slider from \"infinite-react-carousel\";\r\n\r\nimport join from \"../images/svg/join.svg\";\r\nimport object from \"../images/svg/objects.svg\";\r\nimport grad1 from \"../images/grad1.png\";\r\nimport grad2 from \"../images/grad2.png\";\r\nimport grad3 from \"../images/grad3.png\";\r\nimport grad4 from \"../images/grad4.png\";\r\n\r\nconst Join = () => {\r\n\r\n    const [courses, setCourses] = useState([]);\r\n\r\n  useEffect(() => {\r\n    document.title = \"Join - Grazac Academy\";\r\n    window.scrollTo(0, 0);\r\n    fetch(\"https://grazacacademy.com/graduate/courses\")\r\n        .then((resp) => resp.json())\r\n        .then((resp) => {\r\n          setCourses(resp.data);\r\n        })\r\n        .catch((error) => {\r\n          console.log(\r\n            \"An error occurred when fetching the available courses, refreshing...\"\r\n          );\r\n          //\r\n    });\r\n  }, []);\r\n\r\n  \r\n  const handleFaq = (e) => {\r\n    let svg = e.target.parentElement.querySelector(\"svg\");\r\n    if (e.target.nodeName === \"path\") {\r\n      svg = e.target.parentElement.parentElement.querySelector(\"svg\");\r\n    }\r\n    svg.classList.toggle(\"faq-icon_transition\");\r\n  };\r\n\r\n  return (\r\n    <div>\r\n        <div className=\"landing__header join_header\">\r\n          <Navbar/>\r\n            {/* <img src={object} className=\"bg-img\" alt=\"ccc\" /> */}\r\n            <div style={{ height: 10 }}></div>\r\n\r\n            <div className=\"landing__text\">\r\n            <h1>\r\n                Grazac Graduate Accelerator Program\r\n            </h1>\r\n            <p>\r\n            Are you tired of lack of jobs or low income earnings?\r\n            Become employable in just 4 months by joining us today!\r\n            We are bridging the gap between unemployment and entry-level jobs in the technology industry.{\" \"}\r\n            </p>\r\n            </div>\r\n            <Link to=\"/login\">\r\n            <div\r\n                className=\"nav__btn\"\r\n                style={{ width: \"130px\", margin: \"auto\", textAlign: \"center\" }}\r\n            >\r\n                <div className=\"nav__btn--text\">Enroll Now</div>\r\n            </div>\r\n            </Link>\r\n        </div>\r\n\r\n        <div>\r\n          <Container>\r\n            <div className=\"course_mode-intro course_mode-intro\">\r\n                <h2 className=\"join_heading\">Why you should embrace digital skills</h2>\r\n                <p className=\"join_needed\">As the demand for advanced tech skills rises, many companies are looking into recruiting, hiring, and nurturing the right talent that will move their organization forward. This means that people who are willing to spend time developing tech skills will have the upper hand in landing some of the most profitable jobs in the tech industry.</p>\r\n                <p className=\"join_needed\">Now, the good thing about tech skills is that you can make money from anywhere in the world with just a computer or mobile device connected to the internet. These skills allow you to work remotely and on your own terms. Stay on top and leverage on this opportunity to land your dream career in tech.</p>\r\n                <h2 style={{ margin:\"80px 0 30px\"}} className=\"join_heading\">Why Grazac Academy is the best for you</h2>\r\n            </div>\r\n          </Container>\r\n        </div>\r\n\r\n        <div style={{boxSizing:'border-box', margin:'0 0 80px'}}>\r\n          <Container>\r\n            <Row>\r\n              <Col md={6}>\r\n                <div className=\"join_box1\">\r\n                  <div className=\"\">\r\n                    <img src={join} alt=\"profile\" />\r\n                  </div>\r\n                  <h4>1:1 access to mentorship and support</h4>\r\n                  <p className=\"hire_dev-grey\">You gain 24/7 access to a wide range of industry experts that will walk you through your career path and increase your visibility to potential employers.</p>\r\n                </div>\r\n              </Col>\r\n              <Col md={6}>\r\n                <div className=\"join_box1\">\r\n                  <div className=\"\">\r\n                    <img src={join} alt=\"profile\" />\r\n                  </div>\r\n                  <h4>Recognized Certification</h4>\r\n                  <p className=\"hire_dev-grey\">You get a recognized certificate that serves as a proof that you are skilled enough to work in any organization in or outside Nigeria.</p>\r\n                </div>\r\n              </Col>\r\n            </Row>\r\n            {/* <Row>\r\n              <Col md={6}>\r\n                <div className=\"join_box1\">\r\n                  <div className=\"\">\r\n                    <img src={join} alt=\"profile\" />\r\n                  </div>\r\n                  <h4>Job placement upon graduation</h4>\r\n                  <p className=\"hire_dev-grey\">We match you with employers and you enter the recruitment process to land your dream job in tech. In less than 4-months of landing your dream job, you will make the money of this course back and still have more left with you.</p>\r\n                </div>\r\n              </Col>\r\n              <Col md={6}>\r\n                <div className=\"join_box1\">\r\n                  <div className=\"\">\r\n                    <img src={join} alt=\"profile\" />\r\n                  </div>\r\n                  <h4>1-month compulsory Internship</h4>\r\n                  <p className=\"hire_dev-grey\">You stand a chance to work with our amazing team on real-life projects to solve related problems so you can build your portfolio.</p>\r\n                </div>\r\n              </Col>\r\n            </Row> */}\r\n            <Link to=\"/login\">\r\n                    <div\r\n                        className=\"nav__btn\"\r\n                        style={{ width: \"130px\", margin: \" 30px auto\", textAlign: \"center\" }}\r\n                    >\r\n                        <div className=\"nav__btn--text\">Enroll Now</div>\r\n                    </div>\r\n            </Link>\r\n          </Container>\r\n        </div>\r\n\r\n        <div>\r\n            <div className=\"course_mode-intro course_mode-intro\">\r\n                <h2 className=\"join_heading\">Testimonials</h2>\r\n                <p className=\"join_needed\">The success stories, testimonials and other examples of our students are exceptional. These are our students that put in deliberate efforts and have been intentional and consistent in implementing what they learnt from the course.</p>\r\n            </div>\r\n            <div className=\"\">\r\n              <Slider arrows={true}  className=\"landing__slider-desktop\">\r\n                  <div className=\"landing__slider--container\" >\r\n                    <div className=\"video-width\">\r\n                      <iframe className=\"video-width\" src=\"https://www.youtube.com/embed/HQYKZ6RaZ6I\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen></iframe>\r\n                    </div>\r\n                    <div>\r\n                      <iframe className=\"video-width\" src=\"https://www.youtube.com/embed/CVDQuO2KMCw\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen></iframe>\r\n                    </div>\r\n                  </div>\r\n                  <div className=\"landing__slider--container\" >\r\n                    <div className=\"video-width\">\r\n                      <iframe className=\"video-width\" src=\"https://www.youtube.com/embed/yfP88Mr_Ixw\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen></iframe>\r\n                    </div>\r\n                    <div>\r\n                      <iframe className=\"video-width\" src=\"https://www.youtube.com/embed/1KkiCbKrG-w\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen></iframe>\r\n                    </div>\r\n                  </div>\r\n              </Slider>\r\n              <div className=\"landing__slider-mobile\">\r\n                  <iframe src=\"https://www.youtube.com/embed/HQYKZ6RaZ6I\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen></iframe>\r\n                  <iframe src=\"https://www.youtube.com/embed/yfP88Mr_Ixw\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen></iframe>\r\n                  <iframe src=\"https://www.youtube.com/embed/CVDQuO2KMCw\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen></iframe>\r\n              </div>\r\n            </div>\r\n        </div>\r\n\r\n\r\n        <div>\r\n          <div className=\"course_mode-intro course_mode-intro\" style={{textAlign:'center'}}>\r\n              <h2 className=\"join_heading\" style={{ marginTop:\"80px\"}}>Gallery</h2>\r\n              <p className=\"join_needed\">Images of our students that put in deliberate efforts and have been intentional and consistent in implementing what they learnt from the course.</p>\r\n          </div>\r\n          <Container>\r\n            <div className=\"join_gallery\">\r\n              <div className=\"join_gallery-top\">\r\n                <div className=\"join_gallery-top-left\" >\r\n                  <img src={grad1} />\r\n                </div>\r\n                <div className=\"join_gallery-top-right\" >\r\n                  <img src={grad4} />\r\n                </div>\r\n              </div>\r\n              <div className=\"join_gallery-bottom\">\r\n                <div className=\"join_gallery-bottom-left\" >\r\n                  <img src={grad2} />\r\n                </div>\r\n                <div className=\"join_gallery-bottom-right\" >\r\n                  <img src={grad3} />\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </Container>\r\n        </div>\r\n\r\n        <div className=\"join_bg1\" id=\"courses\">\r\n            <div className=\"container\">\r\n              <div className=\"gga\">\r\n                <div className=\"course_mode-intro course_mode-intro\">\r\n                  <h2 style={{textAlign:'center'}}>Available Courses</h2>\r\n                  <p style={{textAlign:'center'}}>Learn any of these 6 hot tech courses today at 20% off</p>\r\n                </div>\r\n                <div className=\"join_container\">\r\n                  {courses.length ? (\r\n                    courses.map((item, index) => (\r\n                      <Link\r\n                        to={`/course-detail-graduate?course=${item.slug}`}\r\n                        className=\"boxes33\"\r\n                        key={index}\r\n                      >\r\n                        <div className=\"gua_cardview\">\r\n                          <div className=\"gua_cardview-box\">\r\n                            <img src={item.thumb} alt=\"course-desc\" />\r\n                          </div>\r\n                          <div className=\"gua_cardview-text\">\r\n                            <h4 style={{ color: \"rgb(51, 51, 51)\" }}>\r\n                              {item.name}\r\n                            </h4>\r\n                            <p>{item.description}</p>\r\n                            <Link\r\n                              to={\"/course-detail-graduate?course=\" + item.slug}\r\n                            >\r\n                            Learn More\r\n                            </Link>\r\n                          </div>\r\n                        </div>\r\n                      </Link>\r\n                    ))\r\n                  ) : (\r\n                    <div>\r\n                      {/* <img src={loader} alt=\"loader\" className=\"loader\" /> */}\r\n                    </div>\r\n                  )}\r\n                </div>\r\n                <div className=\"course_purple-btn\">\r\n                    <PrimaryBtn link=\"/login\">Enroll Now</PrimaryBtn>\r\n                </div>\r\n              </div>\r\n            </div>\r\n        </div>\r\n\r\n      <div className=\"course_purple\">\r\n            <div className=\"course_purple_txt\">\r\n                <p>Our Flexible Payment Plans</p>\r\n                <h1>70%</h1>\r\n                <p>Discount Available</p>\r\n            </div>\r\n            <div className=\"course_purple-main\">\r\n              <div>\r\n                  <div className=\"course_purple-main-boxes grad-box\">\r\n                      <h4>Full Payment</h4>\r\n                      <h3><span style={{textDecoration:'line-through'}}>₦250,000</span></h3>\r\n                      <h2>₦75,000</h2>\r\n                      <p>This is a one-off payment. You won't be required to pay any amount again till the end of your training.</p>\r\n                  </div>\r\n              </div>\r\n              <div>\r\n                  <div className=\"course_purple-main-boxes grad-box\">\r\n                      <h4>Installment Payment</h4>\r\n                      <h3><span style={{textDecoration:'line-through'}}>₦250,000</span></h3>\r\n                      <h2>₦40,000 <span style={{fontSize: '14px'}}>* 2 months.</span></h2>\r\n                      <p>To be paid at the start of each month for the duration of the training which is 2 months.</p>\r\n                  </div>\r\n              </div>\r\n              {/* <div>\r\n                  <div className=\"course_purple-main-boxes grad-box\">\r\n                      <h4>Monthly Payment</h4>\r\n                      <h3><span style={{textDecoration:'line-through'}}>₦250,000</span></h3>\r\n                      <h2>₦55000 <span style={{fontSize: '14px'}}>* 4 months.</span></h2>\r\n                      <p>To be paid at the beginning of each month for the duration of the training which is 4 months.</p>\r\n                  </div>\r\n              </div> */}\r\n            </div>\r\n            <div className=\"course_purple-btn\">\r\n                <PrimaryBtn link=\"/login\">Enroll Now</PrimaryBtn>\r\n            </div>\r\n    </div>\r\n\r\n      <div className=\"landing_faq\">\r\n        <div className=\"container\">\r\n          <h1>FAQs</h1>\r\n          <div>\r\n            <Accordion>\r\n              <Card>\r\n                <Accordion.Toggle as={Card.Header} eventKey=\"0\">\r\n                  <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                    <h4>What is Grazac Academy?</h4>\r\n                    <MdKeyboardArrowDown size=\"2rem\" color=\"black\" />\r\n                  </div>\r\n                </Accordion.Toggle>\r\n                <Accordion.Collapse eventKey=\"0\">\r\n                  <Card.Body>\r\n                    <div className=\"landing_faq-answer\">\r\n                      <p>\r\n                        Grazac Academy is closing the gap between youths and\r\n                        entry-level jobs in the technology industry. We strongly\r\n                        believe the job market for youths has changed and the\r\n                        future of work will be skill-based.\r\n                      </p>\r\n                      <p>We are approaching this in two ways:</p>\r\n                      <p>\r\n                        Grazac Academy Graduate Accelerator - This plan is for\r\n                        tertiary institutions graduates who have full time to\r\n                        build a career in tech. This plan has been arranged in a\r\n                        way to prepare them for work.\r\n                      </p>\r\n                      <p>\r\n                        Grazac Academy Undergraduate Accelerator - This plan is\r\n                        to equip undergraduates in their institutions, we\r\n                        believe the earlier the better and we want to prepare\r\n                        them for life after school by upskilling them while they\r\n                        are still in school.\r\n                      </p>\r\n                    </div>\r\n                  </Card.Body>\r\n                </Accordion.Collapse>\r\n              </Card>\r\n              <hr />\r\n              <Card>\r\n                <Accordion.Toggle as={Card.Header} eventKey=\"1\">\r\n                  <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                    <h4>When was the academy established?</h4>\r\n                    <MdKeyboardArrowDown size=\"2rem\" color=\"black\" />\r\n                  </div>\r\n                </Accordion.Toggle>\r\n                <Accordion.Collapse eventKey=\"1\">\r\n                  <Card.Body>\r\n                    <div className=\"landing_faq-answer\">\r\n                      <p>Grazac Academy has been in operation since 2018</p>\r\n                    </div>\r\n                  </Card.Body>\r\n                </Accordion.Collapse>\r\n              </Card>\r\n              <hr />\r\n              <Card>\r\n                <Accordion.Toggle as={Card.Header} eventKey=\"2\">\r\n                  <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                    <h4>How many students have graduated from your academy?</h4>\r\n                    <MdKeyboardArrowDown size=\"2rem\" color=\"black\" />\r\n                  </div>\r\n                </Accordion.Toggle>\r\n                <Accordion.Collapse eventKey=\"2\">\r\n                  <Card.Body>\r\n                    <div className=\"landing_faq-answer\">\r\n                      <p>\r\n                        Excluding our partnership with Haptics.ng in 2019 to\r\n                        execute Google project of upskilling Nigerians on\r\n                        Digital skills where we trained about 500 youths, we\r\n                        have impacted over 2,000 lives through our trainings,\r\n                        meetups and events.\r\n                      </p>\r\n                    </div>\r\n                  </Card.Body>\r\n                </Accordion.Collapse>\r\n              </Card>\r\n              <hr />\r\n              <Card>\r\n                <Accordion.Toggle as={Card.Header} eventKey=\"3\">\r\n                  <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                    <h4>Where is the academy located?</h4>\r\n                    <MdKeyboardArrowDown size=\"2rem\" color=\"black\" />\r\n                  </div>\r\n                </Accordion.Toggle>\r\n                <Accordion.Collapse eventKey=\"3\">\r\n                  <Card.Body>\r\n                    <div className=\"landing_faq-answer\">\r\n                      <p>\r\n                        Our headquarter is located at Abeokuta, Ogun State,\r\n                        Nigeria.\r\n                      </p>\r\n                      <p>\r\n                        Address: Suite 106, PROHUB, Salawu Olabode Avenue, Ewang\r\n                        Road, Idi-aba, Abeokuta.\r\n                      </p>\r\n                    </div>\r\n                  </Card.Body>\r\n                </Accordion.Collapse>\r\n              </Card>\r\n              <hr />\r\n              <Card>\r\n                <Accordion.Toggle as={Card.Header} eventKey=\"4\">\r\n                  <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                    <h4>How do I enroll in the academy?</h4>\r\n                    <MdKeyboardArrowDown size=\"2rem\" color=\"black\" />\r\n                  </div>\r\n                </Accordion.Toggle>\r\n                <Accordion.Collapse eventKey=\"4\">\r\n                  <Card.Body>\r\n                    <div className=\"landing_faq-answer\">\r\n                      <p>\r\n                        Visit{\" \"}\r\n                        <a href=\"https://www.grazacacademy.com\">\r\n                          www.grazacacademy.com\r\n                        </a>{\" \"}\r\n                        to enroll for your preferred course.\r\n                      </p>\r\n                    </div>\r\n                  </Card.Body>\r\n                </Accordion.Collapse>\r\n              </Card>\r\n              <hr />\r\n              <Card>\r\n                <Accordion.Toggle as={Card.Header} eventKey=\"5\">\r\n                  <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                    <h4>What are the payment options?</h4>\r\n                    <MdKeyboardArrowDown size=\"2rem\" color=\"black\" />\r\n                  </div>\r\n                </Accordion.Toggle>\r\n                <Accordion.Collapse eventKey=\"5\">\r\n                  <Card.Body>\r\n                    <div className=\"landing_faq-answer\">\r\n                      <p>\r\n                        We have three (2) payment options for our Gradaute\r\n                        Accelerator, you can either pay once or pay\r\n                        installmentally.\r\n                      </p>\r\n                    </div>\r\n                  </Card.Body>\r\n                </Accordion.Collapse>\r\n              </Card>\r\n            </Accordion>\r\n            <hr />\r\n            <Link to=\"/faq\">\r\n              <p className=\"landing_faq-link\">\r\n                More frequently asked questions\r\n              </p>\r\n            </Link>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <Mode />\r\n      <Footer />\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default Join;","C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\components\\Navbar.js",["278","279","280"],"C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\components\\Footer.js",["281","282"],"C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\components\\NeedAdvice.js",[],"C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\utils.js",[],"C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\components\\MOT.js",[],"C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\components\\Qualities.js",[],"C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\components\\PrimaryBtn.js",[],"C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\components\\Mode.js",["283","284","285","286"],"C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\components\\SchoolList.js",[],"C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\components\\Modal.js",[],"C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\components\\InfoModal.js",["287"],"import { useState } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport badge from \"../images/svg/badge.svg\";\r\nimport ex from \"../images/svg/x-mark.svg\";\r\n\r\nconst InfoModal = () => {\r\n  const [showModal, setShowModal] = useState(true);\r\n\r\n  return (\r\n    <div>\r\n        <div className=\"infomodal\">\r\n          <div className=\"infomodal_content\">\r\n            <img src={badge} alt=\"\" />\r\n            <p>\r\n              Grazac Graduate Accelerator Program is closed for enrollment., You\r\n              can apply for internship positions\r\n            </p>\r\n            <Link to=\"/internship\">\r\n              <button>Enroll</button>\r\n            </Link>\r\n            <img\r\n              src={ex}\r\n              alt=\"\"\r\n              onClick={() => setShowModal(false)}\r\n              style={{ cursor: \"pointer\" }}\r\n            />\r\n          </div>\r\n        </div>\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default InfoModal;\r\n","C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\components\\NavItem.js",[],"C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\pages\\graduateCohort\\auth\\MailSent.js",["288"],"import { Link } from \"react-router-dom\";\r\nimport logo from '../../../images/svg/academy-logo.svg';\r\nimport email from '../../../images/svg/email.svg';\r\n\r\n\r\nfunction MailSent () {\r\n    return(\r\n        <div className=\"layout_auth\">\r\n            <div className=\"layout_auth-main\">\r\n                <div className=\"auth_container\">\r\n                    <div className=\"auth_container-logo\" >\r\n                        <img src={logo} alt=\"logo\" />\r\n                    </div>\r\n                    <div className=\"auth_container_form\">\r\n                        <img src={email} alt=\"email\" className=\"auth_container_form-email\" />\r\n                        <h3>Password reset link sent!</h3>\r\n                        <p className=\"auth_container_form-text\">We have sent you an email containing a link to reset your password, kindly check your email to set a new password.</p>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n            <div className=\"layout_auth-image\">\r\n\r\n            </div>\r\n        </div>\r\n    )\r\n}\r\n\r\nexport default MailSent;","C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\pages\\graduateCohort\\auth\\ResetPassword.js",["289","290","291"],"import { useState } from 'react';\r\nimport { Link } from \"react-router-dom\";\r\nimport { ToastContainer, toast } from 'react-toastify';\r\nimport { ResetPasswordAction } from \"../../../api/dashboard/auth\";\r\n\r\nimport logo from '../../../images/svg/academy-logo.svg';\r\nimport visible from '../../../images/svg/visible.svg';\r\nimport notvisible from '../../../images/svg/notvisible.svg';\r\nimport loader from \"../../../images/svg/dashboard/loader.gif\";\r\n\r\n\r\nfunction ResetPassword () {\r\n    const urlParams = new URLSearchParams(window.location.search);\r\n    const reset_token = urlParams.get('token');\r\n    const [form, setForm] = useState({\r\n        password: \"\",\r\n        confirmpassword: \"\"\r\n    });\r\n\r\n    const handleChange = (e) => {\r\n        setForm({\r\n            ...form,\r\n            [e.target.name]: e.target.value\r\n        })\r\n    }\r\n\r\n    const doReset = (e) => {\r\n        e.preventDefault();\r\n        if (!form.password.length || !form.confirmpassword.length) {\r\n            toast.info(\"Please make sure no field is empty!\")\r\n        }else if(form.password != form.confirmpassword){\r\n            toast.error(\"Passwords do not match!\")\r\n        }else if(form.password.length<6 || form.confirmpassword<6){\r\n            toast.error(\"Passwords should be at least 6 characters!\")\r\n        } else{\r\n            var btn = document.getElementById(\"actionBtn\");\r\n            btn.innerHTML = `<img src=${loader} width=\"20px\" />`;\r\n            var data  = new FormData();\r\n    \r\n            data.append(\"token\", reset_token);\r\n            data.append(\"password\", form.password);\r\n            data.append(\"confirmPassword\", form.confirmpassword);\r\n    \r\n            ResetPasswordAction(data)\r\n                .then((response) => response.data)\r\n                .then((res) => {\r\n                    console.log(res);\r\n                    if (res.status === 200) {\r\n                        toast.success(\"Password reset successful! Proceed to login.\");\r\n                        btn.innerHTML=`Reset Password`;\r\n                    } else {\r\n                        toast.error(\"Something went wrong, please try again!!!\")\r\n                        btn.innerHTML=`Reset Password`;\r\n                    }\r\n                })\r\n                .catch((err) => {\r\n                    console.log(err.response)//modify the errors\r\n                    toast.error(\"Unable to reset password! Try again\");\r\n                //     if(err.response.data.message){\r\n                //         toast.error(err.response.data.message);\r\n                //         btn.innerHTML=`Reset Password`;\r\n                //     } else{\r\n                //         toast.error(\"Something went wrong!!! Please make sure you have a good internet connection.\");\r\n                //         btn.innerHTML=`Reset Password`;\r\n                //     }\r\n                });\r\n        }\r\n    }\r\n\r\n    const toggleIcon = () => {\r\n        var x = document.getElementById(\"password\");\r\n        var iconContainer = document.getElementById(\"toggle\");\r\n        if (x.type === \"password\") {\r\n          x.type = \"text\";\r\n          iconContainer.innerHTML = `<img src=${notvisible} />`\r\n        } else {\r\n          x.type = \"password\";\r\n          iconContainer.innerHTML = `<img src=${visible} />` ;\r\n        }\r\n    }\r\n    \r\n    const toggleIcon2 = () => {\r\n        var x = document.getElementById(\"confirmpassword\");\r\n        var iconContainer = document.getElementById(\"confirmtoggle\");\r\n        if (x.type === \"password\") {\r\n            x.type = \"text\";\r\n            iconContainer.innerHTML = `<img src=${notvisible} />`\r\n        } else {\r\n            x.type = \"password\";\r\n            iconContainer.innerHTML = `<img src=${visible} />` ;\r\n        }\r\n    }\r\n\r\n    return(\r\n        <div className=\"layout_auth\">\r\n            <ToastContainer/>\r\n            <div className=\"layout_auth-main\">\r\n                <div className=\"auth_container\">\r\n                    <div className=\"auth_container-logo\" >\r\n                        <img src={logo} alt=\"logo\" />\r\n                    </div>\r\n                    <div className=\"auth_container_form\">\r\n                        <h3>Create New Password</h3>\r\n                        <p className=\"auth_container_form-text\">Enter your new password below to continue.</p>\r\n                        <form onSubmit={doReset}>\r\n                            <div className=\"auth_container_form-password\">\r\n                                <label>Password</label>\r\n                                <input type=\"password\" id=\"password\" placeholder=\"Password\" name=\"password\" onChange={handleChange} />\r\n                                <div id=\"toggle\" onClick={toggleIcon} ><img src={visible} /></div>\r\n                            </div>\r\n                            <div className=\"auth_container_form-password\">\r\n                                <label>Confirm Password</label>\r\n                                <input type=\"password\" id=\"confirmpassword\" placeholder=\"Password\" name=\"confirmpassword\" onChange={handleChange} />\r\n                                <div id=\"confirmtoggle\" onClick={toggleIcon2} ><img src={visible} /></div>\r\n                            </div>\r\n                            <button type=\"submit\" id=\"actionBtn\">Reset Password</button>\r\n                            <p>Remember your password? <Link to=\"/login\"><span>Login</span></Link></p>\r\n                        </form>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n            <div className=\"layout_auth-image\">\r\n\r\n            </div>\r\n        </div>\r\n    )\r\n}\r\n\r\nexport default ResetPassword;","C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\pages\\graduateCohort\\auth\\Login.js",["292"],"import { useState } from 'react';\r\nimport { Link } from \"react-router-dom\";\r\nimport { LoginAction } from \"../../../api/dashboard/auth\";\r\nimport { ToastContainer, toast } from 'react-toastify';\r\n\r\nimport logo from '../../../images/svg/academy-logo.svg';\r\nimport visible from '../../../images/svg/visible.svg';\r\nimport notvisible from '../../../images/svg/notvisible.svg';\r\nimport loader from \"../../../images/svg/dashboard/loader.gif\";\r\n\r\n\r\nfunction Login () {\r\n    const [form, setForm] = useState({\r\n        email: \"\",\r\n        password: \"\"\r\n    });\r\n\r\n    const handleChange = (e) => {\r\n        setForm({\r\n            ...form,\r\n            [e.target.name]: e.target.value\r\n        })\r\n    }\r\n\r\n    const doLogin = (e) => {\r\n        e.preventDefault();\r\n        var btn = document.getElementById(\"actionBtn\");\r\n        btn.innerHTML=`<img src=${loader} width=\"20px\" />`;\r\n        const { email, password } = form;\r\n        var data  = new FormData();\r\n\r\n        data.append(\"email\", email);\r\n        data.append(\"password\", password);\r\n\r\n        LoginAction(data)\r\n            .then((response) => response.data)\r\n            .then((res) => {\r\n                console.log(res);\r\n                if (res.status === 201) {\r\n                    toast.success(`${res.message}! Redirecting to dashboard...`);\r\n\r\n                    sessionStorage.setItem(\r\n                        \"user_details\",\r\n                        JSON.stringify({\r\n                        firstName: res.data.payload.FirstName,\r\n                        lastName: res.data.payload.LastName,\r\n                        email: res.data.payload.email,\r\n                        id: res.data.payload.id,\r\n                        phone: res.data.phoneNumber,\r\n                        status: res.data.status,\r\n                        token: res.data.token\r\n                        })\r\n                    ); \r\n                    btn.innerHTML=`Sign in`;\r\n                    setTimeout( function (){window.location = '/dashboard';}, 2500)\r\n                } else {\r\n                    toast.error(\"Something went wrong, please try again!!!\")\r\n                }\r\n            })\r\n            .catch((err) => {\r\n                if(err.response.data.message){\r\n                    toast.error(err.response.data.message);\r\n                    btn.innerHTML=`Sign in`;\r\n                } else{\r\n                    toast.error(\"Something went wrong!!! Please make sure you have a good internet connection.\");\r\n                    btn.innerHTML=`Sign in`;\r\n                }\r\n            });\r\n    }\r\n\r\n    const toggleIcon = () => {\r\n        var x = document.getElementById(\"password\");\r\n        var iconContainer = document.getElementById(\"toggle\");\r\n        if (x.type === \"password\") {\r\n          x.type = \"text\";\r\n          iconContainer.innerHTML = `<img src=${notvisible} />`\r\n        } else {\r\n          x.type = \"password\";\r\n          iconContainer.innerHTML = `<img src=${visible} />` ;\r\n        }\r\n    }\r\n\r\n    return(\r\n        <div className=\"layout_auth\">\r\n            <ToastContainer/>\r\n            <div className=\"layout_auth-main\">\r\n                <div className=\"auth_container\">\r\n                    <div className=\"auth_container-logo\" >\r\n                        <img src={logo} alt=\"logo\" />\r\n                    </div>\r\n                    <div className=\"auth_container_form\">\r\n                        <h3>Login to your account</h3>\r\n                        <p className=\"auth_container_form-text\">Enter your email address and password to continue.</p>\r\n                        <form onSubmit={doLogin}>\r\n                            <div>\r\n                                <label>Email Address</label>\r\n                                <input type=\"email\" required placeholder=\"Email Address\" name=\"email\" onChange={handleChange} />\r\n                            </div>\r\n                            <div className=\"auth_container_form-password\">\r\n                                <label>Password</label>\r\n                                <input type=\"password\" required id=\"password\" placeholder=\"Password\" name=\"password\" onChange={handleChange} />\r\n                                <div id=\"toggle\" onClick={toggleIcon} ><img src={visible} /></div>\r\n                            </div>\r\n                            <button type=\"submit\" id=\"actionBtn\">Sign in</button>\r\n                            <p><Link to=\"/forgot-password\"><span>Forgot your password?</span></Link></p>\r\n                            <p>Don't have an account? <Link to=\"/signup\"><span>Sign up</span></Link></p>\r\n                        </form>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n            <div className=\"layout_auth-image\">\r\n\r\n            </div>\r\n        </div>\r\n    )\r\n}\r\n\r\nexport default Login;","C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\pages\\graduateCohort\\auth\\ForgotPassword.js",[],"C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\pages\\graduateCohort\\auth\\SignUp.js",["293","294"],"import { useState } from 'react';\r\nimport { Link } from \"react-router-dom\";\r\nimport { ToastContainer, toast } from 'react-toastify';\r\nimport { SignupAction } from \"../../../api/dashboard/auth\";\r\nimport axios from 'axios';\r\nimport logo from '../../../images/svg/academy-logo.svg';\r\nimport visible from '../../../images/svg/visible.svg';\r\nimport notvisible from '../../../images/svg/notvisible.svg';\r\nimport loader from \"../../../images/svg/dashboard/loader.gif\";\r\n\r\n\r\nfunction SignUp () {\r\n    const [form, setForm] = useState({\r\n        firstName: \"\",\r\n        lastName: \"\",\r\n        email: \"\",\r\n        phone: \"\",\r\n        password: \"\"\r\n    });\r\n\r\n    const handleChange = (e) => {\r\n        setForm({\r\n            ...form,\r\n            [e.target.name]: e.target.value\r\n        })\r\n    }\r\n\r\n    const doSignUp = (e) => {\r\n        e.preventDefault();\r\n        var btn = document.getElementById(\"actionBtn\");\r\n        if (form.password.length > 5){\r\n            btn.innerHTML=`<img src=${loader} width=\"20px\" />`;\r\n            const {firstName, lastName, email, phone, password} = form;\r\n            var data  = new FormData();\r\n\r\n            data.append(\"firstName\", firstName);\r\n            data.append(\"lastName\", lastName);\r\n            data.append(\"email\", email);\r\n            data.append(\"phoneNumber\", phone);\r\n            data.append(\"password\", password);\r\n\r\n            SignupAction(data)\r\n                .then((response) => response.data)\r\n                .then((res) => {\r\n                    // console.log(res);\r\n                    if (res.status === 201) {\r\n                        toast.success(`${res.message} Proceed to login.`);\r\n                        btn.innerHTML=`Create account`;\r\n                        window.location = \"/account-created\";\r\n                    } else {\r\n                        toast.error(\"Something went wrong, please try again!!!\")\r\n                    }\r\n                })\r\n                .catch((err) => {\r\n                    // console.log(err.response.data.message);\r\n                    if(err.response.data.message){\r\n                        toast.error(err.response.data.message);\r\n                        btn.innerHTML=`Create account`;\r\n                    } else{\r\n                        toast.error(\"Something went wrong!!! Please make sure you have a good internet connection.\");\r\n                        btn.innerHTML=`Create account`;\r\n                    }\r\n                });\r\n        } else {\r\n            toast.error(\"Password must be at least 6 characters!\");\r\n        }\r\n    }\r\n\r\n    const toggleIcon = () => {\r\n        var x = document.getElementById(\"password\");\r\n        var iconContainer = document.getElementById(\"toggle\");\r\n        if (x.type === \"password\") {\r\n          x.type = \"text\";\r\n          iconContainer.innerHTML = `<img src=${notvisible} />`\r\n        } else {\r\n          x.type = \"password\";\r\n          iconContainer.innerHTML = `<img src=${visible} />` ;\r\n        }\r\n    }\r\n\r\n    return(\r\n        <div className=\"layout_auth\">\r\n            <ToastContainer/>\r\n            <div className=\"layout_auth-main\">\r\n                <div className=\"auth_container\">\r\n                    <div className=\"auth_container-logo\" >\r\n                        <img src={logo} alt=\"logo\" />\r\n                    </div>\r\n                    <div className=\"auth_container_form\">\r\n                        <h3>Create an Account</h3>\r\n                        <p className=\"auth_container_form-text\">Create a free account to start your application</p>\r\n                        <form onSubmit={doSignUp}>\r\n                            <div>\r\n                                <label>First Name</label>\r\n                                <input type=\"text\" required placeholder=\"First Name\" name=\"firstName\" onChange={handleChange} />\r\n                            </div>\r\n                            <div>\r\n                                <label>Last Name</label>\r\n                                <input type=\"text\" required placeholder=\"Last Name\" name=\"lastName\" onChange={handleChange} />\r\n                            </div>\r\n                            <div>\r\n                                <label>Email Address</label>\r\n                                <input type=\"email\" required placeholder=\"Email Address\" name=\"email\" onChange={handleChange} />\r\n                            </div>\r\n                            <div>\r\n                                <label>Phone Number</label>\r\n                                <input type=\"number\" required placeholder=\"Phone Number\" name=\"phone\" onChange={handleChange} />\r\n                            </div>\r\n                            <div className=\"auth_container_form-password\">\r\n                                <label>Password</label>\r\n                                <input type=\"password\" id=\"password\" required placeholder=\"Password\" name=\"password\" onChange={handleChange} />\r\n                                <div id=\"toggle\" onClick={toggleIcon} ><img src={visible} /></div>\r\n                            </div>\r\n                            <button type=\"submit\" id=\"actionBtn\">Create account</button>\r\n                            <p>Already have an account? <Link to=\"/login\"><span>Login</span></Link></p>\r\n                        </form>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n            <div className=\"layout_auth-image\">\r\n\r\n            </div>\r\n        </div>\r\n    )\r\n}\r\n\r\nexport default SignUp;","C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\pages\\graduateCohort\\auth\\VerifyMail.js",[],"C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\pages\\graduateCohort\\dashboard\\Main.js",["295"],"C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\components\\dashboard\\Sidebar.js",["296","297"],"import { useState } from \"react\";\r\nimport { ToastContainer, toast } from \"react-toastify\";\r\nimport Logo from \"../../images/svg/grazac-logo.svg\";\r\n\r\nfunction Sidebar ({clicked, clickedDashboard, clickedDetails, showDetails}) {\r\n\r\n    const signOut = () => {\r\n        sessionStorage.clear();\r\n        toast.info(\"Signing out ...\")\r\n        setTimeout( function (){window.location = '/dashboard';}, 2500)\r\n    }\r\n\r\n    return(\r\n        <div className=\"sidebar\">\r\n            <ToastContainer/>\r\n            <img src={Logo} alt=\"logo\" className=\"logo\" />\r\n            <div className=\"sidebar-portal\">\r\n                <p className=\"sidebar-portal-heading\">PORTAL</p>\r\n                <div className={clicked===\"dashboard\" ? \"active\":\"sidebar-portal-links\"} onClick={()=>clickedDashboard(\"dashboard\")}>            \r\n                    <svg width=\"19\" height=\"19\" viewBox=\"0 0 19 19\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\r\n                        <path d=\"M18.5 18.0003C18.5 18.2655 18.3946 18.5198 18.2071 18.7074C18.0196 18.8949 17.7652 19.0003 17.5 19.0003H1.5C1.23478 19.0003 0.98043 18.8949 0.792893 18.7074C0.605357 18.5198 0.5 18.2655 0.5 18.0003V7.49027C0.499895 7.33788 0.534617 7.18749 0.601516 7.05057C0.668415 6.91365 0.76572 6.79384 0.886 6.70027L8.886 0.478272C9.06154 0.341717 9.2776 0.267578 9.5 0.267578C9.7224 0.267578 9.93846 0.341717 10.114 0.478272L18.114 6.70027C18.2343 6.79384 18.3316 6.91365 18.3985 7.05057C18.4654 7.18749 18.5001 7.33788 18.5 7.49027V18.0003ZM4.5 13.0003V15.0003H14.5V13.0003H4.5Z\" fill=\"#787676\"/>\r\n                    </svg>\r\n                    <p>Dashboard</p>\r\n                </div>\r\n                { showDetails != \"Not Submitted\" &&\r\n                    <div className={clicked===\"details\" ? \"active\":\"sidebar-portal-links\"} onClick={()=>clickedDetails(\"details\")}>\r\n                        <svg width=\"21\" height=\"20\" viewBox=\"0 0 21 20\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\r\n                            <path d=\"M10.5 20C4.977 20 0.5 15.523 0.5 10C0.5 4.477 4.977 0 10.5 0C16.023 0 20.5 4.477 20.5 10C20.5 15.523 16.023 20 10.5 20ZM9.5 9V15H11.5V9H9.5ZM9.5 5V7H11.5V5H9.5Z\" fill=\"#787676\"/>\r\n                        </svg>\r\n                        <p>Details</p>\r\n                    </div>\r\n                }\r\n                <div className=\"sidebar-portal-links signout\" onClick={signOut}>\r\n                    <svg width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\r\n                        <path d=\"M10 20C4.477 20 0 15.523 0 10C0 4.477 4.477 0 10 0C15.523 0 20 4.477 20 10C20 15.523 15.523 20 10 20ZM5 9V6L0 10L5 14V11H13V9H5Z\" fill=\"#909198\"/>\r\n                    </svg>\r\n                    <p>Sign Out</p>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    )\r\n}\r\n\r\nexport default Sidebar;","C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\components\\dashboard\\Details.js",[],"C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\components\\dashboard\\Admitted.js",[],"C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\components\\dashboard\\Rejected.js",[],"C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\components\\dashboard\\not-submitted\\index.js",["298","299"],"import { useEffect, useState } from \"react\";\r\nimport { ToastContainer, toast } from 'react-toastify';\r\nimport { submitDetails } from \"../../../api/dashboard/data\";\r\n\r\nimport arrow from \"../../../images/svg/dashboard/arrow.svg\";\r\nimport loader from \"../../../images/svg/dashboard/loader.gif\";\r\n\r\n\r\nfunction NotSubmitted ({fname, lname, phone, email, setNewStatus}) {\r\n    const [active, setActive] = useState(\"welcome\");\r\n    const [formActive, setFormActive] = useState(\"\");\r\n    const [userId, setUserId] = useState(0);\r\n    const [bioData, setBioData] = useState({\r\n        firstName: `${fname}`,\r\n        lastName: `${lname}`,\r\n        email: `${email}`,\r\n        phone: `${phone}`,\r\n        dob: \"\",\r\n        gender: \"\",\r\n        course: \"\",\r\n        state: \"\",\r\n        city: \"\",\r\n        id: null\r\n    });\r\n    const [education, setEducation] = useState({\r\n        courseOfStudy: \"\",\r\n        grade: \"\",\r\n        qualification: \"\",\r\n        experience: \"\",\r\n        nyscStatus: \"\",\r\n        reason: \"\",\r\n        availability: \"\",\r\n        legalFee: \"\"\r\n    });\r\n    \r\n    useEffect(()=>{\r\n        try {\r\n            let details = sessionStorage.getItem('user_details');\r\n            setUserId(JSON.parse(details).id);  \r\n        } catch (err) {\r\n            console.log()\r\n        }\r\n    })\r\n    const handleChange = (e) => {\r\n        setBioData({\r\n            ...bioData,\r\n            [e.target.name]: e.target.value\r\n        })\r\n        setEducation({\r\n            ...education,\r\n            [e.target.name]: e.target.value\r\n        })\r\n    }\r\n\r\n    const handleImage = (e) => {\r\n        setBioData({\r\n            ...bioData,\r\n            id: e.target.files[0]\r\n        })\r\n    }\r\n\r\n    const showForm = () => {\r\n        var check = document.getElementById(\"check\");\r\n        if(check.checked){\r\n            setActive(\"form\");\r\n            setFormActive(\"bio-data\")\r\n        } else {\r\n            toast.warn(\"You need to accept the terms and conditions to proceed!\")\r\n        }\r\n    }\r\n\r\n    const showEduForm = (e) => {\r\n        e.preventDefault();\r\n        setFormActive(\"education\")\r\n    }\r\n\r\n    const submitForm = (e) => {\r\n        e.preventDefault();\r\n        var btn = document.getElementById(\"actionBtn\");\r\n        btn.innerHTML = `<img src=${loader} width=\"20px\" />`;\r\n        var data  = new FormData();\r\n\r\n        // data.append(\"firstName\", bioData.firstName);\r\n        // data.append(\"lastName\", bioData.lastName);\r\n        // data.append(\"email\", bioData.email);\r\n        // data.append(\"phoneNumber\", bioData.phone);\r\n        data.append(\"dob\", bioData.dob);\r\n        data.append(\"gender\", bioData.gender);\r\n        data.append(\"preferred_course\", bioData.course);\r\n        data.append(\"state_of_residence\", bioData.state);\r\n        data.append(\"current_city_and_location\", bioData.city);\r\n        data.append(\"means_of_identification\", bioData.id);\r\n        data.append(\"course_of_study\", education.courseOfStudy);\r\n        data.append(\"grade_achieved\", education.grade);\r\n        data.append(\"qualifications\", education.qualification);\r\n        data.append(\"programming_skills\", education.experience);\r\n        data.append(\"nysc_status\", education.nyscStatus);\r\n        data.append(\"why_selected_for_cohort\", education.reason);\r\n        data.append(\"physically_available\", education.availability);\r\n        data.append(\"will_you_pay_legal_fees\", education.legalFee);\r\n        \r\n        submitDetails(data, userId)\r\n            .then((response) => response.data)\r\n            .then((res) => {\r\n                console.log(res);\r\n                if (res.status === 200) {\r\n                    toast.success(\"Submission successful! Your Application is now under review.\");\r\n                    btn.innerHTML = `Submit`;\r\n                    setNewStatus();\r\n                } else {\r\n                    toast.error(\"Submission not successful, try again!!!\")\r\n                    btn.innerHTML = `Submit`;\r\n                }\r\n            })\r\n            .catch((err) => {\r\n                console.log(err)\r\n                if(err.response){\r\n                    toast.error(err.response);\r\n                    btn.innerHTML = `Submit`;\r\n                } else{\r\n                    toast.error(\"Something went wrong!!! Please make sure you have a good internet connection.\");\r\n                    btn.innerHTML = `Submit`;\r\n                }\r\n            });\r\n        \r\n    }\r\n\r\n    return (\r\n        <div>\r\n            <ToastContainer closeButton={false}/>\r\n            {active === \"welcome\" &&\r\n                <div>\r\n                    <h3>Hello {fname}</h3>\r\n                    <p className=\"text1\">Learn with us for 5 months and pay no tuition till you’re hired!</p>\r\n                    <p>Grazac Accelerator Program is a full time, 5-month training program focused on building in-demand tech skills at an accelerated pace. This program goes above and beyond to provide a superior educational experience, allowing students to develop a successful career in the tech industry through intensive training and internships.</p>\r\n                    <p>Our curriculum covers 4 basic tech disciplines that includes;</p>\r\n                    <ul>\r\n                        <li>Product Designing (UI/UX)</li>\r\n                        <li>Front end web development (HTML, CSS, and Javascript (React.js)</li>\r\n                        <li>Back end web development (Nodejs)</li>\r\n                        <li>Mobile Application Development (Flutter and Dart)</li>\r\n                    </ul>\r\n                    <h4>Pricing Plans</h4>\r\n                    <p>Enrollment is free but for the tuition fee, we offer two basic forms of payment options and they are;</p>\r\n                    <ul>\r\n                        <li><strong>Pay as you Earn plan:</strong> This is a financial instrument to help you participate in our training for FREE. You are expected to start paying us back once you get a job at the end of the program. It is governed by a legally binding contract. This contract is bonded by the law firm.</li>\r\n                        <li><strong>Pay at once:</strong> You can pay your tuition fee all at once with this plan.</li>\r\n                    </ul>\r\n                    <h4>Duration</h4>\r\n                    <ul>\r\n                        <li>5months ( 3months intensive training + 2months internship).</li>\r\n                    </ul>\r\n                    <h4>Basic Criteria to be met</h4>\r\n                    <ul>\r\n                        <li>Candidates must be a Graduate and available full-time for at least 6 months.</li>\r\n                        <li>Note that you will be mandated to provide guarantors and pay the sum of #30,000 legal fee if selected for this cohort. This must be paid within a week after selection if you have chosen our Pay as you Earn option.</li>\r\n                    </ul>\r\n                    <div className=\"checkbox\">\r\n                        <input type=\"checkbox\" id=\"check\" />\r\n                        <p>I accept the <a href=\"#\">Terms ‌and‌ ‌Conditions‌</a></p>\r\n                    </div>\r\n                    <button className=\"button\" onClick={showForm}>Apply Now</button>\r\n                </div>\r\n            }\r\n            {active === \"form\"  &&\r\n                <div>\r\n                    <div>\r\n                        <div className=\"dashboard-content-back\" onClick={()=>setActive(\"welcome\")} >\r\n                            <img src={arrow} alt=\"back\" />\r\n                            <p>Back</p>\r\n                        </div>\r\n                        <h4 style={{marginLeft:\"20px\"}}>Apply</h4>\r\n                        {formActive === \"bio-data\" && (\r\n                            <div className=\"dashboard-content-form\">\r\n                                <form onSubmit={showEduForm}>\r\n                                    <p>Step 1 of 2</p>\r\n                                    <p>BIO DATA</p>\r\n                                    <div className=\"dashboard-content-form-container\">\r\n                                        <label>First Name</label>\r\n                                        <input type=\"text\" required name=\"firstName\" placeholder=\"FirstName\" value={bioData.firstName} onChange={handleChange} />\r\n                                    </div>\r\n                                    <div className=\"dashboard-content-form-container\">\r\n                                        <label>Last Name</label>\r\n                                        <input type=\"text\" required name=\"lastName\" placeholder=\"LastName\" value={bioData.lastName} onChange={handleChange} />\r\n                                    </div>\r\n                                    <div className=\"dashboard-content-form-container\">\r\n                                        <label>Email Address</label>\r\n                                        <input type=\"email\" required name=\"email\" placeholder=\"Email Address\" value={email} onChange={handleChange} />\r\n                                    </div>\r\n                                    <div className=\"dashboard-content-form-container\">\r\n                                        <label>Phone Number</label>\r\n                                        <input type=\"number\" required name=\"phone\" placeholder=\"Phone Number\" value={bioData.phone} onChange={handleChange} />\r\n                                    </div>\r\n                                    <div className=\"dashboard-content-form-container\">\r\n                                        <label>Date of Birth</label>\r\n                                        <input type=\"date\" required name=\"dob\" placeholder=\"31/01/2021\" onChange={handleChange} />\r\n                                    </div>\r\n                                    <div className=\"dashboard-content-form-container\">\r\n                                        <label>Gender</label>\r\n                                        <select name=\"gender\" required onChange={handleChange}>\r\n                                            <option>Select Gender</option>\r\n                                            <option value=\"male\">Male</option>\r\n                                            <option value=\"female\">Female</option>\r\n\r\n                                        </select>\r\n                                    </div>\r\n                                    <div className=\"dashboard-content-form-container\">\r\n                                        <label>Preferred course at Grazac</label>\r\n                                        <select name=\"course\" required onChange={handleChange}>\r\n                                            <option>Select Preferred Course</option>\r\n                                            <option value=\"Product Design\">Product Design</option>\r\n                                            <option value=\"Frontend Web Development\">Front-end Web Development</option>\r\n                                            <option value=\"Backend Web Development\">Back-end Web Development</option>\r\n                                            <option value=\"Android Development\">Android Development</option>\r\n                                        </select>\r\n                                    </div>\r\n                                    <div className=\"dashboard-content-form-container\">\r\n                                        <label>State of residence</label>\r\n                                        <select name=\"state\" required onChange={handleChange}>\r\n                                            <option>Select State</option>\r\n                                            <option value=\"Ogun\">Ogun</option>\r\n                                            <option value=\"Lagos\">Lagos</option>\r\n                                        </select>\r\n                                    </div>\r\n                                    <div className=\"dashboard-content-form-container\">\r\n                                        <label name=\"city\" onChange={handleChange}>Current city and Location</label>\r\n                                        <input type=\"text\" required name=\"city\" placeholder=\"Current City and Location\" onChange={handleChange} />\r\n                                    </div>\r\n                                    <div className=\"dashboard-content-form-container\">\r\n                                        <label>Means of Identification (NIN/ Voter's Card)</label>\r\n                                        <input type=\"file\" required  name=\"id\" accept=\"image/*\" onChange={handleImage}/>\r\n                                    </div>\r\n                                    <button style={{float:\"right\"}} type=\"submit\">Continue</button>\r\n                                </form>\r\n                            </div>\r\n                        )}\r\n                        \r\n                        {formActive === \"education\" && (\r\n                            <div className=\"dashboard-content-form\">\r\n                                <form onSubmit={submitForm}>\r\n                                    <p>Step 2 of 2</p>\r\n                                    <p>Educational Background</p>\r\n                                    <div className=\"dashboard-content-form-container\">\r\n                                        <label>Course of Study</label>\r\n                                        <input type=\"text\" required name=\"courseOfStudy\" placeholder=\"Course of Study\" onChange={handleChange} />\r\n                                    </div>\r\n                                    <div className=\"dashboard-content-form-container\">\r\n                                        <label>Grade Achieved</label>\r\n                                        <input type=\"text\" required name=\"grade\" placeholder=\"Grade Achieved\" onChange={handleChange} />\r\n                                    </div>\r\n                                    <div className=\"dashboard-content-form-container\">\r\n                                        <label>Qualification</label>\r\n                                        <select name=\"qualification\" required onChange={handleChange}>\r\n                                            <option value=\"\">Select Qualification</option>\r\n                                            <option value=\"B.Sc\">B.Sc</option>\r\n                                            <option value=\"ND\">ND</option>\r\n                                            <option value=\"HND\">HND</option>\r\n                                            <option value=\"M.Sc\">M.Sc</option>\r\n                                            <option value=\"PhD\">PhD</option>\r\n                                            <option value=\"other\">other</option>\r\n                                        </select>\r\n                                    </div>\r\n                                    <div className=\"dashboard-content-form-container\">\r\n                                        <label>Programming/Design Experience</label>\r\n                                        <select name=\"experience\" required onChange={handleChange}>\r\n                                            <option value=\"\">Select Programming/Design Experience</option>\r\n                                            <option value=\"No skill\">No skill</option>\r\n                                            <option value=\"Basic skill\">Basic skill</option>\r\n                                            <option value=\"Mid-level skill\">Mid-level Skill</option>\r\n                                        </select>\r\n                                    </div>\r\n                                    <div className=\"dashboard-content-form-container\">\r\n                                        <label>Nysc Status</label>\r\n                                        <select name=\"nyscStatus\" required onChange={handleChange}>\r\n                                            <option value=\"\">Select Nysc Status</option>\r\n                                            <option value=\"Service\">Service</option>\r\n                                            <option value=\"Exemption\">Exemption</option>\r\n                                            <option value=\"Use period to learn\">I will use my period of service to learn</option>\r\n                                            <option value=\"Other\">Other</option>\r\n                                        </select>\r\n                                    </div>\r\n                                    <div className=\"dashboard-content-form-container\">\r\n                                        <label>Why do you think you should be selected as a part of this cohort?</label>\r\n                                        <textarea type=\"text\" required name=\"reason\" placeholder=\"Write your reasons here...\" onChange={handleChange} />\r\n                                    </div>\r\n                                    <div className=\"dashboard-content-form-container\">\r\n                                        <label>Will you be physically available for the next 6 months?</label>\r\n                                        <select name=\"availability\" required onChange={handleChange}>\r\n                                            <option value=\"\">Select Availability</option>\r\n                                            <option value=\"Yes\">Yes</option>\r\n                                            <option value=\"No\">No</option>\r\n                                        </select>\r\n                                    </div>\r\n                                    <div className=\"dashboard-content-form-container\">\r\n                                        <label>If selected, will you be able to pay the legal fees of #30,000?</label>\r\n                                        <select name=\"legalFee\" required onChange={handleChange}>\r\n                                            <option value=\"\">Select</option>\r\n                                            <option value=\"Yes\">Yes</option>\r\n                                            <option value=\"No\">No</option>\r\n                                        </select>\r\n                                    </div>\r\n                                    <button style={{float:\"right\", width: \"50px\"}} type=\"submit\" id=\"actionBtn\">Submit</button>\r\n                                    <button className=\"dashboard-content-form-container-prev\" onClick={()=>setFormActive(\"bio-data\")}>Previous</button>\r\n                                </form>\r\n                            </div>\r\n                        )}\r\n                    </div>\r\n                </div>\r\n            }\r\n        </div>\r\n    )\r\n}\r\n\r\nexport default NotSubmitted;","C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\components\\dashboard\\UnderReview.js",[],"C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\components\\dashboard\\selected\\PaymentReceived.js",[],"C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\api\\dashboard\\auth.js",[],"C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\api\\dashboard\\apikit.js",[],"C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\api\\dashboard\\data.js",[],{"ruleId":"300","replacedBy":"301"},{"ruleId":"302","replacedBy":"303"},{"ruleId":"304","severity":1,"message":"305","line":8,"column":25,"nodeType":"306","messageId":"307","endLine":8,"endColumn":33},{"ruleId":"304","severity":1,"message":"308","line":103,"column":10,"nodeType":"306","messageId":"307","endLine":103,"endColumn":18},{"ruleId":"304","severity":1,"message":"309","line":103,"column":20,"nodeType":"306","messageId":"307","endLine":103,"endColumn":31},{"ruleId":"304","severity":1,"message":"310","line":1,"column":25,"nodeType":"306","messageId":"307","endLine":1,"endColumn":33},{"ruleId":"304","severity":1,"message":"311","line":2,"column":8,"nodeType":"306","messageId":"307","endLine":2,"endColumn":15},{"ruleId":"312","severity":1,"message":"313","line":96,"column":23,"nodeType":"314","endLine":96,"endColumn":49},{"ruleId":"312","severity":1,"message":"313","line":115,"column":21,"nodeType":"314","endLine":118,"endColumn":22},{"ruleId":"312","severity":1,"message":"313","line":149,"column":31,"nodeType":"314","endLine":149,"endColumn":34},{"ruleId":"312","severity":