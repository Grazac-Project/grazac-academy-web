 12.81 10.0243C11.3279 10.0243 11.0272 11.5461 10.9669 12.2291V17.3117C10.9669 17.5791 10.7502 17.7958 10.4828 17.7958H8.15681C7.88948 17.7958 7.67272 17.5791 7.67272 17.3117V7.83209C7.67272 7.56476 7.88948 7.34801 8.15681 7.34801H10.4828C10.7501 7.34801 10.9669 7.56476 10.9669 7.83209V8.65173C11.5164 7.82696 12.3332 7.19037 14.0722 7.19037C17.9231 7.19037 17.901 10.7881 17.901 12.7648V17.3117Z\" fill=\"#0077B7\"/>\r\n              </svg>\r\n\r\n              Linkedln\r\n            </Link>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default Login;","C:\\Users\\Dabiri Mayowa\\Desktop\\Grazac\\grazac-academy-web\\src\\utils.js",[],"C:\\Users\\Dabiri Mayowa\\Desktop\\Grazac\\grazac-academy-web\\src\\components\\Footer.js",["208","209","210","211"],"import { Link } from \"react-router-dom\";\r\nimport Facebook from \"../images/svg/facebook.svg\"\r\nimport Instagram from \"../images/svg/instagram.svg\"\r\nimport Twitter from \"../images/svg/twitter.svg\"\r\nimport Youtube from \"../images/svg/youtube.svg\"\r\nimport Logo from \"../images/svg/grazac-logo.svg\";\r\n\r\nconst Footer = () => {\r\n  return(\r\n    <div className=\"footer\">\r\n      <div className=\"footer__container\">\r\n        <div className=\"footer__links\">\r\n          <ul className=\"footer__list\">\r\n            <li className=\"footer__item footer__item--head\">\r\n              <div className=\"footer__logo\">\r\n                <img src={Logo} alt=\"logo\" />\r\n              </div>\r\n            </li>\r\n            <li className=\"footer__item\">Grazac Academy gives you the opportunity to learn in-demand skills to build your technology career.</li>\r\n            <li className=\"footer__item\"><a href=\"tel:+234806 836 5951\">+234 806 836 5951</a></li>\r\n          </ul>\r\n\r\n          <ul className=\"footer__list\">\r\n            <li className=\"footer__item footer__item--head\">Company</li>\r\n            <li className=\"footer__item\"><Link to=\"/about-us\">About</Link></li>\r\n            <li className=\"footer__item\"><Link to=\"/contact\">Contact Us</Link></li>\r\n          </ul>\r\n\r\n          <ul className=\"footer__list\">\r\n            <li className=\"footer__item footer__item--head\">Features</li>\r\n            <li className=\"footer__item\"><Link to=\"/nysc/coming-soon\">NYSC Members</Link></li>\r\n            <li className=\"footer__item\"><Link to=\"/careers/coming-soon\">Careers</Link></li>\r\n          </ul>\r\n\r\n          <ul className=\"footer__list\">\r\n            <li className=\"footer__item footer__item--head\">Teaching</li>\r\n            <li className=\"footer__item\"><Link to=\"/faq\">FAQ</Link></li>\r\n            {/* <li className=\"footer__item\"><Link>Book a Call</Link></li> */}\r\n            <li className=\"footer__item\"><Link to=\"/training/coming-soon\">Corporate Training</Link></li>\r\n            <li className=\"footer__item\"><Link to=\"/hire/coming-soon\">Grazac Hire</Link></li>\r\n          </ul>\r\n        </div>\r\n\r\n        <div className=\"footer__line\">&nbsp;</div>\r\n\r\n        <div className=\"footer__bottom\">\r\n          <Link>Privacy & Policy</Link>\r\n          <Link>Terms of Service</Link>\r\n\r\n          <p>©{new Date().getFullYear()} Grazac Technologies. All Rights Reserved</p>\r\n\r\n          <div className=\"footer__icons\">\r\n            <a><img src={Youtube} alt=\"icon\" /></a>\r\n            <a href=\"https://twitter.com/grazacacademy\" target=\"_blank\"><img src={Twitter} alt=\"icon\" /></a>\r\n            <a href=\"https://www.instagram.com/grazacacademy/\" target=\"_blank\"><img src={Instagram} alt=\"icon\" /></a>\r\n            <a><img src={Facebook} alt=\"icon\" /></a>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default Footer;","C:\\Users\\Dabiri Mayowa\\Desktop\\Grazac\\grazac-academy-web\\src\\components\\Navbar.js",["212","213"],"import { useEffect, useState, useRef } from \"react\";\r\nimport { cn } from \"../utils\";\r\nimport NavItem from \"./NavItem\";\r\nimport logo from \"../images/svg/grazac-logo.svg\";\r\nimport { Link } from \"react-router-dom\";\r\nimport InfoModal from \"../components/InfoModal\";\r\n\r\nconst Navbar = ({top}) => {\r\n  const [fixed, setFixed] = useState(false);\r\n  const [active, setActive] = useState(false);\r\n  const [hover, setHover] = useState(false);\r\n  const nav = useRef(null);\r\n\r\n  useEffect(() => {\r\n    /*if(top) {\r\n      let h = document.querySelector('.infomodal').offsetHeight;\r\n      console.log(h);\r\n      document.querySelector('nav.nav').style.marginTop = h+'px';\r\n    }*/\r\n    if (nav.current && window.pageYOffset > nav.current.offsetTop) {\r\n      setFixed(true);\r\n    } else {\r\n      setFixed(false);\r\n    }\r\n    window.addEventListener(\"scroll\", () => {\r\n      if (nav.current && window.pageYOffset > nav.current.offsetTop)\r\n        setFixed(true);\r\n      else setFixed(false);\r\n    });\r\n  }, []);\r\n\r\n  const handleClick = (e) => {\r\n    e.preventDefault();\r\n\r\n    if (active) setActive(false);\r\n    else setActive(true);\r\n  };\r\n\r\n  return (\r\n    <nav className={cn(\"nav\", { \"nav--fixed\": fixed })} ref={nav}>\r\n      <div className=\"nav__container\">\r\n        <div className=\"nav__logo\">\r\n          <Link to=\"/\">\r\n            <img src={logo} alt=\"logo\" />\r\n          </Link>\r\n        </div>\r\n\r\n        <div className={cn(\"nav__menu\", { \"nav__menu--active\": active })}>\r\n          <button className=\"nav-tgl\" onClick={handleClick}>\r\n            <span>&nbsp;</span>\r\n          </button>\r\n\r\n          <ul className=\"nav__list--mb\">\r\n            <li className=\"nav__item\">\r\n              <NavItem exact link=\"/\">\r\n              <span>01</span>Home\r\n              </NavItem>\r\n            </li>\r\n            <li className=\"nav__item\">\r\n              <NavItem link=\"/about-us\"><span>02</span>About</NavItem>\r\n            </li>\r\n            <li className=\"nav__item\">\r\n              <NavItem link=\"/undergraduate-accelerator-plan\"><span>03</span>Undergraduate</NavItem>\r\n            </li>\r\n            <li className=\"nav__item\">\r\n              <NavItem link=\"/graduate-accelerator-plan\"><span>04</span>Graduate</NavItem>\r\n            </li>\r\n            <li className=\"nav__item\">\r\n              <a href=\"/#tracks\">\r\n                <button onClick={() => setActive(false)}>Enroll Now</button>\r\n              </a>\r\n            </li>\r\n            <li className=\"nav__item\" style={{marginTop:'30px'}}>\r\n              <a href=\"tel:+2348068365951\">\r\n                <button onClick={() => setActive(false)}>Talk to us</button>\r\n              </a>\r\n            </li>\r\n          </ul>\r\n        </div>\r\n\r\n        <ul className=\"nav__list\" style={{ marginBottom: 0 }}>\r\n          <li className=\"nav__item\">\r\n            <NavItem exact link=\"/\">\r\n              Home\r\n            </NavItem>\r\n          </li>\r\n          <li className=\"nav__item\">\r\n            <NavItem link=\"/about-us\">About</NavItem>\r\n          </li>\r\n          <li\r\n            className=\"nav__item\"\r\n            style={{ position: \"relative\", cursor: \"pointer\" }}\r\n            onMouseEnter={() => setHover(true)}\r\n            onMouseLeave={() => setHover(false)}\r\n          >\r\n            <a className=\"nav__link\">\r\n              Academy\r\n            </a>\r\n            <svg\r\n              className=\"mask\"\r\n              width=\"11\"\r\n              height=\"6\"\r\n              viewBox=\"0 0 11 6\"\r\n              fill=\"none\"\r\n              xmlns=\"http://www.w3.org/2000/svg\"\r\n            >\r\n              <path\r\n                fillRule=\"evenodd\"\r\n                clipRule=\"evenodd\"\r\n                d=\"M5.50003 6C5.32089 6 5.14252 5.934 4.99716 5.80113L0.282791 1.51511C-0.0503581 1.21251