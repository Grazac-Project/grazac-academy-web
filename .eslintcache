2(e)}\r\n                  />\r\n                </div>\r\n                <hr />\r\n                <div className=\"dashboard-content-form-container\">\r\n                  <h5>Relationship with guarantor</h5>\r\n                  {/* <p>{guarantorDetails_2?.name_of_employer}</p> */}\r\n                  <input\r\n                    type=\"text\"\r\n                    name=\"name_of_employer\"\r\n                    value={guarantorDetails_2[0]?.name_of_employer}\r\n                    onChange={(e) => handleChange_2(e)}\r\n                  />\r\n                </div>\r\n                <hr />\r\n                <div className=\"dashboard-content-form-container\">\r\n                  <h5>Email Address of Employer</h5>\r\n                  {/* <p>{guarantorDetails_2?.email_address_of_employer}</p> */}\r\n                  <input\r\n                    type=\"text\"\r\n                    name=\"email_address_of_employer\"\r\n                    value={guarantorDetails_2[0]?.email_address_of_employer}\r\n                    onChange={(e) => handleChange_2(e)}\r\n                  />\r\n                </div>\r\n                <hr />\r\n                <div className=\"dashboard-content-form-container\">\r\n                  <h5>Phone Number of Employer</h5>\r\n                  {/* <p>{guarantorDetails_2?.phone_number_of_employer}</p> */}\r\n                  <input\r\n                    type=\"text\"\r\n                    name=\"phone_number_of_employer\"\r\n                    value={guarantorDetails_2[0]?.phone_number_of_employer}\r\n                    onChange={(e) => handleChange_2(e)}\r\n                  />\r\n                </div>\r\n                <hr />\r\n                <div className=\"dashboard-content-form-container\">\r\n                  <h5>Relationship with guarantor</h5>\r\n                  {/* <p>{guarantorDetails_2?.relationship_with_the_guarantor}</p> */}\r\n                  <input\r\n                    type=\"text\"\r\n                    name=\"relationship_with_the_guarantor\"\r\n                    value={\r\n                      guarantorDetails_2[0]?.relationship_with_the_guarantor\r\n                    }\r\n                    onChange={(e) => handleChange_2(e)}\r\n                  />\r\n                </div>\r\n\r\n                {/*  */}\r\n                {/*  */}\r\n                <button type=\"submit\">Save</button>\r\n              </form>\r\n            </div>\r\n          )}\r\n        </div>\r\n      )}\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default Details;\r\n","C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\academy-dashboard\\component\\carousel\\Carousel.jsx",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\academy-dashboard\\icons\\SettingsIcon.jsx",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\academy-dashboard\\icons\\ChallengeIcon.jsx",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\academy-dashboard\\icons\\PortfolioIcon.jsx",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\academy-dashboard\\icons\\PaymentIcon.jsx",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\academy-dashboard\\icons\\DashboardIcon.jsx",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\academy-dashboard\\component\\challenge\\challenges\\ChallengeProgress.jsx",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\academy-dashboard\\component\\shared\\profilecard\\ProfileCard.jsx",["474"],"import React from \"react\";\r\n\r\nfunction ProfileCard({ image, name, cohort }) {\r\n  return (\r\n    <div className=\"profilecard__container\">\r\n      <div className=\"profilecard-image\" >\r\n        <img src={image} />\r\n      </div>\r\n      <div className=\"profilecard-details\">\r\n        <div className=\"profilecard-details-name\">{name}</div>\r\n        <div className=\"profilecard-details-cohort\">COHORT {cohort}</div>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default ProfileCard;\r\n","C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\academy-dashboard\\component\\challenge\\challenges\\challengecard\\LockedChallenge.jsx",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\academy-dashboard\\component\\shared\\cohortcard\\CohortCard.jsx",["475","476","477","478"],"import React from \"react\";\r\nimport { RiArrowDropDownLine } from \"react-icons/ri\";\r\nimport { HiArrowSmDown } from \"react-icons/hi\";\r\nimport { MdArrowDropDown } from \"react-icons/md\";\r\nimport green from \"../../../../academy-dashboard/static/green.png\";\r\nimport DropDown from \"../../../icons/DropDown\";\r\n\r\nfunction CohortCard({ cohort, status }) {\r\n  return (\r\n    <div className=\"cohortcard__container\">\r\n      <div className=\"cohortcard-heading\">\r\n        <p>COHORT {cohort}</p>\r\n        <DropDown />\r\n      </div>\r\n\r\n      <div className=\"cohortcard-status\">\r\n        {/* <img style={{fontSize:'10px'}}  src={status === \"Admitted\" ? green : null} /> */}\r\n        <p>{status}</p>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default CohortCard;\r\n","C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\academy-dashboard\\component\\challenge\\challenges\\challengetext\\ChallengeText.jsx",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\academy-dashboard\\component\\challenge\\challenges\\challengecard\\ChallengeCard.jsx",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\components\\dashboard\\not-submitted\\AdmissionFeePage.jsx",["479","480","481","482"],"import React, { useState, useRef } from \"react\";\r\nimport termsandconds from \"../../../content/TermsandCondition.pdf\";\r\nimport {\r\n  useFlutterwave,\r\n  FlutterWaveButton,\r\n  closePaymentModal,\r\n} from \"flutterwave-react-v3\";\r\n\r\nfunction AdmissionFeePage({ details, fname, lname, email, phone }) {\r\n  const [checkAct, setCheckAct] = useState(false);\r\n  const buttonRef = useRef();\r\n\r\n  // test: \"FLWPUBK_TEST-b6c44d3213f2d2b3c0c3142f3ab81b72-X\",\r\n  // public_key: \"FLWPUBK-006bdc82ad878f1518af32f44af6478f-X\",\r\n\r\n  const AdmissionFeeFlutterwaveConfig = {\r\n    public_key: \"FLWPUBK-006bdc82ad878f1518af32f44af6478f-X\",\r\n    tx_ref: Date.now(),\r\n    amount: 15000,\r\n    currency: \"NGN\",\r\n    payment_options: \"card,mobilemoney,ussd\",\r\n    customer: {\r\n      email: `${details.email}`,\r\n      phonenumber: `${details.phone}`,\r\n      name: `${details.firstName} ${details.lastName}`,\r\n    },\r\n\r\n    customizations: {\r\n      title: \"Grazac Academy\",\r\n      description: \"Admission Fee Payment\",\r\n      logo: \"https://grazac.com.ng/assets/images/favicon.png\",\r\n    },\r\n  };\r\n\r\n  const HandleAdmissionPayFlutterPayment = useFlutterwave(\r\n    AdmissionFeeFlutterwaveConfig\r\n  );\r\n\r\n  const confirmCheck = () => {\r\n    var check = document.getElementById(\"check\");\r\n    if (check.checked) {\r\n      setCheckAct(true);\r\n    } else {\r\n      setCheckAct(false);\r\n    }\r\n  };\r\n\r\n  return (\r\n    <div>\r\n      <h3>Hello {fname}</h3>\r\n      <h4>Welcome to Grazac Academy</h4>\r\n      <p>We can’t wait to help you kickstart your career in tech!</p>\r\n\r\n      <p>\r\n        To start your application, you are required to pay a non-refundable fee\r\n        of 15,000 naira only.\r\n      </p>\r\n\r\n      <p>\r\n        As part of your registration process, assessment and interview will be\r\n        conducted, the schedule will be communicated to you via your registered\r\n        email address within 7 days after payment of the registration fee.\r\n        Please note that It is important that you do not miss the assessment\r\n        interview. Kindly check your email regularly for updates.\r\n      </p>\r\n\r\n      <p>We look forward to being a part of your growth.</p>\r\n\r\n      <button\r\n        className={\"button\"}\r\n        ref={buttonRef}\r\n        onClick={() => {\r\n          HandleAdmissionPayFlutterPayment({\r\n            callback: (response) => {\r\n              console.log(response.status);\r\n              closePaymentModal(); // this will close the modal programmatically\r\n              window.location = \"/login\";\r\n            },\r\n            onClose: () => {\r\n              window.location = \"/login\";\r\n            },\r\n          });\r\n        }}\r\n      >\r\n        Proceed To Pay\r\n      </button>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default AdmissionFeePage;\r\n","C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\utils.js",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\components\\NavItem.js",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\components\\InfoModal.js",["483"],"import { useState } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport badge from \"../images/svg/badge.svg\";\r\nimport ex from \"../images/svg/x-mark.svg\";\r\n\r\nconst InfoModal = () => {\r\n  const [showModal, setShowModal] = useState(true);\r\n\r\n  return (\r\n    <div>\r\n        <div className=\"infomodal\">\r\n          <div className=\"infomodal_content\">\r\n            <img src={badge} alt=\"\" />\r\n            <p>\r\n              Grazac Graduate Accelerator Program is closed for enrollment., You\r\n              can apply for internship positions\r\n            </p>\r\n            <Link to=\"/internship\">\r\n              <button>Enroll</button>\r\n            </Link>\r\n            <img\r\n              src={ex}\r\n              alt=\"\"\r\n              onClick={() => setShowModal(false)}\r\n              style={{ cursor: \"pointer\" }}\r\n            />\r\n          </div>\r\n        </div>\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default InfoModal;\r\n","C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\api\\dashboard\\apikit.js",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\components\\dashboard\\not-submitted\\index.js",["484","485","486","487","488","489","490","491"],"import { useEffect, useState } from \"react\";\r\nimport { ToastContainer, toast } from \"react-toastify\";\r\nimport { submitDetails } from \"../../../api/dashboard/data\";\r\nimport axios from \"axios\";\r\n\r\nimport arrow from \"../../../images/svg/dashboard/arrow.svg\";\r\nimport upload from \"../../../images/svg/upload.svg\";\r\nimport loader from \"../../../images/svg/dashboard/loader.gif\";\r\nimport about from \"../../../images/about-1.jpg\";\r\nimport termsandconds from \"../../../images/newsletter/terms.pdf\";\r\nimport pricingPolicy from \"../../../images/newsletter/pricing.pdf\";\r\n\r\nfunction NotSubmitted({\r\n  fname,\r\n  lname,\r\n  phone,\r\n  email,\r\n  setNewStatus,\r\n  userDetails,\r\n}) {\r\n  const [active, setActive] = useState(\"welcome\");\r\n  const [formActive, setFormActive] = useState(\"\");\r\n\r\n  // const [isError, setIsError] = useState(\"\");\r\n  // const [formActive, setFormActive] = useState(\"education\");\r\n\r\n  const [userId, setUserId] = useState(0);\r\n  const [checkAct, setCheckAct] = useState(false);\r\n  const [nigerianStates, setNigerianStates] = useState([]);\r\n  const [bioData, setBioData] = useState({\r\n    firstName: `${fname}`,\r\n    lastName: `${lname}`,\r\n    email: `${email}`,\r\n    phone: `${phone}`,\r\n    phone: \"\",\r\n    dob: \"\",\r\n    gender: \"\",\r\n    maritalStatus: \"\",\r\n    haveKids: \"\",\r\n    ageRange: \"\",\r\n    course: \"\",\r\n    state: \"\",\r\n    city: \"\",\r\n    id: \"\",\r\n  });\r\n\r\n  const [education, setEducation] = useState({\r\n    courseOfStudy: \"\",\r\n    grade: \"\",\r\n    qualification: \"\",\r\n    experience: \"\",\r\n    nyscStatus: \"\",\r\n    reason: \"\",\r\n    availability: \"\",\r\n    legalFee: \"\",\r\n  });\r\n  //   setBioData(userDetails)\r\n\r\n  window.onload = (event) => {\r\n    // removeQuestions();\r\n    setBioData(userDetails);\r\n  };\r\n\r\n  useEffect(() => {\r\n    try {\r\n      let details = sessionStorage.getItem(\"user_details\");\r\n      setUserId(JSON.parse(details).id);\r\n    } catch (err) {}\r\n    // setBioData(userDetails)\r\n\r\n    axios\r\n      .get(\"https://nigerian-states-info.herokuapp.com/api/v1/states\")\r\n      .then((response) => {\r\n        setNigerianStates(response.data.data);\r\n      });\r\n\r\n    {\r\n      nigerianStates.length === 0 &&\r\n        axios\r\n          .post(\"https://countriesnow.space/api/v0.1/countries/states\", {\r\n            country: \"Nigeria\",\r\n          })\r\n          .then((response) => {\r\n            setNigerianStates(response.data.data.states);\r\n          });\r\n    }\r\n  }, []);\r\n\r\n  //   setBioData(userDetails)\r\n\r\n  const handleChange = (e) => {\r\n    setBioData({\r\n      ...bioData,\r\n      [e.target.name]: e.target.value,\r\n    });\r\n\r\n    setEducation({\r\n      ...education,\r\n      [e.target.name]: e.target.value,\r\n    });\r\n  };\r\n\r\n  const handleImage = (e) => {\r\n    if (e.target.files[0].size > 2097152) {\r\n      toast.error(\"File too large! A maximum of 2MB is allowed.\");\r\n    } else {\r\n      //   setBioData({\r\n      //     ...bioData,\r\n      //     id: e.target.files[0],\r\n      //   });\r\n    }\r\n  };\r\n\r\n  const confirmCheck = () => {\r\n    var check = document.getElementById(\"check\");\r\n    if (check.checked) {\r\n      setCheckAct(true);\r\n    } else {\r\n      setCheckAct(false);\r\n    }\r\n  };\r\n\r\n  const showForm = () => {\r\n    // toast.info(\"Application for this cohort has ended. Please check back later!!!\")\r\n    var check = document.getElementById(\"check\");\r\n    if (check.checked) {\r\n      setActive(\"form\");\r\n      setFormActive(\"bio-data\");\r\n    } else {\r\n      toast.warn(\"You need to accept the terms and conditions to proceed!\");\r\n    }\r\n  };\r\n\r\n  const showEduForm = (e) => {\r\n    e.preventDefault();\r\n    setFormActive(\"education\");\r\n  };\r\n\r\n  const submitForm = (e) => {\r\n    e.preventDefault();\r\n    var btn = document.getElementById(\"actionBtn\");\r\n    btn.innerHTML = `<img src=${loader} width=\"20px\" />`;\r\n    var data = new FormData();\r\n\r\n    try {\r\n      //  btn.innerHTML = `Submit`;\r\n      btn.innerHTML = `<img src=${loader} width=\"20px\" />`;\r\n      if (!(bioData.phone.length > 10)) {\r\n        btn.innerHTML = `Submit`;\r\n        toast.error(\"please check enter a valid phone number\");\r\n      } else {\r\n        // btn.innerHTML = `Submit`;\r\n        btn.innerHTML = `<img src=${loader} width=\"20px\" />`;\r\n        // toast.success('Successful')\r\n        data.append(\"firstName\", bioData.firstName);\r\n        data.append(\"lastName\", bioData.lastName);\r\n        data.append(\"email\", bioData.email);\r\n        data.append(\"phoneNumber\", bioData.phone);\r\n        data.append(\"dob\", bioData.dob);\r\n        data.append(\"gender\", bioData.gender);\r\n        data.append(\"preferred_course\", bioData.course);\r\n        data.append(\"state_of_residence\", bioData.state);\r\n        data.append(\"current_city_and_location\", bioData.city);\r\n        // data.append(\"means_of_identification\", bioData.id);\r\n        data.append(\"maritalStatus\", bioData.maritalStatus);\r\n        data.append(\"haveKids\", bioData.haveKids);\r\n        data.append(\"ageRange\", bioData.ageRange);\r\n        data.append(\"course_of_study\", education.courseOfStudy);\r\n        data.append(\"grade_achieved\", education.grade);\r\n        data.append(\"qualifications\", education.qualification);\r\n        data.append(\"programming_skills\", education.experience);\r\n        data.append(\"nysc_status\", education.nyscStatus);\r\n        data.append(\"why_selected_for_cohort\", education.reason);\r\n        data.append(\"physically_available\", education.availability);\r\n        data.append(\"will_you_pay_legal_fees\", education.legalFee);\r\n        console.log(data);\r\n      }\r\n    } catch (err) {\r\n      toast.error(\"please check enter a valid phone number\");\r\n      btn.innerHTML = `Submit`;\r\n    }\r\n\r\n    submitDetails(data, userId)\r\n      .then((response) => response.data)\r\n      .then((res) => {\r\n        if (res.status === 200) {\r\n          toast.success(\r\n            \"Submission successful! Your Application is now under review.\"\r\n          );\r\n          btn.innerHTML = `Submit`;\r\n          setNewStatus();\r\n        } else {\r\n          toast.error(\"Submission not successful, try again!!!\");\r\n          btn.innerHTML = `Submit`;\r\n        }\r\n      })\r\n\r\n      .catch((err) => {\r\n        try {\r\n          if (err.response.data === \"File size limit has been reached\") {\r\n            toast.error(\"File size exceeded for Means of Identification Field\");\r\n          }\r\n          if (err.response) {\r\n            toast.error(err.response);\r\n            btn.innerHTML = `Submit`;\r\n          } else {\r\n            toast.error(\r\n              \"Something went wrong!!! Please make sure you have a good internet connection.\"\r\n            );\r\n            btn.innerHTML = `Submit`;\r\n          }\r\n        } catch {\r\n          toast.error(\"Something went wrong!!! Please Try Again\");\r\n          btn.innerHTML = `Submit`;\r\n        }\r\n      });\r\n  };\r\n\r\n  return (\r\n    <div>\r\n      {/* {setBioData(userDetails)} */}\r\n      <ToastContainer closeButton={false} />\r\n      {active === \"welcome\" && (\r\n        <div>\r\n          <h3>Hello {fname}</h3>\r\n          <p className=\"text1\">\r\n            Thank you for choosing to build your career in tech with us!\r\n          </p>\r\n          <p>\r\n            Grazac Academy is at the forefront of upskilling and connecting\r\n            youths to opportunities in the technology industry and our primary\r\n            goal is to have connected a minimum of 1,000 youths to jobs by 2026.\r\n          </p>\r\n          <p>\r\n            You can choose to learn virtually or physically with us. This\r\n            program goes above and beyond to provide a superior educational\r\n            experience, allowing students to develop a successful career in the\r\n            tech industry through intensive training and internships.{\" \"}\r\n          </p>\r\n          <p>Our curriculum covers 5 basic tech disciplines that includes;</p>\r\n          <ul>\r\n            <li>Product Designing (UI/UX)</li>\r\n            <li>Product Management</li>\r\n            <li>\r\n              Front end web development (HTML, CSS, and Javascript (React.js)\r\n            </li>\r\n            <li>Back end web development (Nodejs)</li>\r\n            <li>Mobile Application Development (Flutter and Dart)</li>\r\n          </ul>\r\n          <h4>Pricing Plans</h4>\r\n          <p>Basic Criteria to be met</p>\r\n          <ul>\r\n            <li>Candidates must pass our assessment test</li>\r\n            <li>\r\n              Candidates must have strong ability to think and a strong learning\r\n              mindset\r\n            </li>\r\n            <li>\r\n              Candidates must be a Graduate or available full-time for at least\r\n              6 months.\r\n            </li>\r\n          </ul>\r\n          <h4>Physical Learning</h4>\r\n          <h5>Duration</h5>\r\n          <ul>\r\n            <li>\r\n              6 months ( 3 months intensive training + 3 months internship).\r\n            </li>\r\n          </ul>\r\n          <p>\r\n            Application fee is a non-refundable fee of 15,000 naira only the\r\n            tuition fee is 500,000 naira only, we offer two basic forms of\r\n            payment options and they are;\r\n          </p>\r\n          <ul>\r\n            <li>\r\n              <strong>Pay at once: </strong> You can pay your tuition fee all at\r\n              once with this plan. 6 months ( 3 months intensive training + 3\r\n              months internship).\r\n            </li>\r\n            <li>\r\n              <strong>Pay in instalments: </strong> We also have a plan that\r\n              allows you to pay in instalments. If you choose this, you are\r\n              expected to pay N300,000 immediately and spread the rest over 5\r\n              months of your training. This comes with a 10% interest on the\r\n              tuition fee.\r\n            </li>\r\n            {/* <li>\r\n              <strong>Learn now. Pay later (or ‘pay as you earn): </strong>You\r\n              can also decide to learn now and start paying back when you get a\r\n              job after your training. If you choose this, you would be required\r\n              to pay a non-refundable legal fee of N50,000 immediately and after\r\n              your training, you are expected to pay back the sum of 1500\r\n              dollars (which would be an equivalent to the black dollar rate at\r\n              the time that you start paying back) in 18 months after securing a\r\n              job following our repayment procedure\r\n            </li> */}\r\n          </ul>\r\n\r\n          {/* <h4>Virtual Learning</h4>\r\n          <h5>Duration</h5>\r\n          <ul>\r\n            <li>2 months </li>\r\n          </ul>\r\n          <p>\r\n            Application fee is a non-refundable fee of 15,000 naira only and the\r\n            learning fee is 90,000 naira only, we offer only one form of payment\r\n          </p>\r\n          <ul>\r\n            <li>\r\n              <strong>Pay at once: </strong> You can only pay your tuition fee\r\n              all at once with this plan\r\n            </li>{\" \"}\r\n          </ul> */}\r\n\r\n          <div className=\"checkbox\">\r\n            <input type=\"checkbox\" id=\"check\" onClick={confirmCheck} />\r\n            <p>\r\n              I accept the{\" \"}\r\n              <a href={termsandconds} download target=\"_blank\">\r\n                Terms ‌and‌ ‌Conditions‌\r\n              </a>{\" \"}\r\n              and{\" \"}\r\n              <a href={pricingPolicy} download target=\"_blank\">\r\n                Pricing Policy\r\n              </a>\r\n            </p>\r\n          </div>\r\n          <button\r\n            className={!checkAct ? \"disable-btn\" : \"button\"}\r\n            onClick={showForm}\r\n          >\r\n            Apply Now\r\n          </button>\r\n        </div>\r\n      )}\r\n      {active === \"form\" && (\r\n        <div>\r\n          <div>\r\n            {formActive === \"bio-data\" && (\r\n              <div>\r\n                <div\r\n                  className=\"dashboard-content-back\"\r\n                  onClick={() => {\r\n                    setActive(\"welcome\");\r\n                    setCheckAct(false);\r\n                  }}\r\n                >\r\n                  <img src={arrow} alt=\"back\" />\r\n                  <p>Back</p>\r\n                </div>\r\n                <h4 style={{ marginLeft: \"20px\" }}>Apply</h4>\r\n                <div className=\"dashboard-content-form\">\r\n                  <form onSubmit={showEduForm}>\r\n                    {/* <form onSubmit={submitForm}> */}\r\n                    <p>Step 1 of 2</p>\r\n                    <p>BIO DATA</p>\r\n                    <div className=\"dashboard-content-form-container\">\r\n                      <label>First Name</label>\r\n                      <input\r\n                        type=\"text\"\r\n                        required\r\n                        name=\"firstName\"\r\n                        placeholder=\"FirstName\"\r\n                        value={bioData.firstName}\r\n                        onChange={handleChange}\r\n                      />\r\n                    </div>\r\n                    <div className=\"dashboard-content-form-container\">\r\n                      <label>Last Name</label>\r\n                      <input\r\n                        type=\"text\"\r\n                        required\r\n                        name=\"lastName\"\r\n                        placeholder=\"LastName\"\r\n                        value={bioData.lastName}\r\n                        onChange={handleChange}\r\n                      />\r\n                    </div>\r\n                    <div className=\"dashboard-content-form-container\">\r\n                      <label>Email Address</label>\r\n                      <input\r\n                        type=\"email\"\r\n                        required\r\n                        name=\"email\"\r\n                        placeholder=\"Email Address\"\r\n                        value={email}\r\n                        onChange={handleChange}\r\n                      />\r\n                    </div>\r\n                    <div className=\"dashboard-content-form-container\">\r\n                      <label>Phone Number</label>\r\n                      <input\r\n                        type=\"number\"\r\n                        required\r\n                        name=\"phone\"\r\n                        placeholder=\"Phone Number\"\r\n                        value={bioData.phone}\r\n                        onChange={handleChange}\r\n                      />\r\n                    </div>\r\n                    <div className=\"dashboard-content-form-container\">\r\n                      <label>Date of Birth</label>\r\n                      <input\r\n                        type=\"date\"\r\n                        required\r\n                        name=\"dob\"\r\n                        placeholder=\"31/01/2021\"\r\n                        value={bioData.dob}\r\n                        onChange={handleChange}\r\n                      />\r\n                    </div>\r\n                    <div className=\"dashboard-content-form-container\">\r\n                      <label>Gender</label>\r\n                      <select\r\n                        required\r\n                        name=\"gender\"\r\n                        value={bioData.gender}\r\n                        onChange={handleChange}\r\n                      >\r\n                        <option value=\"\">Select an option</option>\r\n                        <option value=\"male\">Male</option>\r\n                        <option value=\"female\">Female</option>\r\n                      </select>\r\n                    </div>\r\n\r\n                    <div className=\"dashboard-content-form-container\">\r\n                      <label>Marital Status</label>\r\n                      <select\r\n                        required\r\n                        name=\"maritalStatus\"\r\n                        value={bioData.maritalStatus}\r\n                        onChange={handleChange}\r\n                      >\r\n                        <option value=\"\">Select an option</option>\r\n                        <option value=\"single\">Single</option>\r\n                        <option value=\"married\">Married</option>\r\n                      </select>\r\n                    </div>\r\n\r\n                    {/* kid status */}\r\n                    <div className=\"dashboard-content-form-container\">\r\n                      <label>Do you have Kids</label>\r\n                      <select\r\n                        required\r\n                        name=\"haveKids\"\r\n                        value={bioData.haveKids}\r\n                        onChange={handleChange}\r\n                      >\r\n                        <option value=\"\">Select an option</option>\r\n                        <option value=\"yes\">Yes</option>\r\n                        <option value=\"no\">No</option>\r\n                      </select>\r\n                    </div>\r\n                    {/* age range */}\r\n                    <div className=\"dashboard-content-form-container\">\r\n                      <label>What's Your Age Range?</label>\r\n                      <select\r\n                        required\r\n                        name=\"ageRange\"\r\n                        value={bioData.ageRange}\r\n                        onChange={handleChange}\r\n                      >\r\n                        <option value=\"\">Select an option</option>\r\n                        <option value=\"18 - 24\">18 - 24</option>\r\n                        <option value=\"25 - 30\">25 - 30</option>\r\n                        <option value=\"31 - 35\">31 - 35</option>\r\n                        <option value=\"36 and above\">36 and above</option>\r\n                      </select>\r\n                    </div>\r\n\r\n                    <div className=\"dashboard-content-form-container\">\r\n                      <label>Preferred course at Grazac</label>\r\n\r\n                      <select\r\n                        required\r\n                        name=\"course\"\r\n                        value={bioData.course}\r\n                        onChange={handleChange}\r\n                      >\r\n                        <option value=\"\">Select Preferred Course</option>\r\n                        <option value=\"Product Design\">Product Design</option>\r\n                        <option value=\"Frontend Web Development\">\r\n                          Front-end Web Development\r\n                        </option>\r\n                        <option value=\"Backend Web Development\">\r\n                          Back-end Web Development\r\n                        </option>\r\n                        <option value=\"Android Development\">\r\n                          Android Development\r\n                        </option>\r\n                        <option value=\"Product Management\">\r\n                          Product Management\r\n                        </option>\r\n                      </select>\r\n                    </div>\r\n                    <div className=\"dashboard-content-form-container\">\r\n                      <label>State of residence</label>\r\n                      <select\r\n                        required\r\n                        name=\"state\"\r\n                        value={bioData.state}\r\n                        onChange={handleChange}\r\n                      >\r\n                        <option value=\"\">Select State</option>\r\n                        {nigerianStates.map(function (nigerianStates, index) {\r\n                          return (\r\n                            <option\r\n                              value={\r\n                                nigerianStates?.name || nigerianStates?.Name\r\n                              }\r\n                              key={index}\r\n                            >\r\n                              {nigerianStates?.name || nigerianStates?.Name}\r\n                            </option>\r\n                          );\r\n                        })}\r\n                      </select>\r\n                    </div>\r\n                    <div className=\"dashboard-content-form-container\">\r\n                      <label name=\"city\" onChange={handleChange}>\r\n                        Current city and Location\r\n                      </label>\r\n                      <input\r\n                        type=\"text\"\r\n                        required\r\n                        name=\"city\"\r\n                        value={bioData.city}\r\n                        placeholder=\"Current City and Location\"\r\n                        onChange={handleChange}\r\n                      />\r\n                    </div>\r\n\r\n                    {/* <div className=\"dashboard-content-form-container\">\r\n                      <label>\r\n                        Means of Identification (NIN / Voter's Card / Driver’s\r\n                        License / Green Passport)\r\n                      </label>\r\n\r\n                      <input\r\n                        required\r\n                        type=\"file\"\r\n                        name=\"id\"\r\n                        onChange={handleImage}\r\n                      />\r\n\r\n                      <p className=\"upload-text\">\r\n                        {bioData.id\r\n                          ? `${bioData.id.name}`\r\n                          : \"Upload means of identification (max 2MB file size)\"}\r\n                      </p>\r\n                      <img src={upload} alt=\"upload\" className=\"upload-img\" />\r\n                    </div>   */}\r\n\r\n                    <button style={{ float: \"right\" }} type=\"submit\">\r\n                      Continue\r\n                    </button>\r\n                  </form>\r\n                </div>\r\n              </div>\r\n            )}\r\n\r\n            {formActive === \"education\" && (\r\n              <div>\r\n                <div\r\n                  className=\"dashboard-content-back\"\r\n                  onClick={() => setFormActive(\"bio-data\")}\r\n                >\r\n                  <img src={arrow} alt=\"back\" />\r\n                  <p>Back</p>\r\n                </div>\r\n                <h4 style={{ marginLeft: \"20px\" }}>Apply</h4>\r\n                <div className=\"dashboard-content-form\">\r\n                  <form onSubmit={submitForm}>\r\n                    <p>Step 2 of 2</p>\r\n                    <p>Educational Background</p>\r\n                    <div className=\"dashboard-content-form-container\">\r\n                      <label>Course of Study</label>\r\n                      <input\r\n                        type=\"text\"\r\n                        required\r\n                        name=\"courseOfStudy\"\r\n                        value={education.courseOfStudy}\r\n                        placeholder=\"Course of Study\"\r\n                        onChange={handleChange}\r\n                      />\r\n                    </div>\r\n                    <div className=\"dashboard-content-form-container\">\r\n                      <label>Grade Achieved</label>\r\n                      <input\r\n                        type=\"text\"\r\n                        required\r\n                        name=\"grade\"\r\n                        value={education.grade}\r\n                        placeholder=\"Grade Achieved\"\r\n                        onChange={handleChange}\r\n                      />\r\n                    </div>\r\n                    <div className=\"dashboard-content-form-container\">\r\n                      <label>Qualification</label>\r\n                      <select\r\n                        name=\"qualification\"\r\n                        value={education.qualification}\r\n                        required\r\n                        onChange={handleChange}\r\n                      >\r\n                        <option value=\"\">Select Qualification</option>\r\n                        <option value=\"B.Sc\">B.Sc</option>\r\n                        <option value=\"ND\">ND</option>\r\n                        <option value=\"HND\">HND</option>\r\n                        <option value=\"M.Sc\">M.Sc</option>\r\n                        <option value=\"PhD\">PhD</option>\r\n                        <option value=\"other\">other</option>\r\n                      </select>\r\n                    </div>\r\n                    <div className=\"dashboard-content-form-container\">\r\n                      <label>Programming/Design Experience</label>\r\n                      <select\r\n                        name=\"experience\"\r\n                        value={education.experience}\r\n                        required\r\n                        onChange={handleChange}\r\n                      >\r\n                        <option value=\"\">\r\n                          Select Programming/Design Experience\r\n                        </option>\r\n                        <option value=\"No skill\">No skill</option>\r\n                        <option value=\"Basic skill\">Basic skill</option>\r\n                        <option value=\"Mid-level skill\">Mid-level Skill</option>\r\n                      </select>\r\n                    </div>\r\n                    <div className=\"dashboard-content-form-container\">\r\n                      <label>Nysc Status</label>\r\n                      <select\r\n                        name=\"nyscStatus\"\r\n                        value={education.nyscStatus}\r\n                        required\r\n                        onChange={handleChange}\r\n                      >\r\n                        <option value=\"\">Select Nysc Status</option>\r\n                        <option value=\"Service\">Completed</option>\r\n                        <option value=\"Exemption\">Exemption</option>\r\n                        <option value=\"Use period to learn\">\r\n                          I will use my period of service to learn\r\n                        </option>\r\n                        <option value=\"nd_graduate\">ND Graduate</option>\r\n                        <option value=\"ud_graduate\">Under Graduate</option>\r\n                        <option value=\"other\">Other</option>\r\n                      </select>\r\n                    </div>\r\n                    <div className=\"dashboard-content-form-container\">\r\n                      <label>\r\n                        Why do you think you should be selected as a part of\r\n                        this cohort?\r\n                      </label>\r\n                      <textarea\r\n                        type=\"text\"\r\n                        required\r\n                        name=\"reason\"\r\n                        value={education.reason}\r\n                        placeholder=\"Write your reasons here...\"\r\n                        onChange={handleChange}\r\n                      />\r\n                    </div>\r\n                    <div className=\"dashboard-content-form-container\">\r\n                      <label>\r\n                        Will you be available physically or virtually for the\r\n                        trainning?\r\n                      </label>\r\n                      <select\r\n                        name=\"availability\"\r\n                        value={education.availability}\r\n                        required\r\n                        onChange={handleChange}\r\n                      >\r\n                        <option value=\"\">Select Availability</option>\r\n                        <option value=\"Yes\">Yes</option>\r\n                        <option value=\"No\">No</option>\r\n                      </select>\r\n                    </div>\r\n                    <div className=\"dashboard-content-form-container\">\r\n                      <label>\r\n                        If selected, will you be able to pay the tuition fee?\r\n                      </label>\r\n                      <select\r\n                        name=\"legalFee\"\r\n                        value={education.legalFee}\r\n                        required\r\n                        onChange={handleChange}\r\n                      >\r\n                        <option value=\"\">Select</option>\r\n                        <option value=\"Yes\">Yes</option>\r\n                        <option value=\"No\">No</option>\r\n                      </select>\r\n                    </div>\r\n                    <button\r\n                      style={{ float: \"right\", width: \"50px\" }}\r\n                      type=\"submit\"\r\n                      id=\"actionBtn\"\r\n                    >\r\n                      Submit\r\n                    </button>\r\n                    <button\r\n                      className=\"dashboard-content-form-container-prev\"\r\n                      onClick={() => setFormActive(\"bio-data\")}\r\n                    >\r\n                      Previous\r\n                    </button>\r\n                  </form>\r\n                </div>\r\n              </div>\r\n            )}\r\n          </div>\r\n        </div>\r\n      )}\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default NotSubmitted;\r\n","C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\academy-dashboard\\component\\dashboard\\Progress\\Progress.jsx",["492","493"],"import React from \"react\";\r\nimport \"./styles.css\";\r\nimport ProgressBar from \"@ramonak/react-progress-bar\";\r\n\r\nexport const CustomProgressbar = ({\r\n  displayLabel,\r\n  height,\r\n  bgColor,\r\n  completed,\r\n  maxCompleted,\r\n}) => {\r\n  return (\r\n    <ProgressBar\r\n      bgColor={bgColor}\r\n      isLabelVisible={displayLabel}\r\n      height={height}\r\n      completed={completed}\r\n      maxCompleted={maxCompleted}\r\n    />\r\n  );\r\n};\r\n\r\nconst Progress = ({ title, price, current, maximum, bgColor }) => {\r\n  const [colorState, setColorState] = React.useState(bgColor);\r\n  const [showPay, setShowPay] = React.useState();\r\n  return (\r\n    <div\r\n      style={{ background: `${colorState}` }}\r\n      onMouseOver={() => setShowPay(true)}\r\n      onMouseLeave={() => setShowPay(false)}\r\n      className=\"mini-progress__card\"\r\n    >\r\n      {showPay ? (\r\n        <>\r\n          <PayCard />\r\n        </>\r\n      ) : (\r\n        <>\r\n          <h2>{title} Progress</h2>\r\n\r\n          <div className=\"mini-progress__card-information\">\r\n            <span className=\"sub-heading\">\r\n              <span class=\"values\">\r\n                {price && \"$\"}\r\n                {current}\r\n              </span>\r\n              /{maximum}\r\n            </span>\r\n            <span class=\"caption\">{title} Completed</span>\r\n          </div>\r\n\r\n          <div className=\"mini-progress__card-information\">\r\n            <span className=\"values sub-heading\">\r\n              {Math.floor((current / maximum) * 100)}\r\n            </span>\r\n            <span className=\"caption\">%Completed</span>\r\n          </div>\r\n\r\n          <div>\r\n            <CustomProgressbar\r\n              completed={current}\r\n              maxCompleted={maximum}\r\n              bgColor={\"#773DD3\"}\r\n              height={\"5px\"}\r\n              displayLabel={false}\r\n            />\r\n          </div>\r\n        </>\r\n      )}\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default Progress;\r\n\r\nconst PayCard = ({}) => {\r\n  return (\r\n    <div className=\"paycard__container\">\r\n      <button>Pay</button>\r\n    </div>\r\n  );\r\n};\r\n","C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\academy-dashboard\\component\\dashboard\\Learning\\LearningProgress.jsx",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\academy-dashboard\\icons\\DropDown.jsx",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\academy-dashboard\\component\\shared\\textcomponent\\TextComponent.jsx",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\academy-dashboard\\component\\shared\\button\\Button.jsx",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\pages\\newsletterModal\\newsletterModal.js",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\pages\\newsletterModal\\newsForm\\newsform.js",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\pages\\newsletterModal\\newsResponse\\newsResponse.js",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\components\\pricing\\pricing.js",[],"C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\components\\whatsApp\\whatsApp.js",["494"],"import React from \"react\";\r\nimport { ReactComponent as WhatsAppIcon } from \"../../images/newsletter/whatsapp.svg\";\r\nimport classes from \"./whatsApp.module.css\";\r\n\r\nconst WhatsApp = () => {\r\n  return (\r\n    <>\r\n      <a\r\n        href=\"https://wa.me/2348068365951\"\r\n        target=\"_blank\"\r\n        className={classes.whatsapp}\r\n      >\r\n        <WhatsAppIcon />\r\n      </a>\r\n    </>\r\n  );\r\n};\r\n\r\nexport default WhatsApp;\r\n","C:\\Users\\olamide\\Desktop\\grazac-academy-web-1\\src\\components\\tawkTo\\tawk.js",[],{"ruleId":"495","severity":1,"message":"496","line":3,"column":25,"nodeType":"497","messageId":"498","endLine":3,"endColumn":33},{"ruleId":"495","severity":1