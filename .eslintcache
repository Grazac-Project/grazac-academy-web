tate('');\r\n\r\n    useEffect(() => {\r\n        document.title = 'Contact - Grazac Academy';\r\n        window.scrollTo(0,0);\r\n    }, []);\r\n\r\n    const handleSubmit = () => {\r\n        if(name.length && email.length && subject.length && message.length) {\r\n            const btn = document.querySelector('#submit');\r\n            btn.setAttribute('disabled', '');\r\n            btn.textContent = 'Submitting...';\r\n            console.log('Submitted')\r\n            axios.post('http://grazacacademy.com/contact/create', {\r\n                name: name,\r\n                email: email,\r\n                subject: subject,\r\n                message: message\r\n            })\r\n            .then(resp => resp.data)\r\n            .then(response => {\r\n                if(response.success === true) {\r\n                    btn.removeAttribute('disabled');\r\n                    btn.textContent = 'Submit';\r\n                    alert(response.msg);\r\n                    setName(''); setEmail(''); setSubject(''); setMessage('');\r\n                } else {\r\n\r\n                }\r\n            })\r\n            .catch((err) => {\r\n                \r\n            });\r\n        } else {\r\n            alert('Invalid input');\r\n        }\r\n    }\r\n\r\n    return(\r\n        <div>\r\n            <Navbar/>\r\n            <div className=\"contact\">\r\n                <div className=\"contact_layer\">\r\n                    <div className=\"container\">\r\n                        <div className=\"contact_layer-text\">\r\n                            <h1>Get In Touch</h1>\r\n                            <p>We want to hear from you. Let us know how we can help</p>\r\n                        </div>\r\n                        {/*<div classname=\"contact_layer-circles\">\r\n                            <img src={kamala} alt=\"kamala\"  classname=\"contact_layer-circles-1\" />\r\n                            <img src={kamala} alt=\"kamala\"  classname=\"contact_layer-circles-2\" />\r\n                            <img src={kamala} alt=\"kamala\"  classname=\"contact_layer-circles-3\" />\r\n                            <img src={kamala} alt=\"kamala\"  classname=\"contact_layer-circles-4\" />\r\n                        </div>*/}\r\n                        <div className=\"contact_hero\">\r\n                            <div className=\"contact_hero-flexdiv\">\r\n                                <div className=\"contact_hero-flexdiv-1\" >\r\n                                    <label>Full Name  <span>*</span></label>\r\n                                    <input type=\"text\" placeholder=\"ex. John Doe\" value={name} onChange={e => setName(e.target.value)} />\r\n                                </div>\r\n                                <div className=\"contact_hero-flexdiv-2\">\r\n                                    <label>Email  <span>*</span></label>\r\n                                    <input type=\"text\" placeholder=\"ex. john@gmail.com\" value={email} onChange={e => setEmail(e.target.value)}  />\r\n                                </div>\r\n                            </div>\r\n                            <div>\r\n                                <label>Subject  <span>*</span></label>\r\n                                <input  type=\"text\" placeholder=\"ex. John Doe\" value={subject} onChange={e => setSubject(e.target.value)}  />\r\n                            </div>\r\n                            <div>\r\n                                <label>Message  <span>*</span></label>\r\n                                <textarea  type=\"text\" placeholder=\"Describe your task for us\" value={message} onChange={e => setMessage(e.target.value)}  />\r\n                            </div>\r\n                            <div className=\"contact_hero-privacy\" >\r\n                                <p>By submitting this form your consent to us emailing you occasionally about our products and services. You can unsubscribe from emails at any time, and we will never pass your email onto third parties. <span>Privacy Policy</span></p>\r\n                                <button id=\"submit\" onClick={handleSubmit}>Submit</button>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"container\">\r\n                    <div className=\"contact_campus\">\r\n                        <div className=\"contact_campus-intro\">\r\n                            <h2>Campus Inquiries</h2>\r\n                            <p>Connect with Us</p>\r\n                        </div>\r\n                        <div className=\"contact_campus-main\">\r\n                            <div className=\"contact_campus-main-div boxes33\">\r\n                                <h3>Office</h3>\r\n                                <p>PROHUB, Salawu Olabode Avenue, Ewang Road, </p>\r\n                                <p>Idi-aba, 110124, Abeokuta</p>\r\n                                <p>+234 806 836 5951</p>\r\n                            </div>\r\n                            <div className=\"contact_campus-main-div boxes33\">\r\n                                <h3>Book A Call</h3>\r\n                                <p>We are here to help with any questions. </p>\r\n                                <p>Talk to our programme leads.</p>\r\n                                <div style={{display:'flex'}}>\r\n                                    <a href=\"tel:+2348068365951\" ><div className=\"nav__btn--text\">Book a Call</div></a>\r\n                                </div>\r\n                            </div>\r\n                            <div className=\"contact_campus-main-div boxes33\">\r\n                                <h3>Social Media</h3>\r\n                                <div className=\"social\">\r\n                                    <img src={Facebook} alt=\"social\"/>\r\n                                </div>\r\n                                <div className=\"social\">\r\n                                    <img src={Twitter} alt=\"social\"/>\r\n                                </div>\r\n                                <div className=\"social\">\r\n                                    <img src={Youtube} alt=\"social\"/>\r\n                                </div>\r\n                                <div className=\"social\">\r\n                                    <img src={Instagram} alt=\"social\"/>\r\n                                </div>\r\n                            </div>\r\n\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div>\r\n                    <iframe src=\"https://www.google.com/maps/d/embed?mid=16NZ9a9VhKkk2-5nnYEdL93mxq7kjDZLT\" width=\"100%\" height=\"600\"></iframe>\r\n                </div>\r\n                {/*<extracomponent/> a component used in the landing page comes here*/}\r\n            </div>\r\n            <Footer/>\r\n        </div>\r\n    );\r\n}\r\n\r\nexport default Contact;",["321","322"],"C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\pages\\GraduateAccelerator.js",["323","324","325"],"C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\pages\\Landing.js",["326","327","328","329","330","331"],"C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\pages\\UndergraduateCoursePayment.js",["332","333"],"C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\pages\\GraduateCoursePayment.js",[],"C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\pages\\LeadForm.js",[],"C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\pages\\GraduateForm.js",["334","335"],"C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\pages\\ComingSoon.js",[],"C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\pages\\UndergraduateForm.js",[],"C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\auth\\Login.js",["336","337","338","339","340","341","342","343","344","345","346","347"],"C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\pages\\InternshipForm.js",["348","349"],"C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\auth\\Signup.js",["350","351","352","353","354","355","356","357","358","359","360","361","362"],"C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\pages\\UndergraduateAccelerator.js",["363","364","365","366"],"import React, {useState} from \"react\";\r\nimport {Link} from \"react-router-dom\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport NeedAdvice from \"../components/NeedAdvice\";\r\nimport Qualities from \"../components/Qualities\";\r\n\r\nimport undergraduate from \"../images/undergraduate.png\";\r\nimport loader from \"../images/loader.gif\";\r\nimport SchoolList from \"../components/SchoolList\";\r\n\r\nconst UndergraduateAccelerator = () => {\r\n    const [courses, setCourses] = useState([]);\r\n    const [openListModal, setOpenListModal] = useState(false);\r\n\r\n    React.useEffect(() => {\r\n        document.title = 'Undergraduate Accelerator Track - Grazac Academy';\r\n        window.scrollTo(0,0);\r\n        fetch('https://grazacacademy.com/undergraduate/courses')\r\n            .then(resp => resp.json())\r\n            .then(resp => {\r\n                setCourses(resp.data);\r\n            })\r\n            .catch(error => {\r\n                console.log('An error occurred when fetching the available courses, refreshing...')\r\n                window.location.reload();\r\n            })\r\n    }, []);\r\n\r\n    return(\r\n        <div>\r\n            <Navbar/>\r\n            {courses.length ? (<div></div>) : (\r\n                <div>\r\n                <div className=\"loading-blur\"></div>\r\n                <img src={loader} alt=\"loader\" className=\"loader-top\" />\r\n                </div>\r\n            )}\r\n            <div className=\"gua\">\r\n                <div className=\"gua_hero\">\r\n                    <div className=\"container\">\r\n                        <div className=\"row\">\r\n                            <div className=\"col-sm-6\">\r\n                                <div className=\"gua_hero-text\">\r\n                                    <div className=\"gua_hero-text-b\">\r\n                                        <h1>\r\n                                            Undergraduate Accelerator Plan\r\n                                        </h1>\r\n                                        <p>We equip you to be an asset in the digital age before leaving the four walls of school and we believe the future of work will be strictly skill-based. Join thousands of young undergraduates to build a career in technology and be mentored by industry experts.\r\n                                        </p>\r\n                                        <div className=\"contact_hero-privacy\" >\r\n                                            <a href=\"#courses\"  className=\"download-brochure\">Join Us Today!</a>\r\n                                            <Link to=\"/lead\"><button>Apply as Lead</button></Link>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div>\r\n                                <img src={undergraduate} alt=\"undergraduate\"  className=\"gua_hero-image\" />\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"container\">\r\n                    <div className=\"gga\">\r\n                        <div className=\"course_mode-intro course_mode-intro\">\r\n                            <h4 style={{marginTop:'100px'}}>We are preparing you for the future of work</h4>\r\n                            <h2>Join our community</h2>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"gua_highlight\">\r\n                        <div className=\"boxes44 gua_highlight-box1\">\r\n                            <div className=\"gua_highlight-box3\">\r\n                                <div className=\"gua_highlight-box4\">\r\n                                    <h3><strong>Student Lead</strong></h3>\r\n                                    <p>Become our ambassador in your institution. </p>\r\n                                    <p>Lead other students who are ready to prepare themselves for the future of work.</p>\r\n                                    <Link to=\"/lead\"><a className=\"white-link\">Apply as Student Lead</a></Link>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                        <div className=\"boxes44 gua_highlight-box2\">\r\n                            <div  className=\"gua_highlight-box3\">\r\n                                <div className=\"gua_highlight-box4\">\r\n                                    <h3><strong>Affiliated Campuses</strong></h3>\r\n                                    <p>We are well represented in various institutions of learning across Nigeria.</p>\r\n                                    <p>We want to prepare you for the future of work before you leave the four walls of learning.</p>\r\n                                    <a className=\"white-link\" onClick={() => setOpenListModal(true)}>Learn More</a>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"background1\" id=\"courses\">\r\n                    <div className=\"container\">\r\n                        <div className=\"gga\">\r\n                            <div className=\"course_mode-intro course_mode-intro\">\r\n                                <h2>Available Courses</h2>\r\n                            </div>\r\n                            <div className=\"gga_container\">\r\n                                {courses.length ? \r\n                                    courses.map((item,index) => (\r\n                                    <div className=\"boxes33\" key={index}>\r\n                                        <div className=\"gua_cardview\">\r\n                                            <div className=\"gua_cardview-box\">\r\n                                                <img src={item.thumb} alt=\"course-desc\" />\r\n                                            </div>\r\n                                            <div className=\"gua_cardview-text\">\r\n                                                <h4>{item.name}</h4>\r\n                                                <p>{item.description}</p>\r\n                                                <Link to={\"/course-detail-undergraduate?course=\"+item.slug}><a>Learn More</a></Link>\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>)) :\r\n                                    <div>\r\n                                        {/* <img src={loader} alt=\"loader\" className=\"loader\" /> */}\r\n                                    </div>\r\n                                }\r\n                                <div className=\"boxes33\">\r\n                                    <div className=\"gua_cardview\">\r\n                                        <div className=\"gua_cardview-text\">\r\n                                            <h4>Can't find a course you are interested in?</h4>\r\n                                            <p>We will be glad if you can suggest the course you'd love to learn.</p>\r\n                                            <Link to=\"/contact\"><a>Contact Us</a></Link>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <Qualities />\r\n                <NeedAdvice />\r\n            </div>\r\n            <Footer/>\r\n\r\n           { openListModal && <SchoolList onOpen={e => setOpenListModal(e)}/> }\r\n        </div>\r\n    );\r\n}\r\n\r\nexport default UndergraduateAccelerator;","C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\components\\Qualities.js",[],"C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\components\\PrimaryBtn.js",[],"C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\components\\Navbar.js",["367","368"],"C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\components\\NeedAdvice.js",["369","370","371"],"C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\components\\Mode.js",["372","373","374","375","376","377"],"C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\utils.js",[],"C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\components\\Footer.js",["378","379","380","381"],"C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\components\\SchoolList.js",[],"C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\components\\MOT.js",[],"C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\components\\NavItem.js",[],"C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\components\\InfoModal.js",["382"],"C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\components\\Modal.js",[],"C:\\Users\\USER\\Desktop\\Web Development\\G