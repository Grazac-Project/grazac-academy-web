10.1702 8.83094 13.7489H5.08594C5.56844 9.90891 8.23219 6.74516 11.7972 5.53516ZM11.3477 13.7498C11.7302 9.65984 13.8227 6.81234 15.0314 5.49609C16.2814 6.83484 18.3414 9.65609 18.6977 13.7498H11.3477ZM11.3516 16.25H18.7041C18.3216 20.3462 16.2241 23.1937 15.0166 24.51C13.7078 23.1225 11.7003 20.34 11.3516 16.25ZM24.9125 13.7519H21.2225C20.9662 10.1906 19.635 7.45688 18.3125 5.57812C21.8225 6.81563 24.4362 9.95188 24.9125 13.7519ZM27.5 15C27.5 8.12 21.9112 2.5225 15.035 2.5025C15.03 2.5025 15.025 2.50125 15.0188 2.50125C15.0138 2.50125 15.0063 2.5 15 2.5C8.1075 2.5 2.5 8.10875 2.5 15C2.5 21.8925 8.1075 27.5 15 27.5C15.0075 27.5 15.0138 27.4988 15.0188 27.4988C15.0213 27.4988 15.0225 27.5 15.025 27.5C15.0288 27.5 15.0325 27.4975 15.035 27.4975C21.9112 27.4788 27.5 21.88 27.5 15Z\"\r\n                            fill=\"white\"\r\n                          />\r\n                        </mask>\r\n                      </svg>\r\n                    </div>\r\n                    <h3>Job Placement</h3>\r\n                    <p>\r\n                      Enter the recruitment process with tech companies and take\r\n                      a stride into your dream career.{\" \"}\r\n                    </p>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <div className=\"background1\" id=\"courses\">\r\n            <div className=\"container\">\r\n              <div className=\"gga\">\r\n                <div className=\"course_mode-intro course_mode-intro\">\r\n                  <h2>Available Courses</h2>\r\n                </div>\r\n                <div className=\"gga_container\">\r\n                  {courses.length ? (\r\n                    courses.map((item, index) => (\r\n                      <Link\r\n                        to={`/course-detail-graduate?course=${item.slug}`}\r\n                        className=\"boxes33\"\r\n                        key={index}\r\n                      >\r\n                        <div className=\"gua_cardview\">\r\n                          <div className=\"gua_cardview-box\">\r\n                            <img src={item.thumb} alt=\"course-desc\" />\r\n                          </div>\r\n                          <div className=\"gua_cardview-text\">\r\n                            <h4 style={{ color: \"rgb(51, 51, 51)\" }}>\r\n                              {item.name}\r\n                            </h4>\r\n                            <p>{item.description}</p>\r\n                            <Link\r\n                              to={\"/course-detail-graduate?course=\" + item.slug}\r\n                            >\r\n                            Learn More\r\n                            </Link>\r\n                          </div>\r\n                        </div>\r\n                      </Link>\r\n                    ))\r\n                  ) : (\r\n                    <div>\r\n                      {/* <img src={loader} alt=\"loader\" className=\"loader\" /> */}\r\n                    </div>\r\n                  )}\r\n                  <div className=\"boxes33\">\r\n                    <div className=\"gua_cardview\">\r\n                      <div className=\"gua_cardview-text\">\r\n                        <h4>Can't find a course you are interested in?</h4>\r\n                        <p>\r\n                          We will be glad if you can suggest the course you'd\r\n                          love to learn.\r\n                        </p>\r\n                        <Link to=\"/contact\">\r\n                          <a>Contact Us</a>\r\n                        </Link>\r\n                      </div>\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <Qualities />\r\n          <NeedAdvice />\r\n        </div>\r\n        <Footer />\r\n      </div>\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default GraduateAccelerator;\r\n","C:\\Users\\Iyo\\Documents\\grazac academy\\grazac-academy-web\\src\\pages\\Contact.js",["160","161"],"C:\\Users\\Iyo\\Documents\\grazac academy\\grazac-academy-web\\src\\pages\\AboutUs.js",[],"C:\\Users\\Iyo\\Documents\\grazac academy\\grazac-academy-web\\src\\pages\\UndergraduateAccelerator.js",["162","163","164","165"],"import React, { useState, useContext } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport NeedAdvice from \"../components/NeedAdvice\";\r\nimport Qualities from \"../components/Qualities\";\r\n\r\nimport undergraduate from \"../images/undergraduate.png\";\r\nimport loader from \"../images/loader.gif\";\r\nimport SchoolList from \"../components/SchoolList\";\r\nimport { LoaderContext } from \"../context\";\r\nconst UndergraduateAccelerator = () => {\r\n  const { setShow } = useContext(LoaderContext);\r\n  const [courses, setCourses] = useState([]);\r\n  const [openListModal, setOpenListModal] = useState(false);\r\n\r\n  React.useEffect(() => {\r\n    console.log(\"Undergraduate Accelaerator\");\r\n    document.title = \"Undergraduate Accelerator Track - Grazac Academy\";\r\n    window.scrollTo(0, 0);\r\n    setShow(true);\r\n      fetch(\"https://grazacacademy.com/undergraduate/courses\")\r\n        .then((resp) => resp.json())\r\n        .then((resp) => {\r\n          setCourses(resp.data);\r\n          setShow(false);\r\n        })\r\n        .catch((error) => {\r\n          console.log(\r\n            \"An error occurred when fetching the available courses, refreshing...\"\r\n          );\r\n        });\r\n  }, []);\r\n\r\n  return (\r\n    <div>\r\n      <div id=\"blur\">\r\n        <Navbar />\r\n        <div className=\"gua\">\r\n          <div className=\"gua_hero\">\r\n            <div className=\"container\">\r\n              <div className=\"row\">\r\n                <div className=\"col-sm-6\">\r\n                  <div className=\"gua_hero-text\">\r\n                    <div className=\"gua_hero-text-b\">\r\n                      <h1>Undergraduate Accelerator Plan</h1>\r\n                      <p>\r\n                        We equip you to be an asset in the digital age before\r\n                        leaving the four walls of school and we believe the\r\n                        future of work will be strictly skill-based. Join\r\n                        thousands of young undergraduates to build a career in\r\n                        technology and be mentored by industry experts.\r\n                      </p>\r\n                      <div className=\"contact_hero-privacy\">\r\n                        <a href=\"#courses\" className=\"download-brochure\">\r\n                          Join Us Today!\r\n                        </a>\r\n                        <Link to=\"/lead\">\r\n                          <button>Apply as Lead</button>\r\n                        </Link>\r\n                      </div>\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n                <div>\r\n                  <img\r\n                    src={undergraduate}\r\n                    alt=\"undergraduate\"\r\n                    className=\"gua_hero-image\"\r\n                  />\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <div className=\"container\">\r\n            <div className=\"gga\">\r\n              <div className=\"course_mode-intro course_mode-intro\">\r\n                <h4 style={{ marginTop: \"100px\" }}>\r\n                  We are preparing you for the future of work\r\n                </h4>\r\n                <h2>Join our community</h2>\r\n              </div>\r\n            </div>\r\n            <div className=\"gua_highlight\">\r\n              <div className=\"boxes44 gua_highlight-box1\">\r\n                <div className=\"gua_highlight-box3\">\r\n                  <div className=\"gua_highlight-box4\">\r\n                    <h3>\r\n                      <strong>Student Lead</strong>\r\n                    </h3>\r\n                    <p>Become our ambassador in your institution. </p>\r\n                    <p>\r\n                      Lead other students who are ready to prepare themselves\r\n                      for the future of work.\r\n                    </p>\r\n                    <Link to=\"/lead\">\r\n                      <a className=\"white-link\">Apply as Student Lead</a>\r\n                    </Link>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n              <div className=\"boxes44 gua_highlight-box2\">\r\n                <div className=\"gua_highlight-box3\">\r\n                  <div className=\"gua_highlight-box4\">\r\n                    <h3>\r\n                      <strong>Affiliated Campuses</strong>\r\n                    </h3>\r\n                    <p>\r\n                      We are well represented in various institutions of\r\n                      learning across Nigeria.\r\n                    </p>\r\n                    <p>\r\n                      We want to prepare you for the future of work before you\r\n                      leave the four walls of learning.\r\n                    </p>\r\n                    <a\r\n                      className=\"white-link\"\r\n                      onClick={() => setOpenListModal(true)}\r\n                    >\r\n                      Learn More\r\n                    </a>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <div className=\"background1\" id=\"courses\">\r\n            <div className=\"container\">\r\n              <div className=\"gga\">\r\n                <div className=\"course_mode-intro course_mode-intro\">\r\n                  <h2>Available Courses</h2>\r\n                </div>\r\n                <div className=\"gga_container\">\r\n                  {courses.length ? (\r\n                    courses.map((item, index) => (\r\n                      <div className=\"boxes33\" key={index}>\r\n                        <div className=\"gua_cardview\">\r\n                          <div className=\"gua_cardview-box\">\r\n                            <img src={item.thumb} alt=\"course-desc\" />\r\n                          </div>\r\n                          <div className=\"gua_cardview-text\">\r\n                            <h4>{item.name}</h4>\r\n                            <p>{item.description}</p>\r\n                            <Link\r\n                              to={\r\n                                \"/course-detail-undergraduate?course=\" +\r\n                                item.slug\r\n                              }\r\n                            >\r\n                              <a>Learn More</a>\r\n                            </Link>\r\n                          </div>\r\n                        </div>\r\n                      </div>\r\n                    ))\r\n                  ) : (\r\n                    <div>\r\n                      {/* <img src={loader} alt=\"loader\" className=\"loader\" /> */}\r\n                    </div>\r\n                  )}\r\n                  <div className=\"boxes33\">\r\n                    <div className=\"gua_cardview\">\r\n                      <div className=\"gua_cardview-text\">\r\n                        <h4>Can't find a course you are interested in?</h4>\r\n                        <p>\r\n                          We will be glad if you can suggest the course you'd\r\n                          love to learn.\r\n                        </p>\r\n                        <Link to=\"/contact\">\r\n                          <a>Contact Us</a>\r\n                        </Link>\r\n                      </div>\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <Qualities />\r\n          <NeedAdvice />\r\n        </div>\r\n        <Footer />\r\n\r\n        {openListModal && <SchoolList onOpen={(e) => setOpenListModal(e)} />}\r\n      </div>\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default UndergraduateAccelerator;\r\n","C:\\Users\\Iyo\\Documents\\grazac academy\\grazac-academy-web\\src\\pages\\UndergraduateCoursePayment.js",["166","167"],"import { useState, useEffect, useContext} from \"react\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport { useFlutterwave, closePaymentModal } from 'flutterwave-react-v3';\r\nimport { useParams } from \"react-router-dom\";\r\nimport { LoaderContext } from \"../context\";\r\n\r\nconst UndergraduateCoursePayment = () => {\r\n  const { id } = useParams();\r\n  const [fetched, setFetched] = useState({});\r\n  const [payment, setPayment] = useState(true);\r\n  const { setShow } = useContext(LoaderContext);\r\n  useEffect(() => {\r\n    document.title = 'Payment - Grazac Academy'\r\nsetShow(true)\r\n    fetch(`https://grazacacademy.com/undergraduate/registration/details/${id}`)\r\n    .then(resp => resp.json())\r\n    .then(data => {\r\n      setFetched(data.data)\r\n      setShow(false)\r\n      if(data.data.tx_ref.length) {\r\n        document.querySelector(\".form-info\").textContent = \"You have completed your registration\";\r\n        setPayment(false);\r\n      } \r\n    })\r\n    .catch(err => {\r\n      document.querySelector(\".form-info\").textContent = \"Something went wrong, refreshing...\";\r\n      //window.location.reload();\r\n      document.querySelector(\"#form-btn\").setAttribute('disabled', 'disabled');\r\n    })\r\n  }, []);\r\n\r\n  const config = {\r\n    public_key: 'FLWPUBK-006bdc82ad878f1518af32f44af6478f-X',\r\n    tx_ref: Date.now(),\r\n    amount: fetched.tuition,\r\n    currency: 'NGN',\r\n    payment_options: 'card,mobilemoney,ussd',\r\n    customer: {\r\n      email: fetched.email,\r\n      phonenumber: fetched.phone,\r\n      name: fetched.firstname + \" \" + fetched.lastname,\r\n    },\r\n    customizations: {\r\n      title: 'Grazac Undergraduate Accelerator Plan',\r\n      description: `Payment for ${fetched.course} at Grazac Undergraduate Accelerator Plan`,\r\n      logo: 'https://grazac.com.ng/assets/images/favicon.png',\r\n    },\r\n  };\r\n\r\n  const handleFlutterPayment = useFlutterwave(config);\r\n\r\n  const onSubmit = () => {\r\n    if(payment) {\r\n      handleFlutterPayment({\r\n        callback: (response) => {\r\n            if (response.status === 'successful') {\r\n              fetch(\"https://grazacacademy.com/undergraduate/registration/update\", {\r\n                method: 'POST',\r\n                headers: {\r\n                'Content-Type': 'application/json'\r\n                },\r\n                body: JSON.stringify({\r\n                  firstname: fetched.firstname,\r\n                  email: fetched.email,\r\n                  course: fetched.course,\r\n                  tx_ref: response.tx_ref,\r\n                  id: id\r\n                })\r\n              })\r\n              .then(resp => resp.json())\r\n              .then(data => {\r\n                if(data.success === true) {\r\n                  document.querySelector(\".form-info\").textContent = \"Your payment was successful.\";\r\n                }\r\n              })\r\n            };\r\n            closePaymentModal() // this will close the modal programmatically\r\n        },\r\n        onClose: () => {\r\n\r\n        },\r\n      });\r\n  } else {\r\n    alert('You have completed your registration');\r\n  }\r\n  }\r\n\r\n  return (\r\n    <div>\r\n      <Navbar/>\r\n        <div>\r\n          <div className=\"contact_layer\">\r\n            <div className=\"form_top\">\r\n              <div>\r\n                <h1>Payment</h1>\r\n              </div>\r\n              </div>\r\n              <div className=\"container\">\r\n                <div className=\"form\">\r\n                  <div className=\"form-info\">Click on Pay Now to finalize your payment.</div>\r\n                  <div className=\"form-flexdiv\">\r\n                    <div className=\"form-flexdiv-1\" >\r\n                      <label>First Name  <span>*</span></label>\r\n                      <input className=\"input\" type=\"text\" maxLength=\"30\" readOnly value={fetched.firstname} style={{textTransform: \"capitalize\"}}/>\r\n                    </div>\r\n                      <div className=\"form-flexdiv-2\">\r\n                          <label>Last Name  <span>*</span></label>\r\n                          <input className=\"input\" type=\"text\" maxLength=\"30\" readOnly value={fetched.lastname} style={{textTransform: \"capitalize\"}}/>\r\n                      </div>\r\n                    </div>\r\n                      <div className=\"form-flexdiv\">\r\n                          <div className=\"form-flexdiv-1\" >\r\n                              <label>Mobile Number  <span>*</span></label>\r\n                              <input className=\"input\" type=\"text\" maxLength=\"11\" readOnly value={fetched.phone}/>\r\n                          </div>\r\n                          <div className=\"form-flexdiv-2\">\r\n                              <label>Email  <span>*</span></label>\r\n                              <input className=\"input\" type=\"email\" maxLength=\"30\" readOnly value={fetched.email}/>\r\n                          </div>\r\n                      </div>\r\n                      <div>\r\n                          <label>Select your institution  <span>*</span></label><br/>\r\n                          <input className=\"input\" type=\"text\" readOnly value={fetched.institution}/>\r\n                      </div>\r\n                      <div>\r\n                          <label>Kindly choose your preferred course  <span>*</span></label><br/>\r\n                          <input className=\"input\" type=\"text\" readOnly value={fetched.course}/>\r\n                      </div>\r\n                      <div>\r\n                          <label>Amount</label><br/>\r\n                          <p className=\"show-amount\">\r\n                              ₦{ new Intl.NumberFormat().format(fetched.tuition) }\r\n                          </p>\r\n                      </div>\r\n                     \r\n                      <div className=\"form-privacy\" >\r\n                        <a className=\"download-brochure\" onClick={onSubmit} id=\"form-btn\">Pay Now</a>\r\n                      </div>\r\n                  </div>\r\n              </div>\r\n          </div>\r\n        </div>\r\n        <Footer/>\r\n    </div>\r\n  )\r\n}\r\n\r\nexport default UndergraduateCoursePayment;","C:\\Users\\Iyo\\Documents\\grazac academy\\grazac-academy-web\\src\\pages\\GraduateCoursePayment.js",[],"C:\\Users\\Iyo\\Documents\\grazac academy\\grazac-academy-web\\src\\pages\\LeadForm.js",[],"C:\\Users\\Iyo\\Documents\\grazac academy\\grazac-academy-web\\src\\pages\\Faq.js",[],"C:\\Users\\Iyo\\Documents\\grazac academy\\grazac-academy-web\\src\\pages\\GraduateForm.js",["168","169"],"C:\\Users\\Iyo\\Documents\\grazac academy\\grazac-academy-web\\src\\pages\\UndergraduateForm.js",[],"C:\\Users\\Iyo\\Documents\\grazac academy\\grazac-academy-web\\src\\pages\\ComingSoon.js",[],"C:\\Users\\Iyo\\Documents\\grazac academy\\grazac-academy-web\\src\\pages\\InternshipForm.js",["170","171"],"C:\\Users\\Iyo\\Documents\\grazac academy\\grazac-academy-web\\src\\components\\Loader.js",["172"],"C:\\Users\\Iyo\\Documents\\grazac academy\\grazac-academy-web\\src\\auth\\Login.js",["173","174","175","176","177","178","179","180","181","182","183","184"],"C:\\Users\\Iyo\\Documents\\grazac academy\\grazac-academy-web\\src\\auth\\Signup.js",["185","186","187","188","189","190","191","192","193","194","195","196","197"],"C:\\Users\\Iyo\\Documents\\grazac academy\\grazac-academy-web\\src\\components\\Navbar.js",["198","199"],"import { useEffect, useState, useRef } from \"react\";\r\nimport { cn } from \"../utils\";\r\nimport NavItem from \"./NavItem\";\r\nimport logo from \"../images/svg/grazac-logo.svg\";\r\nimport { Link } from \"react-router-dom\";\r\nimport InfoModal from \"../components/InfoModal\";\r\n\r\nconst Navbar = ({ top }) => {\r\n  const [fixed, setFixed] = useState(false);\r\n  const [active, setActive] = useState(false);\r\n  const [hover, setHover] = useState(false);\r\n  const nav = useRef(null);\r\n\r\n  useEffect(() => {\r\n    /*if(top) {\r\n      let h = document.querySelector('.infomodal').offsetHeight;\r\n      console.log(h);\r\n      document.querySelector('nav.nav').style.marginTop = h+'px';\r\n    }*/\r\n    if (nav.current && window.pageYOffset > nav.current.offsetTop) {\r\n      setFixed(true);\r\n    } else {\r\n      setFixed(false);\r\n    }\r\n    window.addEventListener(\"scroll\", () => {\r\n      if (nav.current && window.pageYOffset > nav.current.offsetTop)\r\n        setFixed(true);\r\n      else setFixed(false);\r\n    });\r\n  }, []);\r\n\r\n  const handleClick = (e) => {\r\n    e.preventDefault();\r\n\r\n    if (active) setActive(false);\r\n    else setActive(true);\r\n  };\r\n\r\n  return (\r\n    <nav className={cn(\"nav\", { \"nav--fixed\": fixed })} ref={nav}>\r\n      <div className=\"nav__container\">\r\n        <div className=\"nav__logo\">\r\n          <Link to=\"/\">\r\n            <img src={logo} alt=\"logo\" />\r\n          </Link>\r\n        </div>\r\n\r\n        <div className={cn(\"nav__menu\", { \"nav__menu--active\": active })}>\r\n          <button className=\"nav-tgl\" onClick={handleClick}>\r\n            <span>&nbsp;</span>\r\n          </button>\r\n\r\n          <ul className=\"nav__list--mb\">\r\n            <li className=\"nav__item\">\r\n              <NavItem exact link=\"/\">\r\n                <span>01</span>Home\r\n              </NavItem>\r\n            </li>\r\n            <li className=\"nav__item\">\r\n              <NavItem link=\"/about-us\">\r\n                <span>02</span>About\r\n              </NavItem>\r\n            </li>\r\n            <li className=\"nav__item\">\r\n              <NavItem link=\"/undergraduate-accelerator-plan\">\r\n                <span>03</span>Undergraduate\r\n              </NavItem>\r\n            </li>\r\n            <li className=\"nav__item\">\r\n              <NavItem link=\"/graduate-accelerator-plan\">\r\n                <span>04</span>Graduate\r\n              </NavItem>\r\n            </li>\r\n            <li className=\"nav__item\">\r\n              <a href=\"/#tracks\">\r\n                <button onClick={() => setActive(false)}>Enroll Now</button>\r\n              </a>\r\n            </li>\r\n            <li className=\"nav__item\" style={{ marginTop: \"30px\" }}>\r\n              <a href=\"tel:+2348068365951\">\r\n                <button onClick={() => setActive(false)}>Talk to us</button>\r\n              </a>\r\n            </li>\r\n          </ul>\r\n        </div>\r\n\r\n        <ul className=\"nav__list\" style={{ marginBottom: 0 }}>\r\n          <li className=\"nav__item\">\r\n            <NavItem exact link=\"/\">\r\n              Home\r\n            </NavItem>\r\n          </li>\r\n          <li className=\"nav__item\">\r\n            <NavItem link=\"/about-us\">About</NavItem>\r\n          </li>\r\n          <li\r\n            className=\"nav__item\"\r\n            style={{ position: \"relative\", cursor: \"pointer\" }}\r\n            onMouseEnter={() => setHover(true)}\r\n            onMouseLeave={() => setHover(false)}\r\n          >\r\n            <a className=\"nav__link\">Academy</a>\r\n            <svg\r\n              className=\"mask\"\r\n              width=\"11\"\r\n              height=\"6\"\r\n              viewBox=\"0 0 11 6\"\r\n              fill=\"none\"\r\n              xmlns=\"http://www.w3.org/2000/svg\"\r\n            >\r\n              <path\r\n                fillRule=\"evenodd\"\r\