              <p>Set out on the right path by leveraging on the experience of those who have gone ahead.</p>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                        <div className=\"boxes22\">\r\n                            <div className=\"\">\r\n                                <div className=\"boxes\">\r\n                                    <div className=\"svg-box2\">\r\n                                        <svg width=\"30\" height=\"30\" viewBox=\"0 0 30 30\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\r\n                                            <path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M18.2695 24.44C19.5808 22.5675 20.9445 19.8138 21.217 16.25H24.9108C24.432 20.065 21.7995 23.2125 18.2695 24.44ZM5.08612 16.2498H8.82612C9.08362 19.8273 10.4299 22.5698 11.7586 24.4511C8.21237 23.2298 5.56737 20.0761 5.08612 16.2498ZM11.7972 5.53516C10.4822 7.40766 9.10594 10.1702 8.83094 13.7489H5.08594C5.56844 9.90891 8.23219 6.74516 11.7972 5.53516ZM11.3477 13.7498C11.7302 9.65984 13.8227 6.81234 15.0314 5.49609C16.2814 6.83484 18.3414 9.65609 18.6977 13.7498H11.3477ZM11.3516 16.25H18.7041C18.3216 20.3462 16.2241 23.1937 15.0166 24.51C13.7078 23.1225 11.7003 20.34 11.3516 16.25ZM24.9125 13.7519H21.2225C20.9662 10.1906 19.635 7.45688 18.3125 5.57812C21.8225 6.81563 24.4362 9.95188 24.9125 13.7519ZM27.5 15C27.5 8.12 21.9112 2.5225 15.035 2.5025C15.03 2.5025 15.025 2.50125 15.0188 2.50125C15.0138 2.50125 15.0063 2.5 15 2.5C8.1075 2.5 2.5 8.10875 2.5 15C2.5 21.8925 8.1075 27.5 15 27.5C15.0075 27.5 15.0138 27.4988 15.0188 27.4988C15.0213 27.4988 15.0225 27.5 15.025 27.5C15.0288 27.5 15.0325 27.4975 15.035 27.4975C21.9112 27.4788 27.5 21.88 27.5 15Z\" fill=\"#773DD3\"/>\r\n                                            <mask id=\"mask0\" mask-type=\"alpha\" maskUnits=\"userSpaceOnUse\" x=\"2\" y=\"2\" width=\"26\" height=\"26\">\r\n                                            <path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M18.2695 24.44C19.5808 22.5675 20.9445 19.8138 21.217 16.25H24.9108C24.432 20.065 21.7995 23.2125 18.2695 24.44ZM5.08612 16.2498H8.82612C9.08362 19.8273 10.4299 22.5698 11.7586 24.4511C8.21237 23.2298 5.56737 20.0761 5.08612 16.2498ZM11.7972 5.53516C10.4822 7.40766 9.10594 10.1702 8.83094 13.7489H5.08594C5.56844 9.90891 8.23219 6.74516 11.7972 5.53516ZM11.3477 13.7498C11.7302 9.65984 13.8227 6.81234 15.0314 5.49609C16.2814 6.83484 18.3414 9.65609 18.6977 13.7498H11.3477ZM11.3516 16.25H18.7041C18.3216 20.3462 16.2241 23.1937 15.0166 24.51C13.7078 23.1225 11.7003 20.34 11.3516 16.25ZM24.9125 13.7519H21.2225C20.9662 10.1906 19.635 7.45688 18.3125 5.57812C21.8225 6.81563 24.4362 9.95188 24.9125 13.7519ZM27.5 15C27.5 8.12 21.9112 2.5225 15.035 2.5025C15.03 2.5025 15.025 2.50125 15.0188 2.50125C15.0138 2.50125 15.0063 2.5 15 2.5C8.1075 2.5 2.5 8.10875 2.5 15C2.5 21.8925 8.1075 27.5 15 27.5C15.0075 27.5 15.0138 27.4988 15.0188 27.4988C15.0213 27.4988 15.0225 27.5 15.025 27.5C15.0288 27.5 15.0325 27.4975 15.035 27.4975C21.9112 27.4788 27.5 21.88 27.5 15Z\" fill=\"white\"/>\r\n                                            </mask>\r\n                                        </svg>\r\n                                    </div>\r\n                                    <h3>Job Placement</h3>\r\n                                    <p>Enter the recruitment process with tech companies and take a stride into your dream career. </p>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"background1\" id=\"courses\">\r\n                    <div className=\"container\">\r\n                        <div className=\"gga\">\r\n                            <div className=\"course_mode-intro course_mode-intro\">\r\n                                <h2>Available Courses</h2>\r\n                            </div>\r\n                            <div className=\"gga_container\">\r\n                                {courses.length ?\r\n                                    courses.map((item,index) => (\r\n                                    <a href={`/course-detail-graduate?course=${item.slug}`} className=\"boxes33\" key={index}>\r\n                                        <div className=\"gua_cardview\">\r\n                                            <div className=\"gua_cardview-box\">\r\n                                                <img src={item.thumb} alt=\"course-desc\" />\r\n                                            </div>\r\n                                            <div className=\"gua_cardview-text\">\r\n                                                <h4 style={{color: 'rgb(51, 51, 51)'}}>{item.name}</h4>\r\n                                                <p>{item.description}</p>\r\n                                                <Link to={\"/course-detail-graduate?course=\"+item.slug}><a>Learn More</a></Link>\r\n                                            </div>\r\n                                        </div>\r\n                                    </a>\r\n                                    )) :\r\n                                    <div>\r\n                                        <img src={loader} alt=\"loader\" className=\"loader\" />\r\n                                    </div>\r\n                                }\r\n                                <div className=\"boxes33\">\r\n                                    <div className=\"gua_cardview\">\r\n                                        <div className=\"gua_cardview-text\">\r\n                                            <h4>Can't find a course you are interested in?</h4>\r\n                                            <p>We will be glad if you can suggest the course you'd love to learn.</p>\r\n                                            <Link to=\"/contact\"><a>Contact Us</a></Link>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <Qualities />\r\n                <NeedAdvice />\r\n            </div>\r\n            <Footer/>\r\n        </div>\r\n    );\r\n}\r\n\r\nexport default GraduateAccelerator;","C:\\Users\\'Toyosi Adekanmbi\\Desktop\\grazac-academy-web\\src\\pages\\UndergraduateAccelerator.js",["143","144","145","146"],"import React, {useState} from \"react\";\r\nimport {Link} from \"react-router-dom\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport NeedAdvice from \"../components/NeedAdvice\";\r\nimport Qualities from \"../components/Qualities\";\r\n\r\nimport undergraduate from \"../images/undergraduate.png\";\r\nimport loader from \"../images/loader.gif\";\r\nimport SchoolList from \"../components/SchoolList\";\r\n\r\nconst UndergraduateAccelerator = () => {\r\n    const [courses, setCourses] = useState([]);\r\n    const [openListModal, setOpenListModal] = useState(false);\r\n\r\n    React.useEffect(() => {\r\n        document.title = 'Undergraduate Accelerator Track - Grazac Academy';\r\n        window.scrollTo(0,0);\r\n        fetch('https://grazacacademy.com/undergraduate/courses')\r\n            .then(resp => resp.json())\r\n            .then(resp => {\r\n                setCourses(resp.data);\r\n            })\r\n            .catch(error => {\r\n                console.log('An error occurred when fetching the available courses, refreshing...')\r\n                window.location.reload();\r\n            })\r\n    }, []);\r\n\r\n    return(\r\n        <div>\r\n            <div className=\"gua\">\r\n                <div className=\"gua_hero\">\r\n                        <Navbar/>\r\n                    <div className=\"container\">\r\n                        <div className=\"row\">\r\n                            <div className=\"col-sm-6\">\r\n                                <div className=\"gua_hero-text\">\r\n                                    <div className=\"gua_hero-text-b\">\r\n                                        <h1>\r\n                                            Undergraduate Accelerator Plan\r\n                                        </h1>\r\n                                        <p>We equip you to be an asset in the digital age before leaving the four walls of school and we believe the future of work will be strictly skill-based. Join thousands of young undergraduates to build a career in technology and be mentored by industry experts.\r\n                                        </p>\r\n                                        <div className=\"contact_hero-privacy\" >\r\n                                            <a href=\"#courses\"  className=\"download-brochure\">Join Us Today!</a>\r\n                                            <Link to=\"/lead\"><button>Apply as Lead</button></Link>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div>\r\n                                <img src={undergraduate} alt=\"undergraduate\"  className=\"gua_hero-image\" />\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"container\">\r\n                    <div className=\"gga\">\r\n                        <div className=\"course_mode-intro course_mode-intro\">\r\n                            <h4 style={{marginTop:'100px'}}>We are preparing you for the future of work</h4>\r\n                            <h2>Join our community</h2>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"gua_highlight\">\r\n                        <div className=\"boxes44 gua_highlight-box1\">\r\n                            <div className=\"gua_highlight-box3\">\r\n                                <div className=\"gua_highlight-box4\">\r\n                                    <h3><strong>Student Lead</strong></h3>\r\n                                    <p>Become our ambassador in your institution. </p>\r\n                                    <p>Lead other students who are ready to prepare themselves for the future of work.</p>\r\n                                    <Link to=\"/lead\"><a className=\"white-link\">Apply as Student Lead</a></Link>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                        <div className=\"boxes44 gua_highlight-box2\">\r\n                            <div  className=\"gua_highlight-box3\">\r\n                                <div className=\"gua_highlight-box4\">\r\n                                    <h3><strong>Affiliated Campuses</strong></h3>\r\n                                    <p>We are well represented in various institutions of learning across Nigeria.</p>\r\n                                    <p>We want to prepare you for the future of work before you leave the four walls of learning.</p>\r\n                                    <a className=\"white-link\" onClick={() => setOpenListModal(true)}>Learn More</a>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"background1\" id=\"courses\">\r\n                    <div className=\"container\">\r\n                        <div className=\"gga\">\r\n                            <div className=\"course_mode-intro course_mode-intro\">\r\n                                <h2>Available Courses</h2>\r\n                            </div>\r\n                            <div className=\"gga_container\">\r\n                                {courses.length ? \r\n                                    courses.map((item,index) => (\r\n                                    <div className=\"boxes33\" key={index}>\r\n                                        <div className=\"gua_cardview\">\r\n                                            <div className=\"gua_cardview-box\">\r\n                                                <img src={item.thumb} alt=\"course-desc\" />\r\n                                            </div>\r\n                                            <div className=\"gua_cardview-text\">\r\n                                                <h4>{item.name}</h4>\r\n                                                <p>{item.description}</p>\r\n                                                <Link to={\"/course-detail-undergraduate?course=\"+item.slug}><a>Learn More</a></Link>\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>)) :\r\n                                    <div>\r\n                                        <img src={loader} alt=\"loader\" className=\"loader\" />\r\n                                    </div>\r\n                                }\r\n                                <div className=\"boxes33\">\r\n                                    <div className=\"gua_cardview\">\r\n                                        <div className=\"gua_cardview-text\">\r\n                                            <h4>Can't find a course you are interested in?</h4>\r\n                                            <p>We will be glad if you can suggest the course you'd love to learn.</p>\r\n                                            <Link to=\"/contact\"><a>Contact Us</a></Link>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <Qualities />\r\n                <NeedAdvice />\r\n            </div>\r\n            <Footer/>\r\n\r\n           { openListModal && <SchoolList onOpen={e => setOpenListModal(e)}/> }\r\n        </div>\r\n    );\r\n}\r\n\r\nexport default UndergraduateAccelerator;","C:\\Users\\'Toyosi Adekanmbi\\Desktop\\grazac-academy-web\\src\\pages\\UndergraduateCoursePayment.js",["147","148"],"import { useState, useEffect } from \"react\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport { useFlutterwave, closePaymentModal } from 'flutterwave-react-v3';\r\nimport { useParams } from \"react-router-dom\";\r\n\r\nconst UndergraduateCoursePayment = () => {\r\n  const { id } = useParams();\r\n  const [fetched, setFetched] = useState({});\r\n  const [payment, setPayment] = useState(true);\r\n\r\n  useEffect(() => {\r\n    document.title = 'Payment - Grazac Academy'\r\n    fetch(`https://grazacacademy.com/undergraduate/registration/details/${id}`)\r\n    .then(resp => resp.json())\r\n    .then(data => {\r\n      setFetched(data.data)\r\n      if(data.data.tx_ref.length) {\r\n        document.querySelector(\".form-info\").textContent = \"You have completed your registration\";\r\n        setPayment(false);\r\n      } \r\n    })\r\n    .catch(err => {\r\n      document.querySelector(\".form-info\").textContent = \"Something went wrong, refreshing...\";\r\n      window.location.reload();\r\n      document.querySelector(\"#form-btn\").setAttribute('disabled', 'disabled');\r\n    })\r\n  }, []);\r\n\r\n  const config = {\r\n    public_key: 'FLWPUBK-006bdc82ad878f1518af32f44af6478f-X',\r\n    tx_ref: Date.now(),\r\n    amount: fetched.tuition,\r\n    currency: 'NGN',\r\n    payment_options: 'card,mobilemoney,ussd',\r\n    customer: {\r\n      email: fetched.email,\r\n      phonenumber: fetched.phone,\r\n      name: fetched.firstname + \" \" + fetched.lastname,\r\n    },\r\n    customizations: {\r\n      title: 'Grazac Undergraduate Accelerator Plan',\r\n      description: `Payment for ${fetched.course} at Grazac Undergraduate Accelerator Plan`,\r\n      logo: 'https://grazac.com.ng/assets/images/favicon.png',\r\n    },\r\n  };\r\n\r\n  const handleFlutterPayment = useFlutterwave(config);\r\n\r\n  const onSubmit = () => {\r\n    if(payment) {\r\n      handleFlutterPayment({\r\n        callback: (response) => {\r\n            if (response.status === 'successful') {\r\n              fetch(\"https://grazacacademy.com/undergraduate/registration/update\", {\r\n                method: 'POST',\r\n                headers: {\r\n                'Content-Type': 'application/json'\r\n                },\r\n                body: JSON.stringify({\r\n                  firstname: fetched.firstname,\r\n                  email: fetched.email,\r\n                  course: fetched.course,\r\n                  tx_ref: response.tx_ref,\r\n                  id: id\r\n                })\r\n              })\r\n              .then(resp => resp.json())\r\n              .then(data => {\r\n                if(data.success === true) {\r\n                  document.querySelector(\".form-info\").textContent = \"Your payment was successful.\";\r\n                }\r\n              })\r\n            };\r\n            closePaymentModal() // this will close the modal programmatically\r\n        },\r\n        onClose: () => {\r\n\r\n        },\r\n      });\r\n  } else {\r\n    alert('You have completed your registration');\r\n  }\r\n  }\r\n\r\n  return (\r\n    <div>\r\n      <Navbar/>\r\n        <div>\r\n          <div className=\"contact_layer\">\r\n            <div className=\"form_top\">\r\n              <div>\r\n                <h1>Payment</h1>\r\n              </div>\r\n              </div>\r\n              <div className=\"container\">\r\n                <div className=\"form\">\r\n                  <div className=\"form-info\">Click on Pay Now to finalize your payment.</div>\r\n                  <div className=\"form-flexdiv\">\r\n                    <div className=\"form-flexdiv-1\" >\r\n                      <label>First Name  <span>*</span></label>\r\n                      <input className=\"input\" type=\"text\" maxLength=\"30\" readOnly value={fetched.firstname} style={{textTransform: \"capitalize\"}}/>\r\n                    </div>\r\n                      <div className=\"form-flexdiv-2\">\r\n                          <label>Last Name  <span>*</span></label>\r\n                          <input className=\"input\" type=\"text\" maxLength=\"30\" readOnly value={fetched.lastname} style={{textTransform: \"capitalize\"}}/>\r\n                      </div>\r\n                    </div>\r\n                      <div className=\"form-flexdiv\">\r\n                          <div className=\"form-flexdiv-1\" >\r\n                              <label>Mobile Number  <span>*</span></label>\r\n                              <input className=\"input\" type=\"text\" maxLength=\"11\" readOnly value={fetched.phone}/>\r\n                          </div>\r\n                          <div className=\"form-flexdiv-2\">\r\n                              <label>Email  <span>*</span></label>\r\n                              <input className=\"input\" type=\"email\" maxLength=\"30\" readOnly value={fetched.email}/>\r\n                          </div>\r\n                      </div>\r\n                      <div>\r\n                          <label>Select your institution  <span>*</span></label><br/>\r\n                          <input className=\"input\" type=\"text\" readOnly value={fetched.institution}/>\r\n                      </div>\r\n                      <div>\r\n                          <label>Kindly choose your preferred course  <span>*</span></label><br/>\r\n                          <input className=\"input\" type=\"text\" readOnly value={fetched.course}/>\r\n                      </div>\r\n                      <div>\r\n                          <label>Amount</label><br/>\r\n                          <p className=\"show-amount\">\r\n                              ₦{ new Intl.NumberFormat().format(fetched.tuition) }\r\n                          </p>\r\n                      </div>\r\n                     \r\n                      <div className=\"form-privacy\" >\r\n                        <a className=\"download-brochure\" onClick={onSubmit} id=\"form-btn\">Pay Now</a>\r\n                      </div>\r\n                  </div>\r\n              </div>\r\n          </div>\r\n        </div>\r\n        <Footer/>\r\n    </div>\r\n  )\r\n}\r\n\r\nexport default UndergraduateCoursePayment;","C:\\Users\\'Toyosi Adekanmbi\\Desktop\\grazac-academy-web\\src\\pages\\GraduateCoursePayment.js",["149","150"],"import { useState, useEffect } from \"react\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport { useFlutterwave, closePaymentModal } from 'flutterwave-react-v3';\r\nimport { useParams } from \"react-router-dom\";\r\n\r\nconst UndergraduateCoursePayment = () => {\r\n  const { id } = useParams();\r\n  const [ payment, setPayment ] = useState(true);\r\n  const [ plan, setPlan ] = useState('');\r\n  const [ amount, setAmount ] = useState(150000);\r\n  const [ fetched, setFetched ] = useState({\r\n    firstname: '',\r\n    lastname: '',\r\n    email: '',\r\n    tuition: '',\r\n    course: ''\r\n  });\r\n\r\n  useEffect(() => {\r\n    document.title = 'Payment - Grazac Academy'\r\n    fetch(`https://grazacacademy.com/graduate/registration/details/${id}`)\r\n    .then(resp => resp.json())\r\n    .then(data => {\r\n      setFetched(data.data)\r\n      if(data.data.tx_ref.length) {\r\n        document.querySelector(\".form-info\").textContent = \"You have completed your registration\";\r\n        setPayment(false);\r\n      }\r\n    })\r\n    .catch(err => {\r\n      document.querySelector(\".form-info\").textContent = \"Something went wrong, refreshing...\";\r\n      window.location.reload();\r\n      document.querySelector(\"#form-btn\").setAttribute('disabled', 'disabled');\r\n    })\r\n  }, []);\r\n\r\n  useEffect(_ => {\r\n    if(plan === 'full') {\r\n      setAmount(150000);\r\n      setPayment(true);\r\n    } else if(plan === 'installment') {\r\n      setAmount(40000);\r\n      setPayment(true);\r\n    } else if(plan === 'income-split') {\r\n      setAmount(50000);\r\n      setPayment(true);\r\n    } else {\r\n      setPayment(false);\r\n    }\r\n  }, [plan])\r\n\r\n  const config = {\r\n    public_key: 'FLWPUBK-006bdc82ad878f1518af32f44af6478f-X',\r\n    tx_ref: Date.now(),\r\n    amount: amount,\r\n    currency: 'NGN',\r\n    payment_options: 'card,mobilemoney,ussd',\r\n    customer: {\r\n      email: fetched.email,\r\n      phonenumber: fetched.phone,\r\n      name: fetched.firstname + \" \" + fetched.lastname,\r\n    },\r\n    customizations: {\r\n      title: 'Grazac Graduate Accelerator Plan',\r\n      description: `Payment for ${fetched.course} at Grazac Graduate Accelerator Plan`,\r\n      logo: 'https://grazac.com.ng/assets/images/favicon.png',\r\n    },\r\n  };\r\n\r\n  const handleFlutterPayment = useFlutterwave(config);\r\n\r\n  const onSubmit = () => {\r\n    if(payment) {\r\n      handleFlutterPayment({\r\n        callback: (response) => {\r\n            if (response.status === 'successful') {\r\n                fetch(\"https://grazacacademy.com/graduate/registration/update\", {\r\n                  method: 'POST',\r\n                  headers: {\r\n                  'Content-Type': 'application/json'\r\n                  },\r\n                  body: JSON.stringify({\r\n                    firstname: fetched.firstname,\r\n                    email: fetched.email,\r\n                    course: fetched.course,\r\n                    tx_ref: response.tx_ref,\r\n                    id: id,\r\n                    plan: plan\r\n                  })\r\n                })\r\n                .then(resp => resp.json())\r\n                .then(data => {\r\n                  if(data.success === true) {\r\n                    document.querySelector(\".form-info\").textContent = \"Your payment was successful.\";\r\n                  }\r\n                })\r\n            };\r\n            closePaymentModal() // this will close the modal programmatically\r\n        },\r\n        onClose: () => {},\r\n      });\r\n    } else {\r\n      alert('You have completed your registration');\r\n    }\r\n  }\r\n\r\n  return (\r\n    <div>\r\n      <Navbar/>\r\n        <div>\r\n          <div className=\"contact_layer\">\r\n            <div className=\"form_top\">\r\n              <div>\r\n                <h1>Payment</h1>\r\n              </div>\r\n              </div>\r\n              <div className=\"container\">\r\n                <div className=\"form\">\r\n                  <div className=\"form-info\">Click on Pay Now to pay.</div>\r\n                  <div className=\"form-flexdiv\">\r\n                    <div className=\"form-flexdiv-1\" >\r\n                      <label>First Name  <span>*</span></label>\r\n                      <input className=\"input\" type=\"text\" maxLength=\"30\" readOnly value={fetched.firstname} style={{textTransform: \"capitalize\"}}/>\r\n                    </div>\r\n                      <div className=\"form-flexdiv-2\">\r\n                          <label>Last Name  <span>*</span></label>\r\n                          <input className=\"input\" type=\"text\" maxLength=\"30\" readOnly value={fetched.lastname} style={{textTransform: \"capitalize\"}}/>\r\n                      </div>\r\n                    </div>\r\n                      <div className=\"form-flexdiv\">\r\n                          <div className=\"form-flexdiv-1\" >\r\n                              <label>Mobile Number  <span>*</span></label>\r\n                              <input className=\"input\" type=\"text\" maxLength=\"11\" readOnly value={fetched.phone}/>\r\n                          </div>\r\n                          <div className=\"form-flexdiv-2\">\r\n                              <label>Email  <span>*</span></label>\r\n                              <input className=\"input\" type=\"email\" maxLength=\"30\" readOnly value={fetched.email}/>\r\n                          </div>\r\n                      </div>\r\n                      <div>\r\n                          <label>Kindly choose your preferred course  <span>*</span></label><br/>\r\n                          <input className=\"input\" type=\"text\" readOnly value={fetched.course}/>\r\n                      </div>\r\n                      <div>\r\n                          <label>Amount</label><br/>\r\n                          <p className=\"show-amount\">\r\n                              ₦{ new Intl.NumberFormat().format(fetched.tuition) }\r\n                          </p>\r\n                      </div>\r\n\r\n                      <div>\r\n                          <label>Select payment plan</label><br/>\r\n                          <label style={{marginRight:'30px'}}><input\r\n                              type=\"radio\"\r\n                              className=\"radio-input\"\r\n                              id=\"full-time\"\r\n                              name=\"plan\"\r\n                              value=\"full\"\r\n                              checked={plan === \"full\"}\r\n                              onChange={(e) => setPlan(e.target.value)}\r\n                              style={{marginRight:'5px'}}\r\n                          /> Full (One-Off Payment)</label>\r\n                          <label><input\r\n                              type=\"radio\"\r\n                              className=\"radio-input\"\r\n                              id=\"part-time\"\r\n                              name=\"plan\"\r\n                              value=\"installment\"\r\n                              checked={plan === \"installment\"}\r\n                              onChange={(e) => setPlan(e.target.value)}\r\n                          /> ₦40,000 * 4 Installment Payment</label>\r\n                          <label><input\r\n                              type=\"radio\"\r\n                              className=\"radio-input\"\r\n                              id=\"part-time\"\r\n                              name=\"plan\"\r\n                              value=\"income-split\"\r\n                              checked={plan === \"income-split\"}\r\n                              onChange={(e) => setPlan(e.target.value)}\r\n                          /> ₦50,000 upfront + 15% Split Income</label>\r\n                      </div>\r\n                     \r\n                      <div className=\"form-privacy\" >\r\n                        <a className=\"download-brochure\" onClick={onSubmit} id=\"form-btn\">Pay Now</a>\r\n                      </div>\r\n                  </div>\r\n              </div>\r\n          </div>\r\n        </div>\r\n        <Footer/>\r\n    </div>\r\n  )\r\n}\r\n\r\nexport default UndergraduateCoursePayment;","C:\\Users\\'Toyosi Adekanmbi\\Desktop\\grazac-academy-web\\src\\pages\\LeadForm.js",[],"C:\\Users\\'Toyosi Adekanmbi\\Desktop\\grazac-academy-web\\src\\pages\\GraduateCourseDetail.js",["151","152"],"import React,{useState} from \"react\";\r\nimport {Link} from \"react-router-dom\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport PrimaryBtn from \"../components/PrimaryBtn\";\r\nimport MOT from \"../components/MOT\";\r\n\r\nimport paper from '../images/svg/paper-ribbon.svg';\r\nimport loader from \"../images/loader.gif\";\r\n\r\nconst CourseDetail = (props) => {\r\n    const [course, setCourse] = useState('');\r\n    const [outline, setOutline] = useState([]);\r\n\r\n    React.useEffect(() => {\r\n        document.title = 'Course Details - Grazac Academy';\r\n        window.scrollTo(0,0);\r\n        const slug = props.location.search.substring(8);\r\n        fetch(`https://grazacacademy.com/graduate/course/details/${slug}`)\r\n            .then(resp => resp.json())\r\n            .then(resp => {\r\n                setCourse(resp.data);\r\n                setOutline(JSON.parse(resp.data.outline));\r\n            })\r\n            .catch(error => {\r\n                console.log('An error occurred when fetching course details, refreshing...')\r\n                window.location.reload();\r\n            })\r\n    },[]);\r\n    \r\n    return(\r\n        <div>\r\n            <Navbar/>\r\n            <div className=\"course\">\r\n                <div className=\"course_hero\">\r\n                    <div className=\"container\">\r\n                        {course ? \r\n                            <div className=\"row\">\r\n                                <div className=\"col-sm-6\">\r\n                                    <div className=\"course_hero-text\">\r\n                                        <div className=\"course_hero-text-b\">\r\n                                            <h1>\r\n                                                {course.name}\r\n                                            </h1>\r\n                                            <p>\r\n                                                {course.description}\r\n                                            </p>\r\n                                            <div className=\"contact_hero-privacy\" >\r\n                                                <a href={course.brochure} className=\"download-brochure\" target=\"_blank\">Download Brochure</a>\r\n                                                <Link to=\"/graduate-form\"><button>Enroll now</button></Link>\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                                <div>\r\n                                    <img src={paper} alt=\"academy\"  className=\"gga_hero-image\" />\r\n                                </div>\r\n                            </div> : \r\n                            <img src={loader} alt=\"loader\" className=\"loader\" />\r\n                        }\r\n                    </div>\r\n                </div>\r\n                <div className=\"course_learn\">\r\n                    <div className=\"container\">\r\n                        <div className=\"course_wwd-intro\">\r\n                            <h4>GRAZAC ACADEMY</h4>\r\n                            <h2>What you'll Learn</h2>\r\n                        </div>\r\n                        <div className=\"course_learn-main\">\r\n                            {outline.length ? \r\n                                outline.map((item, index) => (\r\n                                    <div key={index}>\r\n                                        <div className=\"course_learn-main-list\">\r\n                                            <div className=\"box1\">\r\n                                                <h3>{(index<10) ? '0'+index : index}</h3>\r\n                                            </div>\r\n                                            <div className=\"box2\">\r\n                                                <h3>{item.topic}</h3>\r\n                                            </div>\r\n                                            <div className=\"box3\">\r\n                                                <p>{item.summary}</p>\r\n                                            </div>\r\n                                        </div>\r\n                                        <hr/>\r\n                                    </div>\r\n                                )):\r\n                                <div>\r\n                                    <img src={loader} alt=\"loader\" className=\"loader\" />\r\n                                </div>\r\n                            }\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <MOT />\r\n                <div className=\"course_purple\">\r\n                    <div className=\"course_purple_txt\">\r\n                        <p>Our Flexible Payment Plans</p>\r\n                        <h1>{course.percent_off}%</h1>\r\n                        <p>Discount Available</p>\r\n                    </div>\r\n                    <div className=\"course_purple-main\">\r\n                        <Link to=\"/graduate-form?payment=fulltime\">\r\n                            <div className=\"course_purple-main-boxes grad-box\">\r\n                                <h4>Full Package</h4>\r\n                                <h3><span style={{textDecoration:'line-through'}}>₦{course.tuition}</span></h3>\r\n                                <h2>₦{new Intl.NumberFormat().format(course.discounted_tuition)}</h2>\r\n                                <p>This is a one-off payment. You won't be required to pay any amount again till the end of your training.</p>\r\n                            </div>\r\n                        </Link>\r\n                        <Link to=\"/graduate-form?payment=installment\">\r\n                            <div className=\"course_purple-main-boxes grad-box\">\r\n                                <h4>Installment Plan</h4>\r\n                                <h3><span style={{textDecoration:'line-through'}}>₦{course.tuition}</span></h3>\r\n                                <h2>₦{new Intl.NumberFormat().format(40000)} <span style={{fontSize: '14px'}}>* 4 months.</span></h2>\r\n                                <p>To be paid at the beginning of each month for the duration of the training which is 4 months.</p>\r\n                            </div>\r\n                        </Link>\r\n                        <Link to=\"/graduate-form?payment=income-split\">\r\n                            <div className=\"course_purple-main-boxes grad-box\">\r\n                                <h4>Income Split Agreement</h4>\r\n                                <h3><span style={{textDecoration:'line-through'}}>₦{course.tuition}</span></h3>\r\n                                <h2>₦{new Intl.NumberFormat().format(50000)} <span style={{fontSize: '14px'}}>upfront + 15% split income.</span></h2>\r\n                                <p>After the training, you get a job placement and you pay us 15% of your salary for a period of 12months.</p>\r\n                            </div>\r\n                        </Link>\r\n                    </div>\r\n                    <div className=\"course_purple-btn\">\r\n                        <PrimaryBtn link=\"/graduate-form\">Enroll Now</PrimaryBtn>\r\n                        <a href=\"tel:+234806 836 5951\"><p>Talk to course rep</p></a>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n            <Footer/>\r\n        </div>\r\n    );\r\n}\r\n\r\nexport default CourseDetail;","C:\\Users\\'Toyosi Adekanmbi\\Desktop\\grazac-academy-web\\src\\pages\\GraduateForm.js",["153"],"import { useEffect, useRef, useState } from \"react\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport axios from \"axios\";\r\n\r\nconst GraduateForm = () => {\r\n  const [firstname, setFirstName] = useState(\"\");\r\n  const [lastname, setLastName] = useState(\"\");\r\n  const [phone, setPhone] = useState(\"\");\r\n  const [email, setEmail] = useState(\"\");\r\n  const [plan, setPlan] = useState(\"\");\r\n  const [availability, setAvailability] = useState(\"\");\r\n  const [amount, setAmount] = useState(\"\");\r\n  const [course, setCourse] = useState(\"\");\r\n  const [paymentPlan, setPaymentPlan] = useState(\"\");\r\n  const [message, setMessage] = useState(\"\");\r\n  const [fetchCourses, setFetched] = useState([]);\r\n  const formInfo = useRef();\r\n  const [showPayment, setShowPayment] = useState(true);\r\n\r\n  useEffect(() => {\r\n    document.title = \"Join our Graduate Track - Grazac Academy\";\r\n    window.scrollTo(0, 0);\r\n    const method = window.location.search.substring(9);\r\n    if (method) {\r\n      setPaymentPlan(method);\r\n      setShowPayment(false);\r\n    }\r\n    fetch(\"https://grazacacademy.com/graduate/courses\")\r\n      .then((resp) => resp.json())\r\n      .then((resp) => {\r\n        setFetched(resp.data);\r\n      })\r\n      .catch((error) => {\r\n        console.log(\r\n          \"An error occurred when fetching course details, refreshing...\"\r\n        );\r\n        window.location.reload();\r\n      });\r\n  }, []);\r\n\r\n  const courseChange = (e) => {\r\n    setCourse(e.target.value);\r\n    var rc = e.target.options[e.target.selectedIndex].dataset.index;\r\n    setAmount(fetchCourses[rc].discounted_tuition);\r\n  };\r\n\r\n  const choosePlan = (e) => {\r\n    setPaymentPlan(e.target.value);\r\n  };\r\n\r\n  const onSubmit = (e) => {\r\n    e.preventDefault();\r\n    if (amount) {\r\n      window.scroll(0, formInfo.current.offsetTop);\r\n      document.querySelector(\".form-info\").textContent =\r\n        \"Submitting, please wait...\";\r\n      document\r\n        .querySelector(\"#submit-btn\")\r\n        .setAttribute(\"disabled\", \"disabled\");\r\n      fetch(\"https://grazacacademy.com/graduate/register\", {\r\n        method: \"POST\",\r\n        headers: {\r\n          \"Content-Type\": \"application/json\",\r\n        },\r\n        body: JSON.stringify({\r\n          firstname: firstname,\r\n          lastname: lastname,\r\n          email: email,\r\n          phone: phone,\r\n          availability: availability,\r\n          course: course,\r\n          package: plan,\r\n          expectation: message,\r\n          tuition: amount,\r\n        }),\r\n      })\r\n        .then((resp) => resp.json())\r\n        .then((data) => {\r\n          if (data.success === true) {\r\n            document.querySelector(\".form-info\").textContent =\r\n              \"Your registration was successful, kindly check your mailbox for further details\";\r\n            document.querySelector(\"#submit-btn\").removeAttribute(\"disabled\");\r\n            setFirstName(\"\");\r\n            setLastName(\"\");\r\n            setMessage(\"\");\r\n            setPhone(\"\");\r\n            setEmail(\"\");\r\n            setCourse(\"\");\r\n          } else {\r\n            document.querySelector(\".form-info\").textContent = data.msg;\r\n            document.querySelector(\"#submit-btn\").removeAttribute(\"disabled\");\r\n          }\r\n        })\r\n        .catch((err) => {\r\n          document.querySelector(\".form-info\").textContent =\r\n            \"Something went wrong, please try again\";\r\n          document.querySelector(\"#submit-btn\").removeAttribute(\"disabled\");\r\n        });\r\n      let formData = new FormData();\r\n\r\n      formData.append(\"name\", firstname);\r\n      formData.append(\"email\", email);\r\n      axios\r\n        .post(\"http://grazac.com.ng/newsletter/subscribe\", formData, {\r\n          headers: {\r\n            \"Content-Type\": \"application/json\",\r\n          },\r\n        })\r\n        .then((resp) => resp.data)\r\n        .then((data) => {\r\n          console.log(data);\r\n          if (data.success === true) {\r\n            console.log(\"Added to newsletter\");\r\n          } else {\r\n            console.log(\"Not Added to newsletter\");\r\n          }\r\n        })\r\n        .catch((err) => {\r\n          console.log(`An error occured, please try again ${err}`);\r\n        });\r\n    } else {\r\n      alert(\"Please select a course\");\r\n    }\r\n  };\r\n\r\n  return (\r\n    <div>\r\n      <Navbar />\r\n      <div>\r\n        <div className=\"contact_layer\">\r\n          <div className=\"form_top\">\r\n            <div>\r\n              <h1>Grazac Academy Graduate Accelerator</h1>\r\n              <p>\r\n                We are bridging the gap between unemployment and entry-level\r\n                jobs in the technology industry.\r\n              </p>\r\n            </div>\r\n          </div>\r\n          <div className=\"container\" ref={formInfo}>\r\n            <div className=\"form\">\r\n              <form onSubmit={onSubmit}>\r\n                <div className=\"form-info\">\r\n                  Note: Fields with <span>*</span> are required\r\n                </div>\r\n                <div className=\"form-flexdiv\">\r\n                  <div className=\"form-flexdiv-1\">\r\n                    <label>\r\n                      First Name <span>*</span>\r\n                    </label>\r\n                    <input\r\n                      className=\"input\"\r\n                      type=\"text\"\r\n                      placeholder=\"ex. John\"\r\n                      value={firstname}\r\n                      onChange={(e) => setFirstName(e.target.value)}\r\n                      required=\"required\"\r\n                    />\r\n                  </div>\r\n                  <div className=\"form-flexdiv-2\">\r\n                    <label>\r\n                      Last Name <span>*</span>\r\n                    </label>\r\n                    <input\r\n                      className=\"input\"\r\n                      type=\"text\"\r\n                      placeholder=\"ex. Doe\"\r\n                      value={lastname}\r\n                      onChange={(e) => setLastName(e.target.value)}\r\n                      required=\"required\"\r\n                    />\r\n                  </div>\r\n                </div>\r\n                <div className=\"form-flexdiv\">\r\n                  <div className=\"form-flexdiv-1\">\r\n                    <label>\r\n                      Mobile Number <span>*</span>\r\n                    </label>\r\n                    <input\r\n                      className=\"input\"\r\n                      type=\"text\"\r\n                      placeholder=\"ex. 08133333333\"\r\n                      value={phone}\r\n                      onChange={(e) => setPhone(e.target.value)}\r\n                      required=\"required\"\r\n                    />\r\n                  </div>\r\n                  <div className=\"form-flexdiv-2\">\r\n                    <label>\r\n                      Email <span>*</span>\r\n                    </label>\r\n                    <input\r\n                      className=\"input\"\r\n                      type=\"text\"\r\n                      placeholder=\"ex. john@gmail.com\"\r\n                      value={email}\r\n                      onChange={(e) => setEmail(e.target.value)}\r\n                      required=\"required\"\r\n                    />\r\n                  </div>\r\n                </div>\r\n                <div>\r\n                  <label>\r\n                    Our classes will be on Monday, Wednesdays and Fridays, will\r\n                    you be available? <span>*</span>\r\n                  </label>\r\n                  <br />\r\n                  <label>\r\n                    <input\r\n                      type=\"radio\"\r\n                      className=\"radio-input\"\r\n                      id=\"yes\"\r\n                      name=\"availability\"\r\n                      value=\"1\"\r\n                      required=\"required\"\r\n                      checked={availability === \"1\"}\r\n                      onChange={(e) => setAvailability(e.target.value)}\r\n                    />\r\n                    Yes\r\n                  </label>\r\n                  <label>\r\n                    <input\r\n                      type=\"radio\"\r\n                      className=\"radio-input\"\r\n                      id=\"no\"\r\n                      name=\"availability\"\r\n                      value=\"0\"\r\n                      required=\"required\"\r\n                      checked={availability === \"0\"}\r\n                      onChange={(e) => setAvailability(e.target.value)}\r\n                      style={{ marginLeft: \"30px\" }}\r\n                    />\r\n                    No\r\n                  </label>\r\n                </div>\r\n                <div>\r\n                  <label>\r\n                    Kindly choose your preferred course <span>*</span>\r\n                  </label>\r\n                  <br />\r\n                  <select\r\n                    className=\"input\"\r\n                    onChange={courseChange}\r\n                    required=\"required\"\r\n                  >\r\n                    <option value=\"\">---Choose course---</option>\r\n                    {fetchCourses.map((item, index) => (\r\n                      <option key={index} data-index={index}>\r\n                        {item.name}\r\n                      </option>\r\n                    ))}\r\n                  </select>\r\n                </div>\r\n                {showPayment && (\r\n                  <div>\r\n                    <label>\r\n                      Kindly choose your preferred payment plan <span>*</span>\r\n                    </label>\r\n                    <br />\r\n                    <select\r\n                      className=\"input\"\r\n                      onChange={choosePlan}\r\n                      required=\"required\"\r\n                    >\r\n                      <option value=\"\">---Choose Plan---</option>\r\n                      <option>Full Payment</option>\r\n                      <option>Installmental Payment</option>\r\n                      <option>Income Split Agreement</option>\r\n                    </select>\r\n                  </div>\r\n                )}\r\n                <div>\r\n                  <label>Amount</label>\r\n                  <br />\r\n                  <p className=\"show-amount\">\r\n                    ₦{amount ? new Intl.NumberFormat().format(amount) : \"0\"}\r\n                  </p>\r\n                </div>\r\n                <div>\r\n                  <label>\r\n                    Kindly select a package. Our Part-time students have on-site\r\n                    classes only on Saturdays.{\" \"}\r\n                  </label>\r\n                  <br />\r\n                  <label>\r\n                    <input\r\n                      type=\"radio\"\r\n                      className=\"radio-input\"\r\n                      id=\"full-time\"\r\n                      name=\"plan\"\r\n                      value=\"full-time\"\r\n                      checked={plan === \"full-time\"}\r\n                      onChange={(e) => setPlan(e.target.value)}\r\n                      required=\"required\"\r\n                    />\r\n                    Full time\r\n                  </label>\r\n                  <label>\r\n                    <input\r\n                      type=\"radio\"\r\n                      className=\"radio-input\"\r\n                      id=\"part-time\"\r\n                      name=\"plan\"\r\n                      value=\"part-time\"\r\n                      checked={plan === \"part-time\"}\r\n                      onChange={(e) => setPlan(e.target.value)}\r\n                      style={{ marginLeft: \"30px\" }}\r\n                      required=\"required\"\r\n                    />\r\n                    Part time\r\n                  </label>\r\n                </div>\r\n                <div>\r\n                  <label>\r\n                    What do you expect at the end of this training?{\" \"}\r\n                    <span>*</span>\r\n                  </label>\r\n                  <textarea\r\n                    type=\"text\"\r\n                    placeholder=\"Say something ...\"\r\n                    value={message}\r\n                    onChange={(e) => setMessage(e.target.value)}\r\n                    required=\"required\"\r\n                  />\r\n                </div>\r\n                <div className=\"form-privacy\">\r\n                  <button\r\n                    className=\"download-brochure\"\r\n                    type=\"submit\"\r\n                    id=\"submit-btn\"\r\n                  >\r\n                    Register\r\n                  </button>\r\n                </div>\r\n              </form>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <Footer />\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default GraduateForm;\r\n","C:\\Users\\'Toyosi Adekanmbi\\Desktop\\grazac-academy-web\\src\\pages\\UndergraduateForm.js",["154"],"import {useEffect, useRef, useState} from \"react\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport axios from 'axios';\r\n\r\nconst UndergraduateForm = () => {\r\n    const [ firstname, setFirstName ] = useState('');\r\n    const [ lastname, setLastName ] = useState('');\r\n    const [ phone, setPhone ] = useState('');\r\n    const [ email, setEmail ] = useState('');\r\n    const [institution, setInstitution] = useState('');\r\n    const [availability, setAvailability] = useState('');\r\n    const [course, setCourse] = useState('');\r\n    const [ message, setMessage ] = useState('');\r\n    const [fetchCourses, setFetched] = useState([]);\r\n    const [amount, setAmount] = useState('');\r\n\r\n    const formInfo = useRef();\r\n\r\n    useEffect(() => {\r\n        document.title = 'Join our Undergraduate Track - Grazac Academy';\r\n        window.scrollTo(0,0);\r\n        fetch('https://grazacacademy.com/courses/undergraduate',)\r\n            .then(resp => resp.json())\r\n            .then(resp => {\r\n                setFetched(resp.data);\r\n            })\r\n            .catch(error => {\r\n                console.log('An error occurred when fetching course details, refreshing...')\r\n                window.location.reload();\r\n            })\r\n    }, []);\r\n\r\n    const courseChange = (e) => {\r\n        setCourse(e.target.value)\r\n        var rc = e.target.options[e.target.selectedIndex].dataset.index;\r\n        setAmount( fetchCourses[rc].discounted_tuition );\r\n    }\r\n\r\n    const onSubmit = () => {\r\n        if(amount){\r\n            if(availability === \"1\") {\r\n                window.scroll(0, formInfo.current.offsetTop);\r\n                document.querySelector(\".form-info\").textContent = \"Submitting, please wait...\"\r\n                document.querySelector(\"#submit-btn\").setAttribute('disabled', 'disabled');\r\n                fetch('https://grazacacademy.com/undergraduate/register', {\r\n                    method: 'POST',\r\n                    headers: {\r\n                    'Content-Type': 'application/json'\r\n                    },\r\n                    body: JSON.stringify({\r\n                        firstname:firstname,\r\n                        lastname:lastname,\r\n                        email:email,\r\n                        phone:phone,\r\n                        institution:institution,\r\n                        availability:availability,\r\n                        course:course,\r\n                        expectation:message,\r\n                        package:'Full time',\r\n                        tuition: amount\r\n                    })\r\n                }).then(resp => resp.json())\r\n                  .then(data => {\r\n                       if (data.success === true){\r\n                            document.querySelector(\".form-info\").textContent = \"Your registration was successful, kindly check your mailbox for further details.\";\r\n                            document.querySelector(\"#submit-btn\").removeAttribute('disabled');\r\n                            setFirstName(\"\");\r\n                            setLastName(\"\")\r\n                            setMessage(\"\")\r\n                            setPhone(\"\")\r\n                            setEmail(\"\")\r\n                            setInstitution(\"\")\r\n                            setCourse(\"\")\r\n                       } else {\r\n                        document.querySelector(\".form-info\").textContent = data.msg;\r\n                        document.querySelector(\"#submit-btn\").removeAttribute('disabled');\r\n                       }\r\n                   })\r\n                   .catch(err => {\r\n                        document.querySelector(\".form-info\").textContent = \"Something went wrong, please try again\";\r\n                        document.querySelector(\"#submit-btn\").removeAttribute('disabled');\r\n                   })\r\n                   let formData = new FormData();\r\n\r\n                    formData.append('name', firstname);\r\n                    formData.append('email', email);\r\n                    axios.post('https://grazac.com.ng/newsletter/subscribe', formData, {\r\n                        headers: {\r\n                        'Content-Type': 'application/json'\r\n                        }\r\n                    })\r\n                    .then(resp => resp.data)\r\n                    .then(data => {\r\n                    console.log(data)\r\n                        if(data.success === true){\r\n                            console.log('Added to newsletter')\r\n                        }else{\r\n                            console.log('Not Added to newsletter')\r\n                        }  \r\n                    })\r\n                    .catch(err => {\r\n                            console.log(`An error occured, please try again ${err}`);\r\n                    })\r\n                   \r\n            } else {\r\n                alert('You must be available to for the undergraduate training');\r\n            }\r\n        } else {\r\n            alert('Kindly select a course');\r\n        }\r\n    }\r\n\r\n    return(\r\n        <div>\r\n            <Navbar/>\r\n            <div>\r\n                <div className=\"contact_layer\">\r\n                    <div className=\"form_top\" ref={formInfo}>\r\n                        <div>\r\n                            <h1>Grazac Academy Undergraduate Accelerator</h1>\r\n                            <p>FUNAAB and FCE starts by Feb 13th and on-site classes will only be on weekends.</p>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"container\">\r\n                        <div className=\"form\">\r\n                            <div className=\"form-info\">Note: Fields with <span>*</span> are required</div>\r\n                            <div className=\"form-flexdiv\">\r\n                                <div className=\"form-flexdiv-1\" >\r\n                                    <label>First Name  <span>*</span></label>\r\n                                    <input className=\"input\" type=\"text\" maxLength=\"30\" placeholder=\"ex. John\" value={firstname} onChange={e => setFirstName(e.target.value)} required/>\r\n                                </div>\r\n                                <div className=\"form-flexdiv-2\">\r\n                                    <label>Last Name  <span>*</span></label>\r\n                                    <input className=\"input\" type=\"text\" maxLength=\"30\" placeholder=\"ex. Doe\" value={lastname} onChange={e => setLastName(e.target.value)}  required/>\r\n                                </div>\r\n                            </div>\r\n                            <div className=\"form-flexdiv\">\r\n                                <div className=\"form-flexdiv-1\" >\r\n                                    <label>Mobile Number  <span>*</span></label>\r\n                                    <input className=\"input\" type=\"text\" maxLength=\"11\" placeholder=\"ex. 08133333333\" value={phone} onChange={e => setPhone(e.target.value)} required/>\r\n                                </div>\r\n                                <div className=\"form-flexdiv-2\">\r\n                                    <label>Email  <span>*</span></label>\r\n                                    <input className=\"input\" type=\"email\" maxLength=\"30\" placeholder=\"ex. john@gmail.com\" value={email} onChange={e => setEmail(e.target.value)}  required/>\r\n                                </div>\r\n                            </div>\r\n                            <div>\r\n                                <label>Select your institution  <span>*</span></label><br/>\r\n                                <select className=\"input\" onChange={e => setInstitution(e.target.value)} required>\r\n                                    <option>---Choose institution---</option>\r\n                                    <option>Federal University of Agriculture, Abeokuta (FUNAAB)</option>\r\n                                    <option>Federal College of Education, Osiele Abeokuta (FCE)</option>\r\n                                    <option>Olabisi Onabanjo University (AGO-IWOYE)</option>\r\n                                    <option>Olabisi Onabanjo University (IBOGUN)</option>\r\n                                    <option>University of Ibadan (UI)</option>\r\n                                    <option>Obafemi Awolowo University (OAU)</option>\r\n                                </select>\r\n                            </div>\r\n                            <div>\r\n                                <label>Our classes will be on Weekends, will you be available ? </label><br/>\r\n                                <label><input\r\n                                    type=\"radio\"\r\n                                    className=\"radio-input\"\r\n                                    id=\"yes\"\r\n                                    name=\"availability\"\r\n                                    value=\"1\"\r\n                                    checked={availability === \"1\"}\r\n                                    onChange={(e) => setAvailability(e.target.value)}\r\n                                />Yes</label>\r\n                                <label><input\r\n                                    type=\"radio\"\r\n                                    className=\"radio-input\"\r\n                                    id=\"no\"\r\n                                    name=\"availability\"\r\n                                    value=\"0\"\r\n                                    checked={availability === \"0\"}\r\n                                    onChange={(e) => setAvailability(e.target.value)}\r\n                                    style={{marginLeft:'30px'}}\r\n                                />No</label>\r\n                            </div>\r\n                            <div>\r\n                                <label>Kindly choose your preferred course  <span>*</span></label><br/>\r\n                                <select className=\"input\" onChange={courseChange}>\r\n                                    <option>---Choose course---</option>\r\n                                    {\r\n                                        fetchCourses.map((item,index) => (\r\n                                            <option key={index} data-index={index}>{item.name}</option>\r\n                                        ))\r\n                                    }\r\n                                </select>\r\n                            </div>\r\n                            <div>\r\n                                <label>Amount</label><br/>\r\n                                <p className=\"show-amount\">\r\n                                    ₦{\r\n                                        (amount) ? new Intl.NumberFormat().format(amount) : '0'\r\n                                    }\r\n                                </p>\r\n                            </div>\r\n                            <div>\r\n                                <label>What do you expect at the end of this training?  <span>*</span></label>\r\n                                <textarea  type=\"text\" placeholder=\"Write something\" value={message} onChange={e => setMessage(e.target.value)}  />\r\n                            </div>\r\n                            <div className=\"form-privacy\" >\r\n                                <a className=\"download-brochure\" onClick={onSubmit} id=\"submit-btn\">Register</a>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n            <Footer/>\r\n        </div>\r\n    )\r\n}\r\n\r\nexport default UndergraduateForm;","C:\\Users\\'Toyosi Adekanmbi\\Desktop\\grazac-academy-web\\src\\pages\\ComingSoon.js",[],"C:\\Users\\'Toyosi Adekanmbi\\Desktop\\grazac-academy-web\\src\\auth\\Signup.js",["155","156","157","158","159","160","161","162","163","164","165","166","167"],"import { useState } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { cn } from \"../utils\";\r\nimport PrimaryBtn from \"../components/PrimaryBtn\";\r\nimport Grazac from \"../images/grazac.png\";\r\n\r\nconst validEmailRegex = RegExp(\r\n  /^(([^<>()\\[\\]\\.,;:\\s@\\\"]+(\\.[^<>()\\[\\]\\.,;:\\s@\\\"]+)*)|(\\\".+\\\"))@(([^<>()[\\]\\.,;:\\s@\\\"]+\\.)+[^<>()[\\]\\.,;:\\s@\\\"]{2,})$/i\r\n);\r\n\r\nconst Signup = () => {\r\n  const [email, setEmail] = useState(\"\");\r\n  const [password, setPassword] = useState(\"\");\r\n  const [emailErr, setEmailErr] =  useState(\"\");\r\n  const [phone, setPhone] = useState(\"\");\r\n  const [gender, setGender] = useState(\"\");\r\n\r\n  \r\n  const handleEmailChange = e => {\r\n    e.preventDefault();\r\n    setEmail(e.target.value)\r\n\r\n    if (!email) setEmailErr(\"\");\r\n    let err = validEmailRegex.test(e.target.value) ? \"\" : \"please enter a valid email address\";\r\n    setEmailErr(err);\r\n  }\r\n\r\n  const handlePasswordChange = e => {\r\n    e.preventDefault();\r\n    setPassword(e.target.value)\r\n  }\r\n\r\n  return(\r\n    <div className=\"auth\">\r\n      <div className=\"auth__body\">\r\n        <div className=\"auth__hero\">\r\n          <img src={Grazac} alt=\"grazac\" />\r\n        </div>\r\n\r\n        <div className=\"auth__form\">\r\n          <div className=\"auth__form--container\">\r\n            <h1>Create Account</h1>\r\n\r\n            <form className=\"form\">\r\n              <div className=\"form__group\">\r\n                <label for=\"email\">Email address</label>\r\n                <input type=\"email\" id=\"email\" value={email} onChange={handleEmailChange} className={cn(\"form__input\", {\"form__input--err\": emailErr})}/>\r\n              </div>\r\n\r\n              <div className=\"form__group--half\">\r\n                <div className=\"form__group\">\r\n                  <label for=\"phone\">Phone </label>\r\n                  <input type=\"email\" id=\"email\" value={phone} onChange={e => setPhone(e.target.value)} className={cn(\"form__input\")}/>\r\n                </div>\r\n\r\n                <div className=\"form__group\">\r\n                  <label for=\"gender\">Gender</label>\r\n                    <select id=\"cars\" className=\"form__input\" onChange={e => setGender(e.target.value)}>\r\n                      <option value=\"\">Select gender</option>\r\n                      <option value=\"male\">Male</option>\r\n                      <option value=\"female\">Female</option>\r\n                      <option value=\"\">I'm not sure</option>\r\n                    </select>\r\n                </div>\r\n              </div>\r\n\r\n              <div className=\"form__group\">\r\n                <label for=\"pass\">Password</label>\r\n                <input type=\"password\" id=\"pass\" value={password} onChange={handlePasswordChange} className=\"form__input\"/>\r\n              </div>\r\n\r\n              <Link className=\"form__link\">Forgot password?</Link>\r\n\r\n              <button type=\"submit\" className=\"form__btn\">\r\n                <PrimaryBtn>Create Account</PrimaryBtn>\r\n              </button>\r\n            </form>\r\n\r\n            <div className=\"auth__line\">\r\n              <div>&nbsp;</div>\r\n              <span>or</span>\r\n              <div>&nbsp;</div>\r\n            </div>\r\n          </div>\r\n\r\n          <div className=\"auth__btns\">\r\n            <Link className=\"auth__btn\">\r\n              <svg width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\r\n                <path d=\"M4.43236 12.0862L3.7362 14.6851L1.19174 14.7389C0.431322 13.3285 0 11.7148 0 9.99997C0 8.34175 0.403276 6.77802 1.11811 5.40112H1.11866L3.38394 5.81643L4.37627 8.06812C4.16858 8.67362 4.05537 9.32361 4.05537 9.99997C4.05545 10.734 4.18842 11.4373 4.43236 12.0862Z\" fill=\"#FBBB00\"/>\r\n                <path d=\"M19.824 8.1322C19.9389 8.73712 19.9988 9.36183 19.9988 10.0003C19.9988 10.7162 19.9235 11.4146 19.7801 12.0882C19.2933 14.3805 18.0213 16.3821 16.2593 17.7986L16.2587 17.798L13.4055 17.6524L13.0017 15.1316C14.1709 14.4459 15.0846 13.3728 15.5659 12.0882H10.2188V8.1322H15.644H19.824Z\" fill=\"#518EF8\"/>\r\n                <path d=\"M16.2593 17.798L16.2599 17.7985C14.5462 19.176 12.3693 20.0002 9.99953 20.0002C6.19134 20.0002 2.88041 17.8716 1.19141 14.7392L4.43203 12.0865C5.27651 14.3403 7.45066 15.9447 9.99953 15.9447C11.0951 15.9447 12.1215 15.6486 13.0022 15.1315L16.2593 17.798Z\" fill=\"#28B446\"/>\r\n                <path d=\"M16.3818 2.30216L13.1423 4.95431C12.2308 4.38455 11.1533 4.05541 9.99894 4.05541C7.39237 4.05541 5.17756 5.7334 4.37538 8.06802L1.11773 5.40102H1.11719C2.78146 2.19228 6.13415 0 9.99894 0C12.4253 0 14.65 0.864285 16.3818 2.30216Z\" fill=\"#F14336\"/>\r\n              </svg>\r\n\r\n              Google\r\n            </Link>\r\n\r\n            <Link className=\"auth__btn\">\r\n              <svg width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\r\n                <path d=\"M18.1908 0H1.80916C0.81 0 0 0.81 0 1.80916V18.1908C0 19.19 0.81 20 1.80916 20H18.1908C19.19 20 20 19.19 20 18.1908V1.80916C20 0.81 19.19 0 18.1908 0ZM6.18885 17.2693C6.18885 17.5601 5.95314 17.795