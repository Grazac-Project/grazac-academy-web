dRules":"64"},{"filePath":"117","messages":"118","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"64"},{"filePath":"119","messages":"120","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"64"},{"filePath":"121","messages":"122","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"64"},{"filePath":"123","messages":"124","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"64"},{"filePath":"125","messages":"126","errorCount":0,"warningCount":5,"fixableErrorCount":0,"fixableWarningCount":0,"source":"127","usedDeprecatedRules":"64"},{"filePath":"128","messages":"129","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"130","usedDeprecatedRules":"64"},{"filePath":"131","messages":"132","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"64"},{"filePath":"133","messages":"134","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"64"},{"filePath":"135","messages":"136","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"64"},"C:\\Users\\'Toyosi Adekanmbi\\Desktop\\grazac-academy-web\\src\\index.js",[],["137","138"],"C:\\Users\\'Toyosi Adekanmbi\\Desktop\\grazac-academy-web\\src\\App.js",[],"C:\\Users\\'Toyosi Adekanmbi\\Desktop\\grazac-academy-web\\src\\reportWebVitals.js",[],"C:\\Users\\'Toyosi Adekanmbi\\Desktop\\grazac-academy-web\\src\\pages\\Landing.js",[],"C:\\Users\\'Toyosi Adekanmbi\\Desktop\\grazac-academy-web\\src\\pages\\UndergraduateCourseDetail.js",[],"C:\\Users\\'Toyosi Adekanmbi\\Desktop\\grazac-academy-web\\src\\pages\\AboutUs.js",[],"C:\\Users\\'Toyosi Adekanmbi\\Desktop\\grazac-academy-web\\src\\pages\\Contact.js",["139","140"],"import React, { useState, useEffect } from \"react\";\r\nimport axios from 'axios';\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport PrimaryBtn from \"../components/PrimaryBtn\";\r\n\r\nimport Facebook from \"../images/svg/facebook.svg\";\r\nimport Instagram from \"../images/svg/instagram.svg\";\r\nimport Twitter from \"../images/svg/twitter.svg\";\r\nimport Youtube from \"../images/svg/youtube.svg\";\r\nimport kamala from \"../images/kamala.jpg\";\r\n\r\nconst Contact = () => {\r\n\r\n    const [ name, setName ] = useState('');\r\n    const [ email, setEmail ] = useState('');\r\n    const [ subject, setSubject ] = useState('');\r\n    const [ message, setMessage ] = useState('');\r\n\r\n    useEffect(() => {\r\n        document.title = 'Contact - Grazac Academy';\r\n        window.scrollTo(0,0);\r\n    }, []);\r\n\r\n    const handleSubmit = () => {\r\n        if(name.length && email.length && subject.length && message.length) {\r\n            const btn = document.querySelector('#submit');\r\n            btn.setAttribute('disabled', '');\r\n            btn.textContent = 'Submitting...';\r\n            console.log('Submitted')\r\n            axios.post('http://grazacacademy.com/contact/create', {\r\n                name: name,\r\n                email: email,\r\n                subject: subject,\r\n                message: message\r\n            })\r\n            .then(resp => resp.data)\r\n            .then(response => {\r\n                if(response.success === true) {\r\n                    btn.removeAttribute('disabled');\r\n                    btn.textContent = 'Submit';\r\n                    alert(response.msg);\r\n                    setName(''); setEmail(''); setSubject(''); setMessage('');\r\n                } else {\r\n\r\n                }\r\n            })\r\n            .catch((err) => {\r\n                \r\n            });\r\n        } else {\r\n            alert('Invalid input');\r\n        }\r\n    }\r\n\r\n    return(\r\n        <div>\r\n            <Navbar/>\r\n            <div className=\"contact\">\r\n                <div className=\"contact_layer\">\r\n                    <div className=\"container\">\r\n                        <div className=\"contact_layer-text\">\r\n                            <h1>Get In Touch</h1>\r\n                            <p>We want to hear from you. Let us know how we can help</p>\r\n                        </div>\r\n                        {/*<div classname=\"contact_layer-circles\">\r\n                            <img src={kamala} alt=\"kamala\"  classname=\"contact_layer-circles-1\" />\r\n                            <img src={kamala} alt=\"kamala\"  classname=\"contact_layer-circles-2\" />\r\n                            <img src={kamala} alt=\"kamala\"  classname=\"contact_layer-circles-3\" />\r\n                            <img src={kamala} alt=\"kamala\"  classname=\"contact_layer-circles-4\" />\r\n                        </div>*/}\r\n                        <div className=\"contact_hero\">\r\n                            <div className=\"contact_hero-flexdiv\">\r\n                                <div className=\"contact_hero-flexdiv-1\" >\r\n                                    <label>Full Name  <span>*</span></label>\r\n                                    <input type=\"text\" placeholder=\"ex. John Doe\" value={name} onChange={e => setName(e.target.value)} />\r\n                                </div>\r\n                                <div className=\"contact_hero-flexdiv-2\">\r\n                                    <label>Email  <span>*</span></label>\r\n                                    <input type=\"text\" placeholder=\"ex. john@gmail.com\" value={email} onChange={e => setEmail(e.target.value)}  />\r\n                                </div>\r\n                            </div>\r\n                            <div>\r\n                                <label>Subject  <span>*</span></label>\r\n                                <input  type=\"text\" placeholder=\"ex. John Doe\" value={subject} onChange={e => setSubject(e.target.value)}  />\r\n                            </div>\r\n                            <div>\r\n                                <label>Message  <span>*</span></label>\r\n                                <textarea  type=\"text\" placeholder=\"Describe your task for us\" value={message} onChange={e => setMessage(e.target.value)}  />\r\n                            </div>\r\n                            <div className=\"contact_hero-privacy\" >\r\n                                <p>By submitting this form your consent to us emailing you occasionally about our products and services. You can unsubscribe from emails at any time, and we will never pass your email onto third parties. <span>Privacy Policy</span></p>\r\n                                <button id=\"submit\" onClick={handleSubmit}>Submit</button>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"container\">\r\n                    <div className=\"contact_campus\">\r\n                        <div className=\"contact_campus-intro\">\r\n                            <h2>Campus Inquiries</h2>\r\n                            <p>Connect with Us</p>\r\n                        </div>\r\n                        <div className=\"contact_campus-main\">\r\n                            <div className=\"contact_campus-main-div boxes33\">\r\n                                <h3>Office</h3>\r\n                                <p>PROHUB, Salawu Olabode Avenue, Ewang Road, </p>\r\n                                <p>Idi-aba, 110124, Abeokuta</p>\r\n                                <p>0906 133 3395</p>\r\n                            </div>\r\n                            <div className=\"contact_campus-main-div boxes33\">\r\n                                <h3>Book A Call</h3>\r\n                                <p>We are here to help with any questions. </p>\r\n                                <p>Talk to our programme leads.</p>\r\n                                <div style={{display:'flex'}}>\r\n                                    <PrimaryBtn>Book A Call</PrimaryBtn>\r\n                                </div>\r\n                            </div>\r\n                            <div className=\"contact_campus-main-div boxes33\">\r\n                                <h3>Social Media</h3>\r\n                                <div className=\"social\">\r\n                                    <img src={Facebook} alt=\"social\"/>\r\n                                </div>\r\n                                <div className=\"social\">\r\n                                    <img src={Twitter} alt=\"social\"/>\r\n                                </div>\r\n                                <div className=\"social\">\r\n                                    <img src={Youtube} alt=\"social\"/>\r\n                                </div>\r\n                                <div className=\"social\">\r\n                                    <img src={Instagram} alt=\"social\"/>\r\n                                </div>\r\n                            </div>\r\n\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div>\r\n                    <iframe src=\"https://www.google.com/maps/d/embed?mid=16NZ9a9VhKkk2-5nnYEdL93mxq7kjDZLT\" width=\"100%\" height=\"600\"></iframe>\r\n                </div>\r\n                {/*<extracomponent/> a component used in the landing page comes here*/}\r\n            </div>\r\n            <Footer/>\r\n        </div>\r\n    );\r\n}\r\n\r\nexport default Contact;","C:\\Users\\'Toyosi Adekanmbi\\Desktop\\grazac-academy-web\\src\\pages\\GraduateAccelerator.js",["141","142"],"import React, {useState} from \"react\";\r\nimport {Link} from \"react-router-dom\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport NeedAdvice from \"../components/NeedAdvice\";\r\nimport Qualities from \"../components/Qualities\";\r\nimport Graduates from \"../images/graduate.png\";\r\nimport loader from \"../images/loader.gif\";\r\n\r\nconst GraduateAccelerator = () => {\r\n    const [courses, setCourses] = useState([]);\r\n\r\n    React.useEffect(() => {\r\n        document.title = 'Graduate Accelerator Track - Grazac Academy';\r\n        window.scrollTo(0,0);\r\n        fetch('https://grazacacademy.com/graduate/courses')\r\n            .then(resp => resp.json())\r\n            .then(resp => {\r\n                setCourses(resp.data);\r\n            })\r\n            .catch(error => {\r\n                console.log('An error occurred when fetching the available courses, refreshing...')\r\n                window.location.reload();\r\n            })\r\n    }, []);\r\n\r\n    return(\r\n        <div>\r\n            <div className=\"gga\">\r\n                <div className=\"gga_hero\">\r\n                    <Navbar/>\r\n                    <div className=\"container\">\r\n                        <div className=\"row\">\r\n                            <div className=\"col-sm-6\">\r\n                                <div className=\"gga_hero-text\">\r\n                                    <div className=\"gga_hero-text-b\">\r\n                                        <h1>\r\n                                            Graduate Accelerator Plan\r\n                                        </h1>\r\n                                        <p>\r\n                                        We are bridging the gap between unemployment and entry-level jobs in the technology industry. Become employable in just 4 months by joining us today, we provide you with the right mentorship, tools and contents to upskill yourself.\r\n                                        </p>\r\n                                        <div className=\"contact_hero-privacy\" >\r\n                                            <a href=\"#courses\" className=\"download-brochure\">Join Us Today!</a>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div>\r\n                                <img src={Graduates} alt=\"Graduates\" className=\"gga_hero-image\" />\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"container\">\r\n                    <div className=\"course_mode-container\">\r\n                        <div className=\"boxes22\">\r\n                            <div className=\"\">\r\n                                <div className=\"boxes\">\r\n                                    <div className=\"svg-box2\">\r\n                                    <svg width=\"30\" height=\"30\" viewBox=\"0 0 30 30\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\r\n                                        <path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M22.4999 12.5001C22.4999 11.8113 21.9399 11.2501 21.2499 11.2501C20.5599 11.2501 20 11.8113 20 12.5001C20 13.1888 20.5599 13.7501 21.2499 13.7501C21.9399 13.7501 22.4999 13.1888 22.4999 12.5001ZM25.0001 12.5002C25.0001 14.5677 23.3176 16.2502 21.2501 16.2502C19.1826 16.2502 17.5001 14.5677 17.5001 12.5002C17.5001 10.4327 19.1826 8.75022 21.2501 8.75022C23.3176 8.75022 25.0001 10.4327 25.0001 12.5002ZM13.7499 8.74985C13.7499 7.3711 12.6286 6.24985 11.2499 6.24985C9.87111 6.24985 8.74986 7.3711 8.74986 8.74985C8.74986 10.1286 9.87111 11.2498 11.2499 11.2498C12.6286 11.2498 13.7499 10.1286 13.7499 8.74985ZM16.25 8.75C16.25 11.5075 14.0075 13.75 11.25 13.75C8.49253 13.75 6.25003 11.5075 6.25003 8.75C6.25003 5.9925 8.49253 3.75 11.25 3.75C14.0075 3.75 16.25 5.9925 16.25 8.75ZM17.425 18.8078C18.5112 17.9678 19.8487 17.5003 21.25 17.5003C24.6962 17.5003 27.5 20.304 27.5 23.7503C27.5 24.4403 26.9412 25.0003 26.25 25.0003C25