9105 13.4258 9.57361V12.9838Z\" fill=\"#0077B7\"/>\r\n    </svg>\r\n  </a>\r\n)\r\n\r\nconst Mode = () => {\r\n  return(\r\n    <div className=\"mode\">\r\n      {/* <div className=\"landing__middle\">\r\n        <div className=\"landing__middle--container\">\r\n          <div className=\"landing__middle--text\">\r\n            <h2>Our Facilitators</h2>\r\n            <p>We have a good range of industry experts who are ready to hold you by the hand and lead you on your career path.</p>\r\n          </div>\r\n\r\n          <div className=\"landing__middle--images--box\">\r\n            <div className=\"landing__middle--images\">\r\n              <img src={Man}/>\r\n              <a>Olalekan Sogunle</a>\r\n              <h5>CAREERFOUNDRY</h5>\r\n              <small>Software Engineer</small>\r\n              <Linkedn />\r\n            </div>\r\n\r\n            <div className=\"landing__middle--images\">\r\n              <img src={Man}/>\r\n              <a>Olalekan Sogunle</a>\r\n              <h5>CAREERFOUNDRY</h5>\r\n              <small>Software Engineer</small>\r\n              <Linkedn />\r\n            </div>\r\n\r\n            <div className=\"landing__middle--images\">\r\n              <img src={Man}/>\r\n              <a>Olalekan Sogunle</a>\r\n              <h5>CAREERFOUNDRY</h5>\r\n              <small>Software Engineer</small>\r\n              <Linkedn />\r\n            </div>\r\n\r\n            <div className=\"landing__middle--images\">\r\n              <img src={Man}/>\r\n              <a>Olalekan Sogunle</a>\r\n              <h5>CAREERFOUNDRY</h5>\r\n              <small>Software Engineer</small>\r\n              <Linkedn />\r\n            </div>\r\n\r\n            <div className=\"landing__middle--images\">\r\n              <img src={Man}/>\r\n              <a>Olalekan Sogunle</a>\r\n              <h5>CAREERFOUNDRY</h5>\r\n              <small>Software Engineer</small>\r\n              <Linkedn />\r\n            </div>\r\n\r\n            <div className=\"landing__middle--images\">\r\n              <img src={Man}/>\r\n              <a>Olalekan Sogunle</a>\r\n              <h5>CAREERFOUNDRY</h5>\r\n              <small>Software Engineer</small>\r\n              <Linkedn />\r\n            </div>\r\n\r\n            <div className=\"landing__middle--images\">\r\n              <img src={Man}/>\r\n              <a>Olalekan Sogunle</a>\r\n              <h5>CAREERFOUNDRY</h5>\r\n              <small>Software Engineer</small>\r\n              <Linkedn />\r\n            </div>\r\n\r\n            <div className=\"landing__middle--images\">\r\n              <img src={Man}/>\r\n              <a>Olalekan Sogunle</a>\r\n              <h5>CAREERFOUNDRY</h5>\r\n              <small>Software Engineer</small>\r\n              <Linkedn />\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div> */}\r\n\r\n      <div className=\"landing__discount\">\r\n        <div className=\"landing__discount--container\">\r\n          <div className=\"landing__discount--img\">\r\n            <img src={lady}/>\r\n          </div>\r\n          <div className=\"landing__discount--text\">\r\n            <h3>Get equipped for the career you desire.</h3>\r\n            <p>You will gain insights into today’s digital skills and tools necessary for the future of work.</p>\r\n            <div className=\"landing__btn--2\">\r\n              {/* <PrimaryBtn link=\"/\">Enroll Now</PrimaryBtn> */}\r\n              <a>\r\n                <div className=\"nav__btn nav__btn-flex \">\r\n                  <a href=\"/#tracks\"><div className=\"nav__btn--text\" style={{marginRight:'20px'}}>Enroll Now</div></a>\r\n                  <a href=\"tel:+2348068365951\" ><div className=\"nav__btn--text1\">Talk to us</div></a>\r\n                </div>\r\n              </a>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  )\r\n}\r\n\r\nexport default Mode;","C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\components\\SchoolList.js",[],"C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\components\\Modal.js",[],"C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\components\\InfoModal.js",["284"],"import { useState } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport badge from \"../images/svg/badge.svg\";\r\nimport ex from \"../images/svg/x-mark.svg\";\r\n\r\nconst InfoModal = () => {\r\n  const [showModal, setShowModal] = useState(true);\r\n\r\n  return (\r\n    <div>\r\n        <div className=\"infomodal\">\r\n          <div className=\"infomodal_content\">\r\n            <img src={badge} alt=\"\" />\r\n            <p>\r\n              Grazac Graduate Accelerator Program is closed for enrollment., You\r\n              can apply for internship positions\r\n            </p>\r\n            <Link to=\"/internship\">\r\n              <button>Enroll</button>\r\n            </Link>\r\n            <img\r\n              src={ex}\r\n              alt=\"\"\r\n              onClick={() => setShowModal(false)}\r\n              style={{ cursor: \"pointer\" }}\r\n            />\r\n          </div>\r\n        </div>\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default InfoModal;\r\n","C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\components\\NavItem.js",[],"C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\pages\\graduateCohort\\auth\\MailSent.js",["285"],"import { Link } from \"react-router-dom\";\r\nimport logo from '../../../images/svg/academy-logo.svg';\r\nimport email from '../../../images/svg/email.svg';\r\n\r\n\r\nfunction MailSent () {\r\n    return(\r\n        <div className=\"layout_auth\">\r\n            <div className=\"layout_auth-main\">\r\n                <div className=\"auth_container\">\r\n                    <div className=\"auth_container-logo\" >\r\n                        <img src={logo} alt=\"logo\" />\r\n                    </div>\r\n                    <div className=\"auth_container_form\">\r\n                        <img src={email} alt=\"email\" className=\"auth_container_form-email\" />\r\n                        <h3>Password reset link sent!</h3>\r\n                        <p className=\"auth_container_form-text\">We have sent you an email containing a link to reset your password, kindly check your email to set a new password.</p>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n            <div className=\"layout_auth-image\">\r\n\r\n            </div>\r\n        </div>\r\n    )\r\n}\r\n\r\nexport default MailSent;","C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\pages\\graduateCohort\\auth\\ResetPassword.js",["286","287","288"],"C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\pages\\graduateCohort\\auth\\Login.js",["289"],"C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\pages\\graduateCohort\\auth\\ForgotPassword.js",[],"C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\pages\\graduateCohort\\auth\\SignUp.js",["290","291"],"import { useState } from 'react';\r\nimport { Link } from \"react-router-dom\";\r\nimport { ToastContainer, toast } from 'react-toastify';\r\nimport { SignupAction } from \"../../../api/dashboard/auth\";\r\nimport axios from 'axios';\r\nimport logo from '../../../images/svg/academy-logo.svg';\r\nimport visible from '../../../images/svg/visible.svg';\r\nimport notvisible from '../../../images/svg/notvisible.svg';\r\nimport loader from \"../../../images/svg/dashboard/loader.gif\";\r\n\r\n\r\nfunction SignUp () {\r\n    const [form, setForm] = useState({\r\n        firstName: \"\",\r\n        lastName: \"\",\r\n        email: \"\",\r\n        phone: \"\",\r\n        password: \"\"\r\n    });\r\n\r\n    const handleChange = (e) => {\r\n        setForm({\r\n            ...form,\r\n            [e.target.name]: e.target.value\r\n        })\r\n    }\r\n\r\n    const doSignUp = (e) => {\r\n        e.preventDefault();\r\n        var btn = document.getElementById(\"actionBtn\");\r\n        if (form.password.length > 5){\r\n            btn.innerHTML=`<img src=${loader} width=\"20px\" />`;\r\n            const {firstName, lastName, email, phone, password} = form;\r\n            var data  = new FormData();\r\n\r\n            data.append(\"firstName\", firstName);\r\n            data.append(\"lastName\", lastName);\r\n            data.append(\"email\", email);\r\n            data.append(\"phoneNumber\", phone);\r\n            data.append(\"password\", password);\r\n\r\n            SignupAction(data)\r\n                .then((response) => response.data)\r\n                .then((res) => {\r\n                    // console.log(res);\r\n                    if (res.status === 201) {\r\n                        toast.success(`${res.message} Proceed to login.`);\r\n                        btn.innerHTML=`Create account`;\r\n                        window.location = \"/account-created\";\r\n                    } else {\r\n                        toast.error(\"Something went wrong, please try again!!!\")\r\n                    }\r\n                })\r\n                .catch((err) => {\r\n                    // console.log(err.response.data.message);\r\n                    if(err.response.data.message){\r\n                        toast.error(err.response.data.message);\r\n                        btn.innerHTML=`Create account`;\r\n                    } else{\r\n                        toast.error(\"Something went wrong!!! Please make sure you have a good internet connection.\");\r\n                        btn.innerHTML=`Create account`;\r\n                    }\r\n                });\r\n        } else {\r\n            toast.error(\"Password must be at least 6 characters!\");\r\n        }\r\n    }\r\n\r\n    const toggleIcon = () => {\r\n        var x = document.getElementById(\"password\");\r\n        var iconContainer = document.getElementById(\"toggle\");\r\n        if (x.type === \"password\") {\r\n          x.type = \"text\";\r\n          iconContainer.innerHTML = `<img src=${notvisible} />`\r\n        } else {\r\n          x.type = \"password\";\r\n          iconContainer.innerHTML = `<img src=${visible} />` ;\r\n        }\r\n    }\r\n\r\n    return(\r\n        <div className=\"layout_auth\">\r\n            <ToastContainer/>\r\n            <div className=\"layout_auth-main\">\r\n                <div className=\"auth_container\">\r\n                    <div className=\"auth_container-logo\" >\r\n                        <img src={logo} alt=\"logo\" />\r\n                    </div>\r\n                    <div className=\"auth_container_form\">\r\n                        <h3>Create an Account</h3>\r\n                        <p className=\"auth_container_form-text\">Create a free account to start your application</p>\r\n                        <form onSubmit={doSignUp}>\r\n                            <div>\r\n                                <label>First Name</label>\r\n                                <input type=\"text\" required placeholder=\"First Name\" name=\"firstName\" onChange={handleChange} />\r\n                            </div>\r\n                            <div>\r\n                                <label>Last Name</label>\r\n                                <input type=\"text\" required placeholder=\"Last Name\" name=\"lastName\" onChange={handleChange} />\r\n                            </div>\r\n                            <div>\r\n                                <label>Email Address</label>\r\n                                <input type=\"email\" required placeholder=\"Email Address\" name=\"email\" onChange={handleChange} />\r\n                            </div>\r\n                            <div>\r\n                                <label>Phone Number</label>\r\n                                <input type=\"number\" required placeholder=\"Phone Number\" name=\"phone\" onChange={handleChange} />\r\n                            </div>\r\n                            <div className=\"auth_container_form-password\">\r\n                                <label>Password</label>\r\n                                <input type=\"password\" id=\"password\" required placeholder=\"Password\" name=\"password\" onChange={handleChange} />\r\n                                <div id=\"toggle\" onClick={toggleIcon} ><img src={visible} /></div>\r\n                            </div>\r\n                            <button type=\"submit\" id=\"actionBtn\">Create account</button>\r\n                            <p>Already have an account? <Link to=\"/login\"><span>Login</span></Link></p>\r\n                        </form>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n            <div className=\"layout_auth-image\">\r\n\r\n            </div>\r\n        </div>\r\n    )\r\n}\r\n\r\nexport default SignUp;","C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\pages\\graduateCohort\\auth\\VerifyMail.js",[],"C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\pages\\graduateCohort\\dashboard\\Main.js",["292"],"C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\components\\dashboard\\Sidebar.js",["293","294"],"C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\components\\dashboard\\Details.js",[],"C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\components\\dashboard\\Admitted.js",[],"C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\components\\dashboard\\Rejected.js",[],"C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\components\\dashboard\\not-submitted\\index.js",["295"],"import { useState } from \"react\";\r\nimport { ToastContainer, toast } from 'react-toastify';\r\nimport { submitDetails } from \"../../../api/dashboard/data\";\r\n\r\nimport arrow from \"../../../images/svg/dashboard/arrow.svg\";\r\nimport loader from \"../../../images/svg/dashboard/loader.gif\";\r\n\r\n\r\nfunction NotSubmitted () {\r\n    const [active, setActive] = useState(\"welcome\");\r\n    const [formActive, setFormActive] = useState(\"\");\r\n    const [bioData, setBioData] = useState({\r\n        firstName: \"\",\r\n        lastName: \"\",\r\n        email: \"\",\r\n        phone: \"\",\r\n        dob: \"\",\r\n        gender: \"\",\r\n        course: \"\",\r\n        state: \"\",\r\n        city: \"\",\r\n        id: \"\"\r\n    });\r\n    const [education, setEducation] = useState({\r\n        courseOfStudy: \"\",\r\n        grade: \"\",\r\n        qualification: \"\",\r\n        experience: \"\",\r\n        nyscStatus: \"\",\r\n        reason: \"\",\r\n        availability: \"\",\r\n        legalFee: \"\"\r\n    });\r\n    \r\n    const handleChange = (e) => {\r\n        setBioData({\r\n            ...bioData,\r\n            [e.target.name]: e.target.value\r\n        })\r\n        setEducation({\r\n            ...education,\r\n            [e.target.name]: e.target.value\r\n        })\r\n    }\r\n\r\n    const showForm = () => {\r\n        var check = document.getElementById(\"check\");\r\n        if(check.checked){\r\n            setActive(\"form\");\r\n            setFormActive(\"bio-data\")\r\n        } else {\r\n            toast.warn(\"You need to accept the terms and conditions to proceed!\")\r\n        }\r\n    }\r\n\r\n    const showEduForm = (e) => {\r\n        e.preventDefault();\r\n        setFormActive(\"education\")\r\n    }\r\n\r\n    const submitForm = (e) => {\r\n        e.preventDefault();\r\n        var btn = document.getElementById(\"actionBtn\");\r\n        btn.innerHTML = `<img src=${loader} width=\"20px\" />`;\r\n        var data  = new FormData();\r\n\r\n        // data.append(\"firstName\", bioData.firstName);\r\n        // data.append(\"lastName\", bioData.lastName);\r\n        // data.append(\"email\", bioData.email);\r\n        // data.append(\"phoneNumber\", bioData.phone);\r\n        data.append(\"dob\", bioData.dob);\r\n        data.append(\"gender\", bioData.gender);\r\n        data.append(\"preferred_course\", bioData.course);\r\n        data.append(\"state_of_residence\", bioData.state);\r\n        data.append(\"current_city_and_location\", bioData.city);\r\n        data.append(\"means_of_identification\", 'means of id');\r\n        data.append(\"course_of_study\", education.courseOfStudy);\r\n        data.append(\"grade_achieved\", education.grade);\r\n        data.append(\"qualifications\", education.qualification);\r\n        data.append(\"programming_skills\", education.experience);\r\n        data.append(\"nysc_status\", education.nyscStatus);\r\n        data.append(\"why_selected_for_cohort\", education.reason);\r\n        data.append(\"physically_available\", education.availability);\r\n        data.append(\"will_you_pay_legal_fees\", education.legalFee);\r\n        \r\n        submitDetails(data)\r\n            .then((response) => response.data)\r\n            .then((res) => {\r\n                console.log(res);\r\n                if (res.success === true) {\r\n                    toast.success(\"Submission successful! Your Application is now under review.\");\r\n                    btn.innerHTML = `Submit`;\r\n                } else {\r\n                    toast.error(\"Submission not successful, try again!!!\")\r\n                    btn.innerHTML = `Submit`;\r\n                }\r\n            })\r\n            .catch((err) => {\r\n                console.log(err)\r\n                if(err.response){\r\n                    toast.error(err.response);\r\n                    btn.innerHTML = `Submit`;\r\n                } else{\r\n                    toast.error(\"Something went wrong!!! Please make sure you have a good internet connection.\");\r\n                    btn.innerHTML = `Submit`;\r\n                }\r\n            });\r\n        \r\n    }\r\n\r\n    return (\r\n        <div>\r\n            <ToastContainer closeButton={false}/>\r\n            {active === \"welcome\" &&\r\n                <div>\r\n                    <h3>Hello John</h3>\r\n                    <p className=\"text1\">Learn with us for 5 months and pay no tuition till you’re hired!</p>\r\n                    <p>Grazac Accelerator Program is a full time, 5-month training program focused on building in-demand tech skills at an accelerated pace. This program goes above and beyond to provide a superior educational experience, allowing students to develop a successful career in the tech industry through intensive training and internships.</p>\r\n                    <p>Our curriculum covers 4 basic tech disciplines that includes;</p>\r\n                    <ul>\r\n                        <li>Product Designing (UI/UX)</li>\r\n                        <li>Front end web development (HTML, CSS, and Javascript (React.js)</li>\r\n                        <li>Back end web development (Nodejs)</li>\r\n                        <li>Mobile Application Development (Flutter and Dart)</li>\r\n                    </ul>\r\n                    <h4>Pricing Plans</h4>\r\n                    <p>Enrollment is free but for the tuition fee, we offer two basic forms of payment options and they are;</p>\r\n                    <ul>\r\n                        <li><strong>Pay as you Earn plan:</strong> This is a financial instrument to help you participate in our training for FREE. You are expected to start paying us back once you get a job at the end of the program. It is governed by a legally binding contract. This contract is bonded by the law firm.</li>\r\n                        <li><strong>Pay at once:</strong> You can pay your tuition fee all at once with this plan.</li>\r\n                    </ul>\r\n                    <h4>Duration</h4>\r\n                    <ul>\r\n                        <li>5months ( 3months intensive training + 2months internship).</li>\r\n                    </ul>\r\n                    <h4>Basic Criteria to be met</h4>\r\n                    <ul>\r\n                        <li>Candidates must be a Graduate and available full-time for at least 6 months.</li>\r\n                        <li>Note that you will be mandated to provide guarantors and pay the sum of #30,000 legal fee if selected for this cohort. This must be paid within a week after selection if you have chosen our Pay as you Earn option.</li>\r\n                    </ul>\r\n                    <div className=\"checkbox\">\r\n                        <input type=\"checkbox\" id=\"check\" />\r\n                        <p>I accept the <a href=\"#\">Terms ‌and‌ ‌Conditions‌</a></p>\r\n                    </div>\r\n                    <button className=\"button\" onClick={showForm}>Apply Now</button>\r\n                </div>\r\n            }\r\n            {active === \"form\"  &&\r\n                <div>\r\n                    <div>\r\n                        <div className=\"dashboard-content-back\" onClick={()=>setActive(\"welcome\")} >\r\n                            <img src={arrow} alt=\"back\" />\r\n                            <p>Back</p>\r\n                        </div>\r\n                        <h4 style={{marginLeft:\"20px\"}}>Apply</h4>\r\n                        {formActive === \"bio-data\" && (\r\n                            <div className=\"dashboard-content-form\">\r\n                                <form onSubmit={showEduForm}>\r\n                                    <p>Step 1 of 2</p>\r\n                                    <p>BIO DATA</p>\r\n                                    <div className=\"dashboard-content-form-container\">\r\n                                        <label>First Name</label>\r\n                                        <input type=\"text\" required name=\"firstName\" placeholder=\"FirstName\" onChange={handleChange} />\r\n                                    </div>\r\n                                    <div className=\"dashboard-content-form-container\">\r\n                                        <label>Last Name</label>\r\n                                        <input type=\"text\" required name=\"lastName\" placeholder=\"LastName\" onChange={handleChange} />\r\n                                    </div>\r\n                                    <div className=\"dashboard-content-form-container\">\r\n                                        <label>Email Address</label>\r\n                                        <input type=\"email\" required name=\"email\" placeholder=\"Email Address\" onChange={handleChange} />\r\n                                    </div>\r\n                                    <div className=\"dashboard-content-form-container\">\r\n                                        <label>Phone Number</label>\r\n                                        <input type=\"number\" required name=\"phone\" placeholder=\"Phone Number\" onChange={handleChange} />\r\n                                    </div>\r\n                                    <div className=\"dashboard-content-form-container\">\r\n                                        <label>Date of Birth</label>\r\n                                        <input type=\"date\" required name=\"dob\" placeholder=\"31/01/2021\" onChange={handleChange} />\r\n                                    </div>\r\n                                    <div className=\"dashboard-content-form-container\">\r\n                                        <label>Gender</label>\r\n                                        <select name=\"gender\" required onChange={handleChange}>\r\n                                            <option>Select Gender</option>\r\n                                            <option value=\"male\">Male</option>\r\n                                            <option value=\"female\">Female</option>\r\n\r\n                                        </select>\r\n                                    </div>\r\n                                    <div className=\"dashboard-content-form-container\">\r\n                                        <label>Preferred course at Grazac</label>\r\n                                        <select name=\"course\" required onChange={handleChange}>\r\n                                            <option>Select Preferred Course</option>\r\n                                            <option value=\"Product Design\">Product Design</option>\r\n                                            <option value=\"Frontend Web Development\">Front-end Web Development</option>\r\n                                            <option value=\"Backend Web Development\">Back-end Web Development</option>\r\n                                            <option value=\"Android Development\">Android Development</option>\r\n                                        </select>\r\n                                    </div>\r\n                                    <div className=\"dashboard-content-form-container\">\r\n                                        <label>State of residence</label>\r\n                                        <select name=\"state\" required onChange={handleChange}>\r\n                                            <option>Select State</option>\r\n                                            <option value=\"Ogun\">Ogun</option>\r\n                                            <option value=\"Lagos\">Lagos</option>\r\n                                        </select>\r\n                                    </div>\r\n                                    <div className=\"dashboard-content-form-container\">\r\n                                        <label name=\"city\" onChange={handleChange}>Current city and Location</label>\r\n                                        <input type=\"text\" required name=\"city\" placeholder=\"Current City and Location\" onChange={handleChange} />\r\n                                    </div>\r\n                                    <div className=\"dashboard-content-form-container\">\r\n                                        <label>Means of Identification (NIN/ Voter's Card)</label>\r\n                                        <input type=\"file\" required  name=\"id\" onChange={handleChange}/>\r\n                                    </div>\r\n                                    <button style={{float:\"right\"}} type=\"submit\">Continue</button>\r\n                                </form>\r\n                            </div>\r\n                        )}\r\n                        \r\n                        {formActive === \"education\" && (\r\n                            <div className=\"dashboard-content-form\">\r\n                                <form onSubmit={submitForm}>\r\n                                    <p>Step 2 of 2</p>\r\n                                    <p>Educational Background</p>\r\n                                    <div className=\"dashboard-content-form-container\">\r\n                                        <label>Course of Study</label>\r\n                                        <input type=\"text\" required name=\"courseOfStudy\" placeholder=\"Course of Study\" onChange={handleChange} />\r\n                                    </div>\r\n                                    <div className=\"dashboard-content-form-container\">\r\n                                        <label>Grade Achieved</label>\r\n                                        <input type=\"text\" required name=\"grade\" placeholder=\"Grade Achieved\" onChange={handleChange} />\r\n                                    </div>\r\n                                    <div className=\"dashboard-content-form-container\">\r\n                                        <label>Qualification</label>\r\n                                        <select name=\"qualification\" required onChange={handleChange}>\r\n                                            <option value=\"\">Select Qualification</option>\r\n                                            <option value=\"B.Sc\">B.Sc</option>\r\n                                            <option value=\"ND\">ND</option>\r\n                                            <option value=\"HND\">HND</option>\r\n                                            <option value=\"M.Sc\">M.Sc</option>\r\n                                            <option value=\"PhD\">PhD</option>\r\n                                            <option value=\"other\">other</option>\r\n                                        </select>\r\n                                    </div>\r\n                                    <div className=\"dashboard-content-form-container\">\r\n                                        <label>Programming/Design Experience</label>\r\n                                        <select name=\"experience\" required onChange={handleChange}>\r\n                                            <option value=\"\">Select Programming/Design Experience</option>\r\n                                            <option value=\"No skill\">No skill</option>\r\n                                            <option value=\"Basic skill\">Basic skill</option>\r\n                                            <option value=\"Mid-level skill\">Mid-level Skill</option>\r\n                                        </select>\r\n                                    </div>\r\n                                    <div className=\"dashboard-content-form-container\">\r\n                                        <label>Nysc Status</label>\r\n                                        <select name=\"nyscStatus\" required onChange={handleChange}>\r\n                                            <option value=\"\">Select Nysc Status</option>\r\n                                            <option value=\"Service\">Service</option>\r\n                                            <option value=\"Exemption\">Exemption</option>\r\n                                            <option value=\"Use period to learn\">I will use my period of service to learn</option>\r\n                                            <option value=\"Other\">Other</option>\r\n                                        </select>\r\n                                    </div>\r\n                                    <div className=\"dashboard-content-form-container\">\r\n                                        <label>Why do you think you should be selected as a part of this cohort?</label>\r\n                                        <textarea type=\"text\" required name=\"reason\" placeholder=\"Write your reasons here...\" onChange={handleChange} />\r\n                                    </div>\r\n                                    <div className=\"dashboard-content-form-container\">\r\n                                        <label>Will you be physically available for the next 6 months?</label>\r\n                                        <select name=\"availability\" required onChange={handleChange}>\r\n                                            <option value=\"\">Select Availability</option>\r\n                                            <option value=\"Yes\">Yes</option>\r\n                                            <option value=\"No\">No</option>\r\n                                        </select>\r\n                                    </div>\r\n                                    <div className=\"dashboard-content-form-container\">\r\n                                        <label>If selected, will you be able to pay the legal fees of #30,000?</label>\r\n                                        <select name=\"legalFee\" required onChange={handleChange}>\r\n                                            <option value=\"\">Select</option>\r\n                                            <option value=\"Yes\">Yes</option>\r\n                                            <option value=\"No\">No</option>\r\n                                        </select>\r\n                                    </div>\r\n                                    <button style={{float:\"right\", width: \"50px\"}} type=\"submit\" id=\"actionBtn\">Submit</button>\r\n                                    <button className=\"dashboard-content-form-container-prev\" onClick={()=>setFormActive(\"bio-data\")}>Previous</button>\r\n                                </form>\r\n                            </div>\r\n                        )}\r\n                    </div>\r\n                </div>\r\n            }\r\n        </div>\r\n    )\r\n}\r\n\r\nexport default NotSubmitted;","C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\components\\dashboard\\UnderReview.js",["296"],"function UnderReview () {\r\n    return(\r\n        <div>\r\n            <h3>Hello John</h3>\r\n            <p className=\"text1\">Thanks for applying to Grazac Academy!</p>\r\n            <p>Your application has been submitted successfully and currently under review. Kindly, keep an eye on your email to get an update on your application status.</p>\r\n        </div>\r\n    )\r\n}\r\n\r\nexport default UnderReview;","C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\components\\dashboard\\selected\\PaymentReceived.js",[],"C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\api\\dashboard\\auth.js",[],"C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\api\\dashboard\\apikit.js",[],"C:\\Users\\user\\Desktop\\Github\\grazac-academy-web\\src\\api\\dashboard\\data.js",[],{"ruleId":"297","replacedBy":"298"},{"ruleId":"299","replacedBy":"300"},{"ruleId":"301","severity":1,"message":"302","line":8,"column":25,"nodeType":"303","messageId":"304","endLine":8,"endColumn":33},{"ruleId":"301","severity":1,"message":"305","line":70,"column":7,"nodeType":"303","messageId":"304","endLine":70,"endColumn":11},{"ruleId":"301","severity":1,"message":"306","line":105,"column":10,"nodeType":"303","messageId":"304","endLine":105,"endColumn":18},{"ruleId":"301","severity":1,"message":"307","line":105,"column":20,"nodeType":"303","messageId":"304","endLine":105,"endColumn":31},{"ruleId":"301","severity":1,"message":"308","line":1,"column":25,"nodeType":"303","messageId":"304","endLine":1,"endColumn":33},{"ruleId":"301","severity":1,"message":"309","line":2,"column":8,"nodeType":"303","messageId":