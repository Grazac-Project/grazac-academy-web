ey={index}>\r\n                <div className=\"course_learn-main-list\">\r\n                    <div className=\"box1\">\r\n                        <h3>{item.id}</h3>\r\n                    </div>\r\n                    <div className=\"box2\">\r\n                        <h3>{item.topic}</h3>\r\n                    </div>\r\n                    <div className=\"box3\">\r\n                        <p>{item.content}</p>\r\n                    </div>\r\n                </div>\r\n                <hr/>\r\n            </div>\r\n        ))\r\n        return(<div>{list}</div>)\r\n    }\r\n    return(\r\n        <div>\r\n            <Navbar/>\r\n            <div className=\"course\">\r\n                <div className=\"gua_hero\">\r\n                    <div className=\"container\">\r\n                        <div className=\"row\">\r\n                            <div className=\"col-sm-6\">\r\n                                <div className=\"gua_hero-text\">\r\n                                    <div className=\"gua_hero-text-b\">\r\n                                        <h1>\r\n                                            {course.name}\r\n                                        </h1>\r\n                                        <p>\r\n                                            {course.description}\r\n                                        </p>\r\n                                        <div className=\"contact_hero-privacy\" >\r\n                                            <button>Download Brochure</button>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div>\r\n\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"course_learn\">\r\n                    <div className=\"container\">\r\n                        <div className=\"course_wwd-intro\">\r\n                            <h4>GRAZAC ACADEMY</h4>\r\n                            <h2>What you'll Learn</h2>\r\n                        </div>\r\n                        <div className=\"course_learn-main\">\r\n                            <RenderOutline/>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"course_mode\">\r\n                    <div className=\"container\">\r\n                        <div className=\"course_wwd-intro\">\r\n                            <h4>What we do</h4>\r\n                            <h2>Mode Of Teaching</h2>\r\n                            <p>Amet minim mollit non deserunt ullamco est sit aliqua dolor do amet sint. Velit officia consequ</p>\r\n                        </div>\r\n                        <div className=\"course_mode-container\">\r\n                            <div className=\"\">\r\n                                <div>\r\n                                    <div className=\"boxes\">\r\n                                        <div className=\"svg-box\"></div>\r\n                                        <h3></h3>\r\n                                        <p>Learn the foundations of database management with focus on relational database systems and its terminologies.</p>\r\n                                    </div>\r\n                                    <div className=\"boxes\">\r\n                                        <div className=\"svg-box\"></div>\r\n                                        <h3></h3>\r\n                                        <p>Learn the foundations of database management with focus on relational database systems and its terminologies.</p>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div className=\"\">\r\n                                <div>\r\n                                    <div className=\"boxes\">\r\n                                        <div className=\"svg-box\"></div>\r\n                                        <h3></h3>\r\n                                        <p>Learn the foundations of database management with focus on relational database systems and its terminologies.</p>\r\n                                    </div>\r\n                                    <div className=\"boxes\">\r\n                                        <div className=\"svg-box\"></div>\r\n                                        <h3></h3>\r\n                                        <p>Learn the foundations of database management with focus on relational database systems and its terminologies.</p>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div className=\"mode-pic\">\r\n                                <img src={sprint} alt=\"jdgkj\" style={{width:'100%'}} />\r\n                            </div>\r\n                        </div>\r\n                        <div className=\"course_mode-quote\">\r\n                            <img src={quote} alt=\"quote\" />\r\n                            <p>Online learning can be a lifeline to those who have obstacles, such as geographical distances or physical disabilities.</p>\r\n                            <span>Paul Levinson</span>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"course_purple\">\r\n                    <div className=\"course_purple_txt\">\r\n                        <p>Pricing</p>\r\n                        <h1>50%</h1>\r\n                        <p>Scholarship Available</p>\r\n                    </div>\r\n                    <div className=\"course_purple-main\">\r\n                        <div className=\"course_purple-main-boxes\">\r\n                            <h4>FULL TUITION PAYMENT</h4>\r\n                            <h2>₦540,000</h2>\r\n                            <p>Pay your fees 100% upfront. No other charges come up during your career</p>\r\n                        </div>\r\n                        <div className=\"course_purple-main-boxes\">\r\n                            <h4>FULL TUITION PAYMENT</h4>\r\n                            <h2>₦540,000</h2>\r\n                            <p>Pay your fees 100% upfront. No other charges come up during your career</p>\r\n                        </div>\r\n                        <div className=\"course_purple-main-boxes\">\r\n                            <h4>FULL TUITION PAYMENT</h4>\r\n                            <h2>₦540,000</h2>\r\n                            <p>Pay your fees 100% upfront. No other charges come up during your career</p>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"course_purple-btn\">\r\n                        <PrimaryBtn>Claim Scholarship</PrimaryBtn> \r\n                        <p>Talk to course rep</p>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n            <Footer/>\r\n        </div>\r\n    );\r\n}\r\n\r\nexport default CourseDetail;","C:\\Users\\USER\\Desktop\\Web Development\\Bitbucket\\grazac-academy\\src\\pages\\UndergraduateAccelerator.js",["101","102"],"import React from \"react\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport NeedAdvice from \"../components/NeedAdvice\";\r\nimport PopularCourses from \"../components/PopularCourses\";\r\nimport Qualities from \"../components/Qualities\";\r\n\r\nimport undergraduate from \"../images/undergraduate.png\";\r\n\r\nconst UndergraduateAccelerator = () => {\r\n\r\n    React.useEffect(() => {\r\n        document.title = 'Undergraduate Accelerator Track - Grazac Academy';\r\n        window.scrollTo(0,0);\r\n    }, []);\r\n\r\n    return(\r\n        <div>\r\n            <div className=\"gua\">\r\n                <div className=\"gua_hero\">\r\n                        <Navbar/>\r\n                    <div className=\"container\">\r\n                        <div className=\"row\">\r\n                            <div className=\"col-sm-6\">\r\n                                <div className=\"gua_hero-text\">\r\n                                    <div className=\"gua_hero-text-b\">\r\n                                        <h1>\r\n                                            Undergraduate Accelerator Track\r\n                                        </h1>\r\n                                        <p> We equip you for the future of the career you desire,\r\n                                        Become an asset in this 21st century before leaving the four walls of school.</p>\r\n                                        <p>Join thousands of young undergraduates now. Access to mentorship tailored to your career path.</p>\r\n                                        <p>Become the next best talent to be hired in this 21st century and be employable.</p>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div>\r\n                                <img src={undergraduate} alt=\"undergraduate\"  className=\"gua_hero-image\" />\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"container\">\r\n                    <div className=\"gga\">\r\n                        <div className=\"course_mode-intro course_mode-intro\">\r\n                            <h4 style={{marginTop:'100px'}}>How it works</h4>\r\n                            <h2>Highlighted Learning</h2>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"gua_highlight\">\r\n                        <div className=\"boxes44 gua_highlight-box1\">\r\n                            <div className=\"gua_highlight-box3\">\r\n                                <div className=\"gua_highlight-box4\">\r\n                                    <h3><strong>Student Lead</strong></h3>\r\n                                    <p>Become our ambassador in your institution. </p>\r\n                                    <p>Lead other students who are ready to prepare themselves for the future of work.</p>\r\n                                    <a className=\"white-link\">Apply as Student Lead</a>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                        <div className=\"boxes44 gua_highlight-box2\">\r\n                            <div  className=\"gua_highlight-box3\">\r\n                                <div className=\"gua_highlight-box4\">\r\n                                    <h3><strong>Affiliated Campuses</strong></h3>\r\n                                    <p>We are well represented in various institutions of learning across Nigeria.</p>\r\n                                    <p>We want to prepare you for the future of work before you leave the four walls of learning.</p>\r\n                                    <a className=\"white-link\">Learn More</a>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <PopularCourses />\r\n                <Qualities />\r\n                <NeedAdvice />\r\n            </div>\r\n            <Footer/>\r\n        </div>\r\n    );\r\n}\r\n\r\nexport default UndergraduateAccelerator;","C:\\Users\\USER\\Desktop\\Web Development\\Bitbucket\\grazac-academy\\src\\pages\\Contact.js",["103"],"C:\\Users\\USER\\Desktop\\Web Development\\Bitbucket\\grazac-academy\\src\\pages\\Landing.js",["104"],"C:\\Users\\USER\\Desktop\\Web Development\\Bitbucket\\grazac-academy\\src\\pages\\GraduateAccelerator.js",[],"C:\\Users\\USER\\Desktop\\Web Development\\Bitbucket\\grazac-academy\\src\\auth\\Signup.js",["105","106","107","108","109","110","111","112","113","114","115","116","117"],"import { useState } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { cn } from \"../utils\";\r\nimport PrimaryBtn from \"../components/PrimaryBtn\";\r\nimport Grazac from \"../images/grazac.png\";\r\n\r\nconst validEmailRegex = RegExp(\r\n  /^(([^<>()\\[\\]\\.,;:\\s@\\\"]+(\\.[^<>()\\[\\]\\.,;:\\s@\\\"]+)*)|(\\\".+\\\"))@(([^<>()[\\]\\.,;:\\s@\\\"]+\\.)+[^<>()[\\]\\.,;:\\s@\\\"]{2,})$/i\r\n);\r\n\r\nconst Signup = () => {\r\n  const [email, setEmail] = useState(\"\");\r\n  const [password, setPassword] = useState(\"\");\r\n  const [emailErr, setEmailErr] =  useState(\"\");\r\n  const [phone, setPhone] = useState(\"\");\r\n  const [gender, setGender] = useState(\"\");\r\n\r\n  \r\n  const handleEmailChange = e => {\r\n    e.preventDefault();\r\n    setEmail(e.target.value)\r\n\r\n    if (!email) setEmailErr(\"\");\r\n    let err = validEmailRegex.test(e.target.value) ? \"\" : \"please enter a valid email address\";\r\n    setEmailErr(err);\r\n  }\r\n\r\n  const handlePasswordChange = e => {\r\n    e.preventDefault();\r\n    setPassword(e.target.value)\r\n  }\r\n\r\n  return(\r\n    <div className=\"auth\">\r\n      <div className=\"auth__body\">\r\n        <div className=\"auth__hero\">\r\n          <img src={Grazac} alt=\"grazac\" />\r\n        </div>\r\n\r\n        <div className=\"auth__form\">\r\n          <div className=\"auth__form--container\">\r\n            <h1>Create Account</h1>\r\n\r\n            <form className=\"form\">\r\n              <div className=\"form__group\">\r\n                <label for=\"email\">Email address</label>\r\n                <input type=\"email\" id=\"email\" value={email} onChange={handleEmailChange} className={cn(\"form__input\", {\"form__input--err\": emailErr})}/>\r\n              </div>\r\n\r\n              <div className=\"form__group--half\">\r\n                <div className=\"form__group\">\r\n                  <label for=\"phone\">Phone </label>\r\n                  <input type=\"email\" id=\"email\" value={phone} onChange={e => setPhone(e.target.value)} className={cn(\"form__input\")}/>\r\n                </div>\r\n\r\n                <div className=\"form__group\">\r\n                  <label for=\"gender\">Gender</label>\r\n                    <select id=\"cars\" className=\"form__input\" onChange={e => setGender(e.target.value)}>\r\n                      <option value=\"\">Select gender</option>\r\n                      <option value=\"male\">Male</option>\r\n                      <option value=\"female\">Female</option>\r\n                      <option value=\"\">I'm not sure</option>\r\n                    </select>\r\n                </div>\r\n              </div>\r\n\r\n              <div className=\"form__group\">\r\n                <label for=\"pass\">Password</label>\r\n                <input type=\"password\" id=\"pass\" value={password} onChange={handlePasswordChange} className=\"form__input\"/>\r\n              </div>\r\n\r\n              <Link className=\"form__link\">Forgot password?</Link>\r\n\r\n              <button type=\"submit\" className=\"form__btn\">\r\n                <PrimaryBtn>Create Account</PrimaryBtn>\r\n              </button>\r\n            </form>\r\n\r\n            <div className=\"auth__line\">\r\n              <div>&nbsp;</div>\r\n              <span>or</span>\r\n              <div>&nbsp;</div>\r\n            </div>\r\n          </div>\r\n\r\n          <div className=\"auth__btns\">\r\n            <Link className=\"auth__btn\">\r\n              <svg width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\r\n                <path d=\"M4.43236 12.0862L3.7362 14.6851L1.19174 14.7389C0.431322 13.3285 0 11.7148 0 9.99997C0 8.34175 0.403276 6.77802 1.11811 5.40112H1.11866L3.38394 5.81643L4.37627 8.06812C4