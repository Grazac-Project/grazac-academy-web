ount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"78","usedDeprecatedRules":"62"},{"filePath":"79","messages":"80","errorCount":0,"warningCount":13,"fixableErrorCount":0,"fixableWarningCount":0,"source":"81","usedDeprecatedRules":"62"},{"filePath":"82","messages":"83","errorCount":0,"warningCount":4,"fixableErrorCount":0,"fixableWarningCount":0,"source":"84","usedDeprecatedRules":"62"},{"filePath":"85","messages":"86","errorCount":0,"warningCount":12,"fixableErrorCount":0,"fixableWarningCount":0,"source":"87","usedDeprecatedRules":"62"},{"filePath":"88","messages":"89","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"90"},{"filePath":"91","messages":"92","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"62"},{"filePath":"93","messages":"94","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"95","messages":"96","errorCount":0,"warningCount":7,"fixableErrorCount":0,"fixableWarningCount":0,"source":"97","usedDeprecatedRules":"90"},{"filePath":"98","messages":"99","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"62"},{"filePath":"100","messages":"101","errorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"102","usedDeprecatedRules":"62"},{"filePath":"103","messages":"104","errorCount":0,"warningCount":4,"fixableErrorCount":0,"fixableWarningCount":0,"source":"105","usedDeprecatedRules":"62"},{"filePath":"106","messages":"107","errorCount":0,"warningCount":5,"fixableErrorCount":0,"fixableWarningCount":0,"source":"108","usedDeprecatedRules":"62"},{"filePath":"109","messages":"110","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"62"},{"filePath":"111","messages":"112","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"62"},{"filePath":"113","messages":"114","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"115","usedDeprecatedRules":"62"},{"filePath":"116","messages":"117","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"62"},{"filePath":"118","messages":"119","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"120","usedDeprecatedRules":"62"},{"filePath":"121","messages":"122","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"123","usedDeprecatedRules":"62"},{"filePath":"124","messages":"125","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"62"},{"filePath":"126","messages":"127","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"128","messages":"129","errorCount":0,"warningCount":4,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"130","messages":"131","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"62"},{"filePath":"132","messages":"133","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"62"},"C:\\Users\\USER\\Desktop\\Web Development\\Bitbucket\\grazac-academy\\src\\index.js",[],["134","135"],"C:\\Users\\USER\\Desktop\\Web Development\\Bitbucket\\grazac-academy\\src\\reportWebVitals.js",[],"C:\\Users\\USER\\Desktop\\Web Development\\Bitbucket\\grazac-academy\\src\\App.js",[],"C:\\Users\\USER\\Desktop\\Web Development\\Bitbucket\\grazac-academy\\src\\pages\\UndergraduateAccelerator.js",["136","137","138"],"import React, {useState} from \"react\";\r\nimport {Link} from \"react-router-dom\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport NeedAdvice from \"../components/NeedAdvice\";\r\nimport Qualities from \"../components/Qualities\";\r\n\r\nimport undergraduate from \"../images/undergraduate.png\";\r\nimport loader from \"../images/loader.gif\";\r\nimport SchoolList from \"../components/SchoolList\";\r\n\r\nconst UndergraduateAccelerator = () => {\r\n    const [courses, setCourses] = useState([]);\r\n    const [openListModal, setOpenListModal] = useState(false);\r\n\r\n    React.useEffect(() => {\r\n        document.title = 'Undergraduate Accelerator Track - Grazac Academy';\r\n        window.scrollTo(0,0);\r\n        fetch('https://grazacacademy.com/courses/undergraduate',)\r\n            .then(resp => resp.json())\r\n            .then(resp => {\r\n                setCourses(resp.data);\r\n            })\r\n            .catch(error => {\r\n                alert('An error occured')\r\n            })\r\n    }, []);\r\n\r\n    return(\r\n        <div>\r\n            <div className=\"gua\">\r\n                <div className=\"gua_hero\">\r\n                        <Navbar/>\r\n                    <div className=\"container\">\r\n                        <div className=\"row\">\r\n                            <div className=\"col-sm-6\">\r\n                                <div className=\"gua_hero-text\">\r\n                                    <div className=\"gua_hero-text-b\">\r\n                                        <h1>\r\n                                            Undergraduate Accelerator Plan\r\n                                        </h1>\r\n                                        <p>We equip you to be an asset in the digital age before leaving the four walls of school and we believe the future of work will be strictly skill-based. Join thousands of young undergraduates to build a career in technology and be mentored by industry experts.\r\n                                        </p>\r\n                                        <div className=\"contact_hero-privacy\" >\r\n                                            <a href=\"#courses\"  className=\"download-brochure\">Join Us Today!</a>\r\n                                            <Link to=\"/lead\"><button>Apply as Lead</button></Link>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div>\r\n                                <img src={undergraduate} alt=\"undergraduate\"  className=\"gua_hero-image\" />\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"container\">\r\n                    <div className=\"gga\">\r\n                        <div className=\"course_mode-intro course_mode-intro\">\r\n                            <h4 style={{marginTop:'100px'}}>We are preparing you for the future of work</h4>\r\n                            <h2>Join our community</h2>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"gua_highlight\">\r\n                        <div className=\"boxes44 gua_highlight-box1\">\r\n                            <div className=\"gua_highlight-box3\">\r\n                                <div className=\"gua_highlight-box4\">\r\n                                    <h3><strong>Student Lead</strong></h3>\r\n                                    <p>Become our ambassador in your institution. </p>\r\n                                    <p>Lead other students who are ready to prepare themselves for the future of work.</p>\r\n                                    <Link to=\"/lead\"><a className=\"white-link\">Apply as Student Lead</a></Link>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                        <div className=\"boxes44 gua_highlight-box2\">\r\n                            <div  className=\"gua_highlight-box3\">\r\n                                <div className=\"gua_highlight-box4\">\r\n                                    <h3><strong>Affiliated Campuses</strong></h3>\r\n                                    <p>We are well represented in various institutions of learning across Nigeria.</p>\r\n                                    <p>We want to prepare you for the future of work before you leave the four walls of learning.</p>\r\n                                    <a className=\"white-link\" onClick={() => setOpenListModal(true)}>Learn More</a>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"background1\" id=\"courses\">\r\n                    <div className=\"container\">\r\n                        <div className=\"gga\">\r\n                            <div className=\"course_mode-intro course_mode-intro\">\r\n                                <h2>Available Courses</h2>\r\n                            </div>\r\n                            <div className=\"gga_container\">\r\n                                {courses.length ? \r\n                                    courses.map((item,index) => (\r\n                                    <div className=\"boxes33\" key={index}>\r\n                                        <div className=\"gua_cardview\">\r\n                                            <div className=\"gua_cardview-box\">\r\n                                                <img src={item.thumb} alt=\"course-desc\" />\r\n                                            </div>\r\n                                            <div className=\"gua_cardview-text\">\r\n                                                <h4>{item.name}</h4>\r\n                                                <p>{item.description}</p>\r\n                                                <Link to={\"/course-detail-undergraduate?course=\"+item.slug}><a>Learn More</a></Link>\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>)) :\r\n                                    <div>\r\n                                        <img src={loader} alt=\"loader\" className=\"loader\" />\r\n                                    </div>\r\n                                }\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <Qualities />\r\n                <NeedAdvice />\r\n            </div>\r\n            <Footer/>\r\n\r\n           { openListModal && <SchoolList onOpen={e => setOpenListModal(e)}/> }\r\n        </div>\r\n    );\r\n}\r\n\r\nexport default UndergraduateAccelerator;","C:\\Users\\USER\\Desktop\\Web Development\\Bitbucket\\grazac-academy\\src\\pages\\Contact.js",["139"],"import React, { useState, useEffect } from \"react\";\r\nimport axios from 'axios';\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport PrimaryBtn from \"../components/PrimaryBtn\";\r\n\r\nimport Facebook from \"../images/svg/facebook.svg\";\r\nimport Instagram from \"../images/svg/instagram.svg\";\r\nimport Twitter from \"../images/svg/twitter.svg\";\r\nimport Youtube from \"../images/svg/youtube.svg\";\r\nimport kamala from \"../images/kamala.jpg\";\r\n\r\nconst Contact = () => {\r\n\r\n    const [ name, setName ] = useState('');\r\n    const [ email, setEmail ] = useState('');\r\n    const [ subject, setSubject ] = useState('');\r\n    const [ message, setMessage ] = useState('');\r\n\r\n    useEffect(() => {\r\n        document.title = 'Contact - Grazac Academy';\r\n        window.scrollTo(0,0);\r\n    }, []);\r\n\r\n    const handleSubmit = () => {\r\n        if(name.length && email.length && subject.length && message.length) {\r\n            const btn = document.querySelector('#submit');\r\n            btn.setAttribute('disabled', '');\r\n            btn.textContent = 'Submitting...';\r\n            console.log('Submitted')\r\n            axios.post('http://grazacacademy.com/contact/create', {\r\n                name: name,\r\n                email: email,\r\n                subject: subject,\r\n                message: message\r\n            })\r\n            .then(resp => resp.data)\r\n            .then(response => {\r\n                if(response.success === true) {\r\n                    btn.removeAttribute('disabled');\r\n                    btn.textContent = 'Submit';\r\n                    alert(response.msg);\r\n                    setName(''); setEmail(''); setSubject(''); setMessage('');\r\n                } else {\r\n\r\n                }\r\n            })\r\n            .catch((err) => {\r\n                \r\n            });\r\n        } else {\r\n            alert('Invalid input');\r\n        }\r\n    }\r\n\r\n    return(\r\n        <div>\r\n            <Navbar/>\r\n            <div className=\"contact\">\r\n                <div className=\"contact_layer\">\r\n                    <div className=\"container\">\r\n                        <div className=\"contact_layer-text\">\r\n                            <h1>Get In Touch</h1>\r\n                            <p>We want to hear from you. Let us know how we can help</p>\r\n                        </div>\r\n                        <div classname=\"contact_layer-circles\">\r\n                            <img src={kamala} alt=\"kamala\"  classname=\"contact_layer-circles-1\" />\r\n                            <img src={kamala} alt=\"kamala\"  classname=\"contact_layer-circles-2\" />\r\n                            <img src={kamala} alt=\"kamala\"  classname=\"contact_layer-circles-3\" />\r\n                            <img src={kamala} alt=\"kamala\"  classname=\"contact_layer-circles-4\" />\r\n                        </div>\r\n                        <div className=\"contact_hero\">\r\n                            <div className=\"contact_hero-flexdiv\">\r\n                                <div className=\"contact_hero-flexdiv-1\" >\r\n                                    <label>Full Name  <span>*</span></label>\r\n                                    <input type=\"text\" placeholder=\"ex. John Doe\" value={name} onChange={e => setName(e.target.value)} />\r\n                                </div>\r\n                                <div className=\"contact_hero-flexdiv-2\">\r\n                                    <label>Email  <span>*</span></label>\r\n                                    <input type=\"text\" placeholder=\"ex. john@gmail.com\" value={email} onChange={e => setEmail(e.target.value)}  />\r\n                                </div>\r\n                            </div>\r\n                            <div>\r\n                                <label>Subject  <span>*</span></label>\r\n                                <input  type=\"text\" placeholder=\"ex. John Doe\" value={subject} onChange={e => setSubject(e.target.value)}  />\r\n                            </div>\r\n                            <div>\r\n                                <label>Message  <span>*</span></label>\r\n                                <textarea  type=\"text\" placeholder=\"Describe your task for us\" value={message} onChange={e => setMessage(e.target.value)}  />\r\n                            </div>\r\n                            <div className=\"contact_hero-privacy\" >\r\n                                <p>By submitting this form your consent to us emailing you occasionally about our products and services. You can unsubscribe from emails at any time, and we will never pass your email onto third parties. <span>Privacy Policy</span></p>\r\n                                <button id=\"submit\" onClick={handleSubmit}>Submit</button>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"container\">\r\n                    <div className=\"contact_campus\">\r\n                        <div className=\"contact_campus-intro\">\r\n                            <h2>Campus Inquiries</h2>\r\n                            <p>Connect with Us</p>\r\n                        </div>\r\n                        <div className=\"contact_campus-main\">\r\n                            <div className=\"contact_campus-main-div boxes33\">\r\n                                <h3>Office</h3>\r\n                                <p>PROHUB, Salawu Olabode Avenue, Ewang Road, </p>\r\n                                <p>Idi-aba, 110124, Abeokuta</p>\r\n                                <p>0906 133 3395</p>\r\n                            </div>\r\n                            <div className=\"contact_campus-main-div boxes33\">\r\n                                <h3>Book A Call</h3>\r\n                                <p>We are here to help with any questions. </p>\r\n                                <p>Talk to our programme leads.</p>\r\n                                <div style={{display:'flex'}}>\r\n                                    <PrimaryBtn>Book A Call</PrimaryBtn>\r\n                                </div>\r\n                            </div>\r\n                            <div className=\"contact_campus-main-div boxes33\">\r\n                                <h3>Social Media</h3>\r\n                                <div className=\"social\">\r\n                                    <img src={Facebook} alt=\"social\"/>\r\n                                </div>\r\n                                <div className=\"social\">\r\n                                    <img src={Twitter} alt=\"social\"/>\r\n                                </div>\r\n                                <div className=\"social\">\r\n                                    <img src={Youtube} alt=\"social\"/>\r\n                                </div>\r\n                                <div className=\"social\">\r\n                                    <img src={Instagram} alt=\"social\"/>\r\n                                </div>\r\n                            </div>\r\n\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div>\r\n                    <iframe src=\"https://www.google.com/maps/d/embed?mid=16NZ9a9VhKkk2-5nnYEdL93mxq7kjDZLT\" width=\"100%\" height=\"600\"></iframe>\r\n                </div>\r\n                {/*<extracomponent/> a component used in the landing page comes here*/}\r\n            </div>\r\n            <Footer/>\r\n        </div>\r\n    );\r\n}\r\n\r\nexport default Contact;","C:\\Users\\USER\\Desktop\\Web Development\\Bitbucket\\grazac-academy\\src\\pages\\Landing.js",["140"],"import { useState, useEffect } from \"react\";\r\nimport { cn } from \"../utils\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport Mode from \"../components/Mode\";\r\nimport PrimaryBtn from \"../components/PrimaryBtn\";\r\n\r\nimport Abdullahi from \"../images/testimonial/abdullahi.jpeg\";\r\nimport Adedamola from \"../images/testimonial/adedamola.jpeg\";\r\nimport Bosun from \"../images/testimonial/bosun.jpg\";\r\nimport Grazac from \"../images/svg/logo-round.svg\";\r\nimport Video from \"../images/landing-video2.mp4\";\r\nimport Object from \"../images/svg/objects.svg\";\r\nimport poster from \"../images/Grazac-website/IMG_8403.JPG\";\r\n\r\nimport Sponsor1 from \"../images/svg/Apple.svg\";\r\nimport Sponsor2 from \"../images/svg/AWS.svg\";\r\nimport Sponsor3 from \"../images/svg/Flutterwave.svg\";\r\nimport Sponsor5 from \"../images/svg/Microsoft.svg\";\r\nimport Sponsor6 from \"../images/svg/Google.svg\";\r\n\r\nimport Card1 from \"../images/svg/card1.svg\";\r\nimport Card2 from \"../images/svg/card2.svg\"\r\n\r\nconst Landing = () => {\r\n  // const [email, setEmail] = useState(\"\");\r\n  const [step, setStep] = useState(0);\r\n\r\n  useEffect(() => {\r\n    document.title = 'Welcome to Grazac Academy';\r\n    let mediaPlayer = document.querySelector('#video');\r\n    mediaPlayer.controls = false;\r\n    mediaPlayer.play();\r\n    changeSlider();\r\n  })\r\n\r\n  const changeSlider = () => {\r\n    setTimeout(() => {\r\n      if (step < 3)\r\n        setStep(step + 1);\r\n      else \r\n        setStep(0);\r\n    }, 5000);\r\n  }\r\n\r\n  const dots = [false, false, false];\r\n  const content = [\r\n    {\r\n      id: 0,\r\n      img: Bosun,\r\n      content: \"The future of work will be filled with so many opportunities we need to prepare for, I’ve known Grazac for a while and seen them in the business of helping people lay hold of these opportunities. Grazac Academy is an excellent starting point for anyone looking into building a career in technology.\",\r\n      name: \"Bosun Egberinde - Creator of PHPSandbox.io\"\r\n    },\r\n    {\r\n      id: 1,\r\n      img: Adedamola,\r\n      content: \"I've known Grazac for over a year now and having worked with some of their successful students, I can boldly say the competency and problem solving skills of their students is top-notch and their academy is one of the best academy promoting technology skills acquisition here in Nigeria\",\r\n      name: \"Samson Adedamola - Consultant at Kudi\",\r\n    },\r\n    {\r\n      id: 2,\r\n      img: Abdullahi,\r\n      content: \"I passed through Grazac Academy while I was in school and that's one of the best thing that happened to me as an undergraduate. I love how the facilitators mentored everyone of us up and I must say that, we got more value than we paid for.\",\r\n      name: \"Abdullahi Olaniyan - Software Developer at Global Accelerex\"\r\n    }\r\n  ]\r\n\r\n  return(\r\n    <div className=\"landing\">\r\n      <div className=\"landing__header\">\r\n        <Navbar />\r\n        <img src={Object} className=\"bg-img\"/>\r\n        <div style={{height: 10}}></div>\r\n\r\n        <div className=\"landing__text\">\r\n          <h1>Upskilling You For The <span>Future</span> Of Work</h1>\r\n          <p>Learn valuable technology skills with us, we strongly believe the future of work will be skill based. Join us to build a career in tech and get tutored by industry leaders who will walk you through the path of becoming highly valuable and employable </p>\r\n        </div>\r\n        <a href=\"/#tracks\">\r\n          <div className=\"nav__btn\" style={{width:'130px', margin:'auto',textAlign:'center'}}>\r\n            <div className=\"nav__btn--text\">Get Started</div>\r\n          </div>\r\n        </a>\r\n      </div>\r\n\r\n      <div className=\"landing__video\">\r\n        <video id=\"video\" width=\"320\" height=\"240\" autoPlay loop controls poster={poster}>\r\n          <source src={Video} type=\"video/mp4\" />\r\n        </video>\r\n      </div>\r\n\r\n      <div className=\"landing__sponsors\">\r\n        <div className=\"landing__sponsors--container\">\r\n          <img src={Sponsor1} alt=\"sponsor\" />\r\n          <img src={Sponsor2} alt=\"sponsor\" />\r\n          <img src={Sponsor3} alt=\"sponsor\" />\r\n          <img src={Sponsor5} alt=\"sponsor\" />\r\n          <img src={Sponsor6} alt=\"sponsor\" />\r\n        </div>\r\n      </div>\r\n\r\n      <div className=\"landing__cards\" id=\"tracks\">\r\n        <div className=\"landing__cards--container\">\r\n          <div className=\"landing__bottom--text\">\r\n            <div className=\"landing__bottom--text--right\">\r\n              <h1>Get Ready To Grow With us </h1>\r\n            </div>\r\n          </div>\r\n\r\n          <div className=\"landing__card--box\">\r\n            <div className=\"landing__card landing__card--1\">\r\n            <img src={Card1} alt=\"illustration\" />\r\n              <h3><span>Graduate </span><br />Accelerator Plan</h3>\r\n              <p>An immersive program that gives you the opportunity to build a career and get a job in the tech industry.</p>\r\n             \r\n              <div className=\"landing__btn\">\r\n                <PrimaryBtn yellow link=\"/graduate-accelerator-plan\">Learn More</PrimaryBtn>\r\n              </div>\r\n            </div>\r\n\r\n            <div className=\"landing__card landing__card--2\">\r\n              <img src={Card2} alt=\"illustration\" />\r\n              <h3><span>Undergraduate </span><br />Accelerator Plan</h3>\r\n              <p>Set the pace for a bright future as an undergraduate by acquiring technology skills now.</p>\r\n              <div className=\"landing__btn\">\r\n                <PrimaryBtn link=\"/undergraduate-accelerator-plan\">Learn More</PrimaryBtn>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <div className=\"landing__discover\">\r\n        <div className=\"landing__bottom--text landing__bottom--text-2\">\r\n          <div className=\"landing__bottom--text--right\">\r\n            <h1>We are trusted by entrepreneurs and hiring managers globally.</h1>\r\n            <p>We guarantee you impact driven candidates who will impact your bottom lines positively.</p>\r\n          </div>\r\n        </div>\r\n\r\n        <div className=\"landing__discover--container\">\r\n          <div className=\"landing__discover--images\">\r\n            <div className=\"landing__discover--images-left\">\r\n              <div></div>\r\n              <div></div>\r\n            </div>\r\n            <div className=\"landing__discover--images-right\">\r\n              <div></div>\r\n            </div>\r\n          </div>\r\n\r\n          <div className=\"landing__discover--list\">\r\n            <div className=\"landing__discover--list-item\">\r\n              <h2>01</h2>\r\n              <div>\r\n                <h3>Enroll</h3>\r\n                <p>Set yourself up for success by registering for any of our courses that fits your passion and career.</p>\r\n              </div>\r\n            </div>\r\n\r\n            <div className=\"landing__discover--list-item\">\r\n              <h2>02</h2>\r\n              <div>\r\n                <h3>Learn</h3>\r\n                <p>Get trained by world class facilitators. We will provide you with the right mentorship, tools and content you need to be the best in your choosing career.</p>\r\n              </div>\r\n            </div>\r\n\r\n            <div className=\"landing__discover--list-item\">\r\n              <h2>03</h2>\r\n              <div>\r\n                <h3>Get Hired</h3>\r\n                <p>Join the workforce of the future as you get connected with career coaches and potential employers.</p>\r\n              </div>\r\n            </div>\r\n            <div className=\"landing__discover--list-item\"></div>\r\n            <div className=\"landing__discover--list-item\"></div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <div className=\"landing__slider\">\r\n        {content.filter(key => key.id === step ).map(item => (\r\n          <div className=\"landing__slider--container\" key={item.id}>\r\n            <div className=\"landing__slider--img\">\r\n              <img  src={item.img} alt=\"img\"/>\r\n            </div>\r\n\r\n            <div className=\"landing__slider--text\">\r\n              <svg width=\"30\" height=\"28\" viewBox=\"0 0 30 28\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\r\n                <path d=\"M12.3993 5.56001C13.1711 5.22699 13.4948 4.27918 13.1462 3.51069L11.9262 0.872185C11.5777 0.129562 10.7311 -0.203709 9.98417 0.129562C7.86782 1.05176 6.05026 2.25573 4.60616 3.71587C2.83839 5.43192 1.64328 7.4044 0.995927 9.5818C0.348574 11.7851 0 14.782 0 18.5988V26.4631C0 27.3084 0.672251 28.0001 1.49389 28.0001H11.2789C12.1005 28.0001 12.7728 27.3084 12.7728 26.4631V16.3958C12.7728 15.5502 12.1005 14.8588 11.2789 14.8588H6.59802C6.64781 12.2713 7.24537 10.1966 8.34089 8.63373C9.23722 7.37904 10.5817 6.35438 12.3993 5.56001Z\" fill=\"#4B004B\"/>\r\n                <path d=\"M29.1127 5.53403C29.8845 5.20102 30.2079 4.25321 29.8596 3.48471L28.6396 0.872082C28.291 0.129203 27.4445 -0.203812 26.6976 0.129203C24.6061 1.0514 22.8132 2.25537 21.3444 3.6899C19.5764 5.43182 18.3567 7.40429 17.7091 9.5817C17.0617 11.7332 16.7383 14.7306 16.7383 18.5731V26.4374C16.7383 27.2827 17.4105 27.9744 18.2322 27.9744H28.0172C28.8388 27.9744 29.511 27.2827 29.511 26.4374V16.3701C29.511 15.5245 28.8388 14.8331 28.0172 14.8331H23.3114C23.3612 12.2456 23.959 10.1709 25.0543 8.60801C25.9506 7.35306 27.2951 6.3284 29.1127 5.53403Z\" fill=\"#4B004B\"/>\r\n              </svg>\r\n\r\n              <p>{item.content}</p>\r\n\r\n              <small>{item.name}</small>\r\n\r\n              <div className={cn(\"landing__dots\", `landing__dots--${item.id}`)}>\r\n              {\r\n                dots.map((_, index) => (\r\n                  <div onClick={() => setStep(index)}>&nbsp;</div>\r\n                ))\r\n              }\r\n            </div>\r\n            </div>\r\n          </div>\r\n        ))}\r\n      </div>\r\n\r\n      <div className=\"landing__bottom\" style={{paddingBottom: 0}}>\r\n        <div className=\"landing__bottom--text\">\r\n          <div className=\"landing__bottom--text--right\">\r\n            <h1>Get Upskilled For The Future Of Work</h1>\r\n            <p>We will provide you with the tools, resources, facilities, content and mentorship needed for your relevance in the future of work.</p>\r\n\r\n            <div className=\"landing__btn--2\">\r\n              <PrimaryBtn link=\"/get-started\">Learn More</PrimaryBtn>\r\n            </div>\r\n          </div>\r\n\r\n          <div className=\"landing__bottom--text--left\">\r\n            <img src={Grazac} alt=\"img\" />\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <Mode />\r\n      <Footer />\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default Landing;","C:\\Users\\USER\\Desktop\\Web Development\\Bitbucket\\grazac-academy\\src\\pages\\GraduateAccelerator.js",["141"],"import React, {useState} from \"react\";\r\nimport {Link} from \"react-router-dom\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport NeedAdvice from \"../components/NeedAdvice\";\r\nimport Qualities from \"../components/Qualities\";\r\nimport Graduates from \"../images/graduate.jpeg\";\r\nimport loader from \"../images/loader.gif\";\r\n\r\nconst GraduateAccelerator = () => {\r\n    const [courses, setCourses] = useState([]);\r\n\r\n    React.useEffect(() => {\r\n        document.title = 'Graduate Accelerator Track - Grazac Academy';\r\n        window.scrollTo(0,0);\r\n        fetch('https://grazacacademy.com/courses/graduate',)\r\n            .then(resp => resp.json())\r\n            .then(resp => {\r\n                setCourses(resp.data);\r\n            })\r\n            .catch(error => {\r\n                alert('An error occured')\r\n            })\r\n    }, []);\r\n\r\n    return(\r\n        <div>\r\n            <div className=\"gga\">\r\n                <div className=\"gga_hero\">\r\n                    <Navbar/>\r\n                    <div className=\"container\">\r\n                        <div className=\"row\">\r\n                            <div className=\"col-sm-6\">\r\n                                <div className=\"gga_hero-text\">\r\n                                    <div className=\"gga_hero-text-b\">\r\n                                        <h1>\r\n                                            Graduate Accelerator Plan\r\n                                        </h1>\r\n                                        <p>\r\n                                        We are bridging the gap between unemployment and entry-level jobs in the technology industry. Become employable in just 4 months by joining us today, we provide you with the right mentorship, tools and contents to upskill yourself.\r\n                                        </p>\r\n                                        <div className=\"contact_hero-privacy\" >\r\n                                            <a href=\"#courses\" className=\"download-brochure\">Join Us Today!</a>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div>\r\n                                <img src={Graduates} alt=\"Graduates\"  className=\"gga_hero-image\" />\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"container\">\r\n                    <div className=\"course_mode-container\">\r\n                        <div className=\"boxes22\">\r\n                            <div className=\"\">\r\n                                <div className=\"boxes\">\r\n                                    <div className=\"svg-box2\">\r\n                                    <svg width=\"30\" height=\"30\" viewBox=\"0 0 30 30\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\r\n                                        <path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M22.4999 12.5001C22.4999 11.8113 21.9399 11.2501 21.2499 11.2501C20.5599 11.2501 20 11.8113 20 12.5001C20 13.1888 20.5599 13.7501 21.2499 13.7501C21.9399 13.7501 22.4999 13.1888 22.4999 12.5001ZM25.0001 12.5002C25.0001 14.5677 23.3176 16.2502 21.2501 16.2502C19.1826 16.2502 17.5001 14.5677 17.5001 12.5002C17.5001 10.4327 19.1826 8.75022 21.2501 8.75022C23.3176 8.75022 25.0001 10.4327 25.0001 12.5002ZM13.7499 8.74985C13.7499 7.3711 12.6286 6.24985 11.2499 6.24985C9.87111 6.24985 8.74986 7.3711 8.74986 8.74985C8.74986 10.1286 9.87111 11.2498 11.2499 11.2498C12.6286 11.2498 13.7499 10.1286 13.7499 8.74985ZM16.25 8.75C16.25 11.5075 14.0075 13.75 11.25 13.75C8.49253 13.75 6.25003 11.5075 6.25003 8.75C6.25003 5.9925 8.49253 3.75 11.25 3.75C14.0075 3.75 16.25 5.9925 16.25 8.75ZM17.425 18.8078C18.5112 17.9678 19.8487 17.5003 21.25 17.5003C24.6962 17.5003 27.5 20.304 27.5 23.7503C27.5 24.4403 26.9412 25.0003 26.25 25.0003C25.5587 25.0003 25 24.4403 25 23.7503C25 21.6828 23.3175 20.0003 21.25 20.0003C20.3962 20.0003 19.585 20.2928 18.93 20.8115C19.61 22.0565 20 23.484 20 25.0003C20 25.6903 19.4412 26.2503 18.75 26.2503C18.0587 26.2503 17.5 25.6903 17.5 25.0003C17.5 21.554 14.6962 18.7503 11.25 18.7503C7.80375 18.7503 5 21.554 5 25.0003C5 25.6903 4.44125 26.2503 3.75 26.2503C3.05875 26.2503 2.5 25.6903 2.5 25.0003C2.5 20.1753 6.42625 16.2503 11.25 16.2503C13.6587 16.2503 15.8412 17.229 17.425 18.8078Z\" fill=\"#773DD3\"/>\r\n                                        <mask id=\"mask0\" mask-type=\"alpha\" maskUnits=\"userSpaceOnUse\" x=\"2\" y=\"3\" width=\"26\" height=\"24\">\r\n                                        <path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M22.4999 12.5001C22.4999 11.8113 21.9399 11.2501 21.2499 11.2501C20.5599 11.2501 20 11.8113 20 12.5001C20 13.1888 20.5599 13.7501 21.2499 13.7501C21.9399 13.7501 22.4999 13.1888 22.4999 12.5001ZM25.0001 12.5002C25.0001 14.5677 23.3176 16.2502 21.2501 16.2502C19.1826 16.2502 17.5001 14.5677 17.5001 12.5002C17.5001 10.4327 19.1826 8.75022 21.2501 8.75022C23.3176 8.75022 25.0001 10.4327 25.0001 12.5002ZM13.7499 8.74985C13.7499 7.3711 12.6286 6.24985 11.2499 6.24985C9.87111 6.24985 8.74986 7.3711 8.74986 8.74985C8.74986 10.1286 9.87111 11.2498 11.2499 11.2498C12.6286 11.2498 13.7499 10.1286 13.7499 8.74985ZM16.25 8.75C16.25 11.5075 14.0075 13.75 11.25 13.75C8.49253 13.75 6.25003 11.5075 6.25003 8.75C6.25003 5.9925 8.49253 3.75 11.25 3.75C14.0075 3.75 16.25 5.9925 16.25 8.75ZM17.425 18.8078C18.5112 17.9678 19.8487 17.5003 21.25 17.5003C24.6962 17.5003 27.5 20.304 27.5 23.7503C27.5 24.4403 26.9412 25.0003 26.25 25.0003C25.5587 25.0003 25 24.4403 25 23.7503C25 21.6828 23.3175 20.0003 21.25 20.0003C20.3962 20.0003 19.585 20.2928 18.93 20.8115C19.61 22.0565 20 23.484 20 25.0003C20 25.6903 19.4412 26.2503 18.75 26.2503C18.0587 26.2503 17.5 25.6903 17.5 25.0003C17.5 21.554 14.6962 18.7503 11.25 18.7503C7.80375 18.7503 5 21.554 5 25.0003C5 25.6903 4.4412