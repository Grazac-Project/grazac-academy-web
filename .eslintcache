\n                name=\"phone_number_of_employer\"\r\n                value={guarantorDetails_2[0]?.phone_number_of_employer}\r\n                onChange={(e) => handleChange_2(e)}\r\n              />\r\n            </div>\r\n            <hr />\r\n            <div className=\"dashboard-content-form-container\">\r\n              <h5>Relationship with guarantor</h5>\r\n              {/* <p>{guarantorDetails_2?.relationship_with_the_guarantor}</p> */}\r\n              <input\r\n                type=\"text\"\r\n                name=\"relationship_with_the_guarantor\"\r\n                value={guarantorDetails_2[0]?.relationship_with_the_guarantor}\r\n                onChange={(e) => handleChange_2(e)}\r\n              />\r\n            </div>\r\n\r\n            {/*  */}\r\n            {/*  */}\r\n            <button type=\"submit\">Save</button>\r\n          </form>\r\n        </div>\r\n      )}\r\n</div>\r\n\r\n}\r\n\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default Details;\r\n","C:\\Users\\mitchel\\Documents\\grazac\\code\\grazac-academy-web\\src\\api\\dashboard\\hire.js",["283"],"import {forHire, forHireContact} from './apikit';\r\n\r\n\r\nexport const getAllTalents = (page) => {\r\n    return forHire.get(`/hire/fetch?page=${page}`)\r\n}\r\n\r\nexport const getOneTalent = (talentId) => {\r\n    return forHire.get(`/hire/details/${talentId}`)\r\n}\r\n\r\nexport const submitContact = (payload) => {\r\n    return forHire.post(`/hire/contact`, payload)\r\n} ","C:\\Users\\mitchel\\Documents\\grazac\\code\\grazac-academy-web\\src\\components\\dashboard\\Sidebar.js",["284"],"import { useState } from \"react\";\r\nimport { ToastContainer, toast } from \"react-toastify\";\r\nimport { Link } from \"react-router-dom\";\r\nimport Logo from \"../../images/svg/grazac-logo.svg\";\r\n\r\n\r\nfunction Sidebar({ clicked, clickedDashboard, clickedDetails, showDetails }) {\r\n  // console.log(clickedDashboard)\r\n\r\n  const [clickLink, setClickLink] = useState(false);\r\n  // console.log(clickLink);\r\n\r\n  const signOut = () => {\r\n    sessionStorage.clear();\r\n    toast.info(\"Signing out ...\");\r\n    setTimeout(function () {\r\n      window.location = \"/dashboard\";\r\n    }, 2500);\r\n  };\r\n  \r\n\r\n  return (\r\n    <div className=\"sidebar\">\r\n      <ToastContainer closeButton={false} />\r\n      <Link to=\"/\">\r\n        <img src={Logo} alt=\"logo\" className=\"logo\" />\r\n      </Link>\r\n      <div className=\"sidebar-portal\">\r\n        <p className=\"sidebar-portal-heading\">PORTAL</p>\r\n        <div\r\n          className={\r\n            clicked === \"dashboard\" ? \"active\" : \"sidebar-portal-links\"\r\n          }\r\n          onClick={() => clickedDashboard(\"dashboard\")}\r\n        >\r\n          <svg\r\n            width=\"19\"\r\n            height=\"19\"\r\n            viewBox=\"0 0 19 19\"\r\n            fill=\"none\"\r\n            xmlns=\"http://www.w3.org/2000/svg\"\r\n          >\r\n            <path\r\n              d=\"M18.5 18.0003C18.5 18.2655 18.3946 18.5198 18.2071 18.7074C18.0196 18.8949 17.7652 19.0003 17.5 19.0003H1.5C1.23478 19.0003 0.98043 18.8949 0.792893 18.7074C0.605357 18.5198 0.5 18.2655 0.5 18.0003V7.49027C0.499895 7.33788 0.534617 7.18749 0.601516 7.05057C0.668415 6.91365 0.76572 6.79384 0.886 6.70027L8.886 0.478272C9.06154 0.341717 9.2776 0.267578 9.5 0.267578C9.7224 0.267578 9.93846 0.341717 10.114 0.478272L18.114 6.70027C18.2343 6.79384 18.3316 6.91365 18.3985 7.05057C18.4654 7.18749 18.5001 7.33788 18.5 7.49027V18.0003ZM4.5 13.0003V15.0003H14.5V13.0003H4.5Z\"\r\n              fill=\"#787676\"\r\n            />\r\n          </svg>\r\n          <p onClick={() => setClickLink(!clickLink)}>Dashboard</p>\r\n\r\n       \r\n\r\n        </div>\r\n        {showDetails != \"Not Submitted\" && (\r\n          <div\r\n            className={\r\n              clicked === \"details\" ? \"active\" : \"sidebar-portal-links\"\r\n            }\r\n            onClick={() => clickedDetails(\"details\")}\r\n          >\r\n            <svg\r\n              width=\"21\"\r\n              height=\"20\"\r\n              viewBox=\"0 0 21 20\"\r\n              fill=\"none\"\r\n              xmlns=\"http://www.w3.org/2000/svg\"\r\n            >\r\n              <path\r\n                d=\"M10.5 20C4.977 20 0.5 15.523 0.5 10C0.5 4.477 4.977 0 10.5 0C16.023 0 20.5 4.477 20.5 10C20.5 15.523 16.023 20 10.5 20ZM9.5 9V15H11.5V9H9.5ZM9.5 5V7H11.5V5H9.5Z\"\r\n                fill=\"#787676\"\r\n              />\r\n            </svg>\r\n            <p>Details</p>\r\n          </div>\r\n        )}\r\n        <div className=\"sidebar-portal-links signout\" onClick={signOut}>\r\n          <svg\r\n            width=\"20\"\r\n            height=\"20\"\r\n            viewBox=\"0 0 20 20\"\r\n            fill=\"none\"\r\n            xmlns=\"http://www.w3.org/2000/svg\"\r\n          >\r\n            <path\r\n              d=\"M10 20C4.477 20 0 15.523 0 10C0 4.477 4.477 0 10 0C15.523 0 20 4.477 20 10C20 15.523 15.523 20 10 20ZM5 9V6L0 10L5 14V11H13V9H5Z\"\r\n              fill=\"#909198\"\r\n            />\r\n          </svg>\r\n          <p>Sign Out</p>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default Sidebar;\r\n","C:\\Users\\mitchel\\Documents\\grazac\\code\\grazac-academy-web\\src\\api\\dashboard\\data.js",[],"C:\\Users\\mitchel\\Documents\\grazac\\code\\grazac-academy-web\\src\\api\\dashboard\\auth.js",[],"C:\\Users\\mitchel\\Documents\\grazac\\code\\grazac-academy-web\\src\\components\\dashboard\\selected\\PaymentReceived.js",[],"C:\\Users\\mitchel\\Documents\\grazac\\code\\grazac-academy-web\\src\\components\\Modal.js",[],"C:\\Users\\mitchel\\Documents\\grazac\\code\\grazac-academy-web\\src\\utils.js",[],"C:\\Users\\mitchel\\Documents\\grazac\\code\\grazac-academy-web\\src\\components\\InfoModal.js",["285"],"import { useState } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport badge from \"../images/svg/badge.svg\";\r\nimport ex from \"../images/svg/x-mark.svg\";\r\n\r\nconst InfoModal = () => {\r\n  const [showModal, setShowModal] = useState(true);\r\n\r\n  return (\r\n    <div>\r\n        <div className=\"infomodal\">\r\n          <div className=\"infomodal_content\">\r\n            <img src={badge} alt=\"\" />\r\n            <p>\r\n              Grazac Graduate Accelerator Program is closed for enrollment., You\r\n              can apply for internship positions\r\n            </p>\r\n            <Link to=\"/internship\">\r\n              <button>Enroll</button>\r\n            </Link>\r\n            <img\r\n              src={ex}\r\n              alt=\"\"\r\n              onClick={() => setShowModal(false)}\r\n              style={{ cursor: \"pointer\" }}\r\n            />\r\n          </div>\r\n        </div>\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default InfoModal;\r\n","C:\\Users\\mitchel\\Documents\\grazac\\code\\grazac-academy-web\\src\\components\\NavItem.js",[],"C:\\Users\\mitchel\\Documents\\grazac\\code\\grazac-academy-web\\src\\components\\dashboard\\not-submitted\\index.js",["286","287"],"import { useEffect, useState } from \"react\";\r\nimport { ToastContainer, toast } from \"react-toastify\";\r\nimport { submitDetails } from \"../../../api/dashboard/data\";\r\nimport axios from \"axios\";\r\n\r\nimport arrow from \"../../../images/svg/dashboard/arrow.svg\";\r\nimport upload from \"../../../images/svg/upload.svg\";\r\nimport loader from \"../../../images/svg/dashboard/loader.gif\";\r\nimport termsandconds from \"../../../content/TermsandCondition.pdf\";\r\n\r\nfunction NotSubmitted({\r\n  fname,\r\n  lname,\r\n  phone,\r\n  email,\r\n  setNewStatus,\r\n  userDetails,\r\n}) {\r\n\r\n  const [active, setActive] = useState(\"welcome\");\r\n  const [formActive, setFormActive] = useState(\"\");\r\n\r\n  // const [isError, setIsError] = useState(\"\");\r\n  // const [formActive, setFormActive] = useState(\"education\");\r\n//   console.log(userDetails);\r\n\r\n  const [userId, setUserId] = useState(0);\r\n  const [checkAct, setCheckAct] = useState(false);\r\n  const [nigerianStates, setNigerianStates] = useState([]);\r\n  const [bioData, setBioData] = useState({\r\n    firstName: `${fname}`,\r\n    lastName: `${lname}`,\r\n    email: `${email}`,\r\n    phone: `${phone}`,\r\n    phone:\"\",\r\n    dob: \"\",\r\n    gender: \"\",\r\n    maritalStatus: \"\",\r\n    haveKids: \"\",\r\n    ageRange: \"\",\r\n    course: \"\",\r\n    state: \"\",\r\n    city: \"\",\r\n    id: null,\r\n  });\r\n\r\n\r\n\r\n  const [education, setEducation] = useState({\r\n    courseOfStudy: \"\",\r\n    grade: \"\",\r\n    qualification: \"\",\r\n    experience: \"\",\r\n    nyscStatus: \"\",\r\n    reason: \"\",\r\n    availability: \"\",\r\n    legalFee: \"\",\r\n  });\r\n//   setBioData(userDetails)\r\n//   console.log(\"i ran ooh \")\r\n\r\nwindow.onload = (event) => {\r\n    // console.log('page is fully loaded');\r\n    // removeQuestions();\r\n    setBioData(userDetails)\r\n  };\r\n\r\n  useEffect(() => {\r\n\r\n    try {\r\n      let details = sessionStorage.getItem(\"user_details\");\r\n      setUserId(JSON.parse(details).id);\r\n    } catch (err) {\r\n      console.log(err);\r\n    }\r\n    // setBioData(userDetails)\r\n    axios\r\n      .get(\"https://nigerian-states-info.herokuapp.com/api/v1/states\")\r\n      .then((response) => {\r\n        setNigerianStates(response.data.data);\r\n      });\r\n  }, []);\r\n\r\n\r\n//   setBioData(userDetails)\r\n//   console.log(bioData)\r\n//   console.log(userDetails)\r\n \r\n//   console.log(bioData.firstName)\r\n\r\n  const handleChange = (e) => {\r\n    \r\n\r\n  setBioData({\r\n    ...bioData,\r\n    [e.target.name]: e.target.value,\r\n  });\r\n  setEducation({\r\n    ...education,\r\n    [e.target.name]: e.target.value,\r\n  });\r\n  };\r\n\r\n  const handleImage = (e) => {\r\n    if (e.target.files[0].size > 2097152) {\r\n      toast.error(\"File too large! A maximum of 2MB is allowed.\");\r\n    } else {\r\n      setBioData({\r\n        ...bioData,\r\n        id: e.target.files[0],\r\n      });\r\n    }\r\n  };\r\n\r\n  const confirmCheck = () => {\r\n    var check = document.getElementById(\"check\");\r\n    if (check.checked) {\r\n      setCheckAct(true);\r\n    } else {\r\n      setCheckAct(false);\r\n    }\r\n  };\r\n\r\n  const showForm = () => {\r\n    // toast.info(\"Application for this cohort has ended. Please check back later!!!\")\r\n    var check = document.getElementById(\"check\");\r\n    if (check.checked) {\r\n      setActive(\"form\");\r\n      setFormActive(\"bio-data\");\r\n    } else {\r\n      toast.warn(\"You need to accept the terms and conditions to proceed!\");\r\n    }\r\n  };\r\n\r\n  const showEduForm = (e) => {\r\n    e.preventDefault();\r\n    setFormActive(\"education\");\r\n  };\r\n\r\n  const submitForm = (e) => {\r\n    e.preventDefault();\r\n    var btn = document.getElementById(\"actionBtn\");\r\n    btn.innerHTML = `<img src=${loader} width=\"20px\" />`;\r\n    var data = new FormData();\r\n    \r\n    try {\r\n        //  btn.innerHTML = `Submit`;\r\n        btn.innerHTML = `<img src=${loader} width=\"20px\" />`;\r\n    if (!(bioData.phone.length>10)){\r\n      btn.innerHTML = `Submit`;\r\n      toast.error(\"please check enter a valid phone number\")\r\n    }\r\n    else{\r\n      // btn.innerHTML = `Submit`;\r\n      btn.innerHTML = `<img src=${loader} width=\"20px\" />`;\r\n      // toast.success('Successful')\r\n\r\n    data.append(\"firstName\", bioData.firstName);\r\n    data.append(\"lastName\", bioData.lastName);\r\n    data.append(\"email\", bioData.email);\r\n    data.append(\"phoneNumber\", bioData.phone);\r\n    data.append(\"dob\", bioData.dob);\r\n    data.append(\"gender\", bioData.gender);\r\n    data.append(\"preferred_course\", bioData.course);\r\n    data.append(\"state_of_residence\", bioData.state);\r\n    data.append(\"current_city_and_location\", bioData.city);\r\n    data.append(\"means_of_identification\", bioData.id);\r\n    data.append(\"course_of_study\", education.courseOfStudy);\r\n    data.append(\"grade_achieved\", education.grade);\r\n    data.append(\"qualifications\", education.qualification);\r\n    data.append(\"programming_skills\", education.experience);\r\n    data.append(\"nysc_status\", education.nyscStatus);\r\n    data.append(\"why_selected_for_cohort\", education.reason);\r\n    data.append(\"physically_available\", education.availability);\r\n    data.append(\"will_you_pay_legal_fees\", education.legalFee);\r\n    }\r\n  }\r\n    catch(err) {\r\n      toast.error(\"please check enter a valid phone number\")\r\n      btn.innerHTML = `Submit`\r\n    }\r\n\r\n    submitDetails(data, userId)\r\n      .then((response) => response.data)\r\n      .then((res) => {\r\n        console.log(res);\r\n        if (res.status === 200) {\r\n          toast.success(\r\n            \"Submission successful! Your Application is now under review.\"\r\n          );\r\n          btn.innerHTML = `Submit`;\r\n          setNewStatus();\r\n        } else {\r\n          toast.error(\"Submission not successful, try again!!!\");\r\n          btn.innerHTML = `Submit`;\r\n        }\r\n      })\r\n      .catch((err) => {\r\n        console.log(err.response.data);\r\n        \r\n        if(err.response.data===\"File size limit has been reached\"){\r\n          toast.error(\"File size exceeded for Means of Identification Field\");\r\n        }\r\n        if (err.response) {\r\n          toast.error(err.response);\r\n          btn.innerHTML = `Submit`;\r\n        } else {\r\n          toast.error(\r\n            \"Something went wrong!!! Please make sure you have a good internet connection.\"\r\n          );\r\n          btn.innerHTML = `Submit`;\r\n        }\r\n      });\r\n  };\r\n\r\n  return (\r\n    <div>\r\n        {/* {setBioData(userDetails)} */}\r\n      <ToastContainer closeButton={false} />\r\n      {active === \"welcome\" && (\r\n        <div>\r\n          <h3>Hello {fname}</h3>\r\n          <p className=\"text1\">\r\n            Learn with us for 5 months and pay no tuition till you’re hired!\r\n          </p>\r\n          <p>\r\n            Grazac Accelerator Program is a full time, 5-month training program\r\n            focused on building in-demand tech skills at an accelerated pace.\r\n            This program goes above and beyond to provide a superior educational\r\n            experience, allowing students to develop a successful career in the\r\n            tech industry through intensive training and internships.\r\n          </p>\r\n          <p>Our curriculum covers 4 basic tech disciplines that includes;</p>\r\n          <ul>\r\n            <li>Product Designing (UI/UX)</li>\r\n            <li>\r\n              Front end web development (HTML, CSS, and Javascript (React.js)\r\n            </li>\r\n            <li>Back end web development (Nodejs)</li>\r\n            <li>Mobile Application Development (Flutter and Dart)</li>\r\n          </ul>\r\n          <h4>Pricing Plans</h4>\r\n          <p>\r\n            Enrollment is free but for the tuition fee, we offer two basic forms\r\n            of payment options and they are;\r\n          </p>\r\n          <ul>\r\n            <li>\r\n              <strong>Pay as you Earn plan:</strong> This is a financial\r\n              instrument to help you participate in our training for FREE. You\r\n              are expected to start paying us back once you get a job at the end\r\n              of the program. It is governed by a legally binding contract. This\r\n              contract is bonded by the law firm.\r\n            </li>\r\n            <li>\r\n              <strong>Pay at once:</strong> You can pay your tuition fee all at\r\n              once with this plan.\r\n            </li>\r\n          </ul>\r\n          <h4>Duration</h4>\r\n          <ul>\r\n            <li>5months ( 3months intensive training + 2months internship).</li>\r\n          </ul>\r\n          <h4>Basic Criteria to be met</h4>\r\n          <ul>\r\n            <li>\r\n              Candidates must be a Graduate and available full-time for at least\r\n              6 months.\r\n            </li>\r\n            <li>\r\n              Note that you will be mandated to provide guarantors and pay the\r\n              sum of #30,000 legal fee if selected for this cohort. This must be\r\n              paid within a week after selection if you have chosen our Pay as\r\n              you Earn option.\r\n            </li>\r\n          </ul>\r\n          <div className=\"checkbox\">\r\n            <input type=\"checkbox\" id=\"check\" onClick={confirmCheck} />\r\n            <p>\r\n              I accept the{\" \"}\r\n              <a href={termsandconds} download target=\"_blank\">\r\n                Terms ‌and‌ ‌Conditions‌\r\n              </a>\r\n            </p>\r\n          </div>\r\n          <button\r\n            className={!checkAct ? \"disable-btn\" : \"button\"}\r\n            onClick={showForm}\r\n          >\r\n            Apply Now\r\n          </button>\r\n        </div>\r\n      )}\r\n      {active === \"form\" && (\r\n        <div>\r\n          <div>\r\n            {formActive === \"bio-data\" && (\r\n              <div>\r\n                <div\r\n                  className=\"dashboard-content-back\"\r\n                  onClick={() => {\r\n                    setActive(\"welcome\");\r\n                    setCheckAct(false);\r\n                  }}\r\n                >\r\n                  <img src={arrow} alt=\"back\" />\r\n                  <p>Back</p>\r\n                </div>\r\n                <h4 style={{ marginLeft: \"20px\" }}>Apply</h4>\r\n                <div className=\"dashboard-content-form\">\r\n                  <form onSubmit={showEduForm}>\r\n                  {/* <form onSubmit={submitForm}> */}\r\n                    <p>Step 1 of 2</p>\r\n                    <p>BIO DATA</p>\r\n                    <div className=\"dashboard-content-form-container\">\r\n                      <label>First Name</label>\r\n                      <input\r\n                        type=\"text\"\r\n                        required\r\n                        name=\"firstName\"\r\n                        placeholder=\"FirstName\"\r\n                        value={bioData.firstName}\r\n                        onChange={handleChange}\r\n                      />\r\n                      {/* {console.log(bioData.firstName)} */}\r\n                    </div>\r\n                    <div className=\"dashboard-content-form-container\">\r\n                      <label>Last Name</label>\r\n                      <input\r\n                        type=\"text\"\r\n                        required\r\n                        name=\"lastName\"\r\n                        placeholder=\"LastName\"\r\n                        value={bioData.lastName}\r\n                        onChange={handleChange}\r\n                      />\r\n                    </div>\r\n                    <div className=\"dashboard-content-form-container\">\r\n                      <label>Email Address</label>\r\n                      <input\r\n                        type=\"email\"\r\n                        required\r\n                        name=\"email\"\r\n                        placeholder=\"Email Address\"\r\n                        value={email}\r\n                        onChange={handleChange}\r\n                      />\r\n                    </div>\r\n                    <div className=\"dashboard-content-form-container\">\r\n                      <label>Phone Number</label>\r\n                      <input\r\n                        // type=\"number\"\r\n                        required\r\n                        name=\"phone\"\r\n                        placeholder=\"Phone Number\"\r\n                        value={bioData.phone}\r\n                        onChange={handleChange}\r\n                      />\r\n                    </div>\r\n                    <div className=\"dashboard-content-form-container\">\r\n                      <label>Date of Birth</label>\r\n                      <input\r\n                        type=\"date\"\r\n                        required\r\n                        name=\"dob\"\r\n                        placeholder=\"31/01/2021\"\r\n                        value={bioData.dob}\r\n                        onChange={handleChange}\r\n                      />\r\n                    </div>\r\n                    <div className=\"dashboard-content-form-container\">\r\n                      <label>Gender</label>\r\n                      <select\r\n                        name=\"gender\"\r\n                        required\r\n                        value={bioData.gender}\r\n                        onChange={handleChange}\r\n                      >\r\n                        <option>Select an option</option>\r\n                        <option value=\"male\">Male</option>\r\n                        <option value=\"female\">Female</option>\r\n                      </select>\r\n                    </div>\r\n\r\n                    <div className=\"dashboard-content-form-container\">\r\n                      <label>Marital Status</label>\r\n                      <select\r\n                        name=\"maritalStatus\"\r\n                        required\r\n                        value={bioData.maritalStatus}\r\n                        onChange={handleChange}\r\n                      >\r\n                        <option>Select an option</option>\r\n                        <option value=\"single\">Single</option>\r\n                        <option value=\"Married\">Married</option>\r\n                      </select>\r\n                    </div>\r\n\r\n                    {/* kid status */}\r\n                    <div className=\"dashboard-content-form-container\">\r\n                      <label>Do you have Kids</label>\r\n                      <select\r\n                        name=\"haveKids\"\r\n                        required\r\n                        value={bioData.haveKids}\r\n                        onChange={handleChange}\r\n                      >\r\n                        <option>Select an option</option>\r\n                        <option value=\"yes\">Yes</option>\r\n                        <option value=\"No\">No</option>\r\n                      </select>\r\n                    </div>\r\n                    {/* age range */}\r\n                    <div className=\"dashboard-content-form-container\">\r\n                      <label>What's Your Age Range?</label>\r\n                      <select\r\n                        name=\"ageRange\"\r\n                        required\r\n                        value={bioData.ageRange}\r\n                        onChange={handleChange}\r\n                      >\r\n                        <option>Select an option</option>\r\n                        <option value=\"18 - 24\">18 - 24</option>\r\n                        <option value=\"25 - 30\">25 - 30</option>\r\n                        <option value=\"31 - 35\">31 - 35</option>\r\n                        <option value=\"36 and above\">36 and above</option>\r\n                      </select>\r\n                    </div>\r\n\r\n                    <div className=\"dashboard-content-form-container\">\r\n                      <label>Preferred course at Grazac</label>\r\n                      <select\r\n                        name=\"course\"\r\n                        required\r\n                        value={bioData.course}\r\n                        onChange={handleChange}\r\n                      >\r\n                        <option>Select Preferred Course</option>\r\n                        <option value=\"Product Design\">Product Design</option>\r\n                        <option value=\"Frontend Web Development\">\r\n                          Front-end Web Development\r\n                        </option>\r\n                        <option value=\"Backend Web Development\">\r\n                          Back-end Web Development\r\n                        </option>\r\n                        <option value=\"Android Development\">\r\n                          Android Development\r\n                        </option>\r\n                        <option value=\"Product Management\">\r\n                        Product Management\r\n                        </option>\r\n                      </select>\r\n                    </div>\r\n                    <div className=\"dashboard-content-form-container\">\r\n                      <label>State of residence</label>\r\n                      <select\r\n                        name=\"state\"\r\n                        required\r\n                        value={bioData.state}\r\n                        onChange={handleChange}\r\n                      >\r\n                        <option>Select State</option>\r\n                        {nigerianStates.map(function (nigerianStates, index) {\r\n                          return (\r\n                            <option value={nigerianStates.Name} key={index}>\r\n                              {nigerianStates.Name}\r\n                            </option>\r\n                          );\r\n                        })}\r\n                      </select>\r\n                    </div>\r\n                    <div className=\"dashboard-content-form-container\">\r\n                      <label name=\"city\" onChange={handleChange}>\r\n                        Current city and Location\r\n                      </label>\r\n                      <input\r\n                        type=\"text\"\r\n                        required\r\n                        name=\"city\"\r\n                        value={bioData.city}\r\n                        placeholder=\"Current City and Location\"\r\n                        onChange={handleChange}\r\n                      />\r\n                    </div>\r\n\r\n                    <div className=\"dashboard-content-form-container\">\r\n                      <label>\r\n                        Means of Identification (NIN / Voter's Card / Driver’s\r\n                        License / Green Passport)\r\n                      </label>\r\n\r\n                      <input\r\n                        type=\"file\"\r\n                        required\r\n                        name=\"id\"\r\n                        onChange={handleImage}\r\n                      />\r\n                      \r\n                      <p className=\"upload-text\">\r\n                        {bioData.id\r\n                          ? `${bioData.id.name}`\r\n                          : \"Upload means of identification (max 2MB file size)\"}\r\n                      </p>\r\n                      <img src={upload} alt=\"upload\" className=\"upload-img\" />\r\n                    </div>\r\n                    <button style={{ float: \"right\" }} type=\"submit\">\r\n                      Continue\r\n                    </button>\r\n                  </form>\r\n                </div>\r\n              </div>\r\n            )}\r\n\r\n            {formActive === \"education\" && (\r\n              <div>\r\n                <div\r\n                  className=\"dashboard-content-back\"\r\n                  onClick={() => setFormActive(\"bio-data\")}\r\n                >\r\n                  <img src={arrow} alt=\"back\" />\r\n                  <p>Back</p>\r\n                </div>\r\n                <h4 style={{ marginLeft: \"20px\" }}>Apply</h4>\r\n                <div className=\"dashboard-content-form\">\r\n                  <form onSubmit={submitForm}>\r\n                    <p>Step 2 of 2</p>\r\n                    <p>Educational Background</p>\r\n                    <div className=\"dashboard-content-form-container\">\r\n                      <label>Course of Study</label>\r\n                      <input\r\n                        type=\"text\"\r\n                        required\r\n                        name=\"courseOfStudy\"\r\n                        value={education.courseOfStudy}\r\n                        placeholder=\"Course of Study\"\r\n                        onChange={handleChange}\r\n                      />\r\n                    </div>\r\n                    <div className=\"dashboard-content-form-container\">\r\n                      <label>Grade Achieved</label>\r\n                      <input\r\n                        type=\"text\"\r\n                        required\r\n                        name=\"grade\"\r\n                        value={education.grade}\r\n                        placeholder=\"Grade Achieved\"\r\n                        onChange={handleChange}\r\n                      />\r\n                    </div>\r\n                    <div className=\"dashboard-content-form-container\">\r\n                      <label>Qualification</label>\r\n                      <select\r\n                        name=\"qualification\"\r\n                        value={education.qualification}\r\n                        required\r\n                        onChange={handleChange}\r\n                      >\r\n                        <option value=\"\">Select Qualification</option>\r\n                        <option value=\"B.Sc\">B.Sc</option>\r\n                        <option value=\"ND\">ND</option>\r\n                        <option value=\"HND\">HND</option>\r\n                        <option value=\"M.Sc\">M.Sc</option>\r\n                        <option value=\"PhD\">PhD</option>\r\n                        <option value=\"other\">other</option>\r\n                      </select>\r\n                    </div>\r\n                    <div className=\"dashboard-content-form-container\">\r\n                      <label>Programming/Design Experience</label>\r\n                      <select\r\n                        name=\"experience\"\r\n                        value={education.experience}\r\n                        required\r\n                        onChange={handleChange}\r\n                      >\r\n                        <option value=\"\">\r\n                          Select Programming/Design Experience\r\n                        </option>\r\n                        <option value=\"No skill\">No skill</option>\r\n                        <option value=\"Basic skill\">Basic skill</option>\r\n                        <option value=\"Mid-level skill\">Mid-level Skill</option>\r\n                      </select>\r\n                    </div>\r\n                    <div className=\"dashboard-content-form-container\">\r\n                      <label>Nysc Status</label>\r\n                      <select\r\n                        name=\"nyscStatus\"\r\n                        value={education.nyscStatus}\r\n                        required\r\n                        onChange={handleChange}\r\n                      >\r\n                        <option value=\"\">Select Nysc Status</option>\r\n                        <option value=\"Service\">Completed</option>\r\n                        <option value=\"Exemption\">Exemption</option>\r\n                        <option value=\"Use period to learn\">\r\n                          I will use my period of service to learn\r\n                        </option>\r\n                        <option value=\"nd_graduate\">ND Graduate</option>\r\n                        <option value=\"other\">Other</option>\r\n                      </select>\r\n                    </div>\r\n                    <div className=\"dashboard-content-form-container\">\r\n                      <label>\r\n                        Why do you think you should be selected as a part of\r\n                        this cohort?\r\n                      </label>\r\n                      <textarea\r\n                        type=\"text\"\r\n                        required\r\n                        name=\"reason\"\r\n                        value={education.reason}\r\n                        placeholder=\"Write your reasons here...\"\r\n                        onChange={handleChange}\r\n                      />\r\n                    </div>\r\n                    <div className=\"dashboard-content-form-container\">\r\n                      <label>\r\n                        Will you be physically available for the next 6 months?\r\n                      </label>\r\n                      <select\r\n                        name=\"availability\"\r\n                        value={education.availability}\r\n                        required\r\n                        onChange={handleChange}\r\n                      >\r\n                        <option value=\"\">Select Availability</option>\r\n                        <option value=\"Yes\">Yes</option>\r\n                        <option value=\"No\">No</option>\r\n                      </select>\r\n                    </div>\r\n                    <div className=\"dashboard-content-form-container\">\r\n                      <label>\r\n                        If selected, will you be able to pay the legal fees of\r\n                        #30,000?\r\n                      </label>\r\n                      <select\r\n                        name=\"legalFee\"\r\n                        value={education.legalFee}\r\n                        required\r\n                        onChange={handleChange}\r\n                      >\r\n                        <option value=\"\">Select</option>\r\n                        <option value=\"Yes\">Yes</option>\r\n                        <option value=\"No\">No</option>\r\n                      </select>\r\n                    </div>\r\n                    <button\r\n                      style={{ float: \"right\", width: \"50px\" }}\r\n                      type=\"submit\"\r\n                      id=\"actionBtn\"\r\n                    >\r\n                      Submit\r\n                    </button>\r\n                    <button\r\n                      className=\"dashboard-content-form-container-prev\"\r\n                      onClick={() => setFormActive(\"bio-data\")}\r\n                    >\r\n                      Previous\r\n                    </button>\r\n                  </form>\r\n                </div>\r\n              </div>\r\n            )}\r\n          </div>\r\n        </div>\r\n      )}\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default NotSubmitted;\r\n","C:\\Users\\mitchel\\Documents\\grazac\\code\\grazac-academy-web\\src\\api\\dashboard\\apikit.js",[],{"ruleId":"288","replacedBy":"289"},{"ruleId":"290","replacedBy":"291"},{"ruleId":"292","severity":1,"message":"293","line":8,"column":25,"nodeType":"294","messageId":"295","endLine":8,"endColumn":33},{"ruleId":"292","severity":1,"message":"296","line":85,"column":10,"nodeType":"294","messageId":"295","endLine":85,"endColumn":18},{"ruleId":"292","severity":1,"message":"297","line":85,"column":20,"nodeType":"294","messageId":"295","endLine":85,"endColumn":31},{"ruleId":"292","severity":1,"message":"298","line":1,"column":25,"nodeType":"294","messageId":"295","endLine":1,"endColumn":33},{"ruleId":"292","severity":1,"message":"299","line":2,"column":8,"nodeType":"294","messageId":"295","endLine":2,"endColumn":15},{"ruleId":"292","severity":1,"message":"300","line":5,"column":8,"nodeType":"294","messageId":"295","endLine":5,"endColumn":18},{"ruleId":"292","severity":1,"message":"301","line":8,"column":8,"nodeType":"294","messageId":"295","endLine":8,"endColumn":13},{"ruleId":"302","severity":1,"message":"303","line":39,"column":6,"nodeType":"304","endLine":39,"endColumn":8,"suggestions":"305"},{"ruleId":"306","severity":1,"message":"307","line":60,"column":29,"nodeType":"308","endLine":60,"endColumn":44},{"ruleId":"292","severity":1,"message":"309","line":48,"column":11,"nodeType":"294","messageId":"295","endLine":48,"endColumn":18},{"ruleId":"292","severity":1,"message":"310","line":5,"column":8,"nodeType":"294","messageId":"295","endLine":5,"endColumn":14},{"ruleId":"292","severi