les":"38"},{"filePath":"59","messages":"60","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"38"},{"filePath":"61","messages":"62","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"38"},{"filePath":"63","messages":"64","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"38"},{"filePath":"65","messages":"66","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"38"},{"filePath":"67","messages":"68","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"38"},{"filePath":"69","messages":"70","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"71","messages":"72","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"38"},{"filePath":"73","messages":"74","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"38"},"C:\\Users\\'Toyosi Adekanmbi\\Desktop\\grazac-academy-web\\src\\index.js",[],["75","76"],"C:\\Users\\'Toyosi Adekanmbi\\Desktop\\grazac-academy-web\\src\\reportWebVitals.js",[],"C:\\Users\\'Toyosi Adekanmbi\\Desktop\\grazac-academy-web\\src\\App.js",[],"C:\\Users\\'Toyosi Adekanmbi\\Desktop\\grazac-academy-web\\src\\auth\\Signup.js",["77","78","79","80","81","82","83","84","85","86","87","88","89"],"import { useState } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { cn } from \"../utils\";\r\nimport PrimaryBtn from \"../components/PrimaryBtn\";\r\nimport Grazac from \"../images/grazac.png\";\r\n\r\nconst validEmailRegex = RegExp(\r\n  /^(([^<>()\\[\\]\\.,;:\\s@\\\"]+(\\.[^<>()\\[\\]\\.,;:\\s@\\\"]+)*)|(\\\".+\\\"))@(([^<>()[\\]\\.,;:\\s@\\\"]+\\.)+[^<>()[\\]\\.,;:\\s@\\\"]{2,})$/i\r\n);\r\n\r\nconst Signup = () => {\r\n  const [email, setEmail] = useState(\"\");\r\n  const [password, setPassword] = useState(\"\");\r\n  const [emailErr, setEmailErr] =  useState(\"\");\r\n  const [phone, setPhone] = useState(\"\");\r\n  const [gender, setGender] = useState(\"\");\r\n\r\n  \r\n  const handleEmailChange = e => {\r\n    e.preventDefault();\r\n    setEmail(e.target.value)\r\n\r\n    if (!email) setEmailErr(\"\");\r\n    let err = validEmailRegex.test(e.target.value) ? \"\" : \"please enter a valid email address\";\r\n    setEmailErr(err);\r\n  }\r\n\r\n  const handlePasswordChange = e => {\r\n    e.preventDefault();\r\n    setPassword(e.target.value)\r\n  }\r\n\r\n  return(\r\n    <div className=\"auth\">\r\n      <div className=\"auth__body\">\r\n        <div className=\"auth__hero\">\r\n          <img src={Grazac} alt=\"grazac\" />\r\n        </div>\r\n\r\n        <div className=\"auth__form\">\r\n          <div className=\"auth__form--container\">\r\n            <h1>Create Account</h1>\r\n\r\n            <form className=\"form\">\r\n              <div className=\"form__group\">\r\n                <label for=\"email\">Email address</label>\r\n                <input type=\"email\" id=\"email\" value={email} onChange={handleEmailChange} className={cn(\"form__input\", {\"form__input--err\": emailErr})}/>\r\n              </div>\r\n\r\n              <div className=\"form__group--half\">\r\n                <div className=\"form__group\">\r\n                  <label for=\"phone\">Phone </label>\r\n                  <input type=\"email\" id=\"email\" value={phone} onChange={e => setPhone(e.target.value)} className={cn(\"form__input\")}/>\r\n                </div>\r\n\r\n                <div className=\"form__group\">\r\n                  <label for=\"gender\">Gender</label>\r\n                    <select id=\"cars\" className=\"form__input\" onChange={e => setGender(e.target.value)}>\r\n                      <option value=\"\">Select gender</option>\r\n                      <option value=\"male\">Male</option>\r\n                      <option value=\"female\">Female</option>\r\n                      <option value=\"\">I'm not sure</option>\r\n                    </select>\r\n                </div>\r\n              </div>\r\n\r\n              <div className=\"form__group\">\r\n                <label for=\"pass\">Password</label>\r\n                <input type=\"password\" id=\"pass\" value={password} onChange={handlePasswordChange} className=\"form__input\"/>\r\n              </div>\r\n\r\n              <Link className=\"form__link\">Forgot password?</Link>\r\n\r\n              <button type=\"submit\" className=\"form__btn\">\r\n                <PrimaryBtn>Create Account</PrimaryBtn>\r\n              </button>\r\n            </form>\r\n\r\n            <div className=\"auth__line\">\r\n              <div>&nbsp;</div>\r\n              <span>or</span>\r\n              <div>&nbsp;</div>\r\n            </div>\r\n          </div>\r\n\r\n          <div className=\"auth__btns\">\r\n            <Link className=\"auth__btn\">\r\n              <svg width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\r\n                <path d=\"M4.43236 12.0862L3.7362 14.6851L1.19174 14.7389C0.431322 13.3285 0 11.7148 0 9.99997C0 8.34175 0.403276 6.77802 1.11811 5.40112H1.11866L3.38394 5.81643L4.37627 8.06812C4.16858 8.67362 4.05537 9.32361 4.05537 9.99997C4.05545 10.734 4.18842 11.4373 4.43236 12.0862Z\" fill=\"#FBBB00\"/>\r\n                <path d=\"M19.824 8.1322C19.9389 8.73712 19.9988 9.36183 19.9988 10.0003C19.9988 10.7162 19.9235 11.4146 19.7801 12.0882C19.2933 14.3805 18.0213 16.3821 16.2593 17.7986L16.2587 17.798L13.4055 17.6524L13.0017 15.1316C14.1709 14.4459 15.0846 13.3728 15.5659 12.0882H10.2188V8.1322H15.644H19.824Z\" fill=\"#518EF8\"/>\r\n                <path d=\"M16.2593 17.798L16.2599 17.7985C14.5462 19.176 12.3693 20.0002 9.99953 20.0002C6.19134 20.0002 2.88041 17.8716 1.19141 14.7392L4.43203 12.0865C5.27651 14.3403 7.45066 15.9447 9.99953 15.9447C11.0951 15.9447 12.1215 15.6486 13.0022 15.1315L16.2593 17.798Z\" fill=\"#28B446\"/>\r\n                <path d=\"M16.3818 2.30216L13.1423 4.95431C12.2308 4.38455 11.1533 4.05541 9.99894 4.05541C7.39237 4.05541 5.17756 5.7334 4.37538 8.06802L1.11773 5.40102H1.11719C2.78146 2.19228 6.13415 0 9.99894 0C12.4253 0 14.65 0.864285 16.3818 2.30216Z\" fill=\"#F14336\"/>\r\n              </svg>\r\n\r\n              Google\r\n            </Link>\r\n\r\n            <Link className=\"auth__btn\">\r\n              <svg width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\r\n                <path d=\"M18.1908 0H1.80916C0.81 0 0 0.81 0 1.80916V18.1908C0 19.19 0.81 20 1.80916 20H18.1908C19.19 20 20 19.19 20 18.1908V1.80916C20 0.81 19.19 0 18.1908 0ZM6.18885 17.2693C6.18885 17.5601 5.95314 17.7958 5.66236 17.7958H3.4212C3.13042 17.7958 2.89471 17.5601 2.89471 17.2693V7.8745C2.89471 7.58372 3.13042 7.34801 3.4212 7.34801H5.66236C5.95314 7.34801 6.18885 7.58372 6.18885 7.8745V17.2693ZM4.54178 6.46241C3.36592 6.46241 2.41267 5.50916 2.41267 4.3333C2.41267 3.15743 3.36592 2.20419 4.54178 2.20419C5.71764 2.20419 6.67089 3.15743 6.67089 4.3333C6.67089 5.50916 5.7177 6.46241 4.54178 6.46241ZM17.901 17.3117C17.901 17.5791 17.6843 17.7958 17.417 17.7958H15.012C14.7447 17.7958 14.528 17.5791 14.528 17.3117V12.905C14.528 12.2476 14.7208 10.0243 12.81 10.0243C11.3279 10.0243 11.0272 11.5461 10.9669 12.2291V17.3117C10.9669 17.5791 10.7502 17.7958 10.4828 17.7958H8.15681C7.88948 17.7958 7.67272 17.5791 7.67272 17.3117V7.83209C7.67272 7.56476 7.88948 7.34801 8.15681 7.34801H10.4828C10.7501 7.34801 10.9669 7.56476 10.9669 7.83209V8.65173C11.5164 7.82696 12.3332 7.19037 14.0722 7.19037C17.9231 7.19037 17.901 10.7881 17.901 12.7648V17.3117Z\" fill=\"#0077B7\"/>\r\n              </svg>\r\n\r\n              Linkedln\r\n            </Link>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default Signup;","C:\\Users\\'Toyosi Adekanmbi\\Desktop\\grazac-academy-web\\src\\pages\\Landing.js",["90","91","92","93","94","95","96","97"],"import { useState } from \"react\";\r\nimport { Link } from \"react-router-dom\";   \r\nimport { cn } from \"../utils\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport PrimaryBtn from \"../components/PrimaryBtn\";\r\nimport CreateAccount from \"../components/CreateAccount\";\r\nimport Kamala from \"../images/kamala.jpg\"\r\nimport Grazac from \"../images/svg/grazac.svg\";\r\nimport Love from \"../images/my_love.png\";\r\nimport Man from \"../images/man.jpg\";\r\n\r\nimport Sponsor1 from \"../images/svg/sponsor1.svg\";\r\nimport Sponsor2 from \"../images/svg/sponsor2.svg\";\r\nimport Sponsor3 from \"../images/svg/sponsor3.svg\";\r\n\r\nimport Python from \"../images/svg/python.svg\";\r\nimport ML from \"../images/svg/ml.svg\";\r\nimport Html from \"../images/svg/html.svg\";\r\nimport Node from \"../images/svg/node.svg\";\r\nimport PD from \"../images/svg/pd.svg\";\r\nimport Android from \"../images/svg/android.svg\";\r\n\r\nconst Landing = () => {\r\n  // const [email, setEmail] = useState(\"\");\r\n  const [step, setStep] = useState(0);\r\n  \r\n  const dots = [false, false, false, false];\r\n  const content = [\r\n    {\r\n      id: 0,\r\n      img: Kamala,\r\n      content: \"Travelya, thank you so much for a well organized trip. We had a wonderful time. Hard to believe it’s already done and past. Weather was awesom, the hotels were nice, thanks your for everything\",\r\n      name: \"Kamala Harris - First Woman Vice President\"\r\n    },\r\n    {\r\n      id: 1,\r\n      img: Love,\r\n      content: \"Do whatever you want with your life, since you only get to live it once, We had a wonderful time. Hard to believe it’s already done and past. Weather was awesom, the hotels were nice, thanks your for everything\",\r\n      name: \"Adekanmbi Toyosi Adeleye\"\r\n    },\r\n    {\r\n      id: 2,\r\n      img: Kamala,\r\n      content: \"Travelya, thank you so much for a well organized trip. We had a wonderful time. Hard to believe it’s already done and past. Weather was awesom, the hotels were nice, thanks your for everything\",\r\n      name: \"Jermaine Cole - J.Cole\"\r\n    },\r\n    {\r\n      id: 3,\r\n      img: Love,\r\n      content: \"Travelya, thank you so much for a well organized trip. We had a wonderful time. Hard to believe it’s already done and past. Weather was awesom, the hotels were nice, thanks your for everything\",\r\n      name: \"Kendrick Lamar\"\r\n    },\r\n  ]\r\n\r\n  return(\r\n    <div className=\"landing\">\r\n      <div className=\"landing__header\">\r\n        <Navbar />\r\n      <div style={{height: 10}}></div>\r\n\r\n\r\n        <div className=\"landing__text\">\r\n          <h1>The future of insurance is data, driven</h1>\r\n          <p>Rideshur sets fair rates adjusted at every turn. Safety, risk level, and claims are all managed from a single dashboard. Evolve your fleet.</p>\r\n        </div>\r\n\r\n        <div className=\"landing__btn\">\r\n          <PrimaryBtn link=\"/get-started\">Get Started</PrimaryBtn>\r\n        </div>\r\n      </div>\r\n\r\n      <div className=\"landing__video\">\r\n        \r\n      </div>\r\n\r\n      <div className=\"landing__sponsors\">\r\n        <div className=\"landing__sponsors--container\">\r\n          <img src={Sponsor1} alt=\"sponsor\" />\r\n          <img src={Sponsor2} alt=\"sponsor\" />\r\n          <img src={Sponsor3} alt=\"sponsor\" />\r\n          <img src={Sponsor2} alt=\"sponsor\" />\r\n          <img src={Sponsor3} alt=\"sponsor\" />\r\n          <img src={Sponsor1} alt=\"sponsor\" />\r\n        </div>\r\n      </div>\r\n\r\n      <div className=\"landing__courses\">\r\n        <div className=\"landing__courses--container\">\r\n          <div className=\"landing__bottom--text landing__courses--container--txt\">\r\n            <div className=\"landing__bottom--text--right landing__bottom--text2\">\r\n              <h5>GRAZAC ACADEMY</h5>\r\n              <h1>Individualized attention needed for self-confidence.</h1>\r\n            </div>\r\n\r\n            <div className=\"landing__bottom--text--right--left\">\r\n              <div className=\"landing__btn--2\">\r\n                <PrimaryBtn link=\"/get-started\">See All Courses</PrimaryBtn>\r\n              </div>\r\n            </div>\r\n          </div>\r\n\r\n          <div className=\"landing__courses--cards\">\r\n            <div className=\"landing__courses--card\">\r\n              <div>\r\n                <img src={Python} alt=\"python\" />\r\n              </div>\r\n              <h3>Python for Data Science</h3>\r\n              <p>This course helps you accelerate your career into Data Analytics. Learn Structured Query Language and Power BI for Data Analytics and Visualization.</p>\r\n              <Link>Learn More</Link>\r\n            </div>\r\n\r\n            <div className=\"landing__courses--card\">\r\n              <div style={{backgroundColor: \"#75DEBE\"}}>\r\n                <img src={Html} alt=\"python\" />\r\n              </div>\r\n              <h3>Front - End Development</h3>\r\n              <p>This course helps you accelerate your career into Data Analytics. Learn Structured Query Language and Power BI for Data Analytics and Visualization.</p>\r\n              <Link>Learn More</Link>\r\n            </div>\r\n\r\n            <div className=\"landing__courses--card\">\r\n              <div style={{backgroundColor: \"#FEC952\"}}>\r\n                <img src={Node} alt=\"python\" />\r\n              </div>\r\n              <h3>Back - End Development</h3>\r\n              <p>This course helps you accelerate your career into Data Analytics. Learn Structured Query Language and Power BI for Data Analytics and Visualization.</p>\r\n              <Link>Learn More</Link>\r\n            </div>\r\n\r\n            <div className=\"landing__courses--card\">\r\n              <div style={{backgroundColor: \"#B0B54F\"}}>\r\n                <img src={ML} alt=\"python\" />\r\n              </div>\r\n              <h3>Machine Learning</h3>\r\n              <p>This course helps you accelerate your career into Data Analytics. Learn Structured Query Language and Power BI for Data Analytics and Visualization.</p>\r\n              <Link>Learn More</Link>\r\n            </div>\r\n\r\n            <div className=\"landing__courses--card\">\r\n              <div style={{backgroundColor: \"#F0BB8F\"}}>\r\n                <img src={PD} alt=\"python\" />\r\n              </div>\r\n              <h3>Product Design (UI/UX)</h3>\r\n              <p>This course helps you accelerate your career into Data Analytics. Learn Structured Query Language and Power BI for Data Analytics and Visualization.</p>\r\n              <Link>Learn More</Link>\r\n            </div>\r\n\r\n            <div className=\"landing__courses--card\">\r\n              <div style={{backgroundColor: \"#DCCDF4\"}}>\r\n                <img src={Android} alt=\"python\" />\r\n              </div>\r\n              <h3>Android Development</h3>\r\n              <p>This course helps you accelerate your career into Data Analytics. Learn Structured Query Language and Power BI for Data Analytics and Visualization.</p>\r\n              <Link>Learn More</Link>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <div className=\"landing__middle\">\r\n        <div className=\"landing__middle--container\">\r\n          <div className=\"landing__middle--text\">\r\n            <h5>What we do</h5>\r\n            <h2>Mode of Teaching</h2>\r\n            <p>Amet minim mollit non deserunt ullamco est sit aliqua dolor do amet sint. Velit officia consequ</p>\r\n          </div>\r\n\r\n          <div className=\"landing__middle--images--box\">\r\n            <div className=\"landing__middle--images\">\r\n              <img src={Man}/>\r\n              <h3>Olalekan Sogunle</h3>\r\n