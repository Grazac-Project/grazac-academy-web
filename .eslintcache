er used.","Identifier","unusedVar","'Sponsor1' is defined but never used.","'Sponsor2' is defined but never used.","'Sponsor3' is defined but never used.","no-useless-escape","Unnecessary escape character: \\[.","Literal","unnecessaryEscape",["223","224"],"Unnecessary escape character: \\..",["225","226"],"Unnecessary escape character: \\\".",["227","228"],["229","230"],["231","232"],["233","234"],["235","236"],["237","238"],["239","240"],["241","242"],["243","244"],["245","246"],["247","248"],["249","250"],["251","252"],["253","254"],["255","256"],["257","258"],["259","260"],["261","262"],["263","264"],["265","266"],["267","268"],["269","270"],"'gender' is assigned a value but never used.","'PrimaryBtn' is defined but never used.","React Hook useEffect contains a call to 'setFixed'. Without a list of dependencies, this can lead to an infinite chain of updates. To fix this, pass [] as a second argument to the useEffect Hook.",["271"],"no-global-assign","no-unsafe-negation",{"desc":"272","fix":"273"},{"messageId":"274","fix":"275","desc":"276"},{"messageId":"277","fix":"278","desc":"279"},{"messageId":"274","fix":"280","desc":"276"},{"messageId":"277","fix":"281","desc":"279"},{"messageId":"274","fix":"282","desc":"276"},{"messageId":"277","fix":"283","desc":"279"},{"messageId":"274","fix":"284","desc":"276"},{"messageId":"277","fix":"285","desc":"279"},{"messageId":"274","fix":"286","desc":"276"},{"messageId":"277","fix":"287","desc":"279"},{"messageId":"274","fix":"288","desc":"276"},{"messageId":"277","fix":"289","desc":"279"},{"messageId":"274","fix":"290","desc":"276"},{"messageId":"277","fix":"291","desc":"279"},{"messageId":"274","fix":"292","desc":"276"},{"messageId":"277","fix":"293","desc":"279"},{"messageId":"274","fix":"294","desc":"276"},{"messageId":"277","fix":"295","desc":"279"},{"messageId":"274","fix":"296","desc":"276"},{"messageId":"277","fix":"297","desc":"279"},{"messageId":"274","fix":"298","desc":"276"},{"messageId":"277","fix":"299","desc":"2