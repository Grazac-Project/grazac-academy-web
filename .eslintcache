recatedRules":"74"},{"filePath":"138","messages":"139","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"74"},{"filePath":"140","messages":"141","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"74"},{"filePath":"142","messages":"143","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"74"},{"filePath":"144","messages":"145","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"74"},{"filePath":"146","messages":"147","errorCount":0,"warningCount":4,"fixableErrorCount":0,"fixableWarningCount":0,"source":"148","usedDeprecatedRules":"74"},{"filePath":"149","messages":"150","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"151","usedDeprecatedRules":"74"},{"filePath":"152","messages":"153","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"74"},{"filePath":"154","messages":"155","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},"C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\index.js",[],["156","157"],"C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\reportWebVitals.js",[],"C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\App.js",["158","159"],"C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\context.js",["160","161"],"import { createContext, useState } from \"react\";\r\nimport Loading from \"./components/Loader\";\r\n\r\nexport const LoaderContext = createContext(null);\r\n\r\n// const Loader = ({ children }) => {\r\n//   const [show, setShow] = useState(true);\r\n\r\n//   return(\r\n// <>\r\n//     {/* <LoaderContext.Provider value={{show, setShow}}>{show ? <Loader /> : children}</LoaderContext.Provider>; */}\r\n//    </>\r\n//     )\r\n// };\r\n\r\n// export default Loader;\r\n","C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\pages\\Landing.js",["162","163","164"],"C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\pages\\UndergraduateAccelerator.js",["165","166","167","168"],"C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\pages\\LeadForm.js",[],"C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\pages\\UndergraduateCourseDetail.js",["169","170"],"C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\pages\\UndergraduateCoursePayment.js",["171","172"],"import { useState, useEffect, useContext} from \"react\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport { useFlutterwave, closePaymentModal } from 'flutterwave-react-v3';\r\nimport { useParams } from \"react-router-dom\";\r\nimport { LoaderContext } from \"../context\";\r\n\r\nconst UndergraduateCoursePayment = () => {\r\n  const { id } = useParams();\r\n  const [fetched, setFetched] = useState({});\r\n  const [payment, setPayment] = useState(true);\r\n  const { setShow } = useContext(LoaderContext);\r\n  useEffect(() => {\r\n    document.title = 'Payment - Grazac Academy'\r\nsetShow(true)\r\n    fetch(`https://grazacacademy.com/undergraduate/registration/details/${id}`)\r\n    .then(resp => resp.json())\r\n    .then(data => {\r\n      setFetched(data.data)\r\n      setShow(false)\r\n      if(data.data.tx_ref.length) {\r\n        document.querySelector(\".form-info\").textContent = \"You have completed your registration\";\r\n        setPayment(false);\r\n      } \r\n    })\r\n    .catch(err => {\r\n      document.querySelector(\".form-info\").textContent = \"Something went wrong, refreshing...\";\r\n      //window.location.reload();\r\n      document.querySelector(\"#form-btn\").setAttribute('disabled', 'disabled');\r\n    })\r\n  }, []);\r\n\r\n  const config = {\r\n    public_key: 'FLWPUBK-006bdc82ad878f1518af32f44af6478f-X',\r\n    tx_ref: Date.now(),\r\n    amount: fetched.tuition,\r\n    currency: 'NGN',\r\n    payment_options: 'card,mobilemoney,ussd',\r\n    customer: {\r\n      email: fetched.email,\r\n      phonenumber: fetched.phone,\r\n      name: fetched.firstname + \" \" + fetched.lastname,\r\n    },\r\n    customizations: {\r\n      title: 'Grazac Undergraduate Accelerator Plan',\r\n      description: `Payment for ${fetched.course} at Grazac Undergraduate Accelerator Plan`,\r\n      logo: 'https://grazac.com.ng/assets/images/favicon.png',\r\n    },\r\n  };\r\n\r\n  const handleFlutterPayment = useFlutterwave(config);\r\n\r\n  const onSubmit = () => {\r\n    if(payment) {\r\n      handleFlutterPayment({\r\n        callback: (response) => {\r\n            if (response.status === 'successful') {\r\n              fetch(\"https://grazacacademy.com/undergraduate/registration/update\", {\r\n                method: 'POST',\r\n                headers: {\r\n                'Content-Type': 'application/json'\r\n                },\r\n                body: JSON.stringify({\r\n                  firstname: fetched.firstname,\r\n                  email: fetched.email,\r\n                  course: fetched.course,\r\n                  tx_ref: response.tx_ref,\r\n                  id: id\r\n                })\r\n              })\r\n              .then(resp => resp.json())\r\n              .then(data => {\r\n                if(data.success === true) {\r\n                  document.querySelector(\".form-info\").textContent = \"Your payment was successful.\";\r\n                }\r\n              })\r\n            };\r\n            closePaymentModal() // this will close the modal programmatically\r\n        },\r\n        onClose: () => {\r\n\r\n        },\r\n      });\r\n  } else {\r\n    alert('You have completed your registration');\r\n  }\r\n  }\r\n\r\n  return (\r\n    <div>\r\n      <Navbar/>\r\n        <div>\r\n          <div className=\"contact_layer\">\r\n            <div className=\"form_top\">\r\n              <div>\r\n                <h1>Payment</h1>\r\n              </div>\r\n              </div>\r\n              <div className=\"container\">\r\n                <div className=\"form\">\r\n                  <div className=\"form-info\">Click on Pay Now to finalize your payment.</div>\r\n                  <div className=\"form-flexdiv\">\r\n                    <div className=\"form-flexdiv-1\" >\r\n                      <label>First Name  <span>*</span></label>\r\n                      <input className=\"input\" type=\"text\" maxLength=\"30\" readOnly value={fetched.firstname} style={{textTransform: \"capitalize\"}}/>\r\n                    </div>\r\n                      <div className=\"form-flexdiv-2\">\r\n                          <label>Last Name  <span>*</span></label>\r\n                          <input className=\"input\" type=\"text\" maxLength=\"30\" readOnly value={fetched.lastname} style={{textTransform: \"capitalize\"}}/>\r\n                      </div>\r\n                    </div>\r\n                      <div className=\"form-flexdiv\">\r\n                          <div className=\"form-flexdiv-1\" >\r\n                              <label>Mobile Number  <span>*</span></label>\r\n                              <input className=\"input\" type=\"text\" maxLength=\"11\" readOnly value={fetched.phone}/>\r\n                          </div>\r\n                          <div className=\"form-flexdiv-2\">\r\n                              <label>Email  <span>*</span></label>\r\n                              <input className=\"input\" type=\"email\" maxLength=\"30\" readOnly value={fetched.email}/>\r\n                          </div>\r\n                      </div>\r\n                      <div>\r\n                          <label>Select your institution  <span>*</span></label><br/>\r\n                          <input className=\"input\" type=\"text\" readOnly value={fetched.institution}/>\r\n                      </div>\r\n                      <div>\r\n                          <label>Kindly choose your preferred course  <span>*</span></label><br/>\r\n                          <input className=\"input\" type=\"text\" readOnly value={fetched.course}/>\r\n                      </div>\r\n                      <div>\r\n                          <label>Amount</label><br/>\r\n                          <p className=\"show-amount\">\r\n                              ₦{ new Intl.NumberFormat().format(fetched.tuition) }\r\n                          </p>\r\n                      </div>\r\n                     \r\n                      <div className=\"form-privacy\" >\r\n                        <a className=\"download-brochure\" onClick={onSubmit} id=\"form-btn\">Pay Now</a>\r\n                      </div>\r\n                  </div>\r\n              </div>\r\n          </div>\r\n        </div>\r\n        <Footer/>\r\n    </div>\r\n  )\r\n}\r\n\r\nexport default UndergraduateCoursePayment;","C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\auth\\Login.js",["173","174","175","176","177","178","179","180","181","182","183","184"],"import { useState } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { cn } from \"../utils\";\r\nimport PrimaryBtn from \"../components/PrimaryBtn\";\r\nimport Grazac from \"../images/grazac.png\";\r\n\r\nconst validEmailRegex = RegExp(\r\n  /^(([^<>()\\[\\]\\.,;:\\s@\\\"]+(\\.[^<>()\\[\\]\\.,;:\\s@\\\"]+)*)|(\\\".+\\\"))@(([^<>()[\\]\\.,;:\\s@\\\"]+\\.)+[^<>()[\\]\\.,;:\\s@\\\"]{2,})$/i\r\n);\r\n\r\nconst Login = () => {\r\n  const [email, setEmail] = useState(\"\");\r\n  const [password, setPassword] = useState(\"\");\r\n  const [emailErr, setEmailErr] =  useState(\"\");\r\n\r\n  \r\n  const handleEmailChange = e => {\r\n    e.preventDefault();\r\n    setEmail(e.target.value)\r\n\r\n    if (!email) setEmailErr(\"\");\r\n    let err = validEmailRegex.test(e.target.value) ? \"\" : \"please enter a valid email address\";\r\n    setEmailErr(err);\r\n  }\r\n\r\n  const handlePasswordChange = e => {\r\n    e.preventDefault();\r\n    setPassword(e.target.value)\r\n  }\r\n\r\n  return(\r\n    <div className=\"auth\">\r\n      <div className=\"auth__body\">\r\n        <div className=\"auth__hero\">\r\n          <img src={Grazac} alt=\"grazac\" />\r\n        </div>\r\n\r\n        <div className=\"auth__form\">\r\n          <div className=\"auth__form--container\">\r\n            <h1>Login</h1>\r\n\r\n            <form className=\"form\">\r\n              <div className=\"form__group\">\r\n                <label for=\"email\">Email address</label>\r\n                <input type=\"email\" id=\"email\" value={email} onChange={handleEmailChange} className={cn(\"form__input\", {\"form__input--err\": emailErr})}/>\r\n              </div>\r\n\r\n              <div className=\"form__group\">\r\n                <label for=\"pass\">Password</label>\r\n                <input type=\"password\" id=\"pass\" value={password} onChange={handlePasswordChange} className=\"form__input\"/>\r\n              </div>\r\n\r\n              <Link className=\"form__link\">Forgot password?</Link>\r\n\r\n              <button type=\"submit\" className=\"form__btn\">\r\n                <PrimaryBtn>Login</PrimaryBtn>\r\n              </button>\r\n            </form>\r\n\r\n            <div className=\"auth__line\">\r\n              <div>&nbsp;</div>\r\n              <span>or</span>\r\n              <div>&nbsp;</div>\r\n            </div>\r\n          </div>\r\n\r\n          <div className=\"auth__btns\">\r\n            <Link className=\"auth__btn\">\r\n              <svg width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\r\n                <path d=\"M4.43236 12.0862L3.7362 14.6851L1.19174 14.7389C0.431322 13.3285 0 11.7148 0 9.99997C0 8.34175 0.403276 6.77802 1.11811 5.40112H1.11866L3.38394 5.81643L4.37627 8.06812C4.16858 8.67362 4.05537 9.32361 4.05537 9.99997C4.05545 10.734 4.18842 11.4373 4.43236 12.0862Z\" fill=\"#FBBB00\"/>\r\n                <path d=\"M19.824 8.1322C19.9389 8.73712 19.9988 9.36183 19.9988 10.0003C19.9988 10.7162 19.9235 11.4146 19.7801 12.0882C19.2933 14.3805 18.0213 16.3821 16.2593 17.7986L16.2587 17.798L13.4055 17.6524L13.0017 15.1316C14.1709 14.4459 15.0846 13.3728 15.5659 12.0882H10.2188V8.1322H15.644H19.824Z\" fill=\"#518EF8\"/>\r\n                <path d=\"M16.2593 17.798L16.2599 17.7985C14.5462 19.176 12.3693 20.0002 9.99953 20.0002C6.19134 20.0002 2.88041 17.8716 1.19141 14.7392L4.43203 12.0865C5.27651 14.3403 7.45066 15.9447 9.99953 15.9447C11.0951 15.9447 12.1215 15.6486 13.0022 15.1315L16.2593 17.798Z\" fill=\"#28B446\"/>\r\n                <path d=\"M16.3818 2.30216L13.1423 4.95431C12.2308 4.38455 11.1533 4.05541 9.99894 4.05541C7.39237 4.05541 5.17756 5.7334 4.37538 8.06802L1.11773 5.40102H1.11719C2.78146 2.19228 6.13415 0 9.99894 0C12.4253 0 14.65 0.864285 16.3818 2.30216Z\" fill=\"#F14336\"/>\r\n              </svg>\r\n\r\n              Google\r\n            </Link>\r\n\r\n            <Link className=\"auth__btn\">\r\n              <svg width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\r\n                <path d=\"M18.1908 0H1.80916C0.81 0 0 0.81 0 1.80916V18.1908C0 19.19 0.81 20 1.80916 20H18.1908C19.19 20 20 19.19 20 18.1908V1.80916C20 0.81 19.19 0 18.1908 0ZM6.18885 17.2693C6.18885 17.5601 5.95314 17.7958 5.66236 17.7958H3.4212C3.13042 17.7958 2.89471 17.5601 2.89471 17.2693V7.8745C2.89471 7.58372 3.13042 7.34801 3.4212 7.34801H5.66236C5.95314 7.34801 6.18885 7.58372 6.18885 7.8745V17.2693ZM4.54178 6.46241C3.36592 6.46241 2.41267 5.50916 2.41267 4.3333C2.41267 3.15743 3.36592 2.20419 4.54178 2.20419C5.71764 2.20419 6.67089 3.15743 6.67089 4.3333C6.67089 5.50916 5.7177 6.46241 4.54178 6.46241ZM17.901 17.3117C17.901 17.5791 17.6843 17.7958 17.417 17.7958H15.012C14.7447 17.7958 14.528 17.5791 14.528 17.3117V12.905C14.528 12.2476 14.7208 10.0243 12.81 10.0243C11.3279 10.0243 11.0272 11.5461 10.9669 12.2291V17.3117C10.9669 17.5791 10.7502 17.7958 10.4828 17.7958H8.15681C7.88948 17.7958 7.67272 17.5791 7.67272 17.3117V7.83209C7.67272 7.56476 7.88948 7.34801 8.15681 7.34801H10.4828C10.7501 7.34801 10.9669 7.56476 10.9669 7.83209V8.65173C11.5164 7.82696 12.3332 7.19037 14.0722 7.19037C17.9231 7.19037 17.901 10.7881 17.901 12.7648V17.3117Z\" fill=\"#0077B7\"/>\r\n              </svg>\r\n\r\n              Linkedln\r\n            </Link>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default Login;","C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\pages\\ComingSoon.js",[],"C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\pages\\GraduateCoursePayment.js",["185"],"import { useState, useEffect, useContext } from \"react\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport { useFlutterwave, closePaymentModal } from \"flutterwave-react-v3\";\r\nimport { useParams } from \"react-router-dom\";\r\nimport { LoaderContext } from \"../context\";\r\n\r\nconst UndergraduateCoursePayment = () => {\r\n  const { id } = useParams();\r\n  const [payment, setPayment] = useState(true);\r\n  const [plan, setPlan] = useState(\"\");\r\n  const [amount, setAmount] = useState(150000);\r\n  const { setShow } = useContext(LoaderContext);\r\n  const [fetched, setFetched] = useState({\r\n    firstname: \"\",\r\n    lastname: \"\",\r\n    email: \"\",\r\n    tuition: \"\",\r\n    course: \"\",\r\n  });\r\n\r\n  useEffect(() => {\r\n    document.title = \"Payment - Grazac Academy\";\r\n    setShow(false);\r\n    fetch(`https://grazacacademy.com/graduate/registration/details/${id}`)\r\n      .then((resp) => resp.json())\r\n      .then((data) => {\r\n        setFetched(data.data);\r\n        setShow(true);\r\n        if (data.data.tx_ref.length) {\r\n          document.querySelector(\".form-info\").textContent =\r\n            \"You have completed your registration\";\r\n          setPayment(false);\r\n        }\r\n      })\r\n      .catch((_err) => {\r\n        document.querySelector(\".form-info\").textContent =\r\n          \"Something went wrong, refreshing...\";\r\n        window.location.reload();\r\n        document\r\n          .querySelector(\"#form-btn\")\r\n          .setAttribute(\"disabled\", \"disabled\");\r\n      });\r\n  }, [id]);\r\n\r\n  useEffect(\r\n    (_) => {\r\n      if (plan === \"full\") {\r\n        setAmount(150000);\r\n        setPayment(true);\r\n      } else if (plan === \"installment\") {\r\n        setAmount(40000);\r\n        setPayment(true);\r\n      } else if (plan === \"income-split\") {\r\n        setAmount(50000);\r\n        setPayment(true);\r\n      } else {\r\n        setPayment(false);\r\n      }\r\n    },\r\n    [plan]\r\n  );\r\n\r\n  const config = {\r\n    public_key: \"FLWPUBK-006bdc82ad878f1518af32f44af6478f-X\",\r\n    tx_ref: Date.now(),\r\n    amount: amount,\r\n    currency: \"NGN\",\r\n    payment_options: \"card,mobilemoney,ussd\",\r\n    customer: {\r\n      email: fetched.email,\r\n      phonenumber: fetched.phone,\r\n      name: fetched.firstname + \" \" + fetched.lastname,\r\n    },\r\n    customizations: {\r\n      title: \"Grazac Graduate Accelerator Plan\",\r\n      description: `Payment for ${fetched.course} at Grazac Graduate Accelerator Plan`,\r\n      logo: \"https://grazac.com.ng/assets/images/favicon.png\",\r\n    },\r\n  };\r\n\r\n  const handleFlutterPayment = useFlutterwave(config);\r\n\r\n  const onSubmit = () => {\r\n    if (payment) {\r\n      handleFlutterPayment({\r\n        callback: (response) => {\r\n          if (response.status === \"successful\") {\r\n            fetch(\"https://grazacacademy.com/graduate/registration/update\", {\r\n              method: \"POST\",\r\n              headers: {\r\n                \"Content-Type\": \"application/json\",\r\n              },\r\n              body: JSON.stringify({\r\n                firstname: fetched.firstname,\r\n                email: fetched.email,\r\n                course: fetched.course,\r\n                tx_ref: response.tx_ref,\r\n                id: id,\r\n                plan: plan,\r\n              }),\r\n            })\r\n              .then((resp) => resp.json())\r\n              .then((data) => {\r\n                if (data.success === true) {\r\n                  document.querySelector(\".form-info\").textContent =\r\n                    \"Your payment was successful.\";\r\n                }\r\n              });\r\n          }\r\n          closePaymentModal(); // this will close the modal programmatically\r\n        },\r\n        onClose: () => {},\r\n      });\r\n    } else {\r\n      alert(\"You have completed your registration\");\r\n    }\r\n  };\r\n\r\n  return (\r\n    <div>\r\n      <Navbar />\r\n      <div>\r\n        <div className=\"contact_layer\">\r\n          <div className=\"form_top\">\r\n            <div>\r\n              <h1>Payment</h1>\r\n            </div>\r\n          </div>\r\n          <div className=\"container\">\r\n            <div className=\"form\">\r\n              <div className=\"form-info\">Click on Pay Now to pay.</div>\r\n              <div className=\"form-flexdiv\">\r\n                <div className=\"form-flexdiv-1\">\r\n                  <label>\r\n                    First Name <span>*</span>\r\n                  </label>\r\n                  <input\r\n                    className=\"input\"\r\n                    type=\"text\"\r\n                    maxLength=\"30\"\r\n                    readOnly\r\n                    value={fetched.firstname}\r\n                    style={{ textTransform: \"capitalize\" }}\r\n                  />\r\n                </div>\r\n                <div className=\"form-flexdiv-2\">\r\n                  <label>\r\n                    Last Name <span>*</span>\r\n                  </label>\r\n                  <input\r\n                    className=\"input\"\r\n                    type=\"text\"\r\n                    maxLength=\"30\"\r\n                    readOnly\r\n                    value={fetched.lastname}\r\n                    style={{ textTransform: \"capitalize\" }}\r\n                  />\r\n                </div>\r\n              </div>\r\n              <div className=\"form-flexdiv\">\r\n                <div className=\"form-flexdiv-1\">\r\n                  <label>\r\n                    Mobile Number <span>*</span>\r\n                  </label>\r\n                  <input\r\n                    className=\"input\"\r\n                    type=\"text\"\r\n                    maxLength=\"11\"\r\n                    readOnly\r\n                    value={fetched.phone}\r\n                  />\r\n                </div>\r\n                <div className=\"form-flexdiv-2\">\r\n                  <label>\r\n                    Email <span>*</span>\r\n                  </label>\r\n                  <input\r\n                    className=\"input\"\r\n                    type=\"email\"\r\n                    maxLength=\"30\"\r\n                    readOnly\r\n                    value={fetched.email}\r\n                  />\r\n                </div>\r\n              </div>\r\n              <div>\r\n                <label>\r\n                  Kindly choose your preferred course <span>*</span>\r\n                </label>\r\n                <br />\r\n                <input\r\n                  className=\"input\"\r\n                  type=\"text\"\r\n                  readOnly\r\n                  value={fetched.course}\r\n                />\r\n              </div>\r\n              <div>\r\n                <label>Amount</label>\r\n                <br />\r\n                <p className=\"show-amount\">\r\n                  ₦{new Intl.NumberFormat().format(fetched.tuition)}\r\n                </p>\r\n              </div>\r\n\r\n              <div>\r\n                <label>Select payment plan</label>\r\n                <br />\r\n                <label style={{ marginRight: \"30px\" }}>\r\n                  <input\r\n                    type=\"radio\"\r\n                    className=\"radio-input\"\r\n                    id=\"full-time\"\r\n                    name=\"plan\"\r\n                    value=\"full\"\r\n                    checked={plan === \"full\"}\r\n                    onChange={(e) => setPlan(e.target.value)}\r\n                    style={{ marginRight: \"5px\" }}\r\n                  />{\" \"}\r\n                  Full (One-Off Payment)\r\n                </label>\r\n                <label>\r\n                  <input\r\n                    type=\"radio\"\r\n                    className=\"radio-input\"\r\n                    id=\"part-time\"\r\n                    name=\"plan\"\r\n                    value=\"installment\"\r\n                    checked={plan === \"installment\"}\r\n                    onChange={(e) => setPlan(e.target.value)}\r\n                  />{\" \"}\r\n                  ₦40,000 * 4 Installment Payment\r\n                </label>\r\n                <label>\r\n                  <input\r\n                    type=\"radio\"\r\n                    className=\"radio-input\"\r\n                    id=\"part-time\"\r\n                    name=\"plan\"\r\n                    value=\"income-split\"\r\n                    checked={plan === \"income-split\"}\r\n                    onChange={(e) => setPlan(e.target.value)}\r\n                  />{\" \"}\r\n                  ₦50,000 upfront + 15% Split Income\r\n                </label>\r\n              </div>\r\n\r\n              <div className=\"form-privacy\">\r\n                <a\r\n                  className=\"download-brochure\"\r\n                  onClick={onSubmit}\r\n                  id=\"form-btn\"\r\n                  href=\"#ed\"\r\n                >\r\n                  Pay Now\r\n                </a>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <Footer />\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default UndergraduateCoursePayment;\r\n","C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\components\\Loader.js",["186"],"import Modal from \"./Modal\";\r\nimport Logo from \"../images/svg/grazac-icon.svg\";\r\n\r\nconst Loader = () => {\r\n  return (\r\n    <div className=\"loading\">\r\n      <div className=\"loading_container\">\r\n        <div className=\"loading_box \">\r\n          <img src={Logo} className=\"lds-img\" alt=\"ccc\" />\r\n          <div className=\"lds-ring \">\r\n            <div></div>\r\n            <div></div>\r\n            <div></div>\r\n            <div></div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default Loader;\r\n","C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\pages\\Faq.js",[],"C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\pages\\InternshipForm.js",["187","188"],"import { useEffect, useRef, useState } from \"react\";\r\nimport { useFlutterwave, closePaymentModal } from 'flutterwave-react-v3';\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\n\r\nconst InternshipForm = () => {\r\n  const [firstname, setFirstName] = useState(\"\");\r\n  const [lastname, setLastName] = useState(\"\");\r\n  const [phone, setPhone] = useState(\"\");\r\n  const [email, setEmail] = useState(\"\");\r\n  const [availability, setAvailability] = useState(\"\");\r\n  const [amount, setAmount] = useState(40000);\r\n  const [course, setCourse] = useState(\"\");\r\n  const [message, setMessage] = useState(\"\");\r\n  const [fetchCourses, setFetched] = useState([]);\r\n  const formInfo = useRef();\r\n\r\n  useEffect(() => {\r\n    document.title = \"Internship Application - Grazac Academy\";\r\n    window.scrollTo(0, 0);\r\n    fetch(\"https://grazacacademy.com/graduate/courses\")\r\n      .then((resp) => resp.json())\r\n      .then((resp) => {\r\n        setFetched(resp.data);\r\n      })\r\n      .catch((error) => {\r\n        console.log(\r\n          \"An error occurred when fetching course details, refreshing...\"\r\n        );\r\n        window.location.reload();\r\n      });\r\n  }, []);\r\n\r\n  const config = {\r\n    public_key: 'FLWPUBK-006bdc82ad878f1518af32f44af6478f-X',\r\n    tx_ref: Date.now(),\r\n    amount: amount,\r\n    currency: 'NGN',\r\n    payment_options: 'card,mobilemoney,ussd',\r\n    customer: {\r\n      email: email,\r\n      phonenumber: phone,\r\n      name: firstname + \" \" + lastname,\r\n    },\r\n    customizations: {\r\n      title: 'Grazac Internship',\r\n      description: `Payment for ${course} at Grazac Internship`,\r\n      logo: 'https://grazac.com.ng/assets/images/favicon.png',\r\n    },\r\n  };\r\n\r\n  const handleFlutterPayment = useFlutterwave(config);\r\n\r\n  const onSubmit = (e) => {\r\n    e.preventDefault();\r\n    if ( availability === \"1\" ) {\r\n      var elmnt = document.getElementById(\"form_top\");\r\n      elmnt.scrollIntoView();\r\n      //window.scroll(0, formInfo.current.offsetTop);\r\n      handleFlutterPayment({\r\n        callback: (response) => {\r\n            if (response.status === 'successful') {\r\n\r\n              document.querySelector(\".form-info\").textContent = \"Submitting, please wait...\";\r\n              document\r\n                .querySelector(\"#submit-btn\")\r\n                .setAttribute(\"disabled\", \"disabled\");\r\n              fetch(\"https://grazacacademy.com/undergraduate/intern\", {\r\n                method: \"POST\",\r\n                headers: {\r\n                  \"Content-Type\": \"application/json\",\r\n                },\r\n                body: JSON.stringify({\r\n                  firstname: firstname,\r\n                  lastname: lastname,\r\n                  email: email,\r\n                  phone: phone,\r\n                  course: course,\r\n                  expectation: message,\r\n                  transaction_id: response.transaction_id\r\n                })\r\n              })\r\n              .then((resp) => resp.json())\r\n              .then((data) => {\r\n                if (data.success === true) {\r\n                  document.querySelector(\".form-info\").textContent = \"Your registration was successful, kindly check your mailbox for further details\";\r\n                  document.querySelector(\"#submit-btn\").removeAttribute(\"disabled\");\r\n                  setFirstName(\"\");\r\n                  setLastName(\"\");\r\n                  setMessage(\"\");\r\n                  setPhone(\"\");\r\n                  setEmail(\"\");\r\n                  setCourse(\"\");\r\n                } else {\r\n                  document.querySelector(\".form-info\").textContent = data.msg;\r\n                  document.querySelector(\"#submit-btn\").removeAttribute(\"disabled\");\r\n                }\r\n              })\r\n              .catch((err) => {\r\n                document.querySelector(\".form-info\").textContent = `Your payment was successful but something wrong while saving your details. \r\n                Kindly mail us at hello@grazacacademy.com`;\r\n                document.querySelector(\"#submit-btn\").removeAttribute(\"disabled\");\r\n              })\r\n\r\n            };\r\n            closePaymentModal() // this will close the modal programmatically\r\n        },\r\n        onClose: () => {\r\n\r\n        },\r\n      });\r\n    } else {\r\n      alert(\"You have to be available to register\");\r\n    }\r\n  };\r\n\r\n  return (\r\n    <div>\r\n      <Navbar />\r\n      <div>\r\n        <div className=\"contact_layer\">\r\n          <div className=\"form_top\" id=\"form_top\">\r\n            <div>\r\n              <h1>Grazac Internships.</h1>\r\n              <p>\r\n                We are bridging the gap between unemployment and entry-level\r\n                jobs in the technology industry.\r\n              </p>\r\n            </div>\r\n          </div>\r\n          <div className=\"container\" ref={formInfo}>\r\n            <div className=\"form\">\r\n              <form onSubmit={onSubmit}>\r\n                <div className=\"form-info\">\r\n                  Note: Fields with <span>*</span> are required\r\n                </div>\r\n                <div className=\"form-flexdiv\">\r\n                  <div className=\"form-flexdiv-1\">\r\n                    <label>\r\n                      First Name <span>*</span>\r\n                    </label>\r\n                    <input\r\n                      className=\"input\"\r\n                      type=\"text\"\r\n                      placeholder=\"ex. John\"\r\n                      value={firstname}\r\n                      onChange={(e) => setFirstName(e.target.value)}\r\n                      required=\"required\"\r\n                    />\r\n                  </div>\r\n                  <div className=\"form-flexdiv-2\">\r\n                    <label>\r\n                      Last Name <span>*</span>\r\n                    </label>\r\n                    <input\r\n                      className=\"input\"\r\n                      type=\"text\"\r\n                      placeholder=\"ex. Doe\"\r\n                      value={lastname}\r\n                      onChange={(e) => setLastName(e.target.value)}\r\n                      required=\"required\"\r\n                    />\r\n                  </div>\r\n                </div>\r\n                <div className=\"form-flexdiv\">\r\n                  <div className=\"form-flexdiv-1\">\r\n                    <label>\r\n                      Mobile Number <span>*</span>\r\n                    </label>\r\n                    <input\r\n                      className=\"input\"\r\n                      type=\"text\"\r\n                      placeholder=\"ex. 08133333333\"\r\n                      value={phone}\r\n                      onChange={(e) => setPhone(e.target.value)}\r\n                      required=\"required\"\r\n                      pattern=\".{11}\"\r\n                      title=\"Phone number is invalid\"\r\n                    />\r\n                  </div>\r\n                  <div className=\"form-flexdiv-2\">\r\n                    <label>\r\n                      Email <span>*</span>\r\n                    </label>\r\n                    <input\r\n                      className=\"input\"\r\n                      type=\"email\"\r\n                      placeholder=\"ex. john@example.com\"\r\n                      value={email}\r\n                      onChange={(e) => setEmail(e.target.value)}\r\n                      required=\"required\"\r\n                    />\r\n                  </div>\r\n                </div>\r\n                <div>\r\n                  <label>\r\n                    Our classes will be on Tuesdays and Thursdays, will you be\r\n                    available? <span>*</span>\r\n                  </label>\r\n                  <br />\r\n                  <label>\r\n                    <input\r\n                      type=\"radio\"\r\n                      className=\"radio-input\"\r\n                      id=\"yes\"\r\n                      name=\"availability\"\r\n                      value=\"1\"\r\n                      required=\"required\"\r\n                      checked={availability === \"1\"}\r\n                      onChange={(e) => setAvailability(e.target.value)}\r\n                    />\r\n                    Yes\r\n                  </label>\r\n                  <label>\r\n                    <input\r\n                      type=\"radio\"\r\n                      className=\"radio-input\"\r\n                      id=\"no\"\r\n                      name=\"availability\"\r\n                      value=\"0\"\r\n                      required=\"required\"\r\n                      checked={availability === \"0\"}\r\n                      onChange={(e) => setAvailability(e.target.value)}\r\n                      style={{ marginLeft: \"30px\" }}\r\n                    />\r\n                    No\r\n                  </label>\r\n                </div>\r\n                <div>\r\n                  <label>Course</label>\r\n                  <br />\r\n                  <p className=\"show-amount\">\r\n                    Website Development\r\n                  </p>\r\n                </div>\r\n                <div>\r\n                  <label>Amount</label>\r\n                  <br />\r\n                  <p className=\"show-amount\">\r\n                    ₦{new Intl.NumberFormat().format(amount)}\r\n                  </p>\r\n                </div>\r\n\r\n                <div>\r\n                  <label>\r\n                    What do you expect at the end of this training?{\" \"}\r\n                    <span>*</span>\r\n                  </label>\r\n                  <textarea\r\n                    type=\"text\"\r\n                    placeholder=\"Say something ...\"\r\n                    value={message}\r\n                    onChange={(e) => setMessage(e.target.value)}\r\n                    required=\"required\"\r\n                  />\r\n                </div>\r\n                <div className=\"form-privacy\">\r\n                  <button\r\n                    className=\"download-brochure\"\r\n                    type=\"submit\"\r\n                    id=\"submit-btn\"\r\n                  >\r\n                    Register\r\n                  </button>\r\n                </div>\r\n              </form>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <Footer />\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default InternshipForm;\r\n","C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\pages\\Contact.js",["189","190"],"import React, { useState, useEffect } from \"react\";\r\nimport axios from 'axios';\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport PrimaryBtn from \"../components/PrimaryBtn\";\r\n\r\nimport Facebook from \"../images/svg/facebook.svg\";\r\nimport Instagram from \"../images/svg/instagram.svg\";\r\nimport Twitter from \"../images/svg/twitter.svg\";\r\nimport Youtube from \"../images/svg/youtube.svg\";\r\n\r\nconst Contact = () => {\r\n\r\n    const [ name, setName ] = useState('');\r\n    const [ email, setEmail ] = useState('');\r\n    const [ subject, setSubject ] = useState('');\r\n    const [ message, setMessage ] = useState('');\r\n\r\n    useEffect(() => {\r\n        document.title = 'Contact - Grazac Academy';\r\n        window.scrollTo(0,0);\r\n    }, []);\r\n\r\n    const handleSubmit = () => {\r\n        if(name.length && email.length && subject.length && message.length) {\r\n            const btn = document.querySelector('#submit');\r\n            btn.setAttribute('disabled', '');\r\n            btn.textContent = 'Submitting...';\r\n            console.log('Submitted')\r\n            axios.post('http://grazacacademy.com/contact/create', {\r\n                name: name,\r\n                email: email,\r\n                subject: subject,\r\n                message: message\r\n            })\r\n            .then(resp => resp.data)\r\n            .then(response => {\r\n                if(response.success === true) {\r\n                    btn.removeAttribute('disabled');\r\n                    btn.textContent = 'Submit';\r\n                    alert(response.msg);\r\n                    setName(''); setEmail(''); setSubject(''); setMessage('');\r\n                } else {\r\n\r\n                }\r\n            })\r\n            .catch((err) => {\r\n                \r\n            });\r\n        } else {\r\n            alert('Invalid input');\r\n        }\r\n    }\r\n\r\n    return(\r\n        <div>\r\n            <Navbar/>\r\n            <div className=\"contact\">\r\n                <div className=\"contact_layer\">\r\n                    <div className=\"container\">\r\n                        <div className=\"contact_layer-text\">\r\n                            <h1>Get In Touch</h1>\r\n                            <p>We want to hear from you. Let us know how we can help</p>\r\n                        </div>\r\n                        {/*<div classname=\"contact_layer-circles\">\r\n                            <img src={kamala} alt=\"kamala\"  classname=\"contact_layer-circles-1\" />\r\n                            <img src={kamala} alt=\"kamala\"  classname=\"contact_layer-circles-2\" />\r\n                            <img src={kamala} alt=\"kamala\"  classname=\"contact_layer-circles-3\" />\r\n                            <img src={kamala} alt=\"kamala\"  classname=\"contact_layer-circles-4\" />\r\n                        </div>*/}\r\n                        <div className=\"contact_hero\">\r\n                            <div className=\"contact_hero-flexdiv\">\r\n                                <div className=\"contact_hero-flexdiv-1\" >\r\n                                    <label>Full Name  <span>*</span></label>\r\n                                    <input type=\"text\" placeholder=\"ex. John Doe\" value={name} onChange={e => setName(e.target.value)} />\r\n                                </div>\r\n                                <div className=\"contact_hero-flexdiv-2\">\r\n                                    <label>Email  <span>*</span></label>\r\n                                    <input type=\"text\" placeholder=\"ex. john@gmail.com\" value={email} onChange={e => setEmail(e.target.value)}  />\r\n                                </div>\r\n                            </div>\r\n                            <div>\r\n                                <label>Subject  <span>*</span></label>\r\n                                <input  type=\"text\" placeholder=\"ex. John Doe\" value={subject} onChange={e => setSubject(e.target.value)}  />\r\n                            </div>\r\n                            <div>\r\n                                <label>Message  <span>*</span></label>\r\n                                <textarea  type=\"text\" placeholder=\"Describe your task for us\" value={message} onChange={e => setMessage(e.target.value)}  />\r\n                            </div>\r\n                            <div className=\"contact_hero-privacy\" >\r\n                                <p>By submitting this form your consent to us emailing you occasionally about our products and services. You can unsubscribe from emails at any time, and we will never pass your email onto third parties. <span>Privacy Policy</span></p>\r\n                                <button id=\"submit\" onClick={handleSubmit}>Submit</button>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"container\">\r\n                    <div className=\"contact_campus\">\r\n                        <div className=\"contact_campus-intro\">\r\n                            <h2>Campus Inquiries</h2>\r\n                            <p>Connect with Us</p>\r\n                        </div>\r\n                        <div className=\"contact_campus-main\">\r\n                            <div className=\"contact_campus-main-div boxes33\">\r\n                                <h3>Office</h3>\r\n                                <p>PROHUB, Salawu Olabode Avenue, Ewang Road, </p>\r\n                                <p>Idi-aba, 110124, Abeokuta</p>\r\n                                <p>+234 806 836 5951</p>\r\n                            </div>\r\n                            <div className=\"contact_campus-main-div boxes33\">\r\n                                <h3>Book A Call</h3>\r\n                                <p>We are here to help with any questions. </p>\r\n                                <p>Talk to our programme leads.</p>\r\n                                <div style={{display:'flex'}}>\r\n                                    <a href=\"tel:+2348068365951\" ><div className=\"nav__btn--text\">Book a Call</div></a>\r\n                                </div>\r\n                            </div>\r\n                            <div className=\"contact_campus-main-div boxes33\">\r\n                                <h3>Social Media</h3>\r\n                                <div className=\"social\">\r\n                                    <img src={Facebook} alt=\"social\"/>\r\n                                </div>\r\n                                <div className=\"social\">\r\n                                    <img src={Twitter} alt=\"social\"/>\r\n                                </div>\r\n                                <div className=\"social\">\r\n                                    <img src={Youtube} alt=\"social\"/>\r\n                                </div>\r\n                                <div className=\"social\">\r\n                                    <img src={Instagram} alt=\"social\"/>\r\n                                </div>\r\n                            </div>\r\n\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div>\r\n                    <iframe src=\"https://www.google.com/maps/d/embed?mid=16NZ9a9VhKkk2-5nnYEdL93mxq7kjDZLT\" width=\"100%\" height=\"600\"></iframe>\r\n                </div>\r\n                {/*<extracomponent/> a component used in the landing page comes here*/}\r\n            </div>\r\n            <Footer/>\r\n        </div>\r\n    );\r\n}\r\n\r\nexport default Contact;","C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\auth\\Signup.js",["191","192","193","194","195","196","197","198","199","200","201","202","203"],"import { useState } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { cn } from \"../utils\";\r\nimport PrimaryBtn from \"../components/PrimaryBtn\";\r\nimport Grazac from \"../images/grazac.png\";\r\n\r\nconst validEmailRegex = RegExp(\r\n  /^(([^<>()\\[\\]\\.,;:\\s@\\\"]+(\\.[^<>()\\[\\]\\.,;:\\s@\\\"]+)*)|(\\\".+\\\"))@(([^<>()[\\]\\.,;:\\s@\\\"]+\\.)+[^<>()[\\]\\.,;:\\s@\\\"]{2,})$/i\r\n);\r\n\r\nconst Signup = () => {\r\n  const [email, setEmail] = useState(\"\");\r\n  const [password, setPassword] = useState(\"\");\r\n  const [emailErr, setEmailErr] =  useState(\"\");\r\n  const [phone, setPhone] = useState(\"\");\r\n  const [gender, setGender] = useState(\"\");\r\n\r\n  \r\n  const handleEmailChange = e => {\r\n    e.preventDefault();\r\n    setEmail(e.target.value)\r\n\r\n    if (!email) setEmailErr(\"\");\r\n    let err = validEmailRegex.test(e.target.value) ? \"\" : \"please enter a valid email address\";\r\n    setEmailErr(err);\r\n  }\r\n\r\n  const handlePasswordChange = e => {\r\n    e.preventDefault();\r\n    setPassword(e.target.value)\r\n  }\r\n\r\n  return(\r\n    <div className=\"auth\">\r\n      <div className=\"auth__body\">\r\n        <div className=\"auth__hero\">\r\n          <img src={Grazac} alt=\"grazac\" />\r\n        </div>\r\n\r\n        <div className=\"auth__form\">\r\n          <div className=\"auth__form--container\">\r\n            <h1>Create Account</h1>\r\n\r\n            <form className=\"form\">\r\n              <div className=\"form__group\">\r\n                <label for=\"email\">Email address</label>\r\n                <input type=\"email\" id=\"email\" value={email} onChange={handleEmailChange} className={cn(\"form__input\", {\"form__input--err\": emailErr})}/>\r\n              </div>\r\n\r\n              <div className=\"form__group--half\">\r\n                <div className=\"form__group\">\r\n                  <label for=\"phone\">Phone </label>\r\n                  <input type=\"email\" id=\"email\" value={phone} onChange={e => setPhone(e.target.value)} className={cn(\"form__input\")}/>\r\n                </div>\r\n\r\n                <div className=\"form__group\">\r\n                  <label for=\"gender\">Gender</label>\r\n                    <select id=\"cars\" className=\"form__input\" onChange={e => setGender(e.target.value)}>\r\n                      <option value=\"\">Select gender</option>\r\n                      <option value=\"male\">Male</option>\r\n                      <option value=\"female\">Female</option>\r\n                      <option value=\"\">I'm not sure</option>\r\n                    </select>\r\n                </div>\r\n              </div>\r\n\r\n              <div className=\"form__group\">\r\n                <label for=\"pass\">Password</label>\r\n                <input type=\"password\" id=\"pass\" value={password} onChange={handlePasswordChange} className=\"form__input\"/>\r\n              </div>\r\n\r\n              <Link className=\"form__link\">Forgot password?</Link>\r\n\r\n              <button type=\"submit\" className=\"form__btn\">\r\n                <PrimaryBtn>Create Account</PrimaryBtn>\r\n              </button>\r\n            </form>\r\n\r\n            <div className=\"auth__line\">\r\n              <div>&nbsp;</div>\r\n              <span>or</span>\r\n              <div>&nbsp;</div>\r\n            </div>\r\n          </div>\r\n\r\n          <div className=\"auth__btns\">\r\n            <Link className=\"auth__btn\">\r\n              <svg width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\r\n                <path d=\"M4.43236 12.0862L3.7362 14.6851L1.19174 14.7389C0.431322 13.3285 0 11.7148 0 9.99997C0 8.34175 0.403276 6.77802 1.11811 5.40112H1.11866L3.38394 5.81643L4.37627 8.06812C4.16858 8.67362 4.05537 9.32361 4.05537 9.99997C4.05545 10.734 4.18842 11.4373 4.43236 12.0862Z\" fill=\"#FBBB00\"/>\r\n                <path d=\"M19.824 8.1322C19.9389 8.73712 19.9988 9.36183 19.9988 10.0003C19.9988 10.7162 19.9235 11.4146 19.7801 12.0882C19.2933 14.3805 18.0213 16.3821 16.2593 17.7986L16.2587 17.798L13.4055 17.6524L13.0017 15.1316C14.1709 14.4459 15.0846 13.3728 15.5659 12.0882H10.2188V8.1322H15.644H19.824Z\" fill=\"#518EF8\"/>\r\n                <path d=\"M16.2593 17.798L16.2599 17.7985C14.5462 19.176 12.3693 20.0002 9.99953 20.0002C6.19134 20.0002 2.88041 17.8716 1.19141 14.7392L4.43203 12.0865C5.27651 14.3403 7.45066 15.9447 9.99953 15.9447C11.0951 15.9447 12.1215 15.6486 13.0022 15.1315L16.2593 17.798Z\" fill=\"#28B446\"/>\r\n                <path d=\"M16.3818 2.30216L13.1423 4.95431C12.2308 4.38455 11.1533 4.05541 9.99894 4.05541C7.39237 4.05541 5.17756 5.7334 4.37538 8.06802L1.11773 5.40102H1.11719C2.78146 2.19228 6.13415 0 9.99894 0C12.4253 0 14.65 0.864285 16.3818 2.30216Z\" fill=\"#F14336\"/>\r\n              </svg>\r\n\r\n              Google\r\n            </Link>\r\n\r\n            <Link className=\"auth__btn\">\r\n              <svg width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\r\n                <path d=\"M18.1908 0H1.80916C0.81 0 0 0.81 0 1.80916V18.1908C0 19.19 0.81 20 1.80916 20H18.1908C19.19 20 20 19.19 20 18.1908V1.80916C20 0.81 19.19 0 18.1908 0ZM6.18885 17.2693C6.18885 17.5601 5.95314 17.7958 5.66236 17.7958H3.4212C3.13042 17.7958 2.89471 17.5601 2.89471 17.2693V7.8745C2.89471 7.58372 3.13042 7.34801 3.4212 7.34801H5.66236C5.95314 7.34801 6.18885 7.58372 6.18885 7.8745V17.2693ZM4.54178 6.46241C3.36592 6.46241 2.41267 5.50916 2.41267 4.3333C2.41267 3.15743 3.36592 2.20419 4.54178 2.20419C5.71764 2.20419 6.67089 3.15743 6.67089 4.3333C6.67089 5.50916 5.7177 6.46241 4.54178 6.46241ZM17.901 17.3117C17.901 17.5791 17.6843 17.7958 17.417 17.7958H15.012C14.7447 17.7958 14.528 17.5791 14.528 17.3117V12.905C14.528 12.2476 14.7208 10.0243 12.81 10.0243C11.3279 10.0243 11.0272 11.5461 10.9669 12.2291V17.3117C10.9669 17.5791 10.7502 17.7958 10.4828 17.7958H8.15681C7.88948 17.7958 7.67272 17.5791 7.67272 17.3117V7.83209C7.67272 7.56476 7.88948 7.34801 8.15681 7.34801H10.4828C10.7501 7.34801 10.9669 7.56476 10.9669 7.83209V8.65173C11.5164 7.82696 12.3332 7.19037 14.0722 7.19037C17.9231 7.19037 17.901 10.7881 17.901 12.7648V17.3117Z\" fill=\"#0077B7\"/>\r\n              </svg>\r\n\r\n              Linkedln\r\n            </Link>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default Signup;","C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\pages\\AboutUs.js",["204"],"import { useEffect, useContext } from \"react\";\r\n// import { Link } from \"react-router-dom\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport Mode from \"../components/Mode\";\r\nimport Dots from \"../images/svg/dots.svg\";\r\nimport { LoaderContext } from \"../context\";\r\nconst cardsInfo = [\r\n  {\r\n    color: \"39,234,198\",\r\n    title: \"Creativity\",\r\n    body:\r\n      \"We constantly develop ideas that drives innovation. Our company is a community that allow us share common interests and ideas.\",\r\n  },\r\n  {\r\n    color: \"26,222,235\",\r\n    title: \"Quality\",\r\n    body:\r\n      \"We strive to provide value that fulfils and exceeds expectation. We have an unwavering guide that leads the way to fulfilling your goal.\",\r\n  },\r\n  {\r\n    color: \"108,21,250\",\r\n    title: \"Passion\",\r\n    body:\r\n      \"Our enthusiasm to deliver the best makes us unique. We uphold the highest standards in deliverability.\",\r\n  },\r\n  {\r\n    color: \"255,113,155\",\r\n    title: \"Commitment\",\r\n    body:\r\n      \"We are focused on giving best solutions. Our concern is solving your problem rather than why or how the problem was created.\",\r\n  },\r\n  {\r\n    color: \"254,125,108\",\r\n    title: \"Collaboration\",\r\n    body:\r\n      \"Our success depends upon the collective intelligence of our team members and the shared vision of our partners.\",\r\n  },\r\n  {\r\n    color: \"255,180,67\",\r\n    title: \"Teamwork\",\r\n    body:\r\n      \"We do better, together. Our environment fosters progress, effectiveness and speed.\",\r\n  },\r\n];\r\n\r\nconst AboutUs = () => {\r\n  const { setShow } = useContext(LoaderContext);\r\n  useEffect(() => {\r\n    document.title = \"About - Grazac Academy\";\r\n    window.scrollTo(0, 0);\r\n   \r\n  }, []);\r\n\r\n  return (\r\n    <div className=\"about\">\r\n      <Navbar />\r\n      <div className=\"about__top\">\r\n        <div className=\"about__top--container\">\r\n          <div className=\"about__top--up\">\r\n            <div>\r\n              <img src={Dots} alt=\"dots\" />\r\n            </div>\r\n            <div></div>\r\n            <div className=\"about__top--text\">\r\n              <h1>About Us</h1>\r\n              <p>\r\n                At Grazac Academy, we provide you with the right platform to\r\n                upskill yourself for the future.\r\n              </p>\r\n            </div>\r\n          </div>\r\n          <div className=\"about__top--down\">\r\n            <div></div>\r\n            <div></div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <div className=\"about__middle\">\r\n        <div className=\"about__middle--container\">\r\n          <div className=\"about__middle--head\">\r\n            <h2>Our Core Values</h2>\r\n            <p>\r\n              You determine the starting points, we provide the best possible\r\n              interception to achieve the goals.\r\n            </p>\r\n          </div>\r\n\r\n          <div className=\"about__middle--cards\">\r\n            {cardsInfo.map((item) => (\r\n              <div className=\"about__middle--card\">\r\n                <div style={{ \"--bg-color\": item.color }}></div>\r\n                <h3>{item.title}</h3>\r\n                <p>{item.body}</p>\r\n              </div>\r\n            ))}\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <Mode />\r\n      <Footer />\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default AboutUs;\r\n","C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\pages\\GraduateCourseDetail.js",["205","206","207"],"C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\pages\\GraduateForm.js",[],"C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\pages\\GraduateAccelerator.js",["208"],"C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\pages\\UndergraduateForm.js",[],"C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\components\\PrimaryBtn.js",[],"C:\\Users\\USER\\Desktop\\Web Development\\Github\\grazac-academy-web\\src\\components\\Mode.js",["209","210","211","212","213","214"],"import Kamala from \"../images/kamala.jpg\";\r\nimport lady from \"../images/Grazac-website/IMG_8440.JPG\";\r\nimport PrimaryBtn from \"../components/PrimaryBtn\";\r\n\r\nconst Linkedn = () => (\r\n  <a>\r\n    <svg width=\"15\" height=\"15\" viewBox=\"0 0 15 15\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\r\n      <path d=\"M13.6431 0H1.35687C0.6075 0 0 0.6075 0 1.35687V13.6431C0 14.3925 0.6075 15 1.35687 15H13.6431C14.3925 15 15 14.3925 15 13.6431V1.35687C15 0.6075 14.3925 0 13.6431 0ZM4.64164 12.952C4.64164 13.1701 4.46486 13.3469 4.24677 13.3469H2.5659C2.34781 13.3469 2.17103 13.1701 2.17103 12.952V5.90588C2.17103 5.68779 2.34781 5.51101 2.5659 5.51101H4.24677C4.46486 5.51101 4.64164 5.68779 4.64164 5.90588V12.952ZM3.40634 4.84681C2.52444 4.84681 1.8095 4.13187 1.8095 3.24997C1.8095 2.36808 2.52444 1.65314 3.40634 1.65314C4.28823 1.65314 5.00317 2.36808 5.00317 3.24997C5.00317 4.13187 4.28827 4.84681 3.40634 4.84681ZM13.4258 12.9838C13.4258 13.1843 13.2632 13.3469 13.0627 13.3469H11.259C11.0585 13.3469 10.896 13.1843 10.896 12.9838V9.67877C10.896 9.18573 11.0406 7.51826 9.6075 7.51826C8.49589 7.51826 8.27042 8.65959 8.22514 9.17179V12.9838C8.22514 13.1843 8.06262 13.3469 7.86208 13.3469H6.1176C5.91711 13.3469 5.75454 13.1843 5.75454 12.9838V