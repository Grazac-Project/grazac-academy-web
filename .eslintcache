eight=\"24\">\r\n                                        <path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M22.4999 12.5001C22.4999 11.8113 21.9399 11.2501 21.2499 11.2501C20.5599 11.2501 20 11.8113 20 12.5001C20 13.1888 20.5599 13.7501 21.2499 13.7501C21.9399 13.7501 22.4999 13.1888 22.4999 12.5001ZM25.0001 12.5002C25.0001 14.5677 23.3176 16.2502 21.2501 16.2502C19.1826 16.2502 17.5001 14.5677 17.5001 12.5002C17.5001 10.4327 19.1826 8.75022 21.2501 8.75022C23.3176 8.75022 25.0001 10.4327 25.0001 12.5002ZM13.7499 8.74985C13.7499 7.3711 12.6286 6.24985 11.2499 6.24985C9.87111 6.24985 8.74986 7.3711 8.74986 8.74985C8.74986 10.1286 9.87111 11.2498 11.2499 11.2498C12.6286 11.2498 13.7499 10.1286 13.7499 8.74985ZM16.25 8.75C16.25 11.5075 14.0075 13.75 11.25 13.75C8.49253 13.75 6.25003 11.5075 6.25003 8.75C6.25003 5.9925 8.49253 3.75 11.25 3.75C14.0075 3.75 16.25 5.9925 16.25 8.75ZM17.425 18.8078C18.5112 17.9678 19.8487 17.5003 21.25 17.5003C24.6962 17.5003 27.5 20.304 27.5 23.7503C27.5 24.4403 26.9412 25.0003 26.25 25.0003C25.5587 25.0003 25 24.4403 25 23.7503C25 21.6828 23.3175 20.0003 21.25 20.0003C20.3962 20.0003 19.585 20.2928 18.93 20.8115C19.61 22.0565 20 23.484 20 25.0003C20 25.6903 19.4412 26.2503 18.75 26.2503C18.0587 26.2503 17.5 25.6903 17.5 25.0003C17.5 21.554 14.6962 18.7503 11.25 18.7503C7.80375 18.7503 5 21.554 5 25.0003C5 25.6903 4.44125 26.2503 3.75 26.2503C3.05875 26.2503 2.5 25.6903 2.5 25.0003C2.5 20.1753 6.42625 16.2503 11.25 16.2503C13.6587 16.2503 15.8412 17.229 17.425 18.8078Z\" fill=\"white\"/>\r\n                                        </mask>\r\n                                        <g mask=\"url(#mask0)\">\r\n                                        <rect width=\"30\" height=\"30\" fill=\"#773DD3\"/>\r\n                                        </g>\r\n                                    </svg>\r\n                                </div>\r\n                                    <h3>Expert Instructors</h3>\r\n                                    