[{"C:\\Users\\Iyo\\Documents\\grazac academy\\grazac-academy-web\\src\\index.js":"1","C:\\Users\\Iyo\\Documents\\grazac academy\\grazac-academy-web\\src\\App.js":"2","C:\\Users\\Iyo\\Documents\\grazac academy\\grazac-academy-web\\src\\reportWebVitals.js":"3","C:\\Users\\Iyo\\Documents\\grazac academy\\grazac-academy-web\\src\\pages\\GraduateCourseDetail.js":"4","C:\\Users\\Iyo\\Documents\\grazac academy\\grazac-academy-web\\src\\pages\\Landing.js":"5","C:\\Users\\Iyo\\Documents\\grazac academy\\grazac-academy-web\\src\\pages\\UndergraduateCourseDetail.js":"6","C:\\Users\\Iyo\\Documents\\grazac academy\\grazac-academy-web\\src\\pages\\GraduateAccelerator.js":"7","C:\\Users\\Iyo\\Documents\\grazac academy\\grazac-academy-web\\src\\pages\\Contact.js":"8","C:\\Users\\Iyo\\Documents\\grazac academy\\grazac-academy-web\\src\\pages\\AboutUs.js":"9","C:\\Users\\Iyo\\Documents\\grazac academy\\grazac-academy-web\\src\\pages\\UndergraduateAccelerator.js":"10","C:\\Users\\Iyo\\Documents\\grazac academy\\grazac-academy-web\\src\\pages\\UndergraduateCoursePayment.js":"11","C:\\Users\\Iyo\\Documents\\grazac academy\\grazac-academy-web\\src\\pages\\GraduateCoursePayment.js":"12","C:\\Users\\Iyo\\Documents\\grazac academy\\grazac-academy-web\\src\\pages\\LeadForm.js":"13","C:\\Users\\Iyo\\Documents\\grazac academy\\grazac-academy-web\\src\\pages\\Faq.js":"14","C:\\Users\\Iyo\\Documents\\grazac academy\\grazac-academy-web\\src\\pages\\GraduateForm.js":"15","C:\\Users\\Iyo\\Documents\\grazac academy\\grazac-academy-web\\src\\pages\\UndergraduateForm.js":"16","C:\\Users\\Iyo\\Documents\\grazac academy\\grazac-academy-web\\src\\pages\\ComingSoon.js":"17","C:\\Users\\Iyo\\Documents\\grazac academy\\grazac-academy-web\\src\\pages\\InternshipForm.js":"18","C:\\Users\\Iyo\\Documents\\grazac academy\\grazac-academy-web\\src\\components\\Loader.js":"19","C:\\Users\\Iyo\\Documents\\grazac academy\\grazac-academy-web\\src\\auth\\Login.js":"20","C:\\Users\\Iyo\\Documents\\grazac academy\\grazac-academy-web\\src\\auth\\Signup.js":"21","C:\\Users\\Iyo\\Documents\\grazac academy\\grazac-academy-web\\src\\components\\Navbar.js":"22","C:\\Users\\Iyo\\Documents\\grazac academy\\grazac-academy-web\\src\\components\\Footer.js":"23","C:\\Users\\Iyo\\Documents\\grazac academy\\grazac-academy-web\\src\\components\\PrimaryBtn.js":"24","C:\\Users\\Iyo\\Documents\\grazac academy\\grazac-academy-web\\src\\components\\MOT.js":"25","C:\\Users\\Iyo\\Documents\\grazac academy\\grazac-academy-web\\src\\components\\Mode.js":"26","C:\\Users\\Iyo\\Documents\\grazac academy\\grazac-academy-web\\src\\components\\Qualities.js":"27","C:\\Users\\Iyo\\Documents\\grazac academy\\grazac-academy-web\\src\\components\\NeedAdvice.js":"28","C:\\Users\\Iyo\\Documents\\grazac academy\\grazac-academy-web\\src\\components\\Modal.js":"29","C:\\Users\\Iyo\\Documents\\grazac academy\\grazac-academy-web\\src\\utils.js":"30","C:\\Users\\Iyo\\Documents\\grazac academy\\grazac-academy-web\\src\\components\\SchoolList.js":"31","C:\\Users\\Iyo\\Documents\\grazac academy\\grazac-academy-web\\src\\components\\InfoModal.js":"32","C:\\Users\\Iyo\\Documents\\grazac academy\\grazac-academy-web\\src\\components\\NavItem.js":"33","C:\\Users\\Iyo\\Documents\\grazac academy\\grazac-academy-web\\src\\context.js":"34"},{"size":558,"mtime":1625148715791,"results":"35","hashOfConfig":"36"},{"size":2588,"mtime":1625150099371,"results":"37","hashOfConfig":"36"},{"size":375,"mtime":1625148715806,"results":"38","hashOfConfig":"36"},{"size":7814,"mtime":1625148715799,"results":"39","hashOfConfig":"36"},{"size":22018,"mtime":1625150099374,"results":"40","hashOfConfig":"36"},{"size":6899,"mtime":1625148715804,"results":"41","hashOfConfig":"36"},{"size":17939,"mtime":1625148715799,"results":"42","hashOfConfig":"36"},{"size":7330,"mtime":1625148715797,"results":"43","hashOfConfig":"36"},{"size":3152,"mtime":1625148715795,"results":"44","hashOfConfig":"36"},{"size":7794,"mtime":1625148715804,"results":"45","hashOfConfig":"36"},{"size":5836,"mtime":1625148715805,"results":"46","hashOfConfig":"36"},{"size":7814,"mtime":1625148715800,"results":"47","hashOfConfig":"36"},{"size":678,"mtime":1625148715803,"results":"48","hashOfConfig":"36"},{"size":34164,"mtime":1625148715798,"results":"49","hashOfConfig":"36"},{"size":12388,"mtime":1625148715801,"results":"50","hashOfConfig":"36"},{"size":10870,"mtime":1625148715806,"results":"51","hashOfConfig":"36"},{"size":2845,"mtime":1625148715796,"results":"52","hashOfConfig":"36"},{"size":9990,"mtime":1625148715801,"results":"53","hashOfConfig":"36"},{"size":490,"mtime":1625148715205,"results":"54","hashOfConfig":"36"},{"size":5135,"mtime":1625148715201,"results":"55","hashOfConfig":"36"},{"size":6088,"mtime":1625148715202,"results":"56","hashOfConfig":"36"},{"size":5152,"mtime":1625148715233,"results":"57","hashOfConfig":"36"},{"size":2822,"mtime":1625148715203,"results":"58","hashOfConfig":"36"},{"size":399,"mtime":1625148715283,"results":"59","hashOfConfig":"36"},{"size":3854,"mtime":1625148715206,"results":"60","hashOfConfig":"36"},{"size":5089,"mtime":1625148715230,"results":"61","hashOfConfig":"36"},{"size":2469,"mtime":1625148715284,"results":"62","hashOfConfig":"36"},{"size":1127,"mtime":1625148715233,"results":"63","hashOfConfig":"36"},{"size":232,"mtime":1625148715207,"results":"64","hashOfConfig":"36"},{"size":358,"mtime":1625148715829,"results":"65","hashOfConfig":"36"},{"size":1564,"mtime":1625148715284,"results":"66","hashOfConfig":"36"},{"size":923,"mtime":1625148715204,"results":"67","hashOfConfig":"36"},{"size":302,"mtime":1625148715232,"results":"68","hashOfConfig":"36"},{"size":395,"mtime":1625150099372,"results":"69","hashOfConfig":"36"},{"filePath":"70","messages":"71","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},"rc412j",{"filePath":"72","messages":"73","errorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"74","messages":"75","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"76","messages":"77","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"78","messages":"79","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"80","usedDeprecatedRules":"81"},{"filePath":"82","messages":"83","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"84","messages":"85","errorCount":0,"warningCount":4,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"86","messages":"87","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"88","messages":"89","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"90","messages":"91","errorCount":0,"warningCount":4,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"92","messages":"93","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"94","messages":"95","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"96","messages":"97","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"98","messages":"99","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"100","messages":"101","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"102","messages":"103","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"104","messages":"105","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"106","messages":"107","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"108","messages":"109","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"110","messages":"111","errorCount":0,"warningCount":12,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"112","messages":"113","errorCount":0,"warningCount":13,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"114","messages":"115","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"116","messages":"117","errorCount":0,"warningCount":4,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"118","messages":"119","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"120","messages":"121","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"122","messages":"123","errorCount":0,"warningCount":6,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"124","messages":"125","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"126","messages":"127","errorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"128","messages":"129","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"130","messages":"131","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"132","messages":"133","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"134","messages":"135","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"136","messages":"137","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"138","messages":"139","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},"C:\\Users\\Iyo\\Documents\\grazac academy\\grazac-academy-web\\src\\index.js",[],"C:\\Users\\Iyo\\Documents\\grazac academy\\grazac-academy-web\\src\\App.js",["140","141","142"],"C:\\Users\\Iyo\\Documents\\grazac academy\\grazac-academy-web\\src\\reportWebVitals.js",[],"C:\\Users\\Iyo\\Documents\\grazac academy\\grazac-academy-web\\src\\pages\\GraduateCourseDetail.js",["143","144"],"C:\\Users\\Iyo\\Documents\\grazac academy\\grazac-academy-web\\src\\pages\\Landing.js",["145"],"import { useEffect, useState } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { Accordion, Card } from \"react-bootstrap\";\r\n// import { cn } from \"../utils\";\r\nimport { MdKeyboardArrowDown } from \"react-icons/md\";\r\nimport { IoMdArrowRoundBack } from \"react-icons/io\";\r\nimport Slider from \"infinite-react-carousel\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport Mode from \"../components/Mode\";\r\nimport PrimaryBtn from \"../components/PrimaryBtn\";\r\n\r\nimport Abdullahi from \"../images/testimonial/abdullahi.jpeg\";\r\nimport Adedamola from \"../images/testimonial/adedamola.jpeg\";\r\nimport Bosun from \"../images/testimonial/bosun.jpg\";\r\nimport Grazac from \"../images/svg/logo-round.svg\";\r\nimport Video from \"../images/landing-video2.mp4\";\r\nimport Object from \"../images/svg/objects.svg\";\r\nimport poster from \"../images/Grazac-website/IMG_8403.JPG\";\r\n\r\nimport badge from \"../images/svg/badge.svg\";\r\nimport ex from \"../images/svg/x-mark.svg\";\r\nimport Sponsor1 from \"../images/svg/Apple.svg\";\r\nimport Sponsor2 from \"../images/svg/AWS.svg\";\r\nimport Sponsor3 from \"../images/svg/Flutterwave.svg\";\r\nimport Sponsor5 from \"../images/svg/Microsoft.svg\";\r\nimport Sponsor6 from \"../images/svg/Google.svg\";\r\n\r\nimport Card1 from \"../images/svg/card1.svg\";\r\nimport Card2 from \"../images/svg/card2.svg\";\r\n\r\nconst Landing = () => {\r\n  const [showModal, setShowModal] = useState(true);\r\n  useEffect(() => {\r\n    document.title = \"Welcome to Grazac Academy\";\r\n    let mediaPlayer = document.querySelector(\"#video\");\r\n    mediaPlayer.controls = false;\r\n    mediaPlayer.play();\r\n\r\n    //this gives the homepage spacing on top for the notification\r\n    var landingHeight = document.getElementsByClassName(\"landing\")[0];\r\n    landingHeight.style.marginTop = `80px`;\r\n  }, []);\r\n\r\n  const content = [\r\n    {\r\n      id: 0,\r\n      img: Bosun,\r\n      content:\r\n        \"The future of work will be filled with so many opportunities we need to prepare for, I’ve known Grazac for a while and seen them in the business of helping people lay hold of these opportunities. Grazac Academy is an excellent starting point for anyone looking into building a career in technology.\",\r\n      name: \"Bosun Egberinde - Creator of PHPSandbox.io\",\r\n    },\r\n    {\r\n      id: 1,\r\n      img: Adedamola,\r\n      content:\r\n        \"I've known Grazac for over a year now and having worked with some of their successful students, I can boldly say the competency and problem solving skills of their students is top-notch and their academy is one of the best academy promoting technology skills acquisition here in Nigeria\",\r\n      name: \"Samson Adedamola - Consultant at Kudi\",\r\n    },\r\n    {\r\n      id: 2,\r\n      img: Abdullahi,\r\n      content:\r\n        \"I passed through Grazac Academy while I was in school and that's one of the best thing that happened to me as an undergraduate. I love how the facilitators mentored everyone of us up and I must say that, we got more value than we paid for.\",\r\n      name: \"Abdullahi Olaniyan - Software Developer at Global Accelerex\",\r\n    },\r\n  ];\r\n\r\n  const handleModal = () => {\r\n    setShowModal(false);\r\n    var landingHeight = document.getElementsByClassName(\"landing\")[0];\r\n    landingHeight.style.marginTop = `0px`;\r\n  };\r\n\r\n  const handleFaq = (e) => {\r\n    // const svg = e.target.querySelector(\"svg\");\r\n    console.log(e);\r\n    let svg = e.target.parentElement.querySelector(\"svg\");\r\n    if (e.target.nodeName === \"path\") {\r\n      svg = e.target.parentElement.parentElement.querySelector(\"svg\");\r\n    }\r\n    svg.classList.toggle(\"faq-icon_transition\");\r\n  };\r\n\r\n  useEffect(() => {\r\n    window.addEventListener(\"load\", (event) => {\r\n      console.log(\"The page has fully loaded\");\r\n    });\r\n  }, []);\r\n  return (\r\n    <div className=\"landing\">\r\n\r\n      {showModal && (\r\n        <div className=\"infomodal\">\r\n          <div className=\"infomodal_content\">\r\n            <img src={badge} alt=\"\" className=\"infomodal_badge\" />\r\n            <p>\r\n              Grazac Graduate Accelerator Program enrollment is opening by June\r\n              25th.\r\n              <a\r\n                className=\"infomodal_content-link\"\r\n                href=\"https://grazacacademy.com/graduate-accelerator-plan\"\r\n                f\r\n              >\r\n                Learn more\r\n              </a>\r\n            </p>\r\n            <Link to=\"/graduate-accelerator-plan\">\r\n              <button>Learn more</button>\r\n            </Link>\r\n            <img\r\n              src={ex}\r\n              alt=\"\"\r\n              onClick={handleModal}\r\n              style={{ cursor: \"pointer\" }}\r\n            />\r\n          </div>\r\n        </div>\r\n      )}\r\n      <div className=\"landing__header\">\r\n        <Navbar top={true} />\r\n        <img src={Object} className=\"bg-img\" alt=\"ccc\" />\r\n        <div style={{ height: 10 }}></div>\r\n\r\n        <div className=\"landing__text\">\r\n          <h1>\r\n            Upskilling You For The <span>Future</span> Of Work\r\n          </h1>\r\n          <p>\r\n            Learn valuable technology skills with us, we strongly believe the\r\n            future of work will be skill based. Join us to build a career in\r\n            tech and get tutored by industry leaders who will walk you through\r\n            the path of becoming highly valuable and employable{\" \"}\r\n          </p>\r\n        </div>\r\n        <a href=\"/#tracks\">\r\n          <div\r\n            className=\"nav__btn\"\r\n            style={{ width: \"130px\", margin: \"auto\", textAlign: \"center\" }}\r\n          >\r\n            <div className=\"nav__btn--text\">Get Started</div>\r\n          </div>\r\n        </a>\r\n      </div>\r\n\r\n      <div className=\"landing__video\">\r\n        <video\r\n          id=\"video\"\r\n          width=\"320\"\r\n          height=\"240\"\r\n          autoPlay\r\n          loop\r\n          muted\r\n          poster={poster}\r\n        >\r\n          <source src={Video} type=\"video/mp4\" />\r\n        </video>\r\n      </div>\r\n\r\n      <div className=\"landing__sponsors\">\r\n        <div className=\"landing__sponsors--container\">\r\n          <img src={Sponsor1} alt=\"sponsor\" />\r\n          <img src={Sponsor2} alt=\"sponsor\" />\r\n          <img src={Sponsor3} alt=\"sponsor\" />\r\n          <img src={Sponsor5} alt=\"sponsor\" />\r\n          <img src={Sponsor6} alt=\"sponsor\" />\r\n        </div>\r\n      </div>\r\n\r\n      <div className=\"landing__cards\" id=\"tracks\">\r\n        <div className=\"landing__cards--container\">\r\n          <div className=\"landing__bottom--text\">\r\n            <div className=\"landing__bottom--text--right\">\r\n              <h1>Get Ready To Grow With us </h1>\r\n            </div>\r\n          </div>\r\n\r\n          <div className=\"landing__card--box\">\r\n            <div className=\"landing__card landing__card--1\">\r\n              <img src={Card1} alt=\"illustration\" />\r\n              <h3>\r\n                <span>Graduate </span>\r\n                <br />\r\n                Accelerator Plan\r\n              </h3>\r\n              <p>\r\n                An immersive program that gives you the opportunity to build a\r\n                career and get a job in the tech industry.\r\n              </p>\r\n\r\n              <div className=\"landing__btn\">\r\n                <PrimaryBtn yellow link=\"/graduate-accelerator-plan\">\r\n                  Learn More\r\n                </PrimaryBtn>\r\n              </div>\r\n            </div>\r\n\r\n            <div className=\"landing__card landing__card--2\">\r\n              <img src={Card2} alt=\"illustration\" />\r\n              <h3>\r\n                <span>Undergraduate </span>\r\n                <br />\r\n                Accelerator Plan (FREE)\r\n              </h3>\r\n              <p>\r\n                Set the pace for a bright future as an undergraduate by\r\n                acquiring technology skills now.\r\n              </p>\r\n              <div className=\"landing__btn\">\r\n                <PrimaryBtn link=\"/undergraduate-accelerator-plan\">\r\n                  Learn More\r\n                </PrimaryBtn>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <div className=\"landing__intern\">\r\n        <div className=\"landing__intern--content\">\r\n          <div>&nbsp;</div>\r\n          <div className=\"landing__bottom--text landing__bottom--text-2\">\r\n            <div className=\"landing__intern--text\">\r\n              <h1>Tech is Vast. Let's help you with directions.</h1>\r\n              <p>\r\n                Are you looking to step into the field of tech but don't know\r\n                what to learn or how to begin? We can help you. Tech is a broad\r\n                field, and there are a lot of interesting pathways and\r\n                directions you can venture into. You need all the clarity you\r\n                can get so you can make informed decisions. Consult us for free\r\n              </p>\r\n              <div className=\"landing__btn--2\">\r\n                {/* <PrimaryBtn link=\"/\">Enroll Now</PrimaryBtn> */}\r\n                <a href=\"/#tracks\">\r\n                  <div className=\"nav__btn nav__btn-flex \">\r\n                    <a\r\n                      className=\"nav__btn--text\"\r\n                      href=\"tel:+2348068365951\"\r\n                      style={{ marginRight: \"20px\" }}\r\n                    >\r\n                      Call Us Now\r\n                    </a>\r\n                    <a href=\"https://wa.link/w8e0xs\">\r\n                      <div className=\"nav__btn--text1\">Chat With Us</div>\r\n                    </a>\r\n                  </div>\r\n                </a>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          {/* <div className=\"landing__intern--btn\">\r\n            <PrimaryBtn link=\"/internship\">Enroll Now</PrimaryBtn>\r\n          </div> */}\r\n        </div>\r\n      </div>\r\n\r\n      <div className=\"landing__discover\">\r\n        <div className=\"landing__bottom--text landing__bottom--text-2\">\r\n          <div className=\"landing__bottom--text--right\">\r\n            <h1>\r\n              We are trusted by entrepreneurs and hiring managers globally.\r\n            </h1>\r\n            <p>\r\n              We guarantee you impact driven candidates who will impact your\r\n              bottom lines positively.\r\n            </p>\r\n          </div>\r\n        </div>\r\n\r\n        <div className=\"landing__discover--container\">\r\n          <div className=\"landing__discover--images\">\r\n            <div className=\"landing__discover--images-left\">\r\n              <div></div>\r\n              <div></div>\r\n            </div>\r\n            <div className=\"landing__discover--images-right\">\r\n              <div></div>\r\n            </div>\r\n          </div>\r\n\r\n          <div className=\"landing__discover--list\">\r\n            <div className=\"landing__discover--list-item\">\r\n              <h2>01</h2>\r\n              <div>\r\n                <h3>Enroll</h3>\r\n                <p>\r\n                  Set yourself up for success by registering for any of our\r\n                  courses that fits your passion and career.\r\n                </p>\r\n              </div>\r\n            </div>\r\n\r\n            <div className=\"landing__discover--list-item\">\r\n              <h2>02</h2>\r\n              <div>\r\n                <h3>Learn</h3>\r\n                <p>\r\n                  Get trained by world class facilitators. We will provide you\r\n                  with the right mentorship, tools and content you need to be\r\n                  the best in your choosing career.\r\n                </p>\r\n              </div>\r\n            </div>\r\n\r\n            <div className=\"landing__discover--list-item\">\r\n              <h2>03</h2>\r\n              <div>\r\n                <h3>Get Hired</h3>\r\n                <p>\r\n                  Join the workforce of the future as you get connected with\r\n                  career coaches and potential employers.\r\n                </p>\r\n              </div>\r\n            </div>\r\n            <div className=\"landing__discover--list-item\"></div>\r\n            <div className=\"landing__discover--list-item\"></div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      {/* FAQ section commented out till content is ready */}\r\n      <div className=\"landing_faq\">\r\n        <div className=\"container\">\r\n          <h1>FAQs</h1>\r\n          <div>\r\n            <Accordion>\r\n              <Card>\r\n                <Accordion.Toggle as={Card.Header} eventKey=\"0\">\r\n                  <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                    <h4>What is Grazac Academy?</h4>\r\n                    <MdKeyboardArrowDown size=\"2rem\" color=\"black\" />\r\n                  </div>\r\n                </Accordion.Toggle>\r\n                <Accordion.Collapse eventKey=\"0\">\r\n                  <Card.Body>\r\n                    <div className=\"landing_faq-answer\">\r\n                      <p>\r\n                        Grazac Academy is closing the gap between youths and\r\n                        entry-level jobs in the technology industry. We strongly\r\n                        believe the job market for youths has changed and the\r\n                        future of work will be skill-based.\r\n                      </p>\r\n                      <p>We are approaching this in two ways:</p>\r\n                      <p>\r\n                        Grazac Academy Graduate Accelerator - This plan is for\r\n                        tertiary institutions graduates who have full time to\r\n                        build a career in tech. This plan has been arranged in a\r\n                        way to prepare them for work.\r\n                      </p>\r\n                      <p>\r\n                        Grazac Academy Undergraduate Accelerator - This plan is\r\n                        to equip undergraduates in their institutions, we\r\n                        believe the earlier the better and we want to prepare\r\n                        them for life after school by upskilling them while they\r\n                        are still in school.\r\n                      </p>\r\n                    </div>\r\n                  </Card.Body>\r\n                </Accordion.Collapse>\r\n              </Card>\r\n              <hr />\r\n              <Card>\r\n                <Accordion.Toggle as={Card.Header} eventKey=\"1\">\r\n                  <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                    <h4>When was the academy established?</h4>\r\n                    <MdKeyboardArrowDown size=\"2rem\" color=\"black\" />\r\n                  </div>\r\n                </Accordion.Toggle>\r\n                <Accordion.Collapse eventKey=\"1\">\r\n                  <Card.Body>\r\n                    <div className=\"landing_faq-answer\">\r\n                      <p>Grazac Academy has been in operation since 2018</p>\r\n                    </div>\r\n                  </Card.Body>\r\n                </Accordion.Collapse>\r\n              </Card>\r\n              <hr />\r\n              <Card>\r\n                <Accordion.Toggle as={Card.Header} eventKey=\"2\">\r\n                  <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                    <h4>How many students have graduated from your academy?</h4>\r\n                    <MdKeyboardArrowDown size=\"2rem\" color=\"black\" />\r\n                  </div>\r\n                </Accordion.Toggle>\r\n                <Accordion.Collapse eventKey=\"2\">\r\n                  <Card.Body>\r\n                    <div className=\"landing_faq-answer\">\r\n                      <p>\r\n                        Excluding our partnership with Haptics.ng in 2019 to\r\n                        execute Google project of upskilling Nigerians on\r\n                        Digital skills where we trained about 500 youths, we\r\n                        have impacted over 2,000 lives through our trainings,\r\n                        meetups and events.\r\n                      </p>\r\n                    </div>\r\n                  </Card.Body>\r\n                </Accordion.Collapse>\r\n              </Card>\r\n              <hr />\r\n              <Card>\r\n                <Accordion.Toggle as={Card.Header} eventKey=\"3\">\r\n                  <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                    <h4>Where is the academy located?</h4>\r\n                    <MdKeyboardArrowDown size=\"2rem\" color=\"black\" />\r\n                  </div>\r\n                </Accordion.Toggle>\r\n                <Accordion.Collapse eventKey=\"3\">\r\n                  <Card.Body>\r\n                    <div className=\"landing_faq-answer\">\r\n                      <p>\r\n                        Our headquarter is located at Abeokuta, Ogun State,\r\n                        Nigeria.\r\n                      </p>\r\n                      <p>\r\n                        Address: Suite 106, PROHUB, Salawu Olabode Avenue, Ewang\r\n                        Road, Idi-aba, Abeokuta.\r\n                      </p>\r\n                    </div>\r\n                  </Card.Body>\r\n                </Accordion.Collapse>\r\n              </Card>\r\n              <hr />\r\n              <Card>\r\n                <Accordion.Toggle as={Card.Header} eventKey=\"4\">\r\n                  <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                    <h4>How do I enroll in the academy?</h4>\r\n                    <MdKeyboardArrowDown size=\"2rem\" color=\"black\" />\r\n                  </div>\r\n                </Accordion.Toggle>\r\n                <Accordion.Collapse eventKey=\"4\">\r\n                  <Card.Body>\r\n                    <div className=\"landing_faq-answer\">\r\n                      <p>\r\n                        Visit{\" \"}\r\n                        <a href=\"https://www.grazacacademy.com\">\r\n                          www.grazacacademy.com\r\n                        </a>{\" \"}\r\n                        to enroll for your preferred course.\r\n                      </p>\r\n                    </div>\r\n                  </Card.Body>\r\n                </Accordion.Collapse>\r\n              </Card>\r\n              <hr />\r\n              <Card>\r\n                <Accordion.Toggle as={Card.Header} eventKey=\"5\">\r\n                  <div className=\"landing_faq-question\" onClick={handleFaq}>\r\n                    <h4>What are the payment options?</h4>\r\n                    <MdKeyboardArrowDown size=\"2rem\" color=\"black\" />\r\n                  </div>\r\n                </Accordion.Toggle>\r\n                <Accordion.Collapse eventKey=\"5\">\r\n                  <Card.Body>\r\n                    <div className=\"landing_faq-answer\">\r\n                      <p>\r\n                        We have three (2) payment options for our Gradaute\r\n                        Accelerator, you can either pay once or pay\r\n                        installmentally.\r\n                      </p>\r\n                    </div>\r\n                  </Card.Body>\r\n                </Accordion.Collapse>\r\n              </Card>\r\n            </Accordion>\r\n            <hr />\r\n            <Link to=\"/faq\">\r\n              <p className=\"landing_faq-link\">\r\n                More frequently asked questions\r\n              </p>\r\n            </Link>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <div className=\"landing__slider\">\r\n        <Slider arrows={true}>\r\n          {content.map((item) => (\r\n            <div className=\"landing__slider--container\" key={item.id}>\r\n              <div className=\"landing__slider--img\">\r\n                <img src={item.img} alt=\"img\" />\r\n              </div>\r\n\r\n              <div className=\"landing__slider--text\">\r\n                <svg\r\n                  width=\"30\"\r\n                  height=\"28\"\r\n                  viewBox=\"0 0 30 28\"\r\n                  fill=\"none\"\r\n                  xmlns=\"http://www.w3.org/2000/svg\"\r\n                >\r\n                  <path\r\n                    d=\"M12.3993 5.56001C13.1711 5.22699 13.4948 4.27918 13.1462 3.51069L11.9262 0.872185C11.5777 0.129562 10.7311 -0.203709 9.98417 0.129562C7.86782 1.05176 6.05026 2.25573 4.60616 3.71587C2.83839 5.43192 1.64328 7.4044 0.995927 9.5818C0.348574 11.7851 0 14.782 0 18.5988V26.4631C0 27.3084 0.672251 28.0001 1.49389 28.0001H11.2789C12.1005 28.0001 12.7728 27.3084 12.7728 26.4631V16.3958C12.7728 15.5502 12.1005 14.8588 11.2789 14.8588H6.59802C6.64781 12.2713 7.24537 10.1966 8.34089 8.63373C9.23722 7.37904 10.5817 6.35438 12.3993 5.56001Z\"\r\n                    fill=\"#4B004B\"\r\n                  />\r\n                  <path\r\n                    d=\"M29.1127 5.53403C29.8845 5.20102 30.2079 4.25321 29.8596 3.48471L28.6396 0.872082C28.291 0.129203 27.4445 -0.203812 26.6976 0.129203C24.6061 1.0514 22.8132 2.25537 21.3444 3.6899C19.5764 5.43182 18.3567 7.40429 17.7091 9.5817C17.0617 11.7332 16.7383 14.7306 16.7383 18.5731V26.4374C16.7383 27.2827 17.4105 27.9744 18.2322 27.9744H28.0172C28.8388 27.9744 29.511 27.2827 29.511 26.4374V16.3701C29.511 15.5245 28.8388 14.8331 28.0172 14.8331H23.3114C23.3612 12.2456 23.959 10.1709 25.0543 8.60801C25.9506 7.35306 27.2951 6.3284 29.1127 5.53403Z\"\r\n                    fill=\"#4B004B\"\r\n                  />\r\n                </svg>\r\n\r\n                <p>{item.content}</p>\r\n\r\n                <small>{item.name}</small>\r\n              </div>\r\n            </div>\r\n          ))}\r\n        </Slider>\r\n      </div>\r\n\r\n      <div className=\"landing__bottom\" style={{ paddingBottom: 0 }}>\r\n        <div className=\"landing__bottom--text\">\r\n          <div className=\"landing__bottom--text--right\">\r\n            <h1>Get Upskilled For The Future Of Work</h1>\r\n            <p>\r\n              We will provide you with the tools, resources, facilities, content\r\n              and mentorship needed for your relevance in the future of work.\r\n            </p>\r\n            <div className=\"landing__btn--2\">\r\n              {/* <PrimaryBtn link=\"/\">Enroll Now</PrimaryBtn> */}\r\n              <a href=\"/#tracks\">\r\n                <div className=\"nav__btn nav__btn-flex \">\r\n                  <a className=\"nav__btn--text\" href=\"https://wa.link/w8e0xs\">\r\n                    Chat with Us\r\n                  </a>\r\n                </div>\r\n              </a>\r\n            </div>\r\n          </div>\r\n\r\n          <div className=\"landing__bottom--text--left\">\r\n            <img src={Grazac} alt=\"img\" />\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <Mode />\r\n      <Footer />\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default Landing;\r\n",["146","147"],"C:\\Users\\Iyo\\Documents\\grazac academy\\grazac-academy-web\\src\\pages\\UndergraduateCourseDetail.js",["148"],"C:\\Users\\Iyo\\Documents\\grazac academy\\gr