recatedRules":"50"},{"filePath":"85","messages":"86","errorCount":0,"warningCount":7,"fixableErrorCount":0,"fixableWarningCount":0,"source":"87","usedDeprecatedRules":"50"},{"filePath":"88","messages":"89","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"50"},{"filePath":"90","messages":"91","errorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"92","usedDeprecatedRules":"50"},{"filePath":"93","messages":"94","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"50"},{"filePath":"95","messages":"96","errorCount":0,"warningCount":5,"fixableErrorCount":0,"fixableWarningCount":0,"source":"97","usedDeprecatedRules":"50"},{"filePath":"98","messages":"99","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"50"},{"filePath":"100","messages":"101","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"50"},{"filePath":"102","messages":"103","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"104","usedDeprecatedRules":"50"},{"filePath":"105","messages":"106","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},"C:\\Users\\USER\\Desktop\\Web Development\\Bitbucket\\grazac-academy\\src\\index.js",[],["107","108"],"C:\\Users\\USER\\Desktop\\Web Development\\Bitbucket\\grazac-academy\\src\\reportWebVitals.js",[],"C:\\Users\\USER\\Desktop\\Web Development\\Bitbucket\\grazac-academy\\src\\App.js",[],"C:\\Users\\USER\\Desktop\\Web Development\\Bitbucket\\grazac-academy\\src\\pages\\CourseDetail.js",["109","110","111","112","113"],"import React,{useState} from \"react\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport PrimaryBtn from \"../components/PrimaryBtn\";\r\nimport {productDesign} from \"../content/courses.js\";\r\n\r\nimport quote from '../images/svg/quote.svg';\r\nimport paper from '../images/svg/paper-ribbon.svg';\r\nimport sprint from '../images/sprint.png';\r\n\r\nconst CourseDetail = (props) => {\r\n    const [course, setCourse] = useState('');\r\n    const [outline, setOutline] = useState([]);\r\n\r\n    React.useEffect(() => {\r\n        document.title = 'Course Details - Grazac Academy';\r\n        window.scrollTo(0,0);\r\n        const param = props.location.search.substring(8);\r\n        if (param === 'productDesign'){\r\n            setCourse(productDesign);\r\n            setOutline(productDesign.outline)\r\n        }\r\n    },[]);\r\n    \r\n    const RenderOutline = _ => {\r\n        const list = outline.map((item, index) => (\r\n            <div key={index}>\r\n                <div className=\"course_learn-main-list\">\r\n                    <div className=\"box1\">\r\n                        <h3>{item.id}</h3>\r\n                    </div>\r\n                    <div className=\"box2\">\r\n                        <h3>{item.topic}</h3>\r\n                    </div>\r\n                    <div className=\"box3\">\r\n                        <p>{item.content}</p>\r\n                    </div>\r\n                </div>\r\n                <hr/>\r\n            </div>\r\n        ))\r\n        return(<div>{list}</div>)\r\n    }\r\n    return(\r\n        <div>\r\n            <Navbar/>\r\n            <div className=\"course\">\r\n                <div className=\"gua_hero\">\r\n                    <div className=\"container\">\r\n                        <div className=\"row\">\r\n                            <div className=\"col-sm-6\">\r\n                                <div className=\"gua_hero-text\">\r\n                                    <div className=\"gua_hero-text-b\">\r\n                                        <h1>\r\n                                            {course.name}\r\n                                        </h1>\r\n                                        <p>\r\n                                            {course.description}\r\n                                        </p>\r\n                                        <div className=\"contact_hero-privacy\" >\r\n                                            <button>Download Brochure</button>\r\n                                            <button>Enroll now</button>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div>\r\n                                <img src={paper} alt=\"academy\"  className=\"gga_hero-image\" />\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"course_learn\">\r\n                    <div className=\"container\">\r\n                        <div className=\"course_wwd-intro\">\r\n                            <h4>GRAZAC ACADEMY</h4>\r\n                            <h2>What you'll Learn</h2>\r\n                        </div>\r\n                        <div className=\"course_learn-main\">\r\n                            <RenderOutline/>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"course_mode\">\r\n                    <div className=\"container\">\r\n                        <div className=\"course_wwd-intro\">\r\n                            <h4>What we do</h4>\r\n                            <h2>Mode Of Teaching</h2>\r\n                            <p>Amet minim mollit non deserunt ullamco est sit aliqua dolor do amet sint. Velit officia consequ</p>\r\n                        </div>\r\n                        <div className=\"course_mode-container\">\r\n                            <div className=\"\">\r\n                                <div>\r\n                                    <div className=\"boxes\">\r\n                                        <div className=\"svg-box\"></div>\r\n                                        <h3></h3>\r\n                                        <p>Learn the foundations of database management with focus on relational database systems and its terminologies.</p>\r\n                                    </div>\r\n                                    <div className=\"boxes\">\r\n                                        <div className=\"svg-box\"></div>\r\n                                        <h3></h3>\r\n                                        <p>Learn the foundations of database management with focus on relational database systems and its terminologies.</p>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div className=\"\">\r\n                                <div>\r\n                                    <div className=\"boxes\">\r\n                                        <div className=\"svg-box\"></div>\r\n                                        <h3></h3>\r\n                                        <p>Learn the foundations of database management with focus on relational database systems and its terminologies.</p>\r\n                                    </div>\r\n                                    <div className=\"boxes\">\r\n                                        <div className=\"svg-box\"></div>\r\n                                        <h3></h3>\r\n                                        <p>Learn the foundations of database management with focus on relational database systems and its terminologies.</p>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div className=\"mode-pic\">\r\n                                <img src={sprint} alt=\"jdgkj\" style={{width:'100%'}} />\r\n                            </div>\r\n                        </div>\r\n                        <div className=\"course_mode-quote\">\r\n                            <img src={quote} alt=\"quote\" />\r\n                            <p>Online learning can be a lifeline to those who have obstacles, such as geographical distances or physical disabilities.</p>\r\n                            <span>Paul Levinson</span>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"course_purple\">\r\n                    <div className=\"course_purple_txt\">\r\n                        <p>Pricing</p>\r\n                        <h1>50%</h1>\r\n                        <p>Scholarship Available</p>\r\n                    </div>\r\n                    <div className=\"course_purple-main\">\r\n                        <div className=\"course_purple-main-boxes\">\r\n                            <h4>FULL TUITION PAYMENT</h4>\r\n                            <h2>₦540,000</h2>\r\n                            <p>Pay your fees 100% upfront. No other charges come up during your career</p>\r\n                        </div>\r\n                        <div className=\"course_purple-main-boxes\">\r\n                            <h4>FULL TUITION PAYMENT</h4>\r\n                            <h2>₦540,000</h2>\r\n                            <p>Pay your fees 100% upfront. No other charges come up during your career</p>\r\n                        </div>\r\n                        <div className=\"course_purple-main-boxes\">\r\n                            <h4>FULL TUITION PAYMENT</h4>\r\n                            <h2>₦540,000</h2>\r\n                            <p>Pay your fees 100% upfront. No other charges come up during your career</p>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"course_purple-btn\">\r\n                        <PrimaryBtn>Claim Scholarship</PrimaryBtn> \r\n                        <p>Talk to course rep</p>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n            <Footer/>\r\n        </div>\r\n    );\r\n}\r\n\r\nexport default CourseDetail;","C:\\Users\\USER\\Desktop\\Web Development\\Bitbucket\\grazac-academy\\src\\pages\\UndergraduateAccelerator.js",["114","115"],"import React from \"react\";\r\nimport {Link} from \"react-router-dom\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport NeedAdvice from \"../components/NeedAdvice\";\r\nimport PopularCourses from \"../components/PopularCourses\";\r\nimport Qualities from \"../components/Qualities\";\r\n\r\nimport undergraduate from \"../images/undergraduate.png\";\r\n\r\nconst UndergraduateAccelerator = () => {\r\n\r\n    React.useEffect(() => {\r\n        document.title = 'Undergraduate Accelerator Track - Grazac Academy';\r\n        window.scrollTo(0,0);\r\n    }, []);\r\n\r\n    return(\r\n        <div>\r\n            <div className=\"gua\">\r\n                <div className=\"gua_hero\">\r\n                        <Navbar/>\r\n                    <div className=\"container\">\r\n                        <div className=\"row\">\r\n                            <div className=\"col-sm-6\">\r\n                                <div className=\"gua_hero-text\">\r\n                                    <div className=\"gua_hero-text-b\">\r\n                                        <h1>\r\n                                            Undergraduate Accelerator Plan\r\n                                        </h1>\r\n                                        <p> We equip you for the future of the career you desire,\r\n                                        Become an asset in this 21st century before leaving the four walls of school.</p>\r\n                                        <p>Join thousands of young undergraduates now. Access to mentorship tailored to your career path.</p>\r\n                                        <p>Become the next best talent to be hired in this 21st century and be employable.</p>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div>\r\n                                <img src={undergraduate} alt=\"undergraduate\"  className=\"gua_hero-image\" />\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"container\">\r\n                    <div className=\"gga\">\r\n                        <div className=\"course_mode-intro course_mode-intro\">\r\n                            <h4 style={{marginTop:'100px'}}>How it works</h4>\r\n                            <h2>Highlighted Learning</h2>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"gua_highlight\">\r\n                        <div className=\"boxes44 gua_highlight-box1\">\r\n                            <div className=\"gua_highlight-box3\">\r\n                                <div className=\"gua_highlight-box4\">\r\n                                    <h3><strong>Student Lead</strong></h3>\r\n                                    <p>Become our ambassador in your institution. </p>\r\n                                    <p>Lead other students who are ready to prepare themselves for the future of work.</p>\r\n                                    <Link to=\"/lead\"><a className=\"white-link\">Apply as Student Lead</a></Link>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                        <div className=\"boxes44 gua_highlight-box2\">\r\n                            <div  className=\"gua_highlight-box3\">\r\n                                <div className=\"gua_highlight-box4\">\r\n                                    <h3><strong>Affiliated Campuses</strong></h3>\r\n                                    <p>We are well represented in various institutions of learning across Nigeria.</p>\r\n                                    <p>We want to prepare you for the future of work before you leave the four walls of learning.</p>\r\n                                    <a className=\"white-link\">Learn More</a>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <PopularCourses />\r\n                <Qualities />\r\n                <NeedAdvice />\r\n            </div>\r\n            <Footer/>\r\n        </div>\r\n    );\r\n}\r\n\r\nexport default UndergraduateAccelerator;","C:\\Users\\USER\\Desktop\\Web Development\\Bitbucket\\grazac-academy\\src\\pages\\Contact.js",["116"],"import React, { useState, useEffect } from \"react\";\r\nimport axios from 'axios';\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport PrimaryBtn from \"../components/PrimaryBtn\";\r\n\r\nimport Facebook from \"../images/svg/facebook.svg\";\r\nimport Instagram from \"../images/svg/instagram.svg\";\r\nimport Twitter from \"../images/svg/twitter.svg\";\r\nimport Youtube from \"../images/svg/youtube.svg\";\r\nimport kamala from \"../images/kamala.jpg\";\r\n\r\nconst Contact = () => {\r\n\r\n    const [ name, setName ] = useState('');\r\n    const [ email, setEmail ] = useState('');\r\n    const [ subject, setSubject ] = useState('');\r\n    const [ message, setMessage ] = useState('');\r\n\r\n    useEffect(() => {\r\n        document.title = 'Contact - Grazac Academy';\r\n        window.scrollTo(0,0);\r\n    }, []);\r\n\r\n    const handleSubmit = () => {\r\n        if(name.length && email.length && subject.length && message.length) {\r\n            const btn = document.querySelector('#submit');\r\n            btn.setAttribute('disabled', '');\r\n            btn.textContent = 'Submitting...';\r\n            console.log('Submitted')\r\n            axios.post('http://grazacacademy.com/contact/create', {\r\n                name: name,\r\n                email: email,\r\n                subject: subject,\r\n                message: message\r\n            })\r\n            .then(resp => resp.data)\r\n            .then(response => {\r\n                if(response.success === true) {\r\n                    btn.removeAttribute('disabled');\r\n                    btn.textContent = 'Submit';\r\n                    alert(response.msg);\r\n                    setName(''); setEmail(''); setSubject(''); setMessage('');\r\n                } else {\r\n\r\n                }\r\n            })\r\n            .catch((err) => {\r\n                \r\n            });\r\n        } else {\r\n            alert('Invalid input');\r\n        }\r\n    }\r\n\r\n    return(\r\n        <div>\r\n            <Navbar/>\r\n            <div className=\"contact\">\r\n                <div className=\"contact_layer\">\r\n                    <div className=\"container\">\r\n                        <div className=\"contact_layer-text\">\r\n                            <h1>Get In Touch</h1>\r\n                            <p>We want to hear from you. Let us know how we can help</p>\r\n                        </div>\r\n                        <div classname=\"contact_layer-circles\">\r\n                            <img src={kamala} alt=\"kamala\"  classname=\"contact_layer-circles-1\" />\r\n                            <img src={kamala} alt=\"kamala\"  classname=\"contact_layer-circles-2\" />\r\n                            <img src={kamala} alt=\"kamala\"  classname=\"contact_layer-circles-3\" />\r\n                            <img src={kamala} alt=\"kamala\"  classname=\"contact_layer-circles-4\" />\r\n                        </div>\r\n                        <div className=\"contact_hero\">\r\n                            <div className=\"contact_hero-flexdiv\">\r\n                                <div className=\"contact_hero-flexdiv-1\" >\r\n                                    <label>Full Name  <span>*</span></label>\r\n                                    <input type=\"text\" placeholder=\"ex. John Doe\" value={name} onChange={e => setName(e.target.value)} />\r\n                                </div>\r\n                                <div className=\"contact_hero-flexdiv-2\">\r\n                                    <label>Email  <span>*</span></label>\r\n                                    <input type=\"text\" placeholder=\"ex. john@gmail.com\" value={email} onChange={e => setEmail(e.target.value)}  />\r\n                                </div>\r\n                            </div>\r\n                            <div>\r\n                                <label>Subject  <span>*</span></label>\r\n                                <input  type=\"text\" placeholder=\"ex. John Doe\" value={subject} onChange={e => setSubject(e.target.value)}  />\r\n                            </div>\r\n                            <div>\r\n                                <label>Message  <span>*</span></label>\r\n                                <textarea  type=\"text\" placeholder=\"Describe your task for us\" value={message} onChange={e => setMessage(e.target.value)}  />\r\n                            </div>\r\n                            <div className=\"contact_hero-privacy\" >\r\n                                <p>By submitting this form your consent to us emailing you occasionally about our products and services. You can unsubscribe from emails at any time, and we will never pass your email onto third parties. <span>Privacy Policy</span></p>\r\n                                <button id=\"submit\" onClick={handleSubmit}>Submit</button>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"container\">\r\n                    <div className=\"contact_campus\">\r\n                        <div className=\"contact_campus-intro\">\r\n                            <h2>Campus Inquiries</h2>\r\n                            <p>Connect with Us</p>\r\n                        </div>\r\n                        <div className=\"contact_campus-main\">\r\n                            <div className=\"contact_campus-main-div boxes33\">\r\n                                <h3>Office</h3>\r\n                                <p>PROHUB, Salawu Olabode Avenue, Ewang Road, </p>\r\n                                <p>Idi-aba, 110124, Abeokuta</p>\r\n                                <p>0906 133 3395</p>\r\n                            </div>\r\n                            <div className=\"contact_campus-main-div boxes33\">\r\n                                <h3>Book A Call</h3>\r\n                                <p>We are here to help with any questions. </p>\r\n                                <p>Talk to our programme leads.</p>\r\n                                <div style={{display:'flex'}}>\r\n                                    <PrimaryBtn>Book A Call</PrimaryBtn>\r\n                                </div>\r\n                            </div>\r\n                            <div className=\"contact_campus-main-div boxes33\">\r\n                                <h3>Social Media</h3>\r\n                                <div className=\"social\">\r\n                                    <img src={Facebook} alt=\"social\"/>\r\n                                </div>\r\n                                <div className=\"social\">\r\n                                    <img src={Twitter} alt=\"social\"/>\r\n                                </div>\r\n                                <div className=\"social\">\r\n                                    <img src={Youtube} alt=\"social\"/>\r\n                                </div>\r\n                                <div className=\"social\">\r\n                                    <img src={Instagram} alt=\"social\"/>\r\n                                </div>\r\n                            </div>\r\n\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div>\r\n                    <iframe src=\"https://www.google.com/maps/d/embed?mid=16NZ9a9VhKkk2-5nnYEdL93mxq7kjDZLT\" width=\"100%\" height=\"600\"></iframe>\r\n                </div>\r\n                {/*<extracomponent/> a component used in the landing page comes here*/}\r\n            </div>\r\n            <Footer/>\r\n        </div>\r\n    );\r\n}\r\n\r\nexport default Contact;","C:\\Users\\USER\\Desktop\\Web Development\\Bitbucket\\grazac-academy\\src\\pages\\Landing.js",["117"],"import { useState, useEffect } from \"react\";\r\nimport { cn } from \"../utils\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport Mode from \"../components/Mode\";\r\nimport PrimaryBtn from \"../components/PrimaryBtn\";\r\nimport Kamala from \"../images/kamala.jpg\"\r\nimport Grazac from \"../images/svg/logo-round.svg\";\r\nimport Love from \"../images/my_love.png\";\r\nimport Video from \"../images/landing-video2.mp4\";\r\nimport Object from \"../images/svg/objects.svg\";\r\nimport poster from \"../images/Grazac-website/IMG_8403.JPG\";\r\n\r\nimport Sponsor1 from \"../images/svg/Apple.svg\";\r\nimport Sponsor2 from \"../images/svg/AWS.svg\";\r\nimport Sponsor3 from \"../images/svg/Flutterwave.svg\";\r\nimport Sponsor5 from \"../images/svg/Microsoft.svg\";\r\nimport Sponsor6 from \"../images/svg/Google.svg\";\r\n\r\nimport Card1 from \"../images/svg/card1.svg\";\r\nimport Card2 from \"../images/svg/card2.svg\"\r\n\r\nconst Landing = () => {\r\n  // const [email, setEmail] = useState(\"\");\r\n  const [step, setStep] = useState(0);\r\n\r\n  useEffect(() => {\r\n    document.title = 'Welcome to Grazac Academy';\r\n    let mediaPlayer = document.querySelector('#video');\r\n    mediaPlayer.controls = false;\r\n    mediaPlayer.play();\r\n    changeSlider();\r\n  })\r\n\r\n  const changeSlider = () => {\r\n    setTimeout(() => {\r\n      if (step < 3)\r\n        setStep(step + 1);\r\n      else \r\n        setStep(0);\r\n    }, 5000);\r\n  }\r\n\r\n  const dots = [false, false, false, false];\r\n  const content = [\r\n    {\r\n      id: 0,\r\n      img: Kamala,\r\n      content: \"Travelya, thank you so much for a well organized trip. We had a wonderful time. Hard to believe it’s already done and past. Weather was awesom, the hotels were nice, thanks your for everything\",\r\n      name: \"Kamala Harris - First Woman Vice President\"\r\n    },\r\n    {\r\n      id: 1,\r\n      img: Love,\r\n      content: \"Do whatever you want with your life, since you only get to live it once, We had a wonderful time. Hard to believe it’s already done and past. Weather was awesom, the hotels were nice, thanks your for everything\",\r\n      name: \"Adekanmbi Toyosi Adeleye\"\r\n    },\r\n    {\r\n      id: 2,\r\n      img: Kamala,\r\n      content: \"Travelya, thank you so much for a well organized trip. We had a wonderful time. Hard to believe it’s already done and past. Weather was awesom, the hotels were nice, thanks your for everything\",\r\n      name: \"Jermaine Cole - J.Cole\"\r\n    },\r\n    {\r\n      id: 3,\r\n      img: Love,\r\n      content: \"Travelya, thank you so much for a well organized trip. We had a wonderful time. Hard to believe it’s already done and past. Weather was awesom, the hotels were nice, thanks your for everything\",\r\n      name: \"Kendrick Lamar\"\r\n    },\r\n  ]\r\n\r\n  return(\r\n    <div className=\"landing\">\r\n      <div className=\"landing__header\">\r\n        <Navbar />\r\n        <img src={Object} className=\"bg-img\"/>\r\n        <div style={{height: 10}}></div>\r\n\r\n        <div className=\"landing__text\">\r\n          <h1>Upskilling You For The <span>Future</span> Of Work</h1>\r\n          <p>Learn valuable technology skills with us, we strongly believe the future of work will be skill based. Join us to build a career in tech and get tutored by industry leaders who will walk you through the path of becoming highly valuable and employable </p>\r\n        </div>\r\n      </div>\r\n\r\n      <div className=\"landing__video\">\r\n        <video id=\"video\" width=\"320\" height=\"240\" autoPlay loop controls poster={poster}>\r\n          <source src={Video} type=\"video/mp4\" />\r\n        </video>\r\n      </div>\r\n\r\n      <div className=\"landing__sponsors\">\r\n        <div className=\"landing__sponsors--container\">\r\n          <img src={Sponsor1} alt=\"sponsor\" />\r\n          <img src={Sponsor2} alt=\"sponsor\" />\r\n          <img src={Sponsor3} alt=\"sponsor\" />\r\n          <img src={Sponsor5} alt=\"sponsor\" />\r\n          <img src={Sponsor6} alt=\"sponsor\" />\r\n        </div>\r\n      </div>\r\n\r\n      <div className=\"landing__cards\" id=\"tracks\">\r\n        <div className=\"landing__cards--container\">\r\n          <div className=\"landing__bottom--text\">\r\n            <div className=\"landing__bottom--text--right\">\r\n              <h1>Get Ready To Grow With us </h1>\r\n            </div>\r\n          </div>\r\n\r\n          <div className=\"landing__card--box\">\r\n            <div className=\"landing__card landing__card--1\">\r\n            <img src={Card1} alt=\"illustration\" />\r\n              <h3><span>Graduate </span><br />Accelerator Plan</h3>\r\n              <p>An immersive program that gives you the opportunity to build a career and get a job in the tech industry.</p>\r\n             \r\n              <div className=\"landing__btn\">\r\n                <PrimaryBtn yellow link=\"/graduate-accelerator-track\">Learn More</PrimaryBtn>\r\n              </div>\r\n            </div>\r\n\r\n            <div className=\"landing__card landing__card--2\">\r\n              <img src={Card2} alt=\"illustration\" />\r\n              <h3><span>Undergraduate </span><br />Accelerator Plan</h3>\r\n              <p>Set the pace for a bright future as an undergraduate by acquiring technology skills now.</p>\r\n              <div className=\"landing__btn\">\r\n                <PrimaryBtn link=\"/undergraduate-accelerator-track\">Learn More</PrimaryBtn>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <div className=\"landing__discover\">\r\n        <div className=\"landing__bottom--text landing__bottom--text-2\">\r\n          <div className=\"landing__bottom--text--right\">\r\n            <h1>We are trusted by entrepreneurs and hiring managers globally.</h1>\r\n            <p>We guarantee you impact driven candidates who will impact your bottom lines positively.</p>\r\n          </div>\r\n        </div>\r\n\r\n        <div className=\"landing__discover--container\">\r\n          <div className=\"landing__discover--images\">\r\n            <div className=\"landing__discover--images-left\">\r\n              <div></div>\r\n              <div></div>\r\n            </div>\r\n            <div className=\"landing__discover--images-right\">\r\n              <div></div>\r\n            </div>\r\n          </div>\r\n\r\n          <div className=\"landing__discover--list\">\r\n            <div className=\"landing__discover--list-item\">\r\n              <h2>01</h2>\r\n              <div>\r\n                <h3>Enroll</h3>\r\n                <p>Set yourself up for success by registering for any of our courses that fits your passion and career.</p>\r\n              </div>\r\n            </div>\r\n\r\n            <div className=\"landing__discover--list-item\">\r\n              <h2>02</h2>\r\n              <div>\r\n                <h3>Learn</h3>\r\n                <p>Get trained by world class facilitators. We will provide you with the right mentorship, tools and content you need to be the best in your choosing career.</p>\r\n              </div>\r\n            </div>\r\n\r\n            <div className=\"landing__discover--list-item\">\r\n              <h2>03</h2>\r\n              <div>\r\n                <h3>Get Hired</h3>\r\n                <p>Join the workforce of the future as you get connected with career coaches and potential employers.</p>\r\n              </div>\r\n            </div>\r\n            <div className=\"landing__discover--list-item\"></div>\r\n            <div className=\"landing__discover--list-item\"></div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <div className=\"landing__slider\">\r\n        {content.filter(key => key.id === step ).map(item => (\r\n          <div className=\"landing__slider--container\" key={item.id}>\r\n            <div className=\"landing__slider--img\">\r\n              <img  src={item.img} alt=\"img\"/>\r\n            </div>\r\n\r\n            <div className=\"landing__slider--text\">\r\n              <svg width=\"30\" height=\"28\" viewBox=\"0 0 30 28\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\r\n                <path d=\"M12.3993 5.56001C13.1711 5.22699 13.4948 4.27918 13.1462 3.51069L11.9262 0.872185C11.5777 0.129562 10.7311 -0.203709 9.98417 0.129562C7.86782 1.05176 6.05026 2.25573 4.60616 3.71587C2.83839 5.43192 1.64328 7.4044 0.995927 9.5818C0.348574 11.7851 0 14.782 0 18.5988V26.4631C0 27.3084 0.672251 28.0001 1.49389 28.0001H11.2789C12.1005 28.0001 12.7728 27.3084 12.7728 26.4631V16.3958C12.7728 15.5502 12.1005 14.8588 11.2789 14.8588H6.59802C6.64781 12.2713 7.24537 10.1966 8.34089 8.63373C9.23722 7.37904 10.5817 6.35438 12.3993 5.56001Z\" fill=\"#4B004B\"/>\r\n                <path d=\"M29.1127 5.53403C29.8845 5.20102 30.2079 4.25321 29.8596 3.48471L28.6396 0.872082C28.291 0.129203 27.4445 -0.203812 26.6976 0.129203C24.6061 1.0514 22.8132 2.25537 21.3444 3.6899C19.5764 5.43182 18.3567 7.40429 17.7091 9.5817C17.0617 11.7332 16.7383 14.7306 16.7383 18.5731V26.4374C16.7383 27.2827 17.4105 27.9744 18.2322 27.9744H28.0172C28.8388 27.9744 29.511 27.2827 29.511 26.4374V16.3701C29.511 15.5245 28.8388 14.8331 28.0172 14.8331H23.3114C23.3612 12.2456 23.959 10.1709 25.0543 8.60801C25.9506 7.35306 27.2951 6.3284 29.1127 5.53403Z\" fill=\"#4B004B\"/>\r\n              </svg>\r\n\r\n              <p>{item.content}</p>\r\n\r\n              <small>{item.name}</small>\r\n\r\n              <div className={cn(\"landing__dots\", `landing__dots--${item.id}`)}>\r\n              {\r\n                dots.map((_, index) => (\r\n                  <div onClick={() => setStep(index)}>&nbsp;</div>\r\n                ))\r\n              }\r\n            </div>\r\n            </div>\r\n          </div>\r\n        ))}\r\n      </div>\r\n\r\n      <div className=\"landing__bottom\" style={{paddingBottom: 0}}>\r\n        <div className=\"landing__bottom--text\">\r\n          <div className=\"landing__bottom--text--right\">\r\n            <h1>Get Upskilled For The Future Of Work</h1>\r\n            <p>We will provide you with the tools, resources, facilities, content and mentorship needed for your relevance in the future of work.</p>\r\n\r\n            <div className=\"landing__btn--2\">\r\n              <PrimaryBtn link=\"/get-started\">Learn More</PrimaryBtn>\r\n            </div>\r\n          </div>\r\n\r\n          <div className=\"landing__bottom--text--left\">\r\n            <img src={Grazac} alt=\"img\" />\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <Mode />\r\n      <Footer />\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default Landing;","C:\\Users\\USER\\Desktop\\Web Development\\Bitbucket\\grazac-academy\\src\\pages\\GraduateAccelerator.js",["118","119","120"],"import React from \"react\";\r\nimport Navbar from \"../components/Navbar\";\r\nimport Footer from \"../components/Footer\";\r\nimport NeedAdvice from \"../components/NeedAdvice\";\r\nimport PopularCourses from \"../components/PopularCourses\";\r\nimport Qualities from \"../components/Qualities\";\r\nimport PrimaryBtn from \"../components/PrimaryBtn\";\r\nimport Graduates from \"../images/graduates.png\";\r\nimport Card1 from \"../images/svg/card1.svg\";\r\nimport Card2 from \"../images/svg/card1.svg\";\r\n\r\nconst GraduateAccelerator = () => {\r\n\r\n    React.useEffect(() => {\r\n        document.title = 'Graduate Accelerator Track - Grazac Academy';\r\n        window.scrollTo(0,0);\r\n    }, []);\r\n\r\n    return(\r\n        <div>\r\n            <div className=\"gga\">\r\n                <div className=\"gga_hero\">\r\n                    <Navbar/>\r\n                    <div className=\"container\">\r\n                        <div className=\"row\">\r\n                            <div className=\"col-sm-6\">\r\n                                <div className=\"gga_hero-text\">\r\n                                    <div className=\"gga_hero-text-b\">\r\n                                        <h1>\r\n                                            Graduate Accelerator Plan\r\n                                        </h1>\r\n                                        <p>\r\n                                            We are bridging the gap between unemployment and entry - level jobs 21st century.\r\n                                            You need more than a degree to be relevant in the 21st century. </p><p>Let’s prepare you for the future of work.\r\n                                            Access to facilities and resources that aids your learning and practice.</p>\r\n                                        <p>Learn Digital Skills and gain insights into today’s digital tools.</p>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div>\r\n                                <img src={Graduates} alt=\"Graduates\"  className=\"gga_hero-image\" />\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"container\">\r\n                    <div className=\"course_mode-container\">\r\n                        <div className=\"boxes22\">