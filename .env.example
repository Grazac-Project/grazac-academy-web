# Copy to .env.local (or set in Vercel → Settings → Environment Variables).
# Everything here is baked into the public JavaScript at build time:
# never put a secret in a REACT_APP_ variable.

# Grazac backend that serves /api/v1/virtual-courses and /api/v1/admin/analytics.
# No trailing slash. Required in production.
REACT_APP_API_BASE_URL=https://your-backend.example.com

# Hosts an Enrol Now button may link to, comma-separated. Defaults to
# learn.grazacacademy.com and grazac-academy.trainercentralsite.com.
# Drop the trainercentralsite.com host once TrainerCentral serves course
# URLs on learn.grazacacademy.com.
# REACT_APP_ENROLL_HOSTS=learn.grazacacademy.com,grazac-academy.trainercentralsite.com

# Development only: answer API calls from src/api/mocks/adapter.js (sample
# data, clearly labelled). Ignored by production builds.
# REACT_APP_USE_MOCKS=true
