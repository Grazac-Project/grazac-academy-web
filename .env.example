# Copy to .env.development.local and restart npm start.
# Browser requests stay on the frontend origin. Both /api namespaces use school.
REACT_APP_API_URL=/
REACT_APP_ADMIN_API_URL=/
# Required external hire origin. Replace this placeholder with the approved service.
REACT_APP_HIRE_API_URL=https://approved-hire-api.example
# Server-only CRA development proxy target; never prefixed with REACT_APP_.
API_PROXY_TARGET=http://127.0.0.1:9900

# Required sandbox public key for payment testing. Replace this placeholder.
# Never put a secret key in frontend configuration.
REACT_APP_FLW_PUBLIC_KEY=your-flutterwave-sandbox-public-key
# Missing variables are not defaulted.
