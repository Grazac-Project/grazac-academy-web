# Copy this file to .env.local and restart the frontend.
# Both API namespaces use the local school backend.
REACT_APP_API_URL=http://localhost:9900/
REACT_APP_ADMIN_API_URL=http://localhost:9900/

# Optional Flutterwave sandbox public key. Never use a secret key in frontend configuration.
# Empty uses the existing key fallback. Set a sandbox key before payment tests.
REACT_APP_FLW_PUBLIC_KEY=
